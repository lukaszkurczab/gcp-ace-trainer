          {
            "id": "alg-sw-complexity-two-monotone-pointers",
            "prompt": "An outer loop advances right from 0 to n−1. Inside it, a while loop advances left, but left never moves backward and advances at most n times total. What is the total time complexity of the boundary movement?",
            "constraints": [
              "Each right increment and each left increment performs O(1) maintained-state work.",
              "No helper scans the current window."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n^2)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {}
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "The nested while loop is amortized over monotone pointer movement: right advances n times and left advances at most n times.",
              "details": "Syntactic nesting does not multiply iteration counts when the inner pointer keeps its progress across outer iterations. The outer loop contributes n right moves. Across the entire run, left can cross each index once, contributing at most n additional moves. With O(1) state updates per move, total work is O(n+n)=O(n). The bound would change if left reset for each right or if a validity check rescanned the window. The proof counts total operations over the complete execution rather than multiplying the maximum local loop lengths suggested by the source-code indentation."
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_linear_window_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "at_most_k_window",
              "problemArchetypeId": "longest_valid_window"
            }
