            }
          },
          {
            "id": "alg-bits-xor-018",
            "prompt": "An array contains n arbitrary-precision values, each represented with at most w bits. XORing two values costs O(w). Select total time and accumulator space.",
            "constraints": [
              "The result accumulator also occupies O(w) bits."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "accumulator_space"
