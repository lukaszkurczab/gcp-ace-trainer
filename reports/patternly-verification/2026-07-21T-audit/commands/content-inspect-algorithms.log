                  "O(n!)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(n)",
                  "O(2^n)",
                  "O(n·2^n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(2^n)"
                ],
                "auxiliary_space": [
