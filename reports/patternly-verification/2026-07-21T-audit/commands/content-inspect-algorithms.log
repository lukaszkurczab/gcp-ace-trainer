            }
          },
          {
            "id": "alg-gt-msbfs-005",
            "prompt": "Edges have nonnegative weights 1 or 7, and the task asks for the minimum cost to any of several sources. Is ordinary multi-source BFS sufficient?",
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "use_dijkstra",
                  "text": "No; initialize all sources with distance zero in a multi-source Dijkstra priority queue."
                },
                {
                  "id": "ordinary_bfs",
                  "text": "Yes; multiple sources make BFS correct for arbitrary nonnegative weights."
                },
                {
                  "id": "dfs",
                  "text": "Use multi-source DFS because depth-first traversal compares weighted routes more directly."
                },
                {
                  "id": "matrix",
                  "text": "Convert to an adjacency matrix; then FIFO BFS becomes weighted-correct."
                }
              ],
              "acceptedOptionIds": [
                "use_dijkstra"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Multi-source initialization generalizes, but FIFO correctness still requires equal edge costs.",
              "details": "Seed every source in the priority queue with distance zero, then use the usual nonnegative-weight relaxation. The multi-source idea is independent of the frontier discipline: FIFO for equal weights, a deque for a 0/1 model, and a priority queue for general nonnegative weights. An adjacency matrix may change neighbor enumeration cost but not shortest-path correctness.",
              "wrongOptionExplanationsByOptionId": {
                "ordinary_bfs": "Multiple origins do not restore the equal-edge-cost invariant required by FIFO first discovery.",
                "dfs": "DFS exploration order does not finalize the minimum accumulated weighted path cost.",
                "matrix": "Changing the representation does not remove unequal edge weights from path costs."
              }
            },
            "taxonomy": {
