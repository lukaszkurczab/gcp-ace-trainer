                "arbitrary_unique_list": "One aggregate cannot recover an arbitrary set of values."
              },
              "omittedCorrectExplanationsByOptionId": {
                "one_single_pairs": "Pairs cancel and the single remains.",
                "one_odd_others_even": "Parity cancellation leaves the odd-frequency value.",
                "all_pairs_check_zero": "A reduction computes that parity summary."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
