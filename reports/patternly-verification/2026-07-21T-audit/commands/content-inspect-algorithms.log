      {
        "id": "ssc-queries-many-static-range-sums",
        "prompt": "A static array of n values will answer q = 1,000,000 arbitrary range-sum queries. Which strategy best uses the repeated-query workload?",
        "constraints": [
          "q is one million.",
          "The array is unchanged between queries.",
          "Queries ask additive ranges.",
          "O(n) extra memory is available."
        ],
        "difficulty": "introductory",
        "interaction": {
