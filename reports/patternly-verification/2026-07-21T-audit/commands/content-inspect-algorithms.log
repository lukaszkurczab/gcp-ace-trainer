                  "O(2^n)"
                ],
                "peak_auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log n)"
                ],
                "peak_auxiliary_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "decorate_and_sort": "O(n log n)"
                },
                "peak_auxiliary_space": {
                  "decorated_records": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Decoration is linear and sorting dominates time.",
              "details": "The n identity-carrying records dominate peak auxiliary space."
