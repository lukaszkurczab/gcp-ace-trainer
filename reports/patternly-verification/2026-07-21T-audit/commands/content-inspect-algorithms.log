        "items": [
          {
            "id": "alg-dpintro-memo-01-lookup-compute-store",
            "prompt": "Which top-down structure correctly memoizes solve(state)?",
            "constraints": [
              "base(state) can be checked without recursion.",
              "computeFromChildren(state) evaluates the recurrence."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "cache_after_return",
                  "text": "Compute and return the result, then write it to the cache on the next line."
                },
                {
                  "id": "correct_pattern",
                  "text": "Check the base; return cache[state] if present; otherwise compute the full result, store it under state, and return it."
                },
                {
                  "id": "store_placeholder",
                  "text": "Store 0 under state before computing children, then return that cached 0 if state is encountered again."
                }
              ],
              "acceptedOptionIds": [
                "correct_pattern"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A memo entry must map the complete state to its final deterministic result, with lookup before repeated recursion and storage before return.",
              "details": "Base states can return directly or be cached consistently, but nonterminal states need a cache check before expanding dependencies. On a miss, the recurrence is evaluated exactly once, its final value is stored, and all later visits reuse it. Writing a normal answer before computation can corrupt acyclic logic and does not solve cycles. Memoization is an implementation of a proven state and transition, not a substitute for them.",
              "wrongOptionExplanationsByOptionId": {
                "store_placeholder": "A placeholder is not the solved value and can be mistaken for a legitimate result. Cycles require an explicit in-progress policy, not an ordinary answer entry.",
                "cache_after_return": "Code after return is unreachable, so repeated states are never stored and recomputation remains."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "memoize_recursive_subproblem",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "memoization",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-memo-02-complete-cache-key",
            "prompt": "A recurrence solve(i, j) compares suffixes of two strings. Which memo key is correct?",
            "constraints": [
              "i and j can change independently.",
              "The result is deterministic for each suffix pair."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "tuple_key",
                  "text": "Use the pair (i, j)."
                },
                {
                  "id": "i_key",
                  "text": "Use only i because it is the first argument."
                },
                {
                  "id": "depth_key",
                  "text": "Use recursion depth because calls at the same depth have consumed the same total number of characters."
                }
              ],
              "acceptedOptionIds": [
                "tuple_key"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The cache identity must match the semantic state identity, which here is the full pair (i, j).",
              "details": "Memoization replaces repeated evaluation with table lookup, so a key collision is equivalent to declaring two states equal. Since either string can advance independently, one i corresponds to multiple unresolved second-string suffixes. Recursion depth also loses how progress is distributed between the strings. Use a canonical representation of all state components and no irrelevant history.",
              "wrongOptionExplanationsByOptionId": {
                "i_key": "Different j values pair the same first-string suffix with different second-string suffixes, so they can have different answers.",
                "depth_key": "The same depth can contain different (i, j) splits and therefore different suffix pairs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "memoize_recursive_subproblem",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "memoization",
              "problemArchetypeId": "sequence_alignment_intro"
            }
          },
          {
            "id": "alg-dpintro-memo-03-sparse-reachable-states",
            "prompt": "A conceptual R by C state space exists, but obstacles make only K states reachable from the start. Each reached state has O(1) outgoing transitions. Select the memoized time and cache space.",
            "constraints": [
              "Cache operations are O(1) expected time.",
              "K <= R * C.",
              "The recursion never evaluates unreachable states."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(K)",
                  "O(R + C)",
                  "O(R * C)"
                ],
                "space": [
                  "O(1)",
                  "O(K)",
                  "O(R + C)",
                  "O(R * C)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(K)"
                ],
                "space": [
                  "O(K)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {},
                "space": {}
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Memoization evaluates and stores each reachable state once, so its principal cost follows K rather than the full rectangle.",
              "details": "Each of the K reachable states is expanded once and performs constant transition work, giving O(K) time. The memo table holds O(K) values; the call stack may add up to path depth, which is at most O(K), so O(K) remains a valid total bound. When K is close to R·C, tabulation may perform the same asymptotic work with lower recursion overhead. Memoization is conditionally advantageous, not universally faster."
            },
            "taxonomy": {
              "primarySkillAtomId": "memoize_recursive_subproblem",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "memoization",
              "problemArchetypeId": "grid_path_dp"
            }
          },
          {
            "id": "alg-dpintro-memo-04-acyclic-progress-before-cache",
            "prompt": "Order the checks for a safe memoized recursion.",
            "constraints": [
              "The intended DP recurrence should terminate without fixed-point iteration.",
              "A state may have multiple dependencies."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_measure",
                  "text": "Identify a measure that strictly progresses toward a terminal state on every recursive edge."
                },
                {
                  "id": "base_cases",
                  "text": "Define terminal states for that measure."
                },
                {
                  "id": "cache_lookup",
                  "text": "Check whether the complete state already has a finished cached result."
                },
                {
                  "id": "compute_store",
                  "text": "Recursively compute missing dependencies, then store the finished result."
                }
              ],
              "canonicalOrder": [
                "state_measure",
                "base_cases",
                "cache_lookup",
                "compute_store"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Termination and dependency direction must be established before a cache can safely reuse completed results.",
              "details": "Memoization assumes that recursive expansion eventually reaches bases and that a state can be fully solved from already terminating descendants. A cache lookup avoids re-expanding finished states, but an unfinished cycle can revisit itself before any value is stored. Proving a strictly progressing measure separates valid DP recursion from equations that require cycle detection or fixed-point methods. Only after that proof should lookup and storage wrap the recurrence."
            },
            "taxonomy": {
              "primarySkillAtomId": "memoize_recursive_subproblem",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "memoization",
              "problemArchetypeId": "optimize_prefix_or_suffix"
            }
          },
          {
            "id": "alg-dpintro-memo-05-memo-table-not-rolling-state",
            "prompt": "A memoized solver stores only states it reaches. Does that alone justify deleting older cache entries during the same recursion?",
            "constraints": [
              "Future recursive branches may reach states in a nonlocal order.",
              "No liveness proof has been made."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "yes_sparse",
                  "text": "Yes. Any memo table is automatically a state-compressed DP."
                },
                {
                  "id": "yes_after_return",
                  "text": "Yes. A state can always be deleted immediately after its current caller returns."
                },
                {
                  "id": "no_liveness_proof",
                  "text": "No. Sparse allocation and safe eviction are different properties; a later branch may still request an older state."
                }
              ],
              "acceptedOptionIds": [
                "no_liveness_proof"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Memoization is demand-driven storage, but eviction requires a separate proof that the value is dead for all remaining computation.",
              "details": "A sparse cache can be much smaller than a full rectangular table when few states are reached. That does not imply a simple chronological retention window because recursive traversal can return and later enter a different branch that converges on an earlier state. Deleting the entry would preserve correctness only if it is recomputed, but can destroy the intended complexity benefit; in some formulations it can also break reconstruction. Compression must follow dependency liveness, not the fact that storage is a map.",
              "wrongOptionExplanationsByOptionId": {
                "yes_sparse": "Memoization avoids allocating unreachable states, but retained reached states may remain reusable throughout the traversal.",
                "yes_after_return": "Another branch higher in the recursion can later converge on the same state, which is precisely the reuse memoization was meant to preserve."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "memoize_recursive_subproblem",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "state_compression",
              "problemArchetypeId": "choose_or_skip"
            }
          },
          {
            "id": "alg-dpintro-memo-06-cached-zero-sentinel",
            "prompt": "A state can legitimately have 0 valid completions. Which cache check is correct?",
            "constraints": [
              "The language treats 0 as falsy.",
              "The cache supports an explicit membership operation."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "nonzero_only",
                  "text": "Store only nonzero results because zero cannot help another branch."
                },
                {
                  "id": "membership",
                  "text": "If cache contains state, return cache[state], even when the stored value is 0."
                },
                {
                  "id": "truthy",
                  "text": "If cache[state] is truthy, return it; otherwise recompute."
                }
              ],
              "acceptedOptionIds": [
                "membership"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Presence and value are separate facts; zero is a valid cached result, not a cache miss.",
              "details": "A memo table represents a partial mapping from state to solved result. The mapping can contain any value allowed by the recurrence, including zero. Testing truthiness conflates the domain value with membership and can restore exponential recomputation over impossible regions. Use an explicit sentinel outside the value domain or a membership operation.",
              "wrongOptionExplanationsByOptionId": {
                "truthy": "A cached zero is a finished answer, but a truthiness check misclassifies it as missing and repeats work.",
                "nonzero_only": "Repeated impossible states can be common; caching zero prevents their subtrees from being explored again."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "memoize_recursive_subproblem",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "memoization",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-memo-07-two-parameter-transfer",
            "prompt": "A path solver uses solve(r, c) and returns 0 outside the grid, 1 at the destination, otherwise the sum of down and right calls. Which memoization plan preserves the recurrence?",
            "constraints": [
              "Only in-grid nonterminal states need ordinary cache entries.",
              "Different paths can reach the same cell."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "pair_cache",
                  "text": "Use (r, c) as the key; handle out-of-grid and destination bases; on a miss compute both successors, store their sum, and return it."
                },
                {
                  "id": "row_cache",
                  "text": "Use r as the key because all cells in a row have the same distance to the bottom."
                },
                {
                  "id": "cache_branch",
                  "text": "Cache the result of only the down branch and recompute the right branch every time."
                }
              ],
              "acceptedOptionIds": [
                "pair_cache"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The cache key and stored value must correspond exactly to the full cell state and its complete transition result.",
              "details": "The destination and out-of-grid checks establish terminal values. For any other cell, the state result is the sum of both legal successor counts, so that full sum is what belongs under key (r, c). Multiple incoming paths can then reuse the exact cell result. Partial branch caching or row-only keys fail because they no longer map a complete state to its defined answer.",
              "wrongOptionExplanationsByOptionId": {
                "row_cache": "Column changes the remaining grid region and path count, so row-only entries alias distinct subproblems.",
                "cache_branch": "The cached value would not represent solve(r, c), so returning it as the state result would violate the state contract and leave overlap unhandled."
              }
            },
