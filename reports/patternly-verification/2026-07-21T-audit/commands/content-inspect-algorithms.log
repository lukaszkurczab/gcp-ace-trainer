          {
            "id": "algorithms-intervals-sweep-005",
            "prompt": "Select all statements that are true about equal-coordinate event handling.",
            "constraints": [
              "Select all correct statements.",
              "The sweep may observe intermediate active states."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "contract_drives_tie",
                  "text": "The endpoint inclusion contract determines the required tie order."
                },
                {
                  "id": "half_open_end_first",
                  "text": "For half-open active counts, end-before-start preserves immediate reuse."
                },
                {
                  "id": "arbitrary_same_peak",
                  "text": "Any order yields the same peak because the final net delta is identical."
                },
                {
                  "id": "net_preserves_zero_crossing",
                  "text": "Combining same-time deltas into one net value always preserves whether active reached zero within that coordinate."
                }
              ],
              "acceptedOptionIds": [
                "contract_drives_tie",
                "half_open_end_first"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equal-time order is derived from the representation and observed state; final net delta alone does not preserve every peak or transition.",
              "details": "The two correct statements connect domain semantics to event order. Half-open intervals release before acquisition, so an ending delta precedes a starting delta when intermediate counts are inspected. Arbitrary ordering can create a transient extra active interval. Aggregating to a net delta can be safe for a narrowly defined result, but it discards within-coordinate transitions such as active reaching zero and reopening. Therefore grouping is an optimization that needs a proof for the exact answer contract, not a substitute for specifying ties.",
              "wrongOptionExplanationsByOptionId": {
                "arbitrary_same_peak": "Intermediate counts can differ even when the final count after the coordinate matches.",
                "net_preserves_zero_crossing": "A -1 and +1 can net to zero while ordered processing either exposes or hides a zero crossing; that distinction can matter to boundary reconstruction."
              },
              "omittedCorrectExplanationsByOptionId": {
                "contract_drives_tie": "Omitting this treats tie-breaking as a generic sort detail instead of a semantic consequence.",
                "half_open_end_first": "Omitting this loses the concrete half-open rule that prevents false overlap at reuse boundaries."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "process_interval_events_in_order",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sweep_line_intro",
