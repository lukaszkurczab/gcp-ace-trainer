                {
                  "id": "i_equal_length",
                  "text": "Stop only when i == len(a), because a base case handles only the empty suffix."
                },
                {
                  "id": "i_equal_last_index",
                  "text": "Stop only when i == len(a) - 1."
                },
                {
                  "id": "array_empty_initially",
                  "text": "Use a base case only when the original array is empty."
