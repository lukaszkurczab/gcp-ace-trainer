                  "Ω(n·n!)"
                ]
              },
              "normalizedAliasesByDimension": {
                "output_count": {
                  "permutations": "Θ(n!)"
                },
                "time_lower_bound": {
                  "copy_each_length_n": "Ω(n·n!)"
