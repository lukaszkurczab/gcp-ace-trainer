        "items": [
          {
            "id": "algorithms-intervals-resources-001",
            "prompt": "Half-open meetings are [0, 10), [1, 2), [3, 4), and [5, 6). What is the minimum number of rooms required?",
            "constraints": [
              "A room can be reused when one meeting ends exactly as another starts.",
              "The answer is the maximum number of simultaneously active meetings."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_rooms",
                  "text": "2"
                },
                {
                  "id": "four_rooms",
                  "text": "4"
                },
                {
                  "id": "three_plus_one",
                  "text": "4 because the long meeting overlaps three other meetings"
                }
              ],
              "acceptedOptionIds": [
                "two_rooms"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The long meeting overlaps one short meeting at a time, so the active set never exceeds two meetings.",
              "details": "From time 1 to 2, active meetings are [0, 10) and [1, 2); from 3 to 4, they are [0, 10) and [3, 4); from 5 to 6, they are [0, 10) and [5, 6). The short meetings are sequential, so no instant has more than two active intervals. Counting overlapping pairs gives three, and adding one would suggest four rooms, but pair conflicts at different times cannot be summed. The decisive quantity is maximum concurrency, obtainable from active end times or an event sweep.",
              "wrongOptionExplanationsByOptionId": {
                "four_rooms": "There are four meetings, but the three short meetings do not overlap each other. Counting records rather than simultaneous activity overallocates.",
                "three_plus_one": "The long meeting creates three overlapping pairs at different times, but those pair conflicts do not occur simultaneously. Pair count is not resource count."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "count_concurrent_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "interval_resource_count",
              "problemArchetypeId": "count_concurrent_intervals"
            }
          },
          {
            "id": "algorithms-intervals-resources-002",
            "prompt": "Which min-heap procedure correctly computes the minimum number of rooms for half-open meetings?",
            "constraints": [
              "The input may be unsorted.",
              "The heap stores end times of currently allocated rooms."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "release_then_push",
                  "text": "Sort meetings by start; before each meeting, remove every heap end <= its start, then push its end and record the maximum heap size."
                },
                {
                  "id": "sort_by_end_push",
                  "text": "Sort meetings by end and push every end without releasing until the scan finishes."
                },
                {
                  "id": "release_one_strict",
                  "text": "Sort by start; remove at most one end strictly less than the new start, then push."
                }
              ],
              "acceptedOptionIds": [
                "release_then_push"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Start order introduces meetings chronologically, while the min-heap exposes every room that has become reusable before the next start.",
              "details": "Sorting by start ensures no unprocessed meeting begins earlier than the current one. The minimum end at the heap root is the earliest room release. While that end is <= current.start, the room is free under [start, end) and should be removed; multiple rooms can become free, so use a loop. Push the current end to represent its occupied room and track the maximum heap size over the scan. The final heap size alone is not sufficient because concurrency may have peaked earlier. The heap is ordered by end internally, but this does not mean the meetings themselves should be processed by end.",
              "wrongOptionExplanationsByOptionId": {
                "sort_by_end_push": "That counts processed meetings rather than currently active meetings and cannot model room reuse.",
                "release_one_strict": "Several rooms may become free before one meeting, and equality also releases a room under half-open semantics."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "count_concurrent_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "interval_resource_count",
              "problemArchetypeId": "count_concurrent_intervals"
            }
          },
          {
            "id": "algorithms-intervals-resources-003",
            "prompt": "A meeting ends at 10:00 and another starts at 10:00. Under half-open occupancy, how should a two-array or event-based room counter treat the tie?",
            "constraints": [
              "The room may be reused immediately.",
              "The active count is updated at the tie."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "end_first",
                  "text": "Process the end before the start, so the same room can be reused."
                },
                {
                  "id": "start_first",
                  "text": "Process the start before the end, temporarily requiring another room."
                },
                {
                  "id": "tie_irrelevant",
                  "text": "Ignore the ordering because both events have the same timestamp."
                }
              ],
              "acceptedOptionIds": [
                "end_first"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Half-open meetings release their room at the end timestamp, so release precedes acquisition at an equal start.",
              "details": "In a sorted-start/sorted-end two-pointer method, equality start[i] == end[j] advances the end pointer and decrements or reuses before adding the new meeting. In an event sweep, -1 precedes +1. Both are encodings of the same semantic rule. Reversing the tie reports a transient extra active meeting and may increase the room maximum. The tie must be tested directly with back-to-back meetings because inputs with only strict gaps or strict overlaps cannot expose the comparator defect.",
              "wrongOptionExplanationsByOptionId": {
                "start_first": "That treats the ending meeting as active at its exclusive end and overcounts half-open concurrency.",
                "tie_irrelevant": "The intermediate active count changes with the order, which can change the recorded maximum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "count_concurrent_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "interval_resource_count",
              "problemArchetypeId": "count_concurrent_intervals"
            }
          },
          {
            "id": "algorithms-intervals-resources-004",
            "prompt": "Reservations use closed intervals and both reservations occupy the shared endpoint. One ends at t and another starts at t. Which event order computes the required capacity correctly?",
            "constraints": [
              "A one-point simultaneous occupancy consumes two units of capacity."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_before_end",
                  "text": "Process the start before the end."
                },
                {
                  "id": "end_before_start",
                  "text": "Process the end before the start."
                },
                {
                  "id": "aggregate_net_only",
                  "text": "Apply only the net delta and never consider the within-time peak."
                }
              ],
              "acceptedOptionIds": [
                "start_before_end"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Closed intervals both include t, so the new reservation becomes active before the old one can be removed from the count.",
              "details": "The equal-time order is the event-level form of the closed predicate. If active is k immediately before t, a start at t raises it to k + 1 while the ending reservation still occupies t; only after measuring that state should the end decrement. Grouping the events to a net delta of zero would erase the one-point peak. This distinction matters when the resource contract counts instantaneous occupancy, even if the duration of the overlap is zero. Continuous domains that ignore measure-zero intersections would need a different declared policy.",
              "wrongOptionExplanationsByOptionId": {
                "end_before_start": "That releases capacity before accounting for a reservation that is also active at t, undercounting the inclusive overlap.",
                "aggregate_net_only": "A +1 and -1 net to zero, but the closed contract still has two active reservations at t. Net-only aggregation loses that peak."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "count_concurrent_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "interval_resource_count",
              "problemArchetypeId": "count_concurrent_intervals"
            }
          },
          {
            "id": "algorithms-intervals-resources-005",
            "prompt": "Select all methods that can correctly compute maximum concurrency for static half-open intervals when implemented with the proper equality rule.",
            "constraints": [
              "Select all correct methods.",
              "The input may be unsorted."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "min_heap",
                  "text": "Sort by start and maintain a min-heap of active end times."
                },
                {
                  "id": "two_arrays",
                  "text": "Sort starts and ends separately and advance two pointers."
                },
                {
                  "id": "event_sweep",
                  "text": "Create +1/-1 events, sort by coordinate with end-before-start ties, and track the maximum prefix sum."
                },
                {
                  "id": "pair_count",
                  "text": "Count every overlapping pair and add one."
                }
              ],
              "acceptedOptionIds": [
                "min_heap",
                "two_arrays",
                "event_sweep"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Heap, two-array, and event-sweep methods all model active occupancy over time; overlapping-pair count does not.",
              "details": "The three correct methods differ in representation but preserve the same invariant: active equals the number of intervals whose starts have been processed and whose ends have not yet released under the endpoint contract. The min-heap is useful when room end identities matter during the scan. Two sorted arrays reduce the state to ordered starts and ends. A delta sweep generalizes naturally to weighted demand. Counting overlapping pairs discards time alignment, so a single long interval overlapping many sequential short ones produces many pairs but only two simultaneous intervals.",
              "wrongOptionExplanationsByOptionId": {
                "pair_count": "Pair conflicts occurring at different times are not simultaneous, so pair count does not determine maximum active intervals."
              },
              "omittedCorrectExplanationsByOptionId": {
                "min_heap": "The heap directly represents active rooms and exposes the earliest reusable one.",
                "two_arrays": "Separate sorted endpoints provide the same chronological acquire/release process without storing interval identity.",
                "event_sweep": "A correctly ordered delta sweep computes the active-count prefix and its maximum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "count_concurrent_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
