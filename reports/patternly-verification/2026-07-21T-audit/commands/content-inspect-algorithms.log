            "constraints": [
              "Each input pointer moves only forward and each reported occurrence is appended once."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space",
                "output_space"
