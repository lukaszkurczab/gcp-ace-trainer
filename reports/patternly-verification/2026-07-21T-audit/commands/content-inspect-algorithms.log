            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Unsigned interpretation is a positional sum.",
              "details": "Starting from the least significant position prevents reversed place-value mistakes."
            },
            "taxonomy": {
              "primarySkillAtomId": "interpret_integer_bit_representation",
              "secondarySkillAtomIds": [],
