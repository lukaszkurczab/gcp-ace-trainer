        "items": [
          {
            "id": "alg-arrays-stable-compaction-001",
            "prompt": "During stable in-place compaction, what does the write index represent after the first read positions have been processed?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "retained_prefix_length",
                  "text": "The number of retained values already written into the valid output prefix."
                },
                {
                  "id": "next_unread_position",
                  "text": "The position of the next unread input value."
                },
                {
                  "id": "number_removed_only",
                  "text": "Only the number of removed values."
                },
                {
                  "id": "physical_array_length",
                  "text": "The physical length of the array."
                }
              ],
              "acceptedOptionIds": [
                "retained_prefix_length"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The write index is the boundary between the valid compacted prefix and unused positions.",
              "details": "After processing a prefix of the input, positions [0, write) contain exactly the retained values from that processed prefix in their original relative order.",
              "wrongOptionExplanationsByOptionId": {
                "next_unread_position": "The read index, not the write index, tracks the next input position to inspect.",
                "number_removed_only": "Removed count can be derived from read and write, but it is not the direct meaning of write.",
                "physical_array_length": "Compaction usually changes the logical result length without changing physical storage length."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_read_write_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-stable-compaction-002",
            "prompt": "A filter keeps values satisfying a predicate. When should the write index advance?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "only_after_retained_write",
                  "text": "Only after a retained value has been written to array[write]."
                },
                {
                  "id": "every_read_iteration",
                  "text": "On every read iteration, whether the value is retained or removed."
                },
                {
                  "id": "only_when_value_removed",
                  "text": "Only when the current value is removed."
                },
                {
                  "id": "once_after_loop",
                  "text": "Only once after the scan finishes."
                }
              ],
              "acceptedOptionIds": [
                "only_after_retained_write"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Write counts retained output positions, so it advances exactly when one output value is produced.",
              "details": "If a value is removed, no new valid output position is created. Incrementing write anyway would leave gaps or include stale values in the logical prefix.",
              "wrongOptionExplanationsByOptionId": {
                "every_read_iteration": "This makes write track processed input rather than retained output.",
                "only_when_value_removed": "Removed values should not consume positions in the compacted prefix.",
                "once_after_loop": "The algorithm needs the current output boundary during the scan."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_read_write_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-stable-compaction-003",
            "prompt": "Which invariant prevents stable compaction from overwriting unread input?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "write_not_ahead_of_read",
                  "text": "At every step, write <= read."
                },
                {
                  "id": "read_not_ahead_of_write",
                  "text": "At every step, read <= write."
                },
                {
                  "id": "write_equals_length",
                  "text": "At every step, write equals n."
                },
                {
                  "id": "read_equals_write_plus_one",
                  "text": "At every step, read equals write + 1."
                }
              ],
              "acceptedOptionIds": [
                "write_not_ahead_of_read"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The output boundary can lag behind the read position but must never move ahead of it.",
              "details": "Writing to an index at or before the current read position cannot destroy future unread values. If write moved beyond read, the algorithm could overwrite input that has not yet been examined.",
              "wrongOptionExplanationsByOptionId": {
                "read_not_ahead_of_write": "This permits write to move into unread territory.",
                "write_equals_length": "Write should reflect retained count, which can be much smaller than n.",
                "read_equals_write_plus_one": "Read and write may be equal for long stretches when all values are retained."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_read_write_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-stable-compaction-005",
            "prompt": "A filter removes every input value. What should the final write index be?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero",
                  "text": "0"
                },
                {
                  "id": "one",
                  "text": "1"
                },
                {
                  "id": "n_minus_one",
                  "text": "n - 1"
                },
                {
                  "id": "n",
                  "text": "n"
                }
              ],
              "acceptedOptionIds": [
                "zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "No retained values means the valid compacted prefix has length zero.",
              "details": "Read still scans the entire input, but write never advances because no output value is produced.",
              "wrongOptionExplanationsByOptionId": {
                "one": "The algorithm does not reserve a placeholder output position.",
                "n_minus_one": "This confuses an index with the number of retained values.",
                "n": "Processed input count and retained output count are different."
              }
            },
