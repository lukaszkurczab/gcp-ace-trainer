            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The r + 1 conversion is conditional; at the maximum representable endpoint it corrupts the range rather than creating a valid exclusive bound.",
              "details": "The mathematical equivalence [l, r] = [l, r + 1) on integers assumes r + 1 exists in the representation. Fixed-width overflow violates that assumption and can invert or wrap the interval. Safe alternatives include a wider proven type, an explicit inclusive-end flag, a sentinel outside the value domain, or a branch for maximal r. The chosen representation must remain orderable and serializable. This is a transfer-boundary failure, not a sorting failure or an acceptable edge-case omission.",
              "wrongOptionExplanationsByOptionId": {
                "sort_overflowed_range": "Sorting cannot recover the lost numeric value or represented set after overflow.",
                "ignore_max_endpoint": "Silently deleting valid input is not a semantic correction and changes the problem."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_interval_endpoint_error",
