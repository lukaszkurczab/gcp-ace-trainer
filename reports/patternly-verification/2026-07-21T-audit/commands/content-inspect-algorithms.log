            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A 0/1 cell contribution remains additive over rectangles, so the same four-term inclusion-exclusion isolates the count.",
              "details": "The geometry and boundary formula stay unchanged; only the per-cell contribution becomes an indicator. A scalar sum does not encode a median, online updates stale many prefix entries, and optimizing over all possible rectangles requires a search or different invariant beyond one region query.",
              "wrongOptionExplanationsByOptionId": {
                "rectangle_median": "Four scalar sums retain only total magnitude, not the distribution needed for a median.",
                "online_cell_updates": "Changing one cell affects every prefix region below and to its right. A static table cannot remain correct without updates or a dynamic structure.",
                "largest_valid_rectangle": "A four-term query evaluates one supplied rectangle. It does not choose the best rectangle among many candidates."
              }
            },
