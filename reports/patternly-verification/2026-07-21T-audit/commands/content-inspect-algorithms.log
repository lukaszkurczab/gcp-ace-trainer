              "text": "The estimate treats operations as abstract equal-cost units."
            },
            {
              "id": "constants",
              "text": "Constant factors and cache behavior may matter near the limit."
            },
            {
              "id": "memory",
              "text": "Memory and output constraints may reject an otherwise acceptable operation count."
            },
            {
              "id": "universal_speed",
              "text": "The estimate proves every implementation finishes in the same wall-clock time."
            }
          ],
          "acceptedOptionIds": [
            "abstract_units",
            "constants",
            "memory"
