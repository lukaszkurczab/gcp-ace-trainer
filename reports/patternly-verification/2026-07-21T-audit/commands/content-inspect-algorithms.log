          {
            "id": "alg-contrast-window-prefix-objective-012",
            "prompt": "Which facts support exact-sum prefix state? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "difference_equation",
                  "text": "A valid interval satisfies currentPrefix - earlierPrefix = k."
                },
                {
                  "id": "arbitrary_signs",
                  "text": "Values may be positive, zero, or negative."
                },
                {
                  "id": "many_starts",
                  "text": "Counting or optimizing may require information about several earlier boundaries."
                },
                {
                  "id": "first_valid_only",
