                  "O(qn)",
                  "O(n²)"
                ],
                "sort_time": [
                  "O(n + q)",
                  "O(n log n + q log n)",
                  "O(qn)",
                  "O(n²)"
                ],
                "hash_auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(q)"
                ],
                "sort_auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(q)"
                ]
              },
              "acceptedValuesByDimension": {
                "hash_time": [
                  "O(n + q)"
                ],
                "sort_time": [
                  "O(n log n + q log n)"
                ],
                "hash_auxiliary_space": [
                  "O(n)"
                ],
                "sort_auxiliary_space": [
                  "O(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "hash_time": {
                  "expected_build_and_queries": "O(n + q)"
                },
                "sort_time": {
                  "sort_and_binary_queries": "O(n log n + q log n)"
                },
                "hash_auxiliary_space": {
                  "table_entries": "O(n)"
                },
                "sort_auxiliary_space": {
                  "sort_stack": "O(log n)"
                }
              },
              "maxPoints": 4
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 4
            },
            "feedback": {
              "reason": "The lookup signal favors expected hash time, while sorting offers an ordered representation and lower stated auxiliary memory under these assumptions.",
              "details": "This calculation does not make hashing universally preferable; output order, mutation, guarantees, and key-operation costs can change the decision."
            },
            "taxonomy": {
