          {
            "id": "algorithms-intervals-sweep-009",
            "prompt": "Inclusive integer interval [l, r] must be processed by a half-open difference sweep. Which conversion is correct when r + 1 is safely representable?",
            "constraints": [
              "The domain is discrete integers.",
              "The sweep should count every integer l through r."
