        ],
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "counterexample_refutes_rule",
              "text": "The rule takes 4+1+1 using three coins, while 3+3 uses two, so the local choice property is absent for this denomination system."
            },
            {
              "id": "largest_is_always_safe",
              "text": "Taking 4 is safe because it reduces the remaining amount more than any other coin."
            },
            {
              "id": "sorting_fix",
              "text": "Sorting denominations in descending order makes the same choice correct."
            },
            {
              "id": "greedy_equals_dp",
              "text": "The result is still optimal because greedy and dynamic programming are interchangeable methods."
            }
          ],
          "acceptedOptionIds": [
