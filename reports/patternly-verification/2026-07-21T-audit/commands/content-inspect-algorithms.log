          {
            "id": "alg-mg-geometry-vertical-line-predicate",
            "prompt": "A point-on-line test must handle a vertical line through A and B. Which predicate avoids an unsafe special-case slope?",
            "constraints": [
              "A and B are distinct.",
              "Coordinates are exact integers in a safe width."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "cross_zero",
                  "text": "Test cross(B-A, P-A)==0."
                },
                {
                  "id": "slope_equals",
                  "text": "Test (Py-Ay)/(Px-Ax) == (By-Ay)/(Bx-Ax)."
                },
                {
                  "id": "x_only",
                  "text": "Test only Px==Ax for every line direction."
                },
                {
                  "id": "infinite_slope_token",
                  "text": "Assign a floating infinity slope and compare it with ==."
                }
              ],
              "acceptedOptionIds": [
                "cross_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The determinant handles every line orientation with one exact predicate and no division by a zero x-difference.",
              "details": "For a vertical line, Bx-Ax is zero, so slope division is undefined. The cross product tests whether P-A is linearly dependent with B-A and works equally for horizontal and diagonal lines. Testing x alone is valid only after the line is known vertical, and an infinity token does not solve general exact comparison. Segment membership would add a bounding check after collinearity.",
              "wrongOptionExplanationsByOptionId": {
                "slope_equals": "The baseline denominator is zero, so the expression is undefined.",
                "x_only": "That is a vertical-only shortcut and would accept wrong points for nonvertical lines.",
                "infinite_slope_token": "Floating infinity is an implementation artifact, not a general exact line predicate."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "diagnose_degenerate_or_precision_case",
              "secondarySkillAtomIds": [],
