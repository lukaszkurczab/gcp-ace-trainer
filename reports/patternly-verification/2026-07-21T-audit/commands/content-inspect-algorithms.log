        "items": [
          {
            "id": "alg-stack-ops-01-trace-mixed-operations",
            "prompt": "A stack starts empty and performs push(4), push(9), top(), pop(), push(2), top(). What value is returned by the final top()?",
            "constraints": [
              "top() returns the current top without removing it.",
              "pop() removes the current top."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_2",
                  "text": "2"
                },
                {
                  "id": "value_4",
                  "text": "4"
                },
                {
                  "id": "value_9",
                  "text": "9"
                }
              ],
              "acceptedOptionIds": [
                "value_2"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "After 9 is popped, pushing 2 makes 2 the new top.",
              "details": "The stack evolves as [] → [4] → [4, 9]. The first top reads 9 but leaves the stack unchanged; pop then removes 9, producing [4]. Pushing 2 yields [4, 2], so the final top is 2. The trace depends on operation semantics, not on retaining every value ever seen.",
              "wrongOptionExplanationsByOptionId": {
                "value_4": "4 remains below the top. It becomes visible only after 2 is removed.",
                "value_9": "9 was removed by pop. A popped entry is not still available unless it is pushed again."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_stack_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            }
          },
          {
            "id": "alg-stack-ops-02-safe-read-and-remove",
            "prompt": "Order the steps for safely reading and removing the current top when top() and pop() are separate operations.",
            "constraints": [
              "The stack may be empty.",
              "pop() does not return the removed value."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_nonempty",
                  "text": "Check that the stack is not empty."
                },
                {
                  "id": "read_top",
                  "text": "Read the value with top()."
                },
                {
                  "id": "remove_top",
                  "text": "Remove the value with pop()."
                }
              ],
              "canonicalOrder": [
                "check_nonempty",
                "read_top",
                "remove_top"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The empty check must precede access, and the value must be read before pop removes it.",
              "details": "Reading or removing from an empty stack violates the operation precondition. Because pop does not return the value in this contract, reading after removal would expose the next entry or underflow instead of the intended one. The adjacent relations check nonempty → read top and read top → remove top capture the decisive dependencies."
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_stack_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            }
          },
          {
            "id": "alg-stack-ops-03-top-is-nonmutating",
            "prompt": "A stack contains [A, B, C] with C on top. The program calls top() twice and performs no other operation. Which state is correct afterward?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "unchanged",
                  "text": "The stack is still [A, B, C], and both calls return C."
                },
                {
                  "id": "one_removed",
                  "text": "The stack is [A, B], because the first top() consumed C."
                },
                {
                  "id": "two_removed",
                  "text": "The stack is [A], because each top() removes one entry."
                }
              ],
              "acceptedOptionIds": [
                "unchanged"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "top() is an observation operation; only pop() changes the stack.",
              "details": "Both top calls inspect C, and neither changes the number or order of entries. Treating top as destructive silently skips data in later processing. Some APIs name a destructive read pop(), but the prompt fixes the contract explicitly, so the method name and stated semantics control the trace.",
              "wrongOptionExplanationsByOptionId": {
                "one_removed": "This confuses top with pop. It would be valid only under an API whose peek operation is explicitly destructive.",
                "two_removed": "Repeated observation does not remove entries. Two removals require two pop operations."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_stack_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            }
          },
          {
            "id": "alg-stack-ops-04-empty-stack-boundary",
            "prompt": "A parser receives a closing token while its stack of open contexts is empty. What is the correct primitive-stack conclusion before any matching logic?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "reject_underflow",
                  "text": "Reject the operation or return the defined empty-stack result without mutating state."
                },
                {
                  "id": "pop_default",
                  "text": "Pop a default opening token so the scan can continue."
                },
                {
                  "id": "switch_to_recursion",
                  "text": "Switch to recursion and treat the current call frame as a fabricated top value."
                }
              ],
              "acceptedOptionIds": [
                "reject_underflow"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "An empty stack has no top; access or removal must be rejected rather than replaced with invented state.",
              "details": "Underflow is a real boundary, not a request for a fallback value. Creating a default opener would turn malformed input into an apparently valid trace. Recursion also cannot supply a missing unresolved context. Higher-level matching may attach a domain error, but the primitive fact is that top and pop are unavailable on an empty stack.",
              "wrongOptionExplanationsByOptionId": {
                "pop_default": "A default value hides the missing state and changes correctness. Defaults are valid only when the domain contract explicitly defines one.",
                "switch_to_recursion": "Recursive control flow does not create a legitimate stack entry. The input is missing the required prior opener."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_stack_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "problemArchetypeId": "validate_nested_structure"
            }
          },
          {
            "id": "alg-stack-ops-05-entry-removed-once",
            "prompt": "A particular stack entry E is pushed once and later popped. Without pushing E again, how many additional times can that same entry be popped?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero_additional",
                  "text": "Zero; E is no longer in the stack."
                },
                {
                  "id": "one_additional",
                  "text": "One more time because every entry supports two removals."
                },
                {
                  "id": "unbounded",
                  "text": "Any number of times while a loop keeps checking the top."
                }
              ],
              "acceptedOptionIds": [
                "zero_additional"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A pop removes one concrete entry permanently; that entry cannot be removed again without a new push.",
              "details": "The stack may execute many pop operations overall, and one iteration may pop several different entries. That does not mean a single entry is popped repeatedly. The identity-level lifecycle is push once, remain pending for some time, then pop once. This fact later limits total work in amortized stack algorithms.",
              "wrongOptionExplanationsByOptionId": {
                "one_additional": "There is no second copy of E after the first pop. Another removal would require another push.",
                "unbounded": "A loop may continue with new top entries, but those are different entries. Rechecking the stack does not resurrect E."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_stack_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            }
          },
          {
            "id": "alg-stack-ops-06-stack-versus-queue-trace",
            "prompt": "Three labels A, B, and C are inserted in that order. The required removal order is C, then B, then A. Which state discipline satisfies the trace?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "stack_lifo",
                  "text": "A stack using push and pop."
                },
                {
                  "id": "queue_fifo",
                  "text": "A queue using enqueue and dequeue."
                },
                {
                  "id": "either_equivalent",
                  "text": "Either structure; removal order is an implementation detail."
                }
              ],
              "acceptedOptionIds": [
                "stack_lifo"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "C, B, A is the reverse of insertion order, so the required discipline is LIFO.",
              "details": "A stack exposes the newest label first and produces C, B, A. A queue exposes the oldest label and would produce A, B, C. Both structures support insertion and removal, but their ordering contracts are semantically different. No recursion assumption is needed to choose between them.",
              "wrongOptionExplanationsByOptionId": {
                "queue_fifo": "A queue would return A first. It becomes correct only when insertion order must be preserved.",
                "either_equivalent": "The specified trace makes order material. Interchanging the structures changes the observable result."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_stack_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            }
          }
        ],
