        "feedback": {
          "reason": "Random interval queries need a representation independent of one current boundary pair.",
          "details": "With P[i + 1] = P[i] + a[i], rangeSum(l, r) = P[r + 1] - P[l].",
          "wrongOptionExplanationsByOptionId": {
