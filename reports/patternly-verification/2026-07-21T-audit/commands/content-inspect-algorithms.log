          },
          {
            "id": "alg-sort-two-pointers-03-duplicate-occurrence-boundary",
            "prompt": "For target 10, which input can legally satisfy a sorted two-pointer search using value 5 twice?",
            "constraints": [
              "A pair must use two distinct array positions.",
              "Equal values are allowed when they come from separate occurrences."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "empty",
                  "text": "[], because missing values are treated as zero."
                },
                {
                  "id": "one_five",
                  "text": "[5], because the same position can serve as both pointers."
                },
                {
                  "id": "two_fives",
                  "text": "[5, 5], because left and right reference distinct positions."
                },
                {
                  "id": "five_and_six",
                  "text": "[5, 6], because being close to the target is sufficient."
                }
              ],
              "acceptedOptionIds": [
                "two_fives"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equal values form a valid pair only when the pointers identify two distinct occurrences.",
              "details": "The left < right loop condition encodes the distinct-position contract. Two stored 5s can occupy different positions and sum to 10. A singleton cannot be reused unless the problem explicitly permits selecting one occurrence twice, which ordinary pair-sum contracts do not. Duplicate skipping, when added for unique-output variants, must not collapse the only two occurrences before their pair is considered.",
              "wrongOptionExplanationsByOptionId": {
                "one_five": "Using one index twice violates the distinct-occurrence requirement represented by left < right.",
                "empty": "The algorithm does not fabricate zero-valued elements or any missing occurrence.",
                "five_and_six": "The required relation is exact equality to 10, not nearest sum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "combine_sorting_with_pointer_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sort_then_two_pointers",
              "problemArchetypeId": "pair_search_after_sort"
            }
          },
          {
            "id": "alg-sort-two-pointers-04-deterministic-tie-traversal",
            "prompt": "A test harness requires a sort-based pair search to traverse equal-price records reproducibly. Any valid price pair is acceptable, but records tied on price must have a deterministic order. Which preprocessing rule satisfies that requirement without changing the pointer sum invariant?",
            "constraints": [
              "Each record has a unique recordId.",
              "Pointer comparisons use price only after sorting."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "random_ties",
                  "text": "Sort by price but randomly shuffle each equal-price block before searching."
                },
                {
                  "id": "price_only",
                  "text": "Sort by price only and assume tied records will always appear in the same order."
                },
                {
                  "id": "id_only",
                  "text": "Sort by recordId and use prices only in the sum comparison."
                },
                {
                  "id": "price_then_id",
                  "text": "Sort by (price, recordId), then run the price-based pointer search."
                }
              ],
              "acceptedOptionIds": [
                "price_then_id"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Record ID completes the tie order while price remains the primary monotone key used by pointer movement.",
              "details": "The pointer proof depends on prices being nondecreasing, so a secondary record ID does not disturb it. It does make the traversal and first encountered identity pair reproducible across implementations and input permutations. A price-only comparator can leave tie order to stability or prior order. Sorting primarily by ID destroys the monotone price sequence, while randomizing ties deliberately violates reproducibility.",
              "wrongOptionExplanationsByOptionId": {
                "price_only": "Comparator equality among distinct records leaves their relative order under-specified for the stated reproducibility contract.",
                "id_only": "Record-ID order does not make endpoint prices monotone, so the pointer elimination proof fails.",
                "random_ties": "Random tie order is the opposite of the deterministic traversal requirement."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "combine_sorting_with_pointer_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "custom_key_sort",
              "problemArchetypeId": "pair_search_after_sort"
            }
          },
          {
            "id": "alg-sort-two-pointers-05-original-index-output",
            "prompt": "A sort-then-two-pointer solution must return original array indices. Select all statements that are required for correctness.",
            "constraints": [
              "Duplicate values can occur.",
              "The returned indices must identify two distinct source occurrences."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "normalize_output_pair",
                  "text": "If the API requires ascending index order, normalize the two saved original indices before returning."
                },
                {
                  "id": "return_pointer_positions",
                  "text": "The current left and right positions in the sorted array are the requested original indices."
                },
                {
                  "id": "recover_by_value_only",
                  "text": "After finding values, search the original array by value without tracking which duplicate occurrences were used."
                },
                {
                  "id": "carry_original_index",
                  "text": "Each sorted occurrence must retain its original index or an equivalent stable identity."
                }
              ],
              "acceptedOptionIds": [
                "carry_original_index",
                "normalize_output_pair"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorted pointer positions are search state; the output must be reconstructed from preserved source identities and formatted to its own contract.",
              "details": "Decorated occurrences let pointer movement operate on sorted values while preserving the exact source positions. The output order may have a separate normalization rule, such as lower index first, that is unrelated to left and right in value order. Value-only recovery becomes ambiguous for duplicates and can accidentally return one occurrence twice. Identity must therefore survive from preprocessing through result construction.",
              "wrongOptionExplanationsByOptionId": {
                "return_pointer_positions": "Left and right index the transformed sequence, not the source array requested by the API.",
                "recover_by_value_only": "Duplicate values make occurrence recovery ambiguous and can violate the distinct-index contract."
              },
              "omittedCorrectExplanationsByOptionId": {
                "carry_original_index": "Without source identity attached to each occurrence, the sort destroys the required index mapping.",
                "normalize_output_pair": "Output formatting is a separate contract and may require reordering the two saved indices."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "combine_sorting_with_pointer_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sort_then_two_pointers",
              "problemArchetypeId": "pair_search_after_sort"
            }
          },
          {
            "id": "alg-sort-two-pointers-06-one-query-hash-alternative",
            "prompt": "For one unsorted pair-sum existence query, expected O(n) hash-set lookup is permitted, original order must remain unchanged, and O(n) auxiliary space is acceptable. Which strategy assessment is correct?",
            "constraints": [
              "Hash operations have the stated expected-time assumption.",
              "No later query reuses a sorted order."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_is_reasonable",
                  "text": "A hash-set scan is a reasonable O(n)-expected alternative; sorting is not automatically better."
                },
                {
                  "id": "sort_is_mandatory",
                  "text": "The use of two values means sorting and two pointers are mandatory."
                },
                {
                  "id": "quadratic_only",
                  "text": "Without mutating the input, only an O(n^2) pair enumeration is possible."
                },
                {
                  "id": "sort_is_linear",
                  "text": "Sorting is preferable because sort-then-two-pointers is O(n) overall."
                }
              ],
              "acceptedOptionIds": [
                "hash_is_reasonable"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The hash method meets the stated one-query and immutability constraints with a better expected time bound than comparison sorting.",
              "details": "Sort-then-two-pointers is a valid deterministic strategy when reordering or copying and O(n log n) time are acceptable. It is not universally dominant. Here a complement set preserves input order and answers the single query in expected linear time using the allowed memory. The decision could reverse under strict memory limits, adversarial hash requirements, or repeated operations that reuse sorted order.",
              "wrongOptionExplanationsByOptionId": {
                "sort_is_mandatory": "Pair structure does not prescribe one family; hash complement lookup is a complete competing mechanism.",
                "sort_is_linear": "Comparison sorting remains O(n log n), so the total pipeline is not linear under the stated assumptions.",
                "quadratic_only": "An auxiliary hash set preserves the input and avoids enumerating every pair."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "combine_sorting_with_pointer_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sort_then_two_pointers",
              "problemArchetypeId": "pair_search_after_sort"
            }
          },
          {
            "id": "alg-sort-two-pointers-07-sort-dominates-pointer-pass",
            "prompt": "An array may be reordered, and the result needs only pair values rather than source indices. A comparison sort is followed by one opposite-end pointer pass. What is the complete worst-case time complexity?",
            "constraints": [
              "The comparison sort has O(n log n) worst-case time.",
              "Each pointer moves inward at most n positions in total."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n^2)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {}
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "The opposite-end pass is linear, but the preceding comparison sort dominates the complete pipeline at O(n log n).",
              "details": "The two pointers move monotonically inward, so the search phase performs O(n) pointer advances. That fact does not erase preprocessing. Comparison sorting costs O(n log n), and O(n log n) + O(n) simplifies to O(n log n). The answer is intentionally time-only: source identity and defensive-copy space are outside this values-only, mutation-permitted contract."
            },
            "taxonomy": {
              "primarySkillAtomId": "combine_sorting_with_pointer_search",
