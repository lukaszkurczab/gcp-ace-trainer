        "items": [
          {
            "id": "alg-tree-choice-streaming-prefix-serialization",
            "prompt": "A serializer writes one token stream that a deserializer reads strictly from left to right. The deserializer must create each parent before recursively reading its left and right child encodings, and missing children must be reconstructible.\nWhich traversal contract matches this stream?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "preorder_with_null_markers",
                  "text": "Write the current node first, then the left and right encodings, and write an explicit null marker for every missing child."
                },
                {
                  "id": "inorder_without_markers",
                  "text": "Write the left subtree, current node, and right subtree without null markers."
                },
                {
                  "id": "postorder_forward_only",
                  "text": "Write both children before the parent and require the forward-only reader to create the parent first."
                },
                {
                  "id": "bfs_values_only",
                  "text": "Write only non-null values in level order and infer all missing positions from value order."
                }
              ],
              "acceptedOptionIds": [
                "preorder_with_null_markers"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Parent-first streaming requires preorder, and explicit null tokens preserve where each recursive child slot is absent.",
              "details": "The reader consumes a node token, creates that node, then recursively consumes exactly one left encoding and one right encoding. A null marker is itself a complete empty-subtree encoding, so arbitrary shape remains unambiguous even when values repeat. Inorder values alone do not identify the root of a generic tree, and level-order values without position markers lose gaps. Postorder can support reconstruction when the decoder reads in reverse or buffers children, but that violates the stated forward parent-first contract.",
              "wrongOptionExplanationsByOptionId": {
                "inorder_without_markers": "Inorder alone does not identify the root or missing child positions for a generic binary tree. It can reconstruct a BST only with extra ordering assumptions and a declared duplicate policy.",
                "postorder_forward_only": "The parent token arrives after its children, so a forward-only parent-first reader cannot create the requested object at the required moment. Reverse reading or buffering would change the contract.",
                "bfs_values_only": "Without null-position information, different sparse shapes can produce the same value sequence. BFS serialization can work when it includes explicit missing slots and a finite trimming rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_tree_traversal_order",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "dfs_preorder",
