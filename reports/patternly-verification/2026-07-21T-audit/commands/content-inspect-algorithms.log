        ],
        "taxonomy": {
          "roadmapNodeId": "contrast_two_pointers_vs_sliding_window",
          "primaryMentalUnitId": "global_pair_search_vs_running_window",
          "patternFamilyId": "two_pointers"
        },
        "batchKind": "contrast",
        "contrastMetadata": {
          "contrastedMentalUnitIds": [
            "recognize_two_pointer_signal",
            "recognize_sliding_window_signal"
          ],
          "falseHeuristicId": "any_solution_with_two_indices_is_two_pointers",
          "transferBoundary": "Use pair search when pointer movement eliminates classes of endpoint pairs; use a running window when advancing the right boundary reuses state for contiguous candidates and the left boundary repairs validity."
        },
        "authoringProvenance": {
          "author": "OpenAI GPT-5.6 Pro — candidate authoring; human review required",
          "createdAt": "2026-07-18",
          "contentBatchId": "algorithms-contrast-two-pointers-vs-sliding-window-gpsrw-v1",
          "authoringMethod": "independently_authored"
        },
        "items": [
          {
            "id": "alg-ctpsw-gpsrw-01",
            "prompt": "In a sorted array, compare a[left] + a[right] with T. If the sum is too small, increment left; if it is too large, decrement right. No aggregate for the interior is stored. What search model is being used?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Use a two-pointers invariant."
                },
                {
                  "id": "sliding_window",
                  "text": "Use a sliding-window validity invariant."
                },
                {
                  "id": "indices_only",
                  "text": "Classify it as two pointers solely because two indices appear."
                }
              ],
              "acceptedOptionIds": [
                "two_pointers"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each comparison eliminates a class of endpoint pairs; there is no running contiguous candidate.",
              "details": "The state is the current pair of endpoints. Sorted order proves that a too-small sum cannot be fixed by keeping the smaller endpoint and choosing an even smaller partner, while a too-large sum cannot be fixed by keeping the larger endpoint and choosing an even larger partner. This is global pair-space elimination. A sliding window would instead carry forward state for [left, right] as right advances and would move left to repair a validity predicate for that range. The absence of an interior aggregate is not merely an implementation detail; it reflects a different candidate space.",
              "wrongOptionExplanationsByOptionId": {
                "sliding_window": "The endpoints enclose values, but the algorithm neither treats them as one candidate nor maintains range state. Movement eliminates endpoint pairs.",
                "indices_only": "Two indices describe the implementation, while sorted endpoint elimination supplies the actual classification."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_global_pair_search_from_running_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "Input is sorted in nondecreasing order.",
              "Only endpoint values are compared."
            ]
          },
          {
            "id": "alg-ctpsw-gpsrw-02",
            "prompt": "To find the longest substring containing at most K distinct characters, right advances one character at a time, a frequency map is updated, and left advances only until the current substring is valid again. Which model explains the linear scan?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Use a two-pointers invariant."
                },
                {
                  "id": "sliding_window",
                  "text": "Use a sliding-window validity invariant."
                },
                {
                  "id": "indices_only",
                  "text": "Classify it as two pointers solely because two indices appear."
                }
              ],
              "acceptedOptionIds": [
                "sliding_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each right step reuses and repairs state for the current contiguous substring.",
              "details": "The algorithm does not restart a search for every pair of indices. It carries a frequency map from one right endpoint to the next, adding the entering character and removing characters that leave from the left. That reuse is the running-window mechanism: candidates ending at successive right positions share almost all of their contents. The at-most-K predicate is also repairable by shrinking because removing characters cannot introduce a new distinct character. A global pair search would compare isolated endpoint relations rather than maintain the membership state of every character inside the range.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers": "Although two indices move, the decisive state is the frequency map for all characters in the current range.",
                "indices_only": "The variable count cannot explain why the algorithm is linear. Reused range state and validity repair do."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_global_pair_search_from_running_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "The candidate must be a contiguous substring.",
              "K is a nonnegative integer fixed for the task."
            ]
          },
          {
            "id": "alg-ctpsw-gpsrw-03",
            "prompt": "Which statement most directly distinguishes a global pair search from a running window?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "pair_elimination",
                  "text": "Pair search uses an endpoint comparison to eliminate impossible endpoint combinations; a window reuses state for a contiguous candidate and removes starts under a validity rule."
                },
                {
                  "id": "direction_only",
                  "text": "Pair search always moves inward, while a window always moves both indices to the right."
                },
                {
                  "id": "two_variables",
                  "text": "Pair search has two index variables, while a window has more than two state variables."
                },
                {
                  "id": "sorted_only",
                  "text": "Pair search requires sorted input, while a window never uses sorted input."
                }
              ],
              "acceptedOptionIds": [
                "pair_elimination"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The decisive distinction is how the algorithm reuses or eliminates candidate space, not pointer direction or variable count.",
              "details": "Both families can use same-direction pointers, and either may carry auxiliary state. What matters is the justification for not reconsidering candidates. In pair search, an endpoint relation—often supported by ordering—rules out a set of pairs. In a running window, the algorithm reuses state for contiguous candidates and advances left because earlier starts are invalid or dominated under the window rule. This proof-level distinction transfers to unfamiliar code more reliably than surface rules about direction, sorting, or the number of variables.",
              "wrongOptionExplanationsByOptionId": {
                "direction_only": "This is a common mnemonic but not a contract. Same-direction read/write two pointers exist, and some windows can have fixed width.",
                "two_variables": "Both families commonly use two indices and may use additional state. Variable count does not identify the candidate space.",
                "sorted_only": "Sortedness often supports pair elimination, but it is neither required by every two-pointers problem nor forbidden for windows."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_global_pair_search_from_running_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Assume either candidate may use two indices and auxiliary state; classify by candidate-space reasoning."
            ]
          },
          {
            "id": "alg-ctpsw-gpsrw-04",
            "prompt": "A sorted sequence is scanned from both ends to find the pair with sum closest to T. Each step evaluates only the two endpoint values and moves one endpoint according to whether the sum is below or above T. Is the shrinking span a sliding window?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_pair_search",
                  "text": "No. The span is the unresolved domain of endpoint pairs, not a maintained contiguous candidate."
                },
                {
                  "id": "yes_shrinking_window",
                  "text": "Yes. Any pair of boundaries that moves inward is a window."
                },
                {
                  "id": "yes_length_changes",
                  "text": "Yes. The distance right - left changes on every step."
                }
              ],
              "acceptedOptionIds": [
                "no_pair_search"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The enclosed span is search space, while the actual candidate is the endpoint pair.",
              "details": "A visual interval can represent different semantics. Here the algorithm does not score or validate every element in the interval. It uses the endpoints to form one pair and relies on order to choose which class of pairs can be discarded. Calling the unresolved domain a window would obscure the proof: no entering/leaving aggregate is maintained and no range-validity predicate is repaired. A changing width or inward motion is therefore insufficient evidence for sliding window.",
              "wrongOptionExplanationsByOptionId": {
                "yes_shrinking_window": "Boundary motion alone is not a window invariant. The interior values are not maintained as one candidate.",
                "yes_length_changes": "Changing interval length is a visual property, not the algorithm's candidate or proof obligation."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_global_pair_search_from_running_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Only endpoint values contribute to each evaluated candidate."
            ]
          },
          {
            "id": "alg-ctpsw-gpsrw-05",
            "prompt": "An original task asks whether two sorted values differ by exactly D. A revised task asks for the longest contiguous segment whose maximum minus minimum is at most D, and supplies data structures that maintain the segment extrema as right advances. Which structural change requires a running-window model?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "range_reuse",
                  "text": "The revised candidate is a contiguous segment whose maintained extrema are reused across successive right endpoints."
                },
                {
                  "id": "same_threshold",
                  "text": "Both tasks compare a quantity with D."
                },
                {
                  "id": "two_boundaries",
                  "text": "Both implementations may use left and right."
                },
                {
                  "id": "optimization_word",
                  "text": "The word longest appears in the revised task."
                }
              ],
              "acceptedOptionIds": [
                "range_reuse"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The revised task introduces a reusable contiguous candidate with state owned by the entire range.",
              "details": "The threshold D is shared, but the candidate space is not. The original task evaluates a relation between two selected values. The revised task evaluates every member of a contiguous segment through its extrema and reuses that state as the segment expands and shrinks. The word “longest” alone is not decisive; longest-pair-distance problems still exist. The decisive change is that the answer and validity belong to a running interval, allowing successive candidates to share maintained state.",
              "wrongOptionExplanationsByOptionId": {
                "same_threshold": "Sharing a numeric threshold does not preserve the same candidate space or invariant.",
                "two_boundaries": "Both patterns can use these variables. The revised range state, not the names, drives the change.",
                "optimization_word": "Optimization wording is not enough; the relevant fact is that the entire contiguous segment is maintained."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_global_pair_search_from_running_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "advanced",
            "constraints": [
              "The revised segment must preserve original-order contiguity.",
              "The maintained extrema represent all elements currently in the segment.",
              "D is nonnegative."
            ]
          }
        ],
