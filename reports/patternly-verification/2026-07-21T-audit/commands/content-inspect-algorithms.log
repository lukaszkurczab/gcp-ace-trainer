        "items": [
          {
            "id": "alg-binary-search-monotonic-001",
            "prompt": "Which truth pattern is valid for a first-true binary search over increasing candidates?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "false_then_true",
                  "text": "false, false, ..., false, true, true, ..., true."
                },
                {
                  "id": "alternating",
                  "text": "false, true, false, true."
                },
                {
                  "id": "true_false_true",
                  "text": "true, false, true."
                },
                {
                  "id": "arbitrary",
                  "text": "Any pattern, because indices are ordered."
                }
              ],
              "acceptedOptionIds": [
                "false_then_true"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A first-true search requires one false-to-true transition.",
              "details": "Evaluating a midpoint then proves either that the boundary is at or left of mid, or strictly right of mid.",
              "wrongOptionExplanationsByOptionId": {
                "alternating": "Multiple transitions do not define one boundary.",
                "true_false_true": "Truth cannot return after becoming false in a single-boundary search.",
                "arbitrary": "Ordered indices do not make an arbitrary predicate monotonic."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_monotonic_predicate",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "monotonic_predicate_search",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-monotonic-002",
            "prompt": "Which truth pattern supports a last-true search?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "true_then_false",
                  "text": "true, true, ..., true, false, false, ..., false."
                },
                {
                  "id": "false_then_true",
                  "text": "false values followed by true values."
                },
                {
