        "items": [
          {
            "id": "alg-contrast-window-prefix-hash-001",
            "prompt": "While scanning arbitrary signed values, currentPrefix is p. Which earlier prefix value proves that a subarray ending here has exact sum k?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "p_minus_k",
                  "text": "p - k."
                },
                {
                  "id": "p_plus_k",
                  "text": "p + k."
                },
                {
                  "id": "k_only",
                  "text": "Only prefix value k."
                },
                {
                  "id": "zero_only",
                  "text": "Only prefix value 0."
                }
              ],
              "acceptedOptionIds": [
                "p_minus_k"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "For boundaries j < i, prefix[i] - prefix[j] = k exactly when prefix[j] = prefix[i] - k.",
              "details": "A hash lookup converts that algebraic condition into an expected constant-time state query.",
              "wrongOptionExplanationsByOptionId": {
                "p_plus_k": "That would make the subarray sum -k.",
                "k_only": "The required earlier value depends on the current prefix.",
                "zero_only": "That recognizes only intervals starting at index 0 when p = k."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_prefix_hash_state_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-hash-002",
            "prompt": "The result asks for the number of exact-sum-k subarrays. What should the prefix hash table store?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frequency",
                  "text": "The frequency of each previously seen prefix value."
                },
                {
                  "id": "existence_only",
                  "text": "Only whether each prefix occurred."
                },
                {
                  "id": "latest_only",
                  "text": "Only the latest index of each prefix."
                },
                {
                  "id": "sorted_values",
                  "text": "The input values sorted ascending."
                }
              ],
              "acceptedOptionIds": [
                "frequency"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Every earlier occurrence of p - k contributes one matching start boundary.",
              "details": "The number of such occurrences must be added to the answer.",
              "wrongOptionExplanationsByOptionId": {
                "existence_only": "One prefix value may occur at several start boundaries, each defining a different subarray.",
                "latest_only": "That loses additional valid starts needed for counting.",
                "sorted_values": "Sorting destroys contiguous boundaries."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_prefix_hash_state_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-hash-003",
            "prompt": "The result asks for the longest exact-sum-k subarray. Which prefix metadata is most useful?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "earliest_index",
                  "text": "The earliest index at which each prefix value occurred."
                },
                {
                  "id": "frequency_only",
                  "text": "Only the number of times each prefix occurred."
                },
                {
                  "id": "latest_index",
                  "text": "Always overwrite with the latest index."
                },
                {
                  "id": "current_window",
                  "text": "Only one left pointer chosen from sum comparisons."
                }
              ],
              "acceptedOptionIds": [
                "earliest_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "For a fixed ending index, the longest interval uses the earliest matching prefix boundary.",
              "details": "The map should preserve the first occurrence rather than overwrite it.",
              "wrongOptionExplanationsByOptionId": {
                "frequency_only": "A count does not identify the farthest start boundary.",
                "latest_index": "A later start makes the resulting interval shorter.",
                "current_window": "Mixed signs provide no safe comparison direction."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_prefix_hash_state_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-hash-004",
            "prompt": "Why is prefix value 0 usually seeded before scanning for exact-sum subarrays?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_zero",
                  "text": "It represents the boundary before index 0, allowing intervals that begin at the first element."
                },
                {
                  "id": "avoid_negative",
                  "text": "It prevents prefix sums from becoming negative."
                },
                {
                  "id": "sort_prefix",
                  "text": "It keeps hash iteration ordered."
                },
                {
                  "id": "one_based_only",
                  "text": "It forces all arrays to use one-based indexing."
                }
              ],
              "acceptedOptionIds": [
                "start_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "If the running prefix itself equals k, then runningPrefix - k equals 0.",
              "details": "The seeded boundary lets that interval be detected without a separate special case.",
              "wrongOptionExplanationsByOptionId": {
                "avoid_negative": "Prefix values may still be negative.",
                "sort_prefix": "Seeding does not sort a table.",
                "one_based_only": "It is a boundary convention, not an array-index restriction."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_prefix_hash_state_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-hash-005",
            "prompt": "For counting non-empty exact-sum-k subarrays, why is the current prefix normally queried before its frequency is incremented?",
