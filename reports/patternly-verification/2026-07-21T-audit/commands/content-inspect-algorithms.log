        "items": [
          {
            "id": "alg-dpintro-two-d-01-independent-coordinates",
            "prompt": "Which scenario most directly requires a state dp(i, j)?",
            "constraints": [
              "The goal is to model the unresolved problem without compression."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_suffixes",
                  "text": "A solver compares suffix a[i:] with suffix b[j:], and either index may advance independently."
                },
                {
                  "id": "single_suffix",
                  "text": "A solver processes one suffix s[i:] and no other history affects future choices."
                },
                {
                  "id": "fixed_window",
                  "text": "A solver computes a fixed formula for each i using only the previous scalar result."
                }
              ],
              "acceptedOptionIds": [
                "two_suffixes"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Independent movement through two suffixes creates distinct subproblems for each reachable pair (i, j).",
              "details": "A state coordinate is needed for each variable that can change independently and alter the future. In alignment, a transition may advance i, j, or both, so one coordinate cannot reconstruct the other. A one-suffix recurrence lacks that second axis. Overlap may occur among pairs, but the two-dimensional model comes from state sufficiency rather than from overlap alone.",
              "wrongOptionExplanationsByOptionId": {
                "single_suffix": "A single independently varying suffix boundary is naturally one-dimensional.",
                "fixed_window": "The described future state has one progress coordinate and one live aggregate, not two independent subproblem axes."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_two_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "sequence_alignment_intro"
            }
          },
          {
            "id": "alg-dpintro-two-d-02-same-row-different-column",
            "prompt": "Why cannot dp(i) replace dp(i, j) in a two-string alignment recurrence?",
            "constraints": [
              "j is not determined by i.",
              "Different j values expose different suffixes of the second string."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_arrays_rule",
                  "text": "Any problem with two arrays must use exactly two DP dimensions."
                },
                {
                  "id": "memory_speed",
                  "text": "A one-dimensional table is always slower than a two-dimensional table."
                },
                {
                  "id": "different_suffix_pairs",
                  "text": "The same i can be paired with different j values whose remaining matches and optimal alignment lengths differ."
                }
              ],
              "acceptedOptionIds": [
                "different_suffix_pairs"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Omitting j merges distinct second-string suffixes under one cache or table entry.",
              "details": "For a fixed i, one state may compare a[i:] with b[2:] and another with b[7:]. Their legal matches and result can differ, so they are not future-equivalent. The need for two dimensions follows from independent progress, not simply from having two arrays. A later rolling-row optimization can reduce physical storage while retaining the logical pair.",
              "wrongOptionExplanationsByOptionId": {
                "two_arrays_rule": "Two inputs do not mechanically imply two dimensions; dimensions follow independent future-relevant state variables.",
                "memory_speed": "The failure is semantic state collision, not a universal performance relationship."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_two_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "sequence_alignment_intro"
            }
          },
          {
            "id": "alg-dpintro-two-d-03-dense-grid-evaluation-choice",
            "prompt": "A grid recurrence reaches every one of R × C cells and does O(1) work per cell. Which comparison is accurate?",
            "constraints": [
              "Both implementations use correct identical state and transition semantics."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "tab_exponential",
                  "text": "Tabulation examines all paths explicitly and is exponential."
                },
                {
                  "id": "same_asymptotic",
                  "text": "Memoization and tabulation both take O(RC) time; constants, stack depth, and locality determine practical differences."
                },
                {
                  "id": "memo_linear",
                  "text": "Memoization takes O(R + C) because it follows paths rather than cells."
                }
              ],
              "acceptedOptionIds": [
                "same_asymptotic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Dense reachability makes the number of distinct computed states Θ(RC) for both evaluation strategies.",
              "details": "Memoization collapses repeated path prefixes into one result per cell, while tabulation writes each cell once. Both therefore perform Θ(RC) constant-time transitions. Top-down may use recursion and hash or table lookup; bottom-up can use contiguous loops and known boundaries. The two-dimensional state model does not privilege memoization by itself.",
              "wrongOptionExplanationsByOptionId": {
                "memo_linear": "Although each path has that length, the memoized solver still evaluates every distinct reachable cell once.",
                "tab_exponential": "Tabulation aggregates path counts per cell rather than enumerating complete paths."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_two_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "grid_path_dp"
            }
          },
          {
            "id": "alg-dpintro-two-d-04-boundaries-before-interior",
            "prompt": "Order the construction of a prefix-based two-string DP table.",
            "constraints": [
              "Interior cell (i, j) reads smaller-coordinate neighbors.",
              "The answer is at (m, n)."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "allocate",
                  "text": "Allocate rows 0..m and columns 0..n."
                },
                {
                  "id": "initialize_boundaries",
                  "text": "Initialize the empty-prefix row and column."
                },
                {
                  "id": "fill_interior",
                  "text": "Fill cells with increasing i and j so all predecessor cells are ready."
                },
                {
                  "id": "read_terminal",
                  "text": "Read dp[m][n]."
                }
              ],
              "canonicalOrder": [
                "allocate",
                "initialize_boundaries",
                "fill_interior",
                "read_terminal"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The empty-prefix boundaries are dependencies of the first interior cells and must be established before row-major filling.",
              "details": "A two-dimensional table includes boundary states where one or both prefixes are empty. Those states encode the recurrence's terminal semantics and seed all later cells. Increasing coordinates then form a topological order for above, left, and diagonal-up-left dependencies. Only after the terminal coordinate is finalized does it represent the complete input pair."
            },
            "taxonomy": {
              "primarySkillAtomId": "model_two_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "sequence_alignment_intro"
            }
          },
          {
            "id": "alg-dpintro-two-d-05-row-compression-condition",
            "prompt": "When is replacing a full m × n table with previous/current rows justified?",
            "constraints": [
              "Rows are evaluated in increasing order.",
              "The output contract is known."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bounded_rows_no_history",
                  "text": "Every transition reads only the current and immediately previous row, and no later consumer needs older rows."
                },
                {
                  "id": "always_two_d",
                  "text": "Whenever the logical state has two coordinates."
                },
                {
                  "id": "same_values_somewhere",
                  "text": "Whenever the final optimum value appears in the last row."
                }
              ],
              "acceptedOptionIds": [
                "bounded_rows_no_history"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Compression follows row liveness and output requirements, not the mere existence of a two-dimensional state.",
              "details": "If no transition ever reads beyond the previous row, older rows become dead after the next row is complete. They may be discarded when the final output also does not need them for tracing or queries. One-row compression requires an additional proof about in-place old and new versions. A recurrence with longer-range rows or full-table reconstruction breaks this boundary.",
              "wrongOptionExplanationsByOptionId": {
                "always_two_d": "Logical dimensionality alone does not limit dependency distance or reconstruction needs.",
                "same_values_somewhere": "The final location does not prove that intermediate updates can be computed without older rows."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_two_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "state_compression",
              "problemArchetypeId": "sequence_alignment_intro"
            }
          },
          {
            "id": "alg-dpintro-two-d-06-first-row-column-semantics",
            "prompt": "dp(i, j) is the minimum insertions and deletions needed to transform prefix a[:i] into b[:j]. Which boundary initialization is correct?",
            "constraints": [
              "Replacing a character is not an allowed single operation.",
              "Inserting or deleting one character costs 1."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "all_zero",
                  "text": "Set the whole first row and first column to 0 because one prefix is empty."
                },
                {
                  "id": "all_one",
                  "text": "Set every non-origin boundary cell to 1 because only one side is empty."
                },
                {
                  "id": "i_and_j",
                  "text": "dp(i, 0) = i and dp(0, j) = j."
                }
              ],
              "acceptedOptionIds": [
                "i_and_j"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Converting to empty deletes every source character, while converting from empty inserts every target character.",
              "details": "Boundary states are complete subproblems, not generic padding. dp(i, 0) needs i deletions and dp(0, j) needs j insertions; the origin is zero. These values seed the interior recurrence and encode the permitted operation costs. Uniform zero or one defaults would make longer empty-prefix transformations artificially cheap.",
              "wrongOptionExplanationsByOptionId": {
                "all_zero": "Transforming a nonempty prefix to or from empty requires one deletion or insertion per character.",
                "all_one": "The cost grows with the nonempty prefix length, not merely with the fact that it is nonempty."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_two_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "sequence_alignment_intro"
            }
          },
          {
            "id": "alg-dpintro-two-d-07-third-dimension-boundary",
            "prompt": "A grid solver tracks position (r, c) and may remove up to k blocked cells. Is dp(r, c) sufficient?",
            "constraints": [
              "The number of removals remaining changes which future cells can be entered.",
              "Different paths can reach the same cell with different remaining removals."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "overlap_removes_resource",
                  "text": "Yes. Because paths overlap at a cell, their resource histories can be merged."
                },
                {
                  "id": "need_resource",
                  "text": "No. The state must also distinguish remaining removals, such as dp(r, c, remaining)."
                },
                {
                  "id": "position_enough",
                  "text": "Yes. A grid is two-dimensional, so row and column always define the DP state."
                }
              ],
              "acceptedOptionIds": [
                "need_resource"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The same cell with different remaining removals has a different set of legal continuations.",
              "details": "Row and column identify location but not the solver's remaining capability. A path arriving with one removal left can cross a future obstacle that a path with zero cannot, so those states are not future-equivalent. The logical state is therefore augmented beyond two coordinates. This illustrates that '2D DP' describes a state model, not simply a 2D input layout.",
              "wrongOptionExplanationsByOptionId": {
                "position_enough": "Geometric dimension does not capture an independent resource that changes future choices.",
                "overlap_removes_resource": "Overlap permits merging only when complete future-relevant state components, including remaining removals, are equal."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_two_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "grid_path_dp"
            }
          }
        ],
