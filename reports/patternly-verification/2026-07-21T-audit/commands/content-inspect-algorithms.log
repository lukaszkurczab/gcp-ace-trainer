              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The temporary set and returned list have separate roles and parameters.",
              "details": "They may both be live near return, but auxiliary and output are reported separately."
