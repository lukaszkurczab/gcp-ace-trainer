          {
            "id": "alg-contrast-hash-sort-cost-019",
            "prompt": "Input is already sorted. Count equal runs and emit one record per distinct key. Select time and auxiliary space excluding output.",
            "constraints": [
              "The sorted-order precondition is guaranteed.",
              "Only current key and count are stored."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
