        "items": [
          {
            "id": "alg-hms-review-self-pair-after-insert",
            "prompt": "Pseudocode for distinct-index pair existence does: insert current into seen; then test whether target - current is in seen. On input [5] with target 10 it returns true. What is the primary defect?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "current_matches_itself",
                  "text": "The insertion makes the current occurrence available as its own prior partner."
                },
                {
                  "id": "set_needs_count",
                  "text": "Every pair-existence algorithm requires a full frequency map."
                },
                {
                  "id": "hash_too_slow",
                  "text": "The lookup is not expected O(1)."
                }
              ],
              "acceptedOptionIds": [
                "current_matches_itself"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The table includes the current occurrence before the lookup that is supposed to prove an earlier distinct partner.",
              "details": "The failing trace exposes an operation-order mismatch. The correct invariant is that seen contains only indices smaller than the current index. Compute and query the complement first, then insert the current value. This repair preserves distinctness without requiring a precomputed frequency table.",
              "wrongOptionExplanationsByOptionId": {
                "set_needs_count": "A prior-presence set is sufficient for one-pass existence when the check occurs before insertion; counts are not the primary defect.",
                "hash_too_slow": "Performance does not explain the false positive; the temporal invariant is wrong."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_hash_state_mismatch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "complement_lookup",
              "problemArchetypeId": "find_pair_with_condition"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-hms-review-set-used-for-count",
            "prompt": "An implementation uses a set to answer “which value appears most often?” It returns an arbitrary seen value. What is the primary state mismatch?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "multiplicity_missing",
                  "text": "The state preserves presence but not per-value multiplicity."
                },
                {
                  "id": "key_direction_wrong",
                  "text": "The map direction should be index to value."
                },
                {
                  "id": "sorting_required",
                  "text": "The input must be sorted before any frequency decision is possible."
                }
              ],
              "acceptedOptionIds": [
                "multiplicity_missing"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A set collapses every positive count to membership, so it cannot compare frequencies.",
              "details": "The algorithm’s output depends on the magnitude of count[value]. The state must therefore maintain numeric counts and an explicit tie rule if needed. The existing set can detect whether a value appeared, but that is a weaker function and cannot be repaired by changing iteration order.",
              "wrongOptionExplanationsByOptionId": {
                "key_direction_wrong": "There is no map payload at all; the missing information is count, not mapping direction.",
                "sorting_required": "Sorting is one alternative strategy, but a value-to-count map can solve the stated problem without sorting."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_hash_state_mismatch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-hms-review-lossy-grouping-key",
            "prompt": "Strings are grouped by character multiset, but the implementation uses string length as the map key. It merges “ab” and “cd”. What is the primary defect?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "lossy_equivalence_key",
                  "text": "The key omits character identity and therefore merges non-equivalent inputs."
                },
                {
                  "id": "bucket_payload_wrong",
                  "text": "The bucket should be a set instead of a list."
                },
                {
                  "id": "hash_collision_worst_case",
                  "text": "The hash table suffered an implementation collision that cannot be handled."
                }
              ],
              "acceptedOptionIds": [
                "lossy_equivalence_key"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The grouping key does not encode the full equivalence relation, so distinct classes are collapsed before hashing behavior matters.",
              "details": "A canonical key must be equal exactly when the grouping contract says two inputs are equivalent. Length is only a necessary condition for character-multiset equality, not a complete signature. Use a sorted-character key or canonical frequency vector under the stated alphabet.",
              "wrongOptionExplanationsByOptionId": {
                "bucket_payload_wrong": "Changing the bucket container cannot undo the fact that unrelated records were assigned the same semantic key.",
                "hash_collision_worst_case": "The merge is caused deliberately by equal length keys, not by a low-level hash collision; hash tables can distinguish unequal keys after collisions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_hash_state_mismatch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grouping_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-review-earliest-index-overwritten",
            "prompt": "A value-to-index map overwrites the stored index on every duplicate, but the result must use the earliest occurrence. Which repair is required?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "write_if_absent",
                  "text": "Keep the first stored index and ignore later replacements."
                },
                {
                  "id": "overwrite_faster",
                  "text": "Overwrite before the lookup instead of after it."
                },
                {
                  "id": "use_set",
                  "text": "Replace the map with a set of values."
                }
              ],
              "acceptedOptionIds": [
                "write_if_absent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The map shape is plausible, but its replacement policy contradicts the earliest-index invariant.",
              "details": "Hash-state bugs can live in payload semantics even when keys and lookups are correct. The required invariant is map[value] equals the minimum processed index, so only the first write should be retained. If the contract asked for the latest occurrence, unconditional overwrite would instead be appropriate.",
              "wrongOptionExplanationsByOptionId": {
                "overwrite_faster": "Moving the overwrite does not preserve earliest provenance; the payload still becomes a later index.",
                "use_set": "A set removes the index payload entirely and makes the output even less reconstructable."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_hash_state_mismatch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "preserve_original_index"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-review-worst-case-claim",
            "prompt": "A code review states: “This algorithm is worst-case O(n) because each of its n hash operations is guaranteed O(1).” What correction is needed?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "expected_not_guaranteed",
                  "text": "Call the total expected O(n) under ordinary hashing assumptions, unless the implementation supplies a stronger worst-case guarantee."
                },
                {
                  "id": "total_constant",
                  "text": "Call the entire algorithm O(1) because every operation is constant."
                },
                {
                  "id": "always_quadratic",
                  "text": "Call it O(n^2) for every input because collisions exist."
                }
              ],
              "acceptedOptionIds": [
                "expected_not_guaranteed"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The aggregate linear result is expected, while the premise of guaranteed worst-case constant hash operations is too strong.",
              "details": "A precise review separates the operation count from the operation model. The loop executes O(n) table operations. Under ordinary distribution and load assumptions, each is expected O(1), giving expected O(n). A different worst-case bound requires implementation-specific evidence or a different data structure.",
              "wrongOptionExplanationsByOptionId": {
                "total_constant": "Repeating constant expected work n times still yields linear total work, not constant total work.",
                "always_quadratic": "A possible collision worst case does not make every execution quadratic; expected analysis remains valid under its stated assumptions."
              }
            },
