              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Counting subsets alone understates materialization cost.",
              "details": "Total stored element occurrences are n·2^(n - 1)."
