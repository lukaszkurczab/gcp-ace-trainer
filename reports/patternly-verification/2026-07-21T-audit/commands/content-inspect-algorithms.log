        "items": [
          {
            "id": "alg-bits-xor-001",
            "prompt": "What is x XOR x for any fixed-width bit pattern x?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero",
                  "text": "A word of all zeros."
                },
                {
                  "id": "x",
                  "text": "x."
                },
                {
                  "id": "all_ones",
                  "text": "A word of all ones."
                },
                {
                  "id": "complement",
                  "text": "The complement of x."
                }
              ],
              "acceptedOptionIds": [
                "zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each bit XOR itself is zero.",
              "details": "This self-cancellation identity is the basis of pair cancellation.",
              "wrongOptionExplanationsByOptionId": {
                "x": "XOR with zero preserves x; XOR with itself cancels.",
                "all_ones": "Equal bits produce zero under XOR.",
                "complement": "Complement is XOR with an all-ones mask, not with x itself."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-002",
            "prompt": "What is x XOR 0?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "x",
                  "text": "x."
                },
                {
                  "id": "zero",
                  "text": "0."
                },
                {
                  "id": "complement",
                  "text": "The complement of x."
                },
                {
                  "id": "one",
                  "text": "1."
                }
              ],
              "acceptedOptionIds": [
                "x"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Zero is the identity element for XOR.",
              "details": "At every position, bit XOR 0 equals the original bit.",
              "wrongOptionExplanationsByOptionId": {
                "zero": "Only x XOR x cancels to zero.",
                "complement": "XOR with zero leaves every bit unchanged.",
                "one": "There is no universal one result."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-003",
            "prompt": "Why can XOR operands be reordered when proving pair cancellation?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "commutative_associative",
                  "text": "XOR is commutative and associative."
                },
                {
                  "id": "numeric_sort",
                  "text": "XOR automatically sorts numeric values."
                },
                {
                  "id": "addition_rule",
                  "text": "XOR is ordinary addition."
                },
                {
                  "id": "same_width_only_order",
                  "text": "Fixed width forces one evaluation order."
                }
              ],
              "acceptedOptionIds": [
                "commutative_associative"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Reordering and regrouping bring equal values next to each other conceptually.",
              "details": "Each equal pair cancels to zero, and the zero identities disappear.",
              "wrongOptionExplanationsByOptionId": {
                "numeric_sort": "No sorting occurs.",
                "addition_rule": "Carries make ordinary addition different.",
                "same_width_only_order": "Width fixes patterns but not XOR grouping."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-004",
            "prompt": "Every array value appears exactly twice except one value that appears once. What does XOR of all values produce?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "unique_value",
                  "text": "The value that appears once."
                },
                {
                  "id": "zero",
                  "text": "Always zero."
                },
                {
                  "id": "sum",
                  "text": "The arithmetic sum of all values."
                },
                {
                  "id": "largest",
                  "text": "The largest value."
                }
              ],
              "acceptedOptionIds": [
                "unique_value"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Every duplicated bit pattern cancels with its equal partner.",
              "details": "The accumulator starts at zero, so the only uncancelled pattern is the unique value.",
              "wrongOptionExplanationsByOptionId": {
                "zero": "The unpaired value remains after pair cancellation.",
                "sum": "XOR does not propagate carries.",
                "largest": "Ordering is irrelevant to cancellation."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-005",
            "prompt": "What is the XOR reduction of an empty sequence when the accumulator starts at zero?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero",
                  "text": "0."
                },
                {
                  "id": "undefined",
                  "text": "Always undefined."
                },
                {
                  "id": "all_ones",
                  "text": "An all-ones word."
                },
                {
                  "id": "one",
                  "text": "1."
                }
              ],
              "acceptedOptionIds": [
                "zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Zero is the neutral element for XOR reduction.",
              "details": "An empty reduction leaves the initial accumulator unchanged.",
              "wrongOptionExplanationsByOptionId": {
                "undefined": "The identity accumulator defines the result.",
                "all_ones": "That is not the XOR identity.",
                "one": "No input bit toggles the zero accumulator."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-006",
            "prompt": "A value appears three times and every other value appears twice. What remains after XOR reduction?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "triple_value",
                  "text": "The value appearing three times."
                },
                {
                  "id": "zero",
                  "text": "Zero."
                },
                {
                  "id": "twice_value",
                  "text": "A value appearing twice."
                },
                {
                  "id": "count_three",
                  "text": "The number 3."
                }
              ],
              "acceptedOptionIds": [
                "triple_value"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "XOR preserves whether each identical pattern occurs an odd or even number of times.",
              "details": "Three copies reduce to one because two cancel and one remains.",
              "wrongOptionExplanationsByOptionId": {
                "zero": "Three is odd, so one copy remains after one pair cancels.",
                "twice_value": "Every even multiplicity cancels completely.",
                "count_three": "XOR reduction operates on bit patterns, not occurrence counts."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-007",
            "prompt": "What is 5 XOR 3 in binary arithmetic?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_6",
                  "text": "6."
                },
                {
                  "id": "value_8",
                  "text": "8."
                },
                {
                  "id": "value_2",
                  "text": "2."
                },
                {
                  "id": "value_15",
                  "text": "15."
                }
              ],
              "acceptedOptionIds": [
                "value_6"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "0101 XOR 0011 equals 0110.",
              "details": "XOR is addition without carries at each bit, not general arithmetic addition.",
              "wrongOptionExplanationsByOptionId": {
                "value_8": "8 is ordinary addition, not XOR.",
                "value_2": "This is not the bitwise XOR of 0101 and 0011.",
                "value_15": "OR of these values is 7, and XOR is 6."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-008",
            "prompt": "Can equal negative integers cancel under fixed-width two's-complement XOR?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "yes_same_pattern",
                  "text": "Yes. Equal negative integers have identical fixed-width bit patterns, and x XOR x is zero."
                },
                {
                  "id": "no_sign",
                  "text": "No. Sign bits can never cancel."
                },
                {
                  "id": "only_positive",
                  "text": "XOR cancellation works only for positive values."
                },
                {
                  "id": "only_unsigned",
                  "text": "The operands must be reinterpreted as unsigned numeric values first."
                }
              ],
              "acceptedOptionIds": [
                "yes_same_pattern"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Self-cancellation depends on equality of bit patterns, not on numeric sign.",
              "details": "The width must still be fixed so both patterns are comparable position by position.",
              "wrongOptionExplanationsByOptionId": {
                "no_sign": "Equal sign bits XOR to zero like every other equal bit.",
                "only_positive": "The identity is bit-pattern based.",
                "only_unsigned": "The stored bits can be XORed directly."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            },
            "constraints": [
              "All values use the same fixed-width two's-complement representation."
            ]
          },
          {
            "id": "alg-bits-xor-009",
            "prompt": "Which multiplicity contract is required for the basic one-unique XOR solution?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "all_pairs_one_single",
                  "text": "Every non-answer value occurs an even canceling number of times, typically exactly twice, and the answer occurs an odd number of times."
                },
                {
                  "id": "arbitrary_counts",
                  "text": "Every value may occur any number of times with no further structure."
                },
                {
                  "id": "sorted_only",
                  "text": "The values must be sorted."
                },
                {
                  "id": "positive_only",
                  "text": "Every value must be positive."
                }
              ],
              "acceptedOptionIds": [
                "all_pairs_one_single"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The algorithm isolates one odd-frequency pattern only under a matching multiplicity guarantee.",
              "details": "Without that contract, the aggregate XOR may represent several uncancelled values combined.",
              "wrongOptionExplanationsByOptionId": {
                "arbitrary_counts": "Multiple odd-frequency values would combine into an unrelated XOR.",
                "sorted_only": "Order is irrelevant.",
                "positive_only": "Equal fixed-width negative patterns cancel too."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-010",
            "prompt": "Exactly two values appear once and every other value appears twice. What does XOR of all values produce?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "xor_of_two",
                  "text": "The XOR of the two unique values, not either value individually."
                },
                {
                  "id": "first_unique",
                  "text": "The first unique value."
                },
                {
                  "id": "second_unique",
                  "text": "The second unique value."
                },
                {
                  "id": "zero",
                  "text": "Zero."
                }
              ],
              "acceptedOptionIds": [
                "xor_of_two"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Paired values cancel, leaving a XOR b.",
              "details": "A further partition by a differing set bit is needed to recover a and b separately.",
              "wrongOptionExplanationsByOptionId": {
                "first_unique": "XOR has no ordering information.",
                "second_unique": "The aggregate combines both.",
                "zero": "The two different unique patterns do not cancel."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-011",
            "prompt": "What does XOR reduction track for each bit position across a sequence?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "parity",
                  "text": "Whether that bit is set in an odd number of inputs."
                },
                {
                  "id": "count",
                  "text": "The exact number of set occurrences."
                },
                {
                  "id": "maximum",
                  "text": "The largest bit position seen."
                },
                {
                  "id": "union",
                  "text": "Whether the bit is set in at least one input."
                }
              ],
              "acceptedOptionIds": [
                "parity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each occurrence of a one toggles the accumulator bit.",
              "details": "An even number of toggles returns zero, while an odd number leaves one.",
              "wrongOptionExplanationsByOptionId": {
                "count": "XOR retains only parity, not the full count.",
                "maximum": "XOR is position-wise parity.",
                "union": "That is OR, not XOR."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-012",
            "prompt": "Which XOR identities are correct? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "self_zero",
                  "text": "x XOR x = 0."
                },
                {
                  "id": "zero_identity",
                  "text": "x XOR 0 = x."
                },
                {
                  "id": "commutative",
                  "text": "x XOR y = y XOR x."
                },
                {
                  "id": "idempotent",
                  "text": "x XOR x = x."
                }
              ],
              "acceptedOptionIds": [
                "self_zero",
                "zero_identity",
                "commutative"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "XOR forms a cancellation algebra with zero identity.",
              "details": "Its repeated application differs fundamentally from OR.",
              "wrongOptionExplanationsByOptionId": {
                "idempotent": "XOR is self-canceling, not idempotent."
              },
              "omittedCorrectExplanationsByOptionId": {
                "self_zero": "Equal bits cancel.",
                "zero_identity": "Zero preserves every bit.",
                "commutative": "Operand order does not matter."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-013",
            "prompt": "Which problem contracts can be solved directly by one XOR reduction? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "one_single_pairs",
                  "text": "One value occurs once and every other value occurs exactly twice."
                },
                {
                  "id": "one_odd_others_even",
                  "text": "Exactly one value has odd multiplicity and every other value has even multiplicity."
