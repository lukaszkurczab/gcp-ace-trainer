        "items": [
          {
            "id": "alg-contrast-window-prefix-negative-001",
            "prompt": "Why can a negative value invalidate the rule \"if the current sum is too large, move left rightward\"?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "removal_can_increase",
                  "text": "Removing a negative left value can increase the sum instead of decreasing it."
                },
                {
                  "id": "negative_not_contiguous",
                  "text": "Negative values cannot belong to contiguous intervals."
                },
                {
                  "id": "prefix_forbidden",
                  "text": "Prefix sums cannot contain negative totals."
                },
                {
                  "id": "left_never_moves",
                  "text": "A sliding window never moves its left boundary."
                }
              ],
              "acceptedOptionIds": [
                "removal_can_increase"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The simple shrink rule assumes removing an element changes the aggregate in a predictable direction.",
              "details": "With a negative outgoing value, shrinking can make the sum larger, so discarded intervals may still contain valid answers.",
              "wrongOptionExplanationsByOptionId": {
                "negative_not_contiguous": "Sign does not affect contiguity.",
                "prefix_forbidden": "Cumulative sums may be negative.",
                "left_never_moves": "Variable windows depend on left movement."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-002",
            "prompt": "Why can a negative incoming value invalidate the rule \"expand right to increase the sum\"?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "extension_can_decrease",
                  "text": "Adding the new value can decrease the current sum."
                },
                {
                  "id": "right_moves_left",
                  "text": "The right boundary begins moving backward."
                },
                {
                  "id": "array_unsorted",
                  "text": "Negative values make the array unsorted."
                },
                {
                  "id": "sum_undefined",
                  "text": "Sums containing negatives are undefined."
                }
              ],
              "acceptedOptionIds": [
                "extension_can_decrease"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Monotone window logic needs expansion and contraction to have known directional effects.",
              "details": "Negative values break that relationship even though boundaries still move forward.",
              "wrongOptionExplanationsByOptionId": {
                "right_moves_left": "The boundary can still move right; the aggregate direction is the problem.",
                "array_unsorted": "Sortedness is unrelated.",
                "sum_undefined": "They are ordinary numeric sums."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-003",
            "prompt": "The array is [4, -5, 6] and the target is an exact sum of 5. Which contiguous interval is a counterexample to discarding after the prefix sum drops?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "whole_array",
                  "text": "[4, -5, 6] sums to 5."
                },
                {
                  "id": "first_only",
                  "text": "[4] sums to 5."
                },
                {
                  "id": "last_only",
                  "text": "[6] sums to 5."
                },
                {
                  "id": "middle_last",
                  "text": "[-5, 6] sums to 5."
                }
              ],
              "acceptedOptionIds": [
                "whole_array"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A temporary decrease does not mean a later extension cannot reach the exact target.",
              "details": "This demonstrates why local sum direction is not a safe discard signal with negative values.",
              "wrongOptionExplanationsByOptionId": {
                "first_only": "It sums to 4.",
                "last_only": "It sums to 6.",
                "middle_last": "It sums to 1."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-004",
            "prompt": "A task asks whether any contiguous subarray has exact sum k, and values may be negative. Which state is generally appropriate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "prefix_lookup",
                  "text": "Track cumulative sums and test whether currentPrefix - k occurred earlier."
                },
                {
                  "id": "simple_window",
                  "text": "Use the rule shrink when sum > k and expand when sum < k."
                },
                {
                  "id": "sort_values",
                  "text": "Sort values and use two pointers."
                },
                {
                  "id": "positive_assumption",
                  "text": "Assume negative values cancel harmlessly."
                }
              ],
              "acceptedOptionIds": [
                "prefix_lookup"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A subarray from j to i has sum k exactly when prefix[i + 1] - prefix[j] = k.",
              "details": "A hash lookup for prefix[i + 1] - k does not rely on monotone value signs.",
              "wrongOptionExplanationsByOptionId": {
                "simple_window": "Neither comparison gives a legal direction when signs are mixed.",
                "sort_values": "Sorting destroys contiguous intervals.",
                "positive_assumption": "Their placement determines every interval sum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-005",
            "prompt": "The objective is the shortest subarray with sum at least k, and negative values are allowed. Which conclusion is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "simple_not_enough",
                  "text": "A simple two-boundary sum window is not justified; a prefix-based structure with stronger ordering may be needed."
                },
                {
                  "id": "same_positive_rule",
                  "text": "The ordinary positive-value shrink rule remains correct."
                },
                {
                  "id": "prefix_hash_always",
                  "text": "A frequency hash map alone always gives the shortest threshold interval."
                },
                {
                  "id": "sort_array",
                  "text": "Sort the array and use adjacent values."
                }
              ],
              "acceptedOptionIds": [
                "simple_not_enough"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Mixed signs destroy the simple threshold window's discard proof.",
              "details": "A known solution uses prefix sums with a monotonic deque, illustrating that prefix state may need an additional ordered invariant.",
              "wrongOptionExplanationsByOptionId": {
                "same_positive_rule": "Removing or adding values no longer changes the sum monotonically.",
                "prefix_hash_always": "Shortest-at-least queries require order-aware handling of prefix values and indices.",
                "sort_array": "Contiguity would be lost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-006",
            "prompt": "All values are strictly positive. Which property restores the simple threshold-window rule?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sum_monotonicity",
                  "text": "Extending right increases the sum, and removing left decreases it."
                },
                {
                  "id": "prefix_unique",
                  "text": "All prefix sums become identical."
                },
                {
                  "id": "indices_sorted",
                  "text": "Index values become sorted."
                },
                {
                  "id": "target_positive",
                  "text": "A positive target alone is sufficient even with negative inputs."
                }
              ],
              "acceptedOptionIds": [
                "sum_monotonicity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Positive values create a one-direction aggregate response to each boundary move.",
              "details": "That lets the algorithm prove when smaller or larger windows can be discarded.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_unique": "Positive values make prefixes strictly increasing, not identical.",
                "indices_sorted": "Indices are always ordered.",
                "target_positive": "The input sign constraint is decisive."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-007",
            "prompt": "All values are nonnegative and zeros are allowed. What changes for a threshold window?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "nondecreasing",
                  "text": "Expansion is nondecreasing and shrinking is nonincreasing, so monotonicity remains but equal-sum plateaus need careful loop conditions."
                },
                {
                  "id": "fully_broken",
                  "text": "Any zero breaks sliding-window correctness."
                },
                {
                  "id": "strict_only",
                  "text": "Every move changes the sum strictly."
                },
                {
                  "id": "prefix_required",
                  "text": "Prefix hashing becomes the only legal method."
                }
              ],
              "acceptedOptionIds": [
                "nondecreasing"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Zeros preserve directional monotonicity but remove strict progress in the aggregate value.",
              "details": "Boundary indices must still move, and answer timing must handle equal-sum intervals correctly.",
              "wrongOptionExplanationsByOptionId": {
                "fully_broken": "Zero does not reverse sum direction.",
                "strict_only": "Adding or removing zero can leave it unchanged.",
                "prefix_required": "A window can still be valid for suitable threshold objectives."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-008",
            "prompt": "A developer says, \"The right pointer never moves backward, so the mixed-sign window is O(n) and therefore correct.\" What is wrong?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "complexity_not_correctness",
                  "text": "Forward-only pointers may bound work, but they do not prove that discarded intervals cannot contain the answer."
                },
                {
                  "id": "pointers_quadratic",
                  "text": "Two forward pointers always imply O(n²)."
                },
                {
                  "id": "negative_forces_backtrack",
                  "text": "Negative values force the pointer to move backward in every algorithm."
                },
                {
                  "id": "big_o_answer",
                  "text": "Any O(n) algorithm returns the same answer."
                }
              ],
              "acceptedOptionIds": [
                "complexity_not_correctness"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A runtime bound and a discard invariant are different proofs.",
              "details": "The algorithm can be fast and wrong if sign changes invalidate the boundary decision.",
              "wrongOptionExplanationsByOptionId": {
                "pointers_quadratic": "They may be linear, but correctness is separate.",
                "negative_forces_backtrack": "Prefix methods avoid that.",
                "big_o_answer": "Complexity says nothing about semantic correctness."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-009",
            "prompt": "For exact sum k with arbitrary integers, what must a prefix-frequency map store to count all matching subarrays?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "prefix_counts",
                  "text": "How many times each earlier prefix value has occurred."
                },
                {
                  "id": "one_current_sum",
                  "text": "Only the current window sum."
                },
                {
                  "id": "sorted_values",
                  "text": "The values sorted ascending."
                },
                {
                  "id": "target_count",
                  "text": "Only how often k appears as an element."
                }
              ],
              "acceptedOptionIds": [
                "prefix_counts"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Every earlier occurrence of currentPrefix - k defines a different starting boundary.",
              "details": "Frequency, not only existence, is required when the result is a count.",
              "wrongOptionExplanationsByOptionId": {
                "one_current_sum": "Different earlier boundaries can share the needed prefix value.",
                "sorted_values": "Sorting loses interval identity.",
                "target_count": "Subarray sums are not element equality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_negative_value_window_failure",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-negative-010",
            "prompt": "Which test most directly exposes a false simple-window implementation for exact sums?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "mixed_sign_recovery",
                  "text": "A prefix that overshoots or undershoots and later reaches the target after a negative or positive correction."
                },
                {
                  "id": "all_ones",
                  "text": "Only an array of ones."
                },
                {
                  "id": "empty_only",
                  "text": "Only empty input."
                },
                {
                  "id": "sorted_positive",
                  "text": "Only ascending positive values."
                }
              ],
              "acceptedOptionIds": [
                "mixed_sign_recovery"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A counterexample must force the aggregate direction to reverse after a boundary decision.",
              "details": "Mixed-sign recovery cases distinguish a memorized window template from a valid invariant.",
              "wrongOptionExplanationsByOptionId": {
