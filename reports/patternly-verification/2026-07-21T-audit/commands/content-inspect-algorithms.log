                "compare_scan"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Binary search can still help, but the output lower bound changes the total cost.",
              "details": "Transfer should preserve the search advantage without claiming that k outputs are free."
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_binary_search_vs_scan_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-transfer-019",
            "prompt": "A static unsorted array receives q exact queries. Select the total time of repeated scans and of sorting once followed by binary searches.",
            "constraints": [
              "Sorting is comparison-based.",
              "No updates occur."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "scan_time",
                "indexed_time"
              ],
              "availableValuesByDimension": {
                "scan_time": [
                  "O(qn)",
                  "O(n log n + q log n)",
                  "O(n+q)",
                  "O(q log n)"
                ],
                "indexed_time": [
                  "O(qn)",
                  "O(n log n + q log n)",
                  "O(n+q)",
                  "O(nq log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "scan_time": [
                  "O(qn)"
                ],
                "indexed_time": [
                  "O(n log n + q log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "scan_time": {
                  "repeated_scans": "O(qn)"
                },
                "indexed_time": {
                  "sort_then_queries": "O(n log n + q log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "This formula is a reusable transfer model for static repeated exact queries.",
              "details": "The decision flips with q, legal mutation or copy cost, and practical constants."
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_binary_search_vs_scan_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-transfer-020",
            "prompt": "A sorted array query returns all k matches. Compare boundary search plus output with a full scan plus output.",
            "constraints": [
              "Two boundary searches cost O(log n) total.",
              "Writing each matching result costs O(1)."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "binary_range_time",
                "scan_time"
              ],
              "availableValuesByDimension": {
                "binary_range_time": [
                  "O(log n)",
                  "O(k)",
                  "O(log n + k)",
                  "O(nk)"
                ],
                "scan_time": [
                  "O(n)",
                  "O(k)",
                  "O(n + k)",
                  "O(log n + k)"
                ]
              },
              "acceptedValuesByDimension": {
                "binary_range_time": [
                  "O(log n + k)"
                ],
                "scan_time": [
                  "O(n + k)"
                ]
              },
              "normalizedAliasesByDimension": {
                "binary_range_time": {
                  "locate_then_emit": "O(log n + k)"
                },
                "scan_time": {
                  "scan_then_emit": "O(n + k)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Output size narrows but does not erase the benefit of locating the range logarithmically.",
              "details": "When k is Θ(n), both totals become Θ(n)."
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_binary_search_vs_scan_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-transfer-021",
            "prompt": "A candidate predicate costs P(n), candidate range width is W, and a direct legal scan-style solution costs D(n). Select the answer-space binary cost and the correct transfer comparison.",
            "constraints": [
              "The predicate is monotonic and binary search uses O(log W) evaluations."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "binary_cost",
                "decision_rule"
              ],
              "availableValuesByDimension": {
                "binary_cost": [
                  "O(log W)",
                  "O(P(n))",
                  "O(P(n) log W)",
                  "O(WP(n))"
                ],
                "decision_rule": [
                  "always_binary",
                  "always_scan",
                  "compare_P(n)logW_with_D(n)",
                  "compare_names"
                ]
              },
              "acceptedValuesByDimension": {
                "binary_cost": [
                  "O(P(n) log W)"
                ],
                "decision_rule": [
                  "compare_P(n)logW_with_D(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "binary_cost": {
                  "predicate_times_iterations": "O(P(n) log W)"
                },
                "decision_rule": {
                  "full_legal_cost": "compare_P(n)logW_with_D(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The outer logarithm is only one factor in the transferred workload.",
              "details": "A direct method remains preferable when D(n) grows more slowly or has materially lower costs."
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_binary_search_vs_scan_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-transfer-022",
            "prompt": "A dataset has q exact queries and u updates. A maintained ordered structure costs O(log n) per query and O(log n) per update; a plain array costs O(n) per query and O(1) per append update. Select total time for both models.",
            "constraints": [
              "The maintained structure preserves the required query semantics.",
              "Updates are append-like in the plain array model."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "ordered_structure_time",
                "plain_array_time"
              ],
              "availableValuesByDimension": {
                "ordered_structure_time": [
                  "O((q+u) log n)",
                  "O(qn+u)",
                  "O(q log n+un)",
                  "O(qun)"
                ],
                "plain_array_time": [
                  "O((q+u) log n)",
                  "O(qn+u)",
                  "O(q+u)",
                  "O(qu)"
                ]
              },
              "acceptedValuesByDimension": {
                "ordered_structure_time": [
                  "O((q+u) log n)"
                ],
                "plain_array_time": [
                  "O(qn+u)"
                ]
              },
              "normalizedAliasesByDimension": {
                "ordered_structure_time": {
                  "queries_and_updates": "O((q+u) log n)"
                },
                "plain_array_time": {
                  "scans_and_appends": "O(qn+u)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "A different maintained representation can move both query and update costs.",
              "details": "Transfer should compare the actual data structure options rather than only sort-once versus scan."
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_binary_search_vs_scan_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          }
        ],
