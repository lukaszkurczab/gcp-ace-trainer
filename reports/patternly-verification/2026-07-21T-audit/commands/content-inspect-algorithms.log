            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The full cost of one query includes every predicate evaluation.",
              "details": "Binary search saves candidate evaluations, but it may repeat expensive global work that a direct algorithm performs once.",
              "wrongOptionExplanationsByOptionId": {
                "binary": "Each candidate costs O(n) to evaluate.",
                "equal": "The binary strategy has an additional logarithmic factor.",
                "unknown_without_mid": "Names are irrelevant."
