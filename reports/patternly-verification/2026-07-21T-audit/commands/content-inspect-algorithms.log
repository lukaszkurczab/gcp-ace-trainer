                  "O(n)"
                ],
                "rolling_auxiliary_space": [
                  "O(1)"
                ],
                "prefix_time": [
                  "O(n)"
                ],
                "prefix_auxiliary_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "rolling_time": {
                  "initial_plus_slides": "O(n)"
                },
                "rolling_auxiliary_space": {
                  "moving_sum": "O(1)"
                },
                "prefix_time": {
                  "build_plus_queries": "O(n)"
                },
                "prefix_auxiliary_space": {
                  "prefix_array": "O(n)"
                }
              },
              "maxPoints": 4
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 4
            },
            "feedback": {
              "reason": "Both strategies are linear for this workload.",
              "details": "The moving sum uses less retained state, while the prefix array remains reusable for other interval queries."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_moving_window_from_precomputed_prefix",
