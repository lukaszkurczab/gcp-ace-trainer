        "items": [
          {
            "id": "alg-contrast-hash-sort-duplicates-001",
            "prompt": "A stream must report the first position at which any value repeats. Which strategy best matches the contract?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_seen",
                  "text": "Maintain a seen set and stop at the first repeated arrival."
                },
                {
                  "id": "sort_end",
                  "text": "Read all values, sort them, and then infer the first repeat position."
                },
                {
                  "id": "adjacent_stream",
                  "text": "Compare only adjacent arrivals."
                },
                {
                  "id": "frequency_after",
                  "text": "Build final groups before checking for a repeat."
                }
              ],
              "acceptedOptionIds": [
                "hash_seen"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The result depends on online equality lookup and original arrival position.",
              "details": "A seen set supports both without requiring complete input or reordering.",
              "wrongOptionExplanationsByOptionId": {
                "sort_end": "Sorting destroys arrival position unless metadata is retained and cannot stop at the first repeated arrival.",
                "adjacent_stream": "The repeated value may be separated.",
                "frequency_after": "The contract permits earlier termination."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-002",
            "prompt": "A report must emit every distinct key in ascending order with its count. Which direct strategy is strongest?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_runs",
                  "text": "Sort values and scan equal runs."
                },
                {
                  "id": "hash_only",
                  "text": "Use a hash map and assume iteration is ascending."
                },
                {
                  "id": "first_duplicate",
                  "text": "Stop after finding one duplicate."
                },
                {
                  "id": "pair_compare",
                  "text": "Compare every pair."
                }
              ],
              "acceptedOptionIds": [
                "sort_runs"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorting simultaneously supplies deterministic key order and duplicate adjacency.",
              "details": "Hash counting remains viable only if the later key-ordering cost is included.",
              "wrongOptionExplanationsByOptionId": {
                "hash_only": "A plain hash map does not guarantee ascending key order.",
                "first_duplicate": "The report requires all groups.",
                "pair_compare": "Pairwise comparison does not create ordered groups efficiently."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-003",
            "prompt": "The caller needs counts by key but explicitly accepts arbitrary group order. Which strategy avoids unused ordering work?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_counts",
                  "text": "Use a hash frequency map."
                },
                {
                  "id": "sort_required",
                  "text": "Sort because duplicate counts are impossible without adjacency."
                },
                {
                  "id": "stable_sort",
                  "text": "Use stable sorting to preserve order that the caller does not require."
                },
                {
                  "id": "all_pairs",
                  "text": "Count each key by scanning the entire input repeatedly."
                }
              ],
              "acceptedOptionIds": [
                "hash_counts"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The state is a key-to-count mapping with no ordered-output requirement.",
              "details": "Hashing directly serves that contract in expected linear time.",
              "wrongOptionExplanationsByOptionId": {
                "sort_required": "A map updates counts wherever occurrences appear.",
                "stable_sort": "This adds an unnecessary constraint.",
                "all_pairs": "This can be quadratic."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-004",
            "prompt": "Why does sorting simplify grouping equal values?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "equal_adjacent",
                  "text": "All equal keys become one contiguous run that can be consumed with a linear scan."
                },
                {
                  "id": "duplicates_removed",
                  "text": "Sorting automatically deletes duplicates."
                },
                {
                  "id": "hash_generated",
                  "text": "Sorting implicitly creates a hash function."
                },
                {
                  "id": "counts_free",
                  "text": "Run lengths require no scan."
                }
              ],
              "acceptedOptionIds": [
                "equal_adjacent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Order turns a global equality relation into local adjacency.",
              "details": "This reusable structure is the sorting-side mechanism for duplicate grouping.",
              "wrongOptionExplanationsByOptionId": {
                "duplicates_removed": "Sorting reorders but preserves occurrences.",
                "hash_generated": "No hash state is created.",
                "counts_free": "The runs still need to be traversed and counted."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-005",
            "prompt": "Keys are comparable but intentionally not hashable. The task is to group duplicates. Which strategy remains legal?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_compare",
                  "text": "Sort by the comparator and scan equal runs."
                },
                {
                  "id": "hash_anyway",
                  "text": "Use object identity as an unrelated hash and assume semantic equality."
                },
                {
                  "id": "no_solution",
                  "text": "Duplicate grouping is impossible."
                },
                {
                  "id": "index_hash",
                  "text": "Hash input indices instead of keys."
                }
              ],
              "acceptedOptionIds": [
                "sort_compare"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorting needs a compatible total order, not a hash function.",
              "details": "The legal key operations can decide the strategy before asymptotic comparison.",
              "wrongOptionExplanationsByOptionId": {
                "hash_anyway": "The hash/equality contract would be incorrect.",
                "no_solution": "Comparison equality after sorting is sufficient.",
                "index_hash": "Distinct indices do not group equal key values."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-006",
            "prompt": "Keys are hashable but have no domain-approved total order. The result needs counts in arbitrary order. Which strategy is legal and direct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_counts",
                  "text": "Use a hash map keyed by semantic equality."
                },
                {
                  "id": "invent_order",
                  "text": "Sort by an incidental memory address."
                },
                {
                  "id": "stringify_sort",
                  "text": "Convert keys to strings without proving that string equality matches key equality."
                },
                {
                  "id": "adjacent_original",
                  "text": "Assume equal values are adjacent in the input."
                }
              ],
              "acceptedOptionIds": [
                "hash_counts"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Hashing matches the available equality contract.",
              "details": "Sorting should not be forced by inventing an order unrelated to the domain.",
              "wrongOptionExplanationsByOptionId": {
                "invent_order": "An incidental order is not a domain comparator and may be unstable.",
                "stringify_sort": "This can merge or split semantic keys incorrectly.",
                "adjacent_original": "No such precondition is given."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-007",
            "prompt": "A hash frequency map is used, but the output must be deterministic across runs and environments. What additional decision is required?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "order_policy",
                  "text": "Define and implement an explicit output order, such as sorting keys or preserving first-seen order."
                },
                {
                  "id": "assume_hash_order",
                  "text": "Assume every hash table has the same iteration order."
                },
                {
                  "id": "drop_counts",
                  "text": "Remove counts to make order deterministic."
                },
                {
                  "id": "rehash",
                  "text": "Rehash repeatedly until an ascending order appears."
                }
              ],
              "acceptedOptionIds": [
                "order_policy"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Determinism is an observable output property.",
              "details": "A hash map can still be used, but the ordering mechanism and its cost must be explicit.",
              "wrongOptionExplanationsByOptionId": {
                "assume_hash_order": "Iteration guarantees vary and may not be value-sorted.",
                "drop_counts": "The required data would be lost.",
                "rehash": "Hash placement is not a sorting contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-008",
            "prompt": "Memory is constrained, input mutation is legal, and all duplicate groups must be found. Which tradeoff can favor sorting?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "in_place_groups",
                  "text": "An in-place sort plus run scan can avoid O(k) hash entries."
                },
                {
                  "id": "hash_constant",
                  "text": "A general frequency map always uses O(1) memory."
                },
                {
                  "id": "skip_groups",
                  "text": "Return only one duplicate to save memory."
                },
                {
                  "id": "pairwise",
                  "text": "Use O(n²) pair checks because memory is the only concern."
                }
              ],
              "acceptedOptionIds": [
                "in_place_groups"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorting can exchange more comparison work and mutation for lower auxiliary storage.",
              "details": "The chosen sorting algorithm's own memory must still be included.",
              "wrongOptionExplanationsByOptionId": {
                "hash_constant": "It may store one entry per distinct key.",
                "skip_groups": "That changes the result contract.",
                "pairwise": "Time feasibility must also be considered."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-009",
            "prompt": "The task needs the first occurrence index and total count for every key, emitted by first-seen order. Which design is most natural?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_metadata",
                  "text": "Scan once, storing first index and count per key, then emit according to first-seen metadata."
                },
                {
                  "id": "sort_values_only",
                  "text": "Sort values without positions and infer first occurrence."
                },
                {
                  "id": "run_index",
                  "text": "Use each sorted-run start as the original first occurrence."
                },
                {
                  "id": "arbitrary_hash",
                  "text": "Use a hash map but do not store first indices or order metadata."
                }
              ],
              "acceptedOptionIds": [
                "hash_metadata"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The grouping state is equality-keyed, but the output also needs original-order metadata.",
              "details": "A map can retain both count and first position while the initial scan establishes first-seen order.",
              "wrongOptionExplanationsByOptionId": {
                "sort_values_only": "Sorting alone loses original index and first-seen order.",
                "run_index": "Sorted positions are not original positions.",
                "arbitrary_hash": "The required output cannot be reconstructed reliably."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-010",
            "prompt": "Different input positions contain equal values. What must be clarified before deduplicating outputs?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "identity_contract",
                  "text": "Whether results distinguish indexed occurrences or only distinct values."
                },
                {
                  "id": "sort_direction",
                  "text": "Only ascending versus descending order."
                },
                {
                  "id": "hash_size",
                  "text": "Only initial bucket count."
                },
                {
                  "id": "loop_count",
                  "text": "How many loops the implementation uses."
                }
              ],
              "acceptedOptionIds": [
                "identity_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Duplicate handling depends on what equality means for the output.",
              "details": "A value-distinct group, an occurrence-distinct result, and a first-occurrence result require different retained information.",
              "wrongOptionExplanationsByOptionId": {
                "sort_direction": "Order does not define occurrence identity.",
                "hash_size": "Representation tuning cannot replace the semantic identity contract.",
                "loop_count": "Loop structure is not the result definition."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-011",
            "prompt": "Which contracts favor a hash-based duplicate strategy? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "online_first_repeat",
                  "text": "Report the first repeated arrival online."
                },
                {
                  "id": "arbitrary_count_order",
                  "text": "Count every key with arbitrary output order."
                },
                {
                  "id": "first_index_metadata",
                  "text": "Retain first indices and counts without reordering input."
                },
                {
                  "id": "ascending_groups",
                  "text": "Emit all groups in ascending key order with no later ordering step."
                }
              ],
              "acceptedOptionIds": [
                "online_first_repeat",
                "arbitrary_count_order",
                "first_index_metadata"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Hashing is strongest for equality-keyed state, online updates, and original-position metadata.",
              "details": "Ascending groups add an ordering signal.",
              "wrongOptionExplanationsByOptionId": {
                "ascending_groups": "This directly consumes sorted order."
              },
              "omittedCorrectExplanationsByOptionId": {
                "online_first_repeat": "Seen membership supports early detection.",
                "arbitrary_count_order": "A frequency map directly represents the result.",
                "first_index_metadata": "Map entries can store both."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_duplicates_and_grouping",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-duplicates-012",
            "prompt": "Which contracts favor sorting and run grouping? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "ordered_groups",
                  "text": "Emit groups in key order."
                },
                {
                  "id": "adjacent_run_stats",
                  "text": "Compute run lengths and neighboring-group relations."
