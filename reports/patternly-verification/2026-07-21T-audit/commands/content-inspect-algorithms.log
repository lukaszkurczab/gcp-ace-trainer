        "items": [
          {
            "id": "alg-binary-search-classic-001",
            "prompt": "For a closed-interval exact search on an array of length n, what are the usual initial boundaries?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero_n_minus_one",
                  "text": "left = 0 and right = n - 1."
                },
                {
                  "id": "zero_n",
                  "text": "left = 0 and right = n."
                },
                {
                  "id": "one_n",
                  "text": "left = 1 and right = n."
                },
                {
                  "id": "minus_one_n",
                  "text": "left = -1 and right = n."
                }
              ],
              "acceptedOptionIds": [
                "zero_n_minus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A closed exact-search interval contains valid candidate indices from left through right.",
              "details": "For n elements, the full candidate set is [0, n - 1].",
              "wrongOptionExplanationsByOptionId": {
                "zero_n": "Index n is outside a closed array interval.",
                "one_n": "This skips index 0 and includes index n.",
                "minus_one_n": "These are sentinels, not the ordinary active closed interval."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-002",
            "prompt": "In ascending sorted data, nums[mid] is greater than target. Which closed-interval update preserves the exact-search invariant?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "right_mid_minus_one",
                  "text": "right = mid - 1."
                },
                {
                  "id": "left_mid_plus_one",
                  "text": "left = mid + 1."
                },
                {
                  "id": "right_mid",
                  "text": "right = mid."
                },
                {
                  "id": "return_mid",
                  "text": "Return mid."
                }
              ],
              "acceptedOptionIds": [
                "right_mid_minus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Every index at or to the right of mid contains a value at least nums[mid], which is too large.",
              "details": "The remaining possible target region is strictly left of mid.",
              "wrongOptionExplanationsByOptionId": {
                "left_mid_plus_one": "This discards the only side where a smaller target may remain.",
                "right_mid": "For exact search after strict greater-than, mid is known not to be the target and should be removed.",
                "return_mid": "The value at mid is not equal to target."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-003",
            "prompt": "In ascending sorted data, nums[mid] is less than target. Which closed-interval update is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "left_mid_plus_one",
                  "text": "left = mid + 1."
                },
                {
                  "id": "right_mid_minus_one",
                  "text": "right = mid - 1."
                },
                {
                  "id": "left_mid",
                  "text": "left = mid."
                },
                {
                  "id": "return_not_found",
                  "text": "Return not found immediately."
                }
              ],
              "acceptedOptionIds": [
                "left_mid_plus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Every index at or to the left of mid contains a value no greater than nums[mid], which is too small.",
              "details": "The target, if present, must be strictly right of mid.",
              "wrongOptionExplanationsByOptionId": {
                "right_mid_minus_one": "This keeps only values that are no larger than nums[mid].",
                "left_mid": "Mid is known not to match and retaining it can prevent strict progress.",
                "return_not_found": "The target may remain to the right."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-004",
            "prompt": "What should an exact binary search do when nums[mid] equals target and the contract accepts any matching index?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "return_mid",
                  "text": "Return mid immediately."
                },
                {
                  "id": "continue_left",
                  "text": "Always continue left until the first occurrence."
                },
                {
                  "id": "continue_right",
                  "text": "Always continue right until the last occurrence."
                },
                {
                  "id": "remove_mid",
                  "text": "Discard mid and continue without recording it."
                }
              ],
              "acceptedOptionIds": [
                "return_mid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The result contract is already satisfied by the matching midpoint.",
              "details": "Searching for first or last occurrence requires a different invariant and completion policy.",
              "wrongOptionExplanationsByOptionId": {
                "continue_left": "That implements a lower-bound-style contract rather than any-match.",
                "continue_right": "That implements a different boundary contract.",
                "remove_mid": "This can lose the known valid answer."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-005",
            "prompt": "What should a correct closed-interval exact search return after the loop exits with left > right?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "not_found",
                  "text": "The target is not present in the searched array."
                },
                {
                  "id": "left_index",
                  "text": "left is always a matching target index."
                },
                {
                  "id": "right_index",
                  "text": "right is always a matching target index."
                },
                {
                  "id": "mid_index",
                  "text": "The last midpoint must be returned."
                }
              ],
              "acceptedOptionIds": [
                "not_found"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The invariant says every possible target index remains inside [left, right].",
              "details": "When that interval becomes empty, no candidate position remains.",
              "wrongOptionExplanationsByOptionId": {
                "left_index": "For exact search, left may be only an insertion position.",
                "right_index": "The interval may be empty with no match.",
                "mid_index": "The last midpoint may contain a nonmatching value."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-006",
            "prompt": "How should an iterative exact search behave on an empty array?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero_iterations",
                  "text": "The initial interval is empty, so it returns not found without reading an element."
                },
                {
                  "id": "read_zero",
                  "text": "It reads index 0 once before returning."
                },
                {
                  "id": "return_zero",
                  "text": "It returns index 0 as the insertion point under the exact-index contract."
                },
                {
                  "id": "throw_always",
                  "text": "It must throw because binary search cannot represent emptiness."
                }
              ],
              "acceptedOptionIds": [
                "zero_iterations"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With left = 0 and right = -1, the loop condition left <= right is false.",
              "details": "A correct interval convention handles empty input naturally.",
              "wrongOptionExplanationsByOptionId": {
                "read_zero": "Index 0 does not exist.",
                "return_zero": "The contract asks for a matching index, not insertion position.",
                "throw_always": "An empty interval is a normal searchable state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-007",
            "prompt": "A one-element array contains target. What should happen on the first iteration?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "mid_zero_match",
                  "text": "mid is 0, the value matches, and index 0 is returned."
                },
                {
                  "id": "skip_loop",
                  "text": "The loop is skipped because left equals right."
                },
                {
                  "id": "right_negative",
                  "text": "right becomes -1 before the value is checked."
                },
                {
                  "id": "return_one",
                  "text": "Index 1 is returned because length is 1."
                }
              ],
              "acceptedOptionIds": [
                "mid_zero_match"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A singleton closed interval must be inspected.",
              "details": "This is a critical edge case for distinguishing left <= right from left < right.",
              "wrongOptionExplanationsByOptionId": {
                "skip_loop": "A closed interval with left == right still contains one candidate.",
                "right_negative": "The midpoint must be evaluated first.",
                "return_one": "Length and last valid index are different."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-008",
            "prompt": "The sorted array contains duplicate target values, and the contract accepts any matching index. Which statement is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "any_match_valid",
                  "text": "Returning whichever matching midpoint is encountered is valid."
                },
                {
                  "id": "must_first",
                  "text": "The algorithm must return the first occurrence."
                },
                {
                  "id": "must_last",
                  "text": "The algorithm must return the last occurrence."
                },
                {
                  "id": "duplicates_break_all",
                  "text": "Duplicates make exact binary search incorrect."
                }
              ],
              "acceptedOptionIds": [
                "any_match_valid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The invariant only needs to preserve the possibility of some target index.",
              "details": "Duplicates matter when the contract asks for a specific boundary, not when any match is acceptable.",
              "wrongOptionExplanationsByOptionId": {
                "must_first": "That is not required by the stated contract.",
                "must_last": "That is a different result contract.",
                "duplicates_break_all": "Equality still identifies a valid match."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-009",
            "prompt": "Which midpoint formula avoids overflow in fixed-width integer arithmetic when left and right are nonnegative?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "safe_mid",
                  "text": "left + (right - left) / 2."
                },
                {
                  "id": "sum_mid",
                  "text": "(left + right) / 2 without any overflow consideration."
                },
                {
                  "id": "product_mid",
                  "text": "left * right / 2."
                },
                {
                  "id": "difference_only",
                  "text": "(right - left) / 2 without adding left."
                }
              ],
              "acceptedOptionIds": [
                "safe_mid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Computing the interval offset before adding it to left avoids summing two large boundaries.",
              "details": "The exact integer-rounding convention must still match the update rules.",
              "wrongOptionExplanationsByOptionId": {
                "sum_mid": "The sum can overflow even when both boundaries are valid.",
                "product_mid": "This is not the interval midpoint and can overflow more easily.",
                "difference_only": "This yields an offset rather than the absolute midpoint index."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-010",
            "prompt": "An exact search compares target with nums[mid] using an ordering inconsistent with how the array was sorted. What is the main defect?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "invariant_invalid",
                  "text": "The direction chosen after comparison no longer preserves the target-candidate invariant."
                },
                {
                  "id": "only_slower",
                  "text": "The search remains correct but becomes slower."
                },
                {
                  "id": "duplicates_only",
                  "text": "The defect appears only when duplicates exist."
                },
                {
                  "id": "mid_overflow",
                  "text": "The midpoint necessarily overflows."
                }
              ],
              "acceptedOptionIds": [
                "invariant_invalid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The search order and comparison relation must agree.",
              "details": "Binary search correctness depends on knowing how values on each side relate to nums[mid].",
              "wrongOptionExplanationsByOptionId": {
                "only_slower": "An inconsistent comparator can discard the side containing the target.",
                "duplicates_only": "Comparator inconsistency can fail on distinct values.",
                "mid_overflow": "Comparator semantics are unrelated to midpoint arithmetic."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-011",
            "prompt": "Which statements belong to the classic exact-search invariant? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "target_inside",
                  "text": "If target exists, at least one matching index remains inside the active interval."
                },
                {
                  "id": "outside_eliminated",
                  "text": "Every discarded index is proven unable to contain target."
                },
                {
                  "id": "strict_progress",
                  "text": "Every nonterminal update removes mid and strictly shrinks the interval."
                },
                {
                  "id": "first_occurrence",
                  "text": "The interval always contains the first occurrence specifically."
                }
              ],
              "acceptedOptionIds": [
                "target_inside",
                "outside_eliminated",
                "strict_progress"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Classic exact search preserves possible membership and removes known-impossible regions.",
              "details": "It does not promise first or last occurrence unless the contract is strengthened.",
              "wrongOptionExplanationsByOptionId": {
                "first_occurrence": "That stronger boundary invariant is not required for any-match search."
              },
              "omittedCorrectExplanationsByOptionId": {
                "target_inside": "This is the core candidate invariant.",
                "outside_eliminated": "Elimination must be justified.",
                "strict_progress": "This guarantees termination."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-012",
            "prompt": "Which test cases are important for classic exact binary search? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "empty",
                  "text": "Empty input."
                },
                {
                  "id": "singleton_hit_miss",
                  "text": "A singleton containing and not containing target."
                },
                {
                  "id": "target_edges",
                  "text": "Target at the first and last index."
                },
                {
                  "id": "only_middle",
                  "text": "Only one odd-length case where target starts at the midpoint."
                }
              ],
              "acceptedOptionIds": [
                "empty",
                "singleton_hit_miss",
                "target_edges"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary, absence, and minimal-size cases expose most invariant defects.",
              "details": "A midpoint hit alone can pass even when every update rule is wrong.",
              "wrongOptionExplanationsByOptionId": {
                "only_middle": "This does not exercise updates or edge boundaries."
              },
              "omittedCorrectExplanationsByOptionId": {
                "empty": "It verifies the initial empty interval.",
                "singleton_hit_miss": "It exercises the one-candidate interval.",
                "target_edges": "It checks boundary retention."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-013",
            "prompt": "Which updates are valid for closed-interval exact search after a strict comparison? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "too_small",
                  "text": "If nums[mid] < target, set left = mid + 1."
                },
                {
                  "id": "too_large",
                  "text": "If nums[mid] > target, set right = mid - 1."
                },
                {
                  "id": "equal_return",
                  "text": "If nums[mid] == target, return mid under an any-match contract."
                },
                {
                  "id": "too_small_keep_mid",
                  "text": "If nums[mid] < target, set left = mid."
                }
              ],
              "acceptedOptionIds": [
                "too_small",
                "too_large",
                "equal_return"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each branch either returns a valid answer or removes the known-nonmatching midpoint with the impossible side.",
              "details": "Keeping mid after a strict comparison breaks strict progress.",
              "wrongOptionExplanationsByOptionId": {
                "too_small_keep_mid": "Mid is known wrong and retaining it can stall on a singleton interval."
              },
              "omittedCorrectExplanationsByOptionId": {
                "too_small": "Mid and everything left of it are too small.",
                "too_large": "Mid and everything right of it are too large.",
                "equal_return": "The contract is satisfied."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-014",
            "prompt": "Arrange one iteration of classic exact binary search.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_interval",
                  "text": "Confirm the active closed interval is non-empty."
                },
                {
                  "id": "compute_mid",
                  "text": "Compute a midpoint inside the interval."
                },
                {
                  "id": "compare",
                  "text": "Compare nums[mid] with target."
                },
                {
                  "id": "return_or_update",
                  "text": "Return on equality; otherwise discard the proven-impossible side including mid."
                }
              ],
              "canonicalOrder": [
                "check_interval",
                "compute_mid",
                "compare",
                "return_or_update"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The update decision follows midpoint evidence inside a valid active interval.",
              "details": "Every nonterminal branch must preserve the invariant and shrink the interval."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-015",
            "prompt": "Arrange the reasoning after nums[mid] is less than target in ascending data.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "mid_too_small",
                  "text": "Establish that mid is not a match and is too small."
                },
                {
                  "id": "left_side_too_small",
                  "text": "Use sorted order to show every index at or left of mid is also too small."
                },
                {
                  "id": "move_left",
                  "text": "Set left = mid + 1."
                },
                {
                  "id": "continue",
                  "text": "Search the remaining right-side interval."
                }
              ],
              "canonicalOrder": [
                "mid_too_small",
                "left_side_too_small",
                "move_left",
                "continue"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The boundary update is justified by a chain from local comparison to regional elimination.",
              "details": "This reasoning is the half-discard proof for exact ascending search."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-016",
            "prompt": "Arrange the debugging steps for an exact search that misses a target at the final index.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_contract",
                  "text": "State whether the active interval is closed or half-open."
                },
                {
                  "id": "trace_last_candidate",
                  "text": "Trace the iteration where only the final index remains."
                },
                {
                  "id": "check_loop",
                  "text": "Verify that the loop condition still processes a one-element interval."
                },
                {
                  "id": "check_update",
                  "text": "Verify earlier updates did not discard the final index incorrectly."
                }
              ],
              "canonicalOrder": [
                "state_contract",
                "trace_last_candidate",
                "check_loop",
                "check_update"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Off-by-one debugging starts from the interval contract and the smallest failing state.",
              "details": "The final-index case often exposes a left < right loop used with a closed interval or an over-aggressive right update."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-017",
            "prompt": "An iterative exact binary search runs on n sorted elements with O(1) comparisons per iteration. Select its worst-case time and auxiliary-space complexity.",
            "constraints": [
              "The active interval is reduced by about half after each mismatch."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(log n)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "halving": "O(log n)"
                },
                "auxiliary_space": {
                  "iterative": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Strict interval halving gives logarithmic iterations, and iterative boundaries require constant extra state.",
              "details": "This excludes preprocessing such as sorting; the input is already sorted."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-classic-018",
            "prompt": "A recursive exact binary search on n sorted elements performs O(1) work per call. Select its worst-case time and recursion-stack space.",
            "constraints": [
              "Each recursive call searches at most half of the previous interval."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "recursion_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ],
                "recursion_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(log n)"
                ],
                "recursion_space": [
                  "O(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "halving": "O(log n)"
                },
                "recursion_space": {
                  "call_depth": "O(log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Recursive and iterative versions visit logarithmically many intervals, but recursion retains one frame per level.",
              "details": "The asymptotic search time is unchanged while auxiliary stack usage differs."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_classic_search_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
