          {
            "id": "algorithms-intervals-sweep-006",
            "prompt": "Why is sorting intervals by end not a substitute for sorting all sweep events by coordinate?",
            "constraints": [
              "Each interval contributes both a start and an end event.",
              "The sweep state must follow chronological changes."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "events_need_global_coordinate_order",
                  "text": "An early start can belong to an interval with a late end, so interval-end order does not globally order all event coordinates."
                },
                {
                  "id": "end_sort_too_expensive",
                  "text": "Sorting intervals by end is asymptotically slower than sorting events."
                },
                {
                  "id": "intervals_have_no_starts",
                  "text": "End-sorted intervals lose their start values."
                }
              ],
              "acceptedOptionIds": [
