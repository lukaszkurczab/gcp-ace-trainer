            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-011",
            "prompt": "Which facts support a threshold sliding window? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "inequality",
                  "text": "The answer uses at-least or at-most validity rather than one exact value."
                },
                {
                  "id": "monotone_values",
                  "text": "Value constraints make expansion and shrinking directional."
                },
                {
                  "id": "one_evolving_interval",
                  "text": "The scan can maintain one current candidate interval."
                },
                {
                  "id": "arbitrary_negatives",
                  "text": "Values are arbitrary signed with no stronger invariant."
                }
              ],
              "acceptedOptionIds": [
                "inequality",
                "monotone_values",
                "one_evolving_interval"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Threshold wording is useful only together with a monotone value domain and matching boundary search.",
              "details": "Arbitrary signs break the simple form.",
