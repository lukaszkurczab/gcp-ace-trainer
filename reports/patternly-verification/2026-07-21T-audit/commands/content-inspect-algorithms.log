                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Version churn multiplies preprocessing cost by u.",
              "details": "Peak space remains one n-sized prefix representation if old versions are released."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_window_or_prefix_for_query_volume",
              "secondarySkillAtomIds": [],
