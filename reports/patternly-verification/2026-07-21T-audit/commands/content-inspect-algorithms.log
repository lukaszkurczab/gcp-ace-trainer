        "items": [
          {
            "id": "alg-backtracking-recognize-signal-001",
            "prompt": "Which requirement is the strongest signal for a backtracking search?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "enumerate_valid_configurations",
                  "text": "Enumerate every configuration that satisfies a set of constraints."
                },
                {
                  "id": "single_linear_aggregate",
                  "text": "Compute one running sum over an array."
                },
                {
                  "id": "sorted_lookup",
                  "text": "Find one value in a sorted array."
                },
                {
                  "id": "frequency_report",
                  "text": "Count how many times each value appears."
                }
              ],
              "acceptedOptionIds": [
                "enumerate_valid_configurations"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Backtracking is appropriate when a solution is assembled through a sequence of choices and multiple legal branches may need exploration.",
              "details": "Enumerating all constrained configurations naturally forms a choice tree. Each partial configuration defines the legal next choices, and the search restores branch-local state before exploring siblings.",
              "wrongOptionExplanationsByOptionId": {
                "single_linear_aggregate": "A deterministic aggregate has no branching choice tree.",
                "sorted_lookup": "A monotonic lookup problem does not require exploring reversible choices.",
                "frequency_report": "Frequency accumulation is direct state aggregation rather than search over alternatives."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-002",
            "prompt": "A task asks for all length-k combinations chosen from n distinct values. Which structural description best matches the search?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "choice_tree",
                  "text": "A depth-k choice tree in which each level chooses the next value."
                },
                {
                  "id": "single_scan",
                  "text": "One deterministic left-to-right scan with no branching."
                },
                {
                  "id": "binary_lookup",
                  "text": "A binary search over sorted candidate values."
                },
                {
                  "id": "frequency_table",
                  "text": "A frequency table containing all values."
                }
              ],
              "acceptedOptionIds": [
                "choice_tree"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each partial combination branches on the legal candidates for the next position.",
              "details": "The search depth is k. A start boundary prevents reuse and duplicate ordering, while each branch represents one possible next selected value.",
              "wrongOptionExplanationsByOptionId": {
                "single_scan": "A scan cannot represent all alternative subsets without branching.",
                "binary_lookup": "The task is not locating one monotonic boundary.",
                "frequency_table": "Frequency state does not enumerate different selections."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-003",
            "prompt": "Which task is least likely to require backtracking?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "maximum_scan",
                  "text": "Return the maximum value in an unsorted array."
                },
                {
                  "id": "all_permutations",
                  "text": "Generate all permutations of distinct values."
                },
                {
                  "id": "word_path",
                  "text": "Determine whether a word can be formed by a non-reusing path through a grid."
                },
                {
                  "id": "valid_assignments",
                  "text": "List all assignments satisfying pairwise constraints."
                }
              ],
              "acceptedOptionIds": [
                "maximum_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A maximum can be computed by a deterministic linear scan with one running best value.",
              "details": "No choice must be revisited, undone, or explored in sibling branches. The other tasks naturally require searching alternatives.",
              "wrongOptionExplanationsByOptionId": {
                "all_permutations": "Permutation generation requires exploring many reversible choices.",
                "word_path": "The path branches on neighboring cells and uses branch-local visited state.",
                "valid_assignments": "Assignment construction forms a constrained choice tree."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-004",
            "prompt": "A problem asks whether at least one valid assignment exists. Does the find-one result contract rule out backtracking?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_short_circuit",
                  "text": "No. Backtracking may stop as soon as one complete valid branch succeeds."
                },
                {
                  "id": "yes_all_only",
                  "text": "Yes. Backtracking is valid only when every solution must be returned."
                },
                {
                  "id": "yes_no_output",
                  "text": "Yes. Boolean results never require search."
                },
                {
                  "id": "only_if_sorted",
                  "text": "Backtracking is allowed only when candidates are sorted."
                }
              ],
              "acceptedOptionIds": [
                "no_short_circuit"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Backtracking describes how alternatives are explored, not whether the result contains one solution or all solutions.",
              "details": "A find-one solver can propagate success immediately. A collect-all solver instead records each complete branch and continues.",
              "wrongOptionExplanationsByOptionId": {
                "yes_all_only": "Backtracking can support either find-one or collect-all contracts.",
                "yes_no_output": "A boolean can summarize the outcome of a branching search.",
                "only_if_sorted": "Sorting may help duplicate control but is not a universal precondition."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-005",
            "prompt": "Which detail most clearly distinguishes backtracking from an unrestricted brute-force loop over complete candidates?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "partial_invariant",
                  "text": "The search maintains a valid partial state and rejects branches that cannot lead to a solution."
                },
                {
                  "id": "large_input",
                  "text": "The input size is large."
                },
                {
                  "id": "uses_recursion",
                  "text": "The implementation uses recursion."
                },
                {
                  "id": "nested_loops",
                  "text": "The code contains nested loops."
                }
              ],
              "acceptedOptionIds": [
                "partial_invariant"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Backtracking reasons about partial solutions, legal next choices, and restoration between branches.",
              "details": "It can still be exponential, but it is not merely unstructured enumeration: partial invariants and sound pruning shape the search tree.",
              "wrongOptionExplanationsByOptionId": {
                "large_input": "Input size alone does not define the algorithmic structure.",
                "uses_recursion": "Recursion can implement many non-backtracking algorithms.",
                "nested_loops": "Loop nesting does not establish reversible branch exploration."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-006",
            "prompt": "A string may be split at multiple positions, and every segment must satisfy a predicate. Which signal points to backtracking?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "choose_next_boundary",
                  "text": "At each position, choose among multiple legal next segment boundaries."
                },
                {
                  "id": "compare_adjacent",
                  "text": "Only compare each character with its neighbor."
                },
                {
                  "id": "sort_segments",
                  "text": "Sort the eventual segments alphabetically."
                },
                {
                  "id": "count_characters",
                  "text": "Count the frequency of each character."
                }
              ],
              "acceptedOptionIds": [
                "choose_next_boundary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Segmentation forms a tree whose edges are possible next cut positions.",
              "details": "Each branch commits to one segment, recursively solves the suffix, and then restores the path before trying another boundary.",
              "wrongOptionExplanationsByOptionId": {
                "compare_adjacent": "Adjacent comparison does not enumerate segmentation alternatives.",
                "sort_segments": "Sorting output does not identify the search structure.",
                "count_characters": "Character counts do not represent partition boundaries."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_search",
              "problemArchetypeId": "partition_sequence"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-007",
            "prompt": "Which grid task has a backtracking signal rather than a standard flood-fill signal?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "path_spells_word",
                  "text": "Find a path that spells a target word without reusing a cell in the same path."
                },
                {
                  "id": "count_components",
                  "text": "Count connected components while each cell may be visited globally once."
                },
                {
                  "id": "compute_row_sums",
                  "text": "Compute the sum of each row."
                },
                {
                  "id": "find_minimum_cell",
                  "text": "Find the smallest cell value."
                }
              ],
              "acceptedOptionIds": [
                "path_spells_word"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The word-path task explores alternative neighbor choices with visited state scoped to the current path.",
              "details": "A cell blocked in one candidate path may need to be available in a sibling path, so marking and undoing are central.",
              "wrongOptionExplanationsByOptionId": {
                "count_components": "Global reachability can use ordinary DFS or BFS without undoing visited state.",
                "compute_row_sums": "Row aggregation is deterministic.",
                "find_minimum_cell": "A simple scan is sufficient."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-008",
            "prompt": "A problem asks for one shortest path in an unweighted graph. Which observation argues against choosing backtracking as the primary approach?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bfs_structure",
                  "text": "Layered breadth-first exploration directly guarantees the shortest number of edges."
                },
                {
                  "id": "has_choices",
                  "text": "The graph has more than one outgoing edge."
                },
                {
                  "id": "uses_path",
                  "text": "The result is a path."
                },
                {
                  "id": "needs_visited",
                  "text": "The algorithm needs visited state."
                }
              ],
              "acceptedOptionIds": [
                "bfs_structure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A specialized polynomial-time traversal should be preferred when it directly satisfies the objective.",
              "details": "Backtracking is not a default for every problem with choices. The goal and available invariants determine the appropriate search.",
              "wrongOptionExplanationsByOptionId": {
                "has_choices": "Branching alone does not make backtracking the best method.",
                "uses_path": "Many path problems are solved without backtracking search.",
                "needs_visited": "Visited state appears in ordinary graph traversal too."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-009",
            "prompt": "Which phrase is an unsafe reason by itself to classify a problem as backtracking?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "uses_recursion",
                  "text": "\"The solution uses recursion.\""
                },
                {
                  "id": "all_valid_outputs",
                  "text": "\"The task asks for all valid outputs under constraints.\""
                },
                {
                  "id": "reversible_choice",
                  "text": "\"Each branch makes a reversible choice and explores alternatives.\""
                },
                {
                  "id": "partial_constraints",
                  "text": "\"A partial assignment can be rejected before completion.\""
                }
              ],
              "acceptedOptionIds": [
                "uses_recursion"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Recursion is an implementation mechanism, not a sufficient classification rule.",
              "details": "Tree traversal, divide-and-conquer, and dynamic programming can all be recursive without using choose-recurse-unchoose search.",
              "wrongOptionExplanationsByOptionId": {
                "all_valid_outputs": "This is a strong backtracking signal.",
                "reversible_choice": "This directly describes backtracking mechanics.",
                "partial_constraints": "This describes sound pruning in a choice tree."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-010",
            "prompt": "A task generates all subsets of n distinct values. What is the branching decision at each input position in a common backtracking formulation?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "include_or_exclude",
                  "text": "Include the current value or exclude it."
                },
                {
                  "id": "left_or_right_half",
                  "text": "Search the left half or the right half of a sorted array."
                },
                {
                  "id": "increment_or_decrement",
                  "text": "Increment or decrement the value."
                },
                {
                  "id": "sort_or_not",
                  "text": "Sort the input or leave it unsorted."
                }
              ],
              "acceptedOptionIds": [
                "include_or_exclude"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each position contributes a binary membership choice.",
              "details": "The resulting decision tree has depth n and up to 2^n leaves, one for each subset.",
              "wrongOptionExplanationsByOptionId": {
                "left_or_right_half": "That describes binary search, not subset construction.",
                "increment_or_decrement": "The subset choice concerns membership, not modifying values.",
                "sort_or_not": "Sorting is not the per-position decision that defines the subset tree."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-011",
            "prompt": "A solver assigns one value to each variable and must satisfy constraints involving earlier assignments. What state transition suggests backtracking?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "assign_check_recurse_undo",
                  "text": "Assign a candidate, check consistency, recurse, then undo the assignment."
                },
                {
                  "id": "sum_once",
                  "text": "Add every candidate value into one running total."
                },
                {
                  "id": "sort_once",
                  "text": "Sort variables once and return the order."
                },
                {
                  "id": "lookup_once",
                  "text": "Read one precomputed answer from a table."
                }
              ],
              "acceptedOptionIds": [
                "assign_check_recurse_undo"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Variable assignment is a sequence of constrained choices whose effects must be isolated between branches.",
              "details": "Undo restores the partial assignment so sibling candidate values are evaluated from the same parent state.",
              "wrongOptionExplanationsByOptionId": {
                "sum_once": "A single aggregate does not explore alternative assignments.",
                "sort_once": "Sorting alone does not construct or test assignments.",
                "lookup_once": "A fixed lookup has no search transition."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-012",
            "prompt": "Which result requirement most strongly suggests output-sensitive backtracking?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "return_every_solution",
                  "text": "Return every valid permutation satisfying the constraints."
                },
                {
                  "id": "return_count_length",
                  "text": "Return the input length."
                },
                {
                  "id": "return_first_value",
                  "text": "Return the first array element."
                },
                {
                  "id": "return_sorted_copy",
                  "text": "Return a sorted copy of the input."
                }
              ],
              "acceptedOptionIds": [
                "return_every_solution"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When all solutions must be materialized, runtime must at least scale with the number and size of those outputs.",
              "details": "Backtracking can generate each valid leaf while sharing partial-path work across solutions.",
              "wrongOptionExplanationsByOptionId": {
                "return_count_length": "This is direct computation.",
                "return_first_value": "No search is necessary.",
                "return_sorted_copy": "Sorting is not output enumeration."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-013",
            "prompt": "Which features are strong backtracking signals? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "partial_solution",
                  "text": "The algorithm builds a partial solution one decision at a time."
                },
                {
                  "id": "multiple_legal_choices",
                  "text": "A state can have multiple legal next choices."
                },
                {
                  "id": "branch_restoration",
                  "text": "Mutable branch state must be restored before exploring a sibling."
                },
                {
                  "id": "single_deterministic_pass",
                  "text": "Every input position has exactly one forced transition."
                }
              ],
              "acceptedOptionIds": [
                "partial_solution",
                "multiple_legal_choices",
                "branch_restoration"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Backtracking combines partial construction, branching, and branch-local state isolation.",
              "details": "Not every feature must appear in identical syntax, but the conceptual search tree and reversible decisions are central.",
              "wrongOptionExplanationsByOptionId": {
                "single_deterministic_pass": "A forced one-pass transition does not require branch exploration."
              },
              "omittedCorrectExplanationsByOptionId": {
                "partial_solution": "Backtracking state is usually a partial candidate.",
                "multiple_legal_choices": "Sibling choices form the branching structure.",
                "branch_restoration": "Restoration isolates branches."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-014",
            "prompt": "Which tasks can naturally be modeled as backtracking choice trees? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "permutations",
                  "text": "Generate all permutations of distinct values."
                },
                {
                  "id": "constrained_assignment",
                  "text": "Assign values to variables subject to partial consistency constraints."
                },
                {
                  "id": "palindrome_partition",
                  "text": "Enumerate all partitions whose segments satisfy a predicate."
                },
                {
                  "id": "array_sum",
                  "text": "Compute the sum of all array values."
                }
              ],
              "acceptedOptionIds": [
                "permutations",
                "constrained_assignment",
                "palindrome_partition"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "These tasks construct outputs by exploring alternative legal next choices.",
              "details": "The array sum is solved by one fixed accumulation path.",
              "wrongOptionExplanationsByOptionId": {
                "array_sum": "A deterministic aggregate has no alternative branches."
              },
              "omittedCorrectExplanationsByOptionId": {
                "permutations": "Each level chooses an unused next value.",
                "constrained_assignment": "Each variable assignment is a branch choice.",
                "palindrome_partition": "Each branch chooses the next segment boundary."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-015",
            "prompt": "Which statements prevent the false heuristic that backtracking is merely unstructured brute force? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "state_invariant",
                  "text": "Each recursion level has a defined partial-state invariant."
                },
                {
                  "id": "legal_choices",
                  "text": "Candidate generation is limited to legal next choices."
                },
                {
                  "id": "sound_pruning",
                  "text": "A branch may be cut only when no completion can satisfy the contract."
                },
                {
                  "id": "prune_unpromising",
                  "text": "Any branch that looks slow may be removed."
                }
              ],
              "acceptedOptionIds": [
                "state_invariant",
                "legal_choices",
                "sound_pruning"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correct backtracking is governed by explicit state, choice, completion, and pruning contracts.",
              "details": "A branch is not removable merely because it appears inconvenient.",
              "wrongOptionExplanationsByOptionId": {
                "prune_unpromising": "Performance intuition alone cannot preserve completeness."
              },
              "omittedCorrectExplanationsByOptionId": {
                "state_invariant": "The invariant gives semantic meaning to the current node.",
                "legal_choices": "Legal-choice rules structure the tree.",
                "sound_pruning": "Sound pruning is justified by impossibility."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-recognize-signal-016",
            "prompt": "A full choice tree has branching factor b and maximum depth d, with O(1) work per node besides recursion. Select an upper bound on visited nodes and recursion-stack space.",
            "constraints": [
              "Every internal node may generate up to b children.",
              "No pruning is guaranteed."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "visited_nodes",
                "recursion_space"
              ],
              "availableValuesByDimension": {
                "visited_nodes": [
                  "O(d)",
                  "O(bd)",
                  "O(b^d)",
                  "O(d^b)"
