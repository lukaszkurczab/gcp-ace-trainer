          {
            "id": "alg-bits-representation-005",
            "prompt": "Which bit positions are selected by the 8-bit mask 00101100?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bits_2_3_5",
                  "text": "Positions 2, 3, and 5."
                },
                {
                  "id": "bits_1_2_4",
                  "text": "Positions 1, 2, and 4."
                },
                {
                  "id": "bits_0_2_3",
                  "text": "Positions 0, 2, and 3."
                },
                {
                  "id": "bits_3_4_6",
                  "text": "Positions 3, 4, and 6."
                }
              ],
              "acceptedOptionIds": [
                "bits_2_3_5"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A mask selects the positions containing ones.",
              "details": "Reading from the least significant bit as position 0, the set positions are 2, 3, and 5.",
              "wrongOptionExplanationsByOptionId": {
                "bits_1_2_4": "Those positions correspond to a different pattern.",
                "bits_0_2_3": "The least significant bit is zero in this mask.",
                "bits_3_4_6": "Bits 4 and 6 are zero."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "interpret_integer_bit_representation",
