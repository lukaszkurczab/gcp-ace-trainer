      {
        "id": "alg-contrast-window-prefix-state-009",
        "prompt": "A variable window maintains the invariant \"current interval is valid\" while the right boundary advances. What distinguishes this from a prefix array?",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
