      {
        "id": "alg-contrast-window-prefix-transfer-011",
        "prompt": "After a requirement change, which resulting workloads require retained cumulative history? Select all that apply.",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "multiple",
          "options": [
            {
              "id": "many_ranges",
              "text": "One query becomes many arbitrary static interval queries."
            },
            {
              "id": "negative_exact",
              "text": "Values become arbitrary signed for an exact-sum objective."
            },
            {
              "id": "count_matches",
              "text": "The result changes from one match to counting all exact matches."
            },
            {
              "id": "last_k_only",
              "text": "Only the current last-k stream interval remains relevant."
            }
