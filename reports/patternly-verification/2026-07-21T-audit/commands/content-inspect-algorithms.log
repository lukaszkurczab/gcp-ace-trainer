          {
            "id": "alg-bits-representation-016",
            "prompt": "Arrange the steps for interpreting a fixed-width unsigned bit pattern.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "number_positions",
                  "text": "Number positions from 0 at the least significant bit."
                },
                {
                  "id": "identify_ones",
                  "text": "Identify which positions contain one."
                },
                {
                  "id": "map_powers",
                  "text": "Map each set position k to 2^k."
                },
                {
                  "id": "sum_values",
                  "text": "Sum the selected place values."
                }
              ],
              "canonicalOrder": [
                "number_positions",
                "identify_ones",
