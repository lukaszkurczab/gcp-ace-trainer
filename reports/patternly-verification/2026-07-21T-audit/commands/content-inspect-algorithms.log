      {
        "id": "alg-arrays-frequency-state-012",
        "prompt": "Which statements correctly distinguish presence state from frequency state? Select all that apply.",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "multiple",
          "options": [
            {
              "id": "set_answers_membership",
              "text": "A set can answer whether a value has appeared."
            },
            {
              "id": "map_preserves_multiplicity",
              "text": "A frequency map can distinguish one occurrence from several."
            },
            {
              "id": "both_may_grow_with_keys",
              "text": "Either structure may grow with the number of distinct values."
            },
            {
              "id": "set_preserves_exact_counts",
              "text": "A set directly preserves the exact count of every value."
            }
          ],
          "acceptedOptionIds": [
