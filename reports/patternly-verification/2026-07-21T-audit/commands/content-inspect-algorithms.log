        "items": [
          {
            "prompt": "A routine removes every node whose value equals target. The original head may be removed repeatedly. Which setup most directly avoids a separate head-deletion branch?",
            "constraints": [
              "The operation is in place and may change the logical head.",
              "The list is singly linked and acyclic."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_values",
                  "text": "Sort payload values before traversal."
                },
                {
                  "id": "dummy_before_head",
                  "text": "Create dummy.next = head and start prev at dummy."
                },
                {
                  "id": "fast_slow",
                  "text": "Start fast two nodes ahead of slow."
                },
                {
                  "id": "tail_only",
                  "text": "Keep only a tail pointer and discard head."
                }
              ],
              "acceptedOptionIds": [
                "dummy_before_head"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A sentinel gives the original head the same predecessor relationship as every later node.",
              "details": "With prev at dummy, deleting the current first data node uses the same assignment prev.next = current.next used elsewhere. Repeated head removals remain uniform because prev can stay at dummy. The final logical head is dummy.next. Relative-speed pointers, sorting, and a lone tail do not provide a stable predecessor for mutation.",
              "wrongOptionExplanationsByOptionId": {
                "fast_slow": "Different traversal speeds do not create a predecessor before a removable head.",
                "sort_values": "Sorting changes content order and does not eliminate the head-reference update problem.",
                "tail_only": "A tail reference cannot update or recover the first link of a singly linked list."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "simplify_head_boundary_with_sentinel",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "dummy_head",
              "problemArchetypeId": "remove_or_rewire_node"
            },
            "id": "alg-linked-list-sentinel-01-head-boundary-signal",
            "difficulty": "introductory"
          },
          {
            "prompt": "A sentinel-based filter traverses current = prev.next. Select all statements that preserve the uniform predecessor invariant.",
            "constraints": [
              "current is recomputed as prev.next after each transition.",
              "The output excludes the sentinel."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "delete_advance_prev",
                  "text": "When current is removed, advance prev to the removed node."
                },
                {
                  "id": "return_dummy",
                  "text": "Return dummy itself as the first logical data node."
                },
                {
                  "id": "delete_keep_prev",
                  "text": "When current is removed, set prev.next = current.next and keep prev in place."
                },
                {
                  "id": "retain_advance_prev",
                  "text": "When current is retained, advance prev to current."
                }
              ],
              "acceptedOptionIds": [
                "delete_keep_prev",
                "retain_advance_prev"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Deletion keeps the same predecessor for the next candidate, while retention makes the kept node the next predecessor.",
              "details": "current is always read from prev.next. After deletion, prev.next changes to the successor, so prev still precedes the next candidate and must not move into the removed node. After retention, current remains in the result and becomes the correct predecessor. The result begins at dummy.next, not dummy. These transitions are what remove the special branch for the original head.",
              "wrongOptionExplanationsByOptionId": {
                "delete_advance_prev": "Advancing into a removed node breaks the invariant and may skip consecutive matching nodes.",
                "return_dummy": "The sentinel is implementation scaffolding; returning it violates the stated logical-list contract."
              },
              "omittedCorrectExplanationsByOptionId": {
                "delete_keep_prev": "Keeping prev is necessary to test the new successor after a deletion, especially for consecutive removals.",
                "retain_advance_prev": "Advancing after retention preserves prev as the last kept node and predecessor of the next candidate."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "simplify_head_boundary_with_sentinel",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "dummy_head",
              "problemArchetypeId": "remove_or_rewire_node"
            },
            "id": "alg-linked-list-sentinel-02-uniform-predecessor-invariant",
            "difficulty": "intermediate"
          },
          {
            "prompt": "A routine creates dummy.next = head and returns dummy.next after deleting the first matching node. Which pair of outcomes is correct?",
            "constraints": [
              "At most one matching node is deleted.",
              "The list is acyclic and the sentinel is not logical data."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "empty_null_head_successor",
                  "text": "If head is null, return null; if head is the match, set dummy.next = head.next and return that successor."
                },
                {
                  "id": "empty_dummy_head_dummy",
                  "text": "Return the sentinel node itself for both the empty and head-deletion cases."
                },
                {
                  "id": "empty_error_head_null",
                  "text": "Throw for empty input and always return null after deleting the head."
                },
                {
                  "id": "allocate_replacement",
                  "text": "Allocate a new head node even when a successor already exists."
                }
              ],
              "acceptedOptionIds": [
                "empty_null_head_successor"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The sentinel's next field is the canonical logical-head reference for both the empty and head-deletion cases.",
              "details": "When head is null, dummy.next is null and no mutation is needed. When the old head is removed, assigning dummy.next to its successor updates the logical head through the same predecessor link used for internal deletion. Returning dummy would expose scaffolding; returning null unconditionally would lose a nonempty suffix; replacement allocation is unnecessary.",
              "wrongOptionExplanationsByOptionId": {
                "empty_dummy_head_dummy": "The output contract excludes the sentinel, so dummy itself is not a valid logical result.",
                "empty_error_head_null": "Empty input can be handled normally, and deleting the head does not imply that the entire suffix is empty.",
                "allocate_replacement": "The existing successor already has the correct identity and link structure."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "simplify_head_boundary_with_sentinel",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "dummy_head",
              "problemArchetypeId": "remove_or_rewire_node"
