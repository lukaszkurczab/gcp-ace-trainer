        "items": [
          {
            "id": "alg-contrast-window-prefix-queries-001",
            "prompt": "An unsorted static array receives exactly one query for the sum of a known interval [l, r], and no later reuse is possible. Which baseline is usually sufficient?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan_interval",
                  "text": "Scan the requested interval once."
                },
                {
                  "id": "prefix_mandatory",
                  "text": "Always build an O(n)-space prefix array first."
                },
                {
                  "id": "sliding_all",
                  "text": "Enumerate every possible window before answering."
                },
                {
                  "id": "sort_range",
                  "text": "Sort the interval before summing."
                }
              ],
              "acceptedOptionIds": [
                "scan_interval"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "One unrepeated query does not automatically justify a reusable index.",
              "details": "A direct scan costs O(r - l + 1) time and O(1) auxiliary space.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_mandatory": "The one query may not repay preprocessing or memory.",
                "sliding_all": "Only one interval is requested.",
                "sort_range": "Sorting is unnecessary and changes order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_window_or_prefix_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-queries-002",
            "prompt": "An immutable n-value array will receive q arbitrary range-sum queries. Which workload expression supports prefix sums?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "build_plus_queries",
                  "text": "O(n) preprocessing followed by O(1) arithmetic per query."
                },
                {
                  "id": "move_between_queries",
                  "text": "One moving window is O(1) regardless of how far query boundaries jump."
                },
                {
                  "id": "sort_once",
                  "text": "Sorting once makes original interval sums constant-time."
                },
                {
                  "id": "scan_free",
                  "text": "Every query is free because the array is static."
                }
              ],
              "acceptedOptionIds": [
                "build_plus_queries"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Prefix state separates one build cost from repeated query cost.",
              "details": "The complete workload is O(n + q) time with O(n) retained prefix storage.",
              "wrongOptionExplanationsByOptionId": {
                "move_between_queries": "Moving between arbitrary ranges may cross many elements.",
                "sort_once": "Sorting destroys original interval membership.",
                "scan_free": "Static data permits reuse but still requires an index."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_window_or_prefix_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-queries-003",
            "prompt": "The task asks for the maximum sum over every length-k block, visited from left to right exactly once. Which repeated-workload choice is strongest?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "rolling_window",
                  "text": "Use one rolling sum in O(n) time and O(1) auxiliary state."
                },
                {
                  "id": "prefix_only",
                  "text": "A prefix array is the only valid way to reuse work."
                },
                {
                  "id": "scan_each",
                  "text": "Rescan k elements for every block."
                },
                {
                  "id": "query_count",
                  "text": "Treat each block as an unrelated random query."
                }
              ],
              "acceptedOptionIds": [
                "rolling_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Many intervals do not automatically imply prefix preprocessing.",
              "details": "Sequential adjacent queries can reuse a moving aggregate more compactly.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_only": "Prefix sums are valid but use more state than this sequential workload needs.",
                "scan_each": "This repeats overlap and costs O(nk).",
                "query_count": "Their boundaries advance predictably."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_window_or_prefix_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-queries-004",
            "prompt": "After each point update, later range sums must reflect the new value. What is the main issue with a plain static prefix array?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
