            }
          },
          {
            "id": "alg-backtracking-partition-018",
            "prompt": "A collect-all partition solver returns s partitions, and each partition contains at most n segment references or copied segments. Select a lower bound on materialized output work and output space.",
            "constraints": [
              "Every returned partition is stored independently."
