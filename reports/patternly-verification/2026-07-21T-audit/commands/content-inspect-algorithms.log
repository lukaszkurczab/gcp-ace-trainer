          {
            "id": "alg-tp-sorted-sum-rule-dependency",
            "prompt": "Which exact precondition makes the usual low-sum/advance-left and high-sum/retreat-right rules valid for pair-sum search?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "even_length",
                  "text": "The array length is even."
                },
                {
                  "id": "nondecreasing_candidate_interval",
                  "text": "The candidate interval is ordered, so its endpoints are its value extremes."
                },
                {
                  "id": "two_indices",
                  "text": "The implementation uses two indices."
                },
                {
                  "id": "positive_values",
                  "text": "Every value is positive."
                }
              ],
              "acceptedOptionIds": [
                "nondecreasing_candidate_interval"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The movement rule relies on endpoints being value extrema of the remaining candidates. Nondecreasing order supplies the inequalities needed for safe elimination.",
              "details": "A low sum eliminates left only because right is the largest partner still available to it. A high sum eliminates right only because left is the smallest partner still available to it. Positive values and array length do not establish those extremal bounds, and two indices are merely representation. The precondition is part of correctness, not an optional performance hint.",
              "wrongOptionExplanationsByOptionId": {
                "two_indices": "Index count does not imply ordered boundary semantics or safe candidate elimination.",
                "positive_values": "Negative values are compatible with the method when the array remains sorted; positivity is not the required property.",
                "even_length": "The algorithm works for odd or even lengths under the distinct-position stopping rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "validate_sorted_input_dependency",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-tp-sorted-unsorted-elimination-counterexample",
            "prompt": "For unsorted values [8, 1, 6, 4] and target 10, left=0 and right=3 give sum 12. If the code retreats right because the sum is high, what valid pair can be skipped?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "eight_plus_one",
                  "text": "The pair 8+1, even though it sums to 9."
                },
                {
                  "id": "one_plus_four",
                  "text": "The pair 1+4, even though it sums to 5."
                },
                {
                  "id": "eight_plus_two_none",
                  "text": "No pair is skipped because high-sum movement is valid on any array."
                },
                {
                  "id": "six_plus_four",
                  "text": "The pair 6+4, because retreating right moves away from value 4 before value 6 is considered as the left endpoint."
                }
              ],
              "acceptedOptionIds": [
                "six_plus_four"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Physical right=4 is not the largest remaining value, so a high endpoint sum does not prove that value 4 is unusable. Retreating right skips the valid pair 6+4.",
