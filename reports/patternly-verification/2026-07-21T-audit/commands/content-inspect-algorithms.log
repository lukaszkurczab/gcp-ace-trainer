            "feedback": {
              "reason": "One-query strategy comparison includes the cost required to make each strategy legal.",
              "details": "A direct scan is both correct and asymptotically cheaper than one-off sorting.",
              "wrongOptionExplanationsByOptionId": {
                "binary_log": "The method is not correct without ordering.",
                "sort_ignored": "The required setup dominates.",
                "both_log": "A scan can inspect n positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_single_query_binary_and_linear_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-single-003",
            "prompt": "A sorted array has n = 6. Both a scan and binary search are correct. Which conclusion is defensible?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "measure_or_simplify",
                  "text": "Binary search has better asymptotic worst case, but simplicity and measured constants may justify a scan for this tiny fixed size."
                },
                {
                  "id": "binary_mandatory",
                  "text": "Binary search is mandatory because O(log n) always dominates engineering considerations."
                },
                {
                  "id": "scan_asymptotically_better",
                  "text": "The scan has the better asymptotic class."
                },
                {
                  "id": "correctness_diff",
                  "text": "Only one of the two is correct."
                }
              ],
              "acceptedOptionIds": [
                "measure_or_simplify"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Asymptotic advantage and practical preference are related but not identical.",
              "details": "The transfer boundary is growth: binary search matters as n scales, while tiny fixed domains may favor simpler code.",
              "wrongOptionExplanationsByOptionId": {
                "binary_mandatory": "Asymptotics do not determine every fixed-size implementation decision.",
                "scan_asymptotically_better": "O(n) is worse than O(log n) as n grows.",
                "correctness_diff": "Both satisfy the exact-match contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_single_query_binary_and_linear_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-single-004",
            "prompt": "A scan stops at the first element and binary search takes several iterations. Does that make the scan asymptotically better for one successful input?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_case_vs_bound",
                  "text": "No. That is a favorable case for the scan, not its worst-case growth bound."
                },
                {
                  "id": "yes_o1",
                  "text": "Yes. Linear scan is O(1) because one input finishes immediately."
                },
                {
                  "id": "binary_wrong",
                  "text": "Yes, and binary search is therefore incorrect."
                },
                {
                  "id": "same_always",
                  "text": "Both always perform the same number of comparisons."
                }
              ],
              "acceptedOptionIds": [
                "no_case_vs_bound"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Single-query cost comparison should distinguish best case, expected case, and worst case.",
              "details": "A scan can be excellent on early hits while retaining O(n) worst-case behavior.",
              "wrongOptionExplanationsByOptionId": {
                "yes_o1": "Big-O worst case is not determined by one instance.",
                "binary_wrong": "Iteration count does not imply incorrectness.",
                "same_always": "Their traces vary by target location and absence."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_single_query_binary_and_linear_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-single-005",
