      {
        "id": "alg-arrays-output-space-007",
        "prompt": "Arrange the steps for analyzing the space usage of a sequence algorithm.",
        "difficulty": "foundational",
        "interaction": {
          "type": "ordering",
          "elements": [
            {
              "id": "identify_required_result",
              "text": "Identify the exact required output and its size."
            },
            {
              "id": "identify_input_storage",
              "text": "Separate pre-existing input storage from memory allocated by the algorithm."
            },
            {
              "id": "identify_temporary_state",
              "text": "List temporary collections, recursion state, indices, and other working memory."
            },
            {
              "id": "report_separate_bounds",
              "text": "Report output space and auxiliary space separately."
            }
          ],
          "canonicalOrder": [
            "identify_required_result",
            "identify_input_storage",
            "identify_temporary_state",
            "report_separate_bounds"
          ],
          "scoringMethod": "adjacent_relations"
        },
        "scoringContract": {
          "type": "ordering",
          "maxPoints": 3
        },
        "feedback": {
          "reason": "Space accounting begins with the contract, then separates input, result, and temporary state.",
          "details": "Without identifying the required output first, the same structure may be misclassified as either result storage or working memory. Separate reporting avoids double-counting."
        },
