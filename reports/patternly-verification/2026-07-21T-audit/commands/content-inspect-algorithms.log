              "availableValuesByDimension": {
                "comparison_lower_bound": [
                  "Ω(n)",
                  "Ω(n log n)",
                  "Ω(n²)",
                  "Ω(2^n)"
                ],
                "optimal_sort_time": [
                  "O(n)",
                  "O(n log n)",
                  "O(n²)",
                  "O(2^n)"
                ]
              },
              "acceptedValuesByDimension": {
                "comparison_lower_bound": [
                  "Ω(n log n)"
                ],
                "optimal_sort_time": [
                  "O(n log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "comparison_lower_bound": {
                  "decision_tree": "Ω(n log n)"
                },
                "optimal_sort_time": {
                  "matching_upper_bound": "O(n log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "There are n! possible key orders, so a comparison decision tree needs logarithmic depth in n!, which is Ω(n log n).",
              "details": "The n log n term is not merely avoidable overhead when the output contract requires a full arbitrary-key order."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_expected_hash_and_sorting_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-cost-022",
            "prompt": "Hashing one key costs H and comparing two keys costs C. Count n keys by hashing, or sort them by comparison and scan. Select symbolic dominant operation costs.",
            "constraints": [
              "Hash construction performs expected O(n) hash/equality operations.",
              "Comparison sorting performs O(n log n) key comparisons.",
              "The final scan is O(n)."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "hash_key_work",
                "sort_key_work"
              ],
              "availableValuesByDimension": {
                "hash_key_work": [
                  "O(nH)",
                  "O(n log n·H)",
                  "O(nC)",
                  "O(H + n)"
                ],
                "sort_key_work": [
                  "O(nC)",
                  "O(n log n·C)",
                  "O(nH)",
                  "O(C log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "hash_key_work": [
                  "O(nH)"
                ],
                "sort_key_work": [
                  "O(n log n·C)"
                ]
              },
              "normalizedAliasesByDimension": {
                "hash_key_work": {
                  "hash_cost": "O(nH)"
                },
                "sort_key_work": {
                  "comparison_cost": "O(n log n·C)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Expected operation counts must be multiplied by the actual key-operation costs.",
              "details": "The symbolic model explains why a larger asymptotic count of very cheap comparisons can compete with expensive hashing."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_expected_hash_and_sorting_cost",
