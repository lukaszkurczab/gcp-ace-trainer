        "items": [
          {
            "id": "algorithms-intervals-merge-001",
            "prompt": "Merge the half-open intervals [5, 7), [1, 3), [2, 6), and [8, 9) into a start-sorted, non-overlapping representation of their union.",
            "constraints": [
              "Intervals that only touch are kept separate under this batch's half-open scheduling policy.",
              "Input order is arbitrary."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "merged_union",
                  "text": "[1, 7), [8, 9)"
                },
                {
                  "id": "keep_input_groups",
                  "text": "[1, 3), [2, 7), [8, 9)"
                },
                {
                  "id": "merge_all",
                  "text": "[1, 9)"
                }
              ],
              "acceptedOptionIds": [
                "merged_union"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "After start sorting, [1, 3), [2, 6), and [5, 7) form one overlapping chain, while [8, 9) begins after the active end.",
              "details": "Sort to [1, 3), [2, 6), [5, 7), [8, 9). Seed the active interval with [1, 3). Because 2 < 3, extend its end to max(3, 6) = 6. Because 5 < 6, extend again to 7. The next start 8 is not before the active end 7, so emit [1, 7) and start a new active interval [8, 9). Finally emit the active interval. The scan preserves exactly the covered set: it merges overlapping chains but does not bridge a positive gap. The output remains sorted and pairwise non-overlapping.",
              "wrongOptionExplanationsByOptionId": {
                "keep_input_groups": "The first two output intervals still overlap, so the result is not a non-overlapping representation of the union.",
                "merge_all": "There is a positive gap from 7 to 8. Merging across it would add points that were not covered by any input interval."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_overlapping_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          },
          {
            "id": "algorithms-intervals-merge-002",
            "prompt": "During a start-sorted merge scan, the active interval is [1, 10) and the next interval is [3, 4). What must the active interval become?",
            "constraints": [
              "The next interval is known to overlap the active interval.",
              "The output must preserve the complete union."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "remain_one_ten",
                  "text": "[1, 10)"
                },
                {
                  "id": "shrink_to_four",
                  "text": "[1, 4)"
                },
                {
                  "id": "choose_shorter",
                  "text": "[3, 4)"
                }
              ],
              "acceptedOptionIds": [
                "remain_one_ten"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Merging overlapping intervals updates the end with max(active.end, next.end); a contained interval cannot shrink the union.",
              "details": "The active interval summarizes the union of the overlapping chain processed so far. That invariant requires active.end to be the greatest end in the chain, not merely the end of the most recently read interval. Here max(10, 4) is 10, so no state changes. This containment case catches a common implementation bug: active.end = next.end. It also demonstrates why interval length is not a decision rule. The shorter interval overlaps because of its position, but its length does not determine which bounds survive; set union does.",
              "wrongOptionExplanationsByOptionId": {
                "shrink_to_four": "Assigning next.end would discard the covered range [4, 10). An overlapping interval can be contained inside the active interval.",
                "choose_shorter": "Replacing the active interval with the shorter input loses both the earlier start and most of the covered set."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_overlapping_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          },
          {
            "id": "algorithms-intervals-merge-003",
            "prompt": "Under half-open semantics, what is the merged result of [1, 3), [2, 5), and [4, 6)?",
            "constraints": [
              "The intervals are already sorted by start."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_chain",
                  "text": "[1, 6)"
                },
                {
                  "id": "first_and_third_separate",
                  "text": "[1, 5), [4, 6)"
                },
                {
                  "id": "only_direct_pairs",
                  "text": "[1, 3), [2, 6)"
                }
              ],
              "acceptedOptionIds": [
                "one_chain"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Overlap is transitive through the maintained union component: the middle interval extends the active end so the third interval joins the same chain.",
              "details": "The first and third original intervals do not overlap directly because 4 is not before 3. That does not imply separate union components. After processing [2, 5), the active interval is [1, 5). The third interval starts at 4, which is before the updated active end 5, so it extends the component to [1, 6). The algorithm therefore compares against maintained state, not only against the first interval or a static pair graph edge. This is a key transfer rule for chains of containment and partial overlap.",
              "wrongOptionExplanationsByOptionId": {
                "first_and_third_separate": "These outputs still overlap on [4, 5). The active interval was extended by the middle interval before the third was compared.",
                "only_direct_pairs": "A union representation cannot retain overlapping output. Merge decisions propagate through the active chain rather than grouping only original direct pairs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_overlapping_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          },
          {
            "id": "algorithms-intervals-merge-004",
            "prompt": "A half-open booking system merges only intervals that share occupied time. How should [1, 3) and [3, 5) appear in the normalized output?",
            "constraints": [
              "Back-to-back bookings must remain distinguishable.",
              "The merge predicate follows the same half-open conflict contract."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "keep_separate",
                  "text": "[1, 3), [3, 5)"
                },
                {
                  "id": "merge_touching",
                  "text": "[1, 5)"
                },
                {
                  "id": "drop_second",
                  "text": "[1, 3)"
                }
              ],
              "acceptedOptionIds": [
                "keep_separate"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The active interval extends only when next.start < active.end; equality is a non-overlap handoff under the stated policy.",
              "details": "This item makes the product's normalization policy explicit. Some union representations choose to coalesce adjacent half-open intervals because [1, 3) union [3, 5) equals [1, 5) as a set. Here the domain requires back-to-back bookings to remain distinguishable, so equality starts a new output interval. The merge implementation must therefore use the same strict comparator as conflict detection. The transfer boundary matters: if the output contract cares only about covered measure and not booking boundaries, coalescing adjacency could be valid, but it would be a different declared normalization policy.",
              "wrongOptionExplanationsByOptionId": {
                "merge_touching": "Although the mathematical union is contiguous, the product contract says touching bookings are non-conflicting and must remain distinguishable. Using '<=' would erase that boundary.",
                "drop_second": "The second interval contributes covered time from 3 to 5 and cannot be discarded."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_overlapping_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          },
          {
            "id": "algorithms-intervals-merge-005",
            "prompt": "Two ranges use the closed convention and the output should merge every non-empty intersection. How should [1, 3] and [3, 5] be normalized?",
            "constraints": [
              "A one-point intersection counts as overlap.",
              "The output represents connected closed coverage."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "merge_closed",
                  "text": "[1, 5]"
                },
                {
                  "id": "keep_separate",
                  "text": "[1, 3], [3, 5]"
                },
                {
                  "id": "remove_point",
                  "text": "[1, 3), (3, 5]"
                }
              ],
              "acceptedOptionIds": [
                "merge_closed"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Both closed intervals include 3, so their intersection is non-empty and the merged union spans from 1 to 5.",
              "details": "The merge comparison must match the closed overlap predicate: next.start <= active.end. Equality joins the chain because the shared endpoint belongs to both ranges. Emitting the two original intervals would leave overlapping normalized output, while changing one endpoint to open would alter the represented set. This is the closed counterpart to the half-open booking item. The pair demonstrates why comparator equality is not a style preference and why a reusable merge routine must receive or encapsulate the endpoint contract explicitly.",
              "wrongOptionExplanationsByOptionId": {
                "keep_separate": "The two outputs still intersect at 3, violating the requirement that normalized outputs be non-overlapping.",
                "remove_point": "Changing endpoint inclusion removes a covered point and changes the input contract instead of merging it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_overlapping_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          },
          {
            "id": "algorithms-intervals-merge-006",
            "prompt": "Why can sorting by end break a one-pass merge that only revises its last output interval?",
            "constraints": [
              "The output is emitted incrementally and earlier outputs are not revisited."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "backward_start",
                  "text": "A later end-sorted interval may start before already emitted output and overlap more than the last interval."
                },
                {
                  "id": "end_sort_not_deterministic",
                  "text": "End sorting cannot be deterministic."
                },
                {
                  "id": "end_sort_changes_lengths",
                  "text": "End sorting changes interval durations."
                }
              ],
              "acceptedOptionIds": [
                "backward_start"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "End order permits a future interval to reach backward across committed output, while a tail-only merge requires nondecreasing starts.",
              "details": "The counterexample [2, 3), [4, 5), [1, 10) in end order shows the problem. After the first two intervals are emitted separately, [1, 10) overlaps both but arrives too late to revise the first output. Start sorting would place the containing interval first and preserve one active union component. The lesson is not that end sorting is generally bad; it is that a one-pass union merge needs the exact monotonic boundary supplied by start order. Finish-time order belongs to different objectives with different proofs.",
              "wrongOptionExplanationsByOptionId": {
                "end_sort_not_deterministic": "A tie-breaker can make end sorting deterministic. The problem is the missing monotonic-start guarantee.",
                "end_sort_changes_lengths": "Sorting changes order only; durations remain the same. The invariant failure comes from backward-reaching starts."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_overlapping_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          },
          {
            "id": "algorithms-intervals-merge-007",
            "prompt": "Order the operations of a standard start-sorted merge scan.",
            "constraints": [
              "Use the already-declared endpoint predicate when deciding overlap.",
              "The output is built left to right."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "sort_by_start",
                  "text": "Sort input intervals by nondecreasing start."
                },
                {
                  "id": "seed_active",
                  "text": "Seed the active interval from the first sorted interval."
                },
                {
                  "id": "compare_next",
                  "text": "Compare each next start with the active end using the endpoint contract."
                },
                {
                  "id": "extend_or_emit",
                  "text": "If overlapping, extend active.end with max; otherwise emit active and replace it."
                },
                {
                  "id": "emit_final",
                  "text": "Emit the remaining active interval after the scan."
                }
              ],
              "canonicalOrder": [
                "sort_by_start",
                "seed_active",
                "compare_next",
                "extend_or_emit",
                "emit_final"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 4
            },
            "feedback": {
              "reason": "Sorting establishes monotonic starts, the active interval summarizes the current union component, and the final flush handles the component with no later gap.",
              "details": "Each adjacent relation preserves an invariant. Sorting must precede seeding so the active interval is the leftmost unseen component. Comparison must occur before mutation or emission. Extending with max keeps the full union of the current overlap chain; emitting on a proven gap is safe because future starts cannot move backward. The final active interval needs an explicit flush because no next interval triggers its emission. Adjacent-relation scoring focuses on these dependencies rather than arbitrary exact positions disconnected from meaning."
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_overlapping_intervals",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          },
          {
            "id": "algorithms-intervals-merge-008",
            "prompt": "During a start-sorted merge, select all invariants that should hold after a processed prefix.",
            "constraints": [
              "Select all correct statements.",
              "The active interval has not yet been emitted."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "emitted_sorted_disjoint",
                  "text": "All emitted intervals are sorted and pairwise non-overlapping."
                },
                {
                  "id": "active_is_current_union",
                  "text": "The active interval is the union of the not-yet-emitted overlapping chain."
                },
                {
                  "id": "active_end_is_max",
                  "text": "The active end is the maximum end seen in that chain."
                },
                {
                  "id": "active_before_emitted",
                  "text": "The active interval may begin before an already emitted interval."
                }
              ],
              "acceptedOptionIds": [
                "emitted_sorted_disjoint",
                "active_is_current_union",
                "active_end_is_max"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Emitted output is final and disjoint, while the active interval stores the complete current overlap chain with its greatest end.",
              "details": "These invariants divide committed state from mutable state. Emitted intervals lie strictly before the active interval and cannot be affected by unseen starts. The active interval begins at the first start of the current component and ends at the maximum end encountered in that component. Comparing the next interval against this summary captures transitive overlap chains. If the active interval could begin before emitted output, or if its end tracked only the latest input, prior emission would be unsafe and containment would lose coverage. The invariants are the correctness argument behind the concise implementation.",
              "wrongOptionExplanationsByOptionId": {
