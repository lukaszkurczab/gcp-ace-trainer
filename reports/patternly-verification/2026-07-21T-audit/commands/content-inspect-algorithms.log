        "items": [
          {
            "prompt": "A singly linked structure may contain a cycle. The routine must not modify nodes and may use only O(1) extra space. Which strategy directly fits the contract?",
            "constraints": [
              "Each node has at most one next reference.",
              "The list must remain unchanged."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_values",
                  "text": "Sort payload values and look for duplicates."
                },
                {
                  "id": "visited_set",
                  "text": "Store every visited node reference in a hash set."
                },
                {
                  "id": "reverse_structure",
                  "text": "Reverse links and infer a cycle from whether the head changes."
                },
                {
                  "id": "floyd_convergence",
                  "text": "Advance slow by one and fast by two; report a cycle only if their node references meet after movement."
                }
              ],
              "acceptedOptionIds": [
                "floyd_convergence"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Floyd's convergence test detects a reachable cycle without mutation or a visited-node collection.",
              "details": "In an acyclic list, fast eventually reaches null. In a reachable cycle, both pointers enter the cycle and their relative position changes until their references coincide. A visited set is correct but uses O(n) extra space; duplicate values do not imply repeated nodes; reversing mutates the structure and does not provide the stated safe contract.",
              "wrongOptionExplanationsByOptionId": {
                "visited_set": "This can detect a cycle but violates the O(1)-extra-space requirement.",
                "sort_values": "Payload duplicates are unrelated to structural cycles and sorting does not expose repeated node identity.",
                "reverse_structure": "Mutation is forbidden, and head changes are not a valid general cycle criterion."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_cycle_by_pointer_convergence",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "fast_slow_pointer",
              "problemArchetypeId": "detect_cycle"
            },
            "id": "alg-linked-list-cycle-detection-01-floyd-applicability",
            "difficulty": "introductory"
          },
          {
            "prompt": "After slow and fast are both inside a cycle of length L, slow advances one edge and fast two per iteration. Why must they eventually reference the same node?",
            "constraints": [
              "Both pointers are already inside the same reachable cycle.",
              "The speed difference is exactly one edge per iteration."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "phase_mod_l",
                  "text": "Their relative offset increases by one modulo L, so within at most L iterations it becomes zero."
                },
                {
                  "id": "fast_stops",
                  "text": "Fast eventually reaches null inside the cycle and waits for slow."
                },
                {
                  "id": "values_repeat",
                  "text": "A finite cycle must contain duplicate payload values, which forces a meeting."
                },
                {
                  "id": "slow_moves_backward",
                  "text": "Slow reverses direction when fast passes it."
                }
              ],
              "acceptedOptionIds": [
                "phase_mod_l"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Inside the cycle, the relative phase changes by one modulo the finite cycle length and therefore must hit zero.",
              "details": "Number cycle positions modulo L. Each iteration adds two to fast's position and one to slow's, so the offset gains one modulo L. The sequence of offsets visits every residue before repeating, including zero. Zero means both references designate the same node. Payloads may all be distinct, null is unreachable inside the cycle, and neither pointer changes direction.",
              "wrongOptionExplanationsByOptionId": {
                "values_repeat": "Cycle convergence depends on positions and references, not on payload duplication.",
                "fast_stops": "A pointer following next inside a cycle never reaches null.",
                "slow_moves_backward": "Both pointers continue following next in the same direction."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "detect_cycle_by_pointer_convergence",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "fast_slow_pointer",
              "problemArchetypeId": "detect_cycle"
            },
            "id": "alg-linked-list-cycle-detection-02-relative-phase-convergence",
            "difficulty": "advanced"
          },
          {
            "prompt": "Select all inputs that contain a cycle under the ordinary singly linked definition.",
            "constraints": [
              "A cycle is defined by repeated node identity along next traversal.",
              "Only the listed next references exist."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "empty",
                  "text": "head = null, so traversal begins with no node."
                },
                {
                  "id": "single_null",
                  "text": "head = S and S.next = null."
                },
                {
                  "id": "two_back",
                  "text": "A.next = B and B.next = A."
                },
                {
                  "id": "single_self",
                  "text": "head = S and S.next = S."
                }
              ],
              "acceptedOptionIds": [
                "single_self",
                "two_back"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
