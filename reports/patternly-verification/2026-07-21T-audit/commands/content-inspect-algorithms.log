        "items": [
          {
            "id": "hpq-recognize-dynamic-repeated-minimum",
            "prompt": "Jobs arrive over time. After every completion, the scheduler must choose and remove the waiting job with the smallest deadline. Which requirement is the decisive heap signal?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_final_order",
                  "text": "The system needs one complete sorted list only after all jobs have arrived."
                },
                {
                  "id": "repeated_extreme_with_updates",
                  "text": "The system repeatedly removes the current minimum while new candidates are inserted."
                },
                {
                  "id": "membership_queries",
                  "text": "The system repeatedly asks whether a job ID is present."
                },
                {
                  "id": "fifo_arrival_order",
                  "text": "The system always processes the earliest arrival, regardless of deadline."
                }
              ],
              "acceptedOptionIds": [
                "repeated_extreme_with_updates"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Repeated access to a changing extreme is the decisive signal: the scheduler needs the current minimum after each update.",
              "details": "A min-heap maintains exactly the ordering needed at the root while allowing insertions and removals without re-sorting the entire waiting set. The task does not require every job to be globally ordered; it requires the next smallest deadline again and again. A one-time final ordering favors sorting, membership favors a set or map, and strict arrival order favors a queue. Transfer this rule to any workload that repeatedly exposes one best candidate under updates.",
              "wrongOptionExplanationsByOptionId": {
                "one_final_order": "A complete one-time ordering is a sorting boundary, not a repeated-extreme boundary. A heap would add incremental maintenance that the requirement does not use.",
                "membership_queries": "Membership does not require an extreme element. A set or map represents presence directly and avoids heap-order maintenance.",
                "fifo_arrival_order": "FIFO order is determined by arrival sequence rather than a priority key. A queue represents that contract directly."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_repeated_extreme_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "schedule_by_priority"
            }
          },
          {
            "id": "hpq-recognize-one-shot-minimum-boundary",
            "prompt": "An unsorted array is available in memory, and the only required result is its minimum value once. No later insertions or removals occur. Which approach best matches the requirement?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "balanced_tree",
                  "text": "Insert every value into a balanced search tree and read its minimum."
                },
                {
                  "id": "build_min_heap",
                  "text": "Build a min-heap and then peek at its root."
                },
                {
                  "id": "linear_scan",
                  "text": "Scan the array once and keep the smallest value seen."
                },
                {
                  "id": "full_sort",
                  "text": "Sort the entire array and read the first value."
                }
              ],
              "acceptedOptionIds": [
                "linear_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "One minimum query over static input needs only a linear scan; repeated-extreme maintenance is absent.",
              "details": "A scan visits each element once and retains one scalar, giving the required minimum without maintaining additional structure. Building a heap can also produce the minimum, but it solves an update-and-repeat problem that the prompt does not contain. Sorting or a balanced tree maintain substantially more order than one answer requires. The boundary changes when later operations repeatedly insert candidates or remove the current extreme.",
              "wrongOptionExplanationsByOptionId": {
                "build_min_heap": "A heap is correct but unnecessary here. Its maintained priority state pays off only when the extreme is queried or removed repeatedly under updates.",
                "full_sort": "Sorting computes a complete order even though the contract asks for one extreme once.",
                "balanced_tree": "A search tree supports a broader ordered set of operations than the one-shot minimum query needs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_repeated_extreme_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "choose_repeated_extreme"
            }
          },
          {
            "id": "hpq-recognize-workload-set",
            "prompt": "Select all workloads in which maintaining a heap frontier is material to the stated requirement.",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "single_membership_test",
                  "text": "The system checks once whether a specific identifier occurs in an array."
                },
                {
                  "id": "dispatch_highest_priority",
                  "text": "Tasks arrive while the system repeatedly dispatches the highest-priority waiting task."
                },
                {
                  "id": "merge_sorted_feeds",
                  "text": "The system merges many sorted feeds by repeatedly choosing the smallest current feed head."
                },
                {
                  "id": "report_kth_largest_stream",
                  "text": "After each new value, the system reports the kth largest value seen so far."
                },
                {
                  "id": "final_complete_sort",
                  "text": "The system receives all values first and then emits one complete sorted sequence."
                }
              ],
              "acceptedOptionIds": [
                "dispatch_highest_priority",
                "merge_sorted_feeds",
                "report_kth_largest_stream"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each accepted workload repeatedly exposes a priority frontier that changes as candidates enter or leave.",
              "details": "Priority dispatch keeps the best waiting task accessible, k-way merge keeps one current candidate from each sorted source, and streaming kth-largest maintains a bounded threshold frontier. A membership test is a lookup problem, and a one-time complete ordering is a sorting problem. Surface words such as “largest” or “sorted” are not enough; the decisive structure is repeated extreme selection from a changing candidate set.",
              "wrongOptionExplanationsByOptionId": {
                "single_membership_test": "Presence of one identifier is a lookup decision, not an extreme-selection decision. A set, map, or direct scan matches the requirement.",
                "final_complete_sort": "A heap can produce sorted output by repeated removal, but a one-time complete order does not require an incrementally maintained frontier."
              },
              "omittedCorrectExplanationsByOptionId": {
                "dispatch_highest_priority": "Omitting priority dispatch misses the core repeated extract-best signal under insertions.",
                "merge_sorted_feeds": "Omitting the merge misses that only the current head of each sorted source competes for the next output.",
                "report_kth_largest_stream": "Omitting the streaming threshold misses that a bounded heap can maintain the kth-largest frontier after every arrival."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_repeated_extreme_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bounded_heap",
              "problemArchetypeId": "choose_repeated_extreme"
            }
          },
          {
            "id": "hpq-recognize-priority-updates-contract",
            "prompt": "A scheduler repeatedly removes the smallest current priority, but an already queued job may later receive a new priority. Which diagnosis is most precise?",
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_after_every_change",
                  "text": "The only valid design is to sort every queued job after each priority change."
                },
                {
                  "id": "fifo_queue",
                  "text": "Priority changes make the workload a FIFO queue problem."
                },
                {
                  "id": "plain_heap_is_complete",
                  "text": "A basic heap automatically finds and updates any arbitrary job in constant time."
                },
                {
                  "id": "heap_with_update_contract",
                  "text": "Use a heap plus an update contract, such as indexed handles or lazy versioning with stale-entry checks."
                }
              ],
              "acceptedOptionIds": [
                "heap_with_update_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Repeated extract-min still indicates a priority frontier, but arbitrary key changes add a separate state-location and validity contract.",
              "details": "A standard heap efficiently repairs order when the changed entry is known, but it does not by itself provide constant-time lookup of an arbitrary job. The design may keep an index from job ID to heap position, use an indexed priority queue, or insert a new version and discard stale entries when they reach the root. The repeated-extreme signal therefore survives, while the mutation contract determines the supporting state. If updates disappear, a simpler ordinary heap may be enough.",
              "wrongOptionExplanationsByOptionId": {
                "plain_heap_is_complete": "Heap order does not provide direct lookup by arbitrary job ID. Updating an unknown interior entry requires additional indexing or another validity strategy.",
                "sort_after_every_change": "Repeated full sorting is not the only valid approach and discards the benefit of local heap repair.",
                "fifo_queue": "Changing priorities do not replace the priority contract with arrival order; the next job is still selected by an extreme key."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_repeated_extreme_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "schedule_by_priority"
            }
          },
          {
            "id": "hpq-recognize-k-way-frontier-signal",
            "prompt": "There are k individually sorted sources containing N total values. The output must be globally sorted. Why is a heap frontier relevant?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "orientation_does_not_matter",
                  "text": "Either heap orientation emits ascending output without changing the key rule."
                },
                {
                  "id": "all_values_are_needed",
                  "text": "Every one of the N values must be placed in the heap before output begins."
                },
                {
                  "id": "one_head_per_source",
                  "text": "Only the current head of each nonempty source can be the next output, so at most k candidates compete."
                },
                {
                  "id": "heap_sorts_each_source",
                  "text": "The heap will repair any source that is internally unsorted."
                }
              ],
              "acceptedOptionIds": [
                "one_head_per_source"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorted sources reduce the candidate set to one head per source, creating a bounded repeated-minimum frontier.",
              "details": "Within a sorted source, no later value can precede its current head. Therefore the next global output must be the smallest among the current heads, and after one head is emitted only that source advances. The heap stores the frontier rather than all N values. If sources are not sorted, this frontier proof fails; if there are only two sources, a direct two-pointer merge may be simpler.",
              "wrongOptionExplanationsByOptionId": {
                "all_values_are_needed": "Loading all N values ignores the sorted-source invariant that limits competition to one current head per source.",
                "heap_sorts_each_source": "A heap over source heads cannot reveal a smaller value hidden behind an out-of-order head. Internal source order is a precondition.",
                "orientation_does_not_matter": "Ascending output needs the smallest frontier key exposed. A max-oriented frontier would choose the wrong next value unless the key is transformed."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_repeated_extreme_requirement",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "k_way_merge",
              "problemArchetypeId": "merge_sorted_sources"
            }
          }
        ],
