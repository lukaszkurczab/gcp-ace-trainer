          "transferBoundary": "For one query, compare the entire legal strategy cost—including sorting, copying, predicate work, and access model—rather than comparing O(log n) with O(n) in isolation."
        },
        "authoringProvenance": {
          "author": "lukasz-kurczab",
          "createdAt": "2026-07-18T00:00:00.000Z",
          "contentBatchId": "contrast-binary-search-vs-linear-scan-single-query-cost-comparison-v1",
          "authoringMethod": "independently_authored"
        },
        "items": [
          {
            "id": "alg-contrast-binary-scan-single-001",
            "prompt": "A random-access array is already sorted and receives one exact query. Both implementations are correct. Which asymptotic comparison applies?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "binary_log_scan_linear",
                  "text": "Binary search is O(log n) and a worst-case scan is O(n)."
                },
                {
                  "id": "both_linear",
                  "text": "Both are O(n)."
                },
                {
                  "id": "scan_constant",
                  "text": "The scan is O(1) because it may find target first."
                },
                {
                  "id": "binary_without_invariant",
                  "text": "Any midpoint loop is O(log n)."
                }
              ],
              "acceptedOptionIds": [
                "binary_log_scan_linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When sorted order and random access already exist, binary search has the lower worst-case query cost.",
              "details": "The one-query contrast changes if sorting, copying, or expensive predicate work must be added first.",
              "wrongOptionExplanationsByOptionId": {
                "both_linear": "A legal binary search halves the remaining interval.",
                "scan_constant": "Worst-case analysis includes target absent or at the end.",
                "binary_without_invariant": "The statement is true only for a correct half-discard implementation."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_single_query_binary_and_linear_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-single-002",
            "prompt": "An unsorted random-access array receives one exact query. Which complete asymptotic comparison is correct?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan_vs_sort",
                  "text": "A scan is O(n); sorting solely to enable binary search is O(n log n) overall."
                },
                {
                  "id": "binary_log",
                  "text": "Binary search is O(log n) on the unsorted array."
                },
                {
                  "id": "sort_ignored",
                  "text": "Sort plus binary search is O(log n) because only query time matters."
                },
                {
                  "id": "both_log",
                  "text": "Both are O(log n)."
                }
              ],
              "acceptedOptionIds": [
                "scan_vs_sort"
