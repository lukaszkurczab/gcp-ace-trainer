          {
            "id": "recursion-basics-choose-recursive-state-linked-search-current-node-not-fixed-head",
            "prompt": "contains(node, target) searches an acyclic singly linked list from node onward. target is fixed for the whole search.\nWhich changing recursive state is minimal?",
            "constraints": [
              "The list is acyclic.",
              "The target value does not change during the search.",
              "The return value is Boolean membership, not the found position."
            ],
            "difficulty": "intermediate",
            "interaction": {
