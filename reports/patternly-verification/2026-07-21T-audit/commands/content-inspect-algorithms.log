                  "O(n log n + k)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ],
                "output_space": [
                  "O(k)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "sort_scan_emit": "O(n log n + k)"
                },
                "auxiliary_space": {
