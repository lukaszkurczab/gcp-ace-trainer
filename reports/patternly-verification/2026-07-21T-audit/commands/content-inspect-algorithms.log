      {
        "id": "ssc-compare-output-sensitive-lower-bound",
        "prompt": "A task must emit every matching pair, and the maximum number of pairs is Θ(n²). Candidate X claims O(n) total time because it finds matches with hashing. Which comparison is valid?",
        "constraints": [
          "Every matching pair must be emitted.",
          "The number of matching pairs may be Θ(n²).",
          "Hash lookup cost is not the only required work."
        ],
        "difficulty": "advanced",
