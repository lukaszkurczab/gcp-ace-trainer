        "items": [
          {
            "id": "alg-mg-geometry-point-segment-degenerate",
            "prompt": "Segment AB has A=B=(2,3), so it is a single point. Segment CD is nondegenerate. Which first decision is required in an intersection routine?",
            "constraints": [
              "Endpoint contact counts as intersection.",
              "Coordinates are exact integers."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "point_on_segment_test",
                  "text": "Treat AB as a point and test whether (2,3) lies on segment CD."
                },
                {
                  "id": "general_orientation_only",
                  "text": "Run only the ordinary four-orientation crossing test and ignore the repeated endpoints."
                },
                {
                  "id": "assign_horizontal_slope",
                  "text": "Give AB slope 0 and compare it with CD."
                },
                {
                  "id": "always_intersects",
                  "text": "Declare every point-segment pair intersecting because a point has zero area."
                }
              ],
              "acceptedOptionIds": [
                "point_on_segment_test"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A collapsed segment changes the predicate from segment-segment crossing to point-on-segment membership.",
              "details": "The zero direction vector invalidates the assumptions behind a general crossing test. The correct branch checks collinearity of the point with CD and verifies that its coordinates lie within CD’s bounds. Assigning an arbitrary slope invents a line, and zero area says nothing about membership. The same reduction applies when both segments collapse: compare the two points directly.",
              "wrongOptionExplanationsByOptionId": {
                "general_orientation_only": "The general test assumes both directed segments are meaningful; with AB collapsed, its orientation values are trivially zero and can misclassify.",
                "assign_horizontal_slope": "A point has no line direction, so assigning slope zero creates geometry not present in the input.",
                "always_intersects": "A point intersects a segment only when it lies on that finite segment."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "diagnose_degenerate_or_precision_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-geometry-touching-endpoint-policy",
            "prompt": "Closed segments AB and CD share exactly one endpoint B=C, and otherwise do not overlap. Under the stated closed-segment contract, what is the intersection result?",
            "constraints": [
              "Closed endpoints are included.",
              "Touching counts as intersection."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "intersects_at_endpoint",
                  "text": "They intersect at the shared endpoint."
                },
                {
                  "id": "no_intersection",
                  "text": "They do not intersect because the orientations do not form a strict crossing."
                },
                {
                  "id": "overlapping_segment",
                  "text": "Their intersection is a positive-length segment."
                },
                {
                  "id": "slope_dependent",
                  "text": "The answer depends on whether their slopes are equal as floating-point values."
                }
              ],
              "acceptedOptionIds": [
                "intersects_at_endpoint"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A closed-segment contract includes endpoint contact even when the strict-crossing signs are not opposite.",
              "details": "Many orientation implementations first detect the proper crossing case and then separately handle zero-orientation points lying on the other segment. The shared endpoint satisfies the on-segment boundary and is therefore an intersection. It is not a positive-length overlap. If a problem instead defines open segments or excludes touching, the accepted boundary changes, which is why endpoint semantics must appear in the prompt rather than only in feedback.",
              "wrongOptionExplanationsByOptionId": {
                "no_intersection": "Strict opposite orientations detect only an interior crossing and omit the explicitly included endpoint case.",
                "overlapping_segment": "One shared point has zero length and is not a collinear interval overlap.",
                "slope_dependent": "Endpoint identity decides this case directly; floating slope equality is irrelevant and fragile."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "diagnose_degenerate_or_precision_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-geometry-collinear-overlap-projection",
            "prompt": "Exact integer segments AB and CD are collinear. Which additional test distinguishes disjoint, touching, and positive-length overlap?",
            "constraints": [
              "The segments may be vertical.",
              "Endpoints are closed."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "project_bounding_intervals",
                  "text": "Compare their closed projections on x and y, using the nonconstant axis or equivalent bounding-box overlap."
                },
                {
                  "id": "cross_zero_is_enough",
                  "text": "A zero orientation alone proves the finite segments overlap."
                },
                {
                  "id": "compare_slopes",
                  "text": "Equal slopes prove overlap."
                },
                {
                  "id": "compare_lengths",
                  "text": "The longer segment always contains the shorter one."
                }
              ],
              "acceptedOptionIds": [
                "project_bounding_intervals"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Collinearity places the segments on one supporting line, but finite overlap still depends on endpoint ranges.",
              "details": "Two collinear segments can be far apart, touch at one endpoint, or share an interval. Checking max(min endpoints) against min(max endpoints) on a suitable axis classifies those cases and works for vertical segments when y is used or when both coordinate boxes are checked. Equal slopes or zero cross products establish only the supporting line. Relative length alone gives no position information.",
              "wrongOptionExplanationsByOptionId": {
                "cross_zero_is_enough": "Collinear segments can be disjoint, so line membership does not establish finite overlap.",
                "compare_slopes": "Equal slopes say nothing about where the segments lie and fail for vertical lines.",
                "compare_lengths": "A shorter segment can lie completely outside the longer segment’s coordinate range."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "diagnose_degenerate_or_precision_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-geometry-near-collinear-float-policy",
            "prompt": "A geometry system receives measured floating coordinates. Two large products in an orientation determinant nearly cancel. Which policy is most defensible?",
            "constraints": [
              "The application defines an error budget.",
              "Inputs are not exact rationals."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scale_aware_or_adaptive",
                  "text": "Use a scale-aware tolerance justified by the error model, or an adaptive robust predicate when the result is near the boundary."
                },
                {
                  "id": "exact_double_zero",
                  "text": "Use det == 0.0 as the only collinearity rule."
                },
                {
                  "id": "fixed_unscaled_epsilon",
                  "text": "Use the same absolute epsilon for every coordinate magnitude without analysis."
                },
                {
                  "id": "slope_equality",
                  "text": "Compare two floating slopes with == because division reduces the magnitude."
                }
              ],
              "acceptedOptionIds": [
                "scale_aware_or_adaptive"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Near cancellation makes a raw floating sign uncertain; the boundary must be tied to scale and the data-error model or resolved with higher precision.",
              "details": "An absolute determinant has units proportional to the product of vector lengths, so one fixed epsilon is not invariant under scaling. A normalized or scale-aware tolerance can model angular error, while adaptive exact predicates can increase precision only when a fast estimate is inconclusive. Exact double zero and equal divided slopes both ignore rounding and vertical cases. The correct choice depends on whether inputs are measured, computed, or exact integers.",
              "wrongOptionExplanationsByOptionId": {
                "exact_double_zero": "Roundoff can produce a tiny nonzero value for a mathematically zero determinant or zero for a tiny real one.",
                "fixed_unscaled_epsilon": "A threshold suitable near unit coordinates can be meaningless at 10^12 or 10^-12 scale.",
                "slope_equality": "Division adds its own instability, loses vertical cases, and exact equality remains brittle."
              }
            },
            "difficulty": "foundational-transfer",
