        "items": [
          {
            "id": "alg-mg-vector-translation-invariant-difference",
            "prompt": "A=(3,-2) and B=(8,4). Both points are then translated by T=(100,-50). Which statement about the directed relation from A to B is correct?",
            "constraints": [
              "A vector from A to B is represented by B-A."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "same_vector_5_6",
                  "text": "The vector remains (5,6) because (B+T)-(A+T)=B-A."
                },
                {
                  "id": "translated_vector",
                  "text": "The vector becomes (105,-44) because the translation must be added to the old vector."
                },
                {
                  "id": "absolute_b",
                  "text": "The vector is represented by the translated endpoint B+T alone."
                },
                {
                  "id": "slope_only",
                  "text": "Only the slope is preserved; the vector components are not."
                }
              ],
              "acceptedOptionIds": [
                "same_vector_5_6"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Subtracting endpoints cancels a common translation, so the directed displacement remains (5,6).",
              "details": "A relation between two positions is represented by their difference, not by either absolute coordinate. Translating both points adds the same T to each, and the terms cancel. The vector retains both direction and magnitude; a slope would lose magnitude and fail for vertical directions. This translation-invariance is the basis for expressing segments, velocities, and relative coordinates.",
              "wrongOptionExplanationsByOptionId": {
                "translated_vector": "A common translation changes absolute positions but cancels from the endpoint difference.",
                "absolute_b": "An endpoint alone depends on the coordinate origin and does not encode the directed relation from A.",
                "slope_only": "The full vector is preserved, and slope is an incomplete representation with a vertical-line failure."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "represent_geometric_relation_with_vectors",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "coordinate_transform",
              "problemArchetypeId": "normalize_coordinates"
            }
          },
          {
            "id": "alg-mg-vector-orientation-sign",
            "prompt": "From O=(0,0), let u point to A=(2,0) and v point to B=(1,3). What does the sign of cross(u,v) establish?",
            "constraints": [
              "Use cross(u,v)=ux*vy-uy*vx.",
              "Coordinates are exact integers."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "counterclockwise",
                  "text": "cross(u,v)=6>0, so v is counterclockwise from u."
                },
                {
                  "id": "clockwise",
                  "text": "cross(u,v)>0, so v is clockwise from u."
                },
                {
                  "id": "parallel",
                  "text": "The vectors are parallel because both x-components are positive."
                },
                {
                  "id": "compare_slopes",
                  "text": "The sign cannot be known without dividing y by x for both vectors."
                }
              ],
              "acceptedOptionIds": [
                "counterclockwise"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A positive two-dimensional cross product means the second vector is counterclockwise from the first under the stated coordinate convention.",
              "details": "The determinant 2·3-0·1=6 is positive. It represents the signed area scale of the parallelogram and gives orientation without slope division. A zero result would require a separate collinear or degenerate interpretation. The sign rule transfers to point-side tests and polygon winding, provided both vectors are formed from the same origin and arithmetic remains exact.",
              "wrongOptionExplanationsByOptionId": {
                "clockwise": "The sign convention is reversed: positive cross(u,v) is counterclockwise in the standard x-right, y-up plane.",
                "parallel": "Positive x-components do not imply proportional vectors; the nonzero cross product proves they are not parallel.",
                "compare_slopes": "Slope division is unnecessary and would introduce a vertical-direction special case."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "represent_geometric_relation_with_vectors",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-vector-common-origin-construction",
            "prompt": "To determine whether C lies to the left, right, or exactly on the directed line from A to B, which pair of vectors must be compared?",
            "constraints": [
              "The relation must be invariant under translating all three points."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "b_minus_a_c_minus_a",
                  "text": "u=B-A and v=C-A, then inspect cross(u,v)."
                },
                {
                  "id": "b_and_c_absolute",
                  "text": "Use the absolute coordinate vectors B and C from the global origin."
                },
                {
                  "id": "a_minus_b_c_minus_b",
                  "text": "Use A-B and C-B but interpret the sign as if the direction were still A to B."
                },
                {
                  "id": "slope_ab_slope_ac",
                  "text": "Compute (By-Ay)/(Bx-Ax) and (Cy-Ay)/(Cx-Ax) and compare with ==."
                }
              ],
              "acceptedOptionIds": [
                "b_minus_a_c_minus_a"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Both vectors must start at A so the determinant compares C against the directed relation A→B.",
              "details": "B-A encodes the directed baseline and C-A encodes the candidate point from the same origin. Their cross product is translation invariant and its sign gives the side. Reversing the baseline changes the sign, so A-B cannot be interpreted as A→B without also changing the convention. Absolute coordinates inject the arbitrary global origin, and slope comparison fails on vertical lines and exact-equality boundaries.",
              "wrongOptionExplanationsByOptionId": {
                "b_and_c_absolute": "The result would depend on where the global origin happens to be, not only on the relation among A, B, and C.",
                "a_minus_b_c_minus_b": "This forms the reversed baseline B→A; keeping the old sign interpretation gives the opposite side.",
                "slope_ab_slope_ac": "Slope division is undefined for vertical directions and equality of floating quotients is not the robust vector predicate."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "represent_geometric_relation_with_vectors",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-vector-zero-direction-degenerate",
            "prompt": "Points P and Q are identical, so vector u=Q-P is (0,0). Which conclusion is valid when comparing u with a nonzero vector v?",
            "constraints": [
              "A direction relation requires a nonzero direction vector."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "direction_undefined",
                  "text": "u has no direction; cross(u,v)=0 and dot(u,v)=0 do not by themselves prove a meaningful parallel or perpendicular relation."
                },
                {
                  "id": "both_parallel_perpendicular",
                  "text": "u is simultaneously a valid parallel and perpendicular direction because both products are zero."
                },
                {
                  "id": "slope_zero",
                  "text": "u has slope 0 and is horizontal."
                },
                {
                  "id": "normalize_zero",
                  "text": "Divide u by its length to obtain a unit direction."
                }
              ],
              "acceptedOptionIds": [
                "direction_undefined"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The zero vector satisfies algebraic equalities trivially but does not define a geometric direction.",
              "details": "Cross and dot predicates often assume both direction vectors are nonzero. With u=(0,0), both products vanish for every v, so treating zero as ordinary parallelism or perpendicularity makes the classifier accept everything. Normalization would divide by zero, and assigning slope zero invents a horizontal direction. The transfer rule is to check vector magnitude or endpoint distinctness before interpreting direction predicates.",
              "wrongOptionExplanationsByOptionId": {
                "both_parallel_perpendicular": "The zero results are caused by degeneracy, not by a unique directional relation.",
                "slope_zero": "A repeated point does not define a line direction or a finite slope.",
                "normalize_zero": "The vector length is zero, so normalization is undefined."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "represent_geometric_relation_with_vectors",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-vector-floating-dot-tolerance",
            "prompt": "Measured nonzero vectors u and v use floating-point components. You want to classify them as approximately perpendicular. Which test has an explicit scale-aware boundary?",
            "constraints": [
              "Measurement and arithmetic error are expected.",
              "The tolerance parameter eps is positive and dimensionless."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scaled_dot_tolerance",
                  "text": "|dot(u,v)| <= eps * |u| * |v|"
                },
                {
                  "id": "exact_dot_zero",
                  "text": "dot(u,v) == 0.0"
                },
                {
                  "id": "component_equality",
                  "text": "ux == vy and uy == vx"
                },
                {
                  "id": "compare_slopes_negative",
                  "text": "(uy/ux) * (vy/vx) == -1.0 for all vectors"
                }
              ],
              "acceptedOptionIds": [
                "scaled_dot_tolerance"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Scaling the tolerance by both vector lengths tests the cosine-like angular error rather than an arbitrary raw magnitude.",
              "details": "The dot product has units and grows with vector magnitude, so a fixed absolute threshold can classify the same angle differently after scaling. Dividing by |u||v| conceptually yields cos(theta); the inequality avoids an explicit division while applying an angular tolerance. Exact zero is appropriate only for exact arithmetic under proven bounds. Slope products fail for vertical components and magnify rounding.",
              "wrongOptionExplanationsByOptionId": {
                "exact_dot_zero": "Floating operations and measurements rarely produce an exact zero even for an intended right angle.",
                "component_equality": "Those component equalities do not characterize perpendicular vectors.",
                "compare_slopes_negative": "Slope division is undefined for vertical directions and exact product equality is numerically fragile."
              }
            },
            "difficulty": "foundational-transfer",
            "taxonomy": {
              "primarySkillAtomId": "represent_geometric_relation_with_vectors",
              "secondarySkillAtomIds": [],
