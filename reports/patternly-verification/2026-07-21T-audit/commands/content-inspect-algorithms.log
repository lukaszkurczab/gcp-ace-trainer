        "items": [
          {
            "id": "alg-complexity-output-001",
            "prompt": "A function must materialize k output records. What time lower bound follows immediately under a unit-cost write model?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "omega_k",
                  "text": "Ω(k)."
                },
                {
                  "id": "omega_1",
                  "text": "Ω(1) only."
                },
                {
                  "id": "omega_log_k",
                  "text": "Ω(log k)."
                },
                {
                  "id": "zero",
                  "text": "No lower bound follows from output."
                }
              ],
              "acceptedOptionIds": [
                "omega_k"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Every materialized result record must be written or otherwise produced.",
              "details": "This lower bound is independent of how quickly the records are discovered.",
              "wrongOptionExplanationsByOptionId": {
                "omega_1": "Writing k distinct records requires at least k output actions.",
                "omega_log_k": "A logarithmic number of writes cannot materialize k records.",
                "zero": "The output contract itself forces work."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "recognize_output_sensitive_lower_bound",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "output_sensitive_analysis"
            }
          },
          {
            "id": "alg-complexity-output-002",
            "prompt": "Why can an existence query be asymptotically easier than listing every witness?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "different_contract",
                  "text": "The decision problem may stop after one proof, while enumeration must produce all k witnesses."
                },
                {
                  "id": "existence_no_input",
                  "text": "Existence queries never inspect input."
                },
                {
                  "id": "listing_constant",
                  "text": "Listing k witnesses is always O(1)."
                },
                {
                  "id": "same_always",
                  "text": "Decision and enumeration always have identical lower bounds."
                }
              ],
              "acceptedOptionIds": [
                "different_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Result contracts create different unavoidable work.",
              "details": "A decision answer is constant-size, whereas enumeration carries an Ω(k) output lower bound.",
              "wrongOptionExplanationsByOptionId": {
                "existence_no_input": "They may still require substantial search.",
                "listing_constant": "Every witness must be emitted.",
                "same_always": "Their output obligations differ."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "recognize_output_sensitive_lower_bound",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "output_sensitive_analysis"
            }
          },
          {
            "id": "alg-complexity-output-003",
            "prompt": "A function returns a new list containing k matches and uses only constant working state. Which space classification is precise?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "output_k_aux_1",
                  "text": "O(k) output space and O(1) auxiliary space."
                },
                {
                  "id": "aux_k",
                  "text": "O(k) auxiliary space only."
                },
                {
                  "id": "both_k",
                  "text": "The same list counts as both output and auxiliary storage."
                },
                {
                  "id": "all_constant",
                  "text": "All space is O(1)."
                }
              ],
              "acceptedOptionIds": [
                "output_k_aux_1"
              ]
