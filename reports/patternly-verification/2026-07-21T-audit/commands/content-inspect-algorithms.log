        ],
        "taxonomy": {
          "roadmapNodeId": "strategy_selection_core",
          "primaryMentalUnitId": "generate_candidate_strategies",
          "patternFamilyId": "complexity_and_constraints"
        },
        "batchKind": "standard",
        "authoringProvenance": {
          "author": "OpenAI GPT-5.6 Pro — candidate authoring assistant",
          "createdAt": "2026-07-18",
