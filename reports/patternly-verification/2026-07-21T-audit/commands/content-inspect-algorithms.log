        "items": [
          {
            "id": "alg-gt-complexity-001",
            "prompt": "A complete BFS or iterative DFS traverses every vertex and edge entry of a graph stored as adjacency lists. Each vertex is discovered once. Derive worst-case traversal time and auxiliary space, excluding the input representation and output.",
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliarySpace"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(V)",
                  "O(E)",
                  "O(V + E)",
                  "O(V²)"
                ],
                "auxiliarySpace": [
                  "O(1)",
                  "O(V)",
                  "O(E)",
                  "O(V + E)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(V + E)"
                ],
                "auxiliarySpace": [
                  "O(V)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "O(E + V)": "O(V + E)"
                },
                "auxiliarySpace": {}
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Each vertex is discovered once and adjacency-list scans total the stored edge entries; visited plus frontier can hold O(V) state.",
              "details": "The vertex loop or discovery events contribute O(V). Summed neighbor iteration contributes O(E) for a directed graph and O(2E) = O(E) for an undirected graph. The visited structure and queue or stack are each bounded by O(V). The fact that BFS uses FIFO and DFS uses LIFO does not change this full-traversal asymptotic cost under the same representation."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_graph_traversal_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "adjacency_list",
              "problemArchetypeId": "traverse_connected_state"
            }
          },
          {
            "id": "alg-gt-complexity-002",
            "prompt": "A traversal of a graph with V vertices uses an adjacency matrix and, for every reached vertex, scans its entire matrix row. All vertices are reached. Derive worst-case time and auxiliary space, excluding the matrix itself and output.",
            "difficulty": "intermediate",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliarySpace"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(V + E)",
                  "O(V log V)",
                  "O(V²)",
                  "O(E²)"
                ],
                "auxiliarySpace": [
                  "O(1)",
                  "O(V)",
                  "O(V²)",
                  "O(E)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(V²)"
                ],
                "auxiliarySpace": [
                  "O(V)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {},
                "auxiliarySpace": {}
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "V reached vertices each trigger a scan of V potential neighbors, while visited and frontier remain linear in V.",
              "details": "The matrix row scan pays for absent as well as present edges, producing V × V checks. The traversal's own visited/frontier state is O(V); the O(V²) matrix is excluded by the prompt as input storage. A matrix is not categorically invalid: on a dense graph E = Θ(V²), O(V²) is also O(V + E). The representation changes the cost model, not the correctness of BFS or DFS."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_graph_traversal_complexity",
              "secondarySkillAtomIds": [],
