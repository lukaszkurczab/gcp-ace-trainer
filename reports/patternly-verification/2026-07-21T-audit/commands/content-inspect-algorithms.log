        "items": [
          {
            "id": "alg-bits-review-001",
            "prompt": "A review note says only, \"clear bit k with x AND complement(1 shifted left by k),\" but does not state a word width. What is missing?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "width_model",
                  "text": "The width that limits complement and defines valid bit positions."
                },
                {
                  "id": "sort_order",
                  "text": "The numeric sort order of inputs."
                },
                {
                  "id": "xor_identity",
                  "text": "A proof that x XOR x is zero."
                },
                {
                  "id": "subset_count",
                  "text": "The number of subsets represented."
                }
              ],
              "acceptedOptionIds": [
                "width_model"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Complement flips every position in the declared word.",
              "details": "Without a width model, the high-bit pattern and portability of the expression are underspecified.",
              "wrongOptionExplanationsByOptionId": {
                "sort_order": "Sorting is unrelated.",
                "xor_identity": "The operation is clear, not XOR cancellation.",
                "subset_count": "The defect is complement ambiguity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_bit_width_or_sign_assumption",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-review-002",
            "prompt": "Two variables contain the same 8-bit pattern 11111111, but one is unsigned and one is signed two's complement. Which diagnosis is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "same_bits_diff_values",
                  "text": "They have the same stored bits but numeric values 255 and -1."
                },
                {
                  "id": "same_value",
                  "text": "Signedness cannot change numeric interpretation."
                },
                {
                  "id": "different_bits",
                  "text": "The stored patterns must differ."
                },
                {
                  "id": "both_invalid",
                  "text": "All-ones is invalid in one of the types."
                }
              ],
              "acceptedOptionIds": [
                "same_bits_diff_values"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Bit pattern and numeric interpretation are separate concepts.",
              "details": "Review must track both width and signedness.",
              "wrongOptionExplanationsByOptionId": {
                "same_value": "The sign bit changes the signed value.",
                "different_bits": "The pattern is explicitly the same.",
                "both_invalid": "It is valid in both interpretations."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_bit_width_or_sign_assumption",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Use exactly 8 bits."
            ]
          },
          {
            "id": "alg-bits-review-003",
            "prompt": "A developer replaces signed integer division by 2 with arithmetic right shift for all values. Which counterexample exposes the assumption?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
