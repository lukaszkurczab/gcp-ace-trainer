            "feedback": {
              "reason": "A faster search phase does not remove output-sensitive lower bounds.",
              "details": "Binary search can still beat a full scan when k is small, but total time includes the emitted range.",
              "wrongOptionExplanationsByOptionId": {
                "pure_log": "Required output work cannot be skipped.",
