                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "one_xor_per_value": "O(n)"
                },
                "auxiliary_space": {
                  "single_accumulator": "O(1)"
