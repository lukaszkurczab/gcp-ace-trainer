        "items": [
          {
            "id": "alg-mg-distance-compare-squared-values",
            "prompt": "From O=(0,0), point A=(6,8) and point B=(9,5). Which exact comparison determines the nearer point without precision loss?",
            "constraints": [
              "Coordinates are exact integers.",
              "A sufficiently wide integer type is used for squares."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "compare_100_106",
                  "text": "Compare 6^2+8^2=100 with 9^2+5^2=106; A is nearer."
                },
                {
                  "id": "compare_square_roots",
                  "text": "Compute both square roots as double and compare them with == before deciding."
                },
                {
                  "id": "compare_manhattan",
                  "text": "Compare 14 with 14 and conclude the points are equally distant."
                },
                {
                  "id": "compare_slopes",
                  "text": "Compare slopes 8/6 and 5/9; the smaller slope is nearer."
                }
              ],
              "acceptedOptionIds": [
                "compare_100_106"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Square root is strictly increasing on nonnegative values, so squared distances preserve the exact ordering.",
              "details": "The Euclidean squared distances are 100 and 106. Comparing them avoids an unnecessary square root and remains exact under the stated integer-width contract. Manhattan distance and slope answer different geometric questions and can tie or reorder points. The transfer rule applies to nearest-neighbor scans and radius tests: compare squared radius to squared distance, while checking that the squared terms fit.",
              "wrongOptionExplanationsByOptionId": {
                "compare_square_roots": "Square roots introduce approximation and exact equality is unnecessary for ordering these integer quantities.",
                "compare_manhattan": "Manhattan distance is a different metric; its tie does not imply equal Euclidean distance.",
                "compare_slopes": "Slope describes direction, not distance from the origin."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "compare_geometric_quantities_without_unsafe_division",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "coordinate_transform",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-slope-cross-multiply-with-sign",
            "prompt": "Two nonvertical direction vectors are u=(3,2) and v=(-4,-1). To compare their rational slopes exactly, what must be done before cross multiplication?",
            "constraints": [
              "Slope is dy/dx.",
              "The comparison must account for denominator signs."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "normalize_denominator_signs",
                  "text": "Normalize each representation so dx>0, then compare uy*vx with vy*ux in a sufficiently wide exact type."
                },
                {
                  "id": "raw_cross_multiply",
                  "text": "Compare uy*vx with vy*ux without considering the signs of ux and vx."
                },
                {
                  "id": "double_slopes",
                  "text": "Compute both double slopes and compare with ==."
                },
                {
                  "id": "absolute_denominators",
                  "text": "Replace each dx by |dx| but leave dy unchanged, then compare."
                }
              ],
              "acceptedOptionIds": [
                "normalize_denominator_signs"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Cross multiplication preserves an inequality only after denominator signs are controlled; flipping a vector representation must flip both components.",
              "details": "A rational slope dy/dx has an ordering rule that reverses when multiplied by a negative denominator. Canonicalizing each direction so dx>0 makes the denominators positive and allows exact product comparison. For v=(-4,-1), the equivalent direction (4,1) has the same slope. Taking only |dx| changes the fraction, while raw products can reverse the inequality. Vertical directions require a separate category rather than this formula.",
              "wrongOptionExplanationsByOptionId": {
                "raw_cross_multiply": "Multiplying an inequality by a negative denominator reverses its direction, so uncontrolled signs can invert the result.",
                "double_slopes": "Floating division can collapse close rational slopes and exact equality is unnecessary.",
                "absolute_denominators": "Changing only the denominator changes the represented slope; both vector components must be negated together."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "compare_geometric_quantities_without_unsafe_division",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-slope-vertical-line-category",
            "prompt": "Direction vectors u=(0,5) and v=(0,-2) define vertical lines. Which predicate correctly determines whether the directions are parallel without dividing?",
            "constraints": [
              "Both vectors are nonzero.",
              "Opposite directions may still be parallel."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "cross_zero_parallel",
                  "text": "cross(u,v)=0, so the directions are parallel even though their orientations are opposite."
                },
                {
                  "id": "divide_y_by_x",
                  "text": "Compute 5/0 and -2/0 and compare the resulting slopes."
                },
                {
                  "id": "dot_positive",
                  "text": "They are parallel only if dot(u,v)>0."
                },
                {
                  "id": "same_components",
                  "text": "They are parallel only when both component pairs are equal."
                }
              ],
              "acceptedOptionIds": [
                "cross_zero_parallel"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A zero cross product tests linear dependence and handles vertical directions without a special infinite-slope value.",
              "details": "The determinant 0·(-2)-5·0 is zero, so one nonzero vector is a scalar multiple of the other. Their negative dot product shows opposite orientation, but parallelism does not require the same orientation. Division by zero is undefined, and component equality is too strong. The transfer boundary is that a zero vector must be excluded before interpreting cross=0 as a direction relation.",
              "wrongOptionExplanationsByOptionId": {
                "divide_y_by_x": "Both denominators are zero, so the finite slope representation is undefined.",
                "dot_positive": "A negative dot product means opposite orientation, not nonparallel lines.",
                "same_components": "Parallel vectors can differ by any nonzero scalar factor."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "compare_geometric_quantities_without_unsafe_division",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-slope-coincident-endpoints",
            "prompt": "A segment is represented by endpoints P and Q, but P=Q. A second segment has distinct endpoints. What is the correct status of the “slope of PQ” comparison?",
            "constraints": [
              "A segment of zero length does not define a line direction."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "undefined_direction",
                  "text": "PQ is a point with no direction; handle it as a degenerate case before any slope or parallelism comparison."
                },
                {
                  "id": "slope_zero",
                  "text": "Its slope is 0 because both coordinate differences are zero."
                },
                {
                  "id": "parallel_to_all",
                  "text": "It is parallel to every segment because every cross product with the zero vector is zero."
                },
                {
                  "id": "divide_zero_zero",
                  "text": "Evaluate 0/0 and use the resulting floating value as a slope category."
                }
              ],
              "acceptedOptionIds": [
                "undefined_direction"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A zero-length segment has no directional slope, and zero products cannot be interpreted as ordinary parallelism.",
              "details": "The vector Q-P is zero. Both its cross and dot product with any vector are zero, but those algebraic results are caused by missing direction rather than a meaningful angle. Assigning slope zero invents a horizontal line, while 0/0 is undefined. The correct transfer is to branch on endpoint equality before line-based predicates and then apply point-specific rules if the larger problem requires them.",
              "wrongOptionExplanationsByOptionId": {
                "slope_zero": "Zero coordinate differences do not define a horizontal direction; they define no direction.",
                "parallel_to_all": "The zero vector is linearly dependent in an algebraic sense but cannot serve as a geometric line direction.",
                "divide_zero_zero": "0/0 is undefined and cannot be used as a stable slope category."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "compare_geometric_quantities_without_unsafe_division",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-slope-collinearity-determinant",
            "prompt": "For exact integer points A, B, and C, which predicate tests collinearity without slope division?",
            "constraints": [
              "Arithmetic is performed in a sufficiently wide exact type."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "determinant_zero",
                  "text": "(Bx-Ax)*(Cy-Ay) - (By-Ay)*(Cx-Ax) == 0"
                },
                {
                  "id": "slope_equality",
                  "text": "(By-Ay)/(Bx-Ax) == (Cy-Ay)/(Cx-Ax) using integer division"
                },
                {
                  "id": "distance_sum_only",
                  "text": "distance(A,B)+distance(B,C)==distance(A,C) for every point ordering"
                },
                {
                  "id": "matching_y",
                  "text": "By==Cy because collinear points share a horizontal level."
                }
              ],
              "acceptedOptionIds": [
                "determinant_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The determinant is exactly zero precisely when the two relative vectors are linearly dependent.",
              "details": "Forming B-A and C-A removes the arbitrary origin. Their 2D cross product vanishes when one vector is a scalar multiple of the other, covering vertical and horizontal lines uniformly. Integer slope division truncates and may divide by zero. A distance-sum test additionally depends on B lying between A and C and introduces square roots or norms, so it is not a general collinearity predicate.",
              "wrongOptionExplanationsByOptionId": {
                "slope_equality": "Integer division loses remainders and vertical lines have zero denominators.",
                "distance_sum_only": "The equality is an ordering/betweenness condition, not a collinearity test for arbitrary B.",
                "matching_y": "That tests only one horizontal special case."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "compare_geometric_quantities_without_unsafe_division",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-slope-cross-product-width",
            "prompt": "Coordinates use the full signed 32-bit range. You compare two direction slopes by cross products of coordinate differences. Which type plan is required?",
            "constraints": [
              "The comparison must be exact.",
              "Differences may need more than signed 32-bit, and products may need more than signed 64-bit."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "wide_before_subtract",
                  "text": "Convert coordinates to a sufficiently wide exact type before subtraction, then form and compare products in that type."
                },
                {
                  "id": "int32_diff_int64_product",
                  "text": "Subtract in signed 32-bit and multiply the resulting differences in signed 64-bit."
                },
                {
                  "id": "double_division",
                  "text": "Convert each difference to double and divide to get slopes."
                },
                {
                  "id": "int64_wrap",
                  "text": "Use signed 64-bit wraparound because both sides wrap consistently."
                }
              ],
              "acceptedOptionIds": [
                "wide_before_subtract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Exact rational comparison requires every difference and product to remain the mathematical value before the final ordering is inspected.",
              "details": "Full-range signed 32-bit coordinates can differ by more than signed 32-bit and their products can exceed signed 64-bit. Widening after subtraction cannot repair an already-overflowed difference. Floating division introduces rounding and vertical cases, while wraparound need not affect both products in an order-preserving way. The transfer rule is to range-check the entire cross-multiplication expression, not just its inputs.",
              "wrongOptionExplanationsByOptionId": {
                "int32_diff_int64_product": "The first subtraction may overflow, and even a correct difference can produce a product beyond signed 64-bit.",
                "double_division": "Division loses exact rational ordering for close values and is undefined for vertical directions.",
                "int64_wrap": "Independent wraparound does not preserve the mathematical comparison or sign."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "compare_geometric_quantities_without_unsafe_division",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-slope-floating-near-collinearity",
            "prompt": "Points have floating coordinates from measurement. A determinant is 2.0e-12 while the products used to form it are around 1.0. Which classification rule is defensible?",
            "constraints": [
              "The measurement model permits a relative tolerance eps larger than 2.0e-12.",
              "The vectors are nonzero."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scaled_tolerance",
                  "text": "Classify approximately collinear when |det| is within an explicitly chosen scale-aware tolerance based on vector magnitudes."
                },
                {
                  "id": "exact_zero",
                  "text": "Classify collinear only when det == 0.0 exactly."
                },
                {
                  "id": "always_nonzero_turn",
                  "text": "Any nonzero floating determinant proves a real clockwise or counterclockwise turn."
                },
                {
                  "id": "round_coordinates",
                  "text": "Round every coordinate to an integer and use exact arithmetic regardless of the measurement resolution."
                }
              ],
              "acceptedOptionIds": [
                "scaled_tolerance"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With measured floating inputs, the decision boundary must reflect expected error and the scale of the vectors rather than exact zero.",
              "details": "Subtraction of nearly equal products can amplify relative error, so a tiny nonzero determinant may not be meaningful. A scale-aware threshold such as eps·|u|·|v| approximates an angular tolerance and remains consistent under uniform scaling. Exact comparison is appropriate for exact integer or rational inputs, not automatically for measured floats. Rounding coordinates changes the problem unless the measurement contract explicitly authorizes quantization.",
              "wrongOptionExplanationsByOptionId": {
                "exact_zero": "Floating representation and measurement error make exact zero too brittle for the stated data source.",
                "always_nonzero_turn": "A tiny computed sign can be dominated by input and arithmetic error.",
                "round_coordinates": "Unspecified rounding can change a legitimate near-boundary relation and has no stated error guarantee."
              }
            },
            "difficulty": "foundational-transfer",
            "taxonomy": {
              "primarySkillAtomId": "compare_geometric_quantities_without_unsafe_division",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "vector_orientation",
              "problemArchetypeId": "compare_geometric_orientation"
            }
          },
          {
            "id": "alg-mg-slope-polar-direction-ordering",
            "prompt": "Select all ingredients required to totally order nonzero exact integer vectors around the origin without computing floating angles.",
            "constraints": [
              "The order starts at the positive x-axis and proceeds counterclockwise.",
              "Opposite rays must be ordered half a turn apart.",
              "Distinct vectors on the same ray must have a deterministic tie rule.",
              "Products use a sufficiently wide exact type."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "half_plane_partition",
                  "text": "Partition vectors into an upper/starting half-plane and a lower half-plane with an explicit boundary rule."
                },
                {
                  "id": "cross_within_half",
                  "text": "Within the same half-plane, use the sign of the cross product to order distinct directions."
                },
                {
                  "id": "same_ray_tie_rule",
                  "text": "When the cross product is zero on the same ray, apply a declared tie rule such as squared length and then stable identity."
                },
                {
                  "id": "raw_slope",
                  "text": "Use dy/dx as the sole key for every vector."
                },
                {
                  "id": "negative_percent_angle",
                  "text": "Compute an integer angle code and rely on raw %360 even when it can be negative."
                }
              ],
              "acceptedOptionIds": [
                "half_plane_partition",
                "cross_within_half",
                "same_ray_tie_rule"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A half-plane key resolves the circular wrap, cross-product sign orders distinct directions locally, and an explicit tie rule completes the element order.",
              "details": "Cross product alone cannot define one total circular order across the -π/π cut, and cross=0 within one half leaves vectors on the same ray tied. A common classifier places y>0, plus the positive x-axis, before the remaining directions; within one half, cross(a,b)>0 establishes counterclockwise order. A declared length or stable-identity tie rule then orders duplicate directions. Raw slope fails vertically and merges opposite rays.",
              "wrongOptionExplanationsByOptionId": {
                "raw_slope": "Slope is undefined vertically and assigns the same value to opposite rays, which must be separated in a full circular order.",
                "negative_percent_angle": "Language remainder may be negative and an invented integer angle code is not an exact substitute for the vector predicates."
              },
              "omittedCorrectExplanationsByOptionId": {
                "half_plane_partition": "The partition chooses a deterministic side of the circular wrap and separates opposite rays.",
                "cross_within_half": "The exact determinant gives the local counterclockwise order once both vectors are in the same half-plane.",
                "same_ray_tie_rule": "A total order of vector instances still needs to distinguish collinear vectors pointing along the same ray."
              }
            },
