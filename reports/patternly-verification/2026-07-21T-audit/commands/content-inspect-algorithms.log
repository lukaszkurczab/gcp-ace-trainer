        "items": [
          {
            "id": "alg-arrays-output-space-001",
            "prompt": "A function returns a newly allocated reversed copy of an array of length n and otherwise uses only two indices. Select its time, auxiliary-space, and output-space complexity.",
            "constraints": [
              "The returned reversed array contains n values."
            ],
            "difficulty": "intro",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space",
                "output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(n)",
                  "O(n log n)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(n)"
                ],
                "output_space": [
                  "O(1)",
                  "O(n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ],
                "output_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "linear": "O(n)"
                },
                "auxiliary_space": {
                  "indices_only": "O(1)"
                },
                "output_space": {
                  "returned_copy": "O(n)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The algorithm reads n values, uses constant working state, and materializes an n-element result.",
              "details": "The returned copy is output space rather than auxiliary memory. The two indices remain O(1) auxiliary state."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_output_from_auxiliary_space",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-output-space-002",
            "prompt": "A function reverses an array in place using left, right, and one temporary value, then returns the same array reference. Select its time, auxiliary-space, and additional output-space complexity.",
            "constraints": [
              "The input contains n values.",
              "No new result array is allocated."
            ],
            "difficulty": "intro",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space",
                "additional_output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(n)",
                  "O(n²)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(n)"
                ],
                "additional_output_space": [
                  "O(1)",
                  "O(n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ],
                "additional_output_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "half_scan_linear": "O(n)"
                },
                "auxiliary_space": {
                  "constant": "O(1)"
                },
                "additional_output_space": {
                  "reuses_input": "O(1)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "In-place reversal performs a linear number of swaps and reuses the input storage.",
              "details": "The n-element input still exists, but it is not auxiliary memory. Only constant local state is added, and no growing output container is allocated."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_output_from_auxiliary_space",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "in_place_duplicate_collapse",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-output-space-003",
            "prompt": "A function must return every distinct value. It builds a set of distinct values and then copies those values into a separate result array. If there are d distinct values, how should the two structures be classified?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "set_aux_array_output",
                  "text": "The set is O(d) auxiliary space and the returned array is O(d) output space."
                },
                {
                  "id": "both_output",
                  "text": "Both structures are output space because they contain the same values."
                },
                {
                  "id": "both_auxiliary",
                  "text": "Both structures are auxiliary space because they are created during execution."
                },
                {
                  "id": "set_output_array_aux",
                  "text": "The set is output space and the returned array is auxiliary space."
                }
              ],
              "acceptedOptionIds": [
                "set_aux_array_output"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Classification follows each structure's role, not whether it contains similar data.",
              "details": "The set is temporary state used to construct the required result. The separate returned array is the output. Both scale with d, but they belong to different accounting categories.",
              "wrongOptionExplanationsByOptionId": {
                "both_output": "The temporary set is not returned or otherwise part of the required result.",
                "both_auxiliary": "The returned array is required output and should not be counted as temporary working memory.",
                "set_output_array_aux": "This reverses the actual roles of the two structures."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_output_from_auxiliary_space",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-output-space-004",
            "prompt": "A function builds a map of value frequencies and returns that same map as its required result. It uses no other growing structure. Which classification is most precise?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "map_is_output",
                  "text": "The map is O(d) output space; auxiliary space outside the returned map is O(1)."
                },
                {
                  "id": "map_is_auxiliary",
                  "text": "The map is O(d) auxiliary space and output space is O(1)."
                },
                {
                  "id": "map_counts_twice",
                  "text": "The map is both O(d) output space and O(d) auxiliary space."
                },
                {
                  "id": "all_constant",
                  "text": "Both output and auxiliary space are O(1) because each update is constant time."
                }
              ],
              "acceptedOptionIds": [
                "map_is_output"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A structure created during execution can still be output space when it is the required returned result.",
              "details": "The map stores one entry per distinct value and is returned directly. It therefore represents O(d) output storage. Constant-time updates do not imply constant memory.",
              "wrongOptionExplanationsByOptionId": {
                "map_is_auxiliary": "The map is not temporary; it is the required result.",
                "map_counts_twice": "One structure should not be counted in both categories merely because it was built incrementally.",
                "all_constant": "Per-operation time says nothing about the final number of stored entries."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_output_from_auxiliary_space",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-output-space-005",
            "prompt": "A function returns the prefix-sum array for an input of length n and writes each prefix sum directly into the returned array. It uses one running total. Which statement is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "output_n_aux_1",
                  "text": "O(n) output space and O(1) auxiliary space."
                },
                {
                  "id": "output_1_aux_n",
                  "text": "O(1) output space and O(n) auxiliary space."
                },
                {
                  "id": "both_n",
                  "text": "O(n) output space and O(n) auxiliary space because the result is built incrementally."
                },
                {
                  "id": "both_1",
                  "text": "O(1) output space and O(1) auxiliary space because only one pass is used."
                }
              ],
              "acceptedOptionIds": [
                "output_n_aux_1"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The returned prefix array is output, while the running total is constant working state.",
              "details": "The algorithm materializes n result values. Building the result one element at a time does not turn that required output into auxiliary space.",
              "wrongOptionExplanationsByOptionId": {
                "output_1_aux_n": "The n-element returned array is output, not auxiliary memory.",
                "both_n": "The output array should not also be charged as temporary state.",
                "both_1": "One pass does not make an n-element result constant-size."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_output_from_auxiliary_space",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-output-space-006",
            "prompt": "A function normalizes two inputs of lengths n and m into temporary buffers of retained lengths k and r, compares them, and returns one boolean. Select its time, auxiliary-space, and output-space complexity.",
            "constraints": [
              "Each input is normalized in one pass.",
              "The temporary buffers are discarded."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space",
                "output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(n + m)",
                  "O(nm)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(k + r)",
                  "O(nm)"
                ],
                "output_space": [
                  "O(1)",
                  "O(k + r)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n + m)"
                ],
                "auxiliary_space": [
                  "O(k + r)"
                ],
                "output_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "linear_in_inputs": "O(n + m)"
                },
                "auxiliary_space": {
                  "normalized_buffers": "O(k + r)"
                },
                "output_space": {
                  "boolean": "O(1)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The normalized copies are temporary working state, while the required result is only one boolean.",
              "details": "Both original inputs are scanned, the buffers occupy O(k + r) auxiliary space, and the constant-size boolean is output."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_output_from_auxiliary_space",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-output-space-007",
            "prompt": "Arrange the steps for analyzing the space usage of a sequence algorithm.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "identify_required_result",
                  "text": "Identify the exact required output and its size."
                },
                {
                  "id": "identify_input_storage",
                  "text": "Separate pre-existing input storage from memory allocated by the algorithm."
                },
                {
                  "id": "identify_temporary_state",
                  "text": "List temporary collections, recursion state, indices, and other working memory."
                },
                {
                  "id": "report_separate_bounds",
                  "text": "Report output space and auxiliary space separately."
                }
              ],
              "canonicalOrder": [
                "identify_required_result",
                "identify_input_storage",
                "identify_temporary_state",
                "report_separate_bounds"
              ],
