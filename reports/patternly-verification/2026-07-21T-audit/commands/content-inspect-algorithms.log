        "items": [
          {
            "id": "alg-backtracking-duplicates-001",
            "prompt": "Candidates are sorted, and a combination loop is choosing values at one recursion depth. Which rule skips value-equivalent sibling branches?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "skip_same_depth_duplicate",
