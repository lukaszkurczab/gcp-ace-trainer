          {
            "id": "alg-contrast-window-prefix-objective-015",
            "prompt": "Which mistaken claims collapse threshold and exact-sum objectives into one rule? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "exact_never_window",
                  "text": "Exact sum can never use a sliding window."
                },
                {
                  "id": "threshold_always_window",
                  "text": "Every threshold objective supports a simple window."
                },
                {
                  "id": "contiguous_decides",
                  "text": "Contiguity alone decides between the methods."
                },
                {
                  "id": "prefix_identity",
                  "text": "Exact subarray sum is a prefix difference."
                }
              ],
              "acceptedOptionIds": [
