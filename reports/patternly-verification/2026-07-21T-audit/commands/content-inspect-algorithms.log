        "items": [
          {
            "id": "alg-dpintro-base-01-empty-solution-count",
            "prompt": "dp(s) counts the number of move sequences whose total is exactly target, starting from current sum s. What should dp(target) equal?",
            "constraints": [
              "Reaching target completes one valid sequence.",
              "No additional moves are needed after completion."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "target",
                  "text": "target, because the base value should match the target sum."
                },
                {
                  "id": "one",
                  "text": "1, because the empty continuation completes the already valid sequence."
                },
                {
                  "id": "zero",
                  "text": "0, because there are zero moves left to make."
                }
              ],
              "acceptedOptionIds": [
                "one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "At an exactly completed state, the empty continuation is one valid way, so it supplies the multiplicative seed for counting.",
              "details": "A predecessor transition adds the number of completions from its successor. If dp(target) were zero, every valid path ending at target would contribute nothing and all counts would collapse to zero. Setting it to one represents the single choice to stop successfully. This is a semantic base case, independent of whether the recurrence is memoized or tabulated.",
              "wrongOptionExplanationsByOptionId": {
                "zero": "The state counts valid continuations, not remaining actions. The empty continuation is one valid way to finish.",
                "target": "The numeric target is not a count of continuations; the base must follow the state meaning."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_dp_base_cases",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-base-02-complete-versus-invalid",
            "prompt": "A recursion count(i, remaining) counts subsets of items i onward whose weights sum exactly to remaining. Which base rules are correct?",
            "constraints": [
              "Items may be used at most once.",
              "A remaining value below zero is invalid."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "exact_rules",
                  "text": "If remaining == 0, return 1; if i == n while remaining > 0, return 0; if remaining < 0, return 0."
                },
                {
                  "id": "index_only_success",
                  "text": "If remaining == 0, return 1; if i == n, return 1 for every remaining value; if remaining < 0, return 0."
                },
                {
                  "id": "zero_remaining_failure",
                  "text": "If remaining == 0, return 0; if i == n while remaining > 0, return 0; if remaining < 0, return 0."
                }
              ],
              "acceptedOptionIds": [
                "exact_rules"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Successful completion, exhausted choices, and invalid overshoot are distinct terminal states with different counts.",
              "details": "remaining == 0 means the target has been met, so the empty choice over the rest is one valid completion. Reaching i == n with a positive remainder cannot complete the target, and a negative remainder is already invalid. The index alone cannot determine the base result because the resource component changes whether the terminal state is successful.",
              "wrongOptionExplanationsByOptionId": {
                "index_only_success": "Exhausting items succeeds only when the target is also satisfied; positive remaining means the construction is incomplete.",
                "zero_remaining_failure": "Zero remaining is the exact target condition and represents one completed subset, regardless of unused items."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_dp_base_cases",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "memoization",
              "problemArchetypeId": "choose_or_skip"
            }
          },
          {
            "id": "alg-dpintro-base-03-same-bases-both-directions",
            "prompt": "A suffix recurrence has top-down base solve(n) = 0 because no cost remains after the last element. What is the corresponding bottom-up initialization?",
            "constraints": [
              "dp(i) stores the same suffix cost as solve(i).",
              "The table has entries 0 through n."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "dp_zero_zero",
                  "text": "Set dp[0] = 0 because bottom-up always starts at index 0."
                },
                {
                  "id": "omit_base",
                  "text": "Do not initialize any base because the loop will infer it."
                },
                {
                  "id": "dp_n_zero",
                  "text": "Set dp[n] = 0 before filling earlier states."
                }
              ],
              "acceptedOptionIds": [
                "dp_n_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The empty suffix is state n in both implementations, so its value remains zero even though evaluation direction changes.",
              "details": "Top-down reaches n through recursive calls; bottom-up stores the same state explicitly and starts from it. Moving the seed to index 0 would change what the value represents. Memoization and tabulation can differ in overhead and reachable states, but they must agree on every state value, including bases.",
              "wrongOptionExplanationsByOptionId": {
                "dp_zero_zero": "The base location follows the state meaning. dp[0] represents the full suffix, not the empty suffix.",
                "omit_base": "The first computed state reads the terminal value; without a defined seed it consumes an undefined or default value."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_dp_base_cases",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "optimize_prefix_or_suffix"
            }
          },
          {
            "id": "alg-dpintro-base-04-initialize-before-consumer",
            "prompt": "Order the bottom-up setup for a suffix recurrence whose states depend on larger indices.",
            "constraints": [
              "dp[n] is the terminal base.",
              "For i < n, dp[i] reads dp[i + 1] and possibly dp[i + 2]."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "allocate",
                  "text": "Allocate entries including every terminal index the recurrence may read."
                },
                {
                  "id": "initialize",
                  "text": "Write the terminal base values."
                },
                {
                  "id": "iterate",
                  "text": "Process nonterminal indices in dependency-safe order."
                },
                {
                  "id": "read_answer",
                  "text": "Read the state representing the original problem."
                }
              ],
              "canonicalOrder": [
                "allocate",
                "initialize",
                "iterate",
                "read_answer"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The transition cannot safely consume a terminal state until that state exists and has its semantic base value.",
              "details": "Allocation alone does not establish the mathematical meaning of a default cell. Terminal entries must be explicitly initialized before earlier suffix states read them. The loop then follows the dependency direction, and only after all required states are valid should the original-problem state be returned. Swapping initialization and iteration can silently propagate a language default through the table."
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_dp_base_cases",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "optimize_prefix_or_suffix"
            }
          },
          {
            "id": "alg-dpintro-base-05-compressed-seed-preservation",
            "prompt": "A recurrence uses dp[i] = dp[i - 1] + dp[i - 2] with dp[0] = 1 and dp[1] = 1. Which compressed initialization is correct before computing i = 2?",
            "constraints": [
              "prev2 represents dp[i - 2].",
              "prev1 represents dp[i - 1]."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_zero",
                  "text": "prev2 = 1 and prev1 = 0 because dp[1] has not been iterated yet."
                },
                {
                  "id": "both_one",
                  "text": "prev2 = 1 and prev1 = 1."
                },
                {
                  "id": "zero_one",
                  "text": "prev2 = 0 and prev1 = 1 because index 0 means no work."
                }
              ],
              "acceptedOptionIds": [
                "both_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The two live variables must start with the exact values of dp[0] and dp[1].",
              "details": "Compression changes storage, not base semantics. At i = 2, the recurrence expects the values of both terminally initialized predecessors. A default zero for either variable produces a different sequence even though the update formula is unchanged. The same rule applies to rolling rows: every boundary cell required by the first interior update must already represent its logical DP state.",
              "wrongOptionExplanationsByOptionId": {
                "zero_one": "dp[0] is one valid empty construction under the stated recurrence, so replacing it with zero changes every later value.",
                "one_zero": "dp[1] is an explicit base, not a state waiting for the general loop; it must be seeded before i = 2 reads it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_dp_base_cases",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "state_compression",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-base-06-empty-input-boundary",
            "prompt": "dp(i) is the minimum deletion cost for suffix s[i:], with dp(n) = 0. What should an implementation return when s is empty?",
            "constraints": [
              "For an empty string, n = 0.",
              "No deletion is required."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero",
                  "text": "Return dp[0] = dp[n] = 0."
                },
                {
                  "id": "error",
                  "text": "Reject the input because the transition needs at least one character."
                },
                {
                  "id": "one",
                  "text": "Return 1 to count the empty suffix as one deletion."
                }
              ],
              "acceptedOptionIds": [
                "zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With n = 0, the requested state is exactly the terminal empty-suffix state whose cost is zero.",
              "details": "The state meaning determines both the base value and whether the general loop is entered. Empty input is not an exceptional unknown case; it is the terminal suffix by definition. Confusing counting and cost bases can produce a plausible but wrong one. Always test the original input against terminal-state conditions before assuming at least one transition will run.",
              "wrongOptionExplanationsByOptionId": {
                "error": "The original state is already the defined terminal state; no transition is necessary.",
                "one": "The state is a cost, not a count of constructions. The empty suffix incurs zero deletion cost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_dp_base_cases",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "one_dimensional_dp",
              "problemArchetypeId": "optimize_prefix_or_suffix"
            }
          },
          {
            "id": "alg-dpintro-base-07-blocked-grid-origin",
            "prompt": "A grid path counter normally sets dp[0][0] = 1. The start cell is blocked. What initialization is correct?",
            "constraints": [
              "A path may visit only unblocked cells.",
              "The answer counts paths from the start to the destination."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_origin",
                  "text": "Keep dp[0][0] = 1 because every grid has one empty path at its origin."
                },
                {
                  "id": "skip_origin",
                  "text": "Leave dp[0][0] uninitialized and start at its neighbors."
                },
                {
                  "id": "zero_origin",
                  "text": "Set dp[0][0] = 0, so no path can propagate from an illegal start."
                }
              ],
              "acceptedOptionIds": [
                "zero_origin"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The origin seed represents one valid way to occupy the start, which does not exist when the start is blocked.",
              "details": "Initialization encodes feasibility as well as recurrence identity. In an open grid, one path of length zero starts at the origin and seeds later counts. A blocked origin is not a legal state, so its count is zero and every reachable count remains zero. The same boundary check applies to blocked destinations or other base states that are valid only under stated constraints.",
              "wrongOptionExplanationsByOptionId": {
                "one_origin": "The empty path is not valid when the starting state itself violates the cell constraint.",
                "skip_origin": "Neighbors must receive path counts from valid predecessors; an undefined origin risks propagating a default inconsistent with the blocked condition."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_dp_base_cases",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "grid_path_dp"
            }
          }
        ],
