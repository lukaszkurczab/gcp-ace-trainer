          {
            "id": "alg-sort-two-pointers-08-transfer-monotone-pair-rule",
            "prompt": "Select all pair objectives that support a direct opposite-end pointer rule after ascending numeric sort under the stated constraints.",
            "constraints": [
              "For product objectives, values may include negative, zero, and positive integers.",
              "The pointer rule must be justified without an additional data structure or case partition."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "mixed_sign_product",
                  "text": "Determine whether some pair product equals P with unrestricted signs using one uniform endpoint rule."
                },
                {
                  "id": "sum_equals_target",
                  "text": "Determine whether some pair sum equals T."
                },
                {
                  "id": "count_sum_at_most",
                  "text": "Count pairs whose sum is at most T using ordered boundary counts."
                },
                {
                  "id": "xor_equals_target",
                  "text": "Determine whether some pair has bitwise XOR equal to T."
                }
              ],
              "acceptedOptionIds": [
                "sum_equals_target",
                "count_sum_at_most"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorted addition changes monotonically with either endpoint, while XOR and unrestricted-sign multiplication do not support one uniform elimination rule.",
              "details": "For sums, increasing left cannot decrease the sum and decreasing right cannot increase it. That supports exact search and batched counting of all partners under a threshold. XOR changes discontinuously with bit patterns. Products over mixed signs have different monotonic regions and need sign partitioning or another method before a pointer proof can be made. The transfer signal is monotone endpoint influence, not simply a two-value expression.",
              "wrongOptionExplanationsByOptionId": {
                "xor_equals_target": "Numeric order does not make XOR monotone, so moving an endpoint based on the current XOR can discard valid pairs unpredictably.",
                "mixed_sign_product": "Negative and positive regions reverse product behaviour; one unpartitioned endpoint rule is not complete."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sum_equals_target": "Sorted endpoint sums provide the classic one-boundary-at-a-time elimination proof.",
                "count_sum_at_most": "When an endpoint pair is small enough, sorted order identifies an entire block of qualifying partners."
              }
            },
