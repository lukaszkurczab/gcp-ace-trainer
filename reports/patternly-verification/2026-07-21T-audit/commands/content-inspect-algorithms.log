          {
            "id": "alg-hms-review-count-payload-for-groups",
            "prompt": "A grouping implementation maps each signature to a count, but the API must return the grouped original strings. What is the primary repair?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "count_to_bucket",
                  "text": "Replace or augment the count payload with a bucket of original strings."
                },
                {
                  "id": "count_to_set",
                  "text": "Replace the map with a set of signatures."
                },
                {
                  "id": "bigger_count",
                  "text": "Use a larger integer type for the count."
                }
              ],
              "acceptedOptionIds": [
                "count_to_bucket"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The key is suitable, but the payload answers “how many” instead of “which members.”",
              "details": "Diagnosis should separate key correctness from payload sufficiency. A signature-to-count map is valid for a histogram and invalid for materialized grouping. Appending original strings to a bucket preserves the information required by the API; counts can be derived later from bucket length if needed.",
              "wrongOptionExplanationsByOptionId": {
                "count_to_set": "A set retains even less information and still cannot reconstruct any group members.",
                "bigger_count": "Numeric range is unrelated to the missing record identities."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_hash_state_mismatch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grouping_map",
              "problemArchetypeId": "group_or_count_values"
