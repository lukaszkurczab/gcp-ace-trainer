              "availableValuesByDimension": {
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "auxiliary_space": {
                  "fixed_scalars": "O(1)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "A fixed number of fixed-size scalars does not grow with n.",
              "details": "Input size affects iteration count, not working storage."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-017",
            "prompt": "A recursive function has depth n and stores an O(1) record in each active frame. Select auxiliary-space complexity.",
            "constraints": [
              "No other growing structure is used."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "auxiliary_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "auxiliary_space": {
                  "linear_depth": "O(n)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "n constant-size frames coexist at maximum depth.",
              "details": "Total stack space is linear."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-018",
            "prompt": "A divide-and-conquer recursion has depth O(log n), and every active frame stores O(1) local state. Select stack-space complexity.",
            "constraints": [
              "Child calls are processed depth-first rather than retained simultaneously as full subtrees."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "stack_space"
              ],
              "availableValuesByDimension": {
                "stack_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "stack_space": [
                  "O(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "stack_space": {
                  "recursion_depth": "O(log n)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Only one root-to-leaf chain is active in depth-first recursion.",
              "details": "Constant frame size times logarithmic depth gives logarithmic stack space."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-019",
            "prompt": "A function builds an n by n boolean table and returns one scalar result. Select auxiliary-space and output-space complexity.",
            "constraints": [
              "The table is discarded before return."
