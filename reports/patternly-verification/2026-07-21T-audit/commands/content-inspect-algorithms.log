                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "recursion_depth": [
                  "O(log n)"
                ],
                "stack_space": [
                  "O(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "recursion_depth": {
                  "halving": "O(log n)"
                },
                "stack_space": {
                  "frames": "O(log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Logarithmic convergence creates logarithmic recursive depth.",
              "details": "An iterative version can retain the same boundary invariant with constant auxiliary space."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_binary_search_boundary_contract",
              "secondarySkillAtomIds": [],
