        "items": [
          {
            "id": "alg-ctpsw-transfer-01",
            "prompt": "Two sorted arrays A and B must yield one value from each whose sum is closest to T. A pointer starts at the beginning of A and another at the end of B; one moves after each comparison. Which family best matches the invariant?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Two pointers across sorted frontiers."
                },
                {
                  "id": "sliding_window",
                  "text": "Sliding window over the combined arrays."
                },
                {
                  "id": "indices_only",
                  "text": "Two pointers only because there are two indices."
                },
                {
                  "id": "neither",
                  "text": "Neither, because the pointers are in different arrays."
                }
              ],
              "acceptedOptionIds": [
                "two_pointers"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The candidate is a cross-array pair and sorted comparison safely moves one frontier.",
              "details": "The pointers do not bound one contiguous candidate. They select one value from each sorted array, and the sum comparison orders the remaining cross-array pairs. When the current sum is below T, moving B toward a smaller value can only move farther below T, so the current A frontier can be advanced; when the sum is above T, increasing A cannot help, so the B frontier moves downward. Recording the best distance before each elimination preserves the closest pair seen on this monotone frontier. This is a transfer of the pair-elimination invariant to two sequences. A window would require a contiguous range with shared membership state, which the cross-array pair does not have. If either array were unsorted, this elimination proof would disappear; that would invalidate this optimization without creating a sliding-window problem.",
              "wrongOptionExplanationsByOptionId": {
                "sliding_window": "There is no single contiguous interval whose enclosed members share aggregate or membership state; the candidate consists of one frontier value from each array.",
                "indices_only": "The classification is supported by the cross-array pair relation and ordered elimination, not index count.",
                "neither": "Two-pointers invariants can coordinate ordered frontiers in different sequences when each comparison safely removes a family of cross-sequence pairs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_two_pointers_vs_window_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Both arrays are sorted in nondecreasing order.",
              "Exactly one value must be selected from each array."
            ]
          },
          {
            "id": "alg-ctpsw-transfer-02",
            "prompt": "Find the longest contiguous substring in which every character count is at most M. The algorithm maintains counts for the current substring and removes left characters after a violation. Which family applies?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Use a two-pointers invariant."
                },
                {
                  "id": "sliding_window",
                  "text": "Use a sliding-window validity invariant."
                },
                {
                  "id": "indices_only",
                  "text": "Classify it as two pointers solely because two indices appear."
                }
              ],
              "acceptedOptionIds": [
                "sliding_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The complete substring is the candidate and its frequency validity is maintained incrementally.",
              "details": "Every character between left and right contributes to the count constraint, so the frequency table is state owned by the complete current substring. Expanding right updates that state. If a count exceeds M, any candidate with the same right endpoint and an even earlier start still contains the violating multiset, so those earlier starts cannot be valid; removing left characters repairs the same candidate until all counts are legal again. For each right endpoint, the earliest remaining valid start gives the longest valid substring ending there. This is the sliding-window model regardless of whether the data are characters or numbers. The transfer rule operates on contiguous membership, incremental state, and a legal repair predicate—not on problem vocabulary or the mere presence of two indices. A noncontiguous selection contract would cross the boundary and require different reasoning.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers": "Endpoint characters alone cannot determine whether every frequency is within M; the complete substring membership state controls validity.",
                "indices_only": "The same two indices could implement other invariants; the maintained frequency state is decisive."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_two_pointers_vs_window_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The answer must be contiguous.",
              "M is a fixed positive integer."
            ]
          },
          {
            "id": "alg-ctpsw-transfer-03",
            "prompt": "Remove rejected records from an array in place while preserving accepted-record order. read scans every record; write marks where the next accepted record is copied. Which family matches this reasoning?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Same-direction two pointers with read/write roles."
                },
                {
                  "id": "sliding_window",
                  "text": "Sliding window over records between read and write."
                },
                {
                  "id": "neither_same_direction",
                  "text": "Neither, because two pointers must move toward each other."
                },
                {
                  "id": "window_if_linear",
                  "text": "Sliding window because the scan is linear."
                }
              ],
              "acceptedOptionIds": [
                "two_pointers"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The invariant relates an exploration pointer to a compacted-output boundary.",
              "details": "The invariant has two roles rather than one enclosed candidate: read identifies the next input record to inspect, while the prefix before write is exactly the accepted records seen so far, in their original order. When read sees an accepted record, copying it to write and advancing write extends that proven output prefix; rejecting a record advances only read. The interval between the indices is neither scored nor maintained as a valid range, and no outgoing element is removed from aggregate state. This is same-direction two-pointers compaction, showing why opposite-end movement is not required. The transfer boundary would change only if all elements between two boundaries collectively determined a contiguous candidate condition—for example, a budget or frequency predicate that must be repaired as members enter and leave.",
              "wrongOptionExplanationsByOptionId": {
                "sliding_window": "The read/write gap is not one candidate with aggregate or membership validity.",
                "neither_same_direction": "Same-direction read/write is a standard two-pointers invariant: read explores input while write marks the proven compacted-output frontier.",
                "window_if_linear": "Linear complexity is shared by many scans; without state representing all elements between the boundaries, there is no sliding-window candidate."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_two_pointers_vs_window_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Accepted records must remain in their original relative order.",
              "No extra output array is used."
            ]
          },
          {
            "id": "alg-ctpsw-transfer-04",
            "prompt": "A sensor stream requires the average of every consecutive block of 60 samples. The algorithm updates one sum by adding the new sample and removing the sample 60 positions old. Which family applies?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sliding_window",
                  "text": "A fixed-size sliding window."
                },
                {
                  "id": "two_pointers",
                  "text": "Two pointers because the leaving and entering positions are two indices."
                },
                {
                  "id": "neither_fixed",
                  "text": "Neither because the width never changes."
                },
                {
                  "id": "pair_relation",
                  "text": "A pair relation between the entering and leaving samples."
                }
              ],
              "acceptedOptionIds": [
                "sliding_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The sum represents one moving contiguous block, even though its width is fixed.",
              "details": "Each output is defined by all 60 samples in one consecutive block. The running sum is therefore state owned by the complete block, not merely by its endpoints. After the first block is initialized, shifting one position preserves the invariant by subtracting the unique outgoing sample and adding the unique incoming sample; dividing the updated sum by 60 yields the next average. The width is fixed, but the candidate still slides and reuses state, so this is a fixed-size sliding window. The entering and leaving positions participate in state updates, yet they are not the selected answer values and do not form an isolated pair relation. The boundary would change if the task asked only about a relation between two selected samples and ignored the 58 interior members.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers": "The two positions update state for all 60 members; they are not an isolated endpoint pair.",
                "neither_fixed": "Sliding windows may be fixed-size; the defining property is reuse of state for successive contiguous blocks, not a changing width.",
                "pair_relation": "The output depends on the sum of all 60 samples, while the entering and leaving samples merely update that full-block state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_two_pointers_vs_window_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Every output block contains exactly 60 consecutive samples.",
              "At least 60 samples are available whenever an average is requested."
            ]
          },
          {
            "id": "alg-ctpsw-transfer-05",
            "prompt": "Two sorted lists must yield one value from each with minimum absolute difference. At each step, advance the pointer at the smaller current value. What invariant family is being transferred?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Two pointers over ordered list frontiers."
                },
                {
                  "id": "sliding_window",
                  "text": "A window whose width is the numerical difference."
                },
                {
                  "id": "both",
                  "text": "Both, because the current values define a width."
                },
                {
                  "id": "neither",
                  "text": "Neither, because there is no target sum."
                }
              ],
              "acceptedOptionIds": [
                "two_pointers"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The numerical gap is a relation between a selected pair, not the width of a contiguous candidate.",
              "details": "If A[i] is smaller than B[j], keeping A[i] while moving j forward cannot reduce the gap because B[j] will not decrease; advancing i is the only frontier move that can improve that pair relation. The reasoning operates over cross-list pairs and ordered elimination. Calling the difference a “window width” would confuse a numeric quantity with contiguous membership. A target sum is unnecessary; many two-pointers proofs rely on other monotone pair relations.",
              "wrongOptionExplanationsByOptionId": {
                "sliding_window": "No contiguous range or entering/leaving membership state exists; the algorithm compares one selected value from each ordered frontier.",
                "both": "A numeric difference is not a semantic window unless it describes all members of a contiguous candidate.",
                "neither": "Two-pointers reasoning extends beyond target-sum tasks when ordered frontier elimination is valid."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_two_pointers_vs_window_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "advanced",
            "constraints": [
              "Both lists are sorted in nondecreasing order.",
              "One value must be chosen from each list."
            ]
          },
          {
            "id": "alg-ctpsw-transfer-06",
            "prompt": "A timeline of nonnegative event costs asks for the longest consecutive interval with total cost at most B. right appends events, and left removes oldest events after an over-budget state. Which family and boundary apply?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "window_nonnegative",
                  "text": "Sliding window; the whole interval owns the sum, and nonnegative costs justify shrink."
                },
                {
                  "id": "pair_budget",
                  "text": "Two pointers; only the oldest and newest event matter."
                },
                {
                  "id": "indices_only",
                  "text": "Two pointers solely because left and right move."
                },
                {
                  "id": "window_any_sign",
                  "text": "Sliding window with the same proof even if arbitrary negative costs are later allowed."
                }
              ],
              "acceptedOptionIds": [
                "window_nonnegative"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Contiguous range state identifies the window, and nonnegative contributions make its repair rule legal.",
              "details": "The budget is the sum of every event in the current interval, so state belongs to the entire range. Adding the newest cost can violate the limit; removing nonnegative oldest costs cannot increase the total, so shrink repairs validity. The final option exposes the transfer boundary: if arbitrary negative costs are introduced, the range remains contiguous but the same one-pass shrink proof no longer follows. Classification and legality must both be checked.",
              "wrongOptionExplanationsByOptionId": {
                "pair_budget": "Interior costs are material to the budget, so endpoint-only state is insufficient.",
                "indices_only": "The maintained sum and monotone repair—not index count—justify the classification.",
                "window_any_sign": "Negative outgoing costs can increase the remaining total and invalidate the existing shrink proof."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_two_pointers_vs_window_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "advanced",
            "constraints": [
              "All current event costs are nonnegative.",
              "The answer must be a consecutive interval."
            ]
          },
          {
            "id": "alg-ctpsw-transfer-07",
            "prompt": "A baseline task selects two sorted values whose sum meets a target. Select all revisions that, by themselves, create a sliding-window decision boundary.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "contiguous_budget",
                  "text": "Revise the output to the longest contiguous segment whose full sum is within a budget, with nonnegative values."
                },
                {
                  "id": "contiguous_frequency",
                  "text": "Revise the output to the longest contiguous segment in which no value appears more than M times, maintained with per-value frequencies."
                },
                {
                  "id": "rename_indices",
                  "text": "Keep the pair task but rename the indices start and end."
                },
                {
                  "id": "remove_sortedness_only",
                  "text": "Keep selecting any two values, but remove the sorted-input guarantee without adding a contiguous-range contract."
                }
              ],
              "acceptedOptionIds": [
                "contiguous_budget",
                "contiguous_frequency"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Both accepted revisions replace an isolated pair with a maintained contiguous candidate; the other changes do not.",
              "details": "A nonnegative budget segment and a frequency-constrained segment each make every interior member part of validity and provide state that can be updated as a boundary enters or leaves. Those are genuine window candidates. Renaming variables changes nothing. Removing sortedness may invalidate the original two-pointers optimization, but it does not automatically create a window because the output is still an arbitrary pair. The correct transfer analysis therefore separates “the old strategy no longer works” from “sliding window now applies.”",
              "wrongOptionExplanationsByOptionId": {
                "rename_indices": "Identifier names do not alter candidate membership, maintained state, or the proof that makes a boundary movement safe.",
                "remove_sortedness_only": "Loss of sortedness removes one pair-elimination proof but does not make the pair contiguous or introduce range state."
              },
              "omittedCorrectExplanationsByOptionId": {
                "contiguous_budget": "Omitting this misses the shift to a full-range sum with a legal nonnegative shrink rule.",
                "contiguous_frequency": "Omitting this misses the shift to range-owned frequency state and validity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_two_pointers_vs_window_decision",
              "secondarySkillAtomIds": [],
