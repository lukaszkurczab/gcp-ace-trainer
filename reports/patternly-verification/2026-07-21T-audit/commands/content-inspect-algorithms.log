          {
            "id": "alg-bits-xor-015",
            "prompt": "Which statements about per-bit parity are correct? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "odd_one",
                  "text": "An odd number of one bits at a position produces one in the XOR result."
                },
                {
                  "id": "even_zero",
                  "text": "An even number of one bits at a position produces zero."
                },
                {
                  "id": "positions_independent",
                  "text": "Each bit position is combined independently."
                },
                {
                  "id": "exact_count",
                  "text": "The result reveals the exact number of ones at each position."
                }
              ],
              "acceptedOptionIds": [
                "odd_one",
                "even_zero",
                "positions_independent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "XOR is independent parity addition modulo two at every position.",
              "details": "The lack of carries explains both its cancellation property and its information loss.",
              "wrongOptionExplanationsByOptionId": {
                "exact_count": "Only parity is preserved."
              },
              "omittedCorrectExplanationsByOptionId": {
                "odd_one": "Each one toggles the result.",
                "even_zero": "Toggles cancel in pairs.",
                "positions_independent": "There are no carries between positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-016",
            "prompt": "Arrange the algorithm for finding one odd-frequency value when every other value has even frequency.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "initialize_zero",
                  "text": "Initialize accumulator to zero."
                },
                {
                  "id": "xor_each",
                  "text": "XOR every input value into the accumulator."
                },
                {
                  "id": "use_cancellation",
                  "text": "Use associativity and self-cancellation to eliminate even-frequency values."
                },
                {
                  "id": "return_accumulator",
                  "text": "Return the remaining accumulator."
                }
              ],
              "canonicalOrder": [
                "initialize_zero",
                "xor_each",
                "use_cancellation",
                "return_accumulator"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The implementation is a linear reduction, while the proof conceptually regroups equal values.",
              "details": "Input order does not affect the final accumulator."
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          },
          {
            "id": "alg-bits-xor-017",
            "prompt": "A fixed-width array of n values is reduced with XOR to find one odd-frequency value. Select time and auxiliary-space complexity.",
            "constraints": [
              "Each XOR operates on one fixed machine word.",
              "Only one accumulator is stored."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
