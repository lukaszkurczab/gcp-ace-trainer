          {
            "id": "alg-mg-normalize-shortest-signed-delta",
            "prompt": "Current heading is 170 degrees and target heading is -170 degrees. Using the canonical signed-turn interval [-180,180), what is the shortest target-current delta?",
            "constraints": [
