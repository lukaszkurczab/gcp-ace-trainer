            }
          },
          {
            "id": "algorithms-intervals-boundary-review-010",
            "prompt": "A half-open overlap test suite contains only pairs with positive gaps or positive-width intersections. Which additional case most directly detects an accidental '<=' comparator?",
            "constraints": [
              "Choose the smallest discriminating counterexample."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "touching_case",
                  "text": "[1, 3) with [3, 5)"
