      {
        "id": "alg-contrast-binary-scan-transfer-008",
        "prompt": "A scan returns all k matching records. The requirement changes to return only whether any match exists, and records are available in a sorted query-aligned array. Which change becomes possible?",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "binary_existence",
              "text": "Use exact binary search for existence, removing the Ω(k) output requirement."
            },
            {
              "id": "still_output_all",
              "text": "Continue materializing all k records because the old implementation did."
            },
            {
              "id": "binary_all_k_free",
              "text": "Use binary search and claim all k outputs cost O(log n)."
            },
            {
              "id": "scan_only",
              "text": "Existence can never use binary search."
            }
          ],
          "acceptedOptionIds": [
            "binary_existence"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "Output-contract changes can alter both legality and lower bounds.",
          "details": "Binary search becomes more attractive when the result shrinks from all matches to one boolean.",
          "wrongOptionExplanationsByOptionId": {
            "still_output_all": "The new output contract is smaller.",
            "binary_all_k_free": "If all results were still required, output work would remain.",
            "scan_only": "The aligned sorted representation supports it."
