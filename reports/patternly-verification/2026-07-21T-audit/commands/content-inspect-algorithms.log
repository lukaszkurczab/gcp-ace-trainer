      {
        "id": "alg-complexity-scaling-013",
        "prompt": "Which caveats belong in an operation-budget estimate? Select all that apply.",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "multiple",
          "options": [
            {
