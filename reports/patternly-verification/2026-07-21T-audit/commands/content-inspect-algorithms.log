            {
              "id": "restate_objective",
              "text": "Determine whether the target is exact, threshold, count, shortest, or longest."
            },
            {
              "id": "select_prefix_structure",
              "text": "Choose prefix hash, monotonic deque, or another correct structure for that objective."
