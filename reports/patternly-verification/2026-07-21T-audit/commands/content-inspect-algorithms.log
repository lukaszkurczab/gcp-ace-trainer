          {
            "id": "alg-contrast-window-prefix-queries-021",
            "prompt": "The source array is replaced u times. For each version, a prefix array is rebuilt, and q scalar range queries are answered in total. Select total time and peak prefix space.",
            "constraints": [
              "Each complete rebuild costs O(n).",
              "Each query costs O(1).",
              "Only one version's prefix array is live at a time."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
