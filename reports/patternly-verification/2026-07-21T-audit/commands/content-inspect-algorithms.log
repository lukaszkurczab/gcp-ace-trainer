        "items": [
          {
            "id": "alg-binary-search-rotated-001",
            "prompt": "In a rotated ascending array with distinct values, which condition shows that the left half [left, mid] is ordered?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "left_le_mid",
                  "text": "nums[left] <= nums[mid]."
                },
                {
                  "id": "mid_le_right",
                  "text": "nums[mid] <= nums[right]."
                },
                {
                  "id": "target_le_mid",
                  "text": "target <= nums[mid]."
                },
                {
                  "id": "left_le_right",
                  "text": "nums[left] <= nums[right]."
                }
              ],
              "acceptedOptionIds": [
                "left_le_mid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With distinct values, if the left endpoint is no greater than mid, no rotation pivot lies inside [left, mid].",
              "details": "That ordered half can then be tested for target membership.",
              "wrongOptionExplanationsByOptionId": {
                "mid_le_right": "That identifies the right half as ordered.",
                "target_le_mid": "Target comparison does not determine whether the half itself is ordered.",
                "left_le_right": "This may show the whole interval is ordered, but it is not the standard left-half test in the rotated branch."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-002",
            "prompt": "If nums[left] > nums[mid] in a rotated array with distinct values, what can be concluded?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "right_ordered",
                  "text": "The right half [mid, right] is ordered."
                },
                {
                  "id": "left_ordered",
                  "text": "The left half is ordered."
                },
                {
                  "id": "target_absent",
                  "text": "The target is absent."
                },
                {
                  "id": "array_unsorted",
                  "text": "No binary-search structure remains."
                }
              ],
              "acceptedOptionIds": [
                "right_ordered"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With one rotation and distinct values, the pivot must lie in the left portion when nums[left] > nums[mid].",
              "details": "The segment from mid through right therefore remains ascending.",
              "wrongOptionExplanationsByOptionId": {
                "left_ordered": "The pivot lies inside the left side.",
                "target_absent": "The comparison reveals structure, not target existence.",
                "array_unsorted": "Rotation preserves one ordered half."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-003",
            "prompt": "The left half is ordered and satisfies nums[left] <= target < nums[mid]. Which side should be retained after nums[mid] is known not to equal target?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "left_side",
                  "text": "The left side ending at mid - 1."
                },
                {
                  "id": "right_side",
                  "text": "The right side starting at mid + 1."
                },
                {
                  "id": "both_sides",
                  "text": "Both halves must remain."
                },
                {
                  "id": "return_mid",
                  "text": "Return mid."
                }
              ],
              "acceptedOptionIds": [
                "left_side"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The ordered left half contains every value between its endpoint values exactly once under the distinct-value contract.",
              "details": "The target's range membership proves the right half cannot contain the desired occurrence.",
              "wrongOptionExplanationsByOptionId": {
                "right_side": "The target lies inside the value range of the ordered left half.",
                "both_sides": "The ordered-range test provides a legal discard rule.",
                "return_mid": "Mid is known not to match."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-004",
            "prompt": "The left half is ordered, but target is smaller than nums[left] or greater than nums[mid]. Which side should be retained?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "right_side",
                  "text": "The right side starting at mid + 1."
                },
                {
                  "id": "left_side",
                  "text": "The ordered left half."
                },
                {
                  "id": "return_left",
                  "text": "Return left."
                },
                {
                  "id": "stop",
                  "text": "Return not found immediately."
                }
              ],
              "acceptedOptionIds": [
                "right_side"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Range exclusion from the ordered half permits discarding it.",
              "details": "The other half may contain the pivot and the target.",
              "wrongOptionExplanationsByOptionId": {
                "left_side": "The target falls outside that half's value range.",
                "return_left": "No endpoint equality has been established.",
                "stop": "The target may remain in the rotated right half."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-005",
            "prompt": "How should the algorithm behave when the active interval is not rotated and is fully ascending?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "classic_logic",
                  "text": "The same ordered-half logic reduces to ordinary binary search."
                },
                {
                  "id": "fail_rotation",
                  "text": "Return not found because no pivot exists inside the interval."
                },
                {
                  "id": "linear_only",
                  "text": "Switch unconditionally to a full linear scan."
                },
                {
                  "id": "reverse",
                  "text": "Reverse the interval before searching."
                }
              ],
              "acceptedOptionIds": [
                "classic_logic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "An unrotated interval has an ordered left half and an ordered right half.",
              "details": "The target-range test chooses the same side as classic binary search.",
              "wrongOptionExplanationsByOptionId": {
                "fail_rotation": "Zero rotation is a valid rotated-array case.",
                "linear_only": "The interval remains directly binary-searchable.",
                "reverse": "Mutation is unnecessary."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-006",
            "prompt": "A one-element rotated array contains target. What should happen?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "return_zero",
                  "text": "The midpoint is index 0 and should be returned."
                },
                {
                  "id": "skip_singleton",
                  "text": "The loop should skip because no half can be identified."
                },
                {
                  "id": "return_not_found",
                  "text": "Rotation makes a singleton unsearchable."
                },
                {
                  "id": "move_both",
                  "text": "Both boundaries should move before comparison."
                }
              ],
              "acceptedOptionIds": [
                "return_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Rotated search retains the exact-match check before structural half classification.",
              "details": "Minimal domains should behave like classic exact search.",
              "wrongOptionExplanationsByOptionId": {
                "skip_singleton": "A singleton is a valid candidate interval.",
                "return_not_found": "A singleton is trivially sorted.",
                "move_both": "The only candidate must be checked first."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-007",
            "prompt": "Why is comparing target only with nums[mid] insufficient after a mismatch in a rotated array?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "need_ordered_half",
                  "text": "The global order is broken at the pivot, so direction requires identifying an ordered half and checking its endpoint range."
                },
                {
                  "id": "mid_unreadable",
                  "text": "nums[mid] cannot be read after rotation."
                },
                {
                  "id": "target_not_numeric",
                  "text": "Targets in rotated arrays are never numeric."
                },
                {
                  "id": "both_halves_unsorted",
                  "text": "Both halves are always unsorted."
                }
              ],
              "acceptedOptionIds": [
                "need_ordered_half"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A simple target < nums[mid] comparison may point across the rotation pivot incorrectly.",
              "details": "Local half ordering restores a valid elimination rule.",
              "wrongOptionExplanationsByOptionId": {
                "mid_unreadable": "Rotation does not affect access.",
                "target_not_numeric": "The reasoning applies to any ordered values.",
                "both_halves_unsorted": "At least one half is ordered under the distinct-value contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-008",
            "prompt": "What problem do equal values create when nums[left] == nums[mid] == nums[right]?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ambiguous_half",
                  "text": "The comparisons may not reveal which half contains the rotation pivot."
                },
                {
                  "id": "target_found",
                  "text": "They prove target is present."
                },
                {
                  "id": "array_invalid",
                  "text": "The input can no longer be considered rotated."
                },
                {
                  "id": "mid_overflow",
                  "text": "They cause midpoint arithmetic overflow."
                }
              ],
              "acceptedOptionIds": [
                "ambiguous_half"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Distinct-value reasoning relies on a strict structural comparison.",
              "details": "When all three values are equal, shrinking one or both boundaries may be necessary, which can reduce the worst-case progress.",
              "wrongOptionExplanationsByOptionId": {
                "target_found": "The equal endpoint value may differ from target.",
                "array_invalid": "Rotated arrays may contain duplicates under a broader contract.",
                "mid_overflow": "Value equality is unrelated to index arithmetic."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-009",
            "prompt": "When duplicate ambiguity is resolved by incrementing left and decrementing right, what worst-case behavior becomes possible?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear",
                  "text": "O(n) time."
                },
                {
                  "id": "constant",
                  "text": "O(1) time."
                },
                {
                  "id": "log_squared",
                  "text": "O(log² n) time only."
                },
                {
                  "id": "factorial",
                  "text": "O(n!) time."
                }
              ],
              "acceptedOptionIds": [
                "linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Repeated equal endpoints can force the algorithm to discard only one or two positions per iteration.",
              "details": "Correctness can be preserved while the logarithmic guarantee is lost.",
              "wrongOptionExplanationsByOptionId": {
                "constant": "Boundary shrinking may inspect many equal values.",
                "log_squared": "The interval may shrink by one rather than by half.",
                "factorial": "No combinatorial branching occurs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-010",
            "prompt": "An ascending array is rotated by one position so the former last element moves to index 0. Which edge case does this test?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "pivot_near_left",
                  "text": "The rotation pivot lies immediately after the first element."
                },
                {
                  "id": "no_rotation",
                  "text": "There is no rotation."
                },
                {
                  "id": "all_duplicates",
                  "text": "Every value is duplicated."
                },
                {
                  "id": "descending_order",
                  "text": "The array becomes globally descending."
                }
              ],
              "acceptedOptionIds": [
                "pivot_near_left"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Rotations near either boundary test whether ordered-half detection works when one sorted region is very small.",
              "details": "The search must not assume the pivot lies near the middle.",
              "wrongOptionExplanationsByOptionId": {
                "no_rotation": "Moving the last element to the front changes the pivot.",
                "all_duplicates": "Rotation does not create duplicates.",
                "descending_order": "Most of the array remains ascending."
              }
            },
