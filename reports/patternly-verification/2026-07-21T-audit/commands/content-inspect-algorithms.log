            }
          },
          {
            "id": "algorithms-intervals-boundary-review-011",
            "prompt": "A one-pass merge sorts [2, 3), [4, 5), [1, 10) by end and never revisits earlier output. It returns [2, 3), [1, 10). What defect should the review record?",
            "constraints": [
              "The intended output is one union interval [1, 10)."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "wrong_sort_invariant",
                  "text": "The merge uses end order even though its tail-only emission proof requires nondecreasing starts."
                },
                {
                  "id": "wrong_endpoint_contract",
                  "text": "The only defect is that the intervals are half-open."
                },
                {
                  "id": "long_interval_special_case",
                  "text": "The implementation needs a special rule for intervals longer than all previous intervals."
                }
              ],
              "acceptedOptionIds": [
                "wrong_sort_invariant"
