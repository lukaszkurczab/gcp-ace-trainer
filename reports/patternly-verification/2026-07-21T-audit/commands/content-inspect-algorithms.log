          {
            "id": "alg-gt-complexity-005",
            "prompt": "Connected components are counted by scanning all V vertices and starting an adjacency-list traversal whenever a vertex is unseen. Across all components, derive worst-case time and auxiliary space, excluding input and output.",
            "difficulty": "intermediate",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliarySpace"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(V)",
                  "O(E)",
                  "O(V + E)",
                  "O(V(V + E))"
                ],
                "auxiliarySpace": [
                  "O(1)",
                  "O(V)",
                  "O(V + E)",
                  "O(V²)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(V + E)"
                ],
                "auxiliarySpace": [
                  "O(V)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {},
                "auxiliarySpace": {}
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The outer loop adds O(V), but visited state ensures the inner traversals partition rather than repeat graph work.",
              "details": "Every vertex is considered by the outer scan once and expanded by exactly one component traversal. Every adjacency entry is scanned in that one traversal, so the total is O(V + E), not one full traversal per component. Visited plus the largest component frontier is O(V). This amortized whole-graph accounting is the key complexity invariant of component enumeration."
            },
            "taxonomy": {
