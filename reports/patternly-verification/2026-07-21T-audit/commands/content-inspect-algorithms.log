          {
            "id": "alg-contrast-hash-sort-duplicates-016",
            "prompt": "Arrange a hash-frequency workflow.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "initialize",
                  "text": "Initialize an empty key-to-count table."
                },
                {
                  "id": "scan",
                  "text": "Scan values in original order."
                },
                {
                  "id": "update",
                  "text": "Increment the current value's count and any required first-index metadata."
