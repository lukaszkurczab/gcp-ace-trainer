                "output_space": {
                  "k_per_subset": "O(k·C(n,k))"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Filtering after full mask enumeration does not remove the cost of inspecting all masks.",
              "details": "The returned fixed-size subsets occupy k elements each."
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_subset_by_bitmask",
              "secondarySkillAtomIds": [],
