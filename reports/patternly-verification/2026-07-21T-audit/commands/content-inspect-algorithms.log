        "items": [
          {
            "id": "alg-contrast-hash-sort-transfer-001",
            "prompt": "A static-key membership service changes its query from exact membership to \"return every key between a and b in order.\" How should the preferred structure change?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "toward_sorting",
                  "text": "The new ordered-range relation favors sorting or another ordered representation."
                },
                {
                  "id": "keep_hash_only",
                  "text": "Exact and range queries are identical for a hash set."
                },
                {
                  "id": "scan_names",
                  "text": "Keep the same strategy because variable names did not change."
                },
                {
                  "id": "no_preprocess",
                  "text": "Range output never benefits from preprocessing."
                }
              ],
              "acceptedOptionIds": [
                "toward_sorting"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A small change from equality to range semantics crosses the strategy boundary.",
              "details": "The required relation, not the dataset alone, determines reusable structure.",
              "wrongOptionExplanationsByOptionId": {
                "keep_hash_only": "A plain set cannot locate ordered interval boundaries.",
                "scan_names": "The semantic query changed.",
                "no_preprocess": "Ordered preprocessing is reusable."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-transfer-002",
            "prompt": "A frequency-report task changes from arbitrary group order to ascending key order. What changes in the comparison?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ordering_cost",
                  "text": "Sorting becomes directly useful, or the hash path must add key sorting and include that cost."
                },
                {
                  "id": "nothing",
                  "text": "Output order never affects strategy."
                },
                {
                  "id": "hash_sorted",
                  "text": "Hash iteration becomes automatically ascending."
                },
                {
                  "id": "drop_counts",
                  "text": "Counts must be removed."
                }
              ],
              "acceptedOptionIds": [
                "ordering_cost"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The hash path can remain correct only with an explicit ordering stage.",
              "details": "A sort-and-run path may now reuse its main preprocessing for the final output.",
              "wrongOptionExplanationsByOptionId": {
                "nothing": "Ascending order is observable.",
                "hash_sorted": "No such universal guarantee exists.",
                "drop_counts": "The grouping data remains required."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-transfer-003",
            "prompt": "A duplicate-detection task adds the requirement to return the earliest repeated arrival index. Which direction does this push?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "toward_hash_online",
                  "text": "Toward a hash-based seen-state scan that preserves arrival order and can stop early."
                },
                {
                  "id": "toward_sort_values",
                  "text": "Toward sorting values without original indices."
                },
                {
                  "id": "no_change",
                  "text": "Duplicate existence and earliest repeated arrival are the same contract."
                },
                {
                  "id": "all_pairs",
                  "text": "Toward checking every pair regardless of constraints."
                }
              ],
              "acceptedOptionIds": [
                "toward_hash_online"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Adding an online original-position result changes the consumed structure.",
              "details": "The best sorting path would need decoration and complete input, while hashing can answer during the scan.",
              "wrongOptionExplanationsByOptionId": {
                "toward_sort_values": "That loses the earliest arrival identity.",
                "no_change": "The latter is position- and order-sensitive.",
                "all_pairs": "A seen set serves the online relation directly."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-transfer-004",
            "prompt": "A grouping job originally forbids mutation, but the contract changes to allow reordering and imposes a strict auxiliary-memory cap. What transfer is plausible?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "toward_in_place_sort",
                  "text": "An in-place sort-and-run strategy may become preferable."
                },
                {
                  "id": "toward_more_hash",
                  "text": "The memory cap makes an O(n)-entry hash table automatically better."
                },
                {
                  "id": "no_effect",
                  "text": "Mutation permission never affects memory strategy."
                },
                {
                  "id": "drop_groups",
                  "text": "The result must be weakened."
                }
              ],
              "acceptedOptionIds": [
                "toward_in_place_sort"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Allowing mutation changes the sorting path from copy-plus-sort to direct in-place processing.",
              "details": "That can reverse the memory decision even though the duplicate semantics are unchanged.",
              "wrongOptionExplanationsByOptionId": {
                "toward_more_hash": "The new constraint weakens the hash case.",
                "no_effect": "It can eliminate the need for an O(n) copy.",
                "drop_groups": "A legal lower-memory strategy exists."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-transfer-005",
            "prompt": "A sorted report changes into an online stream that must answer seen-before immediately. Which transfer is appropriate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "toward_hash",
                  "text": "Use incremental hash membership state rather than waiting to sort the complete stream."
                },
                {
                  "id": "keep_offline_sort",
                  "text": "Delay every answer until the stream ends."
                },
                {
                  "id": "binary_unsorted",
                  "text": "Binary-search values as they arrive without maintaining order."
                },
                {
                  "id": "adjacent_only",
                  "text": "Compare only the last two arrivals."
                }
              ],
              "acceptedOptionIds": [
                "toward_hash"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Online response and arrival order create a lookup-state signal.",
              "details": "The former ordered-output structure is no longer the primary result.",
              "wrongOptionExplanationsByOptionId": {
                "keep_offline_sort": "That violates immediate response.",
                "binary_unsorted": "The active data is not sorted.",
                "adjacent_only": "Repeated values may be separated."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-transfer-006",
            "prompt": "Keys stop providing a compatible hash but still provide a total comparator. What should happen?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_to_sort",
                  "text": "Remove the hash strategy from the legal candidate set and use comparison-based ordering where it satisfies the result."
                },
                {
                  "id": "invent_hash",
                  "text": "Use an unrelated pointer hash and preserve semantic equality automatically."
                },
                {
                  "id": "no_algorithm",
                  "text": "The problem becomes unsolvable."
                },
                {
                  "id": "same_cost",
                  "text": "Key operations never affect candidate legality."
                }
              ],
              "acceptedOptionIds": [
                "hash_to_sort"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Transfer begins by rechecking which primitive relations exist.",
              "details": "An asymptotically attractive but illegal hash operation cannot remain the chosen strategy.",
              "wrongOptionExplanationsByOptionId": {
                "invent_hash": "Hash/equality compatibility is required.",
                "no_algorithm": "Sorting remains legal.",
                "same_cost": "They define legal mechanisms."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-transfer-007",
            "prompt": "A static sorted dataset becomes highly dynamic with frequent insertions and deletions, while queries remain exact membership only. Which direction can become attractive?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "toward_hash_updates",
                  "text": "A hash set can maintain equality state with expected incremental updates, avoiding repeated full resorting."
                },
                {
                  "id": "resort_everything",
                  "text": "Full resorting after every update is always optimal."
                },
                {
                  "id": "range_required",
                  "text": "Frequent updates automatically create ordered range queries."
                },
                {
                  "id": "scan_only",
                  "text": "Updates make reusable state impossible."
                }
              ],
              "acceptedOptionIds": [
                "toward_hash_updates"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Update frequency changes the lifecycle cost of preprocessing.",
              "details": "The exact decision still depends on guarantees, order needs, and available dynamic ordered structures.",
              "wrongOptionExplanationsByOptionId": {
                "resort_everything": "Repeated O(n log n) rebuilds may dominate.",
                "range_required": "The query relation remains exact membership.",
                "scan_only": "Dynamic structures can be maintained."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-transfer-008",
            "prompt": "A service changes from expected throughput goals to a deterministic worst-case latency requirement under adversarial keys. What transfer may be justified?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "toward_guaranteed_sort",
                  "text": "Toward a deterministic comparison-sorting or ordered strategy, unless hashing supplies an explicit protected worst-case guarantee."
                },
                {
                  "id": "same_hash_claim",
                  "text": "Expected O(1) is automatically a deterministic guarantee."
                },
                {
                  "id": "ignore_adversary",
                  "text": "Input control never affects hashing."
                },
                {
                  "id": "sort_constant",
                  "text": "Sorting becomes O(1)."
                }
              ],
              "acceptedOptionIds": [
                "toward_guaranteed_sort"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A change in required guarantee can reverse the preferred legal strategy without changing the nominal input size.",
              "details": "Expected and deterministic bounds must not be substituted for one another.",
              "wrongOptionExplanationsByOptionId": {
                "same_hash_claim": "The guarantee model changed.",
                "ignore_adversary": "Collision behavior can be adversarial.",
                "sort_constant": "It remains nonconstant but can have predictable bounds."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-transfer-009",
            "prompt": "An unsorted dataset is replaced by a guaranteed already-sorted dataset, while the task remains grouped ordered output. What transfer is appropriate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "reuse_scan",
                  "text": "Drop both hash construction and sorting; scan existing equal runs directly."
                },
                {
                  "id": "hash_rebuild",
                  "text": "Build a table because hashing is always faster."
                },
                {
                  "id": "sort_again",
                  "text": "Pay O(n log n) to recreate the same order."
                },
                {
                  "id": "no_groups",
                  "text": "Sorted input cannot contain duplicates."
                }
              ],
              "acceptedOptionIds": [
                "reuse_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Input preconditions are reusable work.",
              "details": "The best transfer can be to neither preprocessing candidate when the required structure is already supplied.",
              "wrongOptionExplanationsByOptionId": {
                "hash_rebuild": "The required order already exists.",
                "sort_again": "No reorder is needed.",
                "no_groups": "Equal values can be adjacent."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_hash_vs_sorting_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
