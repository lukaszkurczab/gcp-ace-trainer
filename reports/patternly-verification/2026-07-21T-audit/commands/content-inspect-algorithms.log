      {
        "id": "alg-greedy-intro-gfs-003",
        "prompt": "Travel occurs on days 1 through 7 and day 10. Passes cost 2 for 1 day, 7 for 7 days, and 15 for 30 days. What is the decisive failure signal for “buy the cheapest pass on each uncovered travel day”?",
        "constraints": [
          "A pass covers consecutive calendar days beginning on its purchase day.",
          "The objective is minimum total cost."
        ],
        "difficulty": "intermediate",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "future_coverage_state",
              "text": "The 7-day pass costs more now but covers several future travel days, so immediate price does not capture the residual cost state."
            },
            {
              "id": "cheapest_is_always_best",
              "text": "A 1-day pass is cheapest, so buying it on every travel day must minimize total cost."
            },
            {
              "id": "sort_passes_once",
              "text": "Sorting pass types by price once makes the repeated cheapest choice optimal."
            },
            {
              "id": "same_as_interval_count",
              "text": "Because passes cover intervals, earliest-finish interval selection applies unchanged."
            }
          ],
          "acceptedOptionIds": [
