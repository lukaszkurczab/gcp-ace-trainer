          {
            "id": "alg-prefix-2d-transfer-indicator-regions",
            "prompt": "Which requirement transfers directly to the same 2D prefix mechanism after changing each cell’s contribution?",
            "constraints": [
              "The matrix is immutable.",
              "Queries ask about arbitrary axis-aligned rectangles."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "count_obstacles",
                  "text": "Count obstacle cells in each rectangle by prefixing 1 for an obstacle and 0 otherwise."
                },
                {
                  "id": "rectangle_median",
                  "text": "Find the median cell value by subtracting four scalar prefix sums."
