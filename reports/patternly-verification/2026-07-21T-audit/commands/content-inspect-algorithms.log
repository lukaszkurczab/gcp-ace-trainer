        "items": [
          {
            "id": "alg-complexity-amortized-001",
            "prompt": "What does an amortized O(1) operation guarantee?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sequence_average",
                  "text": "For every allowed operation sequence, total cost divided across the sequence is O(1) per operation, even if some individual operations are expensive."
                },
                {
                  "id": "each_worst_constant",
                  "text": "Every individual operation has worst-case O(1) cost."
                },
                {
                  "id": "random_average",
                  "text": "The expected cost is O(1) only under a random input distribution."
                },
                {
                  "id": "first_only",
                  "text": "Only the first operation is O(1)."
                }
              ],
              "acceptedOptionIds": [
                "sequence_average"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Amortized analysis spreads infrequent expensive operations across many cheap operations.",
              "details": "It is a deterministic sequence guarantee, not a promise that each call is cheap.",
              "wrongOptionExplanationsByOptionId": {
                "each_worst_constant": "An occasional operation may be much more expensive.",
                "random_average": "That describes average or expected analysis, not deterministic amortized analysis.",
                "first_only": "The claim concerns the sequence total."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-002",
            "prompt": "How does amortized analysis differ from average-case analysis?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_distribution",
                  "text": "Amortized analysis does not require a probability distribution over inputs or operations."
                },
                {
                  "id": "same",
                  "text": "They are identical names for the same concept."
                },
                {
                  "id": "worst_each",
                  "text": "Amortized analysis is the worst-case cost of one operation."
                },
                {
                  "id": "output_only",
                  "text": "Amortized analysis applies only to output size."
                }
              ],
              "acceptedOptionIds": [
                "no_distribution"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Average-case reasoning asks for an expectation under a model.",
              "details": "Amortized reasoning bounds the total cost of any valid sequence and divides it across operations.",
              "wrongOptionExplanationsByOptionId": {
                "same": "Average case depends on a distribution; amortized analysis can hold for every sequence.",
                "worst_each": "It concerns a sequence aggregate.",
                "output_only": "It applies to operation sequences."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-003",
            "prompt": "A dynamic array doubles capacity when full. What are the worst-case and amortized costs of one append under the fixed-element-copy model?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "worst_n_amortized_1",
                  "text": "Worst-case O(n), amortized O(1)."
                },
                {
                  "id": "both_1",
                  "text": "Both worst-case and amortized O(1)."
                },
                {
                  "id": "both_n",
                  "text": "Both O(n)."
                },
                {
                  "id": "worst_1_amortized_n",
                  "text": "Worst-case O(1), amortized O(n)."
                }
              ],
              "acceptedOptionIds": [
                "worst_n_amortized_1"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "An append that triggers resizing copies the current contents.",
              "details": "Geometric capacity growth makes the sum of all copies across n appends linear, so average charged cost per append is constant.",
              "wrongOptionExplanationsByOptionId": {
                "both_1": "A resize may copy n existing elements.",
                "both_n": "Most appends do not resize.",
                "worst_1_amortized_n": "The labels are reversed."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-amortized-004",
            "prompt": "Why is geometric capacity growth important for dynamic-array amortized append?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "resizes_sparse",
                  "text": "Capacity increases by a constant factor, so expensive copies occur after increasingly many cheap appends."
                },
                {
                  "id": "copy_never",
                  "text": "It eliminates copying entirely."
                },
                {
                  "id": "randomness",
                  "text": "It makes resize positions random."
                },
                {
                  "id": "names",
                  "text": "The variable capacity has a special Big-O meaning."
                }
              ],
              "acceptedOptionIds": [
                "resizes_sparse"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Doubling produces copy sizes 1, 2, 4, 8, and so on.",
              "details": "The geometric sum remains proportional to the final number of elements.",
              "wrongOptionExplanationsByOptionId": {
                "copy_never": "Resizes still copy existing elements.",
                "randomness": "No random model is needed.",
                "names": "Names do not determine cost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-005",
            "prompt": "A stack supports push, pop, and multipop(k), where multipop removes at most k existing items. Why can multipop be amortized O(1) over a sequence?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "each_item_once",
                  "text": "Each pushed item can be popped at most once before it would need to be pushed again."
                },
                {
                  "id": "multipop_constant",
                  "text": "Every multipop call removes at most one item."
                },
                {
                  "id": "stack_sorted",
                  "text": "The stack remains sorted."
                },
                {
                  "id": "random_k",
                  "text": "k is chosen randomly."
                }
              ],
              "acceptedOptionIds": [
                "each_item_once"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The total number of successful pops is bounded by the total number of pushes.",
              "details": "Even if one multipop is expensive, all removals across m operations are O(m).",
              "wrongOptionExplanationsByOptionId": {
                "multipop_constant": "One call can remove many items.",
                "stack_sorted": "Ordering is irrelevant.",
                "random_k": "No probability model is required."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-amortized-006",
            "prompt": "A binary counter increments by flipping trailing ones to zero and the next zero to one. Why is increment amortized O(1) bit flips?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "geometric_flip_frequency",
                  "text": "Higher bits flip exponentially less often, so total flips over n increments are O(n)."
                },
                {
                  "id": "every_increment_one_flip",
                  "text": "Every increment flips exactly one bit."
                },
                {
                  "id": "counter_width_constant_only",
                  "text": "The claim holds only because the counter width is one bit."
                },
                {
                  "id": "random_bits",
                  "text": "Bit patterns are assumed random."
                }
              ],
              "acceptedOptionIds": [
                "geometric_flip_frequency"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Bit 0 flips every increment, bit 1 every two increments, bit 2 every four, and so on.",
              "details": "Summing those frequencies gives fewer than 2n flips over n increments.",
              "wrongOptionExplanationsByOptionId": {
                "every_increment_one_flip": "Values ending in ones flip multiple bits.",
                "counter_width_constant_only": "The argument handles growing bit length.",
                "random_bits": "The flip schedule is deterministic."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-amortized-007",
            "prompt": "Can an amortized O(1) operation still cause a visible latency spike in one call?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "yes_individual_expensive",
                  "text": "Yes. Amortized analysis permits occasional expensive individual operations."
                },
                {
                  "id": "no",
                  "text": "No. Amortized O(1) means strict worst-case O(1)."
                },
                {
                  "id": "only_random",
                  "text": "Only under random inputs."
                },
                {
                  "id": "only_output",
                  "text": "Only when output size is large."
                }
              ],
              "acceptedOptionIds": [
                "yes_individual_expensive"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Amortized throughput and per-operation latency are different contracts.",
              "details": "Real-time systems may require worst-case bounds even when total sequence cost is excellent.",
              "wrongOptionExplanationsByOptionId": {
                "no": "That confuses amortized and worst-case guarantees.",
                "only_random": "The expensive event can be deterministic.",
                "only_output": "Resizing or cleanup can cause the spike without large output."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-008",
            "prompt": "Is the statement \"an operation is usually cheap\" sufficient to prove a good amortized bound?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "need_total_bound",
                  "text": "No. The frequency and total cost of expensive operations must be bounded over every valid sequence."
                },
                {
                  "id": "yes_usually",
                  "text": "Yes. Informal frequency is enough."
                },
                {
                  "id": "yes_random",
                  "text": "Yes, because amortized means probabilistic."
                },
                {
                  "id": "names",
                  "text": "Only the operation name is needed."
                }
              ],
              "acceptedOptionIds": [
                "need_total_bound"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A proof must charge every expensive event to a limited resource, credit, or potential decrease.",
              "details": "Without a sequence bound, 'usually' is only an observation.",
              "wrongOptionExplanationsByOptionId": {
                "yes_usually": "A rare operation can be catastrophically expensive.",
                "yes_random": "Amortized analysis is not probability-based.",
                "names": "Names do not encode cost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-009",
            "prompt": "A data structure advertises amortized O(1) insertion. Which statement is safe?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "total_n_linear",
                  "text": "A sequence of n insertions has O(n) total insertion cost under the stated model."
                },
                {
                  "id": "each_constant",
                  "text": "Every insertion individually takes O(1) worst-case time."
                },
                {
                  "id": "expected_only",
                  "text": "The guarantee holds only in expectation over random insertions."
                },
                {
                  "id": "preprocessing_free",
                  "text": "Any preprocessing cost can be ignored."
                }
              ],
              "acceptedOptionIds": [
                "total_n_linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Multiplying the amortized bound by the sequence length yields the total bound.",
              "details": "The distribution of cost across individual insertions may be uneven.",
              "wrongOptionExplanationsByOptionId": {
                "each_constant": "The amortized claim does not guarantee this.",
                "expected_only": "That would need an average-case or expected-time statement.",
                "preprocessing_free": "The sequence model must specify all charged work."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-amortized-010",
            "prompt": "Which statements correctly distinguish amortized and worst-case cost? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "worst_single",
                  "text": "Worst-case operation cost bounds the most expensive individual call."
                },
                {
                  "id": "amortized_sequence",
                  "text": "Amortized cost bounds total cost across a sequence."
                },
                {
                  "id": "amortized_each",
                  "text": "Amortized O(1) proves every call is O(1)."
                },
                {
                  "id": "both_use_model",
                  "text": "Both claims require a defined operation and cost model."
                }
              ],
              "acceptedOptionIds": [
                "worst_single",
                "amortized_sequence",
                "both_use_model"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Worst-case and amortized claims answer different performance questions.",
              "details": "They can coexist: an operation may be worst-case O(n) and amortized O(1).",
              "wrongOptionExplanationsByOptionId": {
                "amortized_each": "That is false."
              },
              "omittedCorrectExplanationsByOptionId": {
                "worst_single": "It is a per-operation latency guarantee.",
                "amortized_sequence": "Expensive calls can be spread across cheap calls.",
                "both_use_model": "The charged work must be explicit."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-011",
            "prompt": "Which facts support the dynamic-array amortized append proof? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "geometric_growth",
                  "text": "Capacity grows by a constant factor greater than one."
                },
                {
                  "id": "copy_existing",
                  "text": "A resize copies the current number of stored elements."
                },
                {
                  "id": "geometric_sum",
                  "text": "The total copied elements across growth steps form a geometric sum O(n)."
                },
                {
                  "id": "grow_one",
                  "text": "Capacity increases by exactly one on every full append."
                }
              ],
              "acceptedOptionIds": [
                "geometric_growth",
                "copy_existing",
                "geometric_sum"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The proof depends on both the resize cost and how often it occurs.",
              "details": "Growing by one would destroy the constant amortized bound.",
              "wrongOptionExplanationsByOptionId": {
                "grow_one": "That would cause 1 + 2 + ... + n copying, which is quadratic."
              },
              "omittedCorrectExplanationsByOptionId": {
                "geometric_growth": "Resize events become geometrically spaced.",
                "copy_existing": "This defines the expensive event.",
                "geometric_sum": "This supplies the aggregate bound."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-amortized-012",
            "prompt": "Which methods can establish an amortized bound? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "aggregate",
                  "text": "Bound total cost of n operations and divide by n."
                },
                {
                  "id": "accounting",
                  "text": "Charge extra credit to cheap operations to pay for later expensive ones."
                },
                {
                  "id": "potential",
                  "text": "Track stored potential whose change offsets actual cost."
                },
                {
                  "id": "random_sample",
                  "text": "Measure a random subset and call the average amortized."
                }
              ],
              "acceptedOptionIds": [
                "aggregate",
                "accounting",
                "potential"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Amortized proofs can be presented through total cost, credits, or potential.",
              "details": "All three are deterministic accounting frameworks.",
              "wrongOptionExplanationsByOptionId": {
                "random_sample": "That is empirical average-case evidence, not a proof."
              },
              "omittedCorrectExplanationsByOptionId": {
                "aggregate": "This is the aggregate method.",
                "accounting": "This is the accounting method.",
                "potential": "This is the potential method."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-013",
            "prompt": "Which claims are invalid uses of amortized analysis? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "ignore_spike",
                  "text": "A real-time requirement can ignore a worst-case O(n) resize because append is amortized O(1)."
                },
                {
                  "id": "random_average",
                  "text": "A measured mean over random inputs is automatically an amortized proof."
                },
                {
                  "id": "unbounded_cleanup",
                  "text": "An unbounded cleanup is harmless merely because it occurs rarely, without bounding rarity or cost."
                },
                {
                  "id": "sequence_total",
                  "text": "n amortized-O(1) operations have O(n) total charged cost."
                }
              ],
              "acceptedOptionIds": [
                "ignore_spike",
                "random_average",
                "unbounded_cleanup"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Amortized analysis cannot replace latency guarantees or unproven frequency assumptions.",
              "details": "Every expensive event must be accounted for.",
              "wrongOptionExplanationsByOptionId": {
                "sequence_total": "This is a valid implication."
              },
              "omittedCorrectExplanationsByOptionId": {
                "ignore_spike": "Real-time latency may require per-operation bounds.",
                "random_average": "A distributional sample is not a sequence guarantee.",
                "unbounded_cleanup": "Total sequence cost may still be large."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-014",
            "prompt": "Arrange an aggregate-method amortized analysis.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "define_sequence",
                  "text": "Define an arbitrary sequence of n allowed operations."
                },
                {
                  "id": "bound_total",
                  "text": "Bound the total actual cost of the whole sequence."
                },
                {
                  "id": "divide",
                  "text": "Divide the total bound by n."
                },
                {
                  "id": "state_limits",
                  "text": "State the amortized result and any separate worst-case operation cost."
                }
              ],
              "canonicalOrder": [
                "define_sequence",
                "bound_total",
                "divide",
                "state_limits"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The aggregate method proves a sequence guarantee directly.",
              "details": "Separately stating worst-case latency prevents the common equality mistake."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-amortized-015",
            "prompt": "Arrange an accounting-method explanation for dynamic-array append.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "charge_credit",
                  "text": "Charge each cheap append a constant amount greater than its immediate cost."
                },
                {
                  "id": "store_credit",
                  "text": "Store the surplus credit conceptually."
                },
                {
                  "id": "pay_resize",
                  "text": "Use accumulated credit to pay for the next resize copy."
                },
                {
                  "id": "bound_charge",
                  "text": "Conclude a constant amortized charge covers every append."
                }
              ],
              "canonicalOrder": [
                "charge_credit",
                "store_credit",
                "pay_resize",
                "bound_charge"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Credits move cost from rare expensive operations to preceding cheap operations.",
              "details": "The proof must show credits never become negative."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-amortized-016",
            "prompt": "A dynamic array starts empty and doubles capacity. Across n appends, select total append cost, amortized cost per append, and worst-case cost of one append.",
            "constraints": [
              "Copying one element costs O(1)."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "total_cost",
                "amortized_per_append",
                "worst_single_append"
              ],
              "availableValuesByDimension": {
                "total_cost": [
                  "O(n)",
                  "O(n log n)",
                  "O(n²)",
                  "O(2^n)"
                ],
                "amortized_per_append": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ],
                "worst_single_append": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "total_cost": [
                  "O(n)"
                ],
                "amortized_per_append": [
                  "O(1)"
                ],
                "worst_single_append": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "total_cost": {
                  "geometric_copies": "O(n)"
                },
                "amortized_per_append": {
                  "total_divided_by_n": "O(1)"
                },
                "worst_single_append": {
                  "resize_copy": "O(n)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Geometric resize copies sum to O(n) across n appends.",
              "details": "One append can still copy the current array, so its individual worst case is linear."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-amortized-017",
            "prompt": "A stack executes m operations chosen from push, pop, and multipop. Each pushed item can be removed at most once before a later push. Select total cost and amortized cost per operation.",
            "constraints": [
              "Each successful push or pop costs O(1)."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "total_cost",
                "amortized_per_operation"
              ],
              "availableValuesByDimension": {
                "total_cost": [
                  "O(m)",
                  "O(m log m)",
                  "O(m²)",
                  "O(2^m)"
                ],
                "amortized_per_operation": [
                  "O(1)",
                  "O(log m)",
                  "O(m)",
                  "O(m²)"
                ]
              },
              "acceptedValuesByDimension": {
                "total_cost": [
                  "O(m)"
                ],
                "amortized_per_operation": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "total_cost": {
                  "pushes_plus_pops": "O(m)"
                },
                "amortized_per_operation": {
                  "aggregate": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "There can be at most m pushes and at most one successful pop per pushed item.",
              "details": "A single multipop may be large, but total removals remain linear in the sequence length."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_amortized_from_worst_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-amortized-018",
            "prompt": "A binary counter starts at zero and is incremented n times. Select total bit flips, amortized flips per increment, and worst-case flips of one increment.",
            "constraints": [
              "The counter has enough bits to represent values through n."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "total_flips",
                "amortized_per_increment",
                "worst_single_increment"
              ],
              "availableValuesByDimension": {
                "total_flips": [
                  "O(n)",
                  "O(n log n)",
                  "O(n²)",
                  "O(2^n)"
                ],
                "amortized_per_increment": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ],
                "worst_single_increment": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "total_flips": [
                  "O(n)"
                ],
                "amortized_per_increment": [
                  "O(1)"
                ],
                "worst_single_increment": [
                  "O(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "total_flips": {
                  "geometric_frequency": "O(n)"
                },
                "amortized_per_increment": {
                  "total_divided_by_n": "O(1)"
                },
                "worst_single_increment": {
                  "all_trailing_ones": "O(log n)"
