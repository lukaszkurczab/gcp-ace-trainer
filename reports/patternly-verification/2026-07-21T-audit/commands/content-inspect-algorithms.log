        "items": [
          {
            "id": "alg-tp-rw-valid-prefix-invariant",
            "prompt": "During stable in-place filtering, read has processed positions [0, read) and write marks the next output slot. Which invariant should hold before each iteration?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "prefix_is_sorted",
                  "text": "Positions [0, write) are numerically sorted."
                },
                {
                  "id": "write_equals_read",
                  "text": "write always equals read."
                },
                {
                  "id": "suffix_is_empty",
                  "text": "Positions [read, n) have already been cleared."
                },
                {
                  "id": "prefix_contains_kept",
                  "text": "Positions [0, write) contain exactly the kept values from [0, read), in their original relative order."
                }
              ],
              "acceptedOptionIds": [
                "prefix_contains_kept"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The write boundary is the length of the stable valid prefix produced from the input already consumed by read.",
              "details": "This invariant connects the two pointers: read identifies how much input has been examined, while write identifies how much valid output has been produced. It permits write to lag behind read when rejected values are encountered. Numerical sorting is unrelated and would change the stable-order contract. The unread suffix remains original input and must not be treated as processed state.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_is_sorted": "Filtering preserves encounter order; it does not impose numerical order unless sorting is a separate explicit requirement.",
                "write_equals_read": "Rejected values make write lag behind read. Equality holds only while every processed value has been kept.",
                "suffix_is_empty": "The unread suffix still contains input that must be inspected. Clearing it early could destroy future values."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_read_write_pointer_invariant",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "same_direction_read_write",
              "problemArchetypeId": "compact_sequence_in_place"
            },
            "difficulty": "introductory",
            "constraints": [
              "Kept values must preserve their original relative order.",
              "Compaction is performed in the same array."
            ]
          },
          {
            "id": "alg-tp-rw-keep-operation",
            "prompt": "During stable compaction, predicate P accepts a[read]. How must the output-prefix boundary be updated?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "advance_read_only",
                  "text": "Advance read and leave write unchanged."
                },
                {
                  "id": "swap_with_end",
                  "text": "Swap the current value with the last unprocessed value."
                },
                {
                  "id": "copy_then_increment_write",
                  "text": "Write the current value at position write, then increment write; read advances to the next input position."
                },
                {
                  "id": "increment_write_only",
                  "text": "Increment write without copying the current value."
