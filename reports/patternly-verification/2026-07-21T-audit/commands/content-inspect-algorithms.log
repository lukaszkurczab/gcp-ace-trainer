            }
          },
          {
            "id": "alg-contrast-hash-sort-order-020",
            "prompt": "Create n decorated value-index records, sort them in O(n log n), and retain the original array. Select total time and peak auxiliary space excluding final output.",
            "constraints": [
              "The decorated record array contains n records.",
              "The sorting algorithm's extra buffer is at most O(n)."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "peak_auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
