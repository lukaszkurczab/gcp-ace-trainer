              "problemArchetypeId": "range_query"
            }
          },
          {
            "id": "alg-prefix-recognize-signal-transfer-predicate-counts",
            "prompt": "Which new requirement preserves the same reusable-prefix decision boundary as static range sums?",
            "constraints": [
              "The source array is immutable.",
              "The requirement must be answerable from two precomputed boundary states."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "count_even_in_ranges",
                  "text": "Answer many queries asking how many even values occur in [l, r], by prefixing a 0/1 indicator."
                },
                {
                  "id": "range_median_queries",
                  "text": "Answer arbitrary range medians by subtracting two scalar prefix sums."
                },
                {
                  "id": "online_point_updates",
                  "text": "Support point updates and immediately answer later sums using an unchanged static prefix."
                },
                {
                  "id": "longest_unique_subarray",
                  "text": "Find the longest subarray with all distinct values by subtracting two prefix sums."
                }
              ],
              "acceptedOptionIds": [
                "count_even_in_ranges"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A predicate count becomes an additive sequence, so two cumulative counts isolate the requested interval.",
              "details": "Map each value to 1 when it is even and 0 otherwise, then use the same P[r + 1] - P[l] rule. A scalar sum cannot recover a median or distinctness constraint, and online updates make a static prefix stale. The transfer rule is: derive a per-position contribution whose cumulative states can be combined to recover exactly the requested range result.",
              "wrongOptionExplanationsByOptionId": {
                "range_median_queries": "Two scalar sums do not preserve the order statistics needed for a median. A richer data structure or offline method is required.",
                "online_point_updates": "A static prefix bakes in every earlier value. After a point update, many later entries would need repair unless a dynamic structure is used.",
                "longest_unique_subarray": "Uniqueness is a stateful validity condition, not an additive contribution that can be isolated by subtraction. A frequency-constrained window is the usual mechanism."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_reusable_prefix_state",
              "secondarySkillAtomIds": [],
