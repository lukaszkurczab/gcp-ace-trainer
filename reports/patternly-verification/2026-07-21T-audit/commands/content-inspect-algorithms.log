        "items": [
          {
            "id": "alg-sw-order-longest-valid-sequence",
            "prompt": "Order the phases for one right-boundary step of a longest-valid variable window.",
            "constraints": [
              "Expansion may make the window invalid.",
              "The answer is maximum valid length."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "add_right_state",
                  "text": "Add the right-boundary element to maintained state."
                },
                {
                  "id": "repair_invalid",
                  "text": "While invalid, remove left-boundary state and advance left."
                },
                {
                  "id": "update_longest",
                  "text": "Update the maximum with the restored valid length."
                }
              ],
              "canonicalOrder": [
                "add_right_state",
                "repair_invalid",
                "update_longest"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Expansion changes state first, invalidity is then repaired, and only the resulting legal range may update a longest-valid answer.",
              "details": "The phases correspond to three different truths. Before expansion, the state describes the old range. After adding the right element, the new candidate is known but may violate its constraint. The repair loop advances left until state and validity agree. Only then does right−left+1 describe a legal candidate. Updating before repair scores an invalid range; repairing before adding checks the wrong candidate. This sequence transfers across sum, frequency, and budget predicates when their left-removal rule is legal."
            },
            "taxonomy": {
              "primarySkillAtomId": "order_window_state_updates",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "at_most_k_window",
              "problemArchetypeId": "longest_valid_window"
            }
          },
          {
            "id": "alg-sw-order-shortest-threshold-sequence",
            "prompt": "Order the operations performed after a right-boundary addition when minimizing the length of a positive-value window with sum at least T.",
            "constraints": [
              "The current sum after expansion is at least T.",
              "The inner steps repeat while the window remains valid."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "add_incoming",
                  "text": "Add the incoming right-boundary value."
                },
                {
                  "id": "record_current_length",
                  "text": "Record the current valid length as a minimum candidate."
                },
                {
                  "id": "subtract_outgoing",
                  "text": "Subtract the value at the current left boundary."
                },
                {
                  "id": "advance_left",
                  "text": "Advance the left boundary, then repeat the valid-loop test."
                }
              ],
              "canonicalOrder": [
                "add_incoming",
                "record_current_length",
                "subtract_outgoing",
                "advance_left"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A shortest candidate must be recorded while it is still valid, before the outgoing value is removed and left advances.",
              "details": "Expansion is what may establish sum≥T. Once valid, the current boundaries define a candidate and its length must be considered. Then remove the current outgoing value, move left, and test whether an even shorter valid suffix remains. Reversing record and removal can lose the last valid candidate; advancing left before subtraction can remove the wrong value. The repeated record–remove–advance relation is the operational core of shortest threshold windows. In adjacent-relation terms, record→subtract is decisive because reversing that pair can erase the last valid candidate represented by the current boundaries."
            },
            "taxonomy": {
              "primarySkillAtomId": "order_window_state_updates",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "variable_size_positive_numbers",
              "problemArchetypeId": "shortest_threshold_window"
            }
          },
          {
            "id": "alg-sw-order-fixed-initialization-to-slide",
            "prompt": "Order the transition from building the first fixed-size window to evaluating the second one.",
            "constraints": [
              "The required size is k.",
              "The first k−1 values are already in state before these operations begin."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "add_kth",
                  "text": "Add the kth value to complete the first legal window."
                },
                {
                  "id": "evaluate_first",
                  "text": "Evaluate the first length-k window."
                },
                {
                  "id": "add_next",
                  "text": "Add the next right-boundary value, temporarily creating k+1 elements."
                },
                {
                  "id": "remove_first",
                  "text": "Remove the original leftmost value and advance left."
                },
                {
                  "id": "evaluate_second",
                  "text": "Evaluate the restored second length-k window."
                }
              ],
              "canonicalOrder": [
                "add_kth",
                "evaluate_first",
                "add_next",
                "remove_first",
                "evaluate_second"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 4
            },
            "feedback": {
              "reason": "Initialization produces a legal size-k state before any removal; later expansions require one outgoing removal before evaluation.",
              "details": "The first window has no outgoing predecessor. After k−1 values, adding the kth completes a legal candidate and it should be scored immediately. Only on the next right step does the range become k+1, requiring removal of the original left value before scoring the second candidate. Applying the steady-state removal during initialization would keep the range below k; omitting removal during later steps would score an oversized range. The distinction prevents a common collapsed-loop boundary error."
            },
            "taxonomy": {
              "primarySkillAtomId": "order_window_state_updates",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "fixed_size_window",
              "problemArchetypeId": "fixed_length_aggregate"
            }
          },
          {
            "id": "alg-sw-order-remove-before-left-advance",
            "prompt": "A running-sum window uses `left += 1; sum -= a[left]` when removing the outgoing element. What is the precise defect?",
            "constraints": [
              "Before the two statements, left points to the element that must leave.",
              "No outgoing value was cached separately."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "subtracts_new_left",
                  "text": "Advancing first changes which element a[left] names, so the code subtracts the new leftmost value instead of the outgoing one."
                },
                {
                  "id": "subtracts_twice",
                  "text": "The same outgoing element is subtracted twice."
                },
                {
                  "id": "right_boundary_changes",
                  "text": "Incrementing left also increments right implicitly."
                },
                {
                  "id": "only_style",
                  "text": "The two orders are equivalent because addition and subtraction commute."
                }
              ],
              "acceptedOptionIds": [
                "subtracts_new_left"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary mutation changes the identity referenced by `a[left]`; remove state for the old boundary before advancing it.",
              "details": "The outgoing element is defined by the pre-move left boundary. If left is incremented first and the value was not cached, `a[left]` refers to the element that should remain in the window. The aggregate then contains the old outgoing value and lacks the new leftmost value, so state and boundaries diverge. Arithmetic commutativity does not help because the operands differ. Caching `outgoing = a[left]` before increment can make another concrete order safe, but the semantic dependency remains: identify/remove the old element before losing its boundary reference.",
              "wrongOptionExplanationsByOptionId": {
                "subtracts_twice": "Only one subtraction occurs; the issue is that it targets the wrong array element.",
                "right_boundary_changes": "The right index is independent; the defect is stale state relative to the left boundary.",
                "only_style": "The operations use different values after the index changes, so they are not algebraically interchangeable."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "order_window_state_updates",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "fixed_size_window",
              "problemArchetypeId": "fixed_length_aggregate"
            }
          },
          {
            "id": "alg-sw-order-frequency-expand-before-repair",
            "prompt": "Order the phases for a longest window with a frequency cap after a new right-boundary value arrives.",
            "constraints": [
              "The new value itself may create the violation.",
              "The answer is updated only for a legal window."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "increment_incoming",
                  "text": "Increment the incoming value's frequency in the maintained state."
                },
                {
                  "id": "detect_post_expand_violation",
                  "text": "Evaluate the validity predicate on the post-expansion state."
                },
                {
                  "id": "repair_left",
                  "text": "While invalid, decrement outgoing frequencies, remove zero-count keys as needed, and advance left."
                },
                {
                  "id": "update_answer",
                  "text": "Update the longest answer from the repaired window."
                }
              ],
              "canonicalOrder": [
                "increment_incoming",
                "detect_post_expand_violation",
                "repair_left",
                "update_answer"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The violation is defined by the state after the incoming frequency changes; repair and answer evaluation follow that state transition.",
              "details": "Checking validity before incrementing the incoming key only certifies the old range. The new occurrence may exceed a per-key cap or introduce a (K+1)th distinct value. Once state includes it, the predicate is meaningful. Repair then removes left contributions until legal, and the answer consumes that repaired state. The order generalizes the expand–repair–update template while making the state dependency explicit for frequencies. When the new value causes no violation, the repair phase performs zero removals, but the same phase order still leads to a valid answer update."
            },
            "taxonomy": {
              "primarySkillAtomId": "order_window_state_updates",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_constraint",
              "problemArchetypeId": "longest_valid_window"
            }
          }
