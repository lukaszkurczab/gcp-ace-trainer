                  "id": "state_result",
                  "text": "State exact, at-least, at-most, count, shortest, longest, or fixed-boundary semantics."
                },
                {
                  "id": "state_values",
                  "text": "State whether values are positive, nonnegative, or arbitrary signed."
                },
                {
                  "id": "state_workload",
                  "text": "State one sequential scan versus repeated interval queries."
