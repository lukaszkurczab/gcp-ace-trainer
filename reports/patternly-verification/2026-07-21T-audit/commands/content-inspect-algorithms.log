        "items": [
          {
            "id": "alg-complexity-time-001",
            "prompt": "A function performs one full scan of n elements followed by another full scan of n elements. What is the tight asymptotic time?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear",
                  "text": "O(n)."
                },
                {
                  "id": "quadratic",
                  "text": "O(n²)."
                },
                {
                  "id": "constant",
                  "text": "O(1)."
                },
                {
                  "id": "logarithmic",
                  "text": "O(log n)."
                }
              ],
              "acceptedOptionIds": [
                "linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sequential work is added: n + n = 2n.",
              "details": "Constant factors are dropped asymptotically, giving a linear bound.",
              "wrongOptionExplanationsByOptionId": {
                "quadratic": "Sequential phases add rather than multiply.",
                "constant": "Both scans grow with n.",
                "logarithmic": "No halving process is present."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-002",
            "prompt": "An outer loop runs n times and an inner loop runs n times for every outer iteration. What structure determines the time bound?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "product",
                  "text": "The iteration counts multiply, yielding n·n operations."
                },
                {
                  "id": "sum",
                  "text": "The counts add because the loops are written on separate lines."
                },
                {
                  "id": "names",
                  "text": "The variable names determine the bound."
                },
                {
                  "id": "constant",
                  "text": "The inner loop is constant because its body is small."
                }
              ],
              "acceptedOptionIds": [
                "product"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Nested independent loops multiply their iteration counts.",
              "details": "The executed body count is n², regardless of how short the body is.",
              "wrongOptionExplanationsByOptionId": {
                "sum": "The inner loop executes inside every outer iteration.",
                "names": "Names have no effect on execution count.",
                "constant": "A small body still repeats n² times."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-003",
            "prompt": "A nested loop has inner index j start at i and run to n - 1. Which conclusion is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "triangular_quadratic",
                  "text": "The total iterations form a triangular sum and are O(n²)."
                },
                {
                  "id": "always_linear",
                  "text": "The total is O(n) because j never restarts at zero."
                },
                {
                  "id": "always_cubic",
                  "text": "Any nested loop with changing bounds is O(n³)."
                },
                {
                  "id": "constant",
                  "text": "The shrinking inner loop makes total work constant."
                }
              ],
              "acceptedOptionIds": [
                "triangular_quadratic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The inner counts are n, n - 1, ..., 1.",
              "details": "Their sum is n(n + 1)/2, which is quadratic.",
              "wrongOptionExplanationsByOptionId": {
                "always_linear": "The sum n + (n-1) + ... + 1 is quadratic.",
                "always_cubic": "There are only two loop dimensions.",
                "constant": "The total still grows with n."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-004",
            "prompt": "A loop repeatedly divides a positive integer n by 2 until it reaches zero. What drives the iteration count?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "halving_log",
                  "text": "The number of times n can be halved, which is O(log n)."
                },
                {
                  "id": "numeric_n",
                  "text": "Exactly n iterations."
                },
                {
                  "id": "constant",
                  "text": "Exactly one iteration."
                },
                {
                  "id": "quadratic",
                  "text": "The division operator makes the loop O(n²)."
                }
              ],
              "acceptedOptionIds": [
                "halving_log"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "After k iterations, the remaining value is approximately n / 2^k.",
              "details": "The loop stops when 2^k reaches n, so k is logarithmic.",
              "wrongOptionExplanationsByOptionId": {
                "numeric_n": "The value shrinks multiplicatively, not by one.",
                "constant": "Inputs larger than one require multiple halvings.",
                "quadratic": "Operator choice does not determine the number of iterations."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-005",
            "prompt": "Two pointers each move only forward through an array, and neither pointer moves backward. Why can a nested while loop still be O(n)?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bounded_total_moves",
                  "text": "Across the whole run, each pointer advances at most n times."
                },
                {
                  "id": "nested_never_matters",
                  "text": "Nested loops are always linear."
                },
                {
                  "id": "pointer_names",
                  "text": "Variables named left and right imply O(n)."
                },
                {
                  "id": "constant_body",
                  "text": "The loop body is constant-time, so total time is constant."
                }
              ],
              "acceptedOptionIds": [
                "bounded_total_moves"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The relevant count is total pointer movement, not syntactic nesting.",
              "details": "If every iteration advances at least one monotonic pointer and each pointer crosses the array once, total iterations are linear.",
              "wrongOptionExplanationsByOptionId": {
                "nested_never_matters": "Nested loops can be quadratic when inner work resets.",
                "pointer_names": "Names do not determine complexity.",
                "constant_body": "The body still executes multiple times."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-time-006",
            "prompt": "A loop may break on the first element, but in the worst case it scans all n elements. What is the worst-case time?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear",
                  "text": "O(n)."
                },
                {
                  "id": "constant",
                  "text": "O(1) because an early break exists."
                },
                {
                  "id": "logarithmic",
                  "text": "O(log n) because the loop can stop early."
                },
                {
                  "id": "quadratic",
                  "text": "O(n²) because there are two outcomes."
                }
              ],
              "acceptedOptionIds": [
                "linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Worst-case time uses the execution path with the most work among valid inputs of size n.",
              "details": "The possibility of an early exit affects best case, not the worst-case upper bound.",
              "wrongOptionExplanationsByOptionId": {
                "constant": "Worst-case analysis uses an input that delays the break.",
                "logarithmic": "Early termination alone does not imply halving.",
                "quadratic": "Outcome count is unrelated."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-007",
            "prompt": "A function sorts n values and then scans them once. Which term dominates the total time under comparison sorting?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "n_log_n",
                  "text": "O(n log n)."
                },
                {
                  "id": "linear",
                  "text": "O(n) because the final scan is visible in the return path."
                },
                {
                  "id": "sum_as_product",
                  "text": "O(n² log n) because phases multiply."
                },
                {
                  "id": "constant",
                  "text": "O(1) because sorting is a library call."
                }
              ],
              "acceptedOptionIds": [
                "n_log_n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The total is O(n log n + n).",
              "details": "The larger n log n term dominates asymptotically.",
              "wrongOptionExplanationsByOptionId": {
                "linear": "The sort is asymptotically larger.",
                "sum_as_product": "Sequential phases add.",
                "constant": "Library calls still execute work."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-time-008",
            "prompt": "Why is the statement \"the loop variable is named i, so the loop is O(n)\" invalid?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "executed_operations",
                  "text": "Complexity follows the loop's update rule, bounds, and work, not the variable name."
                },
                {
                  "id": "i_reserved",
                  "text": "The name i is reserved for logarithmic loops."
                },
                {
                  "id": "all_loops_linear",
                  "text": "Every loop is O(n) regardless of its header."
                },
                {
                  "id": "names_affect_cpu",
                  "text": "Longer variable names increase the iteration count."
                }
              ],
              "acceptedOptionIds": [
                "executed_operations"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A variable named i may increment by one, double, reset, or depend on another pointer.",
              "details": "The bound must be derived from how many operations execute.",
              "wrongOptionExplanationsByOptionId": {
                "i_reserved": "No naming convention determines Big-O.",
                "all_loops_linear": "Loops can be constant, logarithmic, quadratic, or other.",
                "names_affect_cpu": "Names do not alter the algorithm's execution model."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-time-009",
            "prompt": "Which rules are valid when combining time costs? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sequential_add",
                  "text": "Sequential phases add their costs."
                },
                {
                  "id": "nested_multiply",
                  "text": "Independent nested iteration counts multiply."
                },
                {
                  "id": "dominant_term",
                  "text": "Lower-order terms and constant factors can be dropped for asymptotic classification."
                },
                {
                  "id": "variable_names",
                  "text": "Variable names determine which term dominates."
                }
              ],
              "acceptedOptionIds": [
                "sequential_add",
                "nested_multiply",
                "dominant_term"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Time derivation follows composition of executed work.",
              "details": "Syntactic labels do not replace counting.",
              "wrongOptionExplanationsByOptionId": {
                "variable_names": "Names do not encode operation counts."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sequential_add": "All phases execute one after another.",
                "nested_multiply": "The inner work repeats for each outer iteration.",
                "dominant_term": "They do not change growth class."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-010",
            "prompt": "Which loop patterns can be O(n) despite containing nested syntax? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "two_pointer",
                  "text": "An inner pointer advances monotonically and never resets across outer iterations."
                },
                {
                  "id": "disjoint_work",
                  "text": "Each input element is processed by the inner body at most a constant number of times overall."
                },
                {
                  "id": "reset_full_scan",
                  "text": "The inner loop scans all n elements from the beginning for every outer iteration."
                },
                {
                  "id": "shrinking_stack",
                  "text": "Each item is pushed once and popped once across all iterations."
                }
              ],
              "acceptedOptionIds": [
                "two_pointer",
                "disjoint_work",
                "shrinking_stack"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Nested syntax does not force quadratic execution.",
              "details": "The decisive question is how often each unit of input work can occur over the full run.",
              "wrongOptionExplanationsByOptionId": {
                "reset_full_scan": "That performs n² work."
              },
              "omittedCorrectExplanationsByOptionId": {
                "two_pointer": "Total pointer movement is bounded.",
                "disjoint_work": "Aggregate work remains linear.",
                "shrinking_stack": "Total stack operations are linear."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-time-011",
            "prompt": "Which facts are needed to derive a recursive time bound? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "subproblem_count",
                  "text": "How many recursive subproblems each call creates."
                },
                {
                  "id": "subproblem_size",
                  "text": "How the input size changes in each child."
                },
                {
                  "id": "local_work",
                  "text": "How much nonrecursive work one call performs."
                },
                {
                  "id": "function_name",
                  "text": "Whether the function is named solve or dfs."
                }
              ],
              "acceptedOptionIds": [
                "subproblem_count",
                "subproblem_size",
                "local_work"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A recurrence summarizes child structure and work per call.",
              "details": "Without all three, the total executed operations cannot be justified.",
              "wrongOptionExplanationsByOptionId": {
                "function_name": "Names do not determine recurrence."
              },
              "omittedCorrectExplanationsByOptionId": {
                "subproblem_count": "Branch count determines expansion.",
                "subproblem_size": "Depth and total nodes depend on shrinkage.",
                "local_work": "Per-node cost must be included."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-012",
            "prompt": "Which analyses correctly distinguish best, average, amortized, and worst case? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "worst_max",
                  "text": "Worst case considers the maximum work over inputs of a given size."
                },
                {
                  "id": "best_min",
                  "text": "Best case considers the minimum work over inputs of a given size."
                },
                {
                  "id": "average_distribution",
                  "text": "Average case requires an input distribution or probability model."
                },
                {
                  "id": "amortized_distribution",
                  "text": "Amortized analysis is the same as expected time under random inputs."
                }
              ],
              "acceptedOptionIds": [
                "worst_max",
                "best_min",
                "average_distribution"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Different complexity labels answer different questions.",
              "details": "Amortized analysis belongs to sequence accounting and should not be substituted for probabilistic average case.",
              "wrongOptionExplanationsByOptionId": {
                "amortized_distribution": "Amortized bounds can be deterministic over every operation sequence."
              },
              "omittedCorrectExplanationsByOptionId": {
                "worst_max": "It bounds the most expensive valid execution.",
                "best_min": "Early exits may matter here.",
                "average_distribution": "An expectation needs a model."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-time-013",
            "prompt": "Arrange the process for deriving time complexity from code.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "identify_input",
                  "text": "Define the input-size variables and cost model."
                },
                {
                  "id": "count_structures",
                  "text": "Count iterations, recursive calls, and work per operation."
                },
                {
                  "id": "compose",
                  "text": "Add sequential costs and multiply repeated nested costs where justified."
                },
                {
                  "id": "simplify",
                  "text": "Keep the dominant asymptotic term and state the case being analyzed."
                }
              ],
              "canonicalOrder": [
                "identify_input",
                "count_structures",
                "compose",
                "simplify"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A defensible bound begins with explicit inputs and ends with a simplified execution count.",
              "details": "Skipping directly to a familiar loop shape invites heuristic errors."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-014",
            "prompt": "Arrange the reasoning for a monotonic two-pointer loop.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "define_moves",
                  "text": "Identify which pointer movements can occur."
                },
                {
                  "id": "bound_each",
                  "text": "Show each pointer advances at most n positions."
                },
                {
                  "id": "sum_moves",
                  "text": "Add the total advances across the entire run."
                },
                {
                  "id": "conclude_linear",
                  "text": "Conclude O(n) iterations when each iteration advances a pointer."
                }
              ],
              "canonicalOrder": [
                "define_moves",
                "bound_each",
                "sum_moves",
                "conclude_linear"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Aggregate movement, not loop nesting, determines the bound.",
              "details": "A pointer that never retreats cannot cause repeated full rescans."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-time-015",
            "prompt": "Arrange the analysis of a divide-and-conquer algorithm with two half-size calls and O(n) merge work.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "write_recurrence",
                  "text": "Write T(n) = 2T(n/2) + O(n)."
                },
                {
                  "id": "count_levels",
                  "text": "Observe that recursion has O(log n) levels."
                },
                {
                  "id": "work_per_level",
                  "text": "Show the total merge work per level is O(n)."
                },
                {
                  "id": "multiply_levels",
                  "text": "Conclude O(n log n) total time."
                }
              ],
              "canonicalOrder": [
                "write_recurrence",
                "count_levels",
                "work_per_level",
                "multiply_levels"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The branching doubles while subproblem sizes halve, keeping each level's combined work linear.",
              "details": "Linear work repeated across logarithmically many levels gives n log n."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-016",
            "prompt": "Arrange the simplification of O(n² + 3n log n + 7n + 500).",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "drop_constants",
                  "text": "Ignore constant multiplicative factors."
                },
                {
                  "id": "compare_growth",
                  "text": "Compare n², n log n, n, and 1."
                },
                {
                  "id": "select_dominant",
                  "text": "Identify n² as the fastest-growing term."
                },
                {
                  "id": "report",
                  "text": "Report O(n²)."
                }
              ],
              "canonicalOrder": [
                "drop_constants",
                "compare_growth",
                "select_dominant",
                "report"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Asymptotic simplification preserves the term that dominates for large n.",
              "details": "The discarded terms may matter in practice but do not change the growth class."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_time_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-time-017",
            "prompt": "A loop executes once for each of n elements and performs O(1) work per iteration. Select time complexity.",
            "constraints": [
              "The loop always completes all n iterations."
