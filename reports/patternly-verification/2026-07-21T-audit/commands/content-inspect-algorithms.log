              "id": "state_meaning",
              "text": "State exactly what f(state) returns for every valid state."
            },
            {
              "id": "terminal_states",
              "text": "Identify all terminal states in the declared input domain."
            },
            {
              "id": "terminal_returns",
              "text": "Assign terminal return values that satisfy the stated meaning."
            },
            {
              "id": "recursive_assumption",
              "text": "Assume each strictly smaller call returns that same meaning for its own state."
            },
            {
              "id": "current_result",
              "text": "Use those returned values to produce the current state's promised result."
            }
          ],
          "canonicalOrder": [
            "state_meaning",
            "terminal_states",
            "terminal_returns",
            "recursive_assumption",
            "current_result"
          ],
          "scoringMethod": "adjacent_relations"
        },
        "scoringContract": {
          "type": "ordering",
          "maxPoints": 4
