        "items": [
          {
            "id": "alg-sort-two-pointers-01-pair-sum-signal",
            "prompt": "An unsorted integer array must answer whether two distinct elements sum to target T. The array may be reordered and only existence is required. Which strategy uses sorting to create a valid directional search?",
            "constraints": [
              "Any valid pair of distinct occurrences is acceptable.",
              "Integer addition uses a sufficiently wide type for the input bounds."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_scan_adjacent_only",
                  "text": "Sort ascending and test only adjacent pairs."
                },
                {
                  "id": "sort_opposite_ends",
                  "text": "Sort ascending, place one pointer at each end, and move the side that can change the sum toward T."
                },
                {
                  "id": "preserve_order_ends",
                  "text": "Keep the unsorted order and use the first and last positions as monotone boundaries."
                },
                {
                  "id": "sort_move_both",
                  "text": "Sort ascending and move both pointers inward after every comparison, regardless of the sum."
                }
              ],
              "acceptedOptionIds": [
                "sort_opposite_ends"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Numeric sorting makes the pair sum monotone in each pointer, which justifies discarding one boundary after each comparison.",
              "details": "With left < right, a sum below T cannot be repaired by replacing right with a smaller value, so advancing left is safe. A sum above T cannot be repaired by replacing left with a larger value, so decrementing right is safe. The sorted order supplies this proof. Moving both pointers can discard a valid partner, and adjacency alone is not sufficient for an arbitrary target sum.",
              "wrongOptionExplanationsByOptionId": {
                "sort_move_both": "Changing both boundaries can skip a pair that reuses one current endpoint with a different partner.",
                "sort_scan_adjacent_only": "A target-sum pair can be far apart in sorted order and need not have an adjacent witness.",
                "preserve_order_ends": "Unsorted boundary values provide no monotone relation between pointer movement and the resulting sum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "combine_sorting_with_pointer_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sort_then_two_pointers",
              "problemArchetypeId": "pair_search_after_sort"
            }
          },
          {
            "id": "alg-sort-two-pointers-02-directional-movement-order",
            "prompt": "Order one complete iteration of a sorted two-pointer pair-sum search after left and right have been initialized.",
            "constraints": [
              "The array is sorted ascending.",
              "The loop condition is left < right."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "recheck_bounds",
                  "text": "Re-evaluate left < right before the next iteration."
                },
                {
                  "id": "compare_target",
                  "text": "Compare the sum with T."
                },
                {
                  "id": "return_or_move",
                  "text": "Return on equality; otherwise move left for a small sum or right for a large sum."
                },
                {
                  "id": "compute_wide_sum",
                  "text": "Compute values[left] + values[right] in a type wide enough for the bounds."
                }
              ],
              "canonicalOrder": [
                "compute_wide_sum",
                "compare_target",
                "return_or_move",
                "recheck_bounds"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The movement decision depends on the current wide sum, and the distinct-occurrence boundary must be checked again after movement.",
              "details": "The algorithm maintains the invariant that every unexamined candidate lies within the current closed pointer interval. The current endpoint sum determines which entire boundary row or column is impossible. Movement occurs only after that comparison. Rechecking left < right prevents using one occurrence twice. Computing in a wider type belongs before the comparison because overflow could reverse the apparent ordering relation."
            },
            "taxonomy": {
              "primarySkillAtomId": "combine_sorting_with_pointer_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sort_then_two_pointers",
