        "items": [
          {
            "id": "alg-contrast-hash-sort-order-001",
            "prompt": "A two-sum result must return original array indices. Which hash-based design preserves that contract directly?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_index",
                  "text": "Scan in original order and map each seen value to the required original index metadata."
                },
                {
                  "id": "hash_values_only",
                  "text": "Store only a boolean that the value exists."
                },
                {
                  "id": "sort_values_only",
                  "text": "Sort values in place and return sorted positions as original indices."
                },
                {
                  "id": "ignore_indices",
                  "text": "Return the pair values instead."
                }
              ],
              "acceptedOptionIds": [
                "hash_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A hash table can associate equality keys with original-position metadata while the scan preserves index identity.",
              "details": "The stored index policy must also handle duplicates according to the required pair contract.",
              "wrongOptionExplanationsByOptionId": {
                "hash_values_only": "Existence alone cannot reconstruct the requested index.",
                "sort_values_only": "Sorted positions are not original positions.",
                "ignore_indices": "That changes the result contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-002",
            "prompt": "Why does sorting values alone generally lose original-index information?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "positions_change",
                  "text": "Reordering changes each value's current position, and no mapping back is retained."
                },
                {
                  "id": "values_change",
                  "text": "Sorting changes every numeric value."
                },
                {
                  "id": "indices_deleted",
                  "text": "Arrays cease to have indices after sorting."
                },
                {
                  "id": "hash_required",
                  "text": "Only hash tables can ever store indices."
                }
              ],
              "acceptedOptionIds": [
                "positions_change"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Original identity is not recoverable from a reordered value sequence when equal values or repeated positions are possible.",
              "details": "A sorting path must carry original indices or have another explicit reconstruction source.",
              "wrongOptionExplanationsByOptionId": {
                "values_change": "Sorting reorders values but does not alter their values.",
                "indices_deleted": "They still have indices, but those are sorted positions.",
                "hash_required": "Sorting decorated records can also preserve them."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-003",
            "prompt": "What does a stable sort guarantee about equal-key records?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "relative_equal_order",
                  "text": "Their relative input order is preserved in the sorted output."
                },
                {
                  "id": "original_positions",
                  "text": "Each record remains at its original absolute index."
                },
                {
                  "id": "ascending_indices",
                  "text": "Original indices become numerically sorted regardless of input."
                },
                {
                  "id": "no_memory",
                  "text": "The implementation uses no auxiliary memory."
                }
              ],
              "acceptedOptionIds": [
                "relative_equal_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Stability is a relative-order guarantee inside equal-key groups.",
              "details": "It does not by itself retain absolute original indices or prevent mutation.",
              "wrongOptionExplanationsByOptionId": {
                "original_positions": "Stable sorting still moves records across unequal keys.",
                "ascending_indices": "Stability only preserves relative order among equal keys.",
                "no_memory": "Stability does not define the memory algorithm."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-004",
            "prompt": "Counts must be emitted in first-seen key order. Which design most directly preserves that order?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_first_seen",
                  "text": "Use a map for counts plus explicit first-seen ordering metadata or an insertion-order contract."
                },
                {
                  "id": "sort_keys",
                  "text": "Sort keys ascending and call that first-seen order."
                },
                {
                  "id": "hash_arbitrary",
                  "text": "Rely on unspecified hash iteration order."
                },
                {
                  "id": "sort_unstable",
                  "text": "Use an unstable value sort."
                }
              ],
              "acceptedOptionIds": [
                "hash_first_seen"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "First-seen order is derived from the original scan.",
              "details": "The map handles equality state, while a documented ordering mechanism preserves emission order.",
              "wrongOptionExplanationsByOptionId": {
                "sort_keys": "Value order and first-seen order are different.",
                "hash_arbitrary": "Unspecified iteration is not a first-seen guarantee.",
                "sort_unstable": "The output order still follows key value, not first occurrence."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-005",
            "prompt": "A report must be sorted by value but also include every record's original index. Which sorting design is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "decorate_sort",
                  "text": "Sort records containing both value and original index."
                },
                {
                  "id": "sort_values_only",
                  "text": "Sort only values and guess indices afterward."
                },
                {
                  "id": "hash_no_order",
                  "text": "Store values in an unordered set."
                },
                {
                  "id": "discard_duplicates",
                  "text": "Keep one index per distinct value."
                }
              ],
              "acceptedOptionIds": [
                "decorate_sort"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Decoration carries identity through the reorder.",
              "details": "The sort key can remain the value while original index is retained as payload or a tie-breaker when required.",
              "wrongOptionExplanationsByOptionId": {
                "sort_values_only": "Duplicates and reorderings make the mapping ambiguous.",
                "hash_no_order": "The report requires sorted records and every occurrence.",
                "discard_duplicates": "The contract asks for every record."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-006",
            "prompt": "Why is ordinary hash-table iteration not a general substitute for original input order?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "iteration_contract",
                  "text": "Bucket or implementation order may differ from arrival order unless an explicit ordered-map contract is used."
                },
                {
                  "id": "hash_sort",
                  "text": "Hashing automatically sorts by key."
                },
                {
                  "id": "input_mutated",
                  "text": "Building a hash table necessarily reorders the input array."
                },
                {
                  "id": "indices_absent",
                  "text": "Hash tables cannot store index metadata."
                }
              ],
              "acceptedOptionIds": [
                "iteration_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Preserving input order requires an explicit sequence or an ordered insertion contract.",
              "details": "Correctness cannot depend on incidental bucket layout.",
              "wrongOptionExplanationsByOptionId": {
                "hash_sort": "A conventional hash table does not impose value order.",
                "input_mutated": "The input can remain unchanged.",
                "indices_absent": "They can store arbitrary associated values."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-007",
            "prompt": "The original array must remain available in its initial order, but later logic also needs sorted traversal. Which strategy is legal?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_copy",
                  "text": "Sort a copy or decorated secondary representation and retain the original."
                },
                {
                  "id": "sort_original",
                  "text": "Sort the original in place and assume callers do not notice."
                },
                {
                  "id": "hash_only",
                  "text": "Use a hash table and claim it provides sorted traversal."
                },
                {
                  "id": "discard_original",
                  "text": "Replace the original with sorted output."
                }
              ],
              "acceptedOptionIds": [
                "sort_copy"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Preservation and ordering can coexist through separate representations.",
              "details": "The O(n) copy or decoration cost must be included in memory and preprocessing analysis.",
              "wrongOptionExplanationsByOptionId": {
                "sort_original": "That violates the preservation contract.",
                "hash_only": "A plain hash table does not provide value order.",
                "discard_original": "The initial order is required later."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-008",
            "prompt": "A later consumer expects the same input-object order after the function returns. What does this imply for in-place sorting?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "illegal_unless_restored_contract",
                  "text": "It is illegal unless the contract explicitly permits mutation and restoration is safely unobservable."
                },
                {
                  "id": "always_legal",
                  "text": "The final answer matters, so input order never matters."
                },
                {
                  "id": "hash_forbidden",
                  "text": "A hash-based scan is also necessarily illegal."
                },
                {
                  "id": "stable_enough",
                  "text": "A stable sort preserves the complete original order."
                }
              ],
              "acceptedOptionIds": [
                "illegal_unless_restored_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Input postconditions constrain strategy choice.",
              "details": "Even temporary mutation can be unsafe with aliases, callbacks, concurrency, or exceptions.",
              "wrongOptionExplanationsByOptionId": {
                "always_legal": "The caller's observable state is part of correctness.",
                "hash_forbidden": "Hashing can leave the input untouched.",
                "stable_enough": "Stability preserves only equal-key relative order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-009",
            "prompt": "A pair-sum task accepts reordering internally but must return original indices. Which conclusion is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_with_metadata",
                  "text": "Hashing can store indices; sorting can also work if records are decorated with original indices."
                },
                {
                  "id": "hash_only",
                  "text": "Only hashing can preserve original indices."
                },
                {
                  "id": "sort_values_only",
                  "text": "Plain value sorting is sufficient regardless of duplicates."
                },
                {
                  "id": "indices_irrelevant",
                  "text": "Returning values is equivalent to returning indices."
                }
              ],
              "acceptedOptionIds": [
                "both_with_metadata"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Both families can be correct when identity metadata is carried explicitly.",
              "details": "The strategy comparison then includes expected time, sorting cost, auxiliary metadata, mutation, and duplicate handling.",
              "wrongOptionExplanationsByOptionId": {
                "hash_only": "Sorting decorated records preserves them too.",
                "sort_values_only": "Original identity would be lost.",
                "indices_irrelevant": "The output contract distinguishes them."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-010",
            "prompt": "Equal-key records must retain their input order inside each output group, but groups themselves must be ordered by key. Which sorting property is required?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "stable_sort",
                  "text": "A stable sort by the grouping key, or an explicit original-index tie rule."
                },
                {
                  "id": "unstable_any",
                  "text": "Any unstable sort because equal values are interchangeable."
                },
                {
                  "id": "hash_arbitrary",
                  "text": "An unordered hash map without per-group sequences."
                },
                {
                  "id": "deduplicate",
                  "text": "Remove repeated records."
                }
              ],
              "acceptedOptionIds": [
                "stable_sort"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The output combines key order with stable identity inside groups.",
              "details": "A hash design could also retain per-key sequences and later sort keys, but the ordering mechanisms must be explicit.",
              "wrongOptionExplanationsByOptionId": {
                "unstable_any": "The contract says equal-key record order is observable.",
                "hash_arbitrary": "It does not guarantee group or within-group order.",
                "deduplicate": "Every record remains required."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-011",
            "prompt": "Which requirements force a strategy to retain original-position metadata? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "return_indices",
                  "text": "Return original indices."
                },
                {
                  "id": "first_occurrence",
                  "text": "Return the first original occurrence of each value."
                },
                {
                  "id": "stable_equal_records",
                  "text": "Preserve equal-record input order after key sorting."
                },
                {
                  "id": "distinct_count_only",
                  "text": "Return only the number of distinct values."
                }
              ],
              "acceptedOptionIds": [
                "return_indices",
                "first_occurrence",
                "stable_equal_records"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Position-sensitive outputs need a mapping from transformed state back to the input sequence.",
              "details": "A scalar distinct count does not.",
              "wrongOptionExplanationsByOptionId": {
                "distinct_count_only": "No original position is required."
              },
              "omittedCorrectExplanationsByOptionId": {
                "return_indices": "Reordering alone cannot reconstruct them reliably.",
                "first_occurrence": "The first position must be stored or derived from the original scan.",
                "stable_equal_records": "Original sequence determines the tie order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-012",
            "prompt": "Which designs preserve original input order while still supporting derived lookup or ordering? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "hash_scan",
                  "text": "Scan without mutation and store lookup metadata."
                },
                {
                  "id": "sort_copy",
                  "text": "Sort an independent copy."
                },
                {
                  "id": "decorated_secondary",
                  "text": "Build and sort decorated secondary records."
                },
                {
                  "id": "in_place_exposed",
                  "text": "Sort the shared original object in place and expose it as unchanged."
                }
              ],
              "acceptedOptionIds": [
                "hash_scan",
                "sort_copy",
                "decorated_secondary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Preservation can be achieved by non-mutating hash state or separate ordered representations.",
              "details": "Each alternative has a different memory cost.",
              "wrongOptionExplanationsByOptionId": {
                "in_place_exposed": "Its observable order differs."
              },
              "omittedCorrectExplanationsByOptionId": {
                "hash_scan": "The original sequence remains intact.",
                "sort_copy": "The original remains unchanged.",
                "decorated_secondary": "Identity and original sequence remain available."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-013",
            "prompt": "Which statements about stable sorting are correct? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "equal_relative",
                  "text": "It preserves relative order among records with equal sort keys."
                },
                {
                  "id": "not_absolute",
                  "text": "It does not preserve every record's absolute original index."
                },
                {
                  "id": "can_support_first_seen_ties",
                  "text": "It can preserve first-seen order within equal-key groups."
                },
                {
                  "id": "always_in_place",
                  "text": "Every stable sort is in-place with O(1) auxiliary space."
                }
              ],
              "acceptedOptionIds": [
                "equal_relative",
                "not_absolute",
                "can_support_first_seen_ties"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Stability is a local equal-key ordering contract.",
              "details": "Mutation and auxiliary-space behavior depend on the implementation.",
              "wrongOptionExplanationsByOptionId": {
                "always_in_place": "Stability does not imply one memory profile."
              },
              "omittedCorrectExplanationsByOptionId": {
                "equal_relative": "This is the definition of stability.",
                "not_absolute": "Records still move across unequal keys.",
                "can_support_first_seen_ties": "Input order becomes the tie order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-014",
            "prompt": "Which hash-based metadata can preserve positional contracts? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "first_index",
                  "text": "Store the first original index per key."
                },
                {
                  "id": "all_indices",
                  "text": "Store a list of original indices per key."
                },
                {
                  "id": "first_seen_sequence",
                  "text": "Maintain a sequence of keys when they first appear."
                },
                {
                  "id": "bucket_position",
                  "text": "Treat internal bucket position as the original index."
                }
              ],
              "acceptedOptionIds": [
                "first_index",
                "all_indices",
                "first_seen_sequence"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A hash table can preserve order and indices only by storing the required metadata explicitly.",
              "details": "Internal table placement is not semantic data.",
              "wrongOptionExplanationsByOptionId": {
                "bucket_position": "Bucket layout is unrelated to input position."
              },
              "omittedCorrectExplanationsByOptionId": {
                "first_index": "This supports first-occurrence results.",
                "all_indices": "This preserves every occurrence position.",
                "first_seen_sequence": "This supports first-seen group order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-015",
            "prompt": "Which input shapes expose lost order or index identity after a strategy change? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "duplicates",
                  "text": "Equal values at multiple original indices."
                },
                {
                  "id": "already_sorted",
                  "text": "Input already sorted but original indices still required."
                },
                {
                  "id": "reverse_order",
                  "text": "Input order opposite to value order."
                },
                {
                  "id": "only_unique_mid",
                  "text": "Only unique values already centered near final positions."
                }
              ],
              "acceptedOptionIds": [
                "duplicates",
                "already_sorted",
                "reverse_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Identity-sensitive review must include equal values and substantial reordering.",
              "details": "Easy unique cases can make a broken values-only sort appear correct.",
              "wrongOptionExplanationsByOptionId": {
                "only_unique_mid": "This hides duplicate and movement defects."
              },
              "omittedCorrectExplanationsByOptionId": {
                "duplicates": "They expose ambiguous reconstruction.",
                "already_sorted": "Value order alone does not remove identity requirements.",
                "reverse_order": "It maximizes reordering and tests restoration."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-016",
            "prompt": "Arrange a hash workflow for counts in first-seen order.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "scan",
                  "text": "Scan keys in original order."
                },
                {
                  "id": "first_seen",
                  "text": "On a key's first occurrence, append it to an order list and initialize its entry."
                },
                {
                  "id": "update_count",
                  "text": "Increment the key's count for every occurrence."
                },
                {
                  "id": "emit",
                  "text": "Traverse the first-seen order list and read counts from the map."
                }
              ],
              "canonicalOrder": [
                "scan",
                "first_seen",
                "update_count",
                "emit"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The map stores equality state while a separate sequence stores the required order.",
              "details": "Emission does not depend on incidental hash iteration."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-017",
            "prompt": "Arrange a decorate-sort-recover workflow.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "decorate",
                  "text": "Pair every value with its original index and any required tie metadata."
                },
                {
                  "id": "sort",
                  "text": "Sort decorated records by the declared value key and tie rule."
                },
                {
                  "id": "consume",
                  "text": "Perform the ordered algorithm on decorated records."
                },
                {
                  "id": "recover",
                  "text": "Return original indices or reconstruct the required original-position result."
                }
              ],
              "canonicalOrder": [
                "decorate",
                "sort",
                "consume",
                "recover"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Decoration preserves identity through reordering.",
              "details": "The metadata's time and space are part of the sorting strategy."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-018",
            "prompt": "Arrange the decision process for order and index preservation.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_observables",
                  "text": "State whether original input order, first-seen order, stable ties, or original indices are observable."
                },
                {
                  "id": "identify_metadata",
                  "text": "Determine the minimum metadata needed under hashing and sorting."
                },
                {
                  "id": "check_mutation",
                  "text": "Check whether the original representation may be reordered."
                },
                {
                  "id": "compare_complete",
                  "text": "Compare only complete strategies that preserve every required observable."
                }
              ],
              "canonicalOrder": [
                "state_observables",
                "identify_metadata",
                "check_mutation",
                "compare_complete"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Identity and ordering constraints are correctness conditions.",
              "details": "Asymptotic comparison comes after both candidates include the metadata they need."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-order-019",
            "prompt": "Scan n hashable values and store a list of every original index under its key. Select expected time and total stored index space.",
            "constraints": [
              "Expected hash update is O(1).",
              "Every input index is stored exactly once."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
