        "items": [
          {
            "id": "alg-contrast-window-prefix-space-001",
            "prompt": "A one-pass fixed-size sum window stores only boundaries and the current sum. What is its typical auxiliary-space advantage over a full prefix array?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "constant_vs_linear",
                  "text": "O(1) moving state instead of O(n) cumulative storage."
                },
                {
                  "id": "zero_vs_constant",
                  "text": "Zero storage instead of O(1)."
                },
                {
                  "id": "linear_vs_constant",
                  "text": "O(n) moving state instead of O(1) prefix state."
                },
                {
                  "id": "same_always",
                  "text": "Both representations always use the same space."
                }
              ],
              "acceptedOptionIds": [
                "constant_vs_linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A rolling aggregate retains only information for the current interval.",
              "details": "A prefix array retains one cumulative value per boundary to support later random access.",
              "wrongOptionExplanationsByOptionId": {
                "zero_vs_constant": "The window still stores aggregate and boundary state.",
                "linear_vs_constant": "The comparison is reversed.",
                "same_always": "Their retained state differs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-002",
            "prompt": "Why does a prefix array normally require O(n) auxiliary space?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_per_boundary",
                  "text": "It stores cumulative state for n + 1 interval boundaries."
                },
                {
                  "id": "query_count",
                  "text": "It stores one value per future query."
                },
                {
                  "id": "window_width",
                  "text": "It stores exactly k values for any query width."
                },
                {
                  "id": "sort_buffer",
                  "text": "It is a sorting buffer."
                }
              ],
              "acceptedOptionIds": [
                "one_per_boundary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The representation supports any later [l, r] by retaining cumulative information at every boundary.",
              "details": "That reuse is purchased with linear storage.",
              "wrongOptionExplanationsByOptionId": {
                "query_count": "Its size is tied to input boundaries, not q.",
                "window_width": "A prefix array covers the whole input.",
                "sort_buffer": "No sorting is required."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-003",
            "prompt": "A prefix-hash exact-sum algorithm stores up to one entry per distinct cumulative value. What is its worst-case auxiliary space?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear",
                  "text": "O(n)."
                },
                {
                  "id": "constant",
                  "text": "O(1)."
                },
                {
                  "id": "quadratic",
                  "text": "O(n²)."
                },
                {
                  "id": "logarithmic",
                  "text": "O(log n)."
                }
              ],
              "acceptedOptionIds": [
                "linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Historical lookup requires retaining cumulative values from earlier boundaries.",
              "details": "The worst case has a distinct prefix at every step.",
              "wrongOptionExplanationsByOptionId": {
                "constant": "Every prefix may be distinct.",
                "quadratic": "Only n + 1 prefix boundaries are produced.",
                "logarithmic": "No balancing invariant limits the number of keys."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-004",
            "prompt": "Why is the claim \"sliding windows always use O(1) space\" false?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "state_can_grow",
                  "text": "Some windows maintain frequency maps, deques, or other state whose size grows with the window or distinct values."
                },
                {
                  "id": "boundaries_linear",
                  "text": "Two indices themselves use O(n) space."
                },
                {
                  "id": "sum_array",
                  "text": "Every window requires a prefix array."
                },
                {
                  "id": "time_space_same",
                  "text": "Any O(n) time algorithm uses O(n) space."
                }
              ],
              "acceptedOptionIds": [
                "state_can_grow"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sliding window describes boundary movement, not a universal payload size.",
              "details": "A sum window may be constant-space, while a distinct-element or monotonic-window variant can retain O(n) state.",
              "wrongOptionExplanationsByOptionId": {
                "boundaries_linear": "A fixed number of indices is O(1).",
                "sum_array": "Simple windows do not.",
                "time_space_same": "Time and space are separate dimensions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-005",
            "prompt": "A shortest-subarray-at-least-k solution for arbitrary signed values uses prefix sums and a monotonic deque of prefix indices. What peak auxiliary-space bound is possible?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear",
                  "text": "O(n)."
                },
                {
                  "id": "constant",
                  "text": "O(1)."
                },
                {
                  "id": "quadratic",
                  "text": "O(n²)."
                },
                {
                  "id": "output_only",
                  "text": "No auxiliary space because the answer is one length."
                }
              ],
              "acceptedOptionIds": [
                "linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The prefix sequence and deque can each contain O(n) entries.",
              "details": "The result may be scalar while the algorithm's working state is linear.",
              "wrongOptionExplanationsByOptionId": {
                "constant": "The deque may retain many candidate boundaries.",
                "quadratic": "There are only O(n) prefix boundaries.",
                "output_only": "Working state is distinct from output."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-006",
            "prompt": "The result must materialize all m requested interval sums. How should their storage be classified?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "output_space",
                  "text": "O(m) required output space, separate from auxiliary working space."
                },
                {
                  "id": "auxiliary_only",
                  "text": "It is always auxiliary space and should be hidden."
                },
                {
                  "id": "input_space",
                  "text": "It belongs to the original input array."
                },
                {
                  "id": "constant",
                  "text": "A scalar sum means all m outputs fit in O(1)."
                }
              ],
              "acceptedOptionIds": [
                "output_space"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Space analysis should distinguish required results from temporary state.",
              "details": "A streaming API could reduce retained output, but that is a different output contract.",
              "wrongOptionExplanationsByOptionId": {
                "auxiliary_only": "The caller explicitly requires the results.",
                "input_space": "The results are newly produced.",
                "constant": "Materializing m scalars uses linear output space in m."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-007",
            "prompt": "A prefix array is built in a wider numeric type to avoid overflow. What changes asymptotically under a fixed-width machine model?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "same_asymptotic",
                  "text": "The auxiliary space remains O(n), although each entry may use a larger constant number of bytes."
                },
                {
                  "id": "becomes_quadratic",
                  "text": "Wider values make the array O(n²)."
                },
                {
                  "id": "becomes_constant",
                  "text": "A safer type removes the need to store entries."
                },
                {
                  "id": "window_required",
                  "text": "Overflow safety forces a sliding window."
                }
              ],
              "acceptedOptionIds": [
                "same_asymptotic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Asymptotic space counts how stored state grows with n.",
              "details": "Numeric-width safety can materially affect constants and correctness without changing O(n) under a fixed-word model.",
              "wrongOptionExplanationsByOptionId": {
                "becomes_quadratic": "A constant-size wider word changes only the constant factor.",
                "becomes_constant": "All boundaries are still retained.",
                "window_required": "Both approaches need an adequate numeric type."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-008",
            "prompt": "The data is immutable and many range queries must be answered, but O(n) auxiliary memory is forbidden. Which conclusion is safest?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "tradeoff_explicit",
                  "text": "Prefix preprocessing may be unavailable; use direct scans, a compressed/domain-specific representation, or change the resource contract."
                },
                {
                  "id": "prefix_free",
                  "text": "A full prefix array has no memory cost because it is preprocessing."
                },
                {
                  "id": "window_random_o1",
                  "text": "One rolling sum answers all arbitrary ranges in O(1)."
                },
                {
                  "id": "ignore_memory",
                  "text": "Time complexity always overrides a hard memory cap."
                }
              ],
              "acceptedOptionIds": [
                "tradeoff_explicit"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A time optimization is not legal if its required state exceeds the memory budget.",
              "details": "The correct response is to expose the tradeoff rather than claim a free representation.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_free": "Preprocessing state remains live auxiliary memory.",
                "window_random_o1": "A moving state represents only one current interval.",
                "ignore_memory": "Resource constraints define legality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-009",
            "prompt": "Which structures contribute to peak auxiliary space in window or prefix solutions? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "prefix_array",
                  "text": "A cumulative array retained for random queries."
                },
                {
                  "id": "prefix_map",
                  "text": "A map of prior cumulative values."
                },
                {
                  "id": "window_map",
                  "text": "A frequency map retained for the current window."
                },
                {
                  "id": "original_input",
                  "text": "The pre-existing input as newly allocated auxiliary memory."
                }
              ],
              "acceptedOptionIds": [
                "prefix_array",
                "prefix_map",
                "window_map"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Peak auxiliary space includes every live structure created to perform the computation.",
              "details": "Input and output should be reported separately.",
              "wrongOptionExplanationsByOptionId": {
                "original_input": "Input space is not created by the algorithm."
              },
              "omittedCorrectExplanationsByOptionId": {
                "prefix_array": "It is working state.",
                "prefix_map": "Historical lookup requires it.",
                "window_map": "Its size can grow with the active state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-010",
            "prompt": "Which window workloads can genuinely use O(1) auxiliary state? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "fixed_sum",
                  "text": "A fixed-size rolling sum."
                },
                {
                  "id": "positive_threshold_sum",
                  "text": "A nonnegative threshold window maintaining only sum."
                },
                {
                  "id": "fixed_count",
                  "text": "A fixed-size rolling count of a boolean property."
                },
                {
                  "id": "distinct_constraint",
                  "text": "A window requiring frequencies for up to n distinct values."
                }
              ],
              "acceptedOptionIds": [
                "fixed_sum",
                "positive_threshold_sum",
                "fixed_count"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Constant space depends on the maintained payload, not merely on moving boundaries.",
              "details": "Distinctness constraints often require growing state.",
              "wrongOptionExplanationsByOptionId": {
                "distinct_constraint": "The frequency table can be O(n)."
              },
              "omittedCorrectExplanationsByOptionId": {
                "fixed_sum": "Only sum and boundaries are needed.",
                "positive_threshold_sum": "Two boundaries and one aggregate suffice.",
                "fixed_count": "One count can be updated incrementally."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-011",
            "prompt": "Which statements about prefix-state memory are correct? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "array_linear",
                  "text": "A full one-dimensional prefix array uses O(n) entries."
                },
                {
                  "id": "hash_linear",
                  "text": "A prefix hash map can use O(n) entries in the worst case."
                },
                {
                  "id": "reusable",
                  "text": "The retained space can support many later compatible queries."
                },
                {
                  "id": "always_output",
                  "text": "Prefix storage is always required output."
                }
              ],
              "acceptedOptionIds": [
                "array_linear",
                "hash_linear",
                "reusable"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Prefix representations retain historical cumulative state for future arithmetic or lookup.",
              "details": "They are auxiliary unless the API explicitly returns them.",
              "wrongOptionExplanationsByOptionId": {
                "always_output": "It is usually auxiliary preprocessing state."
              },
              "omittedCorrectExplanationsByOptionId": {
                "array_linear": "One cumulative value is stored per boundary.",
                "hash_linear": "Every prefix may be distinct.",
                "reusable": "Reuse is the reason for storing it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-012",
            "prompt": "Which mistaken space claims confuse moving and prefix representations? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "window_constant_always",
                  "text": "Every sliding-window algorithm uses O(1) space."
                },
                {
                  "id": "prefix_time_only",
                  "text": "Prefix sums trade time but not memory."
                },
                {
                  "id": "output_aux_same",
                  "text": "Required output and auxiliary space are the same category."
                },
                {
                  "id": "rolling_constant_case",
                  "text": "A simple fixed-size sum window can use O(1) auxiliary state."
                }
              ],
              "acceptedOptionIds": [
                "window_constant_always",
                "prefix_time_only",
                "output_aux_same"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Space claims must name the actual retained representation and output contract.",
              "details": "A specific constant-state rolling sum remains valid.",
              "wrongOptionExplanationsByOptionId": {
                "rolling_constant_case": "This is a valid specific claim."
              },
              "omittedCorrectExplanationsByOptionId": {
                "window_constant_always": "Maps and deques can grow.",
                "prefix_time_only": "A full prefix representation uses linear state.",
                "output_aux_same": "They answer different questions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-013",
            "prompt": "Arrange a peak-space audit.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "list_live",
                  "text": "List every input-derived structure live at the same time."
                },
                {
                  "id": "classify",
                  "text": "Separate input, required output, and auxiliary working state."
                },
                {
                  "id": "parameterize",
                  "text": "Express maps, deques, arrays, and copies in n, k, or distinct count."
                },
                {
                  "id": "take_peak",
                  "text": "Report the maximum simultaneous auxiliary state, not the sum of allocations over time."
                }
              ],
              "canonicalOrder": [
                "list_live",
                "classify",
                "parameterize",
                "take_peak"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Space complexity is about live storage, not cumulative allocation events.",
              "details": "Classification prevents required output from being mislabeled as algorithmic workspace."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-014",
            "prompt": "Arrange the lifecycle of a reusable prefix array.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "allocate",
                  "text": "Allocate n + 1 cumulative entries."
                },
                {
                  "id": "build",
                  "text": "Populate them from the immutable source."
                },
                {
                  "id": "retain",
                  "text": "Keep the array live across compatible queries."
                },
                {
                  "id": "release",
                  "text": "Release it when the source version or workload ends."
                }
              ],
              "canonicalOrder": [
                "allocate",
                "build",
                "retain",
                "release"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The O(n) state remains live because later queries depend on it.",
              "details": "Releasing after each query would destroy the preprocessing benefit."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-space-015",
            "prompt": "Arrange the lifecycle of a constant-state rolling sum.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "initialize",
                  "text": "Compute or seed the first current interval aggregate."
                },
                {
                  "id": "update",
                  "text": "Replace outgoing contribution with incoming contribution."
                },
                {
                  "id": "consume",
                  "text": "Use the current aggregate before moving to the next interval."
                },
                {
                  "id": "finish",
                  "text": "Discard the aggregate after the single sequential traversal."
                }
              ],
              "canonicalOrder": [
                "initialize",
                "update",
                "consume",
                "finish"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Only one interval state is live at a time.",
              "details": "The method saves space by giving up arbitrary later interval access."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_window_and_prefix_time_space_tradeoff",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
