        },
        "items": [
          {
            "id": "alg-hms-state-presence-only-set",
            "prompt": "A validator only needs to reject the second occurrence of any token. Which hash state is the smallest complete representation?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "seen_set",
                  "text": "A set of tokens already observed."
                },
                {
                  "id": "count_map",
                  "text": "A map from token to exact frequency."
                },
                {
                  "id": "index_map",
                  "text": "A map from token to first index."
                }
              ],
              "acceptedOptionIds": [
                "seen_set"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When all positive occurrence counts are equivalent and no payload is returned, a set is sufficient.",
              "details": "Choose the state by the information contract, not by habit. The validator asks only whether a prior equal token exists, so membership is the complete invariant. A map becomes necessary only when later logic consumes a count, index, timestamp, bucket, or other value associated with the key.",
              "wrongOptionExplanationsByOptionId": {
                "count_map": "Exact counts can solve the task, but they retain information the boolean duplicate decision never uses.",
                "index_map": "An index payload is unnecessary because the validator does not report or revisit the position of the first occurrence."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_set_from_map_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "seen_set",
              "problemArchetypeId": "detect_duplicate_or_membership"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-hms-state-exact-count-map",
            "prompt": "A report must output the exact number of occurrences for every distinct value. Which state is required?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frequency_map",
                  "text": "A map from value to occurrence count."
                },
                {
                  "id": "seen_set",
                  "text": "A set of values that occurred at least once."
                },
                {
                  "id": "last_value",
                  "text": "One variable containing the latest value."
                }
              ],
              "acceptedOptionIds": [
                "frequency_map"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Exact multiplicity is a payload, so the key must map to a count.",
              "details": "For each processed value, the map maintains the invariant count[value] equals the number of processed occurrences. Presence is a derived condition count[value] > 0, but the reverse derivation is impossible. This distinction transfers to multisets, quotas, and threshold crossings.",
              "wrongOptionExplanationsByOptionId": {
                "seen_set": "A set collapses every positive count to one membership bit, so it cannot produce exact multiplicities.",
                "last_value": "The latest value contains no state for the other distinct values and no accumulated count."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_set_from_map_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-hms-state-original-index-map",
            "prompt": "During a one-pass search, a match must return the earlier element’s original index. Which state preserves the needed information?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_to_index",
                  "text": "A map from prior value to an appropriate original index."
                },
                {
                  "id": "value_set",
                  "text": "A set of prior values."
                },
                {
                  "id": "index_set",
                  "text": "A set of prior indices without their values."
                }
              ],
              "acceptedOptionIds": [
                "value_to_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The lookup key is the value, while the required payload is its original index.",
              "details": "A map links the equality-search key to the provenance needed by the output. The exact overwrite policy depends on whether the earliest, latest, or any valid index is acceptable. A set is adequate only for an existence result, not for reconstructing the source occurrence.",
              "wrongOptionExplanationsByOptionId": {
                "value_set": "A value set can prove that the partner exists but cannot recover which earlier index supplied it.",
                "index_set": "Indices alone do not support lookup by the required partner value."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_set_from_map_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "preserve_original_index"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-hms-state-group-bucket-map",
            "prompt": "The output must contain every input record grouped by a canonical category key. Which state shape is complete?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "key_to_list",
                  "text": "A map from category key to a list of records."
                },
                {
                  "id": "key_set",
                  "text": "A set of category keys."
                },
                {
                  "id": "key_to_count",
                  "text": "A map from category key to the number of records only."
                }
              ],
              "acceptedOptionIds": [
                "key_to_list"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Grouped output requires a bucket payload, not only key presence or group size.",
              "details": "The map key represents the equivalence class and the value accumulates all members of that class. A count map is valid for a histogram but not for returning groups. The boundary transfers to any aggregation: choose a payload that preserves exactly the downstream aggregate or members required.",
              "wrongOptionExplanationsByOptionId": {
                "key_set": "A set identifies which categories exist but loses every record needed to build the grouped output.",
                "key_to_count": "Counts preserve group sizes but not the actual members required by the result."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_set_from_map_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grouping_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-state-distinct-prior-membership-order",
            "prompt": "Order the steps for duplicate detection so that a set proves an occurrence existed before the current one.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "read_current",
                  "text": "Read the current value."
                },
                {
                  "id": "query_seen",
                  "text": "Query whether the value is already in the seen set."
                },
                {
                  "id": "report_duplicate",
                  "text": "If present, report the duplicate outcome."
                },
                {
                  "id": "insert_current",
                  "text": "Insert the current value for future iterations."
                }
              ],
              "canonicalOrder": [
                "read_current",
                "query_seen",
                "report_duplicate",
                "insert_current"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Membership must be checked before insertion when presence is intended to certify a prior distinct occurrence.",
              "details": "The set invariant is “contains values from earlier iterations.” Inserting first changes the meaning to “contains values from earlier iterations or the current one,” making every current value appear present. The same set type can be correct with different operation order in workflows where the current item is allowed to establish the state before later bucket operations."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_set_from_map_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "seen_set",
              "problemArchetypeId": "detect_duplicate_or_membership"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-state-select-all-multiplicity-contracts",
            "prompt": "Select all requirements that need a map payload rather than a presence-only set.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "exact_count",
                  "text": "Return the exact count of each value."
                },
                {
                  "id": "first_index",
                  "text": "Return the first index at which each value appeared."
                },
                {
                  "id": "any_duplicate",
                  "text": "Return only whether any duplicate exists."
                },
                {
                  "id": "group_members",
                  "text": "Return every record grouped under its normalized key."
                }
              ],
              "acceptedOptionIds": [
                "exact_count",
                "first_index",
                "group_members"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Counts, provenance, and buckets are associated values; pure duplicate existence is membership.",
              "details": "The set-versus-map decision is determined by what information must survive after the key is found. A set stores only existence. A map stores a payload such as count, index, or list. Multiple requirements can share the same key but require different payload types, so “use a map” is only the first part of the state decision.",
              "wrongOptionExplanationsByOptionId": {
                "any_duplicate": "A boolean duplicate result needs only to know whether a current value was seen earlier, so a set is complete."
              },
              "omittedCorrectExplanationsByOptionId": {
                "exact_count": "Omitting exact_count misses that different positive multiplicities require a numeric payload.",
                "first_index": "Omitting first_index misses that provenance must be associated with the lookup key.",
                "group_members": "Omitting group_members misses that the output requires a bucket of member records per key."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_set_from_map_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-state-complexity-does-not-choose-payload",
            "prompt": "A set and a map both provide expected O(1) key lookup in the chosen environment. What should determine which one the algorithm uses?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "information_contract",
                  "text": "Whether later logic needs only membership or an associated payload."
                },
                {
                  "id": "same_complexity_means_same",
                  "text": "They are interchangeable because the expected lookup class is the same."
                },
                {
                  "id": "map_always_safer",
                  "text": "Always use a map because it can store more information."
                }
              ],
              "acceptedOptionIds": [
                "information_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Asymptotic access cost and semantic payload are separate decisions; the output and invariant choose the state shape.",
              "details": "Both containers may share expected lookup complexity, but a set represents key presence while a map represents key-to-value association. The correct choice is the smallest state that preserves every downstream requirement. Worst-case guarantees, memory overhead, and implementation details may then influence the broader strategy, but they do not erase the semantic distinction.",
              "wrongOptionExplanationsByOptionId": {
                "same_complexity_means_same": "Equal asymptotic lookup cost does not make two state representations preserve the same information.",
                "map_always_safer": "Retaining unused payloads obscures the invariant and can introduce unnecessary update policy; more capacity is not automatically a better contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_set_from_map_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "detect_duplicate_or_membership"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-state-earliest-index-update-policy",
            "prompt": "A map stores value to index, and the required result must use the earliest occurrence of each value. What update policy preserves that contract?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "write_if_absent",
                  "text": "Store the index only when the value is not already present."
                },
                {
                  "id": "overwrite_every_time",
                  "text": "Replace the stored index on every occurrence."
                },
                {
                  "id": "remove_on_repeat",
                  "text": "Delete the key when a repeated value appears."
                }
              ],
              "acceptedOptionIds": [
                "write_if_absent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A map payload needs an explicit replacement policy; preserving the earliest index means first write wins.",
              "details": "Choosing a map is not enough—the update rule defines what the payload means. With write-if-absent, the invariant is that map[value] is the minimum processed index for that value. Overwrite-every-time is correct only when the latest index is required or any index is acceptable under a separately proven rule.",
              "wrongOptionExplanationsByOptionId": {
                "overwrite_every_time": "Overwriting changes the payload from earliest occurrence to latest occurrence and violates the stated provenance contract.",
                "remove_on_repeat": "Deleting repeated keys discards valid earliest provenance rather than preserving it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_set_from_map_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "preserve_original_index"
            },
            "difficulty": "advanced"
          },
          {
            "id": "alg-hms-state-output-contract-switch",
            "prompt": "The same duplicate-scanning input is used in two tasks. Task A returns only a boolean; Task B returns the first duplicate value and both original indices. What is the minimal state transition between the tasks?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "set_to_index_map",
                  "text": "Replace the seen set with a map from value to first index."
                },
                {
                  "id": "set_to_count_set",
                  "text": "Keep a set and add a second set for counts."
                },
                {
                  "id": "no_change",
                  "text": "Keep the same seen set because both tasks detect duplicates."
                }
              ],
              "acceptedOptionIds": [
                "set_to_index_map"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Changing the output from existence to reconstructable origins changes the state from membership to value-to-index association.",
              "details": "The input and traversal can remain the same while the required information changes. Task A needs one membership bit per value. Task B must retrieve the earlier position when the duplicate is encountered, so the key requires an index payload. This is the core transfer rule for set-versus-map decisions: follow the output contract, not the surface wording of the problem.",
              "wrongOptionExplanationsByOptionId": {
                "set_to_count_set": "A second set still cannot associate the first occurrence index with its value, and sets do not encode counts.",
                "no_change": "The shared duplicate signal does not make the output contracts identical; Task B requires provenance lost by a set."
              }
            },
