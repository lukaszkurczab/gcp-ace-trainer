            }
          },
          {
            "id": "alg-gt-msbfs-006",
            "prompt": "Some graph component contains no source. After a correct multi-source BFS from all sources, how should vertices in that component be represented?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "unreachable",
                  "text": "They remain unseen or at infinite distance; the algorithm must not invent a nearest source across missing edges."
                },
                {
                  "id": "new_sources",
                  "text": "The first unseen vertex should automatically become an additional source at distance zero."
                },
                {
                  "id": "last_distance",
                  "text": "Assign them the largest distance found in another component."
                },
                {
                  "id": "matrix_connect",
                  "text": "An adjacency matrix implicitly connects the component to a source through zero entries."
                }
              ],
              "acceptedOptionIds": [
                "unreachable"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A source wave cannot cross a disconnected-component boundary.",
              "details": "Multi-source BFS covers the union of components containing at least one source. Vertices outside that union have no finite path to any source and must retain an explicit unreachable state. Automatically promoting them to sources is appropriate only for a different algorithm, such as component enumeration, and would invalidate the requested distance semantics.",
              "wrongOptionExplanationsByOptionId": {
                "new_sources": "That changes the supplied source set and turns the task into component coverage rather than nearest supplied source.",
                "last_distance": "Distance requires a path; copying a numeric layer fabricates reachability.",
                "matrix_connect": "Zero matrix entries normally mean absent edges, not zero-cost connections."
              }
            },
            "taxonomy": {
