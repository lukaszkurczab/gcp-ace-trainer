          {
            "id": "alg-hms-review-stored-current-not-complement",
            "prompt": "A one-pass target-sum implementation stores seen values correctly but checks whether the target itself is in seen. Why does it miss valid pairs?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "wrong_lookup_key",
                  "text": "The query should use target - current, the prior value required by the relation."
                },
                {
                  "id": "wrong_container",
                  "text": "A hash set can never support pair existence."
                },
                {
                  "id": "need_sort_only",
                  "text": "Target-sum pairs can only be found after sorting."
                }
              ],
              "acceptedOptionIds": [
                "wrong_lookup_key"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The table is queried with a parameter rather than the value algebraically required to pair with the current element.",
              "details": "The state structure can be correct while the key derivation is wrong. From prior + current = target, the required prior key is target - current. Checking target asks an unrelated membership question and succeeds only accidentally on special inputs.",
              "wrongOptionExplanationsByOptionId": {
                "wrong_container": "A prior-presence set is sufficient for existence when the complement key and operation order are correct.",
                "need_sort_only": "Sorting with two pointers is an alternative, not a requirement; complement lookup is valid under the stated one-pass state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_hash_state_mismatch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "complement_lookup",
