        "items": [
          {
            "id": "alg-tp-proof-eliminate-left-quantifier",
            "prompt": "In a nondecreasing array, left and right delimit all remaining pair candidates. The current sum a[left]+a[right] is below target. Which statement proves that left may advance?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "left_is_first",
                  "text": "left may advance because it is the first index."
                },
                {
                  "id": "right_is_large",
                  "text": "right is large, so both pointers should move."
                },
                {
                  "id": "one_loop",
                  "text": "The algorithm uses one loop, so advancing left is correct."
                },
                {
                  "id": "all_with_left_too_small",
                  "text": "For every j with left < j <= right, a[left]+a[j] <= a[left]+a[right] < target, so no remaining pair using left can succeed."
                }
              ],
              "acceptedOptionIds": [
                "all_with_left_too_small"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The proof must quantify over every remaining partner of left. Sortedness bounds all those sums by the already-too-small extreme sum.",
              "details": "The current right value is the largest partner still available to left. If even that pair is below the target, pairing left with any index inside the interval can only produce an equal or smaller sum. Therefore every candidate containing left is impossible, and advancing left removes exactly a proved-empty candidate class. Pointer position, loop shape, or intuition about a ‘large’ right value is not sufficient.",
              "wrongOptionExplanationsByOptionId": {
                "left_is_first": "Being at a boundary does not make a candidate disposable. The ordered inequality over all remaining partners does.",
                "right_is_large": "The large right endpoint is still needed with a larger left value. Moving both would remove an unproven candidate.",
                "one_loop": "Loop structure can bound work but cannot prove that a discarded candidate is irrelevant to the answer."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "justify_candidate_elimination_by_pointer_move",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The array is sorted in nondecreasing order.",
              "All untested pair candidates lie within [left, right]."
            ]
          },
          {
            "id": "alg-tp-proof-eliminate-right-quantifier",
            "prompt": "In a nondecreasing array, the current sum a[left]+a[right] is above target. Which statement proves that right may retreat?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "right_is_last",
                  "text": "right may retreat because it is the last index."
                },
                {
                  "id": "left_is_small",
                  "text": "left is small, so advancing it will reduce the sum."
                },
                {
                  "id": "eventual_convergence",
                  "text": "The pointers will eventually meet, which proves each move correct."
                },
                {
                  "id": "all_with_right_too_large",
                  "text": "For every i with left <= i < right, a[i]+a[right] >= a[left]+a[right] > target, so no remaining pair using right can succeed."
                }
              ],
              "acceptedOptionIds": [
                "all_with_right_too_large"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The proof uses the smallest remaining partner of right. If that pair is already too large, every pair containing right is too large.",
              "details": "left names the minimum value in the remaining interval. Replacing it with any larger index cannot lower the sum with the fixed right endpoint. Thus the entire class of candidates using right is impossible and can be discarded. Eventual convergence proves termination only; it does not prove that the answer was not skipped along the way.",
              "wrongOptionExplanationsByOptionId": {
                "right_is_last": "Boundary position alone does not eliminate a candidate. The ordered lower bound on all sums using right is the proof.",
                "left_is_small": "Advancing left makes the sum equal or larger, the opposite of what an above-target state requires.",
                "eventual_convergence": "An incorrect algorithm can terminate. Completeness requires a safe-elimination argument for every move."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "justify_candidate_elimination_by_pointer_move",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The array is sorted in nondecreasing order.",
              "All untested pair candidates lie within [left, right]."
            ]
          },
          {
            "id": "alg-tp-proof-both-move-proof-gap",
            "prompt": "After a below-target sum, a proof says: ‘advance left because all pairs using left are too small, and retreat right to make progress faster.’ What is missing for the right move?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "right_elimination_argument",
                  "text": "A separate argument that every remaining pair using right is impossible; the below-target comparison does not provide one."
                },
                {
                  "id": "right_index_bounds",
                  "text": "A check that right is less than n."
                },
                {
                  "id": "even_number_steps",
                  "text": "A guarantee that the loop takes an even number of steps."
                },
                {
                  "id": "duplicate_values",
                  "text": "Evidence that the array contains duplicates."
                }
              ],
              "acceptedOptionIds": [
                "right_elimination_argument"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "One comparison proves one boundary class impossible. It gives no reason to discard the opposite boundary as well.",
              "details": "A low sum proves the smallest value cannot reach the target even with the largest partner. It does not prove that the largest value fails with a larger left candidate. Retreating right therefore removes candidates that may still contain the answer. Faster convergence is not a correctness criterion; every discarded boundary needs its own decisive justification.",
              "wrongOptionExplanationsByOptionId": {
                "right_index_bounds": "An in-range pointer can still be moved incorrectly. Bounds safety and candidate-elimination correctness are separate concerns.",
                "even_number_steps": "A balanced or even number of moves may look like systematic progress, but step parity says nothing about whether discarded pairs were impossible. Correctness needs a boundary-elimination proof.",
                "duplicate_values": "Duplicates may affect output enumeration, but they do not supply the missing proof for discarding right after a low sum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "justify_candidate_elimination_by_pointer_move",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-tp-proof-unsorted-counterexample",
            "prompt": "Values [3, 10, 2, 8] are not sorted. left points to 3, right points to 8, target is 13, and the endpoint sum 11 is below target. Why is advancing left not justified by the standard proof?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "target_parity",
                  "text": "The target is odd, so ordered elimination cannot be used."
                },
                {
                  "id": "array_length_four",
                  "text": "Two-pointer proofs require odd-length arrays."
                },
                {
                  "id": "must_move_both",
                  "text": "Unsorted input is repaired by moving both pointers on each mismatch."
                },
                {
                  "id": "endpoints_not_extrema",
                  "text": "The physical endpoints are not guaranteed extrema of the remaining values, so inequalities over all partners do not follow from the endpoint sum."
                }
              ],
              "acceptedOptionIds": [
                "endpoints_not_extrema"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The elimination proof depends on endpoints being minimum and maximum remaining values. Physical position alone supplies no such bound in unsorted input.",
              "details": "For a low endpoint sum, the proof needs right to be the largest available partner for left. Here right holds 8 while an interior position holds 10, and 3+10 is a valid target pair. Advancing left would therefore discard a real solution. Physical endpoints supply no value bound until an ordering invariant is established. Sorting can establish that relation only if its cost and side effects are accepted.",
              "wrongOptionExplanationsByOptionId": {
                "target_parity": "Parity is irrelevant to the monotonic boundary proof. The missing property is value order.",
                "array_length_four": "The method works for any length when the ordered invariant and distinct-position boundary hold.",
                "must_move_both": "Moving both may appear to make faster progress, but it discards an additional unproved boundary and still does not create value order. A different strategy or explicit sorting is required."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "justify_candidate_elimination_by_pointer_move",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The given order is the physical array order and has not been sorted."
            ]
          },
          {
            "id": "alg-tp-proof-proof-obligation-order",
            "prompt": "Order the proof obligations for one mismatch-driven boundary move in sorted pair search.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "quantify_elimination",
                  "text": "Show that every pair containing that boundary misses the target in the same direction."
                },
                {
                  "id": "state_candidate_interval",
                  "text": "State that every untested candidate pair uses positions inside the current [left, right] interval."
                },
                {
                  "id": "move_boundary",
                  "text": "Move the proved-impossible boundary and preserve the candidate-interval invariant."
                },
                {
                  "id": "use_order_extreme",
                  "text": "Use sortedness to identify the maximum or minimum partner available to the boundary candidate."
                }
              ],
              "canonicalOrder": [
                "state_candidate_interval",
                "use_order_extreme",
                "quantify_elimination",
                "move_boundary"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The move is the final consequence of an invariant, an extremal order fact, and a quantified elimination statement.",
              "details": "Without the candidate-interval invariant, the proof has no defined universe of remaining pairs. Sortedness then identifies the extremal partner needed to bound all pairs containing one boundary. The comparison extends from one pair to the entire boundary candidate class. Only after that class is proved impossible may the pointer move and establish the next smaller interval."
            },
            "taxonomy": {
              "primarySkillAtomId": "justify_candidate_elimination_by_pointer_move",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "advanced"
          },
          {
            "id": "alg-tp-proof-proof-ingredients-multiple",
            "prompt": "Select all ingredients required for a correctness argument that a sorted pair-sum scan does not skip a valid pair.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "fast_convergence",
                  "text": "A claim that moving two pointers at once reduces the interval faster."
                },
                {
                  "id": "candidate_interval",
                  "text": "An invariant describing which interval contains all untested candidate positions."
                },
                {
                  "id": "ordered_extremes",
                  "text": "The fact that left and right are value extrema of that remaining interval."
                },
                {
                  "id": "boundary_quantification",
                  "text": "For each mismatch, an argument covering every pair that uses the boundary being removed."
                },
                {
                  "id": "two_variable_names",
                  "text": "Variables named left and right."
                }
              ],
              "acceptedOptionIds": [
                "candidate_interval",
                "ordered_extremes",
                "boundary_quantification"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Completeness comes from the remaining-candidate invariant, ordered extremal bounds, and quantified safe elimination. Names and speed do not establish correctness.",
              "details": "The invariant states where a not-yet-tested solution could still exist. Sortedness turns endpoint values into bounds over all partners in that interval. The mismatch comparison then eliminates one complete boundary candidate class without losing a solution. Termination follows from monotonic movement, but faster shrinkage cannot replace the safe-elimination step.",
              "wrongOptionExplanationsByOptionId": {
                "two_variable_names": "Names carry no mathematical meaning and can appear in nested loops, windows, or incorrect code.",
                "fast_convergence": "Discarding candidates faster is useful only after they are proved irrelevant. Otherwise it reduces completeness, not just runtime."
              },
              "omittedCorrectExplanationsByOptionId": {
                "candidate_interval": "Without this invariant, the proof cannot say where all remaining candidates reside.",
                "ordered_extremes": "Without extremal order, one endpoint comparison does not bound the other partners of that boundary.",
                "boundary_quantification": "Without quantifying over the removed boundary class, the move may skip an untested valid pair."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "justify_candidate_elimination_by_pointer_move",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            },
            "difficulty": "advanced"
          },
          {
            "id": "alg-tp-proof-empty-candidate-region",
            "prompt": "Why does a distinct-position pair search terminate safely when left >= right?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_pointers_moved_equal_times",
                  "text": "The pointers have moved the same number of times."
                },
                {
                  "id": "no_untested_pair_remains",
                  "text": "The candidate interval contains fewer than two distinct positions, so no untested valid pair remains."
                },
                {
                  "id": "target_must_be_absent",
                  "text": "Any target is mathematically impossible in an array once pointers meet."
                },
                {
                  "id": "values_become_unsorted",
                  "text": "The remaining values lose their sorted order."
                }
              ],
              "acceptedOptionIds": [
                "no_untested_pair_remains"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The loop boundary follows from the candidate-set invariant: fewer than two distinct positions means the remaining pair set is empty.",
              "details": "Earlier moves have eliminated all candidates outside the current interval. At left==right, only one position remains, and at left>right none remain. Because the output contract forbids using one position twice, continuing cannot produce a legal pair. The argument is about candidate cardinality, not about pointer symmetry or loss of sortedness.",
              "wrongOptionExplanationsByOptionId": {
                "target_must_be_absent": "The target may have been found earlier; the statement only says no untested legal pair remains now.",
                "values_become_unsorted": "Because the array was never mutated, the remaining interval stays sorted after the pointers meet. Termination follows from having fewer than two distinct positions, not from losing order.",
                "both_pointers_moved_equal_times": "The pointers need not move equally often. Safe termination depends on the size of the remaining candidate set."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "justify_candidate_elimination_by_pointer_move",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "A pair must use two distinct positions."
            ]
          },
          {
            "id": "alg-tp-proof-mirror-region-transfer",
            "prompt": "During palindrome checking, the current normalized endpoint symbols are equal. Why may both pointers move inward without losing a possible mismatch outside the new interval?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "endpoints_jointly_verified",
                  "text": "The current endpoints have been jointly verified as a matching mirror pair, and every position outside them was already verified."
                },
                {
                  "id": "both_move_rule",
                  "text": "Two-pointer algorithms always move both pointers after equality."
                },
                {
                  "id": "sorted_symbols",
                  "text": "Equal symbols make the remaining sequence sorted."
                },
                {
                  "id": "mismatch_cannot_exist",
                  "text": "One equal endpoint pair proves the entire sequence is a palindrome."
                }
              ],
              "acceptedOptionIds": [
                "endpoints_jointly_verified"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The mirror invariant discharges both current endpoints together, so the only unresolved positions are strictly inside them.",
              "details": "This proof differs from pair-sum elimination but has the same structure: state meaning explains what a move removes. All earlier outer pairs match, and the current left/right symbols also match, so neither endpoint can participate in a future unresolved mismatch. Both moves are therefore justified by one joint relation. An inner mismatch may still exist, so the scan must continue.",
              "wrongOptionExplanationsByOptionId": {
                "both_move_rule": "Both pointers move here because both endpoints are proved resolved, not because the family has a universal movement schedule.",
                "sorted_symbols": "Equal normalized symbols might feel like an ordering fact, but palindrome checking uses positional symmetry, not value order. Sorting would destroy the sequence being tested.",
                "mismatch_cannot_exist": "Equal current endpoints say nothing about unmatched symbols deeper inside the sequence."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "justify_candidate_elimination_by_pointer_move",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "compare_from_both_ends"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-tp-proof-monotonic-movement-complexity",
            "prompt": "left only increases, right only decreases, and neither pointer reverses. Across the whole scan, each pointer moves at most n positions and each iteration does O(1) work. What are the time and auxiliary-space complexities?",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
