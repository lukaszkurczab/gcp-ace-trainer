              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-undo-018",
            "prompt": "A depth-d solver copies a path of length proportional to the current depth for every recursive child. Along one active root-to-leaf chain, select an upper bound on simultaneously retained copied-path space.",
            "constraints": [
              "At depth i, a distinct copied path of length O(i) remains active.",
              "The maximum depth is d."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "active_copy_space"
              ],
              "availableValuesByDimension": {
                "active_copy_space": [
                  "O(d)",
                  "O(d log d)",
                  "O(d²)",
                  "O(2^d)"
                ]
              },
              "acceptedValuesByDimension": {
                "active_copy_space": [
                  "O(d²)"
                ]
              },
              "normalizedAliasesByDimension": {
                "active_copy_space": {
                  "sum_of_prefix_lengths": "O(d²)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Active copied paths can total 1 + 2 + ... + d elements along the recursion chain.",
              "details": "In-place choose-recurse-unchoose can reduce active path storage to O(d), at the cost of requiring correct restoration."
            },
            "taxonomy": {
              "primarySkillAtomId": "restore_path_state_after_branch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          }
        ],
