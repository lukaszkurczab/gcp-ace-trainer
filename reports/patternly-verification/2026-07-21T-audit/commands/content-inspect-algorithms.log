          {
            "id": "alg-bits-representation-012",
            "prompt": "Which statements about fixed-width two's-complement representation are correct? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "same_bits_diff_meaning",
                  "text": "The same bits can have different signed and unsigned numeric interpretations."
                },
                {
                  "id": "all_ones_minus_one",
                  "text": "A word of all ones represents -1 when interpreted as signed two's complement."
                },
                {
                  "id": "msb_sign",
                  "text": "The most significant bit is the sign bit."
                },
                {
                  "id": "width_irrelevant",
                  "text": "The numeric signed value is independent of the declared width."
                }
              ],
              "acceptedOptionIds": [
                "same_bits_diff_meaning",
                "all_ones_minus_one",
                "msb_sign"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Two's complement is a fixed-width interpretation model.",
              "details": "Width determines the sign position and the negative weight of that bit.",
              "wrongOptionExplanationsByOptionId": {
                "width_irrelevant": "The same low bits can represent different values after widening or truncation."
              },
              "omittedCorrectExplanationsByOptionId": {
                "same_bits_diff_meaning": "Signedness changes interpretation, not stored bits.",
                "all_ones_minus_one": "This holds at every positive fixed width.",
                "msb_sign": "It carries negative weight in signed interpretation."
              }
            },
