        "items": [
          {
            "prompt": "Two singly linked traversals currently hold pointers p and q. Both nodes store value 7. Which additional fact is sufficient to conclude that the traversals have reached the same structural node?",
            "constraints": [
              "Node equality means object/reference identity, not payload equality.",
              "The lists may contain duplicate values."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "same_value_twice",
                  "text": "The value 7 also appeared earlier in both traversals."
                },
                {
                  "id": "same_reference",
                  "text": "p and q reference the same node object."
                },
                {
                  "id": "same_distance",
                  "text": "p and q are the same number of steps from their respective heads."
                },
                {
                  "id": "same_next_value",
                  "text": "p.next and q.next store the same value."
                }
              ],
              "acceptedOptionIds": [
                "same_reference"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Structural identity is reference equality: p and q must designate the same node object.",
              "details": "A linked list is a graph of node objects connected by references. Equal payloads, equal traversal depth, or equal successor values can occur in distinct nodes. Reference equality is therefore the decisive test for a shared node or shared tail. The same rule transfers to detecting a pointer meeting inside a cycle: compare node identity, not stored value.",
              "wrongOptionExplanationsByOptionId": {
                "same_next_value": "Equal successor values can belong to different successor nodes, so this does not establish structural sharing.",
                "same_distance": "Equal depth describes traversal position, not whether the two references designate one object.",
                "same_value_twice": "Repeated payloads are common and provide no identity guarantee."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_node_identity_from_node_value",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "pointer_rewiring",
              "problemArchetypeId": "remove_or_rewire_node"
            },
            "id": "alg-linked-list-node-identity-01-shared-reference-signal",
            "difficulty": "introductory"
          },
          {
            "prompt": "Variables p and q both reference the same node N. N.next currently references node M. The program executes p.next = null. Select all statements that are now true.",
            "constraints": [
              "p and q are ordinary references to a mutable node object.",
              "Only the next field is assigned."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "node_value_must_change",
                  "text": "N's payload value must also change because its next field changed."
                },
                {
                  "id": "p_q_still_alias",
                  "text": "p and q still reference the same node N."
                },
                {
                  "id": "q_keeps_private_link",
                  "text": "q.next still references M because q is a different variable."
                },
                {
                  "id": "q_observes_null",
                  "text": "q observes the shared mutation, so q.next is now null."
                }
              ],
              "acceptedOptionIds": [
                "q_observes_null",
                "p_q_still_alias"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "p and q alias one node object, so a mutation through p is visible through q while both variables still designate N.",
              "details": "Variables hold references; they do not create private copies of the referenced node. Setting N.next through p changes N itself, so q observes the same new link. The assignment changes neither the identity of N nor its payload. This distinction is central when a shared tail is edited: every list path that reaches that node sees the edit.",
              "wrongOptionExplanationsByOptionId": {
                "q_keeps_private_link": "A different reference variable does not give the shared node a separate next field.",
                "node_value_must_change": "Changing a link does not imply any payload mutation."
              },
              "omittedCorrectExplanationsByOptionId": {
                "q_observes_null": "Omitting this misses the defining consequence of aliasing: both references observe the same object mutation.",
                "p_q_still_alias": "Omitting this confuses mutation of a field with replacement of the referenced object."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_node_identity_from_node_value",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "pointer_rewiring",
              "problemArchetypeId": "remove_or_rewire_node"
            },
            "id": "alg-linked-list-node-identity-02-aliasing-consequences",
            "difficulty": "intermediate"
          },
          {
            "prompt": "A list contains nodes A(value=4) -> B(value=4) -> C(value=9). A map stores A as a key. Which statement correctly describes a lookup using B as the key when keys use node identity?",
            "constraints": [
              "The map compares node keys by object identity.",
              "Duplicate payload values are permitted."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "result_depends_on_position",
                  "text": "The lookup succeeds only because A and B are adjacent."
                },
                {
                  "id": "lookup_hits_equal_value",
                  "text": "The lookup returns A's entry because A.value equals B.value."
                },
                {
                  "id": "lookup_misses",
                  "text": "The lookup misses unless B was separately inserted."
                },
                {
                  "id": "nodes_merge",
                  "text": "A and B become one logical node after the lookup."
                }
              ],
              "acceptedOptionIds": [
                "lookup_misses"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A and B are distinct key objects even though their payload values are equal.",
              "details": "Identity-based collections distinguish node objects by reference. The payload value 4 does not merge A and B or make one key substitute for the other. This boundary matters whenever duplicate values are legal: using payload equality for structural bookkeeping can falsely report intersections, visits, or cycles.",
              "wrongOptionExplanationsByOptionId": {
                "lookup_hits_equal_value": "That would be value-based key semantics, contrary to the stated identity-based contract.",
                "nodes_merge": "A lookup cannot merge node objects or alter list topology.",
                "result_depends_on_position": "Adjacency is irrelevant to identity-based key equality."
              }
            },
            "taxonomy": {
