            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The same surface words cover several different search and query contracts.",
              "details": "Strategy follows objective, signs, boundary ownership, and reuse.",
              "wrongOptionExplanationsByOptionId": {
                "threshold_sign": "This is a valid rule.",
                "exact_history": "This is a valid rule.",
                "known_boundaries": "This is a valid rule."
