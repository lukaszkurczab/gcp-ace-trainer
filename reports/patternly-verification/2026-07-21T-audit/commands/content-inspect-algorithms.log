            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan_original",
                  "text": "Scan the original in O(n)."
                },
                {
                  "id": "copy_sort_binary",
                  "text": "Copy, sort, and binary-search in O(n log n)."
                },
                {
                  "id": "sort_original",
                  "text": "Sort the original in place."
                },
                {
                  "id": "binary_original",
                  "text": "Binary-search the unsorted original."
