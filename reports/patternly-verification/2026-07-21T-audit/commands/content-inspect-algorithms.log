          "falseHeuristicId": "any_solution_with_two_indices_is_two_pointers",
          "transferBoundary": "Classify by the proof obligation: endpoint movement must eliminate impossible pair candidates for two pointers, while expansion and shrinkage must preserve or restore a window-validity predicate for sliding window."
        },
        "authoringProvenance": {
          "author": "OpenAI GPT-5.6 Pro — candidate authoring; human review required",
          "createdAt": "2026-07-18",
