                  "id": "same_query_new_constraints",
                  "text": "Keep the result fixed but change mutation, memory, or guarantee constraints."
                },
                {
                  "id": "same_contract_new_volume",
                  "text": "Keep semantics fixed but change one query into a large repeated workload."
                },
                {
                  "id": "rename_only",
                  "text": "Rename functions while keeping all semantics and costs fixed."
