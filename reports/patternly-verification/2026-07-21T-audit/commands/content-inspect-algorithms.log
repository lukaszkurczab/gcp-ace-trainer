          {
            "id": "algorithms-intervals-resources-006",
            "prompt": "Order the event-sweep steps for computing maximum resource demand from half-open intervals.",
            "constraints": [
              "Each ordinary interval contributes +1 at start and -1 at end.",
              "Equal coordinates follow the endpoint contract."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "create_events",
                  "text": "Create start and end events for every interval."
                },
                {
                  "id": "sort_with_ties",
                  "text": "Sort events by coordinate and apply end-before-start at equal coordinates."
                },
                {
                  "id": "update_active",
                  "text": "Apply each event delta to the active count."
                },
                {
                  "id": "record_peak",
                  "text": "Record the greatest active count reached."
                }
              ],
              "canonicalOrder": [
                "create_events",
                "sort_with_ties",
                "update_active",
                "record_peak"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Events must exist and be chronologically ordered before their deltas can define a meaningful active-count prefix and maximum.",
              "details": "Creating events translates interval occupancy into changes. Sorting, including the half-open tie rule, establishes the temporal sequence. Applying deltas before sorting would combine unrelated times, while recording a peak before an update would miss the new state. The maximum across the prefix sums is the required capacity. If equal events are grouped, the implementation must use a grouping rule proved equivalent to the stated semantics; it cannot simply omit the tie contract. The order is independent of how the event list is physically stored."
            },
