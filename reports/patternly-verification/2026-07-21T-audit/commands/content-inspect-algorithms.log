      {
        "id": "alg-backtracking-duplicates-001",
        "prompt": "Candidates are sorted, and a combination loop is choosing values at one recursion depth. Which rule skips value-equivalent sibling branches?",
        "difficulty": "intro",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "skip_same_depth_duplicate",
              "text": "Skip candidates[i] when i > start and candidates[i] equals candidates[i - 1]."
            },
            {
              "id": "skip_all_equal_globally",
              "text": "Skip every value equal to any value already in the current path."
            },
            {
              "id": "skip_first_duplicate",
              "text": "Skip the first occurrence and keep only later equal values."
            },
            {
              "id": "skip_if_i_gt_zero",
              "text": "Skip equal neighbors whenever i > 0, regardless of the current start."
            }
          ],
          "acceptedOptionIds": [
            "skip_same_depth_duplicate"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "Sorted equal values should produce one sibling branch per value at the same depth.",
          "details": "The i > start condition scopes duplicate skipping to sibling choices while still allowing equal values to appear at different depths when legal.",
          "wrongOptionExplanationsByOptionId": {
