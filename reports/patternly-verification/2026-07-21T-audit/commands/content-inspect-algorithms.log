        "items": [
          {
            "id": "alg-backtracking-pruning-001",
            "prompt": "A target-sum solver uses only positive candidate values. When is pruning by remainingTarget < 0 sound?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "positive_only",
                  "text": "When every future choice is positive, so the remaining target can only decrease further."
                },
                {
                  "id": "any_numbers",
                  "text": "For arbitrary positive and negative candidates."
                },
                {
                  "id": "only_sorted",
                  "text": "Only because the candidates are sorted."
                },
                {
                  "id": "only_at_leaf",
                  "text": "Only after a complete path is built."
                }
              ],
              "acceptedOptionIds": [
                "positive_only"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sound pruning requires a proof that no future choice can repair the violated condition.",
              "details": "With positive candidates, overshooting the target is irreversible within that branch.",
              "wrongOptionExplanationsByOptionId": {
                "any_numbers": "A later negative or compensating value could restore feasibility.",
                "only_sorted": "Sorting alone does not establish monotonic sum behavior.",
                "only_at_leaf": "The point of pruning is to reject impossible partial states early."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-002",
            "prompt": "Why is the same remainingTarget < 0 prune unsafe when negative candidates are allowed?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "future_negative_can_repair",
                  "text": "A later negative value can increase the remaining target back toward zero."
                },
                {
                  "id": "negative_values_uncomparable",
                  "text": "Negative values cannot be compared."
                },
                {
                  "id": "recursion_forbidden",
                  "text": "Recursion cannot process negative values."
                },
                {
                  "id": "sorting_fails",
                  "text": "Negative values prevent sorting."
                }
              ],
              "acceptedOptionIds": [
                "future_negative_can_repair"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The monotonicity assumption behind the prune no longer holds.",
              "details": "A partial overshoot is not proof of impossibility when later choices can offset it.",
              "wrongOptionExplanationsByOptionId": {
                "negative_values_uncomparable": "They can; the issue is reversibility of the sum condition.",
                "recursion_forbidden": "Recursion is not restricted by sign.",
                "sorting_fails": "Negative values can be sorted."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-003",
            "prompt": "A k-combination solver has chosen c values and has r candidate positions left. Which condition proves completion is impossible?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "r_less_needed",
                  "text": "r < k - c."
                },
                {
                  "id": "r_equals_needed",
                  "text": "r = k - c."
                },
                {
                  "id": "c_less_k",
                  "text": "c < k."
                },
                {
                  "id": "r_positive",
                  "text": "r > 0."
                }
              ],
              "acceptedOptionIds": [
                "r_less_needed"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A branch cannot fill more required slots than the number of candidates still available.",
              "details": "This capacity bound is independent of candidate values and is safe for combination enumeration.",
              "wrongOptionExplanationsByOptionId": {
                "r_equals_needed": "That means exactly enough candidates remain and may force a valid continuation.",
                "c_less_k": "Most nonterminal states satisfy this and still can complete.",
                "r_positive": "Having candidates remaining does not prove impossibility."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-pruning-004",
            "prompt": "A partial assignment already violates a constraint that every full solution must satisfy. What is the correct action?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "prune_now",
                  "text": "Prune the branch immediately."
                },
                {
                  "id": "continue_all_depths",
                  "text": "Continue until every variable is assigned."
                },
                {
                  "id": "record_partial",
                  "text": "Record the partial assignment as a result."
                },
                {
                  "id": "delete_siblings",
                  "text": "Remove all sibling branches as well."
                }
              ],
              "acceptedOptionIds": [
                "prune_now"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A hereditary constraint violation makes every descendant invalid.",
              "details": "The proof must rely on the constraint semantics, not merely on the branch appearing inconvenient.",
              "wrongOptionExplanationsByOptionId": {
                "continue_all_depths": "No completion can remove an already mandatory violation unless the state model says it is reversible.",
                "record_partial": "It is neither complete nor valid.",
                "delete_siblings": "The violation is local to the current branch."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-005",
            "prompt": "A palindrome-partition solver considers a segment that is not a palindrome. Why can that candidate be skipped?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "segment_required_valid",
                  "text": "Every result segment must be a palindrome, and later boundaries cannot change the chosen segment."
                },
                {
                  "id": "segment_long",
                  "text": "Long segments are always invalid."
                },
                {
                  "id": "branch_slow",
                  "text": "The branch would probably be slow."
                },
                {
                  "id": "duplicate_segment",
                  "text": "Every repeated segment is invalid."
                }
              ],
              "acceptedOptionIds": [
                "segment_required_valid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Once a boundary fixes the next segment, its validity is permanent within that branch.",
              "details": "An invalid segment cannot become valid by partitioning the remaining suffix.",
              "wrongOptionExplanationsByOptionId": {
                "segment_long": "Length does not determine palindromicity.",
                "branch_slow": "Expected cost is not a correctness proof.",
                "duplicate_segment": "Repetition is not the relevant contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_search",
              "problemArchetypeId": "partition_sequence"
            }
          },
          {
            "id": "alg-backtracking-pruning-006",
            "prompt": "Which statement describes branch ordering rather than pruning?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "try_promising_first",
                  "text": "Try candidates likely to succeed before other still-legal candidates."
                },
                {
                  "id": "remove_impossible",
                  "text": "Do not recurse into a state proven unable to complete."
                },
                {
                  "id": "skip_invalid_segment",
                  "text": "Reject a segment that violates the mandatory predicate."
                },
                {
                  "id": "capacity_bound",
                  "text": "Stop when too few candidates remain to fill required slots."
                }
              ],
              "acceptedOptionIds": [
                "try_promising_first"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Ordering changes traversal priority but retains every legal branch unless the result contract short-circuits after success.",
              "details": "Pruning removes a branch and therefore requires a sound impossibility argument.",
              "wrongOptionExplanationsByOptionId": {
                "remove_impossible": "This is pruning.",
                "skip_invalid_segment": "This is sound pruning or legality filtering.",
                "capacity_bound": "This is pruning by impossibility."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-007",
            "prompt": "A developer prunes a branch because its current score is worse than the best complete score, but future choices may improve the score. What is missing?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "valid_bound",
                  "text": "A proven bound showing that no completion of the branch can beat the best result."
                },
                {
                  "id": "more_recursion",
                  "text": "A deeper recursion limit."
                },
                {
                  "id": "sorting",
                  "text": "A sorted candidate list."
                },
                {
                  "id": "duplicate_set",
                  "text": "A set of previously returned outputs."
                }
              ],
              "acceptedOptionIds": [
                "valid_bound"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Optimization pruning needs a lower or upper bound on the best possible completion of the partial state.",
              "details": "Comparing only the current partial score may discard a branch that later becomes optimal.",
              "wrongOptionExplanationsByOptionId": {
                "more_recursion": "Depth does not justify the prune.",
                "sorting": "Sorting alone provides no optimization bound.",
                "duplicate_set": "Output deduplication does not prove optimality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-008",
            "prompt": "A grid path still needs L characters but fewer than L unused cells remain reachable under a proven bound. What does this establish?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "impossible_capacity",
                  "text": "The branch cannot complete the target and may be pruned."
                },
                {
                  "id": "guaranteed_success",
                  "text": "The remaining path is guaranteed to exist."
                },
                {
                  "id": "global_failure",
                  "text": "No starting position can ever succeed."
                },
                {
                  "id": "undo_optional",
                  "text": "Visited state no longer needs restoration."
                }
              ],
              "acceptedOptionIds": [
                "impossible_capacity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A completion requiring more resources than the branch can possibly supply is impossible.",
              "details": "The reachability bound must itself be correct; an underestimate could prune valid paths.",
              "wrongOptionExplanationsByOptionId": {
                "guaranteed_success": "Insufficient capacity proves failure, not success.",
                "global_failure": "The bound applies to the current branch.",
                "undo_optional": "Restoration is still needed before returning to the parent."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-pruning-009",
            "prompt": "Which are sound pruning reasons? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "mandatory_constraint_broken",
                  "text": "A mandatory constraint is already irreversibly violated."
                },
                {
                  "id": "insufficient_candidates",
                  "text": "Too few candidates remain to fill required slots."
                },
                {
                  "id": "positive_overshoot",
                  "text": "A positive-only sum branch has already exceeded the target."
                },
                {
                  "id": "looks_unpromising",
                  "text": "The branch looks less promising than its siblings without a proof."
                }
              ],
              "acceptedOptionIds": [
                "mandatory_constraint_broken",
                "insufficient_candidates",
                "positive_overshoot"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sound pruning follows from a proven impossibility condition.",
              "details": "Heuristic appearance may guide ordering but cannot justify omission.",
              "wrongOptionExplanationsByOptionId": {
                "looks_unpromising": "Preference is not impossibility."
              },
              "omittedCorrectExplanationsByOptionId": {
                "mandatory_constraint_broken": "No descendant can restore validity.",
                "insufficient_candidates": "Completion capacity is impossible.",
                "positive_overshoot": "Future choices can only increase the sum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-010",
            "prompt": "Which proposed pruning rules are unsafe without additional assumptions? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "overshoot_with_negatives",
                  "text": "Prune target-sum states whenever the current sum exceeds target, even though negative values remain."
                },
                {
                  "id": "worse_partial_score",
                  "text": "Prune an optimization branch because its current partial score is worse, without a completion bound."
                },
                {
                  "id": "long_segment",
                  "text": "Prune every partition segment longer than three when no length constraint exists."
                },
                {
                  "id": "invalid_prefix",
                  "text": "Prune a branch whose prefix already violates a hereditary validity constraint."
                }
              ],
              "acceptedOptionIds": [
                "overshoot_with_negatives",
                "worse_partial_score",
                "long_segment"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A pruning rule must be tied to explicit monotonicity, capacity, or hereditary constraints.",
              "details": "The invalid-prefix rule is safe when the stated constraint cannot be repaired by extension.",
              "wrongOptionExplanationsByOptionId": {
                "invalid_prefix": "That is sound because the violation persists."
              },
              "omittedCorrectExplanationsByOptionId": {
                "overshoot_with_negatives": "Negative values may repair the overshoot.",
                "worse_partial_score": "Future decisions may improve the score.",
                "long_segment": "The rule is invented rather than contract-derived."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-011",
            "prompt": "Which facts can support a sound remaining-capacity bound? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "remaining_slots",
                  "text": "The number of choices still required."
                },
                {
                  "id": "remaining_candidates",
                  "text": "The number of legal candidates still available."
                },
                {
                  "id": "candidate_reuse_rule",
                  "text": "Whether candidates may be reused."
                },
                {
                  "id": "global_call_count",
                  "text": "How many recursive calls have already occurred."
                }
              ],
              "acceptedOptionIds": [
                "remaining_slots",
                "remaining_candidates",
                "candidate_reuse_rule"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Capacity pruning compares required future work with the maximum legal supply.",
              "details": "The bound must reflect reuse and candidate constraints accurately.",
              "wrongOptionExplanationsByOptionId": {
                "global_call_count": "Instrumentation does not determine branch feasibility."
              },
              "omittedCorrectExplanationsByOptionId": {
                "remaining_slots": "This defines demand.",
                "remaining_candidates": "This defines maximum supply.",
                "candidate_reuse_rule": "Reuse changes available capacity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-pruning-012",
            "prompt": "Which grid conditions can justify pruning the current path? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "current_mismatch",
                  "text": "The current cell does not match the required target symbol."
                },
                {
                  "id": "cell_reused",
                  "text": "The current cell is already used by the path when reuse is forbidden."
                },
                {
                  "id": "out_of_bounds",
                  "text": "The coordinates are outside the grid."
                },
                {
                  "id": "neighbor_order",
                  "text": "The preferred neighbor is not tried first."
                }
              ],
              "acceptedOptionIds": [
                "current_mismatch",
                "cell_reused",
                "out_of_bounds"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "These checks reject states that violate immediate legality.",
              "details": "Neighbor ordering can affect performance but not correctness.",
              "wrongOptionExplanationsByOptionId": {
                "neighbor_order": "Traversal order does not make the branch impossible."
              },
              "omittedCorrectExplanationsByOptionId": {
                "current_mismatch": "This branch cannot represent the target prefix.",
                "cell_reused": "The move violates the path contract.",
                "out_of_bounds": "No legal cell exists there."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-pruning-013",
            "prompt": "Arrange the process for designing a pruning rule.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_condition",
                  "text": "State the partial condition to be tested."
                },
                {
                  "id": "prove_impossibility",
                  "text": "Prove that every completion from that condition violates the result contract."
                },
                {
                  "id": "implement_before_recurse",
                  "text": "Check the condition before expanding the branch."
                },
                {
                  "id": "test_counterexamples",
                  "text": "Test cases near the boundary where the condition becomes true or false."
                }
              ],
              "canonicalOrder": [
                "state_condition",
                "prove_impossibility",
                "implement_before_recurse",
                "test_counterexamples"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Pruning begins with a semantic proof, not with code or performance intuition.",
              "details": "Boundary tests help detect a condition that is too strong or too weak."
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-014",
            "prompt": "Arrange the remaining-slot capacity check for k-combination generation.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "compute_needed",
                  "text": "Compute needed = k - path.length."
                },
                {
                  "id": "compute_available",
                  "text": "Compute how many candidate indices remain."
                },
                {
                  "id": "compare_capacity",
                  "text": "If available < needed, return from the branch."
                },
                {
                  "id": "enumerate_if_possible",
                  "text": "Otherwise enumerate legal next candidates."
                }
              ],
              "canonicalOrder": [
                "compute_needed",
                "compute_available",
                "compare_capacity",
                "enumerate_if_possible"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The branch is expanded only when its remaining candidate capacity can satisfy the completion size.",
              "details": "This bound preserves completeness and can eliminate large impossible suffixes."
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-pruning-015",
            "prompt": "A backtracking tree has branching factor b and depth d. Sound pruning removes many branches on typical inputs but no reduction is guaranteed in the worst case. Select the worst-case visited-node bound and recursion depth.",
            "constraints": [
              "Some inputs may satisfy no pruning condition until the leaves."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "visited_nodes",
                "recursion_depth"
              ],
              "availableValuesByDimension": {
                "visited_nodes": [
                  "O(d)",
                  "O(bd)",
                  "O(b^d)",
                  "O(d^b)"
                ],
                "recursion_depth": [
                  "O(1)",
                  "O(b)",
                  "O(d)",
                  "O(b^d)"
                ]
              },
              "acceptedValuesByDimension": {
                "visited_nodes": [
                  "O(b^d)"
                ],
                "recursion_depth": [
                  "O(d)"
                ]
              },
              "normalizedAliasesByDimension": {
                "visited_nodes": {
                  "full_tree": "O(b^d)"
                },
                "recursion_depth": {
                  "depth_first": "O(d)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Pruning may improve actual exploration without changing the formal worst-case class.",
              "details": "Worst-case analysis must include inputs on which every branch remains feasible until deep in the tree."
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-016",
            "prompt": "A subset search makes an include-or-exclude choice for each of n values. Positive-only target pruning may reduce actual work, but select the standard worst-case leaves and recursion depth.",
            "constraints": [
              "A branch can make two choices at each input position.",
              "No pruning reduction is guaranteed for every input."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "leaves",
                "recursion_depth"
              ],
              "availableValuesByDimension": {
                "leaves": [
                  "O(n)",
                  "O(2^n)",
                  "O(n!)",
                  "O(n^n)"
                ],
                "recursion_depth": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(2^n)"
                ]
              },
              "acceptedValuesByDimension": {
                "leaves": [
                  "O(2^n)"
                ],
                "recursion_depth": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "leaves": {
                  "binary_decisions": "O(2^n)"
                },
                "recursion_depth": {
                  "one_decision_per_value": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The binary decision tree has up to 2^n leaves, while one active path contains n decisions.",
              "details": "Pruning can make many practical instances smaller but does not erase the worst-case tree."
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-017",
            "prompt": "An n-variable assignment solver tries unused values and uses conflict pruning. If every partial assignment remains conflict-free until full depth, select the number of complete branches and recursion depth.",
            "constraints": [
              "Each of n distinct values is used exactly once."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "complete_branches",
                "recursion_depth"
              ],
              "availableValuesByDimension": {
                "complete_branches": [
                  "O(n)",
                  "O(2^n)",
                  "O(n!)",
                  "O(n^n)"
                ],
                "recursion_depth": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n!)"
                ]
              },
              "acceptedValuesByDimension": {
                "complete_branches": [
                  "O(n!)"
                ],
                "recursion_depth": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "complete_branches": {
                  "permutations": "O(n!)"
                },
                "recursion_depth": {
                  "variables": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "When pruning finds no conflict, the solver still enumerates every permutation-like assignment.",
              "details": "This is another example of pruning effectiveness being input-dependent."
            },
            "taxonomy": {
              "primarySkillAtomId": "prune_impossible_partial_solution",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-pruning-018",
            "prompt": "A collect-all pruned solver returns s valid solutions, each of length d. Select a lower bound on output work and output space even if all invalid branches are pruned perfectly.",
            "constraints": [
              "Every valid solution must be materialized independently."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "output_work",
                "output_space"
              ],
              "availableValuesByDimension": {
                "output_work": [
                  "O(1)",
