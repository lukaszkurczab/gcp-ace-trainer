          },
          {
            "id": "alg-complexity-output-020",
            "prompt": "A function enumerates every subset of n elements and stores each subset as its elements. Select subset count and total materialized output volume.",
            "constraints": [
              "Each indexed element appears in exactly half of all subsets."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "subset_count",
                "output_volume"
