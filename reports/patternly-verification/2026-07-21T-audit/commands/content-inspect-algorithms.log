            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan",
                  "text": "Scan until a satisfying value is found or the array ends."
                },
                {
                  "id": "binary",
                  "text": "Binary-search the arbitrary condition because each check is O(1)."
                },
                {
                  "id": "mid_only",
                  "text": "Check only the midpoint."
                },
                {
                  "id": "sort_again",
                  "text": "Sort again by the same key."
                }
