            "id": "alg-linked-list-merge-splice-05-sequential-merge-cost",
            "difficulty": "intermediate"
          },
          {
            "prompt": "l1 references X(value=4) and l2 references Y(value=4). X and Y are distinct nodes, and the output must contain every input node. What should the merge do at this tie?",
            "constraints": [
              "X and Y are separately allocated and the input lists are disjoint.",
              "The merge is not a deduplication operation."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "replace_with_new",
                  "text": "Allocate one new node with value 4 and discard X and Y."
                },
                {
                  "id": "collapse_duplicate",
                  "text": "Include only one because equal values mean X and Y are the same node."
                },
                {
                  "id": "link_x_to_x",
                  "text": "Attach X and set X.next = X to record both equal occurrences."
                },
                {
                  "id": "choose_one_then_other",
                  "text": "Choose one according to the declared tie rule, advance only that source, and later include the other node too."
                }
              ],
              "acceptedOptionIds": [
                "choose_one_then_other"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equal payloads create an ordering tie, not an identity equivalence; completeness requires both distinct nodes.",
              "details": "A deterministic tie rule—often choosing from the first list—can preserve stability, but either choice is compatible with sortedness if specified. Only the chosen source advances, leaving the other equal-valued node for a later iteration. Collapsing nodes silently changes a merge into deduplication, a self-link creates a cycle, and a replacement loses both original identities.",
              "wrongOptionExplanationsByOptionId": {
                "collapse_duplicate": "Equal payloads do not make separately allocated nodes identical, and the output contract requires every node.",
                "link_x_to_x": "A self-cycle neither represents Y nor produces a valid sorted linear result.",
                "replace_with_new": "This violates node reuse and discards two required identities."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_nodes_without_losing_links",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_lists",
              "problemArchetypeId": "merge_ordered_lists"
            },
            "id": "alg-linked-list-merge-splice-06-equal-values-preserve-both-nodes",
            "difficulty": "intermediate"
          },
          {
            "prompt": "chosen references the smaller current source node, and chosenNext stores its original successor. tail is the last output node. Order the merge updates.",
            "constraints": [
              "chosenNext was captured before any chosen.next overwrite.",
              "tail and chosen are distinct before this step."
            ],
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "attach_chosen",
                  "text": "Set tail.next = chosen."
                },
                {
                  "id": "advance_source",
                  "text": "Set the chosen source head = chosenNext."
                },
                {
                  "id": "advance_tail",
                  "text": "Set tail = chosen."
                },
                {
                  "id": "preserve_output_exit",
                  "text": "Leave tail.next as the link that will be assigned on the next iteration or to the final remainder."
                }
              ],
              "canonicalOrder": [
                "attach_chosen",
                "advance_source",
                "advance_tail",
                "preserve_output_exit"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The chosen node is first attached to the existing output, its source frontier advances using the saved successor, and only then does tail become chosen.",
              "details": "attach_chosen -> advance_tail is the critical builder relation: if tail becomes chosen first and code then assigns tail.next = chosen, it creates a self-cycle. The source can advance safely because chosenNext already preserves its suffix. After tail advances, its next field is the output exit to be set by the next selected node or the final remainder. Equivalent code may combine assignments, but it must preserve these dependencies."
            },
            "taxonomy": {
              "primarySkillAtomId": "merge_nodes_without_losing_links",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_lists",
              "problemArchetypeId": "merge_ordered_lists"
            },
            "id": "alg-linked-list-merge-splice-07-attach-before-tail-advance",
            "difficulty": "advanced"
          },
          {
            "prompt": "Two sorted input heads eventually reach the same node S, so their tails are structurally shared. A standard node-reusing merge assumes disjoint inputs. What is the correct assessment?",
            "constraints": [
              "S is the same node object on both input paths.",
              "The algorithm reuses nodes and does not clone the shared suffix."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "dummy_fixes_alias",
                  "text": "Adding a dummy output head automatically removes the shared-tail hazard."
                },
                {
                  "id": "append_twice",
                  "text": "Appending S from each source produces two logical copies without allocation."
                },
                {
                  "id": "values_make_safe",
                  "text": "The standard loop is safe as long as S.value is ordered correctly."
                },
                {
                  "id": "needs_alias_handling",
                  "text": "The precondition is violated; the merge must detect the shared suffix and attach it once or reject the input."
                }
              ],
              "acceptedOptionIds": [
                "needs_alias_handling"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A shared node is one object reachable from both sources, so consuming it twice is not equivalent to consuming two distinct nodes.",
              "details": "The standard invariant partitions disjoint nodes between two unconsumed suffixes. Structural sharing breaks that partition: once one path attaches S, the other source may later designate the same object. Naive updates can duplicate a reference in the logical plan or create a cycle when the tail already reaches S. An alias-aware implementation can stop when l1 is l2 and attach the common suffix once; otherwise the input should be rejected.",
              "wrongOptionExplanationsByOptionId": {
                "values_make_safe": "Sorted payloads do not eliminate identity aliasing or prevent attaching one object twice.",
                "append_twice": "One node object cannot represent two independent occurrences in a linear chain without copying, and repeated attachment can create a cycle.",
                "dummy_fixes_alias": "A sentinel simplifies the first output edge but does not change input sharing."
              }
            },
