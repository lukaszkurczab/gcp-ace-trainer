        "items": [
          {
            "id": "alg-ctpsw-prcr-01",
            "prompt": "A sorted array must yield any two distinct positions whose values add to a target. Values between the two positions are not part of the candidate answer. Which model should drive the first linear-time strategy?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Use a two-pointers invariant."
                },
                {
                  "id": "sliding_window",
                  "text": "Use a sliding-window validity invariant."
                },
                {
                  "id": "indices_only",
                  "text": "Classify it as two pointers solely because two indices appear."
                }
              ],
              "acceptedOptionIds": [
                "two_pointers"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The candidate is a relation between two selected endpoints, not the interval between them.",
              "details": "Sorted order lets an endpoint comparison rule eliminate impossible pairs: a sum that is too small moves the lower endpoint, and a sum that is too large moves the higher endpoint. The elements between the endpoints are merely unexamined candidates; they are not maintained as one aggregate object. A sliding window would instead interpret every element from left through right as part of the current candidate and would need a validity or score rule for that entire range. The transfer test is therefore about the answer object, not the variable names: two selected positions support a pair relation, while a contiguous block whose interior matters supports a window.",
              "wrongOptionExplanationsByOptionId": {
                "sliding_window": "This is plausible because the endpoints enclose a range, but the enclosed values are not maintained or scored. A window becomes appropriate only when the whole contiguous range is the candidate.",
                "indices_only": "Two indices are necessary here but are not the reason for the classification. The decisive evidence is the pair relation plus the sorted-order elimination rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_pair_relation_from_contiguous_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "Input order is nondecreasing.",
              "Only the selected pair contributes to the target sum."
            ]
          },
          {
            "id": "alg-ctpsw-prcr-02",
            "prompt": "Given nonnegative costs in their original order, find the longest contiguous block whose total cost is at most B. A candidate is represented by [left, right], and every cost inside it contributes. Which pattern family matches that candidate?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Use a two-pointers invariant."
                },
                {
                  "id": "sliding_window",
                  "text": "Use a sliding-window validity invariant."
                },
                {
                  "id": "indices_only",
                  "text": "Classify it as two pointers solely because two indices appear."
                }
              ],
              "acceptedOptionIds": [
                "sliding_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The maintained object is the entire contiguous range, so its aggregate validity defines a sliding window.",
              "details": "The task does not ask for two costs that happen to satisfy a relation. It asks for one contiguous block, and adding or removing any interior member changes the block's total. A running sum can be updated when right expands and when left shrinks, so the algorithm maintains the state of [left, right] as one candidate. Nonnegative costs also make budget repair predictable: removing from the left cannot increase the total. If the requirement instead selected two endpoint values and ignored the interior, the candidate would stop being a window and could become a two-pointers relation.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers": "The two endpoints may look like a pair, but the score depends on all elements between them. Endpoint-only comparison would omit material state.",
                "indices_only": "The index count does not classify the algorithm. Here the decisive signal is that [left, right] is the complete candidate whose aggregate is maintained."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_pair_relation_from_contiguous_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "Costs are nonnegative.",
              "The chosen result must preserve original-order contiguity."
            ]
          },
          {
            "id": "alg-ctpsw-prcr-03",
            "prompt": "Task A asks whether a sorted sequence contains two values with sum T. Task B uses the same sequence but asks for the shortest contiguous segment with sum at least T; all values are positive. Which change is decisive for switching from a pair-search model to a window model?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "contiguous_output",
                  "text": "Task B makes every element between the boundaries part of the required output."
                },
                {
                  "id": "same_indices",
                  "text": "Both tasks can use variables named left and right."
                },
                {
                  "id": "sorted_input",
                  "text": "The sequence is sorted in both tasks."
                },
                {
                  "id": "target_value",
                  "text": "Both tasks compare a sum with T."
                }
              ],
              "acceptedOptionIds": [
                "contiguous_output"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Task B changes the candidate from two selected values to one contiguous range.",
              "details": "In Task A, the algorithm reasons about a relation between two values; the interior positions are possible future endpoints but are not part of the current candidate. In Task B, the entire interval contributes to the sum and its length is the optimization target, so the maintained state must represent that interval. Positivity supplies the monotone shrink condition needed for a simple variable window. The shared variable names, sortedness, and target value are surface similarities. The output contract is the structural difference that changes the pattern.",
              "wrongOptionExplanationsByOptionId": {
                "same_indices": "The same names can implement either pattern and therefore cannot decide between them.",
                "sorted_input": "Sortedness can support pair elimination, but it does not erase Task B's requirement that every interior element belongs to the answer.",
                "target_value": "Comparing against a target occurs in both families. What changes is whether two endpoints or an entire range constitute the candidate."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_pair_relation_from_contiguous_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Task B requires original-order contiguity.",
              "All values are positive."
            ]
          },
          {
            "id": "alg-ctpsw-prcr-04",
            "prompt": "A loop advances right, adds a[right] to a running total, repeatedly subtracts a[left] while the total exceeds a budget, and records right - left + 1. What is the correct classification?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers",
                  "text": "Use a two-pointers invariant."
                },
                {
                  "id": "sliding_window",
                  "text": "Use a sliding-window validity invariant."
                },
                {
                  "id": "indices_only",
                  "text": "Classify it as two pointers solely because two indices appear."
                }
              ],
              "acceptedOptionIds": [
                "sliding_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Entering and leaving elements update state for the whole contiguous interval.",
              "details": "The algorithm treats [left, right] as one candidate: expansion includes a new member, shrinkage excludes an old member, and the recorded answer is the interval length. Those operations are the signature of a maintained window. The mere presence of two moving indices is not enough to call the algorithm two pointers in the pair-search sense. A two-pointers loop would normally justify one endpoint movement from a relation between endpoint values or from a read/write invariant, without maintaining every interior element as the current candidate.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers": "This ignores the running state for every member of [left, right]. Endpoint movement is driven by window validity, not by eliminating endpoint pairs.",
                "indices_only": "The code does have two indices, but that observation does not identify the invariant or candidate object."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_pair_relation_from_contiguous_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The running total equals the sum of all elements currently between left and right.",
              "Every array value is nonnegative, so removing a left member cannot increase the running total."
            ]
          },
          {
            "id": "alg-ctpsw-prcr-05",
            "prompt": "A sorted sequence must yield two positions i < j whose values differ by at most D and whose index gap is at least G. Values strictly between i and j are not aggregated and need not satisfy anything. Which candidate model is structurally correct?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "pair_relation",
                  "text": "A relation between the selected endpoints."
                },
                {
                  "id": "contiguous_window",
                  "text": "A contiguous window containing every position from i through j."
                },
                {
                  "id": "both_by_notation",
                  "text": "Both models are equivalent because i and j bound a range."
                }
              ],
              "acceptedOptionIds": [
                "pair_relation"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The constraints are evaluated on the two chosen endpoints, not on all enclosed values.",
              "details": "The index gap mentions the distance between endpoints, but it does not turn the intervening elements into members of the candidate. The maintained decision is still whether a selected pair satisfies two endpoint relations. A contiguous window model would be required if the condition depended on the sum, frequencies, maximum, or another aggregate over every element from i through j. This distinction prevents a common overreach: geometric enclosure by two indices is not the same as semantic ownership of the enclosed range.",
              "wrongOptionExplanationsByOptionId": {
                "contiguous_window": "The endpoints do enclose a span, but the interior is not part of the candidate contract. A window requires the enclosed members to determine validity or score.",
                "both_by_notation": "The notation is shared, but the models are not equivalent. Candidate membership and the movement invariant determine the pattern."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_pair_relation_from_contiguous_window",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "advanced",
            "constraints": [
              "Only endpoint values and endpoint indices are tested.",
              "No interior aggregate is part of the requirement."
            ]
          }
        ],
