            "feedback": {
              "reason": "An accepted value must become the next element of the valid prefix before that prefix boundary grows.",
              "details": "The position write is exactly where the next kept value belongs. Copying first preserves the value, and incrementing write then records that the valid prefix has grown by one. Advancing read consumes the current input after it has been handled. Swapping with an end position would not preserve stable order and belongs to a different partition contract.",
              "wrongOptionExplanationsByOptionId": {
                "increment_write_only": "Growing the boundary without placing the accepted value leaves the output prefix semantically incomplete.",
                "advance_read_only": "The accepted value would be omitted from the compacted output because write still indicates the old prefix length.",
                "swap_with_end": "End swaps can partition but do not preserve the relative order required by stable compaction."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_read_write_pointer_invariant",
