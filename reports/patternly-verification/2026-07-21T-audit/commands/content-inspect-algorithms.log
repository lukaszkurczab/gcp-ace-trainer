        "items": [
          {
            "id": "alg-stack-nearest-01-nearest-not-largest",
            "prompt": "For each position, the required answer is the first later position with a strictly greater value. Which candidate satisfies the contract for value 2 in the suffix [3, 10]?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "first_3",
                  "text": "3, because it is the nearest later value greater than 2."
                },
                {
                  "id": "largest_10",
                  "text": "The position containing 10, because it is the greatest later value."
                },
                {
                  "id": "both",
                  "text": "Both positions are equally valid because both values are greater."
                },
                {
                  "id": "oldest_pending",
                  "text": "Whichever qualifying position entered the pending-state queue first."
                }
              ],
              "acceptedOptionIds": [
                "first_3"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The output boundary is nearest qualifying position, not maximum qualifying value.",
              "details": "Value 3 is encountered before 10 and already satisfies the strict-greater predicate, so it fixes the answer. Once the first qualifying position is found, later larger values cannot improve the nearest-right boundary. A monotonic-stack solution must preserve this directional answer contract; otherwise it can compute a different problem such as suffix maximum.",
              "wrongOptionExplanationsByOptionId": {
                "largest_10": "Largest value optimizes magnitude, but the requested objective is minimum rightward distance among qualifying positions.",
                "both": "Only one position is the first qualifying boundary; later qualifying positions are not equivalent.",
                "oldest_pending": "Queue age does not define nearest-right qualification for this position."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "resolve_nearest_greater_or_smaller",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "next_greater_smaller"
            }
          },
          {
            "id": "alg-stack-nearest-02-current-resolves-popped",
            "prompt": "In a left-to-right next-greater scan, current value 7 causes a pending position with value 4 to be popped. What answer is fixed at that moment?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "popped_gets_current",
                  "text": "The popped position's next-greater boundary is the current position containing 7."
                },
                {
                  "id": "current_gets_popped",
                  "text": "The current position's next-greater boundary is the earlier position containing 4."
                },
                {
                  "id": "both_unresolved",
                  "text": "Neither position can be resolved until the entire sequence is scanned."
                },
                {
                  "id": "pop_again_later",
                  "text": "The popped position remains pending so a later value can replace 7."
                }
              ],
              "acceptedOptionIds": [
                "popped_gets_current"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The current value is the first later strictly greater value that has reached the unresolved popped candidate.",
              "details": "The candidate remained on the stack through every earlier scanned position, which means none of them qualified to resolve it under the invariant. When 7 first exceeds 4, the current index is therefore the nearest qualifying boundary to the right. The popped occurrence is complete and is not reconsidered for a potentially larger but farther value.",
              "wrongOptionExplanationsByOptionId": {
                "current_gets_popped": "The earlier value 4 lies to the left and is smaller, so it cannot be a next-greater-to-the-right answer for 7.",
                "both_unresolved": "Waiting would discard the proof supplied by the maintained frontier and could replace the nearest answer with a farther one.",
                "pop_again_later": "A popped occurrence has a final nearest boundary and cannot be popped again."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "resolve_nearest_greater_or_smaller",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "next_greater_smaller"
            }
          },
          {
            "id": "alg-stack-nearest-03-nearest-trace",
            "prompt": "For the sequence [4, 1, 3, 2, 5], what is the next strictly greater value to the right of the value 1 at index 1?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_3",
                  "text": "3 at index 2."
                },
                {
                  "id": "value_5",
                  "text": "5 at index 4."
                },
                {
                  "id": "value_4",
                  "text": "4 at index 0."
                },
                {
                  "id": "none",
                  "text": "No qualifying value."
                }
              ],
              "acceptedOptionIds": [
                "value_3"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Index 2 is the first position to the right of index 1 whose value exceeds 1.",
              "details": "The scan reaches 3 before 5. At that point, the pending index 1 is resolved and removed. Value 5 is greater but farther away, while value 4 lies on the wrong side. This small trace isolates the directional and nearest constraints that must remain true regardless of the underlying implementation.",
              "wrongOptionExplanationsByOptionId": {
                "value_5": "5 is larger but not nearest; index 2 already supplies a qualifying boundary.",
                "value_4": "Index 0 is to the left and cannot answer a next-to-the-right query.",
                "none": "Both 3 and 5 qualify, and 3 is the first."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "resolve_nearest_greater_or_smaller",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "next_greater_smaller"
            }
          },
          {
            "id": "alg-stack-nearest-04-duplicate-strict-boundary",
            "prompt": "For the sequence [2, 2, 3], using a next strictly greater value contract, what are the answers for the two positions containing 2?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_get_3",
                  "text": "Both positions resolve to the value 3."
                },
                {
                  "id": "first_get_second_2",
                  "text": "The first 2 resolves to the second 2, and the second resolves to 3."
                },
                {
                  "id": "first_none_second_3",
                  "text": "The first 2 has no answer, while the second resolves to 3."
                },
                {
                  "id": "both_get_each_other",
                  "text": "Each equal value resolves the other."
                }
              ],
              "acceptedOptionIds": [
                "both_get_3"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equal values do not satisfy strict greater, so both 2s remain unresolved until 3 arrives.",
              "details": "The second 2 cannot close the first 2's query because equality fails the `>` predicate. Both positions remain pending, and the later 3 is the first strictly greater value to the right for each. A next-greater-or-equal contract would produce a different answer for the first position, which is why strictness must be explicit.",
              "wrongOptionExplanationsByOptionId": {
                "first_get_second_2": "The second value is equal, not strictly greater.",
                "first_none_second_3": "The later 3 lies to the right of both positions and strictly exceeds both.",
                "both_get_each_other": "The first 2 is not to the right of the second, and equality fails the predicate in either direction."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "resolve_nearest_greater_or_smaller",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "next_greater_smaller"
            }
          },
          {
            "id": "alg-stack-nearest-05-unresolved-sentinel",
            "prompt": "A next-strictly-greater-to-the-right scan finishes on [5, 4, 3]. What should happen to the still-unresolved positions?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "assign_no_boundary",
                  "text": "Assign the contract's no-boundary result, such as -1 or null, to all remaining positions."
                },
                {
                  "id": "use_stack_neighbor",
                  "text": "Use the next item deeper in the stack as each answer even though it is smaller."
                },
                {
                  "id": "keep_active_forever",
                  "text": "Keep the session active forever because unresolved positions may not leave a stack."
                },
                {
                  "id": "recurse_until_greater",
                  "text": "Generate recursive calls beyond the end of the input until a greater value appears."
                }
              ],
              "acceptedOptionIds": [
                "assign_no_boundary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "End of input is a decisive boundary: no later qualifying position can exist for any remaining candidate.",
              "details": "The decreasing sequence never supplies a greater value to the right. Remaining stack membership therefore means 'no boundary found,' not 'answer unavailable because processing is incomplete.' The output must use the explicit sentinel or optional representation defined by the prompt. The stack can then be discarded; it is not permanent storage.",
              "wrongOptionExplanationsByOptionId": {
                "use_stack_neighbor": "A smaller retained neighbor fails the greater predicate and cannot be substituted as an answer.",
                "keep_active_forever": "The input boundary finalizes unresolved candidates with a no-answer result; retained state need not persist.",
                "recurse_until_greater": "No values exist beyond the input, and recursion cannot fabricate a qualifying boundary."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "resolve_nearest_greater_or_smaller",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "next_greater_smaller"
            }
          },
          {
            "id": "alg-stack-nearest-06-distance-output",
            "prompt": "For [6, 1, 4, 2], the output is the distance to the next strictly greater position, or 0 when none exists. What is the output for index 1?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "distance_1",
                  "text": "1, because index 2 contains 4."
                },
                {
                  "id": "value_4",
                  "text": "4, because that is the greater value."
                },
                {
                  "id": "distance_2",
                  "text": "2, because index 3 is two steps away."
                },
                {
                  "id": "zero",
                  "text": "0, because 6 is the only value greater than 1."
                }
              ],
              "acceptedOptionIds": [
                "distance_1"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The nearest qualifying position is index 2, and the authored output contract asks for index distance rather than boundary value.",
              "details": "Index 2 is one step to the right and contains 4, which is greater than 1. The value 6 is greater but lies to the left, while index 3 contains 2 but is farther than the already qualifying index 2. This illustrates that the same boundary discovery can feed different output representations: value, index, or distance.",
              "wrongOptionExplanationsByOptionId": {
                "value_4": "4 identifies the boundary value but not the requested distance.",
                "distance_2": "Index 3 is farther and therefore cannot replace the nearer qualifying index 2.",
                "zero": "A qualifying later value exists at index 2; the earlier 6 is irrelevant to a next-right query."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "resolve_nearest_greater_or_smaller",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "next_greater_smaller"
            }
          },
          {
            "id": "alg-stack-nearest-07-previous-smaller-direction",
            "prompt": "A task asks for the nearest strictly smaller value to the left of each position. When scanning left to right, how is the current position's answer obtained after removing non-qualifying top candidates?",
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "surviving_top",
                  "text": "Use the nearest qualifying surviving top, or no boundary if empty."
                },
                {
                  "id": "current_resolves_all_left",
                  "text": "Assign the current position as the next-smaller answer for every earlier value, regardless of comparison."
                },
                {
                  "id": "queue_front",
                  "text": "Use the oldest qualifying candidate at the queue front after cleanup."
                },
                {
                  "id": "largest_left",
                  "text": "Use the largest retained value anywhere to the left after cleanup."
                }
              ],
              "acceptedOptionIds": [
                "surviving_top"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "For a previous-boundary query, cleanup removes candidates that cannot answer the current position, and the nearest surviving top is queried.",
              "details": "The scan direction now makes the left side already known. After removing values that are greater than or equal to the current value for a strict-smaller query, the top—if any—is the nearest remaining smaller value to the left. This differs from left-to-right next-boundary processing, where the current value often resolves popped earlier candidates.",
              "wrongOptionExplanationsByOptionId": {
                "current_resolves_all_left": "Only candidates satisfying the comparison can be related, and this option also answers a different directional question.",
                "queue_front": "The oldest retained candidate is generally not the nearest qualifying one.",
                "largest_left": "The predicate asks for smaller and nearest, not largest."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "resolve_nearest_greater_or_smaller",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "monotonic_increasing_stack"
            }
          },
          {
            "id": "alg-stack-nearest-08-circular-next-greater",
            "prompt": "For the circular sequence [5, 1, 2], what are the next strictly greater values when scanning may wrap once?",
