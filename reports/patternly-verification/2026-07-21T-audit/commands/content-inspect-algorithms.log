        "items": [
          {
            "id": "alg-contrast-binary-scan-transfer-001",
            "prompt": "Scenario A: one exact query on unsorted data. Scenario B: the same data is now maintained in sorted random-access form and receives many exact queries. How should the strategy transfer?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan_then_binary",
                  "text": "Use a scan in A; use binary search in B after verifying the maintained order and query key."
                },
                {
                  "id": "binary_both",
                  "text": "Use binary search in both because the task is called search."
                },
                {
                  "id": "scan_both",
                  "text": "Use scanning in both because it was correct in A."
                },
                {
                  "id": "sort_each",
                  "text": "Sort from scratch before every query in both scenarios."
                }
              ],
              "acceptedOptionIds": [
                "scan_then_binary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Strategy should change when the data representation and workload cross the transfer boundary.",
              "details": "The underlying query is similar, but legality and total cost differ between one unsorted query and many aligned sorted queries.",
              "wrongOptionExplanationsByOptionId": {
                "binary_both": "A has no legal half-discard rule.",
                "scan_both": "B adds stable ordered structure and repeated workload that favor binary search.",
                "sort_each": "A does not amortize sorting and B is already maintained sorted."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_binary_search_vs_scan_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-transfer-002",
            "prompt": "A sorted array initially asks for any exact target. The requirement changes to the first record in original insertion order among matching keys, and no provenance is stored. What changes?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "binary_to_scan",
                  "text": "The key-only binary search no longer satisfies the output contract; scan the original order or build a provenance-aware index."
                },
                {
                  "id": "same_binary",
                  "text": "Keep returning any midpoint match."
                },
                {
                  "id": "leftmost_sorted",
                  "text": "Return the leftmost sorted duplicate and assume it is earliest inserted."
                },
                {
                  "id": "no_solution",
                  "text": "The query is impossible under every representation."
                }
              ],
              "acceptedOptionIds": [
                "binary_to_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A change in output identity can invalidate an otherwise legal search strategy.",
              "details": "Binary search transfers again if the ordered index is enriched with the required original-position metadata.",
              "wrongOptionExplanationsByOptionId": {
                "same_binary": "The output identity contract changed.",
                "leftmost_sorted": "Sorted duplicate order need not preserve insertion order.",
                "no_solution": "Scanning the original or storing provenance can answer it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_binary_search_vs_scan_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-transfer-003",
            "prompt": "A predicate-search problem changes from “capacity at least x is feasible” to “capacity x is feasible only when x is even.” What strategy change is required?",
            "difficulty": "foundational",
