          {
            "id": "alg-contrast-window-prefix-objective-014",
            "prompt": "Which edge cases clarify the threshold-versus-exact boundary? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "zeros",
                  "text": "Zeros that create several windows with the same sum."
