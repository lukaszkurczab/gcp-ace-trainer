        "items": [
          {
            "id": "alg-contrast-binary-scan-monotonic-001",
            "prompt": "Which truth pattern supports a first-true binary search over increasing candidates?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "false_true_suffix",
                  "text": "false, false, ..., false, true, true, ..., true."
                },
                {
                  "id": "alternating",
                  "text": "false, true, false, true."
                },
                {
                  "id": "single_true",
                  "text": "false, false, true, false, false."
                },
                {
                  "id": "arbitrary",
                  "text": "Any pattern, provided mid is checked."
                }
              ],
              "acceptedOptionIds": [
                "false_true_suffix"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A first-true search needs one persistent false-to-true transition.",
              "details": "A false midpoint eliminates the prefix; a true midpoint retains the possibility of an earlier transition.",
              "wrongOptionExplanationsByOptionId": {
                "alternating": "Multiple transitions prevent one directional discard.",
                "single_true": "Truth does not remain true after the transition.",
                "arbitrary": "Midpoint evaluation cannot replace monotonicity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_monotonic_predicate_from_arbitrary_condition",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-monotonic-002",
            "prompt": "The condition P(i) is true when the sorted value at index i is at least target. Why is P monotonic?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sorted_suffix",
                  "text": "Once one value is at least target, every later sorted value is also at least target."
                },
                {
                  "id": "index_increases",
                  "text": "Indices increase numerically."
                },
                {
                  "id": "mid_exists",
                  "text": "A midpoint can be computed."
                },
                {
                  "id": "target_fixed",
                  "text": "The target is fixed."
                }
              ],
              "acceptedOptionIds": [
                "sorted_suffix"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Monotonicity is an implication across the ordered domain.",
              "details": "The sorted-value contract extends one true comparison to every later index.",
              "wrongOptionExplanationsByOptionId": {
                "index_increases": "Index order alone does not constrain the condition.",
                "mid_exists": "Every finite index range has a midpoint, including nonmonotonic conditions.",
                "target_fixed": "A fixed target does not make arbitrary input order monotonic."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_monotonic_predicate_from_arbitrary_condition",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-monotonic-003",
            "prompt": "The condition P(i) is true when the sorted value at index i is even. Which method is generally required to find the first even value?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan",
                  "text": "A scan, because parity can alternate throughout sorted numeric values."
                },
                {
                  "id": "binary",
                  "text": "Binary search, because the values are sorted."
                },
                {
                  "id": "first_true",
                  "text": "A first-true template without a monotonicity proof."
