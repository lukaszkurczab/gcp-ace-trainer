        "items": [
          {
            "id": "alg-tp-mistake-low-sum-both-move",
            "prompt": "Trace review A: on [1, 2, 4, 8] with target 10, the first sum is 9 and the implementation jumps to the inner pair 2+4. Which one-sided repair preserves the omitted witness?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "move_left_only",
                  "text": "Keep right at 8 and advance left, preserving the candidate 2+8."
                },
                {
                  "id": "move_right_only",
                  "text": "Keep left at 1 and retreat right."
                },
                {
                  "id": "move_both",
                  "text": "Keep the existing movement because it converges faster."
                },
                {
                  "id": "restart",
                  "text": "Reset both pointers after every mismatch."
                }
              ],
              "acceptedOptionIds": [
                "move_left_only"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The low sum eliminates only value 1. Moving right as well skips the valid pair 2+8.",
              "details": "The largest partner available to left=1 still yields a sum below target, so every pair using 1 is impossible. The right value 8 remains viable with a larger left value and must stay. This trace is a minimal counterexample to the move-both heuristic. The repair is one-sided movement derived from the ordered sum relation.",
              "wrongOptionExplanationsByOptionId": {
                "move_right_only": "A smaller right value cannot raise the sum, and it discards the endpoint needed for 2+8.",
                "move_both": "Faster convergence skips an unproved right-boundary candidate and loses the solution.",
                "restart": "Restarting revisits work and still lacks a movement invariant; it is not a bounded repair."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_invalid_pointer_movement",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory",
            "constraints": [
              "The array is sorted.",
              "The task is to find any pair summing to 10."
            ]
          },
          {
            "id": "alg-tp-mistake-high-sum-both-move",
            "prompt": "Trace review B starts from 2+14 on [2, 5, 9, 14] for target 11, then discards both endpoints. Which still-legal witness demonstrates the defect?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "nine_plus_fourteen",
                  "text": "9+14, even though it exceeds 11."
                },
                {
                  "id": "none",
                  "text": "No pair is at risk because a high sum eliminates both endpoints."
                },
                {
                  "id": "two_plus_nine",
                  "text": "2+9, because left=2 remains viable with a smaller right value."
                },
                {
                  "id": "five_plus_fourteen",
                  "text": "5+14, even though it exceeds 11."
                }
              ],
              "acceptedOptionIds": [
                "two_plus_nine"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A high sum eliminates right=14 but not left=2. Moving both skips 2+9.",
              "details": "The smallest remaining partner with 14 already produces a sum above target, so 14 cannot participate. The value 2 can still pair with a smaller right value and reaches the target with 9. The bug mirrors the low-sum case: one comparison eliminates one boundary class. Movement symmetry is not a correctness principle.",
              "wrongOptionExplanationsByOptionId": {
                "five_plus_fourteen": "This pair is not a target witness and uses the already-eliminated high boundary.",
                "nine_plus_fourteen": "It is a remaining pair after one move, but 9+14 is even farther above target and does not show why left=2 must be preserved. The decisive skipped witness is 2+9.",
                "none": "The comparison says nothing that eliminates left=2; the trace contains a concrete skipped solution."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_invalid_pointer_movement",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
