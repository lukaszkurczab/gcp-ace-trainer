        "items": [
          {
            "id": "alg-mg-normalize-canonical-residue-interval",
            "prompt": "A fixed-width signed integer coordinate x must wrap into [0,m), with 0<m and m possibly near the maximum representable value. The language may return a negative remainder. Which implementation preserves the cyclic value without an avoidable overflow?",
            "constraints": [
              "m is positive and representable in the working type.",
              "The language remainder r=x%m is defined for the supplied inputs."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "conditional_wrap",
                  "text": "Set r=x % m; return r < 0 ? r + m : r."
                },
                {
                  "id": "unconditional_double_mod",
                  "text": "Return ((x % m) + m) % m in the same fixed-width signed type."
                },
                {
                  "id": "single_mod",
                  "text": "Return x % m."
                },
                {
                  "id": "clamp",
                  "text": "Return min(max(x,0),m-1)."
                }
              ],
              "acceptedOptionIds": [
                "conditional_wrap"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Conditionally correcting only a negative remainder preserves the cyclic class and keeps the result below m.",
              "details": "The remainder r lies between -(m-1) and m-1. When r<0, r+m is in [1,m-1]; otherwise r is already in [0,m). This avoids the unnecessary near-2m intermediate of the familiar unconditional double-mod formula in a bounded signed type. A single raw remainder may stay negative, while clamping changes a cyclic coordinate into a bounded one and discards full turns.",
              "wrongOptionExplanationsByOptionId": {
                "unconditional_double_mod": "It is algebraically valid with unbounded or sufficiently wide arithmetic, but the stated fixed-width contract does not guarantee that a nonnegative r plus a near-maximum m fits.",
                "single_mod": "The stated language contract permits a negative result, which violates the target interval.",
                "clamp": "Clamping discards full-cycle equivalence instead of wrapping it."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "normalize_cyclic_or_coordinate_value",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "coordinate_transform",
              "problemArchetypeId": "normalize_coordinates"
            }
          },
          {
            "id": "alg-mg-normalize-angle-endpoint-convention",
            "prompt": "Angles are canonicalized to the half-open interval [-180,180). Under that convention, which representation is correct for an input of 540 degrees?",
            "constraints": [
              "Angles differing by multiples of 360 degrees are equivalent.",
              "The upper endpoint 180 is excluded."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "minus_180",
                  "text": "-180 degrees"
                },
                {
                  "id": "plus_180",
                  "text": "180 degrees"
                },
                {
                  "id": "zero",
                  "text": "0 degrees"
                },
                {
                  "id": "five_forty",
                  "text": "540 degrees because canonicalization must preserve the original magnitude."
                }
              ],
              "acceptedOptionIds": [
                "minus_180"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "540 is congruent to 180 modulo 360, and the half-open convention maps the excluded +180 endpoint to -180.",
              "details": "A canonical interval must choose exactly one representative for each direction. Because [-180,180) includes -180 but excludes +180, both 180 and 540 map to -180. Choosing [−180,180] would duplicate the same direction at both endpoints; choosing (−180,180] would instead keep +180. The convention is arbitrary but must be explicit and stable wherever equality, sorting, or shortest-turn decisions depend on it.",
              "wrongOptionExplanationsByOptionId": {
                "plus_180": "That endpoint is excluded by the stated half-open interval even though it is directionally equivalent.",
                "zero": "540 differs from 0 by 540, not by an integer multiple of 360.",
                "five_forty": "The purpose of canonicalization is to replace equivalent values with one representative, so the original magnitude is not retained."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "normalize_cyclic_or_coordinate_value",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "coordinate_transform",
              "problemArchetypeId": "normalize_coordinates"
            }
          },
          {
            "id": "alg-mg-normalize-period-domain",
            "prompt": "A function normalize(x,m) promises a result in [0,m). Which precondition and degenerate case are correct?",
            "constraints": [
              "The function uses integer cyclic normalization."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "m_positive_one_zero",
                  "text": "Require m>0; when m=1 the only result is 0, and m=0 is invalid."
                },
                {
                  "id": "m_zero_identity",
                  "text": "Allow m=0 and return x unchanged."
                },
                {
                  "id": "m_negative_interval",
                  "text": "Allow m<0 while keeping the same interval notation [0,m)."
                },
                {
                  "id": "m_one_values",
                  "text": "For m=1, both 0 and 1 are canonical results."
                }
              ],
              "acceptedOptionIds": [
                "m_positive_one_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A positive period is required to define an increasing half-open cycle, and period one collapses all values to zero.",
              "details": "Remainder by zero is undefined, so a zero-sized cycle must be rejected rather than silently treated as an identity transform. A negative period can be converted to a positive magnitude only if the API explicitly defines that normalization; it does not fit the stated [0,m) range. The m=1 boundary is valid and useful: every integer differs from zero by a multiple of one.",
              "wrongOptionExplanationsByOptionId": {
                "m_zero_identity": "Returning x would turn an invalid cyclic domain into an unrelated non-wrapping operation.",
                "m_negative_interval": "The interval [0,m) is not ordered as stated when m is negative, so the contract would be incoherent.",
                "m_one_values": "The half-open interval [0,1) contains only zero, and 1 is equivalent to zero."
              }
            },
            "difficulty": "foundational-boundary",
