      {
        "id": "ssc-queries-online-queries-after-build",
        "prompt": "The complete dataset is loaded before service starts. Queries then arrive online one at a time and require immediate answers, but the dataset remains unchanged. Which interpretation of query timing is correct?",
        "constraints": [
          "All data is available before the first query.",
          "Queries arrive later and are not known in advance.",
