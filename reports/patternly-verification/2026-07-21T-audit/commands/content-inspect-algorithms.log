          {
            "id": "alg-bits-xor-014",
            "prompt": "Which statements describe limitations of XOR cancellation? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "loses_counts",
                  "text": "It loses exact multiplicity beyond even versus odd."
                },
                {
                  "id": "two_uniques_combined",
                  "text": "Two uncancelled values remain combined as their XOR."
                },
                {
                  "id": "not_sum",
                  "text": "It cannot generally replace arithmetic addition."
                },
                {
                  "id": "requires_sort",
                  "text": "It requires sorted input."
                }
              ],
              "acceptedOptionIds": [
                "loses_counts",
                "two_uniques_combined",
                "not_sum"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
