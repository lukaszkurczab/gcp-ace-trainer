        "items": [
          {
            "prompt": "A singly linked list must be reversed in place with O(1) extra space. At the start of each iteration, which pair of references most directly represents the algorithm's two frontiers?",
            "constraints": [
              "The list is singly linked and acyclic.",
              "Existing nodes must be reused."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "prev_current",
                  "text": "prev is the head of the reversed prefix; current is the first node of the unreversed suffix."
                },
                {
                  "id": "head_tail_values",
                  "text": "headValue is the smallest payload; tailValue is the largest payload."
                },
                {
                  "id": "left_right_indices",
                  "text": "left and right are random-access indices into the list."
                },
                {
                  "id": "queue_stack",
                  "text": "A queue contains processed nodes and a stack contains unprocessed nodes."
                }
              ],
              "acceptedOptionIds": [
                "prev_current"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Iterative in-place reversal is organized around a reversed prefix frontier and an unreversed suffix frontier.",
              "details": "prev identifies the already reversed chain, while current identifies the next node whose outgoing link will be redirected. A temporary successor reference preserves the rest during each step. Value order is irrelevant, linked lists do not provide intrinsic left/right indexing, and auxiliary containers would violate the O(1)-space constraint.",
              "wrongOptionExplanationsByOptionId": {
                "head_tail_values": "Reversal changes link direction, not the ordering rule of payload values.",
                "left_right_indices": "A singly linked list does not provide direct indexed access to symmetric positions.",
                "queue_stack": "Storing all nodes in containers uses O(n) extra space and is unnecessary for the iterative in-place method."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reverse_link_direction_iteratively",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "reverse_list",
              "problemArchetypeId": "reverse_linked_structure"
            },
            "id": "alg-linked-list-reverse-iterative-01-prev-current-signal",
            "difficulty": "introductory"
          },
          {
            "prompt": "During iterative reversal, select all statements that must hold immediately before each loop iteration under the standard prev/current algorithm.",
            "constraints": [
              "No node is allocated or deleted.",
              "The list contains no cycle before reversal."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "original_head_still_entry",
                  "text": "The original head remains the entry pointer of the final list throughout the loop."
                },
                {
                  "id": "current_unprocessed_entry",
                  "text": "current is either null or the first node not yet included in the reversed prefix."
                },
                {
                  "id": "values_sorted",
                  "text": "The processed payload values are in sorted order."
                },
                {
                  "id": "prev_reversed_prefix",
                  "text": "Following next from prev visits exactly the already processed nodes in reverse of their original order."
                }
              ],
              "acceptedOptionIds": [
                "prev_reversed_prefix",
                "current_unprocessed_entry"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The loop partitions the original nodes into a reversed prefix reachable from prev and an unreversed suffix reachable from current.",
              "details": "The invariant describes both ownership and reachability. Every processed node appears exactly once behind prev with reversed links, while current preserves the entry to all unprocessed nodes. When current becomes null, the partition is complete and prev is the new head. Payload sorting is unrelated, and the original head becomes the final tail after its link is reversed.",
              "wrongOptionExplanationsByOptionId": {
                "values_sorted": "Reversal does not compare or sort payload values.",
                "original_head_still_entry": "The original head ceases to be the final entry; it becomes the tail in a nonempty list."
              },
              "omittedCorrectExplanationsByOptionId": {
                "prev_reversed_prefix": "Without the processed-prefix invariant, the algorithm has no proof that earlier links are correct.",
                "current_unprocessed_entry": "Without preserving the unprocessed entry, remaining nodes may be lost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reverse_link_direction_iteratively",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "reverse_list",
              "problemArchetypeId": "reverse_linked_structure"
            },
            "id": "alg-linked-list-reverse-iterative-02-loop-invariant",
            "difficulty": "intermediate"
          },
          {
            "prompt": "The standard iterative reverse initializes prev = null and current = head, then loops while current is not null. What should it return for an empty list and for a one-node list S -> null?",
            "constraints": [
              "The input is an ordinary acyclic singly linked list.",
              "The function returns the new head reference."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "null_and_s",
                  "text": "Return null for the empty list and S for the one-node list."
                },
                {
                  "id": "error_both",
                  "text": "Treat both inputs as invalid because no pair of nodes can be swapped."
                },
                {
                  "id": "dummy_and_null",
                  "text": "Return a new dummy node for the empty list and null for the one-node list."
                },
