        "items": [
          {
            "id": "alg-binary-search-signal-001",
            "prompt": "Which property most directly justifies binary search?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "legal_discard",
                  "text": "After evaluating a midpoint, one side can be proven unable to contain the answer."
                },
                {
                  "id": "large_input",
                  "text": "The input contains many elements."
                },
                {
                  "id": "numeric_values",
                  "text": "The values are numeric."
                },
                {
                  "id": "mid_variable",
                  "text": "The implementation uses a variable named mid."
                }
              ],
              "acceptedOptionIds": [
                "legal_discard"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Binary search is legal only when midpoint information proves that an entire region can be discarded.",
              "details": "The decisive signal is a correctness-preserving partition of the search space, not a keyword, data type, or input size.",
              "wrongOptionExplanationsByOptionId": {
                "large_input": "Large input creates a performance need, not a correctness rule.",
                "numeric_values": "Binary search can work on non-numeric ordered domains, and numbers alone do not create a discard rule.",
                "mid_variable": "A midpoint variable does not prove correctness or logarithmic progress."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-signal-002",
            "prompt": "A sorted array is searched for a value using an arbitrary predicate that can be true, then false, then true again. Is binary search justified by sorted input alone?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_nonmonotonic",
                  "text": "No. The predicate does not define one discardable boundary."
                },
                {
                  "id": "yes_sorted",
                  "text": "Yes. Sorted values always make every predicate binary-searchable."
                },
                {
                  "id": "yes_mid",
                  "text": "Yes, as long as a midpoint is inspected."
                },
                {
                  "id": "yes_large",
                  "text": "Yes, when the array is large enough."
                }
              ],
              "acceptedOptionIds": [
                "no_nonmonotonic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorted input is not sufficient when the searched property lacks monotonic structure.",
              "details": "Binary search requires a relation between midpoint evidence and the region that can be removed. A predicate with multiple truth transitions provides no such global boundary.",
              "wrongOptionExplanationsByOptionId": {
                "yes_sorted": "Sorting the values does not make an unrelated predicate monotonic.",
                "yes_mid": "Midpoint inspection needs a valid elimination rule.",
                "yes_large": "Size does not repair a correctness defect."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "monotonic_predicate_search",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-signal-003",
            "prompt": "Which task has a clear binary-search signal?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "first_true",
                  "text": "Find the first integer x for which a monotonic predicate feasible(x) becomes true."
                },
                {
                  "id": "count_letters",
                  "text": "Count the frequency of each character in a string."
                },
                {
                  "id": "all_permutations",
                  "text": "Generate every permutation of n values."
                },
                {
                  "id": "running_sum",
                  "text": "Compute all prefix sums."
                }
              ],
              "acceptedOptionIds": [
                "first_true"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A monotonic false-to-true transition creates a searchable boundary.",
              "details": "Evaluating feasible(mid) identifies which side cannot contain the first true value.",
              "wrongOptionExplanationsByOptionId": {
                "count_letters": "Frequency accumulation does not halve a search domain.",
                "all_permutations": "Enumeration requires exploring many branches rather than discarding one half.",
                "running_sum": "Prefix accumulation is deterministic linear processing."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "monotonic_predicate_search",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-signal-004",
            "prompt": "An unsorted array must be searched for one exact value, and no preprocessing is allowed. Which conclusion is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_scan",
                  "text": "Binary search is not justified because comparisons at mid do not eliminate either side."
                },
                {
                  "id": "binary_anyway",
                  "text": "Binary search is valid because exact equality can be checked at mid."
                },
                {
                  "id": "sort_implicitly",
                  "text": "The algorithm may behave as though the input were sorted."
                },
                {
                  "id": "use_mid_parity",
                  "text": "The parity of mid determines which side to discard."
                }
              ],
              "acceptedOptionIds": [
                "linear_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Without ordering or another monotonic structure, midpoint comparison does not provide directional evidence.",
              "details": "A linear scan remains correct because every position may contain the target.",
              "wrongOptionExplanationsByOptionId": {
                "binary_anyway": "A mismatch at mid gives no direction in an unsorted array.",
                "sort_implicitly": "Correctness cannot assume an unstated order.",
                "use_mid_parity": "Index parity is unrelated to target location."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-signal-005",
            "prompt": "A problem asks for the smallest capacity that can process all jobs within a deadline, and larger capacities never make the schedule worse. What is the binary-search signal?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "monotonic_feasibility",
                  "text": "Feasibility changes monotonically from false to true as capacity increases."
                },
                {
                  "id": "jobs_sorted",
                  "text": "The jobs can be sorted."
                },
                {
                  "id": "capacity_numeric",
                  "text": "Capacity is numeric."
                },
                {
                  "id": "deadline_large",
                  "text": "The deadline value is large."
                }
              ],
              "acceptedOptionIds": [
                "monotonic_feasibility"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The answer domain has a first feasible capacity.",
              "details": "Testing a candidate capacity proves that all smaller or all larger candidates can be discarded, depending on the result.",
              "wrongOptionExplanationsByOptionId": {
                "jobs_sorted": "Sorting may help the predicate but does not define the answer boundary.",
                "capacity_numeric": "A numeric domain alone is not enough.",
                "deadline_large": "Magnitude does not establish a discard rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-signal-006",
            "prompt": "Which statement is an unsafe heuristic?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sorted_implies_binary",
                  "text": "\"The input is sorted, so binary search must be the best choice.\""
                },
                {
                  "id": "discard_rule",
                  "text": "\"A midpoint comparison proves one region cannot contain the answer.\""
                },
                {
                  "id": "monotonic_boundary",
                  "text": "\"The predicate has one truth transition over an ordered domain.\""
                },
                {
                  "id": "ordered_half",
                  "text": "\"In a rotated array with distinct values, one half is still ordered.\""
                }
              ],
              "acceptedOptionIds": [
                "sorted_implies_binary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorted input is helpful only when the query and cost model make midpoint elimination legal and useful.",
              "details": "A one-off linear scan may be simpler, and some predicates over sorted data remain non-monotonic.",
              "wrongOptionExplanationsByOptionId": {
                "discard_rule": "This is the central correctness argument.",
                "monotonic_boundary": "This supports boundary search.",
                "ordered_half": "This can support a rotated-array discard rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-signal-007",
            "prompt": "Why does using left, right, and mid not by itself prove O(log n) time?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "must_shrink",
                  "text": "The active search interval must shrink by a constant factor and midpoint work must be bounded."
                },
                {
                  "id": "variable_names",
                  "text": "Variable names determine asymptotic complexity."
                },
                {
                  "id": "three_variables",
                  "text": "Any algorithm with three variables is logarithmic."
                },
                {
                  "id": "integer_indices",
                  "text": "Integer indices always produce halving."
                }
              ],
              "acceptedOptionIds": [
                "must_shrink"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Logarithmic iteration count comes from strict halving of the remaining domain.",
              "details": "If updates retain the same interval or the predicate evaluation is expensive, the total complexity can be non-logarithmic.",
              "wrongOptionExplanationsByOptionId": {
                "variable_names": "Names have no semantic effect.",
                "three_variables": "Variable count does not determine iteration count.",
                "integer_indices": "Updates may fail to shrink or may move by one position."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-signal-008",
            "prompt": "A rotated sorted array contains distinct values. Why can binary search still be legal?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_half_ordered",
                  "text": "At least one half of the active interval is ordered, allowing a target-range test."
                },
                {
                  "id": "rotation_removed",
                  "text": "Rotation automatically disappears after choosing mid."
                },
                {
                  "id": "all_values_equal",
                  "text": "All values become equal after rotation."
                },
                {
                  "id": "pivot_known",
                  "text": "The pivot is always given explicitly."
                }
              ],
              "acceptedOptionIds": [
                "one_half_ordered"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Distinct-value rotation preserves enough local order to identify one sorted half.",
              "details": "The target's membership in that ordered half determines which region can be discarded.",
              "wrongOptionExplanationsByOptionId": {
                "rotation_removed": "The array remains rotated.",
                "all_values_equal": "Rotation preserves values and distinctness.",
                "pivot_known": "Rotated search can work without a known pivot."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-signal-009",
            "prompt": "A predicate over indices follows false, true, false, true. What is the correct diagnosis?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "not_monotonic",
                  "text": "It is not a valid single-boundary predicate for ordinary binary search."
                },
                {
                  "id": "first_true_valid",
                  "text": "It is valid because a first true value exists."
                },
                {
                  "id": "sorted_indices",
                  "text": "It is valid because indices are ordered."
                },
                {
                  "id": "mid_fixes",
                  "text": "Choosing a different midpoint formula makes it monotonic."
                }
              ],
              "acceptedOptionIds": [
                "not_monotonic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Ordinary boundary search needs one directional truth transition.",
              "details": "Multiple transitions mean a midpoint result does not eliminate an entire side safely.",
              "wrongOptionExplanationsByOptionId": {
                "first_true_valid": "Existence of a first true does not imply later values remain true.",
                "sorted_indices": "An ordered domain is necessary but not sufficient.",
                "mid_fixes": "Midpoint bias cannot change predicate semantics."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "monotonic_predicate_search",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-signal-010",
            "prompt": "A sorted array is queried once for whether any element satisfies an expensive non-monotonic condition. What should determine the strategy?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "predicate_structure",
                  "text": "Whether the condition supports a legal elimination rule, not merely that the values are sorted."
                },
                {
                  "id": "always_binary",
                  "text": "Binary search is always faster on sorted arrays."
                },
                {
                  "id": "always_sort_again",
                  "text": "Sort the array again before searching."
                },
                {
                  "id": "mid_sample",
                  "text": "Check only the midpoint and return its condition result."
                }
              ],
              "acceptedOptionIds": [
                "predicate_structure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The query semantics determine whether sorted order is useful.",
              "details": "Binary search is a reasoning pattern built on elimination, not a general-purpose shortcut for sorted inputs.",
              "wrongOptionExplanationsByOptionId": {
                "always_binary": "No correctness rule has been established.",
                "always_sort_again": "The array is already sorted, and sorting does not make the predicate monotonic.",
                "mid_sample": "One sample cannot answer an existential query without structure."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-signal-011",
            "prompt": "Which problem most naturally supports searching for the last valid value?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "max_feasible",
                  "text": "Find the greatest threshold for which a monotonic feasibility predicate remains true."
                },
                {
                  "id": "arbitrary_local_max",
                  "text": "Find any local maximum in an arbitrary unsorted sequence using the same rule for every input."
                },
                {
                  "id": "count_occurrences_unsorted",
                  "text": "Count occurrences in an unsorted array without preprocessing."
                },
                {
                  "id": "enumerate_subsets",
                  "text": "Generate every subset."
                }
              ],
              "acceptedOptionIds": [
                "max_feasible"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A true-to-false predicate over an ordered domain defines a last-true boundary.",
              "details": "Midpoint feasibility determines which side can still contain a larger valid threshold.",
              "wrongOptionExplanationsByOptionId": {
                "arbitrary_local_max": "No monotonic predicate has been established.",
                "count_occurrences_unsorted": "Every element may need inspection.",
                "enumerate_subsets": "Enumeration does not discard one region."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "monotonic_predicate_search",
              "problemArchetypeId": "find_last_valid_position"
            }
          },
          {
            "id": "alg-binary-search-signal-012",
            "prompt": "When can repeated queries make preprocessing for binary search attractive?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "many_queries",
                  "text": "When one preprocessing cost enables many later logarithmic queries and the order contract permits it."
                },
                {
                  "id": "one_query_always",
                  "text": "For every single query regardless of preprocessing cost."
                },
                {
                  "id": "order_must_preserve",
                  "text": "When original order must be preserved but indices are discarded."
                },
                {
                  "id": "predicate_nonmonotonic",
                  "text": "When the query predicate remains non-monotonic after preprocessing."
                }
              ],
              "acceptedOptionIds": [
                "many_queries"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Strategy choice should include both preprocessing and query volume.",
              "details": "A sorted or indexed representation can pay off across many searches, but only if it preserves the required semantics.",
              "wrongOptionExplanationsByOptionId": {
                "one_query_always": "A one-off sort can cost more than a scan.",
                "order_must_preserve": "Destroying required order may violate the contract.",
                "predicate_nonmonotonic": "Binary search still lacks a valid boundary."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-signal-013",
            "prompt": "Which features are strong binary-search signals? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "ordered_domain",
                  "text": "The candidate domain has a total order."
                },
                {
                  "id": "discard_proof",
                  "text": "Midpoint evidence proves an entire region cannot contain the answer."
                },
                {
                  "id": "single_transition",
                  "text": "A predicate changes truth value at most once in the searched direction."
                },
                {
                  "id": "large_only",
                  "text": "The input is large, with no other structure."
                }
              ],
              "acceptedOptionIds": [
                "ordered_domain",
                "discard_proof",
                "single_transition"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Binary search needs an ordered domain, a single-boundary structure, and a legal discard rule.",
              "details": "Performance pressure may motivate the search for such structure but does not create it.",
              "wrongOptionExplanationsByOptionId": {
                "large_only": "Size alone gives no correctness proof."
              },
              "omittedCorrectExplanationsByOptionId": {
                "ordered_domain": "A direction requires ordered candidates.",
                "discard_proof": "This is the elimination contract.",
                "single_transition": "A single transition defines a boundary."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "monotonic_predicate_search",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-signal-014",
            "prompt": "Which observations are insufficient by themselves to justify binary search? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sorted_values",
                  "text": "The data values are sorted."
                },
                {
                  "id": "uses_mid",
                  "text": "The proposed code uses a midpoint variable."
                },
                {
                  "id": "numeric_answer",
                  "text": "The desired answer is numeric."
                },
                {
                  "id": "monotonic_predicate",
                  "text": "The predicate is proven monotonic over an ordered finite domain."
                }
              ],
              "acceptedOptionIds": [
                "sorted_values",
                "uses_mid",
                "numeric_answer"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Surface properties do not replace the half-discard proof.",
              "details": "A proven monotonic predicate is different because it directly establishes the searchable boundary.",
              "wrongOptionExplanationsByOptionId": {
                "monotonic_predicate": "This is a substantive binary-search foundation."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sorted_values": "The query may not align with that order.",
                "uses_mid": "Syntax does not prove elimination or progress.",
                "numeric_answer": "Numeric domains may still have non-monotonic feasibility."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "monotonic_predicate_search",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-signal-015",
            "prompt": "Which tasks can legally use a binary-search family mechanism? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "exact_sorted",
                  "text": "Find an exact target in ascending sorted data."
                },
                {
                  "id": "first_true",
                  "text": "Find the first true value of a false-to-true monotonic predicate."
                },
                {
                  "id": "rotated_distinct",
                  "text": "Find a target in a rotated sorted array with distinct values."
                },
                {
                  "id": "arbitrary_unsorted",
                  "text": "Find a target in arbitrary unsorted data without preprocessing."
                }
              ],
              "acceptedOptionIds": [
                "exact_sorted",
                "first_true",
                "rotated_distinct"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each accepted task has a specific invariant that supports directional elimination.",
              "details": "The unsorted exact-search case does not.",
              "wrongOptionExplanationsByOptionId": {
                "arbitrary_unsorted": "A midpoint mismatch gives no direction."
              },
              "omittedCorrectExplanationsByOptionId": {
                "exact_sorted": "Comparison determines the only side where the target can remain.",
                "first_true": "The truth transition is a searchable boundary.",
                "rotated_distinct": "One active half remains ordered."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-signal-016",
            "prompt": "A binary search examines O(log W) candidate values, and evaluating the monotonic predicate once costs P(n). Select the total time and iterative auxiliary space.",
            "constraints": [
              "W is the size of the ordered candidate range.",
              "The predicate does not allocate growing persistent state between iterations."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(log W)",
                  "O(P(n))",
                  "O(P(n) log W)",
                  "O(W·P(n))"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log W)",
                  "O(P(n))",
                  "O(W)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(P(n) log W)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "predicate_times_iterations": "O(P(n) log W)"
                },
                "auxiliary_space": {
                  "iterative": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Binary search controls the number of predicate calls, not the internal cost of one call.",
              "details": "The total time multiplies predicate cost by logarithmic iterations. An iterative search needs only boundary variables outside predicate-local memory."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_legal_half_discard_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          }
        ],
