          {
            "id": "alg-hms-complexity-string-key-cost",
            "prompt": "An algorithm processes n strings of length m. Each iteration hashes the entire current string and performs one expected O(1) table lookup after the hash is computed. Classify expected time and extra space if all n strings may be retained as keys.",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "extra_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n)",
                  "O(n + m)",
                  "O(n * m)",
                  "O(n * m log m)",
                  "O(n^2)"
                ],
                "extra_space": [
                  "O(1)",
                  "O(n)",
                  "O(m)",
                  "O(n * m)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n * m)"
                ],
                "extra_space": [
                  "O(n * m)"
                ]
              },
              "normalizedAliasesByDimension": {},
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Hashing each length-m key costs O(m), so key processing dominates expected constant table access.",
              "details": "The O(1) lookup description begins after a hash code and relevant comparisons are available; it does not make arbitrary-size key processing free. Across n strings, reading or hashing all characters costs O(nm). Retaining all string keys can also require O(nm) space, depending on whether the table stores references or copied key content under the item’s accounting convention."
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_expected_hash_lookup_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "detect_duplicate_or_membership"
            },
            "difficulty": "advanced",
            "constraints": [
              "Assume hashing reads all m characters.",
              "Count retained key content as extra space for this item."
            ]
          },
          {
            "id": "alg-hms-complexity-adversarial-guarantee-boundary",
            "prompt": "A system requires a deterministic O(log n) or better worst-case lookup guarantee for attacker-controlled keys. Which conclusion is safest?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "need_specified_guarantee",
                  "text": "Do not rely on a generic expected-O(1) hash claim; choose an implementation with a documented worst-case bound or an ordered alternative."
                },
                {
                  "id": "generic_hash_enough",
                  "text": "Any hash map automatically provides worst-case O(1), so no implementation detail matters."
                },
                {
                  "id": "set_instead_of_map",
                  "text": "Replacing the map with a set creates the required worst-case guarantee."
                }
              ],
              "acceptedOptionIds": [
                "need_specified_guarantee"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A worst-case requirement must be satisfied by a documented data-structure guarantee, not by an expected hash-table heuristic.",
              "details": "Algorithm analysis often accepts expected O(1) hashing, but adversarial inputs change the required evidence. An ordered tree can provide O(log n) worst-case operations, or a hardened hash implementation may document stronger behavior. The choice must be based on actual guarantees and key model, not container name.",
              "wrongOptionExplanationsByOptionId": {
                "generic_hash_enough": "Expected performance under ordinary distribution is not the deterministic worst-case guarantee required by the threat model.",
                "set_instead_of_map": "Set and map often share the same underlying hash behavior; changing payload semantics does not strengthen collision guarantees."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_expected_hash_lookup_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "detect_duplicate_or_membership"
            },
            "difficulty": "advanced"
          },
          {
            "id": "alg-hms-complexity-set-map-same-cost-different-state",
            "prompt": "A set and a map use the same hash-table implementation and therefore have similar expected key-operation complexity. Which statement remains true?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "payload_semantics_differ",
                  "text": "The map can preserve a payload such as count or index, while the set preserves membership only."
                },
                {
                  "id": "interchangeable",
                  "text": "They are interchangeable for every algorithm because their expected complexity is similar."
                },
                {
                  "id": "set_has_counts",
                  "text": "The set implicitly preserves exact counts for repeated insertions."
                }
              ],
              "acceptedOptionIds": [
                "payload_semantics_differ"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Complexity equivalence does not erase the semantic difference between membership and key-to-value association.",
              "details": "Choosing between set and map is first an information decision. Only after both candidates are semantically valid should cost and memory decide among them. A count map, index map, and grouping map can share the same expected lookup class while supporting materially different algorithms.",
              "wrongOptionExplanationsByOptionId": {
                "interchangeable": "Similar asymptotic access cost does not make two representations encode the same information or invariant.",
                "set_has_counts": "Repeated insertion of the same key leaves one membership entry and does not expose multiplicity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_expected_hash_lookup_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "preserve_original_index"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-complexity-presence-count-same-cost",
            "prompt": "A seen set and a frequency map both take expected O(n) time over n fixed-width inputs. Why can the frequency map still be necessary?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "different_information",
                  "text": "The output distinguishes multiplicities, which the set does not preserve."
                },
                {
                  "id": "map_faster",
                  "text": "The map is asymptotically faster than the set."
                },
                {
                  "id": "set_worst_linear_map_constant",
                  "text": "Only the set has collision worst cases; the map is worst-case constant."
                }
              ],
              "acceptedOptionIds": [
                "different_information"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equal expected runtime does not make presence and multiplicity equivalent; the required answer determines the payload.",
              "details": "Both algorithms may execute one hash operation per input element, but they compute different functions. The set returns membership information; the frequency map retains counts. Complexity analysis can compare valid strategies, but it cannot justify discarding information the output requires.",
              "wrongOptionExplanationsByOptionId": {
                "map_faster": "Under the same implementation assumptions, both commonly have the same expected aggregate time class.",
                "set_worst_linear_map_constant": "Sets and maps can share the same collision behavior; payload type does not remove worst cases."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_expected_hash_lookup_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-complexity-order-not-decided-by-o1",
            "prompt": "A developer argues that inserting before checking is harmless because both operations are expected O(1). What is the flaw?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "semantics_not_cost",
                  "text": "Operation order changes the state invariant and may allow the current occurrence to satisfy a prior-occurrence check; equal cost does not make the orders equivalent."
                },
                {
                  "id": "check_more_expensive",
                  "text": "Lookup is always asymptotically more expensive than insertion."
                },
                {
                  "id": "insert_never_allowed",
                  "text": "Hash algorithms must never insert before any check."
                }
              ],
              "acceptedOptionIds": [
                "semantics_not_cost"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Complexity describes resource cost, while operation order determines which occurrences and state transitions are semantically visible.",
              "details": "In duplicate or complement lookup, the table must represent earlier elements when checked, so insertion first can create a false self-match. In grouping, creating a bucket before appending is appropriate because existence is not evidence of a prior member. Expected O(1) for both operations says nothing about this distinction.",
              "wrongOptionExplanationsByOptionId": {
                "check_more_expensive": "Both operations may share expected cost; the issue is what state each operation observes, not an asymptotic difference.",
                "insert_never_allowed": "Initialization-before-use is correct in grouping and other workflows; order depends on the invariant, not a universal prohibition."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_expected_hash_lookup_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "complement_lookup",
              "problemArchetypeId": "find_pair_with_condition"
            },
            "difficulty": "advanced"
          }
