        "items": [
          {
            "id": "alg-contrast-hash-sort-lookup-001",
            "prompt": "A stream must report whether each arriving identifier has been seen before; result order follows arrival order and no sorted output is required. Which primary signal is strongest?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_lookup",
                  "text": "Equality-based membership state favors a hash set."
                },
                {
                  "id": "sort_all",
                  "text": "Sorting is required because duplicate detection always needs adjacency."
                },
                {
                  "id": "compare_neighbors",
                  "text": "Compare only consecutive arrivals."
                },
                {
                  "id": "binary_search_unsorted",
                  "text": "Binary-search the unsorted arrivals."
                }
              ],
              "acceptedOptionIds": [
                "hash_lookup"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The decisive operation is repeated equality-based membership lookup.",
              "details": "A hash set directly represents seen identifiers and can preserve arrival-order processing without first imposing an ordering.",
              "wrongOptionExplanationsByOptionId": {
                "sort_all": "Sorting can expose adjacent duplicates, but online seen-before lookup does not require order.",
                "compare_neighbors": "Equal identifiers may be separated by many other values.",
                "binary_search_unsorted": "Binary search lacks a sorted search domain."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-002",
            "prompt": "A report must list all distinct values in ascending order and combine equal values into adjacent groups. Which signal favors sorting?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ordered_groups",
                  "text": "The output requires deterministic value order and equal-run adjacency."
                },
                {
                  "id": "hash_expected",
                  "text": "Hash lookup is expected O(1), so ordering requirements can be ignored."
                },
                {
                  "id": "one_pass_name",
                  "text": "The implementation should contain one loop."
                },
                {
                  "id": "first_seen_only",
                  "text": "Only first-seen membership matters."
                }
              ],
              "acceptedOptionIds": [
                "ordered_groups"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorting directly creates the adjacency and order consumed by the result.",
              "details": "A hash map could count values, but a later key sort would reintroduce ordering cost and should be included in the strategy comparison.",
              "wrongOptionExplanationsByOptionId": {
                "hash_expected": "A hash table does not by itself produce ascending groups.",
                "one_pass_name": "Loop count does not establish the required output order.",
                "first_seen_only": "The contract explicitly requires ascending grouped output."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-003",
            "prompt": "Keys support equality and hashing but have no meaningful total order. The task asks only whether a queried key exists. Which strategy signal is valid?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_only_needed",
                  "text": "Hash lookup matches the equality contract without inventing an order."
                },
                {
                  "id": "sorting_required",
                  "text": "Sorting is mandatory for every lookup problem."
                },
                {
                  "id": "group_runs",
                  "text": "Equal-run grouping is the primary requirement."
                },
                {
                  "id": "index_order",
                  "text": "Sort by memory address to create a semantic order."
                }
              ],
              "acceptedOptionIds": [
                "hash_only_needed"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Hashing requires equality and a compatible hash function, whereas sorting requires an ordering relation.",
              "details": "When only membership is needed and no legal total order exists, the lookup signal clearly favors hashing.",
              "wrongOptionExplanationsByOptionId": {
                "sorting_required": "Sorting requires a comparator or total order that the contract does not provide.",
                "group_runs": "The task asks only membership.",
                "index_order": "An incidental address order does not satisfy a domain contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-004",
            "prompt": "Records are comparable by timestamp, and the query asks for every record in a time interval in chronological order. Which signal is primary?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ordering_range",
                  "text": "Ordered range traversal favors sorting or an ordered representation."
                },
                {
                  "id": "hash_equality",
                  "text": "Hash equality lookup is sufficient."
                },
                {
                  "id": "frequency_only",
                  "text": "Only frequency counting is relevant."
                },
                {
                  "id": "first_duplicate",
                  "text": "The task is duplicate detection."
                }
              ],
              "acceptedOptionIds": [
                "ordering_range"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Range queries depend on relative order, not only equality.",
              "details": "Sorting establishes the boundary and traversal order needed to emit the interval.",
              "wrongOptionExplanationsByOptionId": {
                "hash_equality": "Equality lookup does not directly locate all values inside an interval.",
                "frequency_only": "The result requires a range and chronological order.",
                "first_duplicate": "No duplicate contract is stated."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-005",
            "prompt": "A one-pass job must count occurrences of each token, and the caller accepts groups in arbitrary order. Which primary signal favors hashing?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frequency_map",
                  "text": "Direct key-to-count updates favor a hash map."
                },
                {
                  "id": "sort_for_order",
                  "text": "Sort because every frequency table must be ordered."
                },
                {
                  "id": "adjacent_only",
                  "text": "Count only adjacent equal tokens."
                },
                {
                  "id": "mutate_input",
                  "text": "Reorder the original token sequence."
                }
              ],
              "acceptedOptionIds": [
                "frequency_map"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The required state is an equality-keyed count per token.",
              "details": "Without an ordered-output requirement, hashing avoids imposing an order that the contract does not consume.",
              "wrongOptionExplanationsByOptionId": {
                "sort_for_order": "The result order is explicitly arbitrary.",
                "adjacent_only": "Equal tokens can appear anywhere.",
                "mutate_input": "Mutation is unnecessary for the stated result."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-006",
            "prompt": "A task asks for the closest pair of numeric values, not their original positions. Which signal favors sorting over a hash table?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "adjacent_after_sort",
                  "text": "After sorting, the minimum difference must occur between adjacent values."
                },
                {
                  "id": "membership_only",
                  "text": "Exact membership is the only required relation."
                },
                {
                  "id": "hash_constant",
                  "text": "Expected constant-time hash operations prove optimality."
                },
                {
                  "id": "duplicate_only",
                  "text": "The task is only to detect duplicates."
                }
              ],
              "acceptedOptionIds": [
                "adjacent_after_sort"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorting creates a structural adjacency invariant for the distance objective.",
              "details": "A hash table represents equality well but not nearest ordered neighbors.",
              "wrongOptionExplanationsByOptionId": {
                "membership_only": "Closest-pair reasoning depends on order and distance.",
                "hash_constant": "A hash table does not expose neighboring values by magnitude.",
                "duplicate_only": "Duplicates are one zero-distance case, but the full task includes nonzero distances."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-007",
            "prompt": "Input is already sorted, and the task is to output value-frequency groups in that same order. Which strategy is most direct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan_runs",
                  "text": "Scan consecutive equal runs without building a hash table."
                },
                {
                  "id": "rehash_all",
                  "text": "Build a hash map because hashing is always faster than sorting."
                },
                {
                  "id": "resort",
                  "text": "Sort the already sorted input again."
                },
                {
                  "id": "random_lookup",
                  "text": "Perform random membership queries for every value."
                }
              ],
              "acceptedOptionIds": [
                "scan_runs"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The existing order already supplies duplicate adjacency and deterministic group order.",
              "details": "A linear run scan consumes that structure directly; expected hash lookup offers no asymptotic advantage and uses extra memory.",
              "wrongOptionExplanationsByOptionId": {
                "rehash_all": "The ordering work is already done and a run scan is linear with constant auxiliary state.",
                "resort": "No additional sorting is needed.",
                "random_lookup": "That adds unnecessary work and state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-008",
            "prompt": "A task must return the original index of the first occurrence of each distinct value while preserving first-seen order. Which signal favors a hash-based design?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_with_first_index",
                  "text": "Store first indices in a hash map while scanning the original sequence."
                },
                {
                  "id": "sort_values_only",
                  "text": "Sort values alone and infer original indices afterward."
                },
                {
                  "id": "adjacent_groups",
                  "text": "Only sorted adjacency matters."
                },
                {
                  "id": "binary_search",
                  "text": "Binary-search the unsorted original sequence."
                }
              ],
              "acceptedOptionIds": [
                "hash_with_first_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The required relation is equality lookup coupled with original-position metadata.",
              "details": "A hash map can retain the first index while the scan preserves first-seen order.",
              "wrongOptionExplanationsByOptionId": {
                "sort_values_only": "Sorting values without index metadata loses the required identity.",
                "adjacent_groups": "The contract prioritizes first-seen order and original indices.",
                "binary_search": "No sorted search domain exists."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-009",
            "prompt": "Objects are comparable by a canonical key but are expensive to hash. The result needs one deterministic ordered traversal and no later equality queries. Which signal favors sorting?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ordered_once",
                  "text": "The result consumes total order directly, while hashing would add unused lookup state."
                },
                {
                  "id": "hash_word",
                  "text": "The presence of keys implies a hash map."
                },
                {
                  "id": "expected_linear",
                  "text": "Expected linear build cost dominates every other contract."
                },
                {
                  "id": "one_pass",
                  "text": "Any one-pass implementation is automatically preferable."
                }
              ],
              "acceptedOptionIds": [
                "ordered_once"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The strategy should serve the relation the result consumes.",
              "details": "When order is the output and hashing is expensive, sorting can be the more natural and possibly faster end-to-end choice.",
              "wrongOptionExplanationsByOptionId": {
                "hash_word": "Keys can support ordering without requiring hashing.",
                "expected_linear": "Hash cost and unused state must be included.",
                "one_pass": "The output itself requires deterministic ordering."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-010",
            "prompt": "A problem statement contains the word \"lookup,\" but the actual query asks for the smallest key not less than x. What should drive the choice?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ordered_successor",
                  "text": "The successor-order relation, which favors sorting or an ordered structure."
                },
                {
                  "id": "keyword_lookup",
                  "text": "The word \"lookup,\" which proves hashing."
                },
                {
                  "id": "hash_any",
                  "text": "Any hash table because expected lookup is constant."
                },
                {
                  "id": "scan_names",
                  "text": "Variable names such as key and table."
                }
              ],
              "acceptedOptionIds": [
                "ordered_successor"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The semantic query is an ordered boundary search, not equality membership.",
              "details": "Strategy classification must follow the relation required by the answer.",
              "wrongOptionExplanationsByOptionId": {
                "keyword_lookup": "Keywords do not define the required relation.",
                "hash_any": "A plain hash table does not locate the next ordered key.",
                "scan_names": "Names are not a strategy invariant."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-011",
            "prompt": "A problem requires both exact membership queries and final ascending output. What is the correct initial conclusion?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_signals",
                  "text": "Both lookup and ordering signals exist; compare the full workload or use a hybrid design."
                },
                {
                  "id": "hash_always",
                  "text": "Hashing automatically satisfies ascending output."
                },
                {
                  "id": "sort_always",
                  "text": "Sorting makes every exact query expected O(1)."
                },
                {
                  "id": "ignore_output",
                  "text": "Choose only from query cost and ignore final output."
                }
              ],
              "acceptedOptionIds": [
                "both_signals"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Mixed contracts can justify sorting, hashing plus key sorting, or maintaining both representations.",
              "details": "The choice depends on query volume, memory, updates, and whether the ordered result can reuse preprocessing.",
              "wrongOptionExplanationsByOptionId": {
                "hash_always": "Hash iteration order is not a general ascending-order contract.",
                "sort_always": "Binary search on sorted data is logarithmic, not expected constant time.",
                "ignore_output": "The final ordering requirement is part of correctness."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-012",
            "prompt": "Which result contracts primarily require equality-keyed state? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "membership",
                  "text": "Repeated equality-based membership tests."
                },
                {
                  "id": "frequency",
                  "text": "Incremental counts by key with arbitrary output order."
                },
                {
                  "id": "first_index",
                  "text": "Retaining first-seen indices while scanning original order."
                },
                {
                  "id": "range_successor",
                  "text": "Finding the next greater key and emitting an ordered range."
                }
              ],
              "acceptedOptionIds": [
                "membership",
                "frequency",
                "first_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Hashing is strongest when the state is keyed by equality and does not require ordered traversal.",
              "details": "Ordered successor and range semantics point toward sorting or an ordered structure.",
              "wrongOptionExplanationsByOptionId": {
                "range_successor": "These require ordering rather than equality alone."
              },
              "omittedCorrectExplanationsByOptionId": {
                "membership": "A set directly represents membership.",
                "frequency": "A map directly updates key-associated state.",
                "first_index": "A map can associate each key with its first position."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-013",
            "prompt": "Which result contracts primarily consume relative order or adjacency? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "ordered_output",
                  "text": "Deterministic ascending output."
                },
                {
                  "id": "adjacent_groups",
                  "text": "Grouping equal values into consecutive runs."
                },
                {
                  "id": "range_query",
                  "text": "Reporting values in an ordered interval."
                },
                {
                  "id": "arbitrary_membership",
                  "text": "Only arbitrary-order exact membership on unorderable keys."
                }
              ],
              "acceptedOptionIds": [
                "ordered_output",
                "adjacent_groups",
                "range_query"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorting is valuable when relative order becomes reusable structure.",
              "details": "Pure equality membership does not consume that structure.",
              "wrongOptionExplanationsByOptionId": {
                "arbitrary_membership": "This is an equality-lookup signal."
              },
              "omittedCorrectExplanationsByOptionId": {
                "ordered_output": "Sorting directly establishes output order.",
                "adjacent_groups": "Sorting makes equal keys adjacent.",
                "range_query": "Ordered boundaries and traversal are central."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-014",
            "prompt": "Which questions should be answered before choosing hashing or sorting? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "relation",
                  "text": "Does the result require equality lookup, relative order, or both?"
                },
                {
                  "id": "key_contract",
                  "text": "Are keys hashable, comparable, or both?"
                },
                {
                  "id": "observable_order",
                  "text": "Must original order, deterministic group order, or indices be preserved?"
                },
                {
                  "id": "variable_name",
                  "text": "Is a variable named map or sorted?"
                }
              ],
              "acceptedOptionIds": [
                "relation",
                "key_contract",
                "observable_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The decision follows semantic operations and observable contracts.",
              "details": "Implementation vocabulary is not evidence.",
              "wrongOptionExplanationsByOptionId": {
                "variable_name": "Names do not establish a legal strategy."
              },
              "omittedCorrectExplanationsByOptionId": {
                "relation": "The required relation is the primary boundary.",
                "key_contract": "The legal operations differ.",
                "observable_order": "These are correctness constraints."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-015",
            "prompt": "Which situations can make both hashing and sorting correct candidates? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "duplicate_exists",
                  "text": "Determine whether any duplicate exists in a reorderable array."
                },
                {
                  "id": "frequency_ordered",
                  "text": "Count values and then emit keys in ascending order."
                },
                {
                  "id": "many_membership_final_order",
                  "text": "Serve many membership queries and later produce ordered output."
                },
                {
                  "id": "unhashable_unorderable",
                  "text": "Keys support neither hashing nor a comparison contract."
                }
              ],
              "acceptedOptionIds": [
                "duplicate_exists",
                "frequency_ordered",
                "many_membership_final_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correctness can leave multiple strategies available.",
              "details": "The final choice then depends on workload, memory, mutation, guarantees, and constants.",
              "wrongOptionExplanationsByOptionId": {
                "unhashable_unorderable": "Neither standard strategy is directly legal."
              },
              "omittedCorrectExplanationsByOptionId": {
                "duplicate_exists": "A set or sort-and-scan can both be correct.",
                "frequency_ordered": "Sort-and-run or hash-then-sort-keys can both work.",
                "many_membership_final_order": "A hybrid or either preprocessing path may be reasonable."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-016",
            "prompt": "Which observations are insufficient by themselves to choose a hash map? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "word_lookup",
                  "text": "The prompt uses the word \"lookup.\""
                },
                {
                  "id": "expected_o1",
                  "text": "A hash operation is expected O(1)."
                },
                {
                  "id": "duplicates",
                  "text": "The input contains duplicates."
                },
                {
                  "id": "equality_only",
                  "text": "The task requires only equality membership and keys are hashable."
                }
              ],
              "acceptedOptionIds": [
                "word_lookup",
                "expected_o1",
                "duplicates"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Surface vocabulary and isolated operation costs do not determine the strategy.",
              "details": "A legal equality-only contract is a real mechanism signal.",
              "wrongOptionExplanationsByOptionId": {
                "equality_only": "This is a substantive hash signal."
              },
              "omittedCorrectExplanationsByOptionId": {
                "word_lookup": "The lookup may be ordered rather than equality-based.",
                "expected_o1": "Full workload and correctness constraints remain.",
                "duplicates": "Sorting may exploit duplicate adjacency."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-017",
            "prompt": "Arrange the decision process for distinguishing a lookup signal from an ordering signal.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_result",
                  "text": "State the exact observable result and query relation."
                },
                {
                  "id": "check_key_ops",
                  "text": "Check whether legal equality/hash and total-order operations exist."
                },
                {
                  "id": "identify_reuse",
                  "text": "Identify whether membership state or ordered adjacency/ranges will be reused."
                },
                {
                  "id": "compare_constraints",
                  "text": "Compare memory, mutation, guarantees, and workload before selecting the strategy."
                }
              ],
              "canonicalOrder": [
                "state_result",
                "check_key_ops",
                "identify_reuse",
                "compare_constraints"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The strategy follows from the relation and reusable structure required by the contract.",
              "details": "Cost comparison is meaningful only after legal candidates have been identified."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_lookup_from_ordering_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-lookup-018",
            "prompt": "An array of n hashable keys receives q exact membership queries. Compare building a hash set once with sorting once and using binary search, assuming expected O(1) hash operations and in-place comparison sorting.",
            "constraints": [
              "Hash-set build uses O(n) auxiliary entries.",
              "In-place comparison sort uses O(log n) stack space."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "hash_time",
                "sort_time",
                "hash_auxiliary_space",
                "sort_auxiliary_space"
