          ],
          "falseHeuristicId": "any_solution_with_two_indices_is_two_pointers",
          "transferBoundary": "Endpoint-only state supports a pair or read/write relation; aggregate, frequency, or membership state representing every element in a changing interval supports a window, even when only two index variables are visible."
        },
        "authoringProvenance": {
          "author": "OpenAI GPT-5.6 Pro — candidate authoring; human review required",
          "createdAt": "2026-07-18",
          "contentBatchId": "algorithms-contrast-two-pointers-vs-sliding-window-fsvws-v1",
          "authoringMethod": "independently_authored"
        },
        "items": [
          {
            "id": "alg-ctpsw-fsvws-01",
            "prompt": "Which state description is the decisive signal for a sliding window rather than an endpoint-pair two-pointers scan?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "range_state",
                  "text": "State such as a sum or frequency map that represents every element currently in [left, right]."
                },
                {
                  "id": "endpoint_values",
                  "text": "Only the current endpoint values and their relation."
                },
                {
                  "id": "two_indices",
                  "text": "Two integer indices named left and right."
                },
                {
                  "id": "linear_loop",
                  "text": "A loop that visits each position at most a few times."
                }
              ],
              "acceptedOptionIds": [
                "range_state"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A window owns state for the complete contiguous candidate, not just its endpoints.",
              "details": "Sliding window gains efficiency by updating a summary of the current range when one element enters or leaves. The summary may be a sum, count, frequency map, deque, or another structure, but its semantics cover every member of [left, right]. Pair-oriented two pointers may use only endpoint values or role-specific state such as read and write positions. Both can be linear and use two indices, so those surface properties are not decisive. The state ownership test transfers across implementations even when data structures differ.",
              "wrongOptionExplanationsByOptionId": {
                "endpoint_values": "Endpoint-only state is consistent with pair-oriented two pointers, not evidence that the whole range is maintained.",
                "two_indices": "Both families and many unrelated algorithms can use two indices; the count does not reveal whether they select a pair, define roles, or bound range-owned state.",
                "linear_loop": "Both pair scans and windows can be amortized linear; runtime shape does not reveal whether the candidate is an endpoint relation or a maintained contiguous range."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_fixed_pointer_state_from_window_state",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "Classify the algorithm by what its maintained state denotes, not by variable names or asymptotic complexity."
            ]
          },
          {
            "id": "alg-ctpsw-fsvws-02",
            "prompt": "To compute every length-k moving average, an algorithm adds the new right value and subtracts the value that just left at right - k. The width never varies. Which classification is correct?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "fixed_window",
                  "text": "A fixed-size sliding window."
                },
                {
                  "id": "fixed_two_pointer_state",
                  "text": "Two pointers, because the distance between boundaries is fixed."
                },
                {
                  "id": "neither_width_constant",
                  "text": "Neither family, because a window must change size."
                }
              ],
              "acceptedOptionIds": [
                "fixed_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The maintained sum belongs to a contiguous interval that moves, even though its size is constant.",
              "details": "“Sliding” refers to the candidate range moving through the sequence, not necessarily to variable width. The algorithm reuses the previous range sum by adding the entrant and removing the leaver, so the state continuously represents exactly k contiguous elements. A two-pointers classification based on fixed distance would miss this aggregate ownership. Variable-window shrink rules are unnecessary here because the size condition itself determines which element leaves.",
              "wrongOptionExplanationsByOptionId": {
                "fixed_two_pointer_state": "A fixed gap does not override the fact that the sum represents every member of the moving interval.",
                "neither_width_constant": "Fixed-size windows are canonical sliding windows; variable width is only one variant."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_fixed_pointer_state_from_window_state",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "1 <= k <= the sequence length.",
              "The output is required for every contiguous block of length k."
            ]
          },
          {
            "id": "alg-ctpsw-fsvws-03",
            "prompt": "A variable-length window over nonnegative numbers stores only one scalar, currentSum, plus left and right. Does O(1) auxiliary state make it an endpoint-only two-pointers algorithm?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_scalar_is_range_state",
                  "text": "No. currentSum semantically represents all elements in the current range."
                },
                {
                  "id": "yes_constant_state",
                  "text": "Yes. Window state must grow with the window."
                },
                {
                  "id": "yes_no_frequency_map",
                  "text": "Yes. Sliding window requires a frequency map."
                },
                {
                  "id": "depends_on_names",
                  "text": "It depends on whether the variables are named start and end."
                }
              ],
              "acceptedOptionIds": [
                "no_scalar_is_range_state"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "State semantics, not memory size, determine whether the full interval is maintained.",
              "details": "A scalar sum is compressed range state: changing any member of the window can change the value, and adding or removing a boundary member updates it. Sliding windows do not require storage proportional to their width, nor do they require a map. Conversely, a two-pointers algorithm can carry substantial auxiliary state while still reasoning about endpoint or read/write relations. The robust question is what the state denotes, not how many machine words it occupies.",
              "wrongOptionExplanationsByOptionId": {
                "yes_constant_state": "A range summary can be constant-size; storage growth is not a defining requirement.",
                "yes_no_frequency_map": "A frequency map is only one representation; sums, counts, deques, or fixed scalars can still summarize every member of the current range.",
                "depends_on_names": "Names such as left and right are arbitrary; the invariant is determined by what currentSum denotes and how entering and leaving elements update it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_fixed_pointer_state_from_window_state",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "currentSum is always equal to the sum of elements in the current inclusive range."
            ]
          },
          {
            "id": "alg-ctpsw-fsvws-04",
            "prompt": "During in-place deduplication of a sorted array, read scans candidates and write marks the last accepted output position. No summary is maintained for the elements between them. Which state model applies?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "endpoint_roles",
                  "text": "Fixed role state for two pointers: read explores and write marks the compacted prefix."
                },
                {
                  "id": "window_membership",
                  "text": "Variable window state for every element between read and write."
                },
                {
                  "id": "both_equivalent",
                  "text": "Both, because the indices enclose a contiguous region."
                }
              ],
              "acceptedOptionIds": [
                "endpoint_roles"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The indices encode distinct roles, while the enclosed region is not one maintained candidate.",
              "details": "The algorithm's invariant concerns the compacted output prefix and the next input candidate. The gap may contain processed or rejected values, but their collective membership is not summarized or validated. That makes the state endpoint- and role-oriented rather than window-oriented. A contiguous geometric region exists, yet it is not the semantic object being optimized or kept valid. This distinction is especially useful for same-direction code, where pointer direction offers little diagnostic help.",
              "wrongOptionExplanationsByOptionId": {
                "window_membership": "The algorithm does not maintain or validate all elements in the gap as one candidate.",
                "both_equivalent": "Geometric enclosure is insufficient; the state and invariant assign different semantics."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_fixed_pointer_state_from_window_state",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The accepted output prefix remains sorted and duplicate-free.",
              "No aggregate describes the read/write gap."
            ]
          },
          {
            "id": "alg-ctpsw-fsvws-05",
            "prompt": "A problem originally asks for a pair of sorted values with a target difference. It is changed to ask for the longest contiguous segment in which no value appears more than twice. What state change is required?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frequency_window",
                  "text": "Maintain per-value frequencies for every element in the current segment, using a sliding-window state."
                },
                {
                  "id": "endpoint_only",
                  "text": "Keep only the two endpoint values; interior multiplicities are irrelevant."
                },
                {
                  "id": "same_pair_state",
                  "text": "Use the original pair state because the implementation still has left and right."
                },
                {
                  "id": "sort_again",
                  "text": "Sort the segment after every right step and keep pair state."
                }
              ],
              "acceptedOptionIds": [
                "frequency_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Interior multiplicities become part of validity, so endpoint-only state is no longer sufficient.",
              "details": "The revised condition can change when any interior member enters or leaves, not merely when an endpoint value is compared. A frequency structure representing the current contiguous segment is therefore material state. It can be incrementally updated as boundaries move, which is the window model. Reusing the old pair state would omit exactly the information the new constraint asks about. The transfer rule is to expand state ownership when the answer contract begins to depend on every range member.",
              "wrongOptionExplanationsByOptionId": {
                "endpoint_only": "Endpoint values cannot determine whether an interior value occurs three times.",
                "same_pair_state": "Shared index names do not preserve a state contract after the validity condition changes.",
                "sort_again": "Sorting each candidate would alter order and still fails to identify the intended incremental range invariant."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_fixed_pointer_state_from_window_state",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "advanced",
            "constraints": [
              "The revised answer must be a contiguous segment in original order."
            ]
          }
        ],
        "modeStructures": {
          "recognitionSets": [],
