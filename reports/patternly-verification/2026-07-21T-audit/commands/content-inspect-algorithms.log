      {
        "id": "alg-arrays-stable-compaction-010",
        "prompt": "When read equals write and the current value is retained, is assigning array[write] = array[read] correct?",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "correct_self_assignment",
              "text": "Yes. It is a harmless self-assignment and preserves the invariant."
            },
            {
              "id": "always_out_of_bounds",
              "text": "No. Equal read and write indices are always out of bounds."
            },
            {
              "id": "must_skip_write_and_increment_read_only",
              "text": "No. write must not advance when read equals write."
            },
            {
              "id": "must_swap_with_end",
              "text": "No. The value must be swapped with the final element."
            }
