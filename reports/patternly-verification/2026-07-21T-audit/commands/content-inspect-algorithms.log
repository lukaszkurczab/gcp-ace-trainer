        "items": [
          {
            "id": "alg-complexity-review-001",
            "prompt": "What makes a complexity explanation defensible?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "executed_work",
                  "text": "It identifies the input variables, cost model, executed operations, and how their counts compose."
                },
                {
                  "id": "label_only",
                  "text": "It names a familiar Big-O class without justification."
                },
                {
                  "id": "syntax_only",
                  "text": "It counts loop keywords."
                },
                {
                  "id": "names",
                  "text": "It interprets variable names as complexity annotations."
                }
              ],
              "acceptedOptionIds": [
                "executed_work"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A good explanation connects program behavior to an asymptotic expression.",
              "details": "It also states whether the bound is worst-case, expected, amortized, or output-sensitive.",
              "wrongOptionExplanationsByOptionId": {
                "label_only": "A label alone does not show why it applies.",
                "syntax_only": "Loop syntax can misrepresent aggregate work.",
                "names": "Names have no semantic force."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_complexity_from_executed_operations",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-review-002",
            "prompt": "Why is \"there are two nested loops, so the algorithm is O(n²)\" incomplete?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
