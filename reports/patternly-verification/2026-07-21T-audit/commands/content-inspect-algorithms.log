      {
        "id": "alg-arrays-stable-compaction-020",
        "prompt": "Arrange the reasoning that proves the read/write invariant is preserved when a value is retained.",
        "difficulty": "easy",
        "interaction": {
          "type": "ordering",
          "elements": [
            {
              "id": "assume_prefix_valid",
              "text": "Assume [0, write) already contains the retained values from the processed prefix."
            },
            {
              "id": "write_next_retained",
              "text": "Write the accepted current value at array[write]."
            },
            {
              "id": "advance_boundary",
              "text": "Increment write so the valid prefix includes the new value."
            },
            {
              "id": "confirm_order_and_safety",
              "text": "Confirm that relative order is preserved and write does not move ahead of the next read boundary."
            }
          ],
          "canonicalOrder": [
            "assume_prefix_valid",
            "write_next_retained",
            "advance_boundary",
            "confirm_order_and_safety"
          ],
          "scoringMethod": "adjacent_relations"
        },
        "scoringContract": {
          "type": "ordering",
          "maxPoints": 3
