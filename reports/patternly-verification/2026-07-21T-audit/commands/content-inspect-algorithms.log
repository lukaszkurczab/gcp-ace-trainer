        "items": [
          {
            "id": "alg-bits-state-001",
            "prompt": "How many independent boolean features can be represented directly by a w-bit mask when each feature owns one bit?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "w_features",
                  "text": "w features."
                },
                {
                  "id": "two_w_features",
                  "text": "2^w features."
                },
                {
                  "id": "w_squared",
                  "text": "w^2 features."
                },
                {
                  "id": "one_feature",
                  "text": "Only one feature."
                }
              ],
              "acceptedOptionIds": [
                "w_features"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "One bit stores one independent true-or-false feature.",
              "details": "The same w positions jointly represent 2^w different combinations of those features.",
              "wrongOptionExplanationsByOptionId": {
                "two_w_features": "2^w is the number of possible states, not the number of independent bit positions.",
                "w_squared": "The mask contains only w positions.",
                "one_feature": "Each bit can encode a separate boolean."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-002",
            "prompt": "A state mask uses bit i to mean resource i is acquired. Which expression tests whether resource i is acquired?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "and_nonzero",
                  "text": "(state AND (1 shifted left by i)) is nonzero."
                },
                {
                  "id": "or_nonzero",
                  "text": "(state OR (1 shifted left by i)) is nonzero."
                },
                {
                  "id": "state_equal_i",
                  "text": "state equals i."
                },
                {
                  "id": "shift_state",
                  "text": "state shifted left by i is nonzero."
                }
              ],
              "acceptedOptionIds": [
                "and_nonzero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A one-hot mask extracts the selected membership bit.",
              "details": "The result is nonzero exactly when the feature is present.",
              "wrongOptionExplanationsByOptionId": {
                "or_nonzero": "OR would make the bit one even when it was previously absent.",
                "state_equal_i": "The numeric state can contain many resources.",
                "shift_state": "Shifting does not isolate the selected resource."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-003",
            "prompt": "Which operation combines two feature masks into a state containing every feature present in either mask?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bitwise_or",
                  "text": "Bitwise OR."
                },
                {
                  "id": "bitwise_and",
                  "text": "Bitwise AND."
                },
                {
                  "id": "bitwise_xor",
                  "text": "Bitwise XOR."
                },
                {
                  "id": "addition",
                  "text": "Arithmetic addition."
                }
              ],
              "acceptedOptionIds": [
                "bitwise_or"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "OR represents set union over boolean feature positions.",
              "details": "Every bit present in either operand becomes present in the result.",
              "wrongOptionExplanationsByOptionId": {
                "bitwise_and": "AND keeps only features present in both.",
                "bitwise_xor": "XOR removes features present in both.",
                "addition": "Carries can corrupt neighboring feature positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-004",
            "prompt": "Which operation produces a mask containing only features present in both state masks?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bitwise_and",
                  "text": "Bitwise AND."
                },
                {
                  "id": "bitwise_or",
                  "text": "Bitwise OR."
                },
                {
                  "id": "bitwise_xor",
                  "text": "Bitwise XOR."
                },
                {
                  "id": "complement",
                  "text": "Complement either state."
                }
              ],
              "acceptedOptionIds": [
                "bitwise_and"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "AND is set intersection over one-bit feature memberships.",
              "details": "A feature remains one only when both input states contain it.",
              "wrongOptionExplanationsByOptionId": {
                "bitwise_or": "OR keeps features present in either state.",
                "bitwise_xor": "XOR keeps features present in exactly one operand.",
                "complement": "Complement inverts membership rather than intersecting."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-005",
            "prompt": "A transition releases every resource selected by mask released. Which update matches the contract?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "clear_mask",
                  "text": "state = state AND complement(released), using the declared width."
                },
                {
                  "id": "set_mask",
                  "text": "state = state OR released."
                },
                {
                  "id": "toggle_mask",
                  "text": "state = state XOR released."
                },
                {
                  "id": "extract_mask",
                  "text": "state = state AND released."
                }
              ],
              "acceptedOptionIds": [
                "clear_mask"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Release requires selected membership bits to become zero while all others remain unchanged.",
              "details": "Width-limited complement supplies zeros at the released positions and ones elsewhere.",
              "wrongOptionExplanationsByOptionId": {
                "set_mask": "This acquires the selected resources.",
                "toggle_mask": "This would acquire a resource that was not currently held.",
                "extract_mask": "This discards every unreleased resource."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Complement is limited to the state-mask width."
            ]
          },
          {
            "id": "alg-bits-state-006",
            "prompt": "When do two bitmask-encoded boolean states represent exactly the same feature set?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "mask_equal",
                  "text": "When their masks are bitwise equal."
                },
                {
                  "id": "same_popcount",
                  "text": "When they contain the same number of set bits."
                },
                {
                  "id": "and_nonzero",
                  "text": "When their AND is nonzero."
                },
                {
                  "id": "same_highest",
                  "text": "When their highest set bit matches."
                }
              ],
              "acceptedOptionIds": [
                "mask_equal"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The bit-position mapping is a canonical state representation.",
              "details": "Every membership position must agree for states to be equal.",
              "wrongOptionExplanationsByOptionId": {
                "same_popcount": "Different feature sets can have equal size.",
                "and_nonzero": "That proves only some shared feature.",
                "same_highest": "Lower memberships may differ."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-007",
            "prompt": "Which expression tests whether feature sets a and b are disjoint?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "and_zero",
                  "text": "(a AND b) equals zero."
                },
                {
                  "id": "or_zero",
                  "text": "(a OR b) equals zero."
                },
                {
                  "id": "xor_zero",
                  "text": "(a XOR b) equals zero."
                },
                {
                  "id": "and_equals_a",
                  "text": "(a AND b) equals a."
                }
              ],
              "acceptedOptionIds": [
                "and_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Any shared feature would survive the AND.",
              "details": "A zero intersection means no bit position is set in both states.",
              "wrongOptionExplanationsByOptionId": {
                "or_zero": "That requires both states to be empty.",
                "xor_zero": "That means the states are equal.",
                "and_equals_a": "That means a is a subset of b."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-008",
            "prompt": "Which expression tests whether every feature in mask a is also present in mask b?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "and_equals_a",
                  "text": "(a AND b) equals a."
                },
                {
                  "id": "and_zero",
                  "text": "(a AND b) equals zero."
                },
                {
                  "id": "or_equals_a",
                  "text": "(a OR b) equals a."
                },
                {
                  "id": "xor_equals_a",
                  "text": "(a XOR b) equals a."
                }
              ],
              "acceptedOptionIds": [
                "and_equals_a"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Intersecting a with b should preserve all of a when a is a subset of b.",
              "details": "Any missing required bit would be cleared in the AND result.",
              "wrongOptionExplanationsByOptionId": {
                "and_zero": "That tests disjointness.",
                "or_equals_a": "That means b is a subset of a.",
                "xor_equals_a": "XOR does not directly express subset inclusion."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-009",
            "prompt": "A task requires all flags in required to be enabled in state, while additional flags are allowed. Which test is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "all_required",
                  "text": "(state AND required) equals required."
                },
                {
                  "id": "any_required",
                  "text": "(state AND required) is nonzero."
                },
                {
                  "id": "exact_state",
                  "text": "state equals required."
                },
                {
                  "id": "or_zero",
                  "text": "(state OR required) equals zero."
                }
              ],
              "acceptedOptionIds": [
                "all_required"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The test extracts required positions and verifies that every one is present.",
              "details": "Unrelated state bits do not affect the comparison.",
              "wrongOptionExplanationsByOptionId": {
                "any_required": "This proves only at least one required flag.",
                "exact_state": "This incorrectly rejects additional allowed flags.",
                "or_zero": "A nonempty required mask makes this impossible."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-010",
            "prompt": "A system needs 70 independent boolean features, but the chosen primitive mask exposes only 64 usable bits. What is the correct design response?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "wider_or_multiword",
                  "text": "Use a wider arbitrary-precision or multiword representation, or another explicit state structure."
                },
                {
                  "id": "reuse_bits",
                  "text": "Map multiple unrelated features to the same bit."
                },
                {
                  "id": "ignore_six",
                  "text": "Ignore six features."
                },
                {
                  "id": "shift_beyond",
                  "text": "Shift a 64-bit one by positions 64 through 69 and assume portability."
                }
              ],
              "acceptedOptionIds": [
                "wider_or_multiword"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "One-bit-per-feature encoding requires at least as many usable positions as features.",
              "details": "Changing representation is safer than introducing collisions or relying on undefined shift assumptions.",
              "wrongOptionExplanationsByOptionId": {
                "reuse_bits": "This creates state collisions.",
                "ignore_six": "The representation would no longer encode the contract.",
                "shift_beyond": "Oversized shift behavior is model-dependent and cannot create extra storage positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-011",
            "prompt": "Which problem states are natural candidates for one-bit-per-feature encoding? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "visited_small_set",
                  "text": "Which members of a small fixed universe have been visited."
                },
                {
                  "id": "enabled_permissions",
                  "text": "Which permissions are enabled."
                },
                {
                  "id": "used_resources",
                  "text": "Which small indexed resources are currently used."
                },
                {
                  "id": "arbitrary_large_counts",
                  "text": "An arbitrary unbounded count for every feature."
                }
              ],
              "acceptedOptionIds": [
                "visited_small_set",
                "enabled_permissions",
                "used_resources"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Bitmask state is suitable for bounded collections of independent booleans.",
              "details": "Counts or large values need more than one membership bit per field.",
              "wrongOptionExplanationsByOptionId": {
                "arbitrary_large_counts": "One bit cannot store an unbounded count."
              },
              "omittedCorrectExplanationsByOptionId": {
                "visited_small_set": "Each universe member maps to one membership bit.",
                "enabled_permissions": "Permissions are boolean features.",
                "used_resources": "Each resource can own a bit."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-012",
            "prompt": "Which set-style operations are represented correctly by bitwise operators? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "union_or",
                  "text": "Union by OR."
                },
                {
                  "id": "intersection_and",
                  "text": "Intersection by AND."
                },
                {
                  "id": "symmetric_xor",
                  "text": "Symmetric difference by XOR."
                },
                {
                  "id": "difference_add",
                  "text": "Set difference by arithmetic addition."
                }
              ],
              "acceptedOptionIds": [
                "union_or",
                "intersection_and",
                "symmetric_xor"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boolean membership algebra maps directly to OR, AND, and XOR.",
              "details": "Set difference instead uses AND with a width-limited complement.",
              "wrongOptionExplanationsByOptionId": {
                "difference_add": "Carries do not represent membership difference."
              },
              "omittedCorrectExplanationsByOptionId": {
                "union_or": "Any present bit remains present.",
                "intersection_and": "Only shared bits remain.",
                "symmetric_xor": "Bits present in exactly one state remain."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-013",
            "prompt": "Which requirements make a bit-position mapping reliable? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "unique_position",
                  "text": "Each feature has one unique bit position."
                },
                {
                  "id": "stable_mapping",
                  "text": "The mapping remains stable anywhere masks are compared or persisted."
                },
                {
                  "id": "width_documented",
                  "text": "The available width and valid positions are documented."
                },
                {
                  "id": "value_sorted",
                  "text": "Feature labels must be sorted numerically."
                }
              ],
              "acceptedOptionIds": [
                "unique_position",
                "stable_mapping",
                "width_documented"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The mask is only canonical when every position has one stable meaning inside a declared width.",
              "details": "Sorting labels is optional and does not define correctness.",
              "wrongOptionExplanationsByOptionId": {
                "value_sorted": "The mapping can use any documented one-to-one assignment."
              },
              "omittedCorrectExplanationsByOptionId": {
                "unique_position": "Shared positions would create collisions.",
                "stable_mapping": "Changing meanings corrupts state interpretation.",
                "width_documented": "Capacity and complement behavior depend on width."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-014",
            "prompt": "Which transitions preserve unselected feature bits? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "set_or",
                  "text": "Set selected features with state OR mask."
                },
                {
                  "id": "clear_and_not",
                  "text": "Clear selected features with state AND complement(mask)."
                },
                {
                  "id": "toggle_xor",
                  "text": "Toggle selected features with state XOR mask."
                },
                {
                  "id": "extract_and",
                  "text": "Replace state with state AND mask."
                }
              ],
              "acceptedOptionIds": [
                "set_or",
                "clear_and_not",
                "toggle_xor"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A state transition should alter only positions explicitly selected by the transition mask.",
              "details": "Direct extraction is useful for testing but not for preserving unrelated state.",
              "wrongOptionExplanationsByOptionId": {
                "extract_and": "This clears every unselected feature."
              },
              "omittedCorrectExplanationsByOptionId": {
                "set_or": "Zero-mask positions preserve state.",
                "clear_and_not": "Unselected positions meet ones in the complemented mask.",
                "toggle_xor": "Zero-mask positions are unchanged."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Complement is width-limited."
            ]
          },
          {
            "id": "alg-bits-state-015",
            "prompt": "Which tests are important for bitmask state representation? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "empty_state",
                  "text": "The zero mask with no features enabled."
                },
                {
                  "id": "full_state",
                  "text": "Every usable feature bit enabled."
                },
                {
                  "id": "independent_features",
                  "text": "Two different features enabled separately and together."
                },
                {
                  "id": "only_one_middle",
                  "text": "Only one ordinary middle bit."
                }
              ],
              "acceptedOptionIds": [
                "empty_state",
                "full_state",
                "independent_features"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "State tests should cover empty, full, and independence properties.",
              "details": "A single ordinary feature cannot prove that the mapping is collision-free.",
              "wrongOptionExplanationsByOptionId": {
                "only_one_middle": "This does not test collisions or width endpoints."
              },
              "omittedCorrectExplanationsByOptionId": {
                "empty_state": "It tests the identity boundary.",
                "full_state": "It tests capacity and complement boundaries.",
                "independent_features": "It detects mapping collisions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-016",
            "prompt": "Arrange the design process for a bitmask state model.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "list_features",
                  "text": "List the boolean features that must be represented."
                },
                {
                  "id": "assign_positions",
                  "text": "Assign one unique zero-based bit position to each feature."
                },
                {
                  "id": "choose_width",
                  "text": "Choose a representation wide enough for every assigned position."
                },
                {
                  "id": "document_contract",
                  "text": "Document membership meaning and legal state operations."
                }
              ],
              "canonicalOrder": [
                "list_features",
                "assign_positions",
                "choose_width",
                "document_contract"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Representation design begins with semantic fields and ends with an explicit positional contract.",
              "details": "Choosing a word before counting features can create silent width overflow."
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-017",
            "prompt": "Arrange the steps for encoding a selected feature collection into one mask.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "initialize_zero",
                  "text": "Initialize state to zero."
                },
                {
                  "id": "map_feature",
                  "text": "Look up each selected feature's assigned bit position."
                },
                {
                  "id": "set_bit",
                  "text": "OR the corresponding one-hot mask into state."
                },
                {
                  "id": "verify",
                  "text": "Test that all selected features are present and no unintended positions were used."
                }
              ],
              "canonicalOrder": [
                "initialize_zero",
                "map_feature",
                "set_bit",
                "verify"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Encoding accumulates independent feature memberships with OR.",
              "details": "Verification catches mapping and width mistakes before the state is consumed."
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-018",
            "prompt": "Arrange a transition that acquires features add, releases features remove, and then verifies required features.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "set_add",
                  "text": "Update state = state OR add."
                },
                {
                  "id": "clear_remove",
                  "text": "Update state = state AND complement(remove) within the width."
                },
                {
                  "id": "extract_required",
                  "text": "Compute state AND required."
                },
                {
                  "id": "verify_required",
                  "text": "Check that the extracted bits equal required."
                }
              ],
              "canonicalOrder": [
                "set_add",
                "clear_remove",
                "extract_required",
                "verify_required"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Set and clear transitions update distinct selected positions, after which the required-state postcondition is tested.",
              "details": "If add and remove overlap, the stated ordering makes removal win; a different policy must be explicit."
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Complement is limited to the declared state width."
            ]
          },
          {
            "id": "alg-bits-state-019",
            "prompt": "On one fixed-width machine word, a state transition performs a constant number of OR, AND, XOR, and comparison operations. Select time and auxiliary-space complexity.",
            "constraints": [
              "The feature count fits inside the fixed word."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log w)",
                  "O(w)",
                  "O(2^w)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log w)",
                  "O(w)",
                  "O(2^w)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(1)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "fixed_word": "O(1)"
                },
                "auxiliary_space": {
                  "constant_masks": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "A constant number of primitive fixed-word operations is constant time.",
              "details": "The representation remains compact only while all features fit the chosen word."
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-state-020",
            "prompt": "A dynamic-programming table stores one constant-size value for every state of n independent boolean features. Select initialization time and table space.",
            "constraints": [
              "Every one of the 2^n masks receives one table entry."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "initialization_time",
                "table_space"
              ],
              "availableValuesByDimension": {
                "initialization_time": [
                  "O(n)",
                  "O(2^n)",
                  "O(n·2^n)",
                  "O(n!)"
                ],
                "table_space": [
                  "O(n)",
                  "O(2^n)",
                  "O(n·2^n)",
                  "O(n!)"
                ]
              },
              "acceptedValuesByDimension": {
                "initialization_time": [
                  "O(2^n)"
                ],
                "table_space": [
                  "O(2^n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "initialization_time": {
                  "one_per_state": "O(2^n)"
                },
                "table_space": {
                  "one_entry_per_mask": "O(2^n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "A compact encoding of one state does not make the full state space small.",
              "details": "Enumerating or storing every combination remains exponential in the number of boolean features."
            },
            "taxonomy": {
              "primarySkillAtomId": "encode_boolean_state_in_mask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          }
        ],
