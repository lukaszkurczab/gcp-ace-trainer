          "transferBoundary": "A strategy is legal only if it preserves or explicitly reconstructs required original order and indices; sorting without metadata changes identity, while hashing without stored positions may also lose it."
        },
        "authoringProvenance": {
          "author": "lukasz-kurczab",
          "createdAt": "2026-07-18T00:00:00.000Z",
          "contentBatchId": "contrast-hash-map-vs-sorting-preservation-of-order-and-indices-v1",
