          {
            "id": "alg-bits-representation-017",
            "prompt": "Arrange the steps for interpreting an 8-bit two's-complement pattern whose most significant bit is one.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "unsigned_value",
                  "text": "Compute the unsigned value of the eight bits."
                },
                {
                  "id": "recognize_negative",
                  "text": "Observe that bit 7 is set, so signed interpretation is negative."
                },
                {
                  "id": "subtract_modulus",
                  "text": "Subtract 2^8 from the unsigned value."
                },
                {
                  "id": "report_signed",
                  "text": "Report the resulting signed integer."
                }
              ],
              "canonicalOrder": [
                "unsigned_value",
                "recognize_negative",
                "subtract_modulus",
                "report_signed"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "For a fixed-width two's-complement word, negative signed value equals unsigned value minus 2^width.",
              "details": "This method makes the width dependency explicit."
            },
            "taxonomy": {
              "primarySkillAtomId": "interpret_integer_bit_representation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Use exactly 8 bits."
            ]
