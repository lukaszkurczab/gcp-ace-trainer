            },
            "feedback": {
              "reason": "The returned index is justified by a partition invariant, not by a final equality check.",
              "details": "It may legally equal n when no array position satisfies the predicate."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_binary_search_boundary_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-boundaries-020",
            "prompt": "Arrange the checks for converting a closed exact-search template into a half-open boundary search.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "change_semantics",
                  "text": "Redefine right as an exclusive boundary."
                },
                {
                  "id": "change_initial",
                  "text": "Initialize right to n rather than n - 1."
                },
                {
                  "id": "change_loop_updates",
                  "text": "Use left < right and derive mid-retaining updates from the boundary predicate."
                },
                {
                  "id": "change_exit",
                  "text": "Define what the converged insertion boundary means."
                }
              ],
              "canonicalOrder": [
                "change_semantics",
                "change_initial",
                "change_loop_updates",
                "change_exit"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Changing one line is insufficient because interval semantics affect every part of the algorithm.",
              "details": "A safe conversion updates initialization, loop condition, branch inclusion, and post-loop interpretation together."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_binary_search_boundary_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-boundaries-021",
            "prompt": "A coherent iterative binary search halves an active domain of n candidates and performs O(1) work per iteration. Select its iteration bound and auxiliary-space complexity.",
            "constraints": [
              "Every nonterminal branch strictly reduces the domain to at most about half."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "iterations",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "iterations": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "iterations": [
                  "O(log n)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "iterations": {
                  "halving": "O(log n)"
                },
                "auxiliary_space": {
                  "iterative": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Boundary convention changes constants and exit meaning, not the asymptotic effect of halving.",
              "details": "Constant boundary variables suffice for an iterative implementation."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_binary_search_boundary_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-boundaries-022",
            "prompt": "A recursive binary search halves the domain until one candidate remains. Select the recursion depth and stack-space complexity.",
            "constraints": [
              "Each call retains one stack frame.",
              "The active-domain size is reduced by about half."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "recursion_depth",
                "stack_space"
