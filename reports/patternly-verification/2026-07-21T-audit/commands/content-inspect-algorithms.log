          },
          {
            "id": "alg-gt-msbfs-007",
            "prompt": "Which conceptual transformation explains why seeding all sources together computes distance to the nearest source in an unweighted graph?",
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "virtual_super_source",
                  "text": "Add a virtual super-source with one edge to every real source, run BFS, and subtract that one virtual edge from reported distances."
                },
                {
                  "id": "merge_vertices",
                  "text": "Merge all source vertices into one physical vertex, even when they have different incident edges."
                },
                {
                  "id": "duplicate_edges",
                  "text": "Duplicate every original edge once per source so each BFS wave has its own graph."
                },
                {
                  "id": "dfs_forest",
                  "text": "Build a DFS forest; every tree depth is automatically the nearest-source distance."
                }
              ],
              "acceptedOptionIds": [
                "virtual_super_source"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A virtual common origin places all real sources in the same first layer, equivalent to a shared distance-zero queue after offsetting the virtual edge.",
              "details": "The transformation is a proof device: one BFS from a super-source reaches every real source at distance one, then reaches any vertex at one plus its minimum distance to the source set. Direct multi-source initialization removes the artificial offset and avoids materializing the extra vertex. Do not physically merge sources, because their identities and incident edges remain distinct.",
              "wrongOptionExplanationsByOptionId": {
                "merge_vertices": "Merging changes the graph by combining source neighborhoods and can create paths that did not exist.",
                "duplicate_edges": "That expands the graph unnecessarily and does not express the shared minimum-distance competition.",
                "dfs_forest": "DFS depth is not minimum unweighted distance and depends on exploration order."
              }
            },
            "taxonomy": {
