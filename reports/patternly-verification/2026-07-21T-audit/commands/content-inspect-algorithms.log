            },
            {
              "id": "select_x",
              "text": "Select X=[4,6)."
            },
            {
              "id": "select_z",
              "text": "Select Z=[7,9)."
            },
            {
              "id": "select_none",
              "text": "Select none because all candidates touch or cross the boundary."
