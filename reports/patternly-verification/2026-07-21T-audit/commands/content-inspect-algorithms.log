        "items": [
          {
            "id": "alg-backtracking-undo-001",
            "prompt": "Why is the final pop in append-recurse-pop necessary when one mutable path is reused?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "restore_parent_path",
                  "text": "It restores the exact parent path before the next sibling choice."
                },
                {
                  "id": "remove_result",
                  "text": "It removes the completed result from the output collection."
                },
                {
                  "id": "reduce_input",
                  "text": "It permanently deletes the candidate from the input."
                },
                {
                  "id": "sort_path",
                  "text": "It keeps the path sorted."
                }
              ],
              "acceptedOptionIds": [
                "restore_parent_path"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sibling branches must begin from the same parent state.",
              "details": "Without the pop, a choice made for one branch remains visible when another candidate is explored.",
              "wrongOptionExplanationsByOptionId": {
                "remove_result": "The pop targets branch state, not stored result snapshots.",
                "reduce_input": "The input candidate set is separate from the current path.",
                "sort_path": "Sorting is unrelated to restoration."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "restore_path_state_after_branch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-undo-002",
            "prompt": "A grid solver marks a cell visited before recursion. When should it normally unmark that cell for path-local reuse constraints?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "after_neighbors_fail_or_finish",
