              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The added ordering stage changes both mechanisms' complete costs.",
              "details": "The best result can depend on the number of distinct keys k."
