        "items": [
          {
            "id": "alg-backtracking-grid-001",
            "prompt": "In a word-search branch where a cell cannot be reused, when should the current cell be marked visited?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "after_validation_before_neighbors",
                  "text": "After bounds and value checks pass, before exploring neighbors."
                },
                {
                  "id": "before_bounds",
                  "text": "Before confirming the coordinates are inside the grid."
                },
                {
                  "id": "after_all_neighbors",
                  "text": "Only after all neighbor recursion finishes."
                },
                {
                  "id": "never",
                  "text": "Visited state is unnecessary in path search."
                }
              ],
              "acceptedOptionIds": [
                "after_validation_before_neighbors"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The current cell becomes part of the active path only after it is proven legal.",
              "details": "The mark must be visible to every descendant so the path cannot revisit the cell.",
              "wrongOptionExplanationsByOptionId": {
                "before_bounds": "Out-of-bounds memory cannot be marked safely.",
                "after_all_neighbors": "Descendants could reuse the current cell.",
                "never": "Cycles and cell reuse can violate the path contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-002",
            "prompt": "Why is one global visited set usually incorrect when every starting cell should be allowed to begin an independent path search?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "blocks_sibling_paths",
                  "text": "A cell used by one failed path may still be required by another path or starting position."
                },
                {
                  "id": "grid_too_small",
                  "text": "Global visited works only on large grids."
                },
                {
                  "id": "visited_cannot_store_cells",
                  "text": "A set cannot store coordinates."
                },
                {
                  "id": "recursion_requires_global",
                  "text": "Recursive search always requires global visited state."
                }
              ],
              "acceptedOptionIds": [
                "blocks_sibling_paths"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Visited state belongs to the current path when cells may be reused across different candidate paths.",
              "details": "Marking and unmarking or branch-local copies restore availability between searches.",
              "wrongOptionExplanationsByOptionId": {
                "grid_too_small": "Grid size is not the issue.",
                "visited_cannot_store_cells": "A set can store coordinates; the scope is wrong.",
                "recursion_requires_global": "Path-local state is common."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-003",
            "prompt": "A grid word-search call has already matched every target character. What should happen before attempting another cell access?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "return_success",
                  "text": "Return success immediately."
                },
                {
                  "id": "read_next_cell",
                  "text": "Read another cell to confirm the path."
                },
                {
                  "id": "clear_board",
                  "text": "Erase the entire board."
                },
                {
                  "id": "restart_start_cells",
                  "text": "Restart the outer search loop."
                }
              ],
              "acceptedOptionIds": [
                "return_success"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The completion contract is based on target progress, not on making an extra move.",
              "details": "Checking completion first also avoids unnecessary out-of-bounds or sentinel accesses after the final character.",
              "wrongOptionExplanationsByOptionId": {
                "read_next_cell": "The target contract is already complete.",
                "clear_board": "Completion does not require destructive cleanup.",
                "restart_start_cells": "Success may be propagated under a find-one contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-004",
            "prompt": "A cell is marked visited, all neighbor branches fail, and the function returns without unmarking it. What defect results?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "leaked_path_state",
                  "text": "Sibling paths can be incorrectly blocked from using that cell."
                },
                {
                  "id": "duplicate_output_only",
                  "text": "Only the order of duplicate outputs changes."
                },
                {
                  "id": "board_sorted",
                  "text": "The board becomes sorted."
                },
                {
                  "id": "target_shortened",
                  "text": "The target string becomes shorter."
                }
              ],
              "acceptedOptionIds": [
                "leaked_path_state"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A failed branch must restore every path-local mark.",
              "details": "Otherwise, the parent no longer represents the same search state for its remaining neighbors.",
              "wrongOptionExplanationsByOptionId": {
                "duplicate_output_only": "The branch may lose valid paths entirely.",
                "board_sorted": "No sorting occurs.",
                "target_shortened": "The defect is visited-state leakage."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-005",
            "prompt": "A problem permits four-directional movement only. Which neighbor set is legal from (r, c)?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "orthogonal_four",
                  "text": "(r - 1, c), (r + 1, c), (r, c - 1), and (r, c + 1), subject to bounds."
                },
                {
                  "id": "diagonal_four",
                  "text": "Only the four diagonal cells."
                },
                {
                  "id": "all_grid_cells",
                  "text": "Every unvisited cell in the grid."
                },
                {
                  "id": "same_cell",
                  "text": "Only (r, c) again."
                }
              ],
              "acceptedOptionIds": [
                "orthogonal_four"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Candidate generation begins with the exact movement relation.",
              "details": "Bounds, target matching, and visited checks then filter these four potential neighbors.",
              "wrongOptionExplanationsByOptionId": {
                "diagonal_four": "The movement contract excludes diagonals.",
                "all_grid_cells": "A path step must satisfy adjacency.",
                "same_cell": "The current cell cannot be reused as the next step."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-006",
            "prompt": "Why may the same board cell be used in two different successful paths returned by a collect-all solver?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "different_branches",
                  "text": "Visited restrictions apply within one path, not necessarily across independent result paths."
                },
                {
                  "id": "visited_ignored",
                  "text": "Visited state is ignored after the first solution."
                },
                {
                  "id": "cell_duplicates",
                  "text": "Every cell has an implicit duplicate copy."
                },
                {
                  "id": "paths_share_state",
                  "text": "All result paths are one shared mutable path."
                }
              ],
              "acceptedOptionIds": [
                "different_branches"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Path-local visited state prevents cycles and reuse inside a branch while allowing independent branches to use the same resources.",
              "details": "The result contract determines whether paths are independent and whether global resource consumption exists.",
              "wrongOptionExplanationsByOptionId": {
                "visited_ignored": "Each path must still obey no-reuse internally.",
                "cell_duplicates": "The same physical cell is reused across separate branches.",
                "paths_share_state": "Results should be independent snapshots."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-007",
            "prompt": "A solver temporarily replaces board[r][c] with a sentinel to mark it visited. What must happen when the branch returns?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "restore_original",
                  "text": "Restore the original cell value."
                },
                {
                  "id": "leave_sentinel",
                  "text": "Leave the sentinel for all future searches."
                },
                {
                  "id": "sort_row",
                  "text": "Sort the row containing the cell."
                },
                {
                  "id": "delete_cell",
                  "text": "Remove the cell from the grid."
                }
              ],
              "acceptedOptionIds": [
                "restore_original"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "In-place marking is a reversible state representation.",
              "details": "The frame that changes the cell owns the restoration, including failure and any success path that must preserve the input.",
              "wrongOptionExplanationsByOptionId": {
                "leave_sentinel": "That converts path-local visited state into a global block.",
                "sort_row": "Sorting is unrelated and changes the board.",
                "delete_cell": "The grid shape must remain unchanged."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-008",
            "prompt": "Why should the outer driver try every grid cell as a potential starting position when no start is specified?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "target_may_begin_anywhere",
                  "text": "A valid path may begin at any cell matching the first target condition."
                },
                {
                  "id": "recursion_requires_all",
                  "text": "Every recursive function must be called once per cell."
                },
                {
                  "id": "visited_global",
                  "text": "Global visited state requires visiting every cell first."
                },
                {
                  "id": "grid_sorted",
                  "text": "Trying every cell sorts the grid."
                }
              ],
              "acceptedOptionIds": [
                "target_may_begin_anywhere"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The first choice is the starting cell.",
              "details": "Each start launches an independent path-local search unless the contract specifies a fixed origin.",
              "wrongOptionExplanationsByOptionId": {
                "recursion_requires_all": "This is problem-specific, not a recursion rule.",
                "visited_global": "The outer loop should not globally mark cells.",
                "grid_sorted": "No reordering occurs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-009",
            "prompt": "Which checks can reject a grid-search call before marking the current cell? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "out_of_bounds",
                  "text": "The coordinates are outside the grid."
                },
                {
                  "id": "target_mismatch",
                  "text": "The cell does not match the required target symbol or predicate."
                },
                {
                  "id": "already_in_path",
                  "text": "The cell is already visited by the current path when reuse is forbidden."
                },
                {
                  "id": "neighbor_failed",
                  "text": "A different neighbor failed in an earlier sibling branch."
                }
              ],
              "acceptedOptionIds": [
                "out_of_bounds",
                "target_mismatch",
                "already_in_path"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Immediate legality checks occur before mutating visited state.",
              "details": "Sibling outcomes do not create global illegality.",
              "wrongOptionExplanationsByOptionId": {
                "neighbor_failed": "One sibling's failure does not invalidate this cell."
              },
              "omittedCorrectExplanationsByOptionId": {
                "out_of_bounds": "There is no legal cell to use.",
                "target_mismatch": "The branch cannot represent the target prefix.",
                "already_in_path": "The move violates path legality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-010",
            "prompt": "Which state must be restored between sibling grid branches? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "visited_mark",
                  "text": "The current cell's visited mark."
                },
                {
                  "id": "board_sentinel",
                  "text": "Any temporary sentinel written into the board."
                },
                {
                  "id": "path_entry",
                  "text": "Any coordinate or character appended to the current path."
                },
                {
                  "id": "immutable_target",
                  "text": "The immutable target string itself."
                }
              ],
              "acceptedOptionIds": [
                "visited_mark",
                "board_sentinel",
                "path_entry"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Every mutable branch-local representation must return to the parent state.",
              "details": "Immutable configuration remains shared.",
              "wrongOptionExplanationsByOptionId": {
                "immutable_target": "Reading shared immutable input requires no restoration."
              },
              "omittedCorrectExplanationsByOptionId": {
                "visited_mark": "Sibling paths need the parent visited set.",
                "board_sentinel": "The original cell value must be restored.",
                "path_entry": "The sibling should inherit only the parent path."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-011",
            "prompt": "Which tests are important for grid-search visited-state correctness? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "single_cell",
                  "text": "A one-cell grid with matching and non-matching targets."
                },
                {
                  "id": "requires_turn",
                  "text": "A valid path that changes direction."
                },
                {
                  "id": "tempting_reuse",
                  "text": "A target that can match only if a cell is illegally reused."
                },
                {
                  "id": "only_large_random",
                  "text": "Only one large random board."
                }
              ],
              "acceptedOptionIds": [
                "single_cell",
                "requires_turn",
                "tempting_reuse"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Minimal, directional, and illegal-reuse cases expose distinct state errors.",
              "details": "Large random tests are supplementary rather than sufficient.",
              "wrongOptionExplanationsByOptionId": {
                "only_large_random": "It may not isolate boundary and restoration defects."
              },
              "omittedCorrectExplanationsByOptionId": {
                "single_cell": "It tests completion and minimal bounds.",
                "requires_turn": "It verifies neighbor enumeration beyond a straight line.",
                "tempting_reuse": "It tests path-local no-reuse."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-012",
            "prompt": "Arrange the control flow for one grid-search call.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_completion",
                  "text": "Return success if the target is already fully matched."
                },
                {
                  "id": "check_current",
                  "text": "Reject bounds, mismatch, or path reuse."
                },
                {
                  "id": "mark_current",
                  "text": "Mark the current cell as used by the path."
                },
                {
                  "id": "search_and_restore",
                  "text": "Search neighbors, then restore the cell before returning."
                }
              ],
              "canonicalOrder": [
                "check_completion",
                "check_current",
                "mark_current",
                "search_and_restore"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Completion, immediate failure, mutation, and recursive expansion have distinct ordering.",
              "details": "This sequence avoids invalid accesses and preserves path-local state."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-013",
            "prompt": "Arrange the operations for exploring one legal neighbor.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "derive_neighbor",
                  "text": "Compute the neighbor coordinates."
                },
                {
                  "id": "validate_neighbor",
                  "text": "Check bounds, target progress, and visited state."
                },
                {
                  "id": "recurse_neighbor",
                  "text": "Recurse into the legal neighbor."
                },
                {
                  "id": "continue_or_return",
                  "text": "Process the result according to find-one or collect-all semantics."
                }
              ],
              "canonicalOrder": [
                "derive_neighbor",
                "validate_neighbor",
                "recurse_neighbor",
                "continue_or_return"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A neighbor becomes a child branch only after its coordinates and state are legal.",
              "details": "The result contract determines whether success short-circuits or enumeration continues."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-014",
            "prompt": "Arrange the reversible in-place marking sequence for a cell.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "save_original",
                  "text": "Save the original cell value."
                },
                {
                  "id": "write_sentinel",
                  "text": "Replace it with a visited sentinel."
                },
                {
                  "id": "search_descendants",
                  "text": "Explore all legal descendants of the current path."
                },
                {
                  "id": "restore_value",
                  "text": "Write the original value back before returning."
                }
              ],
              "canonicalOrder": [
                "save_original",
                "write_sentinel",
                "search_descendants",
                "restore_value"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "In-place marking must preserve enough information to reverse the mutation.",
              "details": "Restoration belongs to the frame that introduced the sentinel."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-015",
            "prompt": "Arrange the outer search over unspecified starting cells.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "iterate_cells",
                  "text": "Iterate every grid coordinate."
                },
                {
                  "id": "match_first",
                  "text": "Skip starts that cannot match the first target condition."
                },
                {
                  "id": "launch_path_search",
                  "text": "Run a fresh path-local backtracking search from the candidate start."
                },
                {
                  "id": "handle_result",
                  "text": "Return early for find-one or accumulate results for collect-all."
                }
              ],
              "canonicalOrder": [
                "iterate_cells",
                "match_first",
                "launch_path_search",
                "handle_result"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The start position is the root choice of each independent path search.",
              "details": "Cheap first-symbol filtering avoids launching impossible roots."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-016",
            "prompt": "Arrange failure unwinding after all neighbors of a marked cell fail.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "neighbors_exhausted",
                  "text": "Determine that no neighbor completed the target."
                },
                {
                  "id": "unmark_cell",
                  "text": "Restore the current cell's visited state."
                },
                {
                  "id": "pop_path",
                  "text": "Remove any current-cell path entry if one was recorded."
                },
                {
                  "id": "return_failure",
                  "text": "Report failure to the parent branch."
                }
              ],
              "canonicalOrder": [
                "neighbors_exhausted",
                "unmark_cell",
                "pop_path",
                "return_failure"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The parent must receive failure together with its original branch state.",
              "details": "Returning before restoration leaks the failed path into sibling exploration."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-017",
            "prompt": "A grid has R·C possible starting cells, the target length is L, and each step considers at most four neighbors. Select a standard loose worst-case time bound and recursion depth.",
            "constraints": [
              "A cell cannot be reused within one path.",
              "The bound may ignore the reduced branching after the first step."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "recursion_depth"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(RC)",
                  "O(RC·L)",
                  "O(RC·4^L)",
                  "O((RC)^L)"
                ],
                "recursion_depth": [
                  "O(1)",
                  "O(log L)",
                  "O(L)",
                  "O(RC·L)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(RC·4^L)"
                ],
                "recursion_depth": [
                  "O(L)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "starts_times_choices": "O(RC·4^L)"
                },
                "recursion_depth": {
                  "target_length": "O(L)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Each starting cell can launch an exponential path search bounded by target length.",
              "details": "No-reuse often lowers the effective branching factor, but O(RC·4^L) is a common safe upper bound."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-grid-018",
            "prompt": "A grid search uses an explicit R by C visited matrix and recursion depth at most L, excluding the immutable board and returned results. Select the auxiliary-space bound.",
            "constraints": [
              "The visited matrix remains allocated for the search.",
              "Only one depth-first path is active at a time."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "auxiliary_space": [
                  "O(1)",
                  "O(L)",
                  "O(RC)",
                  "O(RC + L)"
                ]
              },
              "acceptedValuesByDimension": {
                "auxiliary_space": [
                  "O(RC + L)"
                ]
              },
              "normalizedAliasesByDimension": {
                "auxiliary_space": {
                  "visited_plus_stack": "O(RC + L)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "The explicit visited representation and recursion stack both contribute.",
              "details": "Reversible in-place marking can remove the separate RC visited matrix, but still needs O(L) stack depth."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_grid_search_visited_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          }
        ],
