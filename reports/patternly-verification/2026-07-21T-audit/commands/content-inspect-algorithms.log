        "items": [
          {
            "id": "alg-contrast-hash-sort-memory-001",
            "prompt": "The input array must remain byte-for-byte unchanged, and the task needs one-pass duplicate detection. Which tradeoff is most relevant?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_nonmutating",
                  "text": "A hash set can preserve input order and contents at the cost of O(k) auxiliary entries."
                },
                {
                  "id": "sort_in_place",
                  "text": "Sort the original array in place because lower memory overrides the immutability contract."
                },
                {
                  "id": "ignore_contract",
                  "text": "Choose solely from headline time complexity."
                },
                {
                  "id": "adjacent_only",
                  "text": "Compare only adjacent original elements."
                }
              ],
              "acceptedOptionIds": [
                "hash_nonmutating"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The strategy must first satisfy the non-mutation contract.",
              "details": "Hashing provides equality state without reordering the input, but its memory cost must be accepted explicitly.",
              "wrongOptionExplanationsByOptionId": {
                "sort_in_place": "Mutating the input would be incorrect.",
                "ignore_contract": "Mutation is an observable correctness constraint.",
                "adjacent_only": "Duplicates may be nonadjacent."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_hash_memory_with_sort_mutation",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-memory-002",
            "prompt": "The input may be reordered, memory is tightly constrained, and the result only asks whether any duplicate exists. Which option can reduce auxiliary memory?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_scan",
                  "text": "Sort in place and scan adjacent values."
                },
                {
                  "id": "hash_set",
                  "text": "Build a hash set and claim constant auxiliary space."
                },
                {
                  "id": "copy_sort",
                  "text": "Copy the array and sort the copy."
                },
                {
                  "id": "pair_check",
                  "text": "Use all pairs because it allocates no table."
                }
              ],
              "acceptedOptionIds": [
                "sort_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When mutation is legal, an in-place sorting path can trade O(n log n) time for much lower auxiliary memory.",
              "details": "The exact sort algorithm's stack or buffer contract still needs to be stated.",
              "wrongOptionExplanationsByOptionId": {
                "hash_set": "The set may contain O(n) entries.",
                "copy_sort": "The copy adds O(n) auxiliary storage.",
                "pair_check": "O(n²) time may be infeasible and is not the intended hash-versus-sort tradeoff."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_hash_memory_with_sort_mutation",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-memory-003",
            "prompt": "Why is the statement \"sorting uses O(1) extra space\" incomplete?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "algorithm_specific",
                  "text": "Auxiliary space depends on the chosen sort, stability requirement, recursion stack, and whether a copy is needed."
                },
                {
                  "id": "sorting_never_memory",
                  "text": "Sorting never uses memory."
                },
                {
                  "id": "hash_same",
                  "text": "Hashing and sorting always use identical memory."
                },
                {
                  "id": "output_only",
                  "text": "Only output memory can ever matter."
                }
              ],
              "acceptedOptionIds": [
                "algorithm_specific"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
