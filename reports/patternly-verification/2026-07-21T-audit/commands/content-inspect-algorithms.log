        "items": [
          {
            "id": "alg-arrays-frequency-state-001",
            "prompt": "A function only needs to determine whether any value appears more than once. Which state is sufficient during a left-to-right scan?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "seen_set",
                  "text": "A set of values seen so far."
                },
                {
                  "id": "frequency_map_required",
                  "text": "A full frequency map is always required."
                },
                {
                  "id": "previous_value_only",
                  "text": "Only the immediately previous value."
                },
                {
                  "id": "output_array",
                  "text": "An output array containing every processed value."
                }
              ],
              "acceptedOptionIds": [
                "seen_set"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Presence state is sufficient when the result depends only on whether a value appeared before.",
              "details": "The scan checks whether the current value is already in the seen set. If it is, a duplicate exists. Exact counts are unnecessary because the contract asks only for a yes-or-no answer.",
              "wrongOptionExplanationsByOptionId": {
                "frequency_map_required": "Counts would work, but they retain more information than the contract requires.",
                "previous_value_only": "A repeated value may be separated from its earlier occurrence in an unsorted input.",
                "output_array": "Storing the processed prefix does not provide efficient membership state and retains unnecessary data."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_frequency_state",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-frequency-state-002",
            "prompt": "A report must return the exact number of occurrences of every distinct value. Which state matches the contract?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frequency_map",
                  "text": "A mapping from each value to its current count."
                },
                {
                  "id": "seen_set",
                  "text": "A set recording whether each value appeared."
                },
                {
                  "id": "duplicate_flag",
                  "text": "One boolean indicating whether any duplicate exists."
                },
                {
                  "id": "previous_value",
                  "text": "One variable containing the previous input value."
                }
              ],
              "acceptedOptionIds": [
                "frequency_map"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Exact multiplicity requires a count for each distinct value.",
              "details": "A frequency map distinguishes one occurrence from two, three, or more. Presence-only state collapses all positive counts into the same fact and therefore cannot reproduce exact frequencies.",
              "wrongOptionExplanationsByOptionId": {
                "seen_set": "A set records presence but loses the number of occurrences.",
                "duplicate_flag": "One boolean cannot identify which values occurred or how often.",
                "previous_value": "The previous value provides only local adjacency information, not global counts."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_frequency_state",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-frequency-state-003",
            "prompt": "A function must return the index of the first occurrence of every distinct value. Which mapping should it maintain?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_to_first_index",
                  "text": "Map each value to its index only when that value is first encountered."
                },
                {
                  "id": "value_to_latest_index",
                  "text": "Overwrite the stored index every time the value appears."
                },
                {
                  "id": "value_to_count",
                  "text": "Map each value only to its total count."
                },
                {
                  "id": "index_to_value",
                  "text": "Map each index to the value already stored at that index."
                }
              ],
              "acceptedOptionIds": [
                "value_to_first_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The state update rule must preserve the first index rather than replace it.",
              "details": "When a value is absent from the map, its current index becomes the first occurrence. Later occurrences must not overwrite that entry. A count alone does not preserve position.",
              "wrongOptionExplanationsByOptionId": {
                "value_to_latest_index": "Overwriting implements a last-occurrence contract, not a first-occurrence contract.",
                "value_to_count": "Counts do not identify where the first occurrence appeared.",
                "index_to_value": "The input already provides index-to-value access; this mapping does not answer first-index queries efficiently."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_frequency_state",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-frequency-state-004",
            "prompt": "A function must return the index of the last occurrence of every value. Which update rule is correct during a left-to-right scan?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "overwrite_with_current_index",
                  "text": "Assign the current index to the value on every occurrence."
                },
                {
                  "id": "write_only_when_absent",
