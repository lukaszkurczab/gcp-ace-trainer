            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The insertion scan is correct because of the start-sorted, disjoint input invariant; end order alone does not provide it.",
              "details": "Without start order, an interval that should precede the new range can appear after an interval classified as 'after.' Without pairwise disjointness, old intervals may themselves need merging, so copying a before interval can leave overlapping output. The safe action is to reject invalid canonical input or normalize it using the batch merge contract, then perform insertion. Hiding normalization inside the scan obscures complexity and error behavior. The transfer boundary is explicit: linear insertion is an optimized operation over a canonical merged sequence, not a replacement for canonicalization.",
              "wrongOptionExplanationsByOptionId": {
                "end_order_sufficient": "End order does not guarantee that starts are monotonic or that the overlap region is contiguous in the way insertion requires.",
                "length_check_sufficient": "Relative length does not restore ordering or disjointness and cannot justify the three phases."
              }
            },
            "taxonomy": {
