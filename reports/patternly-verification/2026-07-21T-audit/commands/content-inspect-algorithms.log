        "items": [
          {
            "id": "alg-mg-gcd-euclidean-invariant",
            "prompt": "Starting with a=252 and b=105, which next state preserves the gcd under the Euclidean algorithm?",
            "constraints": [
              "Use nonnegative inputs.",
              "The next state must be derived by exact integer remainder."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "state_105_42",
                  "text": "(a,b) becomes (105,42) because 252 mod 105 is 42."
                },
                {
                  "id": "state_147_105",
                  "text": "(a,b) becomes (147,105) because subtracting once is always the canonical Euclidean step."
                },
                {
                  "id": "state_ratio",
                  "text": "Replace the pair by the rounded floating ratio 252/105 and 1."
                },
                {
                  "id": "state_105_0",
                  "text": "(a,b) becomes (105,0) because 105 divides the nearest multiple of 252."
                }
              ],
              "acceptedOptionIds": [
                "state_105_42"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The invariant gcd(a,b)=gcd(b,a mod b) gives the next pair (105,42).",
              "details": "Write a=q·b+r with 0≤r<b. A number divides both a and b exactly when it divides both b and r, so replacing (a,b) by (b,r) preserves the common divisors. Here 252=2·105+42. Repeated subtraction can express the same mathematics, but one subtraction is not generally the canonical remainder step and may require many iterations. Floating ratios do not encode exact divisibility.",
              "wrongOptionExplanationsByOptionId": {
                "state_147_105": "A single subtraction preserves the gcd but does not necessarily produce the required remainder or the logarithmic progress of the Euclidean step.",
                "state_ratio": "A rounded ratio loses the exact remainder that carries the divisibility invariant.",
                "state_105_0": "105 does not divide 252; the actual remainder is 42, not zero."
              }
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "apply_euclidean_algorithm",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "euclidean_algorithm",
              "problemArchetypeId": "compute_gcd_lcm"
            }
          },
          {
            "id": "alg-mg-gcd-iterative-step-order",
            "prompt": "Order the steps of an iterative gcd routine whose result is always nonnegative.",
            "constraints": [
              "The routine accepts signed integers.",
              "Use the convention gcd(0,0)=0."
            ],
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "normalize_magnitudes",
                  "text": "Convert both inputs to safe nonnegative magnitudes in a type that can represent them."
                },
                {
                  "id": "test_second",
                  "text": "If b is zero, return a."
                },
                {
                  "id": "compute_remainder",
                  "text": "Compute r = a mod b."
                },
                {
                  "id": "shift_pair",
                  "text": "Assign a = b and b = r."
                },
                {
                  "id": "repeat",
                  "text": "Return to the zero test."
                }
              ],
              "canonicalOrder": [
                "normalize_magnitudes",
                "test_second",
                "compute_remainder",
                "shift_pair",
                "repeat"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 4
            },
            "feedback": {
              "reason": "Safe magnitude normalization precedes the Euclidean loop; each remainder is computed before the pair is shifted.",
              "details": "Normalizing signs once gives the loop the standard invariant 0≤r<b. Testing b before remainder avoids division by zero and makes gcd(0,0)=0 and gcd(a,0)=|a| fall out of the same contract. The relation compute remainder→shift pair must remain adjacent because overwriting a or b early destroys the operands needed for r. This sequence transfers to extended Euclid, where coefficient updates must be staged with the same care."
            },
            "difficulty": "foundational",
            "taxonomy": {
              "primarySkillAtomId": "apply_euclidean_algorithm",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "euclidean_algorithm",
              "problemArchetypeId": "compute_gcd_lcm"
            }
          },
          {
            "id": "alg-mg-gcd-zero-and-sign-contract",
            "prompt": "A library defines gcd as a nonnegative integer and adopts gcd(0,0)=0. Which set of results follows from that contract?",
            "constraints": [
              "Inputs may be negative.",
              "The sign of an input is not part of its divisibility magnitude."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "results_24_9_0",
                  "text": "gcd(-24,0)=24, gcd(-24,-15)=3, and gcd(0,0)=0."
                },
                {
                  "id": "results_negative",
                  "text": "gcd(-24,0)=-24, gcd(-24,-15)=-3, and gcd(0,0)=0."
                },
                {
                  "id": "results_undefined_zero",
                  "text": "Any gcd call containing zero is undefined."
                },
                {
                  "id": "results_float",
                  "text": "The sign is chosen from the sign of the floating quotient a/b."
                }
              ],
              "acceptedOptionIds": [
                "results_24_9_0"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The gcd represents a nonnegative common-divisor magnitude, while zero cases are defined explicitly by the stated convention.",
              "details": "Divisibility is unchanged when either input is negated, so the canonical gcd is nonnegative. Every integer divides zero, and the common divisors of a and 0 are exactly the divisors of |a|; therefore gcd(a,0)=|a|. The chosen gcd(0,0)=0 convention must be stated because mathematics and libraries sometimes treat it differently. A production routine must also form |a| in a type that can represent the minimum signed input.",
              "wrongOptionExplanationsByOptionId": {
                "results_negative": "A negative result violates the stated nonnegative gcd contract even though it has the same magnitude.",
                "results_undefined_zero": "The prompt explicitly defines the zero cases, and gcd(a,0)=|a| is useful and consistent with divisibility.",
                "results_float": "A floating quotient is irrelevant to the exact set of common divisors and is undefined when b is zero."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "apply_euclidean_algorithm",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "euclidean_algorithm",
              "problemArchetypeId": "compute_gcd_lcm"
            }
          },
          {
            "id": "alg-mg-gcd-lcm-relationship",
            "prompt": "For nonnegative a and b, which implementation correctly derives lcm from gcd and handles the zero case?",
            "constraints": [
              "g = gcd(a,b).",
              "The multiplication must use checked or sufficiently wide arithmetic."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero_then_reduced_product",
                  "text": "If a==0 or b==0 return 0; otherwise return (a/g)*b using checked or wider multiplication."
                },
                {
                  "id": "always_product_over_g",
                  "text": "Return (a*b)/g in the input type for every pair, including (0,0)."
                },
                {
                  "id": "ratio_rounding",
                  "text": "Return round(max(a,b) / min(a,b)) * min(a,b)."
                },
                {
                  "id": "sum_over_g",
                  "text": "Return (a+b)/g because g measures their common scale."
                }
              ],
              "acceptedOptionIds": [
                "zero_then_reduced_product"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The identity a·b=gcd(a,b)·lcm(a,b) applies to positive magnitudes, with lcm(a,0)=0 handled before division.",
              "details": "For nonzero a and b, dividing one input by g removes the shared factor and then multiplying by the other yields the least common multiple. The zero branch avoids the undefined expression 0/0 when both inputs are zero. Checked or wider multiplication remains necessary because the algebraic identity does not override the machine range. This derivation transfers to synchronization periods and denominator alignment.",
              "wrongOptionExplanationsByOptionId": {
                "always_product_over_g": "For (0,0), g is zero and the expression divides by zero; for large values, a*b can overflow before division.",
                "ratio_rounding": "A rounded ratio does not encode prime multiplicities and can produce a non-multiple of one input.",
                "sum_over_g": "The sum has no identity connecting it to the least common multiple."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "apply_euclidean_algorithm",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "euclidean_algorithm",
              "problemArchetypeId": "compute_gcd_lcm"
            }
          },
          {
            "id": "alg-mg-gcd-align-periodic-events",
            "prompt": "One event repeats every 84 steps and another every 126 steps. Starting together at step 0, what is the first positive step at which they coincide, and which reasoning establishes it?",
            "constraints": [
              "Periods are positive integers.",
              "Step 0 is excluded by “first positive”."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "lcm_252",
                  "text": "Step 252, because gcd(84,126)=42 and lcm=(84/42)*126=252."
                },
                {
                  "id": "gcd_42",
                  "text": "Step 42, because the gcd is the first time both cycles complete."
                },
                {
                  "id": "sum_210",
                  "text": "Step 210, because adding the two periods combines the cycles."
                },
                {
                  "id": "float_ratio_126",
                  "text": "Step 126, because 126/84 is approximately 1.5 and can be rounded to a whole number of cycles."
                }
              ],
              "acceptedOptionIds": [
                "lcm_252"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A simultaneous recurrence must be a positive multiple of both periods, so the least such step is their lcm.",
              "details": "The gcd measures shared factor structure; it is not generally a multiple of either period. Using gcd=42 gives lcm=84·126/42=252, and 252 is exactly three 84-step cycles and two 126-step cycles. Adding periods may produce a common multiple in some accidental cases but has no leastness guarantee. A floating ratio cannot establish exact integral cycle counts.",
              "wrongOptionExplanationsByOptionId": {
                "gcd_42": "42 divides both periods but is smaller than each, so neither event has completed a full cycle at step 42.",
                "sum_210": "210 is not divisible by 84 or 126, so the events are not aligned there.",
                "float_ratio_126": "126 is not divisible by 84; rounding a ratio cannot replace exact divisibility."
              }
            },
            "difficulty": "foundational-transfer",
            "taxonomy": {
              "primarySkillAtomId": "apply_euclidean_algorithm",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "euclidean_algorithm",
              "problemArchetypeId": "divisibility_and_cycles"
            }
          },
          {
            "id": "alg-mg-gcd-negative-remainder-semantics",
            "prompt": "A programming language defines remainder with the sign of the dividend, so -25 % 7 evaluates to -4. How should a gcd routine for signed inputs obtain the standard Euclidean invariant 0 <= r < b?",
            "constraints": [
              "The public gcd result is nonnegative.",
              "The divisor in the loop must be positive."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "normalize_inputs_first",
                  "text": "Convert both inputs to safe nonnegative magnitudes before the loop, then use the language remainder."
                },
                {
                  "id": "assume_positive_remainder",
                  "text": "Run the loop on signed inputs and assume % always returns a value in [0,b)."
                },
                {
                  "id": "use_float_fmod",
                  "text": "Replace integer remainder with floating fmod and compare r with zero using ==."
                },
                {
                  "id": "discard_negative_remainder",
                  "text": "If r is negative, set it to zero and terminate."
                }
              ],
              "acceptedOptionIds": [
                "normalize_inputs_first"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Normalizing signs before Euclid makes the language remainder satisfy the intended nonnegative remainder invariant.",
              "details": "The mathematical Euclidean remainder is conventionally chosen in [0,b), but language % operators vary for negative dividends. Once a and b are safe nonnegative magnitudes and b>0, the ordinary remainder has the required range. Silently assuming another language’s semantics can break progress, and replacing a negative remainder with zero invents divisibility. An alternative explicit normalization r=((a%b)+b)%b is valid when its arithmetic is safe, but one consistent sign contract is simpler for gcd.",
              "wrongOptionExplanationsByOptionId": {
                "assume_positive_remainder": "The prompt states a remainder rule that can produce negative values, so the standard invariant does not follow without normalization.",
                "use_float_fmod": "Floating remainder is unnecessary and exact equality is not a sound substitute for integer divisibility.",
                "discard_negative_remainder": "A negative remainder is not evidence of exact divisibility; changing it to zero changes the gcd computation."
              }
            },
            "difficulty": "foundational-boundary",
            "taxonomy": {
              "primarySkillAtomId": "apply_euclidean_algorithm",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "euclidean_algorithm",
              "problemArchetypeId": "compute_gcd_lcm"
            }
          },
          {
            "id": "alg-mg-gcd-euclidean-complexity",
            "prompt": "For the iterative Euclidean algorithm on nonnegative integers a and b, classify its asymptotic time and extra-space costs in terms of the smaller positive input.",
            "constraints": [
