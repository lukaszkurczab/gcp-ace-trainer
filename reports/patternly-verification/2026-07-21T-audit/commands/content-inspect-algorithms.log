        "items": [
          {
            "id": "alg-bits-shifts-001",
            "prompt": "What is the result of logically right-shifting the 8-bit unsigned pattern 10010000 by 2 positions?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bits_00100100",
                  "text": "00100100."
                },
                {
                  "id": "bits_11100100",
                  "text": "11100100."
                },
                {
                  "id": "bits_01001000",
                  "text": "01001000."
                },
                {
                  "id": "bits_00010010",
                  "text": "00010010."
                }
              ],
              "acceptedOptionIds": [
                "bits_00100100"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Logical right shift inserts zeros at the high end.",
              "details": "Shifting 10010000 right twice yields 00100100.",
              "wrongOptionExplanationsByOptionId": {
                "bits_11100100": "That is the arithmetic-right-shift result with sign extension.",
                "bits_01001000": "This is a shift by one position.",
                "bits_00010010": "This is a shift by three positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reason_about_bit_shift_behavior",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Use exactly 8 bits and logical right shift."
            ]
          },
          {
            "id": "alg-bits-shifts-002",
            "prompt": "What is the result of arithmetically right-shifting the 8-bit two's-complement pattern 10010000 by 2 positions?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bits_11100100",
                  "text": "11100100."
                },
                {
                  "id": "bits_00100100",
                  "text": "00100100."
                },
                {
                  "id": "bits_11001000",
                  "text": "11001000."
                },
                {
                  "id": "bits_10010000",
                  "text": "10010000."
                }
              ],
              "acceptedOptionIds": [
                "bits_11100100"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Arithmetic right shift replicates the sign bit.",
              "details": "The leading one is copied into the two vacated high positions, preserving a negative two's-complement interpretation.",
              "wrongOptionExplanationsByOptionId": {
                "bits_00100100": "That fills high positions with zeros rather than the sign bit.",
                "bits_11001000": "This is only one arithmetic shift.",
                "bits_10010000": "A nonzero shift changes bit positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reason_about_bit_shift_behavior",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Use exactly 8 bits, two's-complement interpretation, and arithmetic right shift."
            ]
          },
          {
            "id": "alg-bits-shifts-003",
            "prompt": "For which values do logical and arithmetic right shift produce the same high-bit fill under a fixed-width two's-complement model?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "nonnegative",
                  "text": "Values whose sign bit is zero."
                },
                {
                  "id": "negative",
                  "text": "All negative values."
                },
                {
                  "id": "all_values",
                  "text": "Every value."
                },
                {
                  "id": "only_zero",
                  "text": "Only zero."
                }
              ],
              "acceptedOptionIds": [
                "nonnegative"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Arithmetic right shift copies the sign bit, while logical right shift always inserts zero.",
              "details": "When the sign bit is zero, both fill rules are identical.",
              "wrongOptionExplanationsByOptionId": {
                "negative": "Arithmetic shift inserts ones while logical shift inserts zeros.",
                "all_values": "They differ for values with the sign bit set.",
                "only_zero": "Every nonnegative pattern receives zero fill in both operations."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reason_about_bit_shift_behavior",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-shifts-004",
            "prompt": "When does left-shifting a nonnegative integer x by k represent multiplication by 2^k?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_discarded_bits",
                  "text": "When the declared representation can hold the result without discarding significant bits."
                },
                {
                  "id": "always_signed",
                  "text": "For every fixed-width signed value, including overflow."
                },
