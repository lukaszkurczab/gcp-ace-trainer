        "items": [
          {
            "id": "algorithms-intervals-insert-001",
            "prompt": "An existing list is sorted by start and pairwise non-overlapping. Which one-pass structure correctly inserts a new interval while preserving that invariant?",
            "constraints": [
              "Use the declared endpoint contract for all before/overlap comparisons.",
              "The output must remain sorted and non-overlapping."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "three_phases",
                  "text": "Append intervals strictly before the new interval, merge every overlapping interval into it, append the remaining intervals."
                },
                {
                  "id": "append_then_local",
                  "text": "Append the new interval at the end and compare it only with the last old interval."
                },
                {
                  "id": "sort_by_length",
                  "text": "Sort all intervals by length and merge adjacent records."
                }
              ],
              "acceptedOptionIds": [
                "three_phases"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Start-sorted disjoint input makes the intervals before, overlapping, and after the new range appear as three contiguous phases.",
              "details": "First copy every interval whose end is at or before the new start under the half-open non-overlap rule. Then, while the next interval begins before the growing new end, replace the new bounds with min(starts) and max(ends). Once an interval begins at or after the merged new end, the disjoint start order proves that all remaining intervals are also after it, so append them unchanged. The scan visits each existing interval at most once and never mutates the prepared order. The precise equality operators come from the endpoint and adjacency policy, not from the three-phase structure itself.",
              "wrongOptionExplanationsByOptionId": {
                "append_then_local": "The new interval may belong near the beginning or overlap several earlier intervals. A tail-only comparison does not preserve order or union.",
                "sort_by_length": "Length order does not create the before/overlap/after regions required by insertion."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "insert_interval_into_merged_sequence",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "insert_interval",
              "problemArchetypeId": "insert_into_merged_intervals"
            }
          },
          {
            "id": "algorithms-intervals-insert-002",
            "prompt": "Insert [6, 10) into the sorted, non-overlapping half-open list [1, 2), [5, 7), [9, 12). What is the resulting list?",
            "constraints": [
              "Intervals overlap when later.start < earlier.end.",
              "The new interval may grow while scanning."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "merged_result",
                  "text": "[1, 2), [5, 12)"
                },
                {
                  "id": "merge_first_only",
                  "text": "[1, 2), [5, 10), [9, 12)"
                },
                {
                  "id": "keep_new_separate",
                  "text": "[1, 2), [5, 7), [6, 10), [9, 12)"
                }
              ],
              "acceptedOptionIds": [
                "merged_result"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The new range first expands to [5, 10) and then to [5, 12), so both intersecting old intervals join one component.",
              "details": "[1, 2) ends before the new start and is copied unchanged. [5, 7) overlaps [6, 10), so the growing interval becomes [5, 10). The next interval [9, 12) must be compared with that updated state, not the original new interval; because 9 < 10, it extends the end to 12. No intervals remain, so append [5, 12). This trace tests transitive growth during insertion and prevents an implementation from stopping after the first overlap or from comparing every old interval only against the original bounds.",
              "wrongOptionExplanationsByOptionId": {
                "merge_first_only": "After merging with [5, 7), the new active range is [5, 10), which still overlaps [9, 12). The overlap phase must continue.",
                "keep_new_separate": "The output contains overlapping intervals and therefore violates the normalized-list contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "insert_interval_into_merged_sequence",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "insert_interval",
              "problemArchetypeId": "insert_into_merged_intervals"
            }
          },
          {
            "id": "algorithms-intervals-insert-003",
            "prompt": "Insert [0, 1) into [3, 5), [8, 10), where the existing list is sorted and disjoint. What should the algorithm do?",
            "constraints": [
              "All intervals are half-open.",
              "The new interval ends before the first existing start."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "prepend",
                  "text": "Place [0, 1) before the existing list without merging."
                },
                {
                  "id": "sort_by_end_first",
                  "text": "Re-sort all three intervals by end before deciding."
                },
                {
                  "id": "merge_with_first",
                  "text": "Merge to [0, 5) because the new interval comes first."
                }
              ],
              "acceptedOptionIds": [
                "prepend"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Because new.end <= first.start under half-open semantics, the new interval is strictly before every existing interval.",
              "details": "The sorted list makes this an early boundary case. [0, 1) is disjoint from [3, 5), and every later interval starts even farther right. The algorithm can append the new interval to output and then append the entire old list unchanged. No sort, heap, or pairwise scan beyond the first comparison is required for correctness, although an implementation may still use the same general loop. This case also separates ordering from overlap: an interval being first does not justify merging across a gap.",
              "wrongOptionExplanationsByOptionId": {
                "sort_by_end_first": "The existing start order already proves the new interval is before every old interval. Re-sorting adds work and abandons the insertion invariant.",
                "merge_with_first": "Chronological order does not imply overlap. The first interval ends at 1 and the new interval starts at 3, so a positive gap requires them to remain separate."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "insert_interval_into_merged_sequence",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "insert_interval",
              "problemArchetypeId": "insert_into_merged_intervals"
            }
          },
          {
            "id": "algorithms-intervals-insert-004",
            "prompt": "Insert [12, 15) into [1, 3), [6, 9), where the list is sorted and disjoint. What is the normalized output?",
            "constraints": [
              "The new interval begins after the last existing end."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "append_new",
                  "text": "[1, 3), [6, 9), [12, 15)"
                },
                {
                  "id": "merge_last",
                  "text": "[1, 3), [6, 15)"
                },
                {
                  "id": "end_sort",
                  "text": "[1, 3), [6, 9), [12, 15) only after re-sorting by end"
