            }
          },
          {
            "id": "algorithms-intervals-insert-008",
            "prompt": "A long old interval is [0, 9). New interval X is [10, 11), while new interval Y is [5, 5.5). Which statement is correct under half-open semantics?",
            "constraints": [
              "Evaluate X and Y separately against the old interval."
