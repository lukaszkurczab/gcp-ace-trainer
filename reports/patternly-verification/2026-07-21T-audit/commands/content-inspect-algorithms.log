        "items": [
          {
            "id": "alg-contrast-hash-sort-reject-001",
            "prompt": "Which statement correctly replaces the heuristic \"a hash map is always faster than sorting\"?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "conditional_choice",
                  "text": "Hashing is often expected-linear for equality state, but the preferred strategy depends on correctness, guarantees, memory, ordering, mutation, key costs, and the full workload."
                },
                {
                  "id": "hash_universal",
                  "text": "Hashing dominates every sorting-based solution."
                },
                {
                  "id": "sort_universal",
                  "text": "Sorting dominates every hash-based solution."
                },
                {
                  "id": "same_always",
                  "text": "Both strategies always have identical costs."
                }
              ],
              "acceptedOptionIds": [
                "conditional_choice"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The false heuristic should be replaced by an explicit conditional decision rule.",
              "details": "Both families are useful when their mechanism matches the result contract and cost model.",
              "wrongOptionExplanationsByOptionId": {
                "hash_universal": "Counterexamples include ordered output, unhashable keys, existing sorted order, tight memory, and adversarial guarantees.",
                "sort_universal": "Many equality-heavy workloads benefit from hashing.",
                "same_always": "Their time, space, guarantees, and output structure differ."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-002",
            "prompt": "Why is expected O(1) hash lookup not a universal latency guarantee?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "expected_not_worst",
                  "text": "Collisions, resizing, adversarial inputs, and implementation details can create slower operations."
                },
                {
                  "id": "lookup_not_bit",
                  "text": "Hash lookup is not a bit operation."
                },
                {
                  "id": "sorting_constant",
                  "text": "Sorting always has O(1) latency."
                },
                {
                  "id": "keys_no_equality",
                  "text": "Hash tables never compare keys."
                }
              ],
              "acceptedOptionIds": [
                "expected_not_worst"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Expected and worst-case analyses answer different operational requirements.",
              "details": "A system requiring deterministic bounds may prefer sorting or a protected hashing scheme.",
              "wrongOptionExplanationsByOptionId": {
                "lookup_not_bit": "That does not explain the guarantee boundary.",
                "sorting_constant": "Sorting also has nonconstant work.",
                "keys_no_equality": "Equality checks are part of collision resolution."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-003",
            "prompt": "How can cache locality challenge the assumption that fewer expected hash operations always run faster?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "memory_access",
                  "text": "Hash tables may perform indirect, irregular accesses, while sorting and scanning contiguous arrays can use caches efficiently."
                },
                {
                  "id": "cache_changes_big_o",
                  "text": "Caches change O(n log n) into O(1)."
                },
                {
                  "id": "hash_no_memory",
                  "text": "Hashing has no memory accesses."
                },
                {
                  "id": "sort_random",
                  "text": "Sorting always accesses memory randomly."
                }
              ],
              "acceptedOptionIds": [
                "memory_access"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Practical time is influenced by data movement and locality as well as operation counts.",
              "details": "This does not prove sorting always wins; it disproves the universal hash claim.",
              "wrongOptionExplanationsByOptionId": {
                "cache_changes_big_o": "They affect constants and practical throughput, not the abstract comparison count.",
                "hash_no_memory": "Table probes are memory accesses.",
                "sort_random": "Many sorting and scan phases are locality-friendly."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-004",
            "prompt": "Memory is limited, input mutation is legal, and only duplicate existence is needed. Which fact can make sorting preferable?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_lower_space",
                  "text": "An in-place sort and scan can use much less auxiliary memory than an O(n)-entry hash set."
                },
                {
                  "id": "hash_no_space",
                  "text": "A set uses no auxiliary memory."
                },
                {
                  "id": "sort_no_time",
                  "text": "Sorting is free when mutation is legal."
                },
                {
                  "id": "duplicates_hash_only",
                  "text": "Duplicates can only be detected through hashing."
                }
              ],
              "acceptedOptionIds": [
                "sort_lower_space"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A slower asymptotic time may be the legal choice under a stricter space budget.",
              "details": "Strategy optimization is multi-dimensional.",
              "wrongOptionExplanationsByOptionId": {
                "hash_no_space": "It stores seen values.",
                "sort_no_time": "It still costs O(n log n) under comparison sorting.",
                "duplicates_hash_only": "Sorting exposes adjacent equal values."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-005",
            "prompt": "The output must list groups in ascending key order. Why can sorting be a better fit?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "order_consumed",
                  "text": "Sorting creates the exact order and adjacency consumed by the output."
                },
                {
                  "id": "hash_sorted",
                  "text": "A hash map automatically iterates in ascending key order."
                },
                {
                  "id": "nlogn_faster_definition",
                  "text": "O(n log n) is definitionally faster than O(n)."
                },
                {
                  "id": "memory_irrelevant",
                  "text": "Output requirements make memory irrelevant."
                }
              ],
              "acceptedOptionIds": [
                "order_consumed"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The sort is not overhead when its order is a required result structure.",
              "details": "A hash path may need to sort keys later, so the full cost can be similar or larger.",
              "wrongOptionExplanationsByOptionId": {
                "hash_sorted": "No universal ascending guarantee exists.",
                "nlogn_faster_definition": "Asymptotic growth says the opposite for large n under aligned models.",
                "memory_irrelevant": "Memory still belongs in the comparison."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-006",
            "prompt": "Keys have a valid total order but deliberately no compatible hash function. What happens to the universal hash claim?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_illegal",
                  "text": "Hashing is not a legal candidate, while sorting remains available."
                },
                {
                  "id": "invent_hash",
                  "text": "Any arbitrary object address can replace semantic hashing."
                },
                {
                  "id": "no_algorithm",
                  "text": "No strategy can process the keys."
                },
                {
                  "id": "hash_strings",
                  "text": "Stringifying keys is always semantically safe."
                }
              ],
              "acceptedOptionIds": [
                "hash_illegal"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correctness and legal key operations precede speed comparison.",
              "details": "A strategy that cannot implement the domain relation is not made valid by its expected complexity.",
              "wrongOptionExplanationsByOptionId": {
                "invent_hash": "It may violate equality compatibility and stability.",
                "no_algorithm": "Comparison-based sorting can.",
                "hash_strings": "String encodings may collide or fail to match domain equality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-007",
            "prompt": "Input is already sorted and the task needs one grouping scan. Which conclusion rejects the heuristic?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "reuse_order",
                  "text": "The sorting-based representation is already available, so a linear run scan can beat building extra hash state."
                },
                {
                  "id": "hash_rebuild",
                  "text": "Hashing must rebuild because expected O(n) always wins."
                },
                {
                  "id": "sort_again",
                  "text": "The array must be sorted again before every scan."
                },
                {
                  "id": "groups_need_hash",
                  "text": "Equal-run grouping cannot use existing order."
                }
              ],
              "acceptedOptionIds": [
                "reuse_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Existing preprocessing changes the starting point of the workload.",
              "details": "Ignoring supplied order creates a biased comparison.",
              "wrongOptionExplanationsByOptionId": {
                "hash_rebuild": "Both paths are O(n), but the hash path allocates unused state.",
                "sort_again": "The precondition says it is already sorted.",
                "groups_need_hash": "That is exactly what sorted adjacency enables."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-008",
            "prompt": "For small n, why can a simple sort or scan outperform hash-table setup?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "constants_setup",
                  "text": "Allocation, hashing, bucket initialization, and indirection can dominate small workloads."
                },
                {
                  "id": "big_o_false",
                  "text": "Big-O analysis is mathematically false."
                },
                {
                  "id": "hash_quadratic",
                  "text": "Every hash operation is quadratic."
                },
                {
                  "id": "sort_constant",
                  "text": "Sorting small arrays is always O(1) asymptotically."
                }
              ],
              "acceptedOptionIds": [
                "constants_setup"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Asymptotic dominance does not specify every finite crossover point.",
              "details": "After correctness, implementation simplicity and constants can guide small-input choices.",
              "wrongOptionExplanationsByOptionId": {
                "big_o_false": "It remains valid for growth, not exact small-instance timing.",
                "hash_quadratic": "Expected operations can still be constant.",
                "sort_constant": "n remains a variable in the complexity model."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-009",
            "prompt": "A service accepts attacker-controlled keys and requires predictable worst-case response. Which concern weakens a conventional hash-table choice?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "collision_attack",
                  "text": "Adversarial collisions can violate the expected constant-time assumption."
                },
                {
                  "id": "sort_no_attack",
                  "text": "Sorting can never receive adversarial input."
                },
                {
                  "id": "hash_no_keys",
                  "text": "Hash tables do not process keys."
                },
                {
                  "id": "expected_is_worst",
                  "text": "Expected bounds are identical to worst-case bounds."
                }
              ],
              "acceptedOptionIds": [
                "collision_attack"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The input model and guarantee level must match the analysis.",
              "details": "Protected hashing, balanced buckets, or deterministic sorting may be considered depending on the system contract.",
              "wrongOptionExplanationsByOptionId": {
                "sort_no_attack": "It can, but deterministic comparison bounds remain analyzable.",
                "hash_no_keys": "Key distribution directly affects them.",
                "expected_is_worst": "They are not."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-010",
            "prompt": "Hashing a large structured key is expensive, while comparing keys often stops after a cheap prefix. What does this show?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "primitive_costs",
                  "text": "The number of operations must be combined with the actual cost of hashing and comparison."
                },
                {
                  "id": "hash_free",
                  "text": "Expected O(1) means hash computation is free."
                },
                {
                  "id": "sorting_invalid",
                  "text": "Early-ending comparisons make sorting incorrect."
                },
                {
                  "id": "keys_constant",
                  "text": "All key operations have identical constants by definition."
                }
              ],
              "acceptedOptionIds": [
                "primitive_costs"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Expected linear versus n log n counts are meaningful only under a stated primitive-cost model.",
              "details": "Expensive hashing can move the practical crossover substantially.",
              "wrongOptionExplanationsByOptionId": {
                "hash_free": "O(1) probe count does not erase key processing.",
                "sorting_invalid": "They affect cost, not correctness.",
                "keys_constant": "The cost model may distinguish them."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-011",
            "prompt": "Which final decision rule is invalid?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "headline_only",
                  "text": "Choose hashing whenever its headline expected asymptotic term is smaller, without checking the result or assumptions."
                },
                {
                  "id": "correctness_first",
                  "text": "Reject strategies that cannot preserve required order, indices, or legal key operations."
                },
                {
                  "id": "full_workload",
                  "text": "Include preprocessing, queries, updates, output, and memory."
                },
                {
                  "id": "guarantee_match",
                  "text": "Match expected or deterministic guarantees to the environment."
                }
              ],
              "acceptedOptionIds": [
                "headline_only"
