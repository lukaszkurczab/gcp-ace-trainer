          {
            "id": "alg-contrast-window-prefix-negative-017",
            "prompt": "Arrange the exact-sum prefix-hash workflow for arbitrary integers.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "seed_zero",
                  "text": "Store prefix value 0 before reading elements."
                },
                {
                  "id": "accumulate",
                  "text": "Add the current value to the running prefix."
                },
                {
                  "id": "lookup",
                  "text": "Query whether or how often runningPrefix - k occurred earlier."
                },
                {
                  "id": "store_current",
                  "text": "Store the current prefix according to the result contract."
                }
              ],
              "canonicalOrder": [
