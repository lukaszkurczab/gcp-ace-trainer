        "authoringProvenance": {
          "author": "lukasz-kurczab",
          "createdAt": "2026-07-18T00:00:00.000Z",
          "contentBatchId": "contrast-binary-search-vs-linear-scan-correctness-before-asymptotic-speed-v1",
          "authoringMethod": "independently_authored"
        },
        "items": [
          {
            "id": "alg-contrast-binary-scan-correctness-001",
            "prompt": "An unsorted array is searched once for an exact target. A proposed binary search compares the midpoint and discards one side as though the array were sorted. Which strategy is correct?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_scan",
                  "text": "Use a linear scan because every position remains a possible target location."
                },
                {
                  "id": "binary_search",
                  "text": "Use the proposed binary search because O(log n) is asymptotically faster."
                },
                {
                  "id": "mid_only",
                  "text": "Check only the midpoint and return not found after one mismatch."
                },
                {
                  "id": "sort_without_cost",
                  "text": "Treat the array as sorted without actually preprocessing it."
                }
              ],
              "acceptedOptionIds": [
                "linear_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A correct O(n) scan is preferable to an unsound O(log n)-shaped procedure.",
              "details": "Asymptotic comparison begins only after both candidates satisfy the query contract. Here, the scan is legal and the midpoint discard rule is not.",
              "wrongOptionExplanationsByOptionId": {
                "binary_search": "The midpoint comparison gives no legal direction in unsorted data, so the algorithm can discard the target.",
                "mid_only": "One mismatch does not eliminate any other position.",
                "sort_without_cost": "Correctness cannot assume an order that is not present."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-002",
            "prompt": "A sorted array is queried for the first element whose index is even and whose value is divisible by 7. The condition can be true, false, then true again. Which approach is justified without additional structure?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan",
                  "text": "Scan candidates because the full condition is not monotonic in sorted value order."
                },
                {
                  "id": "binary",
                  "text": "Binary-search the condition because the array values are sorted."
                },
                {
                  "id": "return_mid",
                  "text": "Return the first midpoint satisfying either part of the condition."
                },
                {
                  "id": "discard_false_half",
                  "text": "Discard the half containing a false midpoint."
                }
              ],
              "acceptedOptionIds": [
                "scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correctness follows the complete query predicate, not a partial sorted-data signal.",
              "details": "A linear scan checks every candidate under the arbitrary condition. Binary search becomes legal only after proving one directional truth transition.",
              "wrongOptionExplanationsByOptionId": {
                "binary": "Sorted values do not make the combined index-and-divisibility condition monotonic.",
                "return_mid": "The query requires both parts and the first qualifying element.",
                "discard_false_half": "A false midpoint does not imply every candidate on that side is false."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-003",
            "prompt": "A sorted array contains duplicates. The query asks for any index containing target. Both a standard binary search and a linear scan are implemented correctly. Which principle applies?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "compare_cost_after_correctness",
                  "text": "Both are correct; compare workload and cost only after confirming the any-match contract."
                },
                {
                  "id": "scan_only",
                  "text": "The scan is the only correct method because duplicates exist."
                },
                {
                  "id": "binary_only",
                  "text": "Binary search is the only correct method because the input is sorted."
                },
                {
                  "id": "first_required",
                  "text": "Both are incorrect unless they return the first occurrence."
                }
              ],
              "acceptedOptionIds": [
                "compare_cost_after_correctness"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correctness is a gate, not a ranking result.",
              "details": "Once both strategies meet the exact result contract, query count, preprocessing state, constants, and simplicity can determine the preferred implementation.",
              "wrongOptionExplanationsByOptionId": {
                "scan_only": "Duplicates do not prevent any-match binary search.",
                "binary_only": "A scan is also correct, though usually slower asymptotically.",
                "first_required": "The contract accepts any matching index."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-004",
            "prompt": "A function must return the first matching record in original arrival order. Records are also available in a separate array sorted by key, but that array does not preserve arrival positions. Which strategy is correct for this output contract?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan_original",
                  "text": "Scan the original sequence unless the sorted representation also preserves and exposes original-order provenance."
                },
                {
                  "id": "binary_sorted",
                  "text": "Binary-search the sorted array and return any matching record."
                },
                {
                  "id": "binary_then_guess",
                  "text": "Binary-search and choose the leftmost sorted duplicate as the first arrival."
                },
                {
                  "id": "ignore_order",
                  "text": "Ignore the original-order clause because binary search is faster."
                }
              ],
              "acceptedOptionIds": [
                "scan_original"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The fastest key lookup is not correct if it returns the wrong identity under the output contract.",
              "details": "Binary search could become appropriate if the index stores the minimum original position for each key or otherwise preserves the required provenance.",
              "wrongOptionExplanationsByOptionId": {
                "binary_sorted": "A key match in sorted order does not establish the first arrival-order match.",
                "binary_then_guess": "Sorted duplicate order need not equal arrival order.",
                "ignore_order": "That changes the required result."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-005",
            "prompt": "A binary-search implementation uses left, right, and mid but updates left = mid when the midpoint is too small and uses a lower-biased midpoint. On two adjacent candidates it can repeat forever. Which assessment is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "incorrect_nonterminating",
                  "text": "It is incorrect because it does not guarantee progress; a terminating scan is preferable until the boundary contract is repaired."
                },
                {
                  "id": "log_by_names",
                  "text": "It is O(log n) because the expected variables are present."
                },
                {
                  "id": "correct_if_sorted",
                  "text": "It is correct whenever the input is sorted."
                },
                {
                  "id": "same_as_scan",
                  "text": "It is equivalent to a linear scan because both inspect values."
                }
              ],
              "acceptedOptionIds": [
                "incorrect_nonterminating"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A claimed asymptotic benefit is irrelevant when the algorithm violates termination.",
              "details": "Correct binary search requires a coherent interval, midpoint bias, and strict progress. Until then, a correct scan dominates the defective implementation.",
              "wrongOptionExplanationsByOptionId": {
                "log_by_names": "Variable names do not guarantee interval shrinkage or termination.",
                "correct_if_sorted": "Sortedness does not repair a non-progressing update.",
                "same_as_scan": "The defective loop may never terminate."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-006",
            "prompt": "A one-time lookup is performed on an unsorted array of n values. Option A scans in O(n). Option B sorts a copy in O(n log n) and then binary-searches in O(log n). Ignoring constants, which strategy has the better complete asymptotic cost for this single query?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan",
                  "text": "The scan, because O(n) is less than O(n log n + log n)."
                },
                {
                  "id": "sort_binary",
                  "text": "Sort plus binary search, because the final query is O(log n)."
                },
                {
                  "id": "equal",
                  "text": "They are asymptotically equal."
                },
                {
                  "id": "binary_without_sort",
                  "text": "Binary-search the unsorted array directly."
                }
              ],
              "acceptedOptionIds": [
                "scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The comparison must include every operation needed to produce a correct answer.",
              "details": "For one unsorted query, sorting solely to enable binary search adds more asymptotic work than a direct scan.",
              "wrongOptionExplanationsByOptionId": {
                "sort_binary": "This ignores the preprocessing cost required to make binary search legal.",
                "equal": "O(n log n) grows faster than O(n).",
                "binary_without_sort": "That is not correct."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-007",
            "prompt": "A linked list is sorted by value and supports only sequential traversal from the head. Which default strategy is more defensible for one exact lookup?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_traversal",
                  "text": "Traverse linearly because locating the midpoint is not constant-time under this access model."
                },
                {
                  "id": "array_binary_assumption",
                  "text": "Apply array-style binary search and count each midpoint access as O(1)."
                },
                {
                  "id": "always_log",
                  "text": "Binary search remains O(log n) on every sorted structure."
                },
                {
                  "id": "ignore_access",
                  "text": "Use whichever code has variables named left and right."
                }
              ],
              "acceptedOptionIds": [
                "linear_traversal"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correctness and cost both depend on the data-access contract.",
              "details": "A specialized indexed structure could support logarithmic search, but ordinary linked-list traversal does not obtain array-style midpoint access for free.",
              "wrongOptionExplanationsByOptionId": {
                "array_binary_assumption": "The data structure does not provide random access.",
                "always_log": "Midpoint location can dominate the work.",
                "ignore_access": "Access cost and invariant, not names, determine the method."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-008",
            "prompt": "A monotonic predicate is proven correct, but evaluating it at one candidate scans all n records. Which statement best evaluates binary search versus one direct scan for a single query?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "compare_full_work",
                  "text": "Binary search is correct, but its total cost is O(n log W); a direct O(n) scan may be cheaper if it answers the same contract."
                },
                {
                  "id": "binary_log_only",
                  "text": "Binary search costs only O(log W), regardless of predicate work."
                },
                {
                  "id": "scan_incorrect",
                  "text": "A scan is automatically incorrect when a monotonic predicate exists."
                },
                {
                  "id": "predicate_free",
                  "text": "Midpoint evaluation has no cost because it returns a boolean."
                }
              ],
              "acceptedOptionIds": [
                "compare_full_work"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A legal algorithm is not automatically the cheapest legal algorithm.",
              "details": "The transfer boundary is the full workload: binary search wins only when the reduced candidate count outweighs the cost of each predicate evaluation.",
              "wrongOptionExplanationsByOptionId": {
                "binary_log_only": "The predicate cost must be multiplied by the number of iterations.",
                "scan_incorrect": "A scan may still evaluate candidates correctly.",
                "predicate_free": "Computing that boolean may be expensive."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-009",
            "prompt": "A sorted array is tiny and queried once. Both scan and exact binary search are correct. What should the correctness-first framework conclude?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_then_engineering",
                  "text": "Both pass correctness; choose using measured constants, simplicity, and surrounding workload rather than an absolute rule."
                },
                {
                  "id": "binary_mandatory",
                  "text": "Binary search is mandatory because sorted input always requires it."
                },
                {
                  "id": "scan_mandatory",
                  "text": "Linear scan is mandatory for all small inputs."
                },
                {
                  "id": "neither",
                  "text": "Neither can be correct on a small array."
                }
              ],
              "acceptedOptionIds": [
                "both_then_engineering"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correctness narrows the candidate strategies; it does not always select a unique implementation.",
              "details": "For very small one-off workloads, constant factors and code clarity may outweigh asymptotic differences without changing the conceptual boundary.",
              "wrongOptionExplanationsByOptionId": {
                "binary_mandatory": "Sortedness makes binary search possible, not compulsory.",
                "scan_mandatory": "Binary search remains correct; the preference is an engineering tradeoff.",
                "neither": "Input size does not invalidate either method."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-010",
            "prompt": "A proposed optimization replaces a verified scan with binary search but cannot state which half is impossible after each mismatch. What should code review require?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "reject_until_proof",
                  "text": "Reject the replacement until a legal half-discard invariant and coherent boundary updates are supplied."
                },
                {
                  "id": "accept_benchmark",
                  "text": "Accept it if one benchmark is faster."
                },
                {
                  "id": "accept_sorted_word",
                  "text": "Accept it because the requirement text contains the word sorted."
                },
                {
                  "id": "rename_variables",
                  "text": "Rename variables to left, right, and mid."
                }
              ],
              "acceptedOptionIds": [
                "reject_until_proof"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Optimization requires a correctness argument before performance evidence is relevant.",
              "details": "The reviewer should demand the active candidate invariant, elimination proof, progress argument, and exit meaning.",
              "wrongOptionExplanationsByOptionId": {
                "accept_benchmark": "A benchmark cannot prove correctness on unseen inputs.",
                "accept_sorted_word": "The query must align with the order and the implementation must preserve the invariant.",
                "rename_variables": "Names do not supply the missing proof."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-011",
            "prompt": "Which conditions must be established before preferring binary search over a correct scan? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "query_alignment",
                  "text": "The query or predicate aligns monotonically with the ordered search domain."
                },
                {
                  "id": "legal_discard",
                  "text": "Each midpoint result proves a complete region cannot contain the answer."
                },
                {
                  "id": "coherent_boundaries",
                  "text": "The interval updates preserve candidates and guarantee termination."
                },
                {
                  "id": "mid_name",
                  "text": "The implementation has a variable named mid."
                }
              ],
              "acceptedOptionIds": [
                "query_alignment",
                "legal_discard",
                "coherent_boundaries"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Binary search must pass semantic and mechanical correctness gates.",
              "details": "Only after these properties hold should its total cost be compared with scanning.",
              "wrongOptionExplanationsByOptionId": {
                "mid_name": "A variable name does not prove any invariant."
              },
              "omittedCorrectExplanationsByOptionId": {
                "query_alignment": "This establishes directional meaning.",
                "legal_discard": "This is the correctness mechanism.",
                "coherent_boundaries": "A legal idea can still be implemented incorrectly."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-012",
            "prompt": "Which scenarios make a linear scan the safer correct default? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "unsorted_no_preprocess",
                  "text": "Unsorted data with one exact query and no legal preprocessing."
                },
                {
                  "id": "arbitrary_condition",
                  "text": "A condition that can change true and false repeatedly across the ordered input."
                },
                {
                  "id": "original_first",
                  "text": "The output requires the first match in original order and the index does not preserve that provenance."
                },
                {
                  "id": "sorted_exact_many",
                  "text": "Many exact queries on a stable random-access sorted array."
                }
              ],
              "acceptedOptionIds": [
                "unsorted_no_preprocess",
                "arbitrary_condition",
                "original_first"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Scanning remains correct when the query lacks the structure needed for safe elimination.",
              "details": "Binary search becomes preferable under a stable ordered representation, aligned query, and sufficient query volume.",
              "wrongOptionExplanationsByOptionId": {
                "sorted_exact_many": "This is a strong binary-search workload."
              },
              "omittedCorrectExplanationsByOptionId": {
                "unsorted_no_preprocess": "No midpoint direction exists.",
                "arbitrary_condition": "No single boundary exists.",
                "original_first": "A sorted lookup may return the wrong identity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-013",
            "prompt": "Which defects invalidate a claimed binary-search optimization even if its average benchmark is fast? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "discard_without_proof",
                  "text": "It discards a side without proving that side impossible."
                },
                {
                  "id": "nonprogress",
                  "text": "Some branch can leave the active interval unchanged."
                },
                {
                  "id": "wrong_output_identity",
                  "text": "It returns any key match when the contract requires the first original-order match."
                },
                {
                  "id": "larger_constant",
                  "text": "Its constant factor is larger than the scan on one machine."
                }
              ],
              "acceptedOptionIds": [
                "discard_without_proof",
                "nonprogress",
                "wrong_output_identity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correctness defects are categorical; performance disadvantages are comparative.",
              "details": "A fast wrong answer or nonterminating path cannot be rescued by average measurements.",
              "wrongOptionExplanationsByOptionId": {
                "larger_constant": "This may affect preference but does not by itself invalidate correctness."
              },
              "omittedCorrectExplanationsByOptionId": {
                "discard_without_proof": "The target may be lost.",
                "nonprogress": "The algorithm may not terminate.",
                "wrong_output_identity": "It violates the result contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-014",
            "prompt": "Which changes can make binary search appropriate where a scan was previously required? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sort_and_preserve_contract",
                  "text": "Build an ordered representation that preserves all required output provenance."
                },
                {
                  "id": "prove_monotonic",
                  "text": "Reformulate the condition as a proven monotonic predicate."
                },
                {
                  "id": "add_index",
                  "text": "Add a maintained index that supports the required key and identity query."
                },
                {
                  "id": "rename_mid",
                  "text": "Rename the scan index to mid."
                }
              ],
              "acceptedOptionIds": [
                "sort_and_preserve_contract",
                "prove_monotonic",
                "add_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The strategy can transfer when the data representation or predicate gains the missing elimination structure.",
              "details": "Cosmetic code changes do not move the decision boundary.",
              "wrongOptionExplanationsByOptionId": {
                "rename_mid": "Naming does not change the algorithmic structure."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sort_and_preserve_contract": "This can create a legal query-aligned domain.",
                "prove_monotonic": "A searchable boundary may then exist.",
                "add_index": "The access and lookup contract changes."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-015",
            "prompt": "Arrange the strategy-review sequence for binary search versus linear scan.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_output",
                  "text": "State the exact result and identity contract."
                },
                {
                  "id": "prove_legality",
                  "text": "Prove which strategies can return that result for every allowed input."
                },
                {
                  "id": "derive_total_cost",
                  "text": "Derive preprocessing, access, predicate, query, and output costs for the legal strategies."
                },
                {
                  "id": "choose",
                  "text": "Choose the legal strategy that best fits the workload and engineering constraints."
                }
              ],
              "canonicalOrder": [
                "state_output",
                "prove_legality",
                "derive_total_cost",
                "choose"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Correctness precedes asymptotic and practical optimization.",
              "details": "This order prevents an attractive complexity label from hiding a contract violation."
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-016",
            "prompt": "Arrange the review of a proposed scan-to-binary-search replacement.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "identify_order",
                  "text": "Identify the ordered domain and the full query predicate."
                },
                {
                  "id": "derive_implication",
                  "text": "Derive what a midpoint outcome proves about each side."
                },
                {
                  "id": "verify_loop",
                  "text": "Verify boundaries, strict progress, and exit meaning."
                },
                {
                  "id": "benchmark_after",
                  "text": "Only then compare full-workload performance with the original scan."
                }
              ],
              "canonicalOrder": [
                "identify_order",
                "derive_implication",
                "verify_loop",
                "benchmark_after"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The replacement is an algorithmic proof obligation before it is a benchmark exercise.",
              "details": "Failure at any of the first three steps means the scan remains the correct baseline."
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-017",
            "prompt": "An unsorted array of n values receives one query. Strategy A scans once. Strategy B copies and comparison-sorts the array, then binary-searches it. Select the complete worst-case time for each strategy.",
            "constraints": [
              "The copy is O(n).",
              "Comparison sorting is O(n log n).",
              "The binary search is O(log n)."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "scan_time",
                "sort_then_binary_time"
              ],
              "availableValuesByDimension": {
                "scan_time": [
                  "O(log n)",
                  "O(n)",
                  "O(n log n)",
                  "O(n²)"
                ],
                "sort_then_binary_time": [
                  "O(log n)",
                  "O(n)",
                  "O(n log n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "scan_time": [
                  "O(n)"
                ],
                "sort_then_binary_time": [
                  "O(n log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "scan_time": {
                  "single_pass": "O(n)"
                },
                "sort_then_binary_time": {
                  "preprocessing_dominates": "O(n log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "For a single unsorted query, making binary search legal costs more asymptotically than scanning.",
              "details": "The O(log n) query term does not replace the O(n log n) preprocessing term."
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-correctness-018",
            "prompt": "A proven monotonic binary search examines O(log W) candidates, but one predicate evaluation scans n records. A direct legal scan answers the same question in O(n). Select the total time of both strategies.",
            "constraints": [
              "The binary-search predicate is evaluated independently at each candidate.",
              "The direct scan needs one pass."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "binary_time",
                "scan_time"
              ],
              "availableValuesByDimension": {
                "binary_time": [
                  "O(log W)",
                  "O(n)",
                  "O(n log W)",
                  "O(nW)"
                ],
                "scan_time": [
                  "O(log n)",
                  "O(n)",
                  "O(n log W)",
                  "O(W)"
                ]
              },
              "acceptedValuesByDimension": {
                "binary_time": [
                  "O(n log W)"
                ],
                "scan_time": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "binary_time": {
                  "predicate_times_iterations": "O(n log W)"
                },
                "scan_time": {
                  "one_pass": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Legality does not imply lower total cost.",
              "details": "When the predicate repeats an O(n) scan, binary search can be asymptotically worse for the same result contract."
            },
            "taxonomy": {
              "primarySkillAtomId": "prioritize_correctness_in_binary_vs_scan_choice",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          }
        ],
