          "options": [
            {
              "id": "mutation_legal",
              "text": "Reordering the original input is legal."
            },
            {
              "id": "in_place_sort",
              "text": "A concrete in-place sort with bounded stack or buffer is chosen."
            },
            {
              "id": "no_index_metadata",
              "text": "Original positions do not need to be retained."
            },
            {
              "id": "stable_required_buffer",
              "text": "A stable output requires an O(n) temporary buffer."
            }
          ],
          "acceptedOptionIds": [
            "mutation_legal",
            "in_place_sort",
            "no_index_metadata"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "Sorting's memory advantage depends on being able to reuse the input storage directly.",
          "details": "Stability, immutability, and index retention can remove that advantage.",
          "wrongOptionExplanationsByOptionId": {
            "stable_required_buffer": "This weakens the low-memory advantage."
          },
          "omittedCorrectExplanationsByOptionId": {
            "mutation_legal": "No O(n) copy is needed.",
            "in_place_sort": "The memory claim becomes algorithm-specific and defensible.",
            "no_index_metadata": "No decoration array is required."
