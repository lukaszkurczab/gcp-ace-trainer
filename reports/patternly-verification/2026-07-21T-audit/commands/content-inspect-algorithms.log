            }
          },
          {
            "id": "alg-bits-subsets-019",
            "prompt": "An algorithm materializes every subset by scanning all n bit positions for each mask. Select total time and output space.",
            "constraints": [
              "All 2^n subsets are returned.",
              "Each subset is stored as its selected elements."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(2^n)",
                  "O(n·2^n)",
                  "O(n!)",
                  "O(n^2)"
                ],
                "output_space": [
                  "O(2^n)",
                  "O(n·2^n)",
                  "O(n!)",
                  "O(n^2)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n·2^n)"
                ],
                "output_space": [
                  "O(n·2^n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "scan_each_mask": "O(n·2^n)"
                },
                "output_space": {
                  "power_set_size": "O(n·2^n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Every mask scans n positions, and the total number of emitted element occurrences across the power set is Θ(n·2^n).",
              "details": "This cost is output-sensitive when every subset is materialized."
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_subset_by_bitmask",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "subset_mask",
              "problemArchetypeId": "enumerate_subsets_by_mask"
            }
          },
          {
            "id": "alg-bits-subsets-020",
            "prompt": "A naive algorithm enumerates all 2^n masks, computes popcount(mask) in O(n), and materializes only masks with exactly k set bits. Select worst-case time and output space in terms of C(n,k).",
            "constraints": [
              "Every mask is still inspected.",
              "Each retained subset stores k elements."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "output_space"
