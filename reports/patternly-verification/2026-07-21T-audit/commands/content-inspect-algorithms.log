          {
            "id": "alg-tree-path-mutable-buffer-sequence",
            "prompt": "A DFS uses one mutable `path` list to enumerate root-to-leaf paths without copying it at every edge. Order the branch-local operations for a non-null node.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "append_current",
                  "text": "Append the current node value to `path`."
                },
                {
                  "id": "record_if_leaf",
                  "text": "If the current node is a leaf, record a snapshot of `path`."
                },
                {
                  "id": "visit_children",
                  "text": "Otherwise recurse into the non-null children using the same `path` list."
                },
                {
                  "id": "remove_current",
                  "text": "Remove the current node value before returning to the parent."
