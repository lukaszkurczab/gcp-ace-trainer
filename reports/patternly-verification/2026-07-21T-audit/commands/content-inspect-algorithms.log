                "recursion_space": [
                  "O(1)",
                  "O(b)",
                  "O(d)",
                  "O(b^d)"
                ]
              },
              "acceptedValuesByDimension": {
                "visited_nodes": [
                  "O(b^d)"
                ],
                "recursion_space": [
                  "O(d)"
                ]
              },
              "normalizedAliasesByDimension": {
                "visited_nodes": {
                  "exponential_tree": "O(b^d)"
                },
                "recursion_space": {
                  "depth": "O(d)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The search tree can grow exponentially in depth, while depth-first recursion retains only one root-to-leaf path.",
              "details": "This bound is a structural warning, not proof that every backtracking problem reaches the full tree. Sound pruning and narrower candidate sets may reduce actual exploration."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_choice_tree_search",
              "secondarySkillAtomIds": [],
