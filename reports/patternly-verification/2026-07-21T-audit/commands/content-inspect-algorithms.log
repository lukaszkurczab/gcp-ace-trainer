          {
            "id": "recursion-basics-recursion-stack-and-complexity-tree-dfs-work-versus-height",
            "prompt": "A depth-first recursive traversal visits each of n real tree nodes once. Let h be the number of real nodes\non the longest root-to-leaf path. Which asymptotic statement is correct?",
            "constraints": [
              "The structure is a tree with no shared or cyclic nodes.",
              "Each real node is visited exactly once.",
              "Per-node local work is O(1)."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "time_n_stack_h",
                  "text": "Time is O(n), and recursion-stack space is O(h)."
                },
                {
                  "id": "time_h_stack_n",
                  "text": "Time is O(h), and recursion-stack space is O(n)."
                },
                {
                  "id": "time_n_stack_n_always",
                  "text": "Time is O(n), and recursion-stack space is always O(n)."
                },
                {
                  "id": "time_exponential",
                  "text": "Time and stack space are exponential because each node may make two recursive calls."
                }
              ],
              "acceptedOptionIds": [
                "time_n_stack_h"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Total work counts all visited nodes, while stack space counts only the longest active ancestor path.",
              "details": "Depth-first recursion suspends a parent while one descendant path is explored. At any instant, the active frames correspond to one root-to-current path, so the extra call stack is proportional to tree height h. Across the complete run, however, each of the n nodes is entered and processed, giving O(n) time when per-node work is constant. A skewed tree has h = n; a balanced tree has h = O(log n). This distinction between total call count and maximum simultaneous call depth is the central accounting boundary.",
              "wrongOptionExplanationsByOptionId": {
                "time_h_stack_n": "Height bounds one active path, not the total nodes visited. Every node contributes work even when the tree is shallow.",
                "time_n_stack_n_always": "O(n) is a valid worst-case upper bound, but it loses the decisive shape parameter. A balanced tree has h = O(log n), so only one root-to-leaf path is active.",
                "time_exponential": "The calls go to disjoint child subtrees and each real node is visited once. Branching does not imply repeated exponential states."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "account_for_recursive_call_stack",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "recursive_decomposition",
              "problemArchetypeId": "traverse_recursive_structure"
            }
          },
          {
            "id": "recursion-basics-recursion-stack-and-complexity-sumto-stack-unwind-trace",
            "prompt": "Order the runtime events for sumTo(2), where sumTo(0) returns 0 and sumTo(n) returns n + sumTo(n - 1).",
            "constraints": [
              "Evaluation of n + sumTo(n - 1) waits for the recursive call to return.",
              "The runtime uses ordinary last-in, first-out call-stack semantics."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "frame_two_suspends",
                  "text": "The frame for n = 2 is created and suspends while requesting sumTo(1)."
                },
                {
                  "id": "frame_one_suspends",
                  "text": "The frame for n = 1 is created and suspends while requesting sumTo(0)."
                },
                {
                  "id": "base_returns_zero",
                  "text": "The frame for n = 0 returns 0."
                },
                {
                  "id": "frame_one_returns",
                  "text": "The n = 1 frame resumes, computes 1 + 0, and returns 1."
                },
                {
                  "id": "frame_two_returns",
                  "text": "The n = 2 frame resumes, computes 2 + 1, and returns 3."
                }
              ],
              "canonicalOrder": [
                "frame_two_suspends",
                "frame_one_suspends",
                "base_returns_zero",
                "frame_one_returns",
                "frame_two_returns"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 4
            },
            "feedback": {
              "reason": "Recursive calls push suspended frames until the base returns, then results flow back in reverse call order.",
              "details": "A non-terminal frame cannot finish its addition until the child value exists, so it remains live with its parameter and return continuation. The n = 0 frame supplies the first completed result. Stack discipline is last-in, first-out: n = 1 resumes before n = 2, and each frame combines its local n with the child result. At maximum depth, three frames are simultaneously alive. The same mechanism explains why recursive local variables do not overwrite one another and why extra space follows depth rather than total calls."
            },
            "taxonomy": {
              "primarySkillAtomId": "account_for_recursive_call_stack",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "recursive_decomposition",
              "problemArchetypeId": "compute_from_smaller_input"
            }
