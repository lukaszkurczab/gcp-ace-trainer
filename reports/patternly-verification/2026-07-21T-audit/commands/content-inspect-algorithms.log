      {
        "id": "alg-contrast-hash-sort-transfer-017",
        "prompt": "Arrange the transfer from offline sorted grouping to online first-repeat detection.",
        "difficulty": "foundational",
        "interaction": {
          "type": "ordering",
          "elements": [
            {
              "id": "remove_offline_assumption",
              "text": "Recognize that the complete input is no longer available before answers are required."
            },
            {
              "id": "preserve_arrival",
              "text": "Make arrival order and earliest repeated position part of correctness."
            },
            {
              "id": "choose_seen_state",
              "text": "Use incremental equality membership with original-position metadata."
            },
            {
              "id": "stop_early",
              "text": "Return when the first repeated arrival is observed."
            }
          ],
          "canonicalOrder": [
            "remove_offline_assumption",
            "preserve_arrival",
            "choose_seen_state",
            "stop_early"
          ],
          "scoringMethod": "adjacent_relations"
        },
        "scoringContract": {
          "type": "ordering",
          "maxPoints": 3
        },
        "feedback": {
          "reason": "The online contract invalidates the former sort-first workflow.",
          "details": "Hash state becomes useful because it can answer before the stream ends."
