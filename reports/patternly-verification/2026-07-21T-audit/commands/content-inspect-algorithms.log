          {
            "id": "alg-gt-complexity-003",
            "prompt": "Recursive DFS traverses an adjacency-list graph whose reachable component is a simple path of V vertices. Derive worst-case time and auxiliary space, counting the recursion stack and visited state but excluding input and output.",
            "difficulty": "intermediate",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliarySpace"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(log V)",
                  "O(V)",
                  "O(V + E)",
                  "O(V²)"
                ],
                "auxiliarySpace": [
                  "O(1)",
                  "O(log V)",
                  "O(V)",
                  "O(E)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(V + E)"
                ],
                "auxiliarySpace": [
                  "O(V)"
