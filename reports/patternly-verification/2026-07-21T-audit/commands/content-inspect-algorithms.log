          {
            "id": "alg-tree-path-sibling-isolation",
            "prompt": "During DFS, the left child adds `7` to a mutable path sum and returns. The right child must start from the parent's original sum.\nWhich invariant is sufficient?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "restore_parent_state",
                  "text": "Before returning from a child call, restore the mutable sum to exactly the value received from the parent."
