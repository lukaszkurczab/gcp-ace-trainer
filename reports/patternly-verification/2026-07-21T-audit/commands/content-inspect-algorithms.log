        "items": [
          {
            "id": "alg-dpintro-one-d-01-single-progress-axis",
            "prompt": "Which problem statement most directly supports a one-dimensional state dp[i]?",
            "constraints": [
              "dp[i] must fully determine the remaining choices and requested result."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "stair_suffix",
                  "text": "Count ways to reach n from step i when legal moves depend only on i."
                },
                {
                  "id": "item_capacity",
                  "text": "Choose items from index i with a remaining capacity c that changes which items fit."
                },
                {
                  "id": "two_strings",
                  "text": "Align suffix a[i:] with independently varying suffix b[j:]."
                }
              ],
              "acceptedOptionIds": [
                "stair_suffix"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Step i alone determines the remaining staircase and all legal moves, so it is a sufficient single axis.",
              "details": "A one-dimensional state is about semantic independence, not the number of input containers. In the staircase, every history reaching i has the same remaining path problem. Capacity adds a second future-relevant resource, and two-string alignment adds an independent second position. Overlap can occur in all three, but only the first has a naturally one-coordinate state under the stated contracts.",
              "wrongOptionExplanationsByOptionId": {
                "item_capacity": "Both i and c affect future choices, so one index does not fully identify the subproblem.",
                "two_strings": "The two suffix boundaries vary independently, requiring two coordinates unless a special invariant links them."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_one_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "one_dimensional_dp",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-one-d-02-index-only-boundary",
            "prompt": "Select all conditions required for dp[i] to be a sufficient suffix state.",
            "constraints": [
              "dp[i] returns the best additional result from i onward."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "same_score_so_far",
                  "text": "All histories reaching i must have earned the same score so far."
                },
                {
                  "id": "one_array_input",
                  "text": "The original input must be a single array."
                },
                {
                  "id": "same_choices",
                  "text": "Any two histories reaching i permit the same future choices."
                },
                {
                  "id": "same_suffix_value",
                  "text": "The optimal additional result from i onward is independent of the discarded history."
                }
              ],
              "acceptedOptionIds": [
                "same_choices",
                "same_suffix_value"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A one-index state is sufficient only when it creates true future equivalence in both choices and returned value.",
              "details": "The purpose of state is to discard irrelevant history. Histories can have different accumulated scores if the function returns only additional future value and those scores do not constrain later decisions. What must agree is the unresolved choice set and the suffix result. A single input array provides no guarantee: capacity, cooldown, or adjacency conditions can still require more state.",
              "wrongOptionExplanationsByOptionId": {
                "same_score_so_far": "Past totals may differ without affecting the additional suffix optimum; requiring equality can prevent valid state merging.",
                "one_array_input": "Input shape does not determine state sufficiency; a single array can still require capacity or previous-choice dimensions."
              },
              "omittedCorrectExplanationsByOptionId": {
                "same_choices": "Future legality must be identical for histories merged under i.",
                "same_suffix_value": "The state must return the same suffix result for every history represented by i."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_one_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "one_dimensional_dp",
              "problemArchetypeId": "optimize_prefix_or_suffix"
            }
          },
          {
            "id": "alg-dpintro-one-d-03-memo-or-table-one-axis",
            "prompt": "A recurrence has states 0 through n and constant work per state. Every state is reachable. Which statement is accurate?",
            "constraints": [
              "Memoization and tabulation use identical state, transition, and bases."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "tab_exponential",
                  "text": "Tabulation is exponential because it evaluates states iteratively."
                },
                {
                  "id": "same_asymptotic",
                  "text": "Both take O(n) time; tabulation may avoid recursion overhead while memoization provides no reachability savings here."
                },
                {
                  "id": "memo_constant",
                  "text": "Memoization takes O(1) time because repeated states are cached."
                }
              ],
              "acceptedOptionIds": [
                "same_asymptotic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With a dense reachable 1D state space, both methods evaluate Θ(n) distinct states.",
              "details": "Memoization collapses duplicate calls to one evaluation per index, yielding O(n). Tabulation visits the same n indices directly and also takes O(n). Practical differences include call-stack cost, cache lookup overhead, locality, and convenience of ordering. The one-dimensional state model does not imply that one evaluation strategy is always faster.",
              "wrongOptionExplanationsByOptionId": {
                "memo_constant": "Caching prevents repeated evaluation but still requires computing each of the n distinct reachable states once.",
                "tab_exponential": "A single pass over n states with constant work per state is linear, not exponential."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_one_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "one_dimensional_dp",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-one-d-04-prefix-model-order",
            "prompt": "Order the stages for a prefix DP where dp[i] counts ways to reach position i from dp[i - 1] and dp[i - 2].",
            "constraints": [
              "dp[0] is the starting base.",
              "The answer is dp[n]."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "seed_zero",
                  "text": "Initialize dp[0] and any other small-index bases."
                },
                {
                  "id": "first_general",
                  "text": "Compute the first index governed by the general recurrence."
                },
                {
                  "id": "advance",
                  "text": "Continue increasing i so both predecessors are finalized."
                },
                {
                  "id": "answer",
                  "text": "Read dp[n]."
                }
              ],
              "canonicalOrder": [
                "seed_zero",
                "first_general",
                "advance",
                "answer"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The recurrence reads lower indices, so initialization and computation must advance from the base toward n.",
              "details": "A prefix state accumulates information from earlier positions. Small-index bases must exist before the first general transition, after which increasing order ensures dp[i - 1] and dp[i - 2] are final. Reading dp[n] before that progression would expose an incomplete table. The same problem can use a suffix state, but then both recurrence direction and loop order change together."
            },
            "taxonomy": {
              "primarySkillAtomId": "model_one_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-one-d-05-rolling-window-size",
            "prompt": "A recurrence is dp[i] = dp[i - 1] + dp[i - 3]. Only dp[n] is needed. What is the key storage requirement?",
            "constraints": [
              "Indices increase.",
              "No reconstruction is required."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "retain_three_window",
                  "text": "Keep a rolling window that preserves dp[i - 1] and dp[i - 3] at every update."
                },
                {
                  "id": "one_scalar",
                  "text": "Keep one scalar because a one-dimensional state has only one live value at a time."
                },
                {
                  "id": "full_table_required",
                  "text": "Keep the full table because a dependency gap of three prevents any bounded rolling window."
                }
              ],
              "acceptedOptionIds": [
                "retain_three_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The live window is determined by the farthest predecessor, here three positions back.",
              "details": "At step i, the algorithm needs dp[i - 1] and dp[i - 3]. A circular buffer of three slots or an equivalent variable schedule preserves those values while discarding older ones. One scalar loses information; a full table retains more than future transitions consume. Compression is safe because dependency distance is bounded and only the final value is requested.",
              "wrongOptionExplanationsByOptionId": {
                "one_scalar": "Dimensionality and dependency span are different; the transition still needs two values separated by three positions.",
                "full_table_required": "The dependency distance is fixed, so values older than the rolling window become dead."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_one_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "state_compression",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-one-d-06-small-n-bounds",
            "prompt": "A recurrence reads dp[i - 1] and dp[i - 2]. Which implementation plan safely handles n = 0 and n = 1?",
            "constraints": [
              "dp[0] and dp[1] have explicit problem-defined values.",
              "Negative indices are not valid states."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_zero",
                  "text": "Start the recurrence loop at i = 0 and rely on negative indices to mean zero."
                },
                {
                  "id": "require_n_two",
                  "text": "Reject n < 2 because the recurrence needs two predecessors."
                },
                {
                  "id": "seed_then_start_two",
                  "text": "Handle or allocate the explicit bases, then start the general loop at i = 2."
                }
              ],
              "acceptedOptionIds": [
                "seed_then_start_two"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The general recurrence begins only after every predecessor it references is a defined state.",
              "details": "n = 0 and n = 1 are not inconvenient exceptions; they are the recurrence's base domain. Initializing those entries or returning them directly avoids undefined negative reads. The loop can then start at i = 2 with both predecessors available. Padding can also work, but only when each padded value has an explicit semantic role.",
              "wrongOptionExplanationsByOptionId": {
                "start_zero": "Unless negative states are explicitly represented and guarded, those reads are invalid or may access unintended elements.",
                "require_n_two": "Small inputs are legitimate base states and should be answered directly rather than rejected."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_one_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "one_dimensional_dp",
              "problemArchetypeId": "count_ways"
            }
          },
          {
            "id": "alg-dpintro-one-d-07-single-input-two-state-transfer",
            "prompt": "A problem has one array of items, but the answer depends on index i and remaining capacity c. Is this a one-dimensional DP?",
            "constraints": [
              "Both i and c can vary independently.",
              "Capacity changes which remaining items are legal."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_d_overlap",
                  "text": "Yes. Overlapping subproblems collapse every DP to one index."
                },
                {
                  "id": "logical_two_d",
                  "text": "No. The logical state is two-dimensional even though the input is one sequence."
                },
                {
                  "id": "one_d_input",
                  "text": "Yes. One input array always implies one-dimensional DP."
                }
              ],
              "acceptedOptionIds": [
                "logical_two_d"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Index and capacity independently determine the unresolved problem, so both belong to the logical state.",
              "details": "At the same item index, different capacities permit different take branches and can produce different optima. A table or memo key must distinguish those cases unless a later compression proof makes one layer implicit. The number of input arrays is only a surface feature. State dimensionality is determined by future-equivalence requirements.",
              "wrongOptionExplanationsByOptionId": {
                "one_d_input": "Input count is unrelated to the number of independent state variables.",
                "one_d_overlap": "Overlap permits reuse of equal states; it does not remove distinctions between unequal capacity states."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "model_one_dimensional_dp",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "choose_or_skip"
            }
          }
        ],
