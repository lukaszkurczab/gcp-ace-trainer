          {
            "id": "alg-contrast-hash-sort-queries-001",
            "prompt": "An unsorted array receives exactly one exact-membership query, and no later reuse is possible. Which baseline should be considered first?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_scan",
                  "text": "A direct O(n) scan with O(1) auxiliary space."
                },
                {
                  "id": "sort_first",
                  "text": "Always sort in O(n log n) before one query."
                },
                {
                  "id": "hash_always",
                  "text": "Always build an O(n)-space hash set because expected lookup is O(1)."
                },
                {
                  "id": "binary_unsorted",
                  "text": "Binary-search the unsorted array."
                }
              ],
              "acceptedOptionIds": [
                "linear_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "For one query, preprocessing must earn back its cost inside the same workload.",
              "details": "A scan is often simplest and asymptotically no worse than building a hash set once.",
              "wrongOptionExplanationsByOptionId": {
                "sort_first": "Preprocessing may cost more than the single scan.",
                "hash_always": "The build still scans all n values and uses extra memory.",
                "binary_unsorted": "No sorted search invariant exists."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-queries-002",
            "prompt": "A static array will receive millions of arbitrary-order exact-membership queries. Which signal strongly favors hashing?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "reused_membership",
                  "text": "One expected O(n) set build can serve expected O(1) queries."
                },
                {
                  "id": "sort_groups",
                  "text": "Ordered grouping is the primary result."
                },
                {
                  "id": "scan_each",
                  "text": "Repeated O(n) scans are preferable regardless of q."
                },
                {
                  "id": "mutation_only",
                  "text": "Input mutation is the only relevant factor."
                }
              ],
              "acceptedOptionIds": [
                "reused_membership"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A large repeated equality workload can amortize hash preprocessing.",
              "details": "Memory, collision guarantees, and updates still belong in the final comparison.",
              "wrongOptionExplanationsByOptionId": {
                "sort_groups": "The workload is equality membership.",
                "scan_each": "They can total O(qn).",
                "mutation_only": "Query volume is decisive here."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
