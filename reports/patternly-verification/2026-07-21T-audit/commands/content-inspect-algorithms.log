              "acceptedValuesByDimension": {
                "time": [
                  "O(1)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "fixed_word": "O(1)"
                },
                "auxiliary_space": {
                  "constant_temporaries": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Primitive shifts and masks are constant-time under the fixed-word model.",
              "details": "This model should not be generalized automatically to arbitrary-precision integers."
            },
            "taxonomy": {
              "primarySkillAtomId": "reason_about_bit_shift_behavior",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-shifts-020",
            "prompt": "An arbitrary-precision integer has w stored bits. A left shift by k requires moving or rewriting the represented limbs. Select a width-sensitive time bound and additional result space.",
            "constraints": [
              "w is part of the input size.",
              "The shifted result is materialized separately and has O(w + k) bits."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "result_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log w)",
                  "O(w + k)",
                  "O(2^w)"
                ],
                "result_space": [
                  "O(1)",
                  "O(log w)",
                  "O(w + k)",
                  "O(2^w)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(w + k)"
                ],
                "result_space": [
                  "O(w + k)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "rewrite_bits": "O(w + k)"
                },
                "result_space": {
                  "materialized_width": "O(w + k)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Arbitrary-precision shifts scale with the represented width and result size.",
              "details": "The fixed-machine-word O(1) assumption no longer applies."
            },
            "taxonomy": {
              "primarySkillAtomId": "reason_about_bit_shift_behavior",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-shifts-021",
            "prompt": "A positive w-bit integer is repeatedly logically right-shifted by one until it becomes zero. Select the number of iterations and auxiliary-space complexity.",
            "constraints": [
              "The most significant set bit is at position w - 1.",
              "Only the current word and a counter are stored."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "iterations",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "iterations": [
                  "O(1)",
                  "O(log w)",
                  "O(w)",
                  "O(2^w)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log w)",
                  "O(w)",
                  "O(2^w)"
                ]
              },
              "acceptedValuesByDimension": {
                "iterations": [
                  "O(w)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "iterations": {
                  "one_bit_position_per_step": "O(w)"
                },
                "auxiliary_space": {
                  "current_and_counter": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Each shift removes one binary place from the remaining magnitude.",
              "details": "The number of iterations is proportional to bit length, not numeric value."
            },
            "taxonomy": {
              "primarySkillAtomId": "reason_about_bit_shift_behavior",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-shifts-022",
            "prompt": "A function performs q valid shifts on one fixed-width word, with O(1) work per shift. Select total time and auxiliary space.",
            "constraints": [
              "The q shift requests are processed sequentially.",
              "No history of intermediate words is retained."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log q)",
                  "O(q)",
                  "O(q²)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log q)",
                  "O(q)",
                  "O(q²)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(q)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "one_per_request": "O(q)"
                },
                "auxiliary_space": {
                  "single_word": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Constant-time primitives accumulate across q requested operations.",
              "details": "Only the current fixed-width word and loop state are retained."
            },
            "taxonomy": {
              "primarySkillAtomId": "reason_about_bit_shift_behavior",
              "secondarySkillAtomIds": [],
