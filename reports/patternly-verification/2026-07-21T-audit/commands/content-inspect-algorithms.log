            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A strategy label is not a proof.",
              "details": "The universal heuristic fails because it omits correctness and most of the cost model.",
              "wrongOptionExplanationsByOptionId": {
                "correctness_first": "This is required.",
                "full_workload": "This is a sound comparison.",
                "guarantee_match": "This is a sound comparison."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-012",
            "prompt": "Which are valid counterexamples to \"hash maps are always faster than sorting\"? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "already_sorted",
                  "text": "The input is already sorted and only a linear run scan is needed."
                },
                {
                  "id": "ordered_output",
                  "text": "The result requires ascending groups, so hash keys would need later sorting."
                },
                {
                  "id": "tight_memory",
                  "text": "Mutation is legal but O(n) auxiliary table memory is not."
                },
                {
                  "id": "equality_many",
                  "text": "Millions of arbitrary-order equality queries over static hashable keys."
                }
              ],
              "acceptedOptionIds": [
                "already_sorted",
                "ordered_output",
                "tight_memory"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A universal claim is refuted by any legal workload where sorting better satisfies the contract or resource limits.",
              "details": "The equality-heavy workload illustrates that hashing can still be the right conditional choice.",
              "wrongOptionExplanationsByOptionId": {
                "equality_many": "This is a strong hash case, not a counterexample."
              },
              "omittedCorrectExplanationsByOptionId": {
                "already_sorted": "No hash build is necessary.",
                "ordered_output": "Ordering cost must be included.",
                "tight_memory": "In-place sorting may fit the constraint."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_hash_map_always_faster_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-reject-013",
            "prompt": "A design review is considering a hash table. Which facts are positive evidence for that choice? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "equality_state",
                  "text": "The workload is dominated by equality membership, counts, or key-to-value updates."
