              "details": "The prefix identity remains universally valid for sums.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_identity": "This is a valid identity."
              },
              "omittedCorrectExplanationsByOptionId": {
                "exact_never_window": "Nonnegative values can support it.",
                "threshold_always_window": "Mixed signs can break monotonicity.",
                "contiguous_decides": "Both operate on contiguous ranges."
              }
            },
            "taxonomy": {
