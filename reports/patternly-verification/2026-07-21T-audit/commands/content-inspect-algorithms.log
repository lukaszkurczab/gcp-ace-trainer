            }
          },
          {
            "id": "algorithms-intervals-sort-008",
            "prompt": "Which statement correctly distinguishes sort keys for two different interval objectives?",
            "constraints": [
              "Objective A merges the union of intervals.",
              "Objective B chooses the maximum number of mutually non-overlapping meetings under the standard earliest-finish greedy proof."
