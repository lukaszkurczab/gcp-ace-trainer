        "items": [
          {
            "id": "alg-contrast-binary-scan-sorted-001",
            "prompt": "An array is sorted by price, but the query asks for the first record whose description contains a word. What does the sorted input prove?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "nothing_for_description",
                  "text": "Nothing directional about the description predicate; scan or use a description-aligned index."
                },
                {
                  "id": "binary_price",
                  "text": "Binary-search descriptions because prices are sorted."
                },
                {
                  "id": "mid_description",
                  "text": "Check the middle description and discard the side with lower prices."
                },
                {
                  "id": "sorted_mandatory",
                  "text": "Binary search is required for every query on sorted data."
                }
              ],
              "acceptedOptionIds": [
                "nothing_for_description"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sortedness is useful only through the relation between the sort key and the query predicate.",
              "details": "A separate text index could change the representation, but the price order alone does not.",
              "wrongOptionExplanationsByOptionId": {
                "binary_price": "Description truth need not follow price order.",
                "mid_description": "Price direction does not classify word containment.",
                "sorted_mandatory": "The query must align with the sort key."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-002",
            "prompt": "A sequence is sorted by value, but the function must return the first matching item in original insertion order. Is value-order binary search sufficient?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_provenance",
                  "text": "No, unless the ordered representation preserves enough original-order provenance."
                },
                {
                  "id": "yes_leftmost_sorted",
                  "text": "Yes. The leftmost sorted duplicate is always the earliest inserted item."
                },
                {
                  "id": "yes_any",
                  "text": "Yes. Any value match satisfies every first-match contract."
                },
                {
                  "id": "no_sorted_invalid",
                  "text": "No sorted data can ever support the query."
                }
              ],
              "acceptedOptionIds": [
                "no_provenance"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The output identity can be different from the sort-order identity.",
              "details": "Binary search transfers only when the representation retains the information needed to select the required record.",
              "wrongOptionExplanationsByOptionId": {
                "yes_leftmost_sorted": "Equal-value ordering may not preserve insertion order.",
                "yes_any": "The required identity is specific.",
                "no_sorted_invalid": "An index storing minimum original position could support it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-003",
            "prompt": "A sorted array query asks whether any adjacent pair differs by exactly 3. Which default approach is justified?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "adjacent_scan",
                  "text": "Scan adjacent pairs because the property is defined over every neighboring boundary."
                },
                {
                  "id": "binary_mid_pair",
                  "text": "Check the pair around mid and discard one half after a mismatch."
                },
                {
                  "id": "lower_bound_three",
                  "text": "Search for the value 3."
                },
                {
                  "id": "sorted_binary",
                  "text": "Sorted input alone requires binary search."
                }
              ],
              "acceptedOptionIds": [
                "adjacent_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorted order can simplify the local checks without creating a binary-search boundary.",
              "details": "The scan uses the order to inspect meaningful adjacent relationships, not to discard unchecked halves.",
              "wrongOptionExplanationsByOptionId": {
                "binary_mid_pair": "A mismatch at one boundary says nothing about other boundaries.",
                "lower_bound_three": "The query concerns differences, not membership of value 3.",
                "sorted_binary": "No half-discard rule has been established."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-004",
            "prompt": "A sorted array query asks for the first index with value >= target. Which fact makes binary search appropriate beyond mere sortedness?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "monotonic_ge",
                  "text": "The predicate value >= target is false on a prefix and true on the remaining suffix."
                },
                {
                  "id": "target_numeric",
                  "text": "Target is numeric."
                },
                {
                  "id": "first_word",
                  "text": "The query uses the word first."
                },
                {
                  "id": "array_length",
                  "text": "The array has more than one element."
                }
              ],
              "acceptedOptionIds": [
                "monotonic_ge"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The sorted order is useful because it makes the complete query predicate monotonic.",
              "details": "This is the missing proof in sorted-but-arbitrary conditions.",
              "wrongOptionExplanationsByOptionId": {
                "target_numeric": "Numeric type alone is insufficient.",
                "first_word": "Many first-match properties are nonmonotonic.",
                "array_length": "Size does not create a boundary."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-005",
            "prompt": "A list is sorted but supports only forward iteration. Which statement is accurate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "order_not_access",
                  "text": "Sortedness may support early stopping, but ordinary array-style O(log n) binary search also requires suitable midpoint access."
                },
                {
                  "id": "always_log",
                  "text": "Sortedness alone guarantees O(log n) lookup on every representation."
                },
                {
                  "id": "always_full_scan",
                  "text": "Sortedness provides no benefit at all."
                },
                {
                  "id": "names_fix",
                  "text": "Adding left and right node variables provides random access."
                }
              ],
              "acceptedOptionIds": [
                "order_not_access"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Data order and data access are separate preconditions.",
              "details": "A scan can exploit sorted order for early termination, while a dedicated index or array can enable logarithmic access.",
              "wrongOptionExplanationsByOptionId": {
                "always_log": "Sequential midpoint access can cost linear work.",
                "always_full_scan": "A scan can stop after passing target.",
                "names_fix": "Pointers do not make arbitrary midpoint location constant-time."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-006",
            "prompt": "A sorted array query asks for every value that is prime. Which strategy follows without a separate prime index?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scan_all",
                  "text": "Scan all values and test primality, because prime status is not monotonic in numeric order."
                },
                {
                  "id": "binary_prime",
                  "text": "Binary-search the first prime and then every later value is prime."
                },
                {
                  "id": "mid_prime",
                  "text": "Return only a prime midpoint if found."
                },
                {
                  "id": "sorted_implies_suffix",
                  "text": "Sorted order makes any boolean property a suffix."
                }
              ],
              "acceptedOptionIds": [
                "scan_all"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorted numeric magnitude does not order arbitrary number-theoretic properties.",
              "details": "A precomputed prime-filtered index could change the workload, but raw sorted order is insufficient.",
              "wrongOptionExplanationsByOptionId": {
                "binary_prime": "Prime and composite values continue to alternate.",
                "mid_prime": "The query asks for every prime value.",
                "sorted_implies_suffix": "Only properties aligned with the order have that behavior."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-007",
            "prompt": "A sorted array query asks for any exact target and the array supports random access. What additional condition is already satisfied by the standard comparison?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "comparison_aligns",
                  "text": "The comparison target <, =, or > nums[mid] aligns with the ascending sort order and identifies the only possible side."
                },
                {
                  "id": "all_queries",
                  "text": "Every possible query over the array is now binary-searchable."
                },
                {
                  "id": "first_original",
                  "text": "The first original occurrence is automatically available."
                },
                {
                  "id": "arbitrary_predicate",
                  "text": "Any helper predicate becomes monotonic."
                }
              ],
              "acceptedOptionIds": [
                "comparison_aligns"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Exact target comparison is a query that directly uses the ordering relation.",
              "details": "This distinguishes the canonical binary-search case from arbitrary predicates on the same sorted data.",
              "wrongOptionExplanationsByOptionId": {
                "all_queries": "Only queries aligned with the order inherit the implication.",
                "first_original": "Sorted duplicates may not preserve original identity.",
                "arbitrary_predicate": "The sort order constrains value comparison, not every helper."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-008",
            "prompt": "A sorted array contains duplicate keys, and the query asks for the record with the smallest timestamp among matching keys. What is required for binary search to solve the full query efficiently?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "boundary_plus_metadata",
                  "text": "Locate the equal-key range and inspect it, or maintain metadata ordered by timestamp within each key group."
                },
                {
                  "id": "any_match",
                  "text": "Return any midpoint key match."
                },
                {
                  "id": "leftmost_key",
                  "text": "Return the leftmost equal key regardless of group ordering."
                },
                {
                  "id": "sorted_key_sufficient",
                  "text": "Key sorting alone determines every secondary-field optimum."
                }
              ],
              "acceptedOptionIds": [
                "boundary_plus_metadata"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sortedness by one key solves only the part of the contract aligned with that key.",
              "details": "The remaining group may require scanning or a richer index.",
              "wrongOptionExplanationsByOptionId": {
                "any_match": "That does not guarantee the smallest timestamp.",
                "leftmost_key": "Leftmost by key need not be smallest by timestamp.",
                "sorted_key_sufficient": "The secondary objective requires additional structure."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-009",
            "prompt": "A sorted array is queried for the sum of all values. Which strategy is appropriate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_aggregate",
                  "text": "A linear accumulation, unless a precomputed sum is already maintained."
                },
                {
                  "id": "binary_sum",
                  "text": "Binary search because the data is sorted."
                },
                {
                  "id": "mid_times_n",
                  "text": "Multiply the midpoint value by n."
                },
                {
                  "id": "discard_smaller",
                  "text": "Discard the smaller half after reading mid."
                }
              ],
              "acceptedOptionIds": [
                "linear_aggregate"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Some queries require information from every element even on sorted input.",
              "details": "Precomputed aggregate metadata can change the cost, but binary search is not the relevant mechanism.",
              "wrongOptionExplanationsByOptionId": {
                "binary_sum": "Halving would omit values that contribute to the sum.",
                "mid_times_n": "Sorted values need not be equal.",
                "discard_smaller": "Every value contributes regardless of relative size."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-010",
            "prompt": "A sorted array query asks for the first element satisfying an arbitrary callback supplied at runtime. Which contract is needed before using binary search?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "callback_monotonic",
                  "text": "The callback must be proven monotonic in the array’s sorted order for every allowed callback instance."
                },
                {
                  "id": "callback_boolean",
                  "text": "It only needs to return a boolean."
                },
                {
                  "id": "callback_named_valid",
                  "text": "It only needs to be named isValid."
                },
                {
                  "id": "array_sorted_only",
                  "text": "The sorted array alone is enough."
                }
              ],
              "acceptedOptionIds": [
                "callback_monotonic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A higher-order predicate must carry an explicit monotonicity contract.",
              "details": "Without it, the general implementation must scan or reject unsupported callbacks.",
              "wrongOptionExplanationsByOptionId": {
                "callback_boolean": "Boolean results can alternate.",
                "callback_named_valid": "Names provide no behavioral guarantee.",
                "array_sorted_only": "The callback may ignore or oppose the sort key."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-011",
            "prompt": "A sorted array is queried for the first value not equal to its predecessor. Which approach is naturally correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "adjacent_scan",
                  "text": "Scan adjacent pairs from the beginning because the requested first boundary is based on local changes that may recur."
                },
                {
                  "id": "binary_change",
                  "text": "Binary-search the change predicate because the data is sorted."
                },
                {
                  "id": "return_one",
                  "text": "Always return index 1."
                },
                {
                  "id": "lower_bound_first",
                  "text": "Use lower bound for the first value."
                }
              ],
              "acceptedOptionIds": [
                "adjacent_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A sorted array may contain multiple run boundaries.",
              "details": "Finding the first change from the start is a scan problem unless a specific run value or boundary predicate is supplied.",
              "wrongOptionExplanationsByOptionId": {
                "binary_change": "Equality runs may create many true change boundaries rather than one transition.",
                "return_one": "The first pair may be equal or the array may be too short.",
                "lower_bound_first": "The query compares neighboring values, not a fixed target threshold."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-012",
            "prompt": "Which additional properties can make sorted input genuinely sufficient for binary search? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "aligned_query",
                  "text": "The query comparison or predicate is monotonic in the sort order."
                },
                {
                  "id": "random_access",
                  "text": "The representation supports efficient midpoint access under the claimed cost model."
                },
                {
                  "id": "output_supported",
                  "text": "The ordered representation preserves the identity or metadata required by the output contract."
                },
                {
                  "id": "sorted_label",
                  "text": "The variable or file name contains sorted."
                }
              ],
              "acceptedOptionIds": [
                "aligned_query",
                "random_access",
                "output_supported"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sortedness is one component of a larger applicability contract.",
              "details": "Query semantics, access, and output identity determine whether the order can be used safely and efficiently.",
              "wrongOptionExplanationsByOptionId": {
                "sorted_label": "Labels do not prove the data or query contract."
              },
              "omittedCorrectExplanationsByOptionId": {
                "aligned_query": "This provides directional elimination.",
                "random_access": "This supports logarithmic iteration cost.",
                "output_supported": "The returned answer must be correct, not merely key-equal."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-013",
            "prompt": "Which queries can still require scanning a sorted array? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sum_all",
                  "text": "Compute a sum that depends on every value."
                },
                {
                  "id": "arbitrary_property",
                  "text": "Find values satisfying a property unrelated to the sort key."
                },
                {
                  "id": "original_order_identity",
                  "text": "Return the first original-order record when the sorted view lacks provenance."
                },
                {
                  "id": "exact_target",
                  "text": "Find any exact target using the same ascending key and random access."
                }
              ],
              "acceptedOptionIds": [
                "sum_all",
                "arbitrary_property",
                "original_order_identity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sortedness does not remove the need to inspect information that the order does not summarize.",
              "details": "Exact target search is the contrasting aligned query.",
              "wrongOptionExplanationsByOptionId": {
                "exact_target": "This is directly binary-searchable."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sum_all": "Every contribution is needed unless precomputed.",
                "arbitrary_property": "Truth may be nonmonotonic.",
                "original_order_identity": "The sorted view cannot identify it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-014",
            "prompt": "Which statements are false heuristics? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sorted_always_binary",
                  "text": "Every sorted input should be searched with binary search."
                },
                {
                  "id": "sorted_all_predicates",
                  "text": "Every predicate becomes monotonic on sorted values."
                },
                {
                  "id": "sorted_random_access",
                  "text": "Sortedness implies constant-time midpoint access."
                },
                {
                  "id": "sorted_exact",
                  "text": "Exact comparison by the same sort key supports binary search on a random-access array."
                }
              ],
              "acceptedOptionIds": [
                "sorted_always_binary",
                "sorted_all_predicates",
                "sorted_random_access"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The word sorted hides several independent assumptions when used as a universal rule.",
              "details": "The exact aligned random-access case states the necessary structure explicitly.",
              "wrongOptionExplanationsByOptionId": {
                "sorted_exact": "This is a valid applicability statement, not a false heuristic."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sorted_always_binary": "The query may be unrelated to the sort key.",
                "sorted_all_predicates": "Arbitrary properties can alternate.",
                "sorted_random_access": "A linked representation can remain sequential."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-015",
            "prompt": "Which representation changes can make a previously scan-only sorted-data query binary-searchable? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "secondary_index",
                  "text": "Build an index sorted by the actual queried field."
                },
                {
                  "id": "group_metadata",
                  "text": "Store per-key aggregate or minimum-position metadata required by the output."
                },
                {
                  "id": "random_access_copy",
                  "text": "Materialize a random-access ordered copy for repeated queries."
                },
                {
                  "id": "rename_sorted",
                  "text": "Rename the original data structure to sortedList."
                }
              ],
              "acceptedOptionIds": [
                "secondary_index",
                "group_metadata",
                "random_access_copy"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The strategy boundary moves when the representation gains query-aligned order, access, or metadata.",
              "details": "Cosmetic changes do not add any of those properties.",
              "wrongOptionExplanationsByOptionId": {
                "rename_sorted": "Naming changes no representation property."
              },
              "omittedCorrectExplanationsByOptionId": {
                "secondary_index": "The predicate now aligns with an order.",
                "group_metadata": "The index can answer more than key membership.",
                "random_access_copy": "Midpoint access becomes efficient."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-016",
            "prompt": "Which edge cases reveal that sorted input alone is insufficient? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "all_same_secondary",
                  "text": "Many equal primary keys with different required secondary metadata."
                },
                {
                  "id": "alternating_property",
                  "text": "A queried property alternates across increasing values."
                },
                {
                  "id": "sequential_structure",
                  "text": "A sorted structure has only sequential access."
                },
                {
                  "id": "exact_unique",
                  "text": "One exact-key query on a sorted random-access array with distinct keys."
                }
              ],
              "acceptedOptionIds": [
                "all_same_secondary",
                "alternating_property",
                "sequential_structure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "These cases isolate output, predicate, and access assumptions separately.",
              "details": "The exact unique-key array provides the control case where sortedness aligns with the full query.",
              "wrongOptionExplanationsByOptionId": {
                "exact_unique": "This is the straightforward sufficient case."
              },
              "omittedCorrectExplanationsByOptionId": {
                "all_same_secondary": "Key order cannot select the secondary optimum.",
                "alternating_property": "No one-transition predicate exists.",
                "sequential_structure": "The claimed logarithmic access model fails."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-017",
            "prompt": "Arrange the analysis after noticing that input is sorted.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "identify_sort_key",
                  "text": "Identify the exact key and ordering relation."
                },
                {
                  "id": "state_query",
                  "text": "State the full query predicate and output identity."
                },
                {
                  "id": "test_alignment",
                  "text": "Prove whether the predicate and required output align with the order and access model."
                },
                {
                  "id": "select",
                  "text": "Use binary search when aligned; otherwise scan or build a suitable index."
                }
              ],
              "canonicalOrder": [
                "identify_sort_key",
                "state_query",
                "test_alignment",
                "select"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Sortedness starts the analysis rather than ending it.",
              "details": "The transfer boundary is the alignment between order, query, access, and output."
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-sorted-018",
            "prompt": "A sorted linked list of n nodes is searched once by repeatedly finding the midpoint of the current sublist with a linear traversal. Select a safe worst-case time bound for that approach and for one ordinary scan.",
            "constraints": [
              "Each level traverses a sublist to locate its midpoint.",
              "Sublist sizes form n, n/2, n/4, ... ."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "midpoint_search_time",
                "scan_time"
              ],
              "availableValuesByDimension": {
                "midpoint_search_time": [
                  "O(log n)",
                  "O(n)",
                  "O(n log n)",
                  "O(n²)"
                ],
                "scan_time": [
                  "O(log n)",
                  "O(n)",
                  "O(n log n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "midpoint_search_time": [
                  "O(n)"
                ],
                "scan_time": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "midpoint_search_time": {
                  "geometric_traversal_sum": "O(n)"
                },
                "scan_time": {
                  "one_traversal": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Sortedness does not guarantee an asymptotic advantage without efficient midpoint access.",
              "details": "The midpoint traversals sum geometrically to O(n), matching a scan rather than array-style O(log n)."
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_sorted_input_alone_as_binary_search_proof",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          }
        ],
