        "items": [
          {
            "id": "hpq-orientation-expose-required-extreme",
            "prompt": "A priority queue must repeatedly return and remove the waiting item with the largest score. Which orientation directly exposes the required item?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "fifo_queue",
                  "text": "A FIFO queue because all items eventually leave."
                },
                {
                  "id": "max_heap",
                  "text": "Use a max-heap so the largest score is the root exposed by peek and pop."
                },
                {
                  "id": "either_unchanged",
                  "text": "Either orientation with the same score key and no other change."
                },
                {
                  "id": "min_heap",
                  "text": "A min-heap keyed by score without transforming the key."
                }
              ],
              "acceptedOptionIds": [
                "max_heap"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The root must represent the next item to remove, so repeated largest-score removal uses max orientation.",
              "details": "Heap orientation is chosen from the extreme the operation must expose under the comparison key. A max-heap places a largest score at the root. A min-heap can emulate that behavior only if the key order is reversed, which is a different key contract. FIFO order ignores score. For repeated smallest-score removal, the decision reverses.",
              "wrongOptionExplanationsByOptionId": {
                "min_heap": "With an unchanged score key, a min-heap exposes the smallest score rather than the required largest score.",
                "either_unchanged": "The two orientations expose opposite extremes; they are not interchangeable without transforming the order.",
                "fifo_queue": "Eventual removal does not make arrival order the selection rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_heap_orientation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "schedule_by_priority"
            }
          },
          {
            "id": "hpq-orientation-k-largest-worst-retained",
            "prompt": "Why does retaining the k largest values use a min-heap of size k rather than a max-heap of size k?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "operation_cost_constant",
                  "text": "Min-heap operations are constant-time while max-heap operations are logarithmic."
                },
                {
                  "id": "expose_best_retained",
                  "text": "The root must expose the largest retained value because it is always evicted first."
                },
                {
                  "id": "expose_worst_retained",
                  "text": "The root must expose the smallest retained value, which is the candidate to evict."
                },
                {
                  "id": "min_heap_sorts_all",
                  "text": "A min-heap keeps the retained values fully sorted."
                }
              ],
              "acceptedOptionIds": [
                "expose_worst_retained"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Top-k retention orients the heap around the worst member inside the retained set, not around the overall best member.",
              "details": "For k largest, the smallest retained value defines admission: a new value must beat it to enter the set. A min-heap places that boundary at the root. The retained values need not be globally sorted, and min/max orientations have symmetric asymptotic operation costs. For k smallest, the worst retained member is the largest, so max orientation is correct.",
              "wrongOptionExplanationsByOptionId": {
                "expose_best_retained": "The largest retained value is safe, not expendable. Eviction decisions need the smallest retained boundary.",
                "min_heap_sorts_all": "The orientation provides a root boundary, not a complete ordering of retained values.",
                "operation_cost_constant": "Both orientations use the same tree height and have equivalent asymptotic push/pop costs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_heap_orientation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "top_k",
              "problemArchetypeId": "maintain_top_k"
            }
          },
          {
            "id": "hpq-orientation-k-smallest-worst-retained",
            "prompt": "A bounded heap retains the k smallest values seen so far. Which root must be exposed to decide whether a new value enters?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "latest_retained",
                  "text": "The most recently inserted retained value, using FIFO order."
                },
                {
                  "id": "arbitrary_leaf",
                  "text": "Any leaf, because all retained values have the same rank role."
                },
                {
                  "id": "largest_retained",
                  "text": "The largest retained value, using max orientation."
                },
                {
                  "id": "smallest_retained",
                  "text": "The smallest retained value, using min orientation."
                }
              ],
              "acceptedOptionIds": [
                "largest_retained"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The largest retained value is the weakest member of the k-smallest set and therefore the admission boundary.",
              "details": "A new value improves the retained k-smallest set only if it is smaller than the current largest retained value. Max orientation exposes exactly that candidate. The smallest retained member is never the first one to evict, and recency has no rank meaning. This “expose the worst retained member” rule transfers across bounded selection problems.",
              "wrongOptionExplanationsByOptionId": {
                "smallest_retained": "The smallest retained value is the strongest member of the k-smallest set, not the eviction candidate.",
                "latest_retained": "Arrival time does not determine whether a value belongs among the k smallest.",
                "arbitrary_leaf": "Leaves are not globally ranked, so an arbitrary leaf cannot represent the boundary."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_heap_orientation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "top_k",
              "problemArchetypeId": "maintain_top_k"
            }
          },
          {
            "id": "hpq-orientation-reverse-key-contract",
            "prompt": "A platform provides only a min-heap API, but the application must remove the largest numeric priority first. Which adaptation is valid?",
            "constraints": [
              "Priorities and the transformed key must remain inside the numeric type’s safe range.",
              "Any tie-break rule must be transformed consistently."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "read_last_leaf",
                  "text": "Use the original priority and remove the last backing-array entry as the maximum."
                },
                {
                  "id": "same_key",
                  "text": "Use the original priority unchanged; min and max behavior are equivalent."
                },
                {
                  "id": "reverse_key",
                  "text": "Use an order-reversing key such as negative priority, with an explicit safe tie-break contract."
                },
                {
                  "id": "sort_after_pop",
                  "text": "Pop the minimum and then sort it into the largest item."
                }
              ],
              "acceptedOptionIds": [
                "reverse_key"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Reversing the comparison key maps the required maximum to the minimum under the available API.",
              "details": "For numeric priorities, negation is a common order-reversing transform: the largest original priority becomes the smallest transformed key. The design must preserve tie semantics and avoid unsafe overflow or representation edge cases. Reading a leaf is invalid because the opposite extreme has no fixed heap position. In languages or domains where negation is unsafe or keys are composite, use an explicit reversed comparator or wrapper.",
              "wrongOptionExplanationsByOptionId": {
                "same_key": "An unchanged min-heap exposes the smallest original priority, not the largest.",
                "read_last_leaf": "The last leaf is not guaranteed to be the maximum among all leaves.",
                "sort_after_pop": "A popped minimum cannot be transformed into the required maximum; the selection order was already wrong."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_heap_orientation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "schedule_by_priority"
            }
          },
          {
            "id": "hpq-orientation-composite-priority-tie",
            "prompt": "Tasks have severity 1–5, where higher severity runs first. Equal severity must run in earlier arrival order. With a min-heap API, which key gives the required order?",
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "neg_severity_arrival",
                  "text": "(-severity, arrivalSequence)"
                },
                {
                  "id": "severity_arrival",
                  "text": "(severity, arrivalSequence)"
                },
                {
                  "id": "neg_severity_neg_arrival",
                  "text": "(-severity, -arrivalSequence)"
                },
                {
                  "id": "arrival_neg_severity",
                  "text": "(arrivalSequence, -severity)"
                }
              ],
              "acceptedOptionIds": [
                "neg_severity_arrival"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Negating severity makes higher severity sort first, while the unchanged arrival sequence keeps earlier arrivals first within a tie.",
              "details": "Lexicographic min-order first compares -severity, so severity 5 precedes severity 4. When severity ties, the smaller arrival sequence represents the earlier task and remains first. Negating arrival reverses the tie rule, and placing arrival first makes time dominate severity. This composite-key reasoning generalizes to any priority queue with a material secondary order.",
              "wrongOptionExplanationsByOptionId": {
                "severity_arrival": "Unchanged severity makes lower severity run first under a min-heap.",
                "neg_severity_neg_arrival": "Severity is correct, but negating arrival makes later tasks precede earlier ones within a tie.",
                "arrival_neg_severity": "Arrival becomes the primary key, so an old low-severity task can precede a newer high-severity task."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_heap_orientation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "schedule_by_priority"
            }
          }
        ],
