    "items": [
      {
        "id": "alg-arrays-duplicate-handling-001",
        "prompt": "A function must return every distinct value exactly once while preserving the order of first appearance. What is the correct output for [4, 2, 4, 3, 2]?",
        "difficulty": "intro",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "first_occurrence_order",
              "text": "[4, 2, 3]"
            },
            {
              "id": "sorted_unique",
              "text": "[2, 3, 4]"
            },
            {
              "id": "unchanged_input",
              "text": "[4, 2, 4, 3, 2]"
            },
            {
              "id": "grouped_duplicates",
              "text": "[4, 4, 2, 2, 3]"
            }
          ],
          "acceptedOptionIds": [
            "first_occurrence_order"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "The contract removes repeated occurrences but preserves the position of each value's first occurrence.",
          "details": "The first 4 is retained and the later 4 is removed. The first 2 is retained and the later 2 is removed. The value 3 appears once. Sorting would produce the same set of values but would violate the required first-appearance order.",
          "wrongOptionExplanationsByOptionId": {
            "sorted_unique": "This removes duplicates but changes the required order of first appearance.",
            "unchanged_input": "This preserves order and multiplicity, but the contract requires every distinct value exactly once.",
            "grouped_duplicates": "Grouping equal values changes order and still preserves repeated occurrences."
          }
        },
        "taxonomy": {
          "primarySkillAtomId": "preserve_duplicate_contract",
          "secondarySkillAtomIds": [],
          "learningStage": "foundations",
          "patternVariantId": "linear_scan",
          "problemArchetypeId": "normalize_and_compare_sequences"
        },
        "interactionType": "choice",
        "resolvedTaxonomy": {
