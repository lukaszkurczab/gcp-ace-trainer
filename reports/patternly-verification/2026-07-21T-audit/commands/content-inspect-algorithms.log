        "items": [
          {
            "id": "alg-ctpsw-rtimtp-01",
            "prompt": "What is the strongest review of the claim “the solution uses two indices, so it is a two-pointers problem”?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "reject_invariant_needed",
                  "text": "Reject it: two indices are a representation, and classification requires the candidate and movement invariant."
                },
                {
                  "id": "accept_definition",
                  "text": "Accept it: two indices are the definition of two pointers."
                },
                {
                  "id": "accept_if_linear",
                  "text": "Accept it whenever the loop is O(n)."
                },
                {
                  "id": "accept_names",
                  "text": "Accept it when the variables are named left and right."
                }
              ],
              "acceptedOptionIds": [
                "reject_invariant_needed"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The number and names of indices do not specify what the algorithm maintains or why movement is safe.",
              "details": "Two indices can bound a sliding window, delimit a binary-search interval, identify a range query, coordinate a merge, or serve read/write roles. These algorithms differ because their candidates, state, and discard proofs differ. Calling all of them two pointers removes the diagnostic information Patternly is meant to teach. The correct process is to ask what the indices mean, which elements belong to the current candidate, and what theorem justifies each movement.",
              "wrongOptionExplanationsByOptionId": {
                "accept_definition": "This definition collapses windows, binary-search intervals, merges, and read/write scans into one category, erasing the distinct invariants that justify movement.",
                "accept_if_linear": "Many linear algorithms are not two pointers, and complexity does not determine family.",
                "accept_names": "Identifier names are arbitrary implementation details; they do not establish candidate membership, maintained state, or a safe discard rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_two_indices_implies_two_pointers_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "Treat “two pointers” as a diagnostic family label, not as a literal count of index variables."
            ]
          },
          {
            "id": "alg-ctpsw-rtimtp-02",
            "prompt": "Code maintains a frequency map for s[left..right], expands right, and advances left while a character count exceeds a limit. A learner labels it two pointers because two indices move. What correction is required?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "window_invariant",
                  "text": "It is sliding window because the map and validity rule belong to the entire contiguous range."
                },
                {
                  "id": "two_pointers_count",
                  "text": "The learner is correct because exactly two indices move."
                },
                {
                  "id": "both_same",
                  "text": "The labels are interchangeable in all technical discussions."
                },
                {
                  "id": "neither_map",
                  "text": "A frequency map means neither family applies."
                }
              ],
              "acceptedOptionIds": [
                "window_invariant"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Explicit range-owned state and validity repair outweigh the superficial two-index cue.",
              "details": "left and right identify the members of one current substring, while the frequency map records state for all of them. When the predicate fails, removing left characters repairs that same candidate. Those are window semantics. The phrase “two pointers” is sometimes used informally for any two-boundary loop, but this learning taxonomy reserves it for endpoint, convergence, or read/write relations so that the distinction remains diagnostically useful.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers_count": "Counting indices ignores that both boundaries delimit one substring whose full frequency state is maintained and repaired after violations.",
                "both_same": "The product intentionally distinguishes the families because their proofs and transfer boundaries differ.",
                "neither_map": "Auxiliary state does not exclude a family; here it is precisely the window state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_two_indices_implies_two_pointers_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "The frequency map exactly matches the current substring."
            ]
          },
          {
            "id": "alg-ctpsw-rtimtp-03",
            "prompt": "Select all examples that contain two indices but should not be classified as the two-pointers family under the stated invariant.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sliding_window_example",
                  "text": "left and right bound a contiguous range with a maintained sum and a shrink-to-valid rule."
                },
                {
                  "id": "prefix_query_example",
                  "text": "l and r are supplied once to compute prefix[r + 1] - prefix[l]."
                },
                {
                  "id": "sorted_pair_example",
                  "text": "left and right form a sorted endpoint pair, and a comparison safely eliminates one endpoint."
                },
                {
                  "id": "read_write_example",
                  "text": "read scans input while write marks the next compacted output position."
                }
              ],
              "acceptedOptionIds": [
                "sliding_window_example",
                "prefix_query_example"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "One example is a sliding window and the other is a direct range query; both refute the index-count heuristic.",
              "details": "The window example uses two boundaries but belongs to sliding window because the full range is maintained and repaired. The prefix-query example also uses two indices, yet they are immutable query parameters rather than moving pointers or a window. By contrast, the sorted pair example has an endpoint-elimination invariant and the read/write example has a same-direction two-pointers invariant. The presence of a valid counterexample outside both families is important: the correct classifier must permit “neither.”",
              "wrongOptionExplanationsByOptionId": {
                "sorted_pair_example": "This example does have a two-pointers invariant because sorted comparison justifies endpoint elimination.",
                "read_write_example": "Distinct read and write roles form a canonical same-direction two-pointers invariant."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sliding_window_example": "Omitting this preserves the false claim that every two-boundary moving loop is two pointers.",
                "prefix_query_example": "Omitting this misses that two indices may describe a range without either moving-pointer family."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_two_indices_implies_two_pointers_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "More than one statement may be correct."
            ]
          },
          {
            "id": "alg-ctpsw-rtimtp-04",
            "prompt": "A prompt says only that an O(n) solution uses indices i and j, with no output contract, state description, or movement rule. What classification is warranted?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "insufficient_information",
                  "text": "Neither family can be assigned yet; inspect the candidate, maintained state, and movement proof."
                },
                {
                  "id": "two_pointers",
                  "text": "Two pointers, because i and j are two indices."
                },
                {
                  "id": "sliding_window",
                  "text": "Sliding window, because two indices can bound a range."
                },
                {
                  "id": "choose_by_direction",
                  "text": "Ask only whether the indices move toward each other."
                }
              ],
              "acceptedOptionIds": [
                "insufficient_information"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Without candidate semantics or a discard proof, any family label would be a guess.",
              "details": "Complexity and variable count are compatible with many algorithms. To classify two pointers, the prompt must reveal an endpoint, convergence, merge, or read/write relation and explain safe movement. To classify sliding window, it must reveal a contiguous candidate, state representing that candidate, and a valid expand/evict or shrink rule. Direction may provide a weak clue but cannot replace these facts. The disciplined response is to request or derive the missing contract before choosing.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers": "The indices may serve unrelated roles, including a query range or binary-search interval.",
                "sliding_window": "Bounding a geometric range does not prove that the range is the maintained candidate.",
                "choose_by_direction": "Pointer direction has counterexamples in both families and cannot supply the missing invariant."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_two_indices_implies_two_pointers_heuristic",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "advanced",
            "constraints": [
              "Do not infer unstated properties from conventional variable names."
            ]
          }
        ],
