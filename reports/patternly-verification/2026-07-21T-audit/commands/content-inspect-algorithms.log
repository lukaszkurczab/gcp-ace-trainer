          {
            "id": "alg-mg-geometry-negative-polygon-index",
            "prompt": "A polygon has n>0 vertices indexed 0..n-1. At i=0, code needs the previous vertex. In a language where -1 % n is -1, which index expression is correct?",
            "constraints": [
              "n is positive.",
              "Index arithmetic uses a type that can represent i-1+n."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "normalized_previous",
                  "text": "((i-1)%n+n)%n"
                },
                {
                  "id": "raw_previous",
                  "text": "(i-1)%n"
                },
                {
                  "id": "absolute_previous",
                  "text": "abs(i-1)%n"
                },
                {
                  "id": "clamp_previous",
                  "text": "max(0,i-1)"
                }
              ],
              "acceptedOptionIds": [
                "normalized_previous"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Canonical modulo normalization maps the predecessor of vertex zero to n-1 instead of an invalid negative index.",
              "details": "Polygon traversal is cyclic, so the predecessor relation must wrap rather than clamp. With truncating remainder, raw -1%n remains -1. Adding n and reducing again returns n-1. Absolute value gives 1 when n>2, which is the next-near vertex rather than the previous one. This boundary often appears in orientation, edge, and shoelace loops even when all geometry predicates themselves are exact.",
              "wrongOptionExplanationsByOptionId": {
                "raw_previous": "The prompt states that the result is negative, so it is not a legal vertex index.",
                "absolute_previous": "For i=0, it gives vertex 1 rather than vertex n-1.",
                "clamp_previous": "Clamping changes the polygon cycle by making vertex zero its own predecessor."
              }
            },
            "difficulty": "foundational",
