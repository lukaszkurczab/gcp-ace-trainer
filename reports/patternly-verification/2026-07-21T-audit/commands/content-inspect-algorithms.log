        "items": [
          {
            "id": "alg-backtracking-choices-001",
            "prompt": "A combination solver has candidates indexed 0 through n - 1 and current start index s. Which indices should be considered as next choices?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "s_to_n_minus_one",
                  "text": "s through n - 1."
                },
                {
                  "id": "zero_to_n_minus_one",
                  "text": "0 through n - 1 at every level."
                },
                {
                  "id": "s_plus_one_only",
                  "text": "Only s + 1."
                },
                {
                  "id": "zero_to_s",
                  "text": "0 through s."
                }
              ],
              "acceptedOptionIds": [
                "s_to_n_minus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Combination search enumerates each remaining candidate index at or after the current start boundary.",
              "details": "Passing i + 1 to the child prevents reusing the chosen index and prevents generating the same set in different orders.",
              "wrongOptionExplanationsByOptionId": {
                "zero_to_n_minus_one": "Restarting at zero permits reordered duplicates and index reuse.",
                "s_plus_one_only": "The branch must consider every legal remaining candidate, not one forced index.",
                "zero_to_s": "Those indices are already outside the remaining candidate suffix."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-choices-002",
            "prompt": "A permutation solver uses a used-by-index array. Which positions are legal next choices?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "all_unused_indices",
                  "text": "Every index whose used flag is false."
                },
                {
                  "id": "only_after_last_index",
                  "text": "Only indices greater than the previously chosen index."
                },
                {
                  "id": "only_same_value",
                  "text": "Only positions whose value equals the previous choice."
                },
                {
                  "id": "only_first_unused",
                  "text": "Only the first unused index."
                }
              ],
              "acceptedOptionIds": [
                "all_unused_indices"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Permutation generation must branch over every currently unused input position.",
              "details": "Unlike combinations, the legal candidate range is not restricted to a monotonic suffix.",
              "wrongOptionExplanationsByOptionId": {
                "only_after_last_index": "That would generate combinations rather than all permutations.",
                "only_same_value": "Permutation legality is based on unused positions, not matching values.",
                "only_first_unused": "That would follow one path and omit other permutations."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-choices-003",
            "prompt": "A grid path may move orthogonally without leaving the board or reusing a path cell. Which operation defines the next-choice set?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "filter_neighbors",
                  "text": "Generate the four neighboring cells and keep only those satisfying bounds, match, and visited constraints."
                },
                {
                  "id": "scan_all_cells",
                  "text": "Choose any unvisited cell anywhere in the grid."
                },
                {
                  "id": "stay_only",
                  "text": "Choose only the current cell again."
                },
                {
                  "id": "diagonal_only",
                  "text": "Choose only diagonal neighbors."
                }
              ],
              "acceptedOptionIds": [
                "filter_neighbors"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Grid candidate generation starts from the movement relation and then applies branch legality constraints.",
              "details": "The choice set is local to the current cell and current path state.",
              "wrongOptionExplanationsByOptionId": {
                "scan_all_cells": "A path move is constrained by adjacency.",
                "stay_only": "The no-reuse path contract forbids this.",
                "diagonal_only": "The movement contract specifies orthogonal neighbors."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-choices-004",
            "prompt": "A partition solver is at start index s in a string of length n. Which exclusive end boundaries represent non-empty next segments?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "s_plus_one_to_n",
                  "text": "s + 1 through n, inclusive."
                },
                {
                  "id": "s_to_n_minus_one",
                  "text": "s through n - 1."
                },
                {
                  "id": "zero_to_n",
                  "text": "0 through n at every level."
                },
                {
                  "id": "only_n",
                  "text": "Only n."
                }
              ],
              "acceptedOptionIds": [
                "s_plus_one_to_n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A non-empty segment beginning at s has an exclusive end strictly greater than s and at most n.",
              "details": "Every such boundary is a potential choice before applying the segment-validity predicate.",
              "wrongOptionExplanationsByOptionId": {
                "s_to_n_minus_one": "End = s would create an empty segment, and end = n must remain available.",
                "zero_to_n": "Boundaries before s overlap already processed input.",
                "only_n": "That tries only the entire remaining suffix and omits shorter legal segments."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_search",
              "problemArchetypeId": "partition_sequence"
            }
          },
          {
            "id": "alg-backtracking-choices-005",
            "prompt": "When should a candidate that already violates a mandatory partial constraint be recursed into?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "never",
                  "text": "Never; it is not a legal next choice."
                },
                {
                  "id": "always_then_fail_later",
                  "text": "Always, because legality may be checked only at full depth."
                },
                {
                  "id": "only_if_last",
                  "text": "Only when it is the final candidate in the loop."
                },
                {
                  "id": "only_if_large",
                  "text": "Only when the candidate value is large."
                }
              ],
              "acceptedOptionIds": [
                "never"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Candidate enumeration should expose only transitions that preserve the partial-state invariant.",
              "details": "Rejecting an illegal choice before mutation and recursion prevents invalid child states from entering the search tree.",
              "wrongOptionExplanationsByOptionId": {
                "always_then_fail_later": "Known partial violations should not be expanded.",
                "only_if_last": "Loop position does not repair invalidity.",
                "only_if_large": "Magnitude is irrelevant unless the contract says so."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-choices-006",
            "prompt": "For a collect-all solver, can changing the order of legal candidate enumeration change the set of valid results?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "same_set_order_may_change",
                  "text": "It should not change the valid result set, though result order and traversal cost may change."
                },
                {
                  "id": "always_changes_set",
                  "text": "Yes, candidate order always changes which solutions are valid."
                },
                {
                  "id": "removes_need_for_undo",
                  "text": "It changes the set only by removing the need for state restoration."
                },
                {
                  "id": "forces_duplicates",
                  "text": "Any reordered loop necessarily creates duplicate results."
                }
              ],
              "acceptedOptionIds": [
                "same_set_order_may_change"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "An exhaustive legal search should be complete regardless of candidate ordering.",
              "details": "Ordering can affect short-circuit find-one results, performance, and the order of collected outputs, but not the mathematical solution set.",
              "wrongOptionExplanationsByOptionId": {
                "always_changes_set": "Validity is defined by the contract, not loop order.",
                "removes_need_for_undo": "Undo requirements depend on mutation, not candidate order.",
                "forces_duplicates": "Duplicates depend on state and duplicate-control rules."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-choices-007",
            "prompt": "A nonterminal state has no legal next choices and does not satisfy the completion contract. What does it represent?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "dead_end",
                  "text": "A dead end that returns to its parent."
                },
                {
                  "id": "valid_result",
                  "text": "A completed valid solution."
                },
                {
                  "id": "restart_search",
                  "text": "A reason to restart the entire search from the root."
                },
                {
                  "id": "record_empty",
                  "text": "A reason to append an empty result regardless of the current path."
                }
              ],
              "acceptedOptionIds": [
                "dead_end"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Candidate exhaustion and successful completion are separate conditions.",
              "details": "A dead-end branch contributes no result but does not invalidate sibling choices.",
              "wrongOptionExplanationsByOptionId": {
                "valid_result": "No-choice termination is not success unless completion is satisfied.",
                "restart_search": "Only this branch has failed.",
                "record_empty": "The result must satisfy the stated contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-choices-008",
            "prompt": "A solver for k-combinations has chosen c values and has only r candidate positions left. When can candidate enumeration stop immediately?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "r_less_k_minus_c",
                  "text": "When r < k - c."
                },
                {
                  "id": "r_equals_n",
                  "text": "Whenever r equals the original input length."
                },
                {
                  "id": "c_positive",
                  "text": "As soon as at least one value is chosen."
                },
                {
                  "id": "r_greater_zero",
                  "text": "Whenever any candidate remains."
                }
              ],
              "acceptedOptionIds": [
                "r_less_k_minus_c"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "If fewer candidates remain than required slots, no child sequence can complete the combination.",
              "details": "This is a sound capacity bound that can shorten or eliminate the candidate loop.",
              "wrongOptionExplanationsByOptionId": {
                "r_equals_n": "That often describes the root, not impossibility.",
                "c_positive": "Partial combinations still need expansion.",
                "r_greater_zero": "Remaining candidates are the reason to continue."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-choices-009",
            "prompt": "Why should candidate enumeration be based on indices rather than only values when equal input values may occupy distinct positions?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "position_identity",
                  "text": "The result contract may distinguish using one occurrence from using another, even when values are equal."
                },
                {
                  "id": "values_uncomparable",
                  "text": "Equal values cannot be compared."
                },
                {
                  "id": "indices_sort_input",
                  "text": "Using indices automatically sorts the input."
                },
                {
                  "id": "indices_remove_undo",
                  "text": "Index-based choices never require undo."
                }
              ],
              "acceptedOptionIds": [
                "position_identity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Candidate identity follows the problem contract.",
              "details": "Duplicate-control rules may later collapse value-equivalent branches, but the base candidate model must know which occurrences exist.",
              "wrongOptionExplanationsByOptionId": {
                "values_uncomparable": "Equality is not the issue.",
                "indices_sort_input": "Indices preserve positions but do not sort values.",
                "indices_remove_undo": "Used-index state still needs restoration."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "duplicate_control",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-choices-010",
            "prompt": "Which properties define legal next choices for combination generation? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "index_at_or_after_start",
                  "text": "The candidate index is at or after the current start boundary."
                },
                {
                  "id": "enough_remaining",
                  "text": "Enough later candidates remain to fill required slots when using capacity pruning."
                },
                {
                  "id": "candidate_constraint",
                  "text": "The candidate preserves any active partial constraints."
                },
                {
                  "id": "unused_anywhere",
                  "text": "Any unused index before start is always legal."
                }
              ],
              "acceptedOptionIds": [
                "index_at_or_after_start",
                "enough_remaining",
                "candidate_constraint"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Combination choices must respect ordering, feasibility, and problem-specific constraints.",
              "details": "The monotonic start boundary is what distinguishes combination enumeration from permutation enumeration.",
              "wrongOptionExplanationsByOptionId": {
                "unused_anywhere": "Indices before start would create reordered duplicate combinations."
              },
              "omittedCorrectExplanationsByOptionId": {
                "index_at_or_after_start": "This preserves increasing index order.",
                "enough_remaining": "This can exclude choices that cannot complete.",
                "candidate_constraint": "Illegal partial states should not be entered."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-choices-011",
            "prompt": "Which properties define legal next choices for a permutation of distinct indexed values? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "index_unused",
                  "text": "The candidate index is unused in the current path."
                },
                {
                  "id": "passes_constraints",
                  "text": "The candidate preserves active assignment constraints."
                },
                {
                  "id": "all_positions_considered",
                  "text": "Every unused position is considered rather than only positions after the previous index."
                },
                {
                  "id": "value_greater_previous",
                  "text": "The value must be greater than the previous value."
                }
              ],
              "acceptedOptionIds": [
                "index_unused",
                "passes_constraints",
                "all_positions_considered"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Permutation candidate enumeration ranges over all unused positions that remain legal.",
              "details": "A start boundary would incorrectly suppress valid orderings.",
              "wrongOptionExplanationsByOptionId": {
                "value_greater_previous": "That would impose an unstated monotonic-value constraint."
              },
              "omittedCorrectExplanationsByOptionId": {
                "index_unused": "A position may appear only once.",
                "passes_constraints": "Constraint legality applies before recursion.",
                "all_positions_considered": "Permutations require arbitrary next-index order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-choices-012",
            "prompt": "Which checks can make a neighboring grid cell a legal next choice? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "inside_bounds",
                  "text": "The row and column are inside the grid."
                },
                {
                  "id": "not_used_in_path",
                  "text": "The cell is not already used by the current path."
                },
                {
                  "id": "matches_next_target",
                  "text": "The cell matches the next required target symbol or condition."
                },
                {
                  "id": "globally_unseen",
                  "text": "The cell has never appeared in any earlier starting-cell search."
                }
              ],
              "acceptedOptionIds": [
                "inside_bounds",
                "not_used_in_path",
                "matches_next_target"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Grid choices are constrained by geometry, target progress, and path-local visited state.",
              "details": "Global exclusion would incorrectly couple independent branches and starting positions.",
              "wrongOptionExplanationsByOptionId": {
                "globally_unseen": "A cell may need to be reused by a different candidate path."
              },
              "omittedCorrectExplanationsByOptionId": {
                "inside_bounds": "Out-of-bounds positions cannot be read.",
                "not_used_in_path": "This enforces the no-reuse rule.",
                "matches_next_target": "The move must advance the target contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-choices-013",
            "prompt": "Which candidate boundaries can be legal in non-empty string partitioning? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "end_greater_start",
                  "text": "The exclusive end is greater than start."
                },
                {
                  "id": "end_at_most_length",
                  "text": "The exclusive end is at most the input length."
                },
                {
                  "id": "segment_valid",
                  "text": "The substring [start, end) satisfies the segment predicate."
                },
                {
                  "id": "end_before_start",
                  "text": "The end may be before start to represent backtracking."
                }
              ],
              "acceptedOptionIds": [
                "end_greater_start",
                "end_at_most_length",
                "segment_valid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A partition choice is a valid forward segment covering the next portion of the unresolved suffix.",
              "details": "Backtracking restores the path after exploring the child; it does not create backward or empty segments.",
              "wrongOptionExplanationsByOptionId": {
                "end_before_start": "Undo occurs after recursion; it is not represented by a reversed segment."
              },
              "omittedCorrectExplanationsByOptionId": {
                "end_greater_start": "This prevents empty segments.",
                "end_at_most_length": "The segment must stay inside the input.",
                "segment_valid": "Only valid segments should become child choices."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_search",
              "problemArchetypeId": "partition_sequence"
            }
          },
          {
            "id": "alg-backtracking-choices-014",
            "prompt": "Which statements support complete candidate enumeration? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "consider_every_legal_choice",
                  "text": "Every legal next choice is eventually considered unless a find-one contract has already succeeded."
                },
                {
                  "id": "exclude_illegal_before_recurse",
                  "text": "Known illegal choices are excluded before child recursion."
                },
                {
                  "id": "restore_between_siblings",
                  "text": "Mutable state is restored before considering the next sibling."
                },
                {
                  "id": "choose_only_promising",
                  "text": "Only choices that look intuitively promising are explored."
                }
              ],
              "acceptedOptionIds": [
                "consider_every_legal_choice",
                "exclude_illegal_before_recurse",
                "restore_between_siblings"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Completeness depends on exhaustive legal coverage and branch isolation.",
              "details": "Heuristic ordering is allowed, but heuristic omission is not sound pruning.",
              "wrongOptionExplanationsByOptionId": {
                "choose_only_promising": "An intuition-based filter can omit valid solutions."
              },
              "omittedCorrectExplanationsByOptionId": {
                "consider_every_legal_choice": "Completeness requires covering all legal branches.",
                "exclude_illegal_before_recurse": "This preserves the state invariant.",
                "restore_between_siblings": "Sibling choices must share the same parent state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-choices-015",
            "prompt": "Arrange the candidate-loop flow for one backtracking state.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "generate_candidate",
                  "text": "Generate the next candidate."
                },
                {
                  "id": "check_legality",
                  "text": "Check that the candidate preserves the partial-state invariant."
                },
                {
                  "id": "apply_choice",
                  "text": "Apply the candidate to branch state."
                },
                {
                  "id": "recurse_and_restore",
                  "text": "Recurse, then restore state before the next candidate."
                }
              ],
              "canonicalOrder": [
                "generate_candidate",
                "check_legality",
                "apply_choice",
                "recurse_and_restore"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Legality is established before mutation, and restoration completes one sibling branch.",
              "details": "This sequence prevents invalid child states and cross-branch contamination."
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-choices-016",
            "prompt": "Arrange the combination branch for choosing candidate index i.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "append_candidate",
                  "text": "Append candidates[i] to the path."
                },
                {
                  "id": "recurse_i_plus_one",
                  "text": "Recurse with start = i + 1."
                },
                {
                  "id": "remove_candidate",
                  "text": "Remove the appended candidate from the path."
                },
                {
                  "id": "advance_loop",
                  "text": "Advance the parent loop to the next candidate index."
                }
              ],
              "canonicalOrder": [
                "append_candidate",
                "recurse_i_plus_one",
                "remove_candidate",
                "advance_loop"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The child receives a strictly later start boundary, and the parent path is restored before the next sibling.",
              "details": "This produces each indexed combination once."
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-choices-017",
            "prompt": "Arrange the partition-choice flow for a candidate exclusive end boundary.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "form_segment",
                  "text": "Form or reference the segment [start, end)."
                },
                {
                  "id": "validate_segment",
                  "text": "Check the segment predicate."
                },
                {
                  "id": "append_and_recurse",
                  "text": "Append the valid segment and recurse from end."
                },
                {
                  "id": "pop_segment",
                  "text": "Remove the segment before trying another end."
                }
              ],
              "canonicalOrder": [
                "form_segment",
                "validate_segment",
                "append_and_recurse",
                "pop_segment"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A segment becomes a branch choice only after validation.",
              "details": "The path is restored so the next boundary is evaluated from the same partition prefix."
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_search",
              "problemArchetypeId": "partition_sequence"
            }
          },
          {
            "id": "alg-backtracking-choices-018",
            "prompt": "A permutation generator for n distinct values considers every unused value at each depth and emits all permutations. Select the number of leaves and maximum recursion depth.",
            "constraints": [
              "Each complete path uses all n values exactly once.",
              "No pruning removes a valid permutation."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "leaves",
                "recursion_depth"
              ],
              "availableValuesByDimension": {
                "leaves": [
                  "O(n)",
                  "O(2^n)",
                  "O(n!)",
                  "O(n^n)"
                ],
                "recursion_depth": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n!)"
                ]
              },
              "acceptedValuesByDimension": {
                "leaves": [
                  "O(n!)"
                ],
                "recursion_depth": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "leaves": {
                  "permutations": "O(n!)"
                },
                "recursion_depth": {
                  "path_length": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The branching choices shrink from n to n - 1 and so on, producing n! complete paths.",
              "details": "Depth follows the number of positions filled, while output materialization adds further output-sensitive work."
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_legal_next_choices",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_permutations"
            }
          }
        ],
