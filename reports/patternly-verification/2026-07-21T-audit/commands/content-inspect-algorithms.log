              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The reduction processes each input once.",
              "details": "Associativity permits streaming with one accumulator."
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_xor_cancellation",
              "secondarySkillAtomIds": [],
