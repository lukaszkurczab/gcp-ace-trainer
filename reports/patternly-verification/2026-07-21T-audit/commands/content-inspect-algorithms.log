                {
                  "id": "count_scan",
                  "text": "Count scan inspections under that case distribution."
                },
                {
                  "id": "count_binary",
                  "text": "Count legal binary-search iterations and access costs."
                },
                {
                  "id": "compare_same_case",
                  "text": "Compare both strategies under the same case and cost model."
                }
