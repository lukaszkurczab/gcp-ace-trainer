        "items": [
          {
            "id": "alg-tp-pair-sum-too-small",
            "prompt": "At the first comparison in [1, 4, 6, 9, 13], the endpoints total 14 while the target is 18. Which boundary candidate has been proved unusable, and how should the scan continue?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "retreat_right",
                  "text": "Retreat right from 13 to 9 and keep left at 1."
                },
                {
                  "id": "move_both",
                  "text": "Advance left and retreat right at the same time."
                },
                {
                  "id": "restart_middle",
                  "text": "Move both pointers to the middle of the array."
                },
                {
                  "id": "advance_left",
                  "text": "Advance left from 1 to 4 and keep right at 13."
                }
              ],
              "acceptedOptionIds": [
                "advance_left"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When the extreme sum is below the target, retaining the same left value cannot work with any smaller right value. Advancing left is the only boundary move that can increase the sum.",
              "details": "Because the array is nondecreasing, every candidate paired with left=1 has a right value at most 13. All of those sums are therefore at most 14 and remain below 18. The value 1 can be eliminated from the remaining search, while 13 must stay because 4+13 may still reach the target. Moving right or both pointers would discard a boundary that has not been proved irrelevant.",
              "wrongOptionExplanationsByOptionId": {
                "retreat_right": "Moving right leftward makes the partner no larger, so the sum cannot rise from 14 to 18 while left remains 1.",
                "move_both": "The right value 13 is still a viable partner for a larger left value. Moving both would skip 4+13.",
                "restart_middle": "Jumping to the middle has no elimination proof and can bypass multiple untested pairs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory",
            "constraints": [
              "The array is sorted in nondecreasing order.",
              "The two elements must occupy distinct positions."
            ]
          },
          {
            "id": "alg-tp-pair-sum-too-large",
            "prompt": "With target 14 on [2, 5, 8, 12, 17], the endpoint total is 19. Which boundary should be removed from the remaining candidate interval?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "advance_left",
                  "text": "Advance left from 2 to 5 and keep right at 17."
                },
                {
                  "id": "move_both",
                  "text": "Advance left and retreat right together."
                },
                {
                  "id": "keep_pair",
                  "text": "Keep both pointers because a later comparison may change the same sum."
                },
                {
                  "id": "retreat_right",
                  "text": "Retreat right from 17 to 12 and keep left at 2."
                }
              ],
              "acceptedOptionIds": [
                "retreat_right"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When the extreme sum is above the target, every larger-left partner with the same right value is also too large. The right boundary can be eliminated.",
              "details": "The current sum is 19. Any candidate using right=17 and a left value at least 2 has sum at least 19, so none can reach 14. Retreating right introduces a smaller value that can reduce the sum. Advancing left or moving both would discard the right value for the right reason but also discard a left value that could still pair with a smaller right.",
              "wrongOptionExplanationsByOptionId": {
                "advance_left": "Advancing left increases or preserves the sum and therefore cannot repair a sum already above the target.",
                "move_both": "Only right=17 has been eliminated. The current left value 2 may still pair with 12 to reach the target.",
                "keep_pair": "The sum of fixed endpoints will not change. Progress requires eliminating the boundary proved impossible."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory",
            "constraints": [
              "The array is sorted in nondecreasing order.",
              "The two elements must occupy distinct positions."
            ]
          },
          {
            "id": "alg-tp-pair-move-both-counterexample",
            "prompt": "For sorted values [1, 2, 4, 8] and target 10, the initial pair 1+8 is too small. A learner moves both pointers, producing the pair 2+4. What is the primary error?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "discarded_unproven_right",
                  "text": "The move discarded right=8 even though 2+8 is a valid solution."
                },
                {
                  "id": "left_should_never_move",
                  "text": "The left pointer must never move in pair-sum search."
                },
                {
                  "id": "target_requires_hash",
                  "text": "Target-sum problems cannot use two pointers."
                },
                {
                  "id": "array_has_duplicates",
                  "text": "The array contains duplicates that must be skipped first."
                }
              ],
              "acceptedOptionIds": [
                "discarded_unproven_right"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A below-target sum proves that left=1 is too small, but it does not eliminate right=8. Moving both skips the valid pair 2+8.",
              "details": "The ordered relation licenses exactly one elimination. Keeping 8 and increasing the smaller endpoint can raise the sum to the target. Retreating the right boundary would instead make the partner smaller and lose the only valid pair. The bug is not merely a bad trace; it reflects the false heuristic that both pointers should always move together.",
              "wrongOptionExplanationsByOptionId": {
                "left_should_never_move": "The left pointer is exactly the boundary that should move after a below-target sum. It is not globally fixed.",
                "target_requires_hash": "Sorted pair-sum is a canonical opposite-ends case. A hash approach is an alternative, not a requirement.",
                "array_has_duplicates": "All values are distinct. Duplicate handling is unrelated to the skipped solution in this trace."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory",
            "constraints": [
              "The array is sorted in nondecreasing order.",
              "The goal is to find any pair with sum 10."
            ]
          },
          {
            "id": "alg-tp-pair-equality-action",
            "prompt": "In a sorted pair-sum search, the current endpoints sum exactly to the target and the task asks whether any valid pair exists. What should happen before any further pointer movement?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "move_both_continue",
                  "text": "Move both pointers and continue because equality is not a stopping condition."
                },
                {
                  "id": "sort_again",
                  "text": "Sort the remaining interval again to confirm the result."
                },
                {
                  "id": "return_success",
                  "text": "Return success for the current distinct endpoint pair."
                },
                {
                  "id": "move_left_then_check",
                  "text": "Advance left, then check whether the previous pair was valid."
                }
              ],
              "acceptedOptionIds": [
                "return_success"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equality satisfies the existential output contract immediately. The answer must be recorded before changing the state that witnesses it.",
              "details": "The current endpoints are distinct because the loop maintains left < right. Their values meet the target, so no further elimination is needed for an existence query. Moving first risks losing the witness or performing unnecessary work. A different output contract, such as collecting all unique value pairs, would record the pair and then apply duplicate-aware movement instead of returning.",
              "wrongOptionExplanationsByOptionId": {
                "move_left_then_check": "Movement would replace one endpoint before the valid pair is committed. The witness exists in the current state and should be handled now.",
                "move_both_continue": "Equality may permit both pointers to move only after the pair is recorded and only when the output contract requires continued enumeration.",
                "sort_again": "The array is already sorted, and no additional ordering step is needed to validate an exact sum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory",
            "constraints": [
              "The task asks only whether at least one pair exists.",
              "The loop condition guarantees left < right."
            ]
          },
          {
            "id": "alg-tp-pair-distinct-position-termination",
            "prompt": "A pair-sum search must use two distinct array positions. Which loop condition preserves that requirement while the pointers converge?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "left_lt_right",
                  "text": "Continue while left < right."
                },
                {
                  "id": "left_le_right",
                  "text": "Continue while left <= right."
                },
                {
                  "id": "left_ne_zero",
                  "text": "Continue while left is not zero."
                },
                {
                  "id": "right_lt_n",
                  "text": "Continue while right is less than the array length."
                }
              ],
              "acceptedOptionIds": [
                "left_lt_right"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The candidate region contains a pair only while the two boundaries name distinct positions. At left == right, using both pointers would reuse one element.",
              "details": "The invariant treats left and right as the two selected positions at each comparison. Once they meet, no unordered pair remains in the current interval, so the search terminates. Using left <= right may incorrectly accept twice the middle value even when only one occurrence exists. This boundary changes if the task explicitly permits reusing an element, but standard pair selection does not.",
              "wrongOptionExplanationsByOptionId": {
                "left_le_right": "At equality the pointers refer to the same position, violating the distinct-position contract and potentially fabricating a pair.",
                "left_ne_zero": "Whether left equals zero says only where the interval starts, not whether two distinct positions remain. The stopping condition must compare left with right.",
                "right_lt_n": "This only checks an array bound; it does not express convergence or distinctness of the two selected positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory",
            "constraints": [
              "Each array position may be used at most once in a pair."
            ]
          },
          {
            "id": "alg-tp-pair-iteration-order",
            "prompt": "Order one iteration of an opposite-ends target-sum search after left and right already delimit the remaining candidate interval.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "handle_equal",
                  "text": "If equal, satisfy the current output contract before changing the pointers."
                },
                {
                  "id": "compare_target",
                  "text": "Compare the sum with the target."
                },
                {
                  "id": "compute_sum",
                  "text": "Compute the sum at the current left and right positions."
                },
                {
                  "id": "move_decisive",
                  "text": "Otherwise move only the boundary whose candidate is eliminated by the comparison."
                }
              ],
              "canonicalOrder": [
                "compute_sum",
                "compare_target",
                "handle_equal",
                "move_decisive"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The current pair must be evaluated and equality handled before a mismatch-driven boundary move. Movement is the consequence of the comparison, not a precondition for it.",
              "details": "Computing and comparing the current sum identifies one of three cases. Equality may complete the task or require recording a result. Only a strict below/above result licenses a one-sided move under the sortedness invariant. Reordering these steps can skip a witness or move without knowing which candidate has become impossible."
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The input is sorted in nondecreasing order.",
              "The current output contract is known before the iteration."
            ]
          },
          {
            "id": "alg-tp-pair-movement-rules-multiple",
            "prompt": "Select all movement statements that are valid for a nondecreasing target-sum pair search with distinct positions.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "high_retreat_right",
                  "text": "If the current sum is above the target, retreat right."
                },
                {
                  "id": "mismatch_move_both",
                  "text": "After any mismatch, move both pointers."
                },
                {
                  "id": "equal_consume_contract",
                  "text": "If the current sum equals the target, handle the pair according to the output contract before moving."
                },
                {
                  "id": "names_prove_rule",
                  "text": "The names left and right are sufficient evidence that these movements are correct."
                },
                {
                  "id": "low_advance_left",
                  "text": "If the current sum is below the target, advance left."
                }
              ],
              "acceptedOptionIds": [
                "low_advance_left",
                "high_retreat_right",
                "equal_consume_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The accepted rules follow from ordered sum monotonicity and answer timing. Neither moving both nor relying on variable names has a correctness basis.",
              "details": "A below-target sum eliminates the smallest remaining value, while an above-target sum eliminates the largest remaining value. Equality is not a mismatch; the witnessed pair must be returned or recorded first. The rules depend on the sorted input and distinct-position boundary. Without those preconditions, the same pointer names do not make the transitions safe.",
              "wrongOptionExplanationsByOptionId": {
                "mismatch_move_both": "One comparison usually eliminates exactly one boundary. Moving both can discard a still-viable partner and skip a solution.",
                "names_prove_rule": "Identifiers are not invariants. The ordered relation and candidate-elimination argument justify the rules."
              },
              "omittedCorrectExplanationsByOptionId": {
                "low_advance_left": "Omitting this misses the only move that can raise a below-target sum while preserving the current large endpoint.",
                "high_retreat_right": "Omitting this misses the only move that can lower an above-target sum while preserving the current small endpoint.",
                "equal_consume_contract": "Omitting this risks changing state before the current valid pair is committed under the output contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The array is sorted in nondecreasing order.",
              "The two positions must be distinct."
            ]
          },
          {
            "id": "alg-tp-pair-closest-sum-transfer",
            "prompt": "A sorted array is scanned for the pair whose sum is closest to a target. After recording the current pair as best-so-far if appropriate, the current sum is below the target. Which movement can produce a closer larger sum without discarding the current right endpoint?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "advance_left",
                  "text": "Advance left and keep right fixed."
                },
                {
                  "id": "retreat_right",
                  "text": "Retreat right and keep left fixed."
                },
                {
                  "id": "move_both",
                  "text": "Move both because the exact target was not reached."
                },
                {
                  "id": "stop",
                  "text": "Stop because a below-target sum cannot be improved."
                }
              ],
              "acceptedOptionIds": [
                "advance_left"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The monotonic direction is unchanged: advancing left is the only boundary move that can increase the sum. The closest-sum contract adds a best-so-far update, not a different elimination direction.",
              "details": "After comparing the current distance to the best recorded distance, a below-target sum needs a larger value to approach the target. Retreating right can only reduce or preserve the partner value, moving the sum farther down. Moving both discards the current right endpoint without proof. Unlike exact search, the algorithm continues after every nonexact comparison because the current pair may still be the final best.",
              "wrongOptionExplanationsByOptionId": {
                "retreat_right": "A smaller right value cannot increase a below-target sum and therefore cannot explore the needed direction.",
                "move_both": "Only the left boundary has been shown too small for the current right; the right endpoint may pair optimally with a larger left value.",
                "stop": "Closest-sum search must continue until the candidate interval is exhausted or an exact target is found, because a closer pair may remain."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The array is sorted in nondecreasing order.",
              "The current pair has already been considered for best-so-far."
            ]
          },
          {
            "id": "alg-tp-pair-ordered-relation-required",
            "prompt": "A teammate proposes applying the low-sum/advance-left and high-sum/retreat-right rules to an unsorted array because the code still uses two indices. What is the decisive objection?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "single_loop_too_slow",
                  "text": "A single loop is too slow for pair search."
                },
                {
                  "id": "ends_not_extremes",
                  "text": "Physical endpoints are not guaranteed to be the smallest and largest remaining values, so a comparison cannot eliminate a boundary safely."
                },
                {
                  "id": "indices_are_zero_based",
                  "text": "The indices start at zero, which is incompatible with two pointers."
                },
                {
                  "id": "must_move_both",
                  "text": "Unsorted input requires moving both pointers on every step."
                }
              ],
              "acceptedOptionIds": [
                "ends_not_extremes"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The movement rules are valid only when boundary position corresponds to ordered value extremity. An unsorted physical boundary has no monotonic elimination meaning.",
              "details": "If the current sum is low in an unsorted array, a smaller or larger value may appear on either side of either pointer. Advancing left can therefore discard a value that participates in a valid pair, and retreating right has the same problem. Sorting can create the needed order when allowed, but its cost and side effects must be included. Two indices and one loop do not replace the missing correctness argument.",
              "wrongOptionExplanationsByOptionId": {
                "indices_are_zero_based": "Index base is irrelevant. Zero-based arrays support the method when the value order and invariant are present.",
                "must_move_both": "Moving both compounds the problem by discarding two unproven candidates. It does not restore monotonicity.",
                "single_loop_too_slow": "One loop can be O(n), so speed is not the obstacle. The method fails because the arbitrary pair predicate provides no monotonic rule for safely discarding an endpoint."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "move_decisive_pointer",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The array is unsorted.",
              "No preprocessing has been performed."
            ]
          },
          {
            "id": "alg-tp-pair-end-to-end-unsorted-time",
            "prompt": "An unsorted array is first sorted with an O(n log n) comparison sort and then searched once with a linear opposite-ends pair scan. What is the overall time complexity?",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)",
                  "O(n^2)"
                ]
              },
              "acceptedValuesByDimension": {
