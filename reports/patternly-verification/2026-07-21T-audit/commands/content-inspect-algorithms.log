      {
        "id": "alg-contrast-hash-sort-transfer-014",
        "prompt": "Which tests demonstrate real transfer rather than memorized labels? Select all that apply.",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "multiple",
          "options": [
