        "items": [
          {
            "id": "recursion-basics-recursion-base-case-and-result-contract-count-digits-complete-contract",
            "prompt": "digits(n) must return the number of decimal digits in a non-negative integer n, including digits(0) == 1.\nWhich definition has a coherent base case and return contract?",
            "constraints": [
              "n is an integer with n >= 0.",
              "Decimal representation has no leading zeroes."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "single_digit_base",
                  "text": "If n < 10 return 1; otherwise return 1 + digits(n // 10)."
                },
                {
                  "id": "zero_returns_zero",
                  "text": "If n == 0 return 0; otherwise return 1 + digits(n // 10)."
                },
                {
                  "id": "return_last_digit",
                  "text": "If n < 10 return n; otherwise return digits(n // 10)."
                },
                {
                  "id": "stop_at_ten",
                  "text": "If n == 10 return 2; otherwise return 1 + digits(n // 10)."
                }
              ],
              "acceptedOptionIds": [
                "single_digit_base"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The base result must already mean “number of digits,” and the recursive step must add exactly the digit removed.",
              "details": "Every call to digits has one promise: return the count of decimal digits in its own argument. Values below\nten are terminal because they contain exactly one digit, including zero. For a larger value, integer\ndivision by ten removes one trailing digit and leaves a smaller non-negative integer whose digit count has\nthe same meaning. Adding one reconstructs the current answer. A base that returns the numeric digit itself\nor treats zero as having no digits breaks the uniform return contract. The transfer rule is to state the\nmeaning before choosing a sentinel value; the base return must be a real answer for that terminal state.",
              "wrongOptionExplanationsByOptionId": {
                "zero_returns_zero": "Returning 0 for n == 0 contradicts the stated contract that zero has one decimal digit. It also makes powers of ten undercount after the final recursive step reaches zero.",
                "return_last_digit": "This returns a digit value rather than a digit count. The base result and recursive result do not share the requested meaning.",
                "stop_at_ten": "A single special value does not cover the terminal class. Calls on 0 through 9 still need a result that satisfies the same digit-count contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_recursive_base_and_return_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "base_case_recognition",
              "problemArchetypeId": "compute_from_smaller_input"
            }
