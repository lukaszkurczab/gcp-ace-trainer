        "items": [
          {
            "id": "alg-sw-variable-shortest-positive-threshold",
            "prompt": "All values are positive. While seeking the shortest range with sum at least T, the current window first reaches sum ≥ T. What should the shrink rule do?",
            "constraints": [
              "Every value is positive.",
              "The objective is minimum length."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "shrink_while_valid",
                  "text": "Record the current length, remove the leftmost value, and repeat while the sum remains at least T."
                },
                {
                  "id": "stop_at_first_valid",
                  "text": "Stop shrinking after the first valid window because it is already the earliest ending at this right boundary."
                },
                {
                  "id": "shrink_until_answer_changes",
                  "text": "Remove values only until the global best length changes."
                },
                {
                  "id": "reset_window",
                  "text": "Clear the entire window after recording one valid range."
                }
              ],
              "acceptedOptionIds": [
                "shrink_while_valid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "For a shortest objective, every valid left removal produces a shorter candidate ending at the same right boundary.",
              "details": "Positivity makes each left removal decrease the sum. Once expansion reaches validity, the algorithm should test the current length, remove one left value, and continue while the threshold still holds. The final valid state before the sum drops below T is the shortest candidate ending at this right boundary. Stopping after one candidate can miss a shorter one, and clearing the range discards overlap needed for later endings. The loop condition is validity, not whether the global answer happened to change.",
              "wrongOptionExplanationsByOptionId": {
                "stop_at_first_valid": "The first valid window for this right boundary is usually the longest of the valid suffixes, not the shortest.",
                "shrink_until_answer_changes": "The answer may remain unchanged even though more left removals are required to find the locally minimal valid candidate.",
                "reset_window": "A full reset discards starts that can combine with future values and is not justified by the monotone invariant."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_monotonic_shrink_rule",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "variable_size_positive_numbers",
              "problemArchetypeId": "shortest_threshold_window"
            }
          },
          {
            "id": "alg-sw-variable-longest-valid-restoration",
            "prompt": "A window tracks nonnegative costs and must keep total cost at most B while maximizing length. After adding a value makes the window invalid, which rule is correct?",
            "constraints": [
              "All costs are nonnegative.",
              "Validity is totalCost ≤ B.",
              "The objective is maximum length."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "shrink_until_valid",
                  "text": "Advance left and remove costs while totalCost > B; once valid, consider the resulting length."
                },
                {
                  "id": "record_invalid_then_shrink",
                  "text": "Record the over-budget length first, then shrink once."
                },
                {
                  "id": "shrink_while_valid",
                  "text": "Keep shrinking while totalCost ≤ B."
                },
                {
                  "id": "move_right_back",
                  "text": "Move the right boundary backward until the prior window is restored."
                }
              ],
              "acceptedOptionIds": [
                "shrink_until_valid"
              ]
            },
            "scoringContract": {
              "type": "choice",
