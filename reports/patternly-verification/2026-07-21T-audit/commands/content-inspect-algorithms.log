            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A recursive invocation creates a new frame, so identically named parameters and locals are isolated per call.",
              "details": "When sumFrom(0) calls sumFrom(1), the first frame remains suspended with its own i and future rest slot. The child creates a second frame, and so on. During unwinding, each child sum is stored in the rest slot of its immediate parent, producing different values for different suffixes. This frame isolation is why ordinary recursive code can retain ancestor context without explicit arrays. Shared behavior occurs only for deliberately global, captured mutable, or reference-shared objects—not merely because local names repeat.",
              "wrongOptionExplanationsByOptionId": {
                "one_shared_rest": "A local variable belongs to a call frame. Reusing its source-level name does not make the storage or value global.",
                "rest_exists_only_base": "The base may return directly, while every non-terminal parent needs its own rest value after the child completes.",
                "rest_values_identical": "The same statement runs on different suffix states, whose sums can differ. Uniform code does not imply uniform local values."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "account_for_recursive_call_stack",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
