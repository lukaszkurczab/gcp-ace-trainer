        "items": [
          {
            "id": "alg-arrays-sequence-shape-001",
            "prompt": "A function returns the maximum element of a non-empty array. Which input shape requires an explicit contract decision before implementation?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "empty_input",
                  "text": "An empty array."
                },
                {
                  "id": "single_element",
                  "text": "A one-element array."
                },
                {
                  "id": "strictly_increasing",
                  "text": "A strictly increasing array."
                },
                {
                  "id": "all_equal",
                  "text": "An array whose values are all equal."
                }
              ],
              "acceptedOptionIds": [
                "empty_input"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A maximum is undefined for an empty input unless the contract specifies a sentinel, error, or optional result.",
              "details": "A singleton has an unambiguous maximum: its only value. Increasing and all-equal shapes are also well-defined. Empty input changes the existence of the result itself.",
              "wrongOptionExplanationsByOptionId": {
                "single_element": "The only element is directly the maximum.",
                "strictly_increasing": "The maximum exists and is the final value.",
                "all_equal": "Every value is a valid maximum, so the returned value is still unambiguous."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-002",
            "prompt": "A function checks whether an array is non-decreasing by comparing adjacent elements. What should it return for an empty array and a one-element array under the usual universal-condition contract?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_true",
                  "text": "true for both inputs."
                },
                {
                  "id": "both_false",
                  "text": "false for both inputs."
                },
                {
                  "id": "empty_false_single_true",
                  "text": "false for empty, true for one element."
                },
                {
                  "id": "empty_true_single_false",
                  "text": "true for empty, false for one element."
                }
              ],
              "acceptedOptionIds": [
                "both_true"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Neither shape contains an adjacent inversion that violates non-decreasing order.",
              "details": "The property says every adjacent pair must satisfy left <= right. Empty and singleton arrays contain no adjacent pairs, so no counterexample exists.",
              "wrongOptionExplanationsByOptionId": {
                "both_false": "The absence of pairs does not create a violating pair.",
                "empty_false_single_true": "The same no-counterexample reasoning applies to both shapes.",
                "empty_true_single_false": "A one-element array also has no adjacent inversion."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-003",
            "prompt": "A scan looks for a pair of adjacent equal values. Which input lengths can never contain such a pair?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero_or_one",
                  "text": "Length 0 or 1."
                },
                {
                  "id": "one_or_two",
                  "text": "Length 1 or 2."
                },
                {
                  "id": "only_zero",
                  "text": "Only length 0."
                },
                {
                  "id": "all_lengths",
                  "text": "Every input length can contain an adjacent equal pair."
                }
              ],
              "acceptedOptionIds": [
                "zero_or_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "An adjacent pair requires at least two positions.",
              "details": "Length 0 has no values and length 1 has no neighbor. Length 2 can contain a pair, for example [5, 5].",
              "wrongOptionExplanationsByOptionId": {
                "one_or_two": "A two-element input can contain exactly one adjacent pair.",
                "only_zero": "A singleton also lacks a second position.",
                "all_lengths": "Inputs shorter than two elements cannot contain any pair."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-004",
            "prompt": "A stable deduplication function keeps the first occurrence of every value. Which shape produces the smallest possible logical output for a non-empty input of length n?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "all_equal",
                  "text": "All n values are equal."
                },
                {
                  "id": "all_distinct",
                  "text": "All n values are distinct."
                },
                {
                  "id": "strictly_increasing",
                  "text": "Values are strictly increasing."
                },
                {
                  "id": "alternating_two_values",
                  "text": "The sequence alternates between two distinct values."
                }
              ],
              "acceptedOptionIds": [
                "all_equal"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When all values are equal, stable deduplication retains exactly one occurrence.",
              "details": "All-distinct and strictly increasing inputs retain n values. Alternating two values retain two distinct values. The all-equal shape minimizes output length at one.",
              "wrongOptionExplanationsByOptionId": {
                "all_distinct": "No value can be removed because every occurrence is unique.",
                "strictly_increasing": "Strict increase implies all values are distinct.",
                "alternating_two_values": "Two distinct values remain after stable deduplication."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-005",
            "prompt": "A filter keeps values greater than zero. What logical output length should be expected when every input value fails the predicate?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero",
                  "text": "0"
                },
                {
                  "id": "one",
                  "text": "1"
                },
                {
                  "id": "n",
                  "text": "n"
                },
                {
                  "id": "undefined",
                  "text": "The output length is undefined."
                }
              ],
              "acceptedOptionIds": [
                "zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A filter may legally produce an empty result even when the input is non-empty.",
              "details": "The output contains exactly the occurrences satisfying the predicate. If none do, the valid result has length zero.",
              "wrongOptionExplanationsByOptionId": {
                "one": "Filtering does not retain a fallback element unless the contract explicitly requires one.",
                "n": "Retaining all n values would contradict the fact that every value fails.",
                "undefined": "An empty filtered sequence is a well-defined result."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-006",
            "prompt": "A filter keeps values greater than zero. Which input shape produces a logical output length equal to n?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "all_pass",
                  "text": "Every input value satisfies the predicate."
                },
                {
                  "id": "none_pass",
                  "text": "No input value satisfies the predicate."
                },
                {
                  "id": "only_first_passes",
                  "text": "Only the first value satisfies the predicate."
                },
                {
                  "id": "alternating",
                  "text": "Exactly every second value satisfies the predicate."
                }
              ],
              "acceptedOptionIds": [
                "all_pass"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The output retains one occurrence for every passing input occurrence.",
              "details": "When all values pass, no position is removed and the logical result length remains n.",
              "wrongOptionExplanationsByOptionId": {
                "none_pass": "This produces an empty result.",
                "only_first_passes": "This produces a result of length one.",
                "alternating": "This retains only a subset of the n positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-008",
            "prompt": "Which shapes should be included when testing a stable deduplication function? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "all_distinct",
                  "text": "All values are distinct."
                },
                {
                  "id": "all_equal",
                  "text": "All values are equal."
                },
                {
                  "id": "separated_duplicates",
                  "text": "Duplicate values are separated by other values."
                },
                {
                  "id": "only_sorted_unique",
                  "text": "Only one already sorted, duplicate-free input."
                }
              ],
              "acceptedOptionIds": [
                "all_distinct",
                "all_equal",
                "separated_duplicates"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The test set should exercise no removals, maximal removals, and non-adjacent repetitions.",
              "details": "These shapes expose accidental deletion, incorrect output length, and algorithms that detect only adjacent duplicates.",
              "wrongOptionExplanationsByOptionId": {
                "only_sorted_unique": "One easy shape cannot reveal behavior under repeated or separated values."
              },
              "omittedCorrectExplanationsByOptionId": {
                "all_distinct": "It verifies that unique values are not removed.",
                "all_equal": "It verifies maximal duplicate collapse and the minimum non-empty output size.",
                "separated_duplicates": "It catches implementations that confuse adjacent-run compression with global deduplication."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-009",
            "prompt": "A normalizer removes every punctuation character. What should it return when the input consists entirely of punctuation?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "empty_sequence",
                  "text": "An empty normalized sequence."
                },
                {
                  "id": "one_punctuation",
                  "text": "One punctuation character as a placeholder."
                },
                {
                  "id": "unchanged_input",
                  "text": "The unchanged input sequence."
                },
                {
                  "id": "undefined",
                  "text": "No result, because normalization requires at least one retained character."
                }
              ],
              "acceptedOptionIds": [
                "empty_sequence"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A valid normalization may produce an empty canonical representation.",
              "details": "Every input occurrence belongs to the ignored category, so none is retained. The empty sequence remains a concrete, comparable result.",
              "wrongOptionExplanationsByOptionId": {
                "one_punctuation": "Adding a placeholder introduces data not present in the contract.",
                "unchanged_input": "This fails to remove characters explicitly declared ignorable.",
                "undefined": "An empty canonical result is well-defined unless the contract says otherwise."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-010",
            "prompt": "A sequence is already in canonical normalized form. Which behavior is expected from an idempotent normalizer?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "unchanged",
                  "text": "It remains unchanged."
                },
                {
                  "id": "remove_last",
                  "text": "The final element is removed to mark completion."
                },
                {
                  "id": "sort_again",
                  "text": "The sequence is always sorted, even when sorting is not part of the contract."
                },
                {
                  "id": "duplicate_values",
                  "text": "Every retained value is duplicated."
                }
              ],
              "acceptedOptionIds": [
                "unchanged"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "An idempotent normalizer maps canonical input to itself.",
              "details": "Repeated normalization should not keep changing a representation that already satisfies every canonical rule.",
              "wrongOptionExplanationsByOptionId": {
                "remove_last": "Normalization must not delete meaningful data merely to signal execution.",
                "sort_again": "Sorting is legal only if order is declared irrelevant.",
                "duplicate_values": "Adding occurrences violates the preservation contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-011",
            "prompt": "A function compares two sequences position by position. Which shape difference can allow an immediate false result before examining corresponding values?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "different_lengths",
                  "text": "The sequences have different lengths and equality requires every position to match."
                },
                {
                  "id": "both_empty",
                  "text": "Both sequences are empty."
                },
                {
                  "id": "both_singleton",
                  "text": "Both sequences contain one value."
                },
                {
                  "id": "same_length",
                  "text": "The sequences have the same length."
                }
              ],
              "acceptedOptionIds": [
                "different_lengths"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Position-by-position equality requires equal lengths.",
              "details": "If lengths differ, one sequence contains an unmatched position regardless of the values in the shared prefix. Equal length is necessary but not sufficient.",
              "wrongOptionExplanationsByOptionId": {
                "both_empty": "Two empty sequences satisfy positional equality.",
                "both_singleton": "Their values still need comparison; the shape alone does not prove inequality.",
                "same_length": "Equal length permits equality but does not determine it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-012",
            "prompt": "A function groups consecutive equal values into runs. How many runs are produced by [2, 2, 1, 2, 2]?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "three_runs",
                  "text": "3"
                },
                {
                  "id": "two_runs",
                  "text": "2"
                },
                {
                  "id": "one_run",
                  "text": "1"
                },
                {
                  "id": "five_runs",
                  "text": "5"
                }
              ],
              "acceptedOptionIds": [
                "three_runs"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Run boundaries depend on adjacency, so separated occurrences of the same value form different runs.",
              "details": "The runs are [2, 2], [1], and [2, 2]. Global value identity does not merge non-adjacent runs.",
              "wrongOptionExplanationsByOptionId": {
                "two_runs": "This incorrectly merges the two separated runs of value 2.",
                "one_run": "The value changes twice, creating additional run boundaries.",
                "five_runs": "Equal adjacent values belong to the same run rather than separate runs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-013",
            "prompt": "Which shapes expose the minimum-length boundary for a three-element window? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "length_two",
                  "text": "Length 2, where no legal window exists."
                },
                {
                  "id": "length_three",
                  "text": "Length 3, where exactly one legal window exists."
                },
                {
                  "id": "length_four",
                  "text": "Length 4, where two legal starts exist."
                },
                {
                  "id": "only_large_random",
                  "text": "Only one large random input."
                }
              ],
              "acceptedOptionIds": [
                "length_two",
                "length_three",
                "length_four"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The largest illegal shape, smallest legal shape, and next legal shape reveal the boundary transition.",
              "details": "Lengths 2, 3, and 4 verify zero, one, and multiple window placements. A single large input does not isolate the threshold.",
              "wrongOptionExplanationsByOptionId": {
                "only_large_random": "A large case may pass despite an off-by-one error at the minimum legal length."
              },
              "omittedCorrectExplanationsByOptionId": {
                "length_two": "It verifies that the algorithm rejects a sequence one element too short.",
                "length_three": "It verifies acceptance of exactly one minimum-size window.",
                "length_four": "It verifies continuation beyond the first legal placement."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-014",
            "prompt": "Which shapes are useful for testing a frequency-count implementation? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "all_same",
                  "text": "All values are the same."
                },
                {
                  "id": "all_distinct",
                  "text": "All values are distinct."
                },
                {
                  "id": "one_dominant_value",
                  "text": "One value appears many times while several others appear once."
                },
                {
                  "id": "only_one_balanced_case",
                  "text": "Only one input where every value appears twice."
                }
              ],
              "acceptedOptionIds": [
                "all_same",
                "all_distinct",
                "one_dominant_value"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Frequency logic should be tested at minimal key count, maximal key count, and uneven multiplicity.",
              "details": "These shapes expose incorrect initialization, key creation, and repeated increment behavior.",
              "wrongOptionExplanationsByOptionId": {
                "only_one_balanced_case": "One symmetric case does not test extremes or skewed distributions."
              },
              "omittedCorrectExplanationsByOptionId": {
                "all_same": "It verifies repeated updates to one key and the minimum distinct-key count.",
                "all_distinct": "It verifies creation of one count entry per occurrence and the maximum distinct-key count.",
                "one_dominant_value": "It checks that large and small counts coexist correctly."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-016",
            "prompt": "An adjacent scan examines every pair in an array of length n. Select the number of pair checks and auxiliary-space complexity.",
            "constraints": [
              "The algorithm uses only a constant number of local variables."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "pair_checks",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "pair_checks": [
                  "0",
                  "max(0, n - 1)",
                  "n",
                  "n²"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "pair_checks": [
                  "max(0, n - 1)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "pair_checks": {
                  "adjacent_boundaries": "max(0, n - 1)"
                },
                "auxiliary_space": {
                  "constant": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Sequence length determines the number of adjacent boundaries, including the zero-pair edge cases.",
              "details": "Lengths 0 and 1 produce zero checks. For n >= 2, each boundary between neighboring elements is examined once, yielding n - 1 checks."
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-017",
            "prompt": "A developer sorts an input before checking whether the original sequence alternates between two values. What is the main defect?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sorting_destroys_shape",
                  "text": "Sorting destroys the original positional shape that defines alternation."
                },
                {
                  "id": "sorting_removes_duplicates",
                  "text": "Sorting automatically removes repeated values."
                },
                {
                  "id": "sorting_cannot_handle_two_values",
                  "text": "Sorting is unable to process sequences containing exactly two values."
                },
                {
                  "id": "sorting_constant_space",
                  "text": "Sorting is invalid because it always uses constant space."
                }
              ],
              "acceptedOptionIds": [
                "sorting_destroys_shape"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Alternation is defined by the original order of neighboring positions.",
              "details": "Sorting groups equal values and can turn an alternating sequence into runs. The multiset remains similar, but the shape relevant to the question is lost.",
              "wrongOptionExplanationsByOptionId": {
                "sorting_removes_duplicates": "Sorting rearranges occurrences but does not delete them.",
                "sorting_cannot_handle_two_values": "Sorting can process such inputs; it simply violates the positional contract.",
                "sorting_constant_space": "Space usage is not the semantic defect."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-sequence-shape-018",
            "prompt": "A function removes only consecutive duplicates. What should it return for [1, 2, 1]?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "unchanged",
                  "text": "[1, 2, 1]"
                },
                {
                  "id": "global_unique",
                  "text": "[1, 2]"
                },
                {
                  "id": "one_only",
                  "text": "[1]"
                },
                {
                  "id": "sorted_unique",
                  "text": "[1, 2], because sorting is implied"
                }
              ],
              "acceptedOptionIds": [
                "unchanged"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The repeated 1 values are separated, so the sequence contains no consecutive duplicate run.",
              "details": "The input shape matters: global repetition does not imply adjacent repetition. Every original occurrence remains under the consecutive-only contract.",
              "wrongOptionExplanationsByOptionId": {
                "global_unique": "This applies global deduplication rather than consecutive-run collapse.",
                "one_only": "This removes distinct and non-consecutive values without justification.",
                "sorted_unique": "Sorting is not implied and would change the original sequence shape."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_sequence_shape_edge_case",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          }
        ],
