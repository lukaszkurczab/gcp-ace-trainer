      {
        "id": "recursion-basics-recursion-mistake-review-empty-input-guard-after-read",
        "prompt": "Consider a shared immutable array a:\n\n    containsFrom(i, target):\n        if a[i] == target: return true\n        if i == len(a): return false\n        return containsFrom(i + 1, target)\n\nWhat fails when i == len(a)?",
        "constraints": [
          "i may equal len(a).",
          "Array indexing is valid only for 0 <= i < len(a).",
          "The array is not padded with a sentinel element."
        ],
        "difficulty": "intermediate",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "read_before_terminal_guard",
              "text": "The code reads a[i] before recognizing the empty suffix, so the terminal state causes an out-of-bounds access."
            },
            {
              "id": "missing_target_state",
              "text": "target must change in every recursive call."
            },
            {
              "id": "wrong_boolean_combiner",
              "text": "The function must combine two child Booleans with AND."
            },
            {
              "id": "only_complexity_problem",
              "text": "The code is correct but uses O(n) instead of O(log n)."
            }
          ],
          "acceptedOptionIds": [
            "read_before_terminal_guard"
          ]
