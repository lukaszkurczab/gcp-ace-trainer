        "items": [
          {
            "id": "alg-tree-path-running-sum-state",
            "prompt": "A helper determines whether a root-to-leaf path sums to `target`. Which state update keeps each recursive branch independent?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "pass_next_remaining",
                  "text": "Compute `nextRemaining = remaining - node.value` and pass that value separately to each child."
                },
                {
                  "id": "mutate_global_remaining",
                  "text": "Subtract from one global `remaining` variable and never restore it after a child returns."
