              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The map may have k keys, but the lists collectively store n positions.",
              "details": "Preserving every occurrence index removes any O(k)-only space claim."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_order_and_indices_across_strategy_choice",
              "secondarySkillAtomIds": [],
