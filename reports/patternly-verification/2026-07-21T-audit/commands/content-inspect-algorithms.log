        "items": [
          {
            "id": "alg-backtracking-state-001",
            "prompt": "For generating combinations without reusing earlier indices, which state is essential?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_index",
                  "text": "The next candidate start index."
                },
                {
                  "id": "last_output_length",
                  "text": "Only the length of the global result list."
                },
                {
                  "id": "sorted_flag",
                  "text": "A boolean saying whether the input is sorted."
                },
                {
                  "id": "recursion_count",
                  "text": "The total number of recursive calls made so far."
                }
              ],
              "acceptedOptionIds": [
                "start_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A start boundary records which candidate indices remain legal for the current combination.",
              "details": "The current path alone may not distinguish whether earlier indices are still available, so the candidate boundary belongs in state.",
              "wrongOptionExplanationsByOptionId": {
                "last_output_length": "Global result count does not constrain the next candidate range.",
                "sorted_flag": "Sorting may be relevant elsewhere but does not replace the start boundary.",
                "recursion_count": "Call count does not define legal candidates."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-state-002",
            "prompt": "For generating permutations of n distinct values, which state prevents reusing the same input position within one path?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "used_indices",
                  "text": "A used-by-index set, boolean array, or bitmask."
                },
                {
                  "id": "start_only",
                  "text": "Only a monotonically increasing start index."
                },
                {
                  "id": "result_count",
                  "text": "Only the number of completed permutations."
                },
                {
                  "id": "previous_value",
                  "text": "Only the previously chosen value."
                }
              ],
              "acceptedOptionIds": [
                "used_indices"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Permutation state must distinguish every input position already selected in the current branch.",
              "details": "A used structure supports arbitrary next-index order while preventing repetition of the same position.",
              "wrongOptionExplanationsByOptionId": {
                "start_only": "A start index would prevent permutations that use a lower index later.",
                "result_count": "Global output count does not identify branch-local availability.",
                "previous_value": "One value cannot represent all used positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-state-003",
            "prompt": "A target-sum backtracking solver uses only positive candidate values. Which state can avoid recomputing the sum of the current path?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "remaining_target",
                  "text": "The remaining target after chosen values are subtracted."
                },
                {
                  "id": "global_max",
                  "text": "The maximum input value."
                },
                {
                  "id": "call_depth_only",
                  "text": "Only recursion depth."
                },
                {
                  "id": "result_size",
                  "text": "The number of solutions already found."
                }
              ],
              "acceptedOptionIds": [
                "remaining_target"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Remaining target is a sufficient summary of the path sum for this constraint.",
              "details": "It supports completion at zero and sound positive-only overshoot pruning without scanning the full path.",
              "wrongOptionExplanationsByOptionId": {
                "global_max": "The maximum does not summarize current progress.",
                "call_depth_only": "Different choices at the same depth can have different sums.",
                "result_size": "Output count does not describe branch feasibility."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-state-004",
            "prompt": "A grid word-search call is represented by (row, col, wordIndex). What additional branch-local state is required when cells cannot be reused in the same path?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "visited_path",
                  "text": "Which cells are already used by the current path."
                },
                {
                  "id": "global_result_count",
                  "text": "The number of words found in earlier searches."
                },
                {
                  "id": "row_sum",
                  "text": "The sum of values in the current row."
                },
                {
                  "id": "board_size_only",
                  "text": "Only the grid dimensions."
                }
              ],
              "acceptedOptionIds": [
                "visited_path"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The call coordinates and target position do not encode which cells were used earlier in the branch.",
              "details": "Visited state can be represented explicitly or by reversible in-place marking, but it must be path-local.",
              "wrongOptionExplanationsByOptionId": {
                "global_result_count": "Earlier output count does not prevent current-path reuse.",
                "row_sum": "Row aggregates do not encode used cells.",
                "board_size_only": "Dimensions support bounds checks but not path reuse constraints."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-state-005",
            "prompt": "Which state is redundant in a combination solver when current path length can be read in O(1)?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "separate_chosen_count",
                  "text": "A separate chosenCount field always equal to path.length."
                },
                {
                  "id": "start_index",
                  "text": "The next legal candidate boundary."
                },
                {
                  "id": "current_path",
                  "text": "The selected values."
                },
                {
                  "id": "remaining_target",
                  "text": "The unresolved target for a constrained-sum problem."
                }
              ],
              "acceptedOptionIds": [
                "separate_chosen_count"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "State that is exactly and cheaply derivable need not be duplicated.",
              "details": "Redundant mutable fields can drift out of sync and enlarge the proof burden.",
              "wrongOptionExplanationsByOptionId": {
                "start_index": "This is not derivable from path length alone.",
                "current_path": "The output under construction is necessary.",
                "remaining_target": "This may summarize feasibility more efficiently than recomputing the path sum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-state-006",
            "prompt": "A solver mutates one shared current path. Where should that path belong conceptually?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "branch_state",
                  "text": "Branch-local state whose contents are restored before sibling exploration."
                },
                {
                  "id": "global_configuration",
                  "text": "Immutable global configuration shared without restoration."
                },
                {
                  "id": "result_metadata",
                  "text": "Only metadata about completed results."
                },
                {
                  "id": "candidate_catalog",
                  "text": "The fixed list of all possible input candidates."
                }
              ],
              "acceptedOptionIds": [
                "branch_state"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The current path is mutable state describing the active root-to-node branch.",
              "details": "It may be implemented as one shared object for efficiency, but choose-recurse-unchoose semantics make it logically branch-local.",
              "wrongOptionExplanationsByOptionId": {
                "global_configuration": "The path changes across branches and cannot be treated as immutable configuration.",
                "result_metadata": "The path represents the current partial solution.",
                "candidate_catalog": "Candidates and selected path are different state roles."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-state-007",
            "prompt": "A partitioning solver receives a string and a start index. Which state is sufficient to identify the unresolved suffix?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_index",
                  "text": "The exclusive boundary where the next segment must begin."
                },
                {
                  "id": "all_previous_end_indices",
                  "text": "Every previous boundary even when the current path already stores the segments."
                },
                {
                  "id": "result_count",
                  "text": "The number of partitions already found."
                },
                {
                  "id": "last_character_only",
                  "text": "Only the final character of the previous segment."
                }
              ],
              "acceptedOptionIds": [
                "start_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The next unprocessed position determines the remaining suffix.",
              "details": "The chosen segments remain in the path for output, while start directs candidate boundary enumeration.",
              "wrongOptionExplanationsByOptionId": {
                "all_previous_end_indices": "The full boundary history may be redundant for finding the next suffix.",
                "result_count": "Output count does not locate the unresolved suffix.",
                "last_character_only": "That does not identify where the remaining input begins."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_search",
              "problemArchetypeId": "partition_sequence"
            }
          },
          {
            "id": "alg-backtracking-state-008",
            "prompt": "Why is storing the entire remaining substring often less attractive than storing its start index?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "copies_and_identity",
                  "text": "It can create repeated substring copies while the index already identifies the same suffix."
                },
                {
                  "id": "indices_invalid",
                  "text": "Indices cannot identify positions in a string."
                },
                {
                  "id": "substrings_no_length",
                  "text": "Substring values have no length."
                },
                {
                  "id": "recursion_requires_copy",
                  "text": "Recursion always requires a copied input."
                }
              ],
              "acceptedOptionIds": [
                "copies_and_identity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A compact boundary can identify the unresolved region without duplicating immutable input data.",
              "details": "State should preserve necessary information while avoiding redundant materialization.",
              "wrongOptionExplanationsByOptionId": {
                "indices_invalid": "Indices are the standard way to identify suffix boundaries.",
                "substrings_no_length": "Substrings do have length.",
                "recursion_requires_copy": "Recursive calls can share immutable input with boundary state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_search",
              "problemArchetypeId": "partition_sequence"
            }
          },
          {
            "id": "alg-backtracking-state-009",
            "prompt": "A solver stores both remainingTarget and the full current sum, updating both independently. What risk does this introduce?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "inconsistent_redundant_state",
                  "text": "The two redundant values can become inconsistent after an update or undo."
                },
                {
                  "id": "automatic_pruning",
                  "text": "The branch will be pruned automatically."
                },
                {
                  "id": "duplicate_results",
                  "text": "Every result is necessarily duplicated."
                },
                {
                  "id": "constant_space",
                  "text": "The algorithm becomes O(1) space."
                }
              ],
              "acceptedOptionIds": [
                "inconsistent_redundant_state"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Redundant mutable state increases synchronization obligations.",
              "details": "Prefer one canonical representation or derive one value from the other when the cost is acceptable.",
              "wrongOptionExplanationsByOptionId": {
                "automatic_pruning": "Redundant state does not automatically improve correctness.",
                "duplicate_results": "Duplication is not an inevitable consequence.",
                "constant_space": "Additional fields do not reduce recursion state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-state-010",
            "prompt": "Which fields can form sufficient state for k-combination generation from an indexed array? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "start_index",
                  "text": "The next candidate start index."
                },
                {
                  "id": "current_path",
                  "text": "The values or indices selected so far."
                },
                {
                  "id": "remaining_slots",
                  "text": "The number of values still required, when not derived from path length."
                },
                {
                  "id": "global_call_count",
                  "text": "The total number of calls made across the entire search."
                }
              ],
              "acceptedOptionIds": [
                "start_index",
                "current_path",
                "remaining_slots"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sufficient state must identify the partial output, legal candidate range, and remaining completion requirement.",
              "details": "Instrumentation such as global call count is not part of the search semantics.",
              "wrongOptionExplanationsByOptionId": {
                "global_call_count": "It does not affect legal completion."
              },
              "omittedCorrectExplanationsByOptionId": {
                "start_index": "It prevents reusing earlier indices and duplicate orderings.",
                "current_path": "It represents the partial combination.",
                "remaining_slots": "It can support completion and capacity pruning."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-state-011",
            "prompt": "Which information can be represented by a used bitmask in a permutation solver? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "used_positions",
                  "text": "Which input positions are already selected in the current path."
                },
                {
                  "id": "available_positions",
                  "text": "Which positions remain available, by complementing within the n-bit domain."
                },
                {
                  "id": "chosen_count",
                  "text": "How many positions are selected, by counting set bits."
                },
                {
                  "id": "selected_order",
                  "text": "The exact order in which selected values appear in the path."
                }
              ],
              "acceptedOptionIds": [
                "used_positions",
                "available_positions",
                "chosen_count"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A bitmask compactly represents membership, but not the ordered path itself.",
              "details": "Permutation output still needs path order or an equivalent ordered construction.",
              "wrongOptionExplanationsByOptionId": {
                "selected_order": "A set of bits does not encode ordering."
              },
              "omittedCorrectExplanationsByOptionId": {
                "used_positions": "Each bit can represent one input position.",
                "available_positions": "Availability is derivable from the used mask.",
                "chosen_count": "The count is derivable from the mask."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-state-012",
            "prompt": "Which state components are relevant for path-based grid search? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "current_cell",
                  "text": "The current row and column."
                },
                {
                  "id": "target_progress",
                  "text": "The index or amount of target already matched."
                },
                {
                  "id": "path_visited",
                  "text": "Cells already used in the current path."
                },
                {
                  "id": "completed_result_count",
                  "text": "The number of unrelated paths found earlier."
                }
              ],
              "acceptedOptionIds": [
                "current_cell",
                "target_progress",
                "path_visited"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Grid-search state combines location, target progress, and branch-local reuse constraints.",
              "details": "Global output metadata does not replace those branch semantics.",
              "wrongOptionExplanationsByOptionId": {
                "completed_result_count": "It does not determine current branch legality."
              },
              "omittedCorrectExplanationsByOptionId": {
                "current_cell": "They identify the search position.",
                "target_progress": "It identifies the next required symbol.",
                "path_visited": "It enforces no-reuse within the branch."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-state-013",
            "prompt": "Which properties suggest that a state field is redundant? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "cheaply_derivable",
                  "text": "It is deterministically and cheaply derived from other state."
                },
                {
                  "id": "must_sync_on_undo",
                  "text": "Every choose and undo operation must update it in lockstep with another field."
                },
                {
                  "id": "never_read",
                  "text": "No completion, legality, pruning, or output logic reads it."
                },
                {
                  "id": "branch_legality",
                  "text": "It is the only field that determines whether a candidate is legal."
                }
              ],
              "acceptedOptionIds": [
                "cheaply_derivable",
                "must_sync_on_undo",
                "never_read"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "State should be minimal but sufficient.",
              "details": "Essential legality information cannot be removed merely to reduce field count.",
              "wrongOptionExplanationsByOptionId": {
                "branch_legality": "That makes it essential rather than redundant."
              },
              "omittedCorrectExplanationsByOptionId": {
                "cheaply_derivable": "Duplicating it may be unnecessary.",
                "must_sync_on_undo": "This creates drift risk.",
                "never_read": "Unused state has no semantic purpose."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-state-014",
            "prompt": "Which state should normally be immutable configuration shared by all branches? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "input_candidates",
                  "text": "The original candidate list when branches do not modify it."
                },
                {
                  "id": "target_contract",
                  "text": "The fixed target or constraint definition."
                },
                {
                  "id": "current_path",
                  "text": "The mutable selected path."
                },
                {
                  "id": "path_visited",
                  "text": "The current path's visited-cell set."
                }
              ],
              "acceptedOptionIds": [
                "input_candidates",
                "target_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Shared immutable configuration is distinct from mutable branch state.",
              "details": "Keeping the distinction explicit reduces accidental cross-branch contamination.",
              "wrongOptionExplanationsByOptionId": {
                "current_path": "The path changes per branch and requires isolation or restoration.",
                "path_visited": "Visited state is branch-local in reusable-cell path search."
              },
              "omittedCorrectExplanationsByOptionId": {
                "input_candidates": "All branches may safely read the same immutable input.",
                "target_contract": "The contract is shared configuration."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-state-015",
            "prompt": "Arrange the process for designing backtracking state.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "define_completion",
                  "text": "Define what a complete valid result means."
                },
                {
                  "id": "define_legality",
                  "text": "Define which next choices are legal from a partial state."
                },
                {
                  "id": "select_minimal_fields",
                  "text": "Choose the minimal fields needed to answer completion and legality questions."
                },
                {
                  "id": "define_updates",
                  "text": "Specify how every field changes and is restored for one branch."
                }
              ],
              "canonicalOrder": [
                "define_completion",
                "define_legality",
                "select_minimal_fields",
                "define_updates"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "State design follows from the result and transition contracts.",
              "details": "Choosing fields before defining their semantic queries often produces redundant or insufficient state."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-state-016",
            "prompt": "Arrange the state update for a target-sum branch using remainingTarget.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_candidate",
                  "text": "Verify that the candidate is legal for the current state."
                },
                {
                  "id": "subtract_candidate",
                  "text": "Subtract the chosen value from remainingTarget."
                },
                {
                  "id": "recurse",
                  "text": "Explore the child state."
                },
                {
                  "id": "restore_target",
                  "text": "Add the value back when returning to the parent state."
                }
              ],
              "canonicalOrder": [
                "check_candidate",
                "subtract_candidate",
                "recurse",
                "restore_target"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The child state must reflect the choice, and the parent state must be restored afterward.",
              "details": "This transition keeps remainingTarget synchronized with the current path."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-state-017",
            "prompt": "A permutation solver stores a length-n boolean used array and a recursion path of depth at most n, excluding materialized outputs. Select the auxiliary-space complexity.",
            "constraints": [
              "The input contains n values.",
              "Only one depth-first branch is active at a time."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "auxiliary_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "auxiliary_space": {
                  "used_plus_depth": "O(n)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "The used array and active recursion path each scale linearly with n.",
              "details": "Their sum remains O(n). The potentially factorial output is excluded by the stated auxiliary-space accounting."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-state-018",
            "prompt": "A grid path solver uses an R by C visited matrix and recursion depth at most L. Select its auxiliary-space bound, excluding the immutable grid.",
            "constraints": [
              "The visited matrix is stored explicitly.",
              "At most L recursive calls are active."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "auxiliary_space": [
                  "O(1)",
                  "O(L)",
                  "O(RC)",
                  "O(RC + L)"
                ]
              },
              "acceptedValuesByDimension": {
                "auxiliary_space": [
                  "O(RC + L)"
                ]
              },
              "normalizedAliasesByDimension": {
                "auxiliary_space": {
                  "visited_plus_stack": "O(RC + L)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Explicit visited state and the active recursion stack contribute separate terms.",
              "details": "If visited is instead encoded by reversible in-place board mutation, the explicit RC term may disappear, but that is a different state representation."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_backtracking_state",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          }
        ],
