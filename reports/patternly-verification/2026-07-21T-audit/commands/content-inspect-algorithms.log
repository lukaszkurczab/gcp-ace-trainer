              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-011",
            "prompt": "The left half [left, mid] is ordered. Which conditions place target inside that half? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "at_left",
                  "text": "target equals nums[left]."
                },
                {
                  "id": "strict_inside",
                  "text": "nums[left] < target < nums[mid]."
                },
                {
                  "id": "at_mid",
                  "text": "target equals nums[mid], before the mismatch branch is entered."
                },
                {
                  "id": "greater_mid",
                  "text": "target is greater than nums[mid]."
                }
              ],
              "acceptedOptionIds": [
                "at_left",
                "strict_inside",
                "at_mid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The ordered half covers its inclusive endpoint-value range under distinct values.",
              "details": "The exact-match check at mid is normally handled before half selection.",
              "wrongOptionExplanationsByOptionId": {
                "greater_mid": "That lies outside the ordered left-half range."
              },
              "omittedCorrectExplanationsByOptionId": {
                "at_left": "The left endpoint is included.",
                "strict_inside": "The target lies strictly inside the ordered range.",
                "at_mid": "Mid itself is part of the left half and should be returned."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-012",
            "prompt": "Which test cases are important for rotated-array search? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "no_rotation",
                  "text": "No rotation."
                },
                {
                  "id": "pivot_edges",
                  "text": "Pivot near the first or last position."
                },
                {
                  "id": "singleton_absent",
                  "text": "Singleton hit and miss cases."
                },
                {
                  "id": "only_middle_hit",
                  "text": "Only one case where target begins at the first midpoint."
                }
              ],
              "acceptedOptionIds": [
                "no_rotation",
                "pivot_edges",
                "singleton_absent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Rotated search needs structural edge cases, not just a midpoint equality case.",
              "details": "Absent targets should also be represented across these shapes.",
              "wrongOptionExplanationsByOptionId": {
                "only_middle_hit": "This does not exercise structural branch logic."
              },
              "omittedCorrectExplanationsByOptionId": {
                "no_rotation": "The algorithm should reduce to classic search.",
                "pivot_edges": "These stress highly unbalanced ordered halves.",
                "singleton_absent": "They test minimal interval handling."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-013",
            "prompt": "Which statements are correct when duplicates are allowed? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "ordered_half_ambiguous",
                  "text": "Equal endpoint and midpoint values can make the ordered half ambiguous."
                },
                {
                  "id": "shrink_boundaries",
                  "text": "A correct strategy may shrink equal boundaries before continuing."
                },
                {
                  "id": "worst_linear",
                  "text": "Worst-case time may degrade to O(n)."
                },
                {
                  "id": "always_log",
                  "text": "The search is always O(log n) despite arbitrary duplicates."
                }
              ],
              "acceptedOptionIds": [
                "ordered_half_ambiguous",
                "shrink_boundaries",
                "worst_linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Duplicates weaken the structural information used for half elimination.",
              "details": "The algorithm can remain correct but may lose logarithmic worst-case progress.",
              "wrongOptionExplanationsByOptionId": {
                "always_log": "An all-equal interval disproves this guarantee."
              },
              "omittedCorrectExplanationsByOptionId": {
                "ordered_half_ambiguous": "The pivot cannot be localized from equality.",
                "shrink_boundaries": "This removes redundant ambiguity while preserving possible targets.",
                "worst_linear": "Repeated one-step shrinking can be linear."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-014",
            "prompt": "Arrange one distinct-value rotated-array search iteration.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_mid",
                  "text": "Return if nums[mid] equals target."
                },
                {
                  "id": "identify_ordered",
                  "text": "Determine whether the left or right half is ordered."
                },
                {
                  "id": "test_target_range",
                  "text": "Check whether target lies inside the ordered half's endpoint range."
                },
                {
                  "id": "retain_side",
                  "text": "Retain that half if target is inside; otherwise retain the other half."
                }
              ],
              "canonicalOrder": [
                "check_mid",
                "identify_ordered",
                "test_target_range",
                "retain_side"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Exact match is resolved first, then local order supports a range-based discard decision.",
              "details": "Every mismatch iteration removes mid and one impossible region."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-015",
            "prompt": "Arrange the branch logic when the left half is ordered and mid is not target.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "confirm_left_order",
                  "text": "Establish nums[left] <= nums[mid]."
                },
                {
                  "id": "check_range",
                  "text": "Test nums[left] <= target < nums[mid]."
                },
                {
                  "id": "inside_move_right",
                  "text": "If inside, set right = mid - 1."
                },
                {
                  "id": "outside_move_left",
                  "text": "Otherwise set left = mid + 1."
                }
              ],
              "canonicalOrder": [
                "confirm_left_order",
                "check_range",
                "inside_move_right",
                "outside_move_left"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The ordered-half endpoint range determines whether it can contain target.",
              "details": "The strict upper comparison excludes the already-checked midpoint."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
            "id": "alg-binary-search-rotated-016",
            "prompt": "Arrange a duplicate-ambiguity branch when nums[left] == nums[mid] == nums[right] and mid is not target.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "recognize_ambiguity",
                  "text": "Recognize that neither half can be proven ordered from the equality."
                },
                {
                  "id": "discard_equal_endpoints",
                  "text": "Increment left and decrement right after confirming those endpoint values are not target."
                },
                {
                  "id": "preserve_interior",
                  "text": "Keep the unresolved interior interval."
                },
                {
                  "id": "continue",
                  "text": "Repeat structural analysis on the smaller interval."
                }
              ],
              "canonicalOrder": [
                "recognize_ambiguity",
                "discard_equal_endpoints",
                "preserve_interior",
                "continue"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Equal nonmatching endpoints can be removed without losing target, but only limited progress is guaranteed.",
              "details": "This branch preserves correctness while explaining possible linear degradation."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_ordered_half_in_rotated_input",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "rotated_array_search",
              "problemArchetypeId": "search_rotated_sequence"
            }
          },
          {
