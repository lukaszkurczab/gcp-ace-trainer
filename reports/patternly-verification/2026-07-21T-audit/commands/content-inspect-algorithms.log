            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_repeated_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-repeated-021",
            "prompt": "Each key comparison costs C. A stable sorted array receives q exact queries. Compare q binary searches with q linear scans.",
            "constraints": [
              "Binary search performs O(log n) comparisons per query.",
              "A scan performs O(n) comparisons per query in the worst case."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "binary_time",
                "scan_time"
              ],
              "availableValuesByDimension": {
                "binary_time": [
                  "O(q log n)",
                  "O(qC log n)",
                  "O(qnC)",
                  "O(C log q)"
