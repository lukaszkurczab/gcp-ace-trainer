          {
            "id": "alg-sw-complexity-frequency-space",
            "prompt": "A longest at-most-K-distinct window uses a hash map of frequencies. Assume expected O(1) hash operations and no more than K+1 keys during a transient violation. Select its expected time and extra-space complexities.",
            "constraints": [
              "Both boundaries move only forward.",
              "The map stores only keys currently represented in the window and removes zero-count keys."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n)",
                  "O(n log n)",
                  "O(n^2)"
                ],
                "space": [
                  "O(1)",
                  "O(K)",
                  "O(n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "space": [
                  "O(K)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {},
                "space": {
                  "O(k)": "O(K)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Monotone boundary movement gives expected O(n) time, while the active frequency map contains O(K) distinct keys.",
              "details": "Each element enters once and leaves at most once, so the number of expected constant-time map operations is linear. After repair there are at most K keys; immediately after adding a new distinct key there may be K+1, which is still O(K). Thus extra state is O(K), bounded by O(min(n, alphabetSize)) in concrete domains. If the alphabet is a fixed constant, the asymptotic space can be described as O(1), but under variable K the declared contract is O(K)."
            },
            "taxonomy": {
