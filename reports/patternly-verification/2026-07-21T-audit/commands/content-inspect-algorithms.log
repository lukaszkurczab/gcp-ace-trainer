        },
        "items": [
          {
            "id": "alg-ctpsw-pmwvr-01",
            "prompt": "Which explanation correctly contrasts the movement rule of a pair-oriented two-pointers scan with the validity rule of a variable sliding window?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "proof_contrast",
                  "text": "Two pointers move an endpoint when the endpoint relation proves some pairs impossible; a window moves left while the maintained range violates a repairable predicate."
                },
                {
                  "id": "direction_contrast",
                  "text": "Two pointers move in opposite directions; a window moves in the same direction."
                },
                {
                  "id": "speed_contrast",
                  "text": "Two pointers move one index per iteration; a window may move several."
                },
                {
                  "id": "state_count_contrast",
                  "text": "Two pointers use no auxiliary state; a window always uses a hash map."
                }
              ],
              "acceptedOptionIds": [
                "proof_contrast"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The classification follows the proof that makes a boundary move safe.",
              "details": "A pointer update is not self-justifying. In a pair scan, the endpoint comparison must show that keeping one endpoint cannot produce a valid pair with any remaining partner, so that endpoint can be discarded. In a variable window, the maintained range becomes invalid and left advances because removing old members can restore the predicate without losing a better candidate. Direction, movement frequency, and data-structure choice are implementation details that vary across problems. The proof obligation is the stable transfer rule.",
              "wrongOptionExplanationsByOptionId": {
                "direction_contrast": "Same-direction two-pointers scans exist, so direction is not a reliable family boundary.",
                "speed_contrast": "Either family may move a boundary multiple times across one outer step. Movement frequency does not identify the invariant.",
                "state_count_contrast": "Two-pointers solutions may carry state, and many windows need only a scalar aggregate. The kind of invariant matters."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_pointer_move_and_window_validity_invariants",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "Compare the proof obligation for a boundary move; do not infer the family from pointer direction."
            ]
          },
          {
            "id": "alg-ctpsw-pmwvr-02",
            "prompt": "Order the conceptual steps for processing one new right endpoint in a variable window whose answer is defined only for valid windows.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "include_right",
                  "text": "Include the new right element in the maintained window state."
                },
                {
                  "id": "repair_validity",
                  "text": "While the window is invalid, remove the outgoing left element from state and then advance left."
                },
                {
                  "id": "record_answer",
                  "text": "Use the now-valid window to update the answer."
                }
              ],
              "canonicalOrder": [
                "include_right",
                "repair_validity",
                "record_answer"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "State must represent the expanded range before validity is tested, and the answer must be recorded only after repair.",
              "details": "The order preserves the representation invariant that the maintained state exactly matches [left, right]. First, the entering element becomes part of both the interval and its state. If that makes the range invalid, each shrink operation removes the old left member from state before advancing the boundary, so state and membership remain aligned. Only after the predicate is restored may the algorithm record a valid-range answer. Reversing these relations can score an invalid candidate or leave stale state associated with an element that has already exited."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_pointer_move_and_window_validity_invariants",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The answer may be updated only from valid windows.",
              "State must exactly represent the current inclusive interval."
            ]
          },
          {
            "id": "alg-ctpsw-pmwvr-03",
            "prompt": "Order the reasoning steps for one iteration of a sorted two-sum scan when the current pair is not the target.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "evaluate_pair",
                  "text": "Evaluate the current endpoint pair."
                },
                {
                  "id": "compare_target",
                  "text": "Determine whether its sum is below or above the target."
                },
                {
                  "id": "discard_endpoint",
                  "text": "Move the endpoint whose current value cannot participate in any remaining target pair under the sorted-order argument."
                }
              ],
              "canonicalOrder": [
                "evaluate_pair",
                "compare_target",
                "discard_endpoint"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The movement is legal only after the current relation and sorted-order elimination argument are established.",
              "details": "The current endpoints first define the candidate pair. Its comparison with the target determines which direction could improve the sum. Sorted order then turns that direction into a proof that one endpoint cannot be part of any still-unseen solution within the remaining domain. Moving before evaluating, or moving both endpoints without such a proof, can discard a valid pair. This sequence differs from a window loop because no validity state for the interior range is being repaired."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_pointer_move_and_window_validity_invariants",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Input is sorted in nondecreasing order.",
              "The current pair is known not to equal the target."
            ]
          },
          {
            "id": "alg-ctpsw-pmwvr-04",
            "prompt": "A stable in-place filter uses read to inspect each element and write to mark the next kept position. Both indices move left to right, and no state represents all elements between them. Which invariant class is present?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "read_write_two_pointers",
                  "text": "A same-direction two-pointers read/write invariant."
                },
                {
                  "id": "sliding_window",
                  "text": "A sliding-window validity invariant."
                },
                {
                  "id": "direction_decides",
                  "text": "A sliding window because both indices move in the same direction."
                }
              ],
              "acceptedOptionIds": [
                "read_write_two_pointers"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The indices have distinct read and write roles rather than bounding a maintained contiguous candidate.",
              "details": "The write index separates the compacted output prefix from unprocessed space, while read explores the input. Elements between the indices are not one candidate whose aggregate must stay valid; they are simply processed or pending positions. This is a two-pointers relation even though both indices move in the same direction. The transfer boundary is semantic: if [left, right] itself became the candidate and its members determined validity, the same directional motion could implement a window.",
              "wrongOptionExplanationsByOptionId": {
                "sliding_window": "There is no contiguous candidate bounded by the indices and no validity predicate repaired by shrinking.",
                "direction_decides": "Direction is only a surface cue. Same-direction read/write is a canonical two-pointers invariant."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_pointer_move_and_window_validity_invariants",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Kept elements preserve their original relative order.",
              "No aggregate or frequency state is maintained for the gap between read and write."
            ]
          },
          {
            "id": "alg-ctpsw-pmwvr-05",
            "prompt": "A proposed algorithm expands right and executes “while invalid: left += 1,” but it neither removes the outgoing element from state nor proves that advancing left moves the predicate toward validity. What is the correct diagnosis?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "invalid_invariant",
                  "text": "The code shape is insufficient; the window invariant and shrink legality are unproved."
                },
                {
                  "id": "valid_window_syntax",
                  "text": "It is a valid sliding window because it has an expand loop and a shrink loop."
                },
                {
                  "id": "two_pointers_by_indices",
                  "text": "It is automatically two pointers because left and right both move."
                },
                {
                  "id": "valid_pair_search",
                  "text": "It is a valid pair search because one endpoint is discarded."
                }
              ],
              "acceptedOptionIds": [
                "invalid_invariant"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary movement is legal only when state stays aligned and the discarded candidates are proved irrelevant.",
              "details": "A window loop must maintain state that exactly represents its current range, so advancing left normally requires removing the outgoing element. It must also establish that repeated removals can restore the predicate and that no discarded start could later become necessary for the objective. Without those facts, the loop is only pseudocode with familiar variable names. It is not rescued by relabeling it two pointers: pair-search movement also needs an elimination proof. The correct response is to reject the unproved invariant rather than infer a family from syntax.",
              "wrongOptionExplanationsByOptionId": {
                "valid_window_syntax": "An expand/shrink shape does not prove state correctness or monotone repair.",
                "two_pointers_by_indices": "Two moving indices do not establish a pair, read/write, or convergence invariant.",
                "valid_pair_search": "Discarding an endpoint is legal in pair search only when an ordering or relation proves all associated pairs impossible; no such proof is present here."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_pointer_move_and_window_validity_invariants",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "advanced",
            "constraints": [
              "No unstated property of the data may be assumed."
            ]
          },
          {
            "id": "alg-ctpsw-pmwvr-06",
            "prompt": "Select all statements that are valid proof obligations when distinguishing two pointers from sliding window.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "pair_elimination",
                  "text": "For a pair scan, moving an endpoint must rule out all skipped pairs that retain that endpoint."
                },
                {
                  "id": "window_repair",
                  "text": "For a variable window, removing left elements must restore or preserve a declared validity predicate without requiring discarded starts later."
                },
                {
                  "id": "direction_rule",
                  "text": "Opposite directions prove two pointers, and same direction proves sliding window."
                },
                {
                  "id": "variable_rule",
                  "text": "Exactly two index variables prove that one of the two families applies."
                }
              ],
              "acceptedOptionIds": [
                "pair_elimination",
                "window_repair"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Both accepted statements state why discarded candidates are safe to forget; direction and variable count do not.",
              "details": "Two-pointers correctness depends on an endpoint or read/write relation that justifies each movement. Sliding-window correctness depends on a candidate range, maintained state, and a shrink rule that safely removes starts until validity is restored or the fixed-size condition is met. These are independent proof obligations, and either can fail even when code uses conventional names. The transfer method is to identify the discarded candidates and the theorem that makes them permanently irrelevant.",
              "wrongOptionExplanationsByOptionId": {
                "direction_rule": "Direction is a heuristic, not a proof. Same-direction two pointers and fixed or unusual window traversals invalidate this rule.",
                "variable_rule": "Two indices can represent many algorithms, including neither family. The invariant is missing."
              },
              "omittedCorrectExplanationsByOptionId": {
                "pair_elimination": "Omitting this misses the core two-pointers proof: an endpoint move must eliminate skipped pair candidates safely.",
                "window_repair": "Omitting this misses the window proof: shrinkage must restore validity while making discarded starts unnecessary."
              }
            },
