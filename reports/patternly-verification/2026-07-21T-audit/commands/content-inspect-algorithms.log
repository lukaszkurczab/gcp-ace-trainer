      {
        "id": "alg-ctpsw-fsvws-01",
        "prompt": "Which state description is the decisive signal for a sliding window rather than an endpoint-pair two-pointers scan?",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "range_state",
              "text": "State such as a sum or frequency map that represents every element currently in [left, right]."
            },
            {
              "id": "endpoint_values",
              "text": "Only the current endpoint values and their relation."
            },
            {
              "id": "two_indices",
              "text": "Two integer indices named left and right."
            },
            {
              "id": "linear_loop",
              "text": "A loop that visits each position at most a few times."
            }
          ],
          "acceptedOptionIds": [
            "range_state"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
