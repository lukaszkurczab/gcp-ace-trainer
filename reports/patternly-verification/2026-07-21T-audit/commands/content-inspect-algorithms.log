            "id": "alg-linked-list-node-identity-03-duplicate-value-boundary",
            "difficulty": "introductory"
          },
          {
            "prompt": "A routine creates dummy(value=-1), sets dummy.next = head, performs link updates, and returns dummy.next. The problem contract says the result contains only the original data nodes that remain after the update. What role does dummy have?",
            "constraints": [
              "The returned pointer is dummy.next, not dummy.",
              "The output contract excludes implementation-only sentinels."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "scaffolding",
                  "text": "It is a separate scaffolding node and is not part of the returned logical list."
                },
                {
                  "id": "forces_value_minus_one",
                  "text": "It adds -1 to the logical result even though dummy.next is returned."
                },
                {
                  "id": "new_first_data",
                  "text": "It becomes the first logical data node because it points to head."
                },
                {
                  "id": "replaces_head_identity",
                  "text": "It changes the identity of every original node reachable from head."
                }
              ],
              "acceptedOptionIds": [
                "scaffolding"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Returning dummy.next excludes the sentinel itself while retaining the updated logical head.",
              "details": "The dummy node provides a stable predecessor before the original head. Its presence changes the implementation topology temporarily, not the output membership contract. Because the routine returns dummy.next, the sentinel is outside the result. A sentinel would count as logical data only if the public representation or problem contract explicitly said so.",
              "wrongOptionExplanationsByOptionId": {
                "new_first_data": "Pointing to the head makes dummy a predecessor, not automatically a logical element.",
                "replaces_head_identity": "Adding one predecessor does not replace or renumber the existing node objects.",
                "forces_value_minus_one": "The sentinel's payload is not reachable from the returned pointer dummy.next."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_node_identity_from_node_value",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "dummy_head",
              "problemArchetypeId": "remove_or_rewire_node"
            },
            "id": "alg-linked-list-node-identity-04-sentinel-not-logical-member",
            "difficulty": "introductory"
          },
          {
            "prompt": "Starting from head in a singly linked list, a routine follows next exactly k times to obtain the node object at zero-based position k. No auxiliary index is available. What are the time and extra-space costs in terms of k?",
            "constraints": [
              "The list is singly linked.",
              "No cached node array, skip links, or index is available."
            ],
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "extra_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log k)",
                  "O(k)",
                  "O(k^2)"
                ],
                "extra_space": [
                  "O(1)",
                  "O(k)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(k)"
                ],
                "extra_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {},
                "extra_space": {}
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "A singly linked list exposes only the next reference, so reaching position k requires k link traversals and constant auxiliary state.",
              "details": "There is no address calculation that jumps directly from head to the kth node. The routine must observe each intervening node reference, producing O(k) time. Only the current pointer and a counter are needed, so extra space is O(1). An external index could change the access cost, but that would be an additional data structure, not an intrinsic linked-list property."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_node_identity_from_node_value",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "pointer_rewiring",
              "problemArchetypeId": "find_middle_node"
            },
            "id": "alg-linked-list-node-identity-05-kth-node-traversal-cost",
            "difficulty": "intermediate"
          },
          {
            "prompt": "List X is X1(value=2) -> X2(value=5). List Y is Y1(value=2) -> Y2(value=5). Every Xi and Yi is a separately allocated node. Which conclusion is correct?",
            "constraints": [
              "Each named node is separately allocated.",
              "No next reference crosses between the two lists."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "identity_undefined",
                  "text": "Node identity cannot be determined once payloads are equal."
                },
                {
                  "id": "share_both_nodes",
                  "text": "The lists share both nodes because corresponding values match."
                },
                {
                  "id": "share_tail",
                  "text": "The lists share their tails because X2.value equals Y2.value."
                },
                {
                  "id": "same_values_distinct_nodes",
                  "text": "The lists have equal value sequences but share no nodes."
                }
              ],
              "acceptedOptionIds": [
                "same_values_distinct_nodes"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Separate allocation gives X1, X2, Y1, and Y2 distinct identities even when their payload sequences match.",
              "details": "Content equality and structural sharing are different properties. The two lists produce the same values during traversal, but no pointer from one list reaches a node object owned by the other. An intersection test must compare references. Conversely, a content-comparison task may intentionally compare values and ignore identity; the problem contract decides which relation matters.",
              "wrongOptionExplanationsByOptionId": {
                "share_both_nodes": "Matching values do not undo separate allocation or create shared references.",
                "share_tail": "Tail sharing requires X2 and Y2 to be the same object, not merely equal-valued objects.",
                "identity_undefined": "Identity remains well-defined independently of payload equality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_node_identity_from_node_value",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_lists",
              "problemArchetypeId": "merge_ordered_lists"
            },
            "id": "alg-linked-list-node-identity-06-equal-values-not-same-node",
            "difficulty": "intermediate"
          },
          {
            "prompt": "A routine has prev pointing to the predecessor of the node to remove. It must unlink that node and then log the exact removed node object. Order the operations so the victim identity and successor are preserved.",
            "constraints": [
              "prev.next is the only current reference to the victim.",
              "The victim's next field is the only current reference to its successor."
            ],
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "capture_victim",
                  "text": "Set victim = prev.next."
                },
                {
                  "id": "capture_successor",
                  "text": "Set successor = victim.next."
                },
                {
                  "id": "bypass_victim",
                  "text": "Set prev.next = successor."
                },
                {
                  "id": "log_identity",
                  "text": "Log victim by reference identity."
                }
              ],
              "canonicalOrder": [
                "capture_victim",
                "capture_successor",
                "bypass_victim",
                "log_identity"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The routine must capture the victim and its successor before bypassing the victim, then it can log the preserved reference.",
              "details": "The adjacent relations encode the dependency chain: victim must be known before victim.next can be read; successor must be known before prev.next is overwritten; and the preserved victim reference is logged after the structural mutation. Changing this order can lose the exact node or its successor when no other reference exists. If both references were already held elsewhere, the dependency could be weaker, but that is outside the stated state."
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_node_identity_from_node_value",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "pointer_rewiring",
              "problemArchetypeId": "remove_or_rewire_node"
            },
            "id": "alg-linked-list-node-identity-07-preserve-victim-reference-order",
            "difficulty": "advanced"
          },
          {
            "prompt": "Original suffix S is S1(value=8) -> S2(value=9). A builder creates C1(value=8) -> C2(value=9) by allocating new nodes and copying values. Another list points directly to S1. Which statement distinguishes the two suffixes?",
            "constraints": [
              "C1 and C2 are newly allocated.",
              "The other list stores the existing reference S1."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "copy_not_shared",
                  "text": "C and S are value-equivalent, but only the list pointing to S1 shares S's node identities."
                },
                {
                  "id": "first_value_decides",
                  "text": "C1 and S1 are the same node because their first values match."
                },
                {
                  "id": "copy_is_shared",
                  "text": "C shares S because the values and link shape are equal."
                },
                {
                  "id": "allocation_irrelevant",
                  "text": "Allocation history is irrelevant to every linked-list question."
                }
              ],
              "acceptedOptionIds": [
                "copy_not_shared"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Copying payloads and shape creates an equivalent sequence, not shared node objects.",
              "details": "Structural sharing is about reusing references to existing nodes. The copied suffix has the same observable value sequence, yet mutating C1.next would not change S1.next because C1 and S1 are distinct objects. This transfer boundary is decisive for intersection and aliasing questions. It can be ignored only when the output contract intentionally treats lists as pure value sequences.",
              "wrongOptionExplanationsByOptionId": {
                "copy_is_shared": "Equal shape and values do not create reference sharing after new allocation.",
                "first_value_decides": "Payload equality cannot establish object identity.",
                "allocation_irrelevant": "Allocation and reference reuse are exactly what determine structural identity and aliasing."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_node_identity_from_node_value",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_lists",
              "problemArchetypeId": "merge_ordered_lists"
            },
            "id": "alg-linked-list-node-identity-08-copy-versus-shared-tail-transfer",
            "difficulty": "advanced"
          }
