              "normalizedAliasesByDimension": {
                "binary_time": {
                  "comparisons_times_cost": "O(qC log n)"
                },
                "scan_time": {
                  "all_comparisons_times_cost": "O(qnC)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Expensive comparisons multiply both strategies, while binary search reduces how many comparisons are needed.",
              "details": "The legality assumptions still precede this cost advantage."
