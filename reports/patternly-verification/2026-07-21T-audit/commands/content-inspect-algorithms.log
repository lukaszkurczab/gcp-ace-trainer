              "availableValuesByDimension": {
                "subset_count": [
                  "Θ(n)",
                  "Θ(2^n)",
                  "Θ(n!)",
                  "Θ(n²)"
                ],
                "output_volume": [
                  "Θ(2^n)",
                  "Θ(n·2^n)",
                  "Θ(n!)",
                  "Θ(n²)"
