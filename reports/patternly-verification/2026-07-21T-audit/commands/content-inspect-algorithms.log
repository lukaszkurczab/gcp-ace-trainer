        "items": [
          {
            "id": "alg-backtracking-base-contract-001",
            "prompt": "A permutation solver builds a path of chosen values. When is a complete permutation ready to record?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "path_length_n",
                  "text": "When path length equals n."
                },
                {
                  "id": "path_nonempty",
                  "text": "As soon as the path contains one value."
                },
                {
                  "id": "no_duplicate_value",
                  "text": "Whenever the last value differs from the previous value."
                },
                {
                  "id": "index_zero",
                  "text": "Only when the current index is zero."
                }
              ],
              "acceptedOptionIds": [
                "path_length_n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A permutation is complete only after every input position or value has been assigned exactly once.",
              "details": "The completion condition must reflect the result contract, not merely that some progress occurred.",
              "wrongOptionExplanationsByOptionId": {
                "path_nonempty": "A partial path is not a complete permutation.",
                "no_duplicate_value": "Local inequality does not establish completion.",
                "index_zero": "The index value does not define a completed assignment."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-base-contract-002",
            "prompt": "A combination solver chooses exactly k values. Which completion condition is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "path_length_k",
                  "text": "Record a result when the current path contains k values."
                },
                {
                  "id": "start_equals_n_only",
                  "text": "Record a result only when the candidate start reaches n."
                },
                {
                  "id": "first_choice",
                  "text": "Record immediately after the first choice."
                },
                {
                  "id": "no_choices",
                  "text": "Record whenever the current loop has no candidates."
                }
              ],
              "acceptedOptionIds": [
                "path_length_k"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The base case must encode the exact required output size.",
              "details": "Candidate exhaustion is a failure or dead-end condition unless the required number of values has already been selected.",
              "wrongOptionExplanationsByOptionId": {
                "start_equals_n_only": "The scan may reach n with fewer than k selected values.",
                "first_choice": "That records incomplete combinations when k is greater than one.",
                "no_choices": "A dead end may be incomplete and invalid."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-base-contract-003",
            "prompt": "A grid word search has matched wordIndex characters. When is success complete?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "word_index_length",
                  "text": "When wordIndex equals the target word length."
                },
                {
                  "id": "at_grid_edge",
                  "text": "Whenever the path reaches a grid edge."
                },
                {
                  "id": "visited_all_cells",
                  "text": "Only after every grid cell has been visited."
                },
                {
                  "id": "no_neighbors",
                  "text": "Whenever the current cell has no legal neighbor."
                }
              ],
              "acceptedOptionIds": [
                "word_index_length"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Success is defined by consuming the entire target, not by a geometric property of the grid.",
              "details": "Once all characters are matched, no further move is required.",
              "wrongOptionExplanationsByOptionId": {
                "at_grid_edge": "Grid position does not determine whether the word is fully matched.",
                "visited_all_cells": "The target may be shorter than the number of cells.",
                "no_neighbors": "A dead end is not success unless the word is complete."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
            "id": "alg-backtracking-base-contract-004",
            "prompt": "A partition solver processes a string using a start index and appends valid segments to a path. When is one full partition complete?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_equals_length",
                  "text": "When start equals the string length."
                },
                {
                  "id": "path_nonempty",
                  "text": "When the path contains at least one segment."
                },
                {
                  "id": "segment_valid",
                  "text": "Whenever the most recent segment is valid."
                },
                {
                  "id": "end_less_length",
                  "text": "When the next boundary is before the end."
                }
              ],
              "acceptedOptionIds": [
                "start_equals_length"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A partition is complete only when the chosen segments cover the entire input exactly.",
              "details": "Using an exclusive start boundary makes start == length the natural completion condition.",
              "wrongOptionExplanationsByOptionId": {
                "path_nonempty": "A non-empty path may still leave an unprocessed suffix.",
                "segment_valid": "One valid segment does not complete the entire input.",
                "end_less_length": "That indicates remaining input, not completion."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_search",
              "problemArchetypeId": "partition_sequence"
            }
          },
          {
            "id": "alg-backtracking-base-contract-005",
            "prompt": "A collect-all solver appends the current mutable path directly to results without copying it. What defect is likely?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "shared_reference",
                  "text": "Later mutations can change every stored result that refers to the same path object."
                },
                {
                  "id": "duplicate_values_removed",
                  "text": "Appending the path automatically removes duplicate values."
                },
                {
                  "id": "recursion_stops",
                  "text": "The recursion can no longer return."
                },
                {
                  "id": "path_becomes_sorted",
                  "text": "The stored path is automatically sorted."
                }
              ],
              "acceptedOptionIds": [
                "shared_reference"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A completed result must preserve a snapshot of the path at that moment.",
              "details": "When the same mutable path object is reused, result storage should receive a copy or another immutable representation.",
              "wrongOptionExplanationsByOptionId": {
                "duplicate_values_removed": "Appending does not deduplicate content.",
                "recursion_stops": "The reference bug does not prevent control flow.",
                "path_becomes_sorted": "No sorting occurs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-base-contract-006",
            "prompt": "A find-one solver discovers a valid complete branch. Which result action matches the contract?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "propagate_true",
                  "text": "Return success and propagate it through callers so the search can stop."
                },
                {
                  "id": "append_and_continue_all",
                  "text": "Always append the solution and continue exploring every branch."
                },
                {
                  "id": "undo_success",
                  "text": "Immediately erase the fact that success was found."
                },
                {
                  "id": "restart_root",
                  "text": "Restart the search from the root."
                }
              ],
              "acceptedOptionIds": [
                "propagate_true"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A boolean existence contract permits short-circuiting on the first complete valid branch.",
              "details": "The base case and recursive callers must agree on how success is represented and propagated.",
              "wrongOptionExplanationsByOptionId": {
                "append_and_continue_all": "That implements collect-all rather than find-one.",
                "undo_success": "Restoration does not mean discarding the result.",
                "restart_root": "The requested existence result is already known."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-base-contract-007",
            "prompt": "For a solver returning all subsets, what result should the empty input produce?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_empty_subset",
                  "text": "A collection containing one empty subset."
                },
                {
                  "id": "no_subsets",
                  "text": "An empty collection of subsets."
                },
                {
                  "id": "error",
                  "text": "An error because no choice can be made."
                },
                {
                  "id": "one_null_value",
                  "text": "A subset containing a null placeholder."
                }
              ],
              "acceptedOptionIds": [
                "one_empty_subset"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The empty construction is a valid completed subset when the task enumerates all subsets.",
              "details": "This illustrates why an empty input can correspond to one solution rather than zero solutions, depending on the result contract.",
              "wrongOptionExplanationsByOptionId": {
                "no_subsets": "The empty set is itself a valid subset.",
                "error": "Zero choices can still define one completed empty construction.",
                "one_null_value": "No placeholder is part of the mathematical result."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-base-contract-008",
            "prompt": "A partial assignment violates a mandatory constraint before all variables are assigned. How should that state be classified?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "failure_dead_end",
                  "text": "A failure state that returns without recording a result."
                },
                {
                  "id": "successful_completion",
                  "text": "A complete result because the branch cannot continue."
                },
                {
                  "id": "record_partial",
                  "text": "A result that should be recorded as a partial solution."
                },
                {
                  "id": "restart_all",
                  "text": "A signal to erase every result found so far."
                }
              ],
              "acceptedOptionIds": [
                "failure_dead_end"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Completion and dead-end conditions must not be conflated.",
              "details": "A branch can terminate because it is impossible, because it is complete, or because the result contract allows short-circuit success. Each case needs distinct behavior.",
              "wrongOptionExplanationsByOptionId": {
                "successful_completion": "Inability to continue does not imply validity.",
                "record_partial": "The contract requires complete valid assignments.",
                "restart_all": "One failed branch does not invalidate sibling results."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-base-contract-009",
            "prompt": "Why can placing a completion check only after generating children be incorrect?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "complete_state_may_have_no_child",
                  "text": "A complete state may need to be recorded before any further candidate loop runs."
                },
                {
                  "id": "children_always_empty",
                  "text": "Every complete state always has children."
                },
                {
                  "id": "base_cases_only_optimize",
                  "text": "Base cases affect only speed, never correctness."
                },
                {
                  "id": "recursion_no_return",
                  "text": "Recursive functions cannot return before a loop."
                }
              ],
              "acceptedOptionIds": [
                "complete_state_may_have_no_child"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A completed path is itself a result node and may intentionally have no outgoing choices.",
              "details": "Checking completion at function entry makes the contract explicit and prevents candidate generation from skipping terminal results.",
              "wrongOptionExplanationsByOptionId": {
                "children_always_empty": "Complete states often intentionally stop generating children.",
                "base_cases_only_optimize": "Incorrect base-case placement can omit or duplicate results.",
                "recursion_no_return": "They can and often should."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-base-contract-010",
            "prompt": "Which conditions can be legitimate backtracking base cases? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "complete_solution",
                  "text": "The partial state satisfies the full result contract."
                },
                {
                  "id": "impossible_state",
                  "text": "The partial state cannot lead to any valid completion."
                },
                {
                  "id": "find_one_success",
                  "text": "A requested find-one result has already been found."
                },
                {
                  "id": "branch_looks_large",
                  "text": "The branch appears expensive but may still contain valid solutions."
                }
              ],
              "acceptedOptionIds": [
                "complete_solution",
                "impossible_state",
                "find_one_success"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Backtracking termination can represent success, failure, or contract-driven short-circuiting.",
              "details": "Each base case needs a precise semantic outcome. An expensive-looking branch is not automatically removable.",
              "wrongOptionExplanationsByOptionId": {
                "branch_looks_large": "Cost alone is not a sound termination condition."
              },
              "omittedCorrectExplanationsByOptionId": {
                "complete_solution": "A valid completed state must be emitted or reported.",
                "impossible_state": "An impossible state terminates as failure.",
                "find_one_success": "Short-circuit contracts can terminate further search."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "constraints_and_pruning",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-base-contract-011",
            "prompt": "Which actions are required when recording a completed mutable path? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "copy_path",
                  "text": "Store a copy or immutable snapshot of the current path."
                },
                {
                  "id": "avoid_extra_choice",
                  "text": "Do not add an unrelated extra choice merely to mark completion."
                },
                {
                  "id": "follow_result_contract",
                  "text": "Either continue or short-circuit according to collect-all versus find-one semantics."
                },
                {
                  "id": "clear_all_results",
                  "text": "Clear previously recorded sibling results."
                }
              ],
              "acceptedOptionIds": [
                "copy_path",
                "avoid_extra_choice",
                "follow_result_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Recording must preserve the completed state and obey the requested result semantics.",
              "details": "Mutable path reuse and mismatched find-one versus collect-all behavior are common contract defects.",
              "wrongOptionExplanationsByOptionId": {
                "clear_all_results": "A new valid solution does not invalidate earlier solutions."
              },
              "omittedCorrectExplanationsByOptionId": {
                "copy_path": "A snapshot preserves the completed result.",
                "avoid_extra_choice": "The current path already represents the result.",
                "follow_result_contract": "The caller contract determines control flow after recording."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-base-contract-012",
            "prompt": "Which empty-input outcomes can be correct depending on the stated contract? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "one_empty_construction",
                  "text": "One empty construction for all-subsets or all-partitions style enumeration."
                },
                {
                  "id": "false_for_nonempty_target",
                  "text": "False when an empty board must match a non-empty target."
                },
                {
                  "id": "zero_assignments_if_variable_required",
                  "text": "Zero valid assignments when the contract requires assigning at least one missing variable."
                },
                {
                  "id": "always_error",
                  "text": "An error for every backtracking problem with empty input."
                }
              ],
              "acceptedOptionIds": [
                "one_empty_construction",
                "false_for_nonempty_target",
                "zero_assignments_if_variable_required"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Empty input has no universal answer across backtracking problems.",
              "details": "The correct result follows from the mathematical identity, completion condition, and target requirements.",
              "wrongOptionExplanationsByOptionId": {
                "always_error": "Empty-input semantics depend on the result contract."
