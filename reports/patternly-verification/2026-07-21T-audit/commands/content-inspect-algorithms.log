          {
            "id": "alg-contrast-window-prefix-queries-020",
            "prompt": "Each of q queries scans the entire n-value array. Compare direct scans with one prefix build and q scalar range queries. Select both total times.",
            "constraints": [
              "Prefix queries are O(1)."
            ],
            "difficulty": "foundational",
            "interaction": {
