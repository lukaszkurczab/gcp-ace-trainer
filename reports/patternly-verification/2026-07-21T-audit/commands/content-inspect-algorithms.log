        "items": [
          {
            "id": "alg-gt-signal-001",
            "prompt": "A service map lists direct communication links between services. The question asks whether service T can be reached from service S by following any number of links. What is the decisive problem structure?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "connected_state_search",
                  "text": "States connected by legal transitions, requiring graph traversal from S."
                },
                {
                  "id": "sort_services",
                  "text": "A sorting problem because service names can be ordered alphabetically."
                },
                {
                  "id": "binary_search",
                  "text": "A binary-search problem because the target service has a known name."
                },
                {
                  "id": "bfs_only",
                  "text": "A graph problem only if BFS is used, because BFS is always faster than DFS."
                }
              ],
              "acceptedOptionIds": [
                "connected_state_search"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The answer depends on following a relation from one state to other reachable states, which is the graph-traversal signal.",
              "details": "Services are vertices and communication links are edges. Reachability requires exploring the connected state space while preventing repeated processing. The decisive signal is not a graph keyword or the choice of BFS; it is the transitive relation created by legal links. If the output instead asked for alphabetical lookup, sorting or indexing would own the decision.",
              "wrongOptionExplanationsByOptionId": {
                "sort_services": "Alphabetical order does not preserve communication reachability; the links define the relevant structure.",
                "binary_search": "Binary search locates a key in an ordered collection; it does not follow arbitrary communication links.",
                "bfs_only": "Reachability is the graph signal; BFS and DFS are both valid full traversals when shortest distance is not requested."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_connected_state_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "adjacency_list",
              "problemArchetypeId": "traverse_connected_state"
            }
          },
          {
            "id": "alg-gt-signal-002",
            "prompt": "A puzzle state is a word. One move changes one character, and only dictionary words are legal. The task asks whether the start word can reach the target word. Which signal identifies the approach family?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "implicit_state_graph",
                  "text": "Each legal word is a state and each one-character move is an edge in an implicit graph."
                },
                {
                  "id": "string_scan",
                  "text": "It is only a string-scanning task because every state is text."
                },
                {
                  "id": "matrix_required",
                  "text": "It becomes graph traversal only after an adjacency matrix is built."
                },
                {
                  "id": "dequeue_marks_graph",
                  "text": "It is graph traversal only if visited states are marked when dequeued."
                }
              ],
              "acceptedOptionIds": [
                "implicit_state_graph"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Repeated legal transformations create an implicit state graph even though no edge list is provided.",
              "details": "The surface type—words—does not determine the algorithm family. The transition rule defines edges, and the reachability output requires search through those transitions. Neighbor generation can remain implicit, while a visited set prevents cycles. Marking policy affects correctness and work after the graph decision has already been made.",
              "wrongOptionExplanationsByOptionId": {
                "string_scan": "The answer depends on sequences of legal transformations, not on a single pass over one string.",
                "matrix_required": "A graph can be implicit; legal neighbors may be generated from the transition rule without a matrix.",
                "dequeue_marks_graph": "Visited timing is an implementation invariant, not the signal that states and transitions form a graph."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_connected_state_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "graph_bfs",
              "problemArchetypeId": "shortest_unweighted_path"
            }
          },
          {
            "id": "alg-gt-signal-003",
            "prompt": "An unweighted transit map gives stations and direct rides. The task asks for the minimum number of rides from A to B. Which feature is decisive?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "unweighted_shortest_path",
                  "text": "Every ride has equal cost, so distance is the number of graph edges and BFS layers are relevant."
                },
                {
                  "id": "dfs_faster",
                  "text": "Use DFS because it dives to B sooner on average."
                },
                {
                  "id": "matrix_density",
                  "text": "Use an adjacency matrix because shortest paths require constant-time edge checks."
                },
                {
                  "id": "tree_path",
                  "text": "Treat the map as a tree and follow parent pointers because routes cannot cycle."
                }
              ],
              "acceptedOptionIds": [
                "unweighted_shortest_path"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equal-cost edges make the requested minimum ride count an unweighted shortest-path traversal problem.",
              "details": "BFS explores vertices in nondecreasing edge distance from the source, so first discovery gives the minimum number of rides when every edge costs one. The graph may be represented with lists or a matrix according to density; that is a separate decision. If rides have different costs, the transfer boundary changes to a weighted shortest-path algorithm rather than ordinary BFS.",
              "wrongOptionExplanationsByOptionId": {
                "dfs_faster": "DFS discovery order does not guarantee the fewest edges, and average intuition is not the stated answer contract.",
                "matrix_density": "Representation may vary; the equal edge-cost shortest-path contract is what selects layer-based traversal.",
                "tree_path": "A transit graph may contain cycles and multiple routes; tree assumptions are not provided."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_connected_state_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "graph_bfs",
              "problemArchetypeId": "shortest_unweighted_path"
            }
          },
          {
            "id": "alg-gt-signal-004",
            "prompt": "Tasks have prerequisite pairs, and the output must list every task after all of its prerequisites. Which graph-traversal signal matters most?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "dependency_order",
                  "text": "Directed dependencies impose a partial order, so topological processing is required."
                },
                {
                  "id": "ordinary_reachability",
                  "text": "Any BFS or DFS visitation order is valid because all tasks only need to be reached."
                },
                {
                  "id": "fastest_traversal",
                  "text": "Choose BFS because it is always faster than DFS and therefore creates the correct order."
                },
                {
                  "id": "undirected_tree",
                  "text": "Drop edge directions and treat prerequisites as an undirected tree."
                }
              ],
              "acceptedOptionIds": [
                "dependency_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The output is not merely a reachable set; it must respect directed prerequisite constraints.",
              "details": "Model each prerequisite p for task t as a directed edge p → t. A legal result is a topological order, commonly produced by indegree processing or DFS postorder with cycle handling. Ordinary BFS or DFS can visit every task yet place a dependent before a prerequisite. This item stays at the recognition boundary; the mechanics of indegree updates belong to the topological-order unit.",
              "wrongOptionExplanationsByOptionId": {
                "ordinary_reachability": "Reachability alone does not guarantee that every prerequisite appears before its dependent task.",
                "fastest_traversal": "Runtime preference does not enforce the dependency invariant; both naive visitation orders can violate it.",
                "undirected_tree": "Direction carries the prerequisite meaning; removing it destroys the ordering contract and cycles may exist."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_connected_state_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "topological_order_intro",
              "problemArchetypeId": "order_dependencies"
            }
          },
          {
            "id": "alg-gt-signal-005",
            "prompt": "An array of integers is given, and the task asks for the maximum sum of one contiguous subarray. No relation between arbitrary indices is defined. Which classification is correct?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "not_graph_signal",
                  "text": "This is not a graph-traversal signal; the key structure is a contiguous sequence and a running-state decision."
                },
                {
                  "id": "index_graph",
                  "text": "Treat every index as a vertex and adjacent indices as edges, then run BFS."
                },
                {
                  "id": "matrix_graph",
                  "text": "Build an adjacency matrix of index pairs to avoid missing subarrays."
                },
                {
                  "id": "tree_rules",
                  "text": "Treat the array as a rooted tree because each index has a next index."
                }
              ],
              "acceptedOptionIds": [
                "not_graph_signal"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A graph model is not useful merely because positions can be connected; the decisive invariant is contiguous accumulation.",
              "details": "Pattern recognition must reject over-modeling. The task has a linear sequence and an optimization state that can be updated while scanning. Converting adjacent indices into a graph is mathematically possible but diagnostically unhelpful because traversal does not determine the answer. Graph traversal becomes relevant when arbitrary state transitions or connectivity drive the output.",
              "wrongOptionExplanationsByOptionId": {
                "index_graph": "Although any sequence can be modeled as a path graph, that representation does not expose the maximum-sum invariant and adds no useful traversal decision.",
                "matrix_graph": "The output depends on contiguous accumulation, not arbitrary edge membership; quadratic graph storage is irrelevant.",
                "tree_rules": "A forced tree analogy does not match the optimization state or answer contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_connected_state_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "adjacency_list",
              "problemArchetypeId": "traverse_connected_state"
            }
          },
          {
            "id": "alg-gt-signal-006",
            "prompt": "The input declares all users and friendship pairs. The task asks how many separate friendship groups exist, including users with no friendships. What signal determines the overall traversal shape?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "all_components",
                  "text": "The whole vertex set must be scanned, starting a traversal from each still-unvisited user."
                },
                {
                  "id": "one_source",
                  "text": "Run one BFS from the first listed user; BFS is always faster and will find every group."
                },
                {
                  "id": "mark_on_dequeue",
                  "text": "Start from every user but count a group only when the start is dequeued, because dequeue marking is equivalent."
                },
                {
                  "id": "tree_parent",
                  "text": "Use one parent per user and omit a visited set because friendship groups behave like trees."
                }
              ],
              "acceptedOptionIds": [
                "all_components"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Counting groups requires whole-graph coverage, not a single-source reachable set.",
              "details": "Every declared user is a vertex, including isolated users. The outer scan detects a new component when it finds an unvisited vertex, increments the count once, and traverses that entire component. BFS and DFS are both valid inner traversals. This item recognizes the component-count shape; the exact count invariant belongs to the connected-components unit.",
              "wrongOptionExplanationsByOptionId": {
                "one_source": "One traversal reaches only the first user’s component, regardless of BFS speed.",
                "mark_on_dequeue": "Late marking can admit duplicate frontier entries; the component count is tied to choosing an unseen start before traversal.",
                "tree_parent": "General friendship graphs can contain cycles; tree traversal rules do not apply unchanged."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_connected_state_search",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "connected_components",
              "problemArchetypeId": "count_components"
            }
          }
        ],
