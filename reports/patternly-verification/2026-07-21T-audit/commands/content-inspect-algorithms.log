          {
            "id": "alg-mg-int-safe-square-root-loop-guard",
            "prompt": "For a nonnegative signed 64-bit n, trial division tests candidate d while d is at most sqrt(n). Which loop guard avoids both d*d overflow and floating-point boundary error?",
            "constraints": [
              "d is positive.",
              "Integer division uses the same nonnegative domain."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "division_guard",
                  "text": "Continue while d <= n / d."
                },
                {
                  "id": "square_guard",
                  "text": "Continue while d*d <= n in signed 64-bit."
                },
                {
                  "id": "sqrt_equality_guard",
                  "text": "Compute s = sqrt((double)n) and continue while d <= (long long)s."
                },
                {
                  "id": "strict_division_guard",
                  "text": "Continue while d < n / d."
                }
              ],
              "acceptedOptionIds": [
                "division_guard"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "For positive d and nonnegative n, d <= n/d is the integer-safe form of d*d <= n and includes the exact-square boundary.",
              "details": "The quotient guard avoids forming d*d and therefore cannot overflow for a valid positive divisor. It also uses integer semantics, so an exact square is not lost because sqrt rounded slightly downward. The non-strict inequality matters: when n=d*d, d can be a necessary factor. This transfer applies to any loop bounded by a product, although sign and zero preconditions must be re-proved before using a division rewrite.",
              "wrongOptionExplanationsByOptionId": {
                "square_guard": "Near the top of signed 64-bit, d*d can overflow even though the loop condition is mathematically meaningful.",
                "sqrt_equality_guard": "A floating square root can round at an integer boundary and is unnecessary for an exact integer loop guard.",
                "strict_division_guard": "The strict comparison skips d when n is exactly d*d, missing a square factor."
              }
            },
