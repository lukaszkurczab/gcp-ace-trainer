                  "O(log n)",
                  "O(n)",
                  "O(n!)"
                ]
              },
              "acceptedValuesByDimension": {
                "distinct_permutations": [
                  "n!/(c1!c2!...cm!)"
                ],
                "recursion_depth": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "distinct_permutations": {
                  "multiset_formula": "n!/(c1!c2!...cm!)"
                },
                "recursion_depth": {
                  "positions": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Equal-value swaps do not create new value sequences, reducing n! indexed permutations by multiplicity factorials.",
              "details": "A complete output still has n positions, so recursion depth remains linear."
            },
            "taxonomy": {
              "primarySkillAtomId": "prevent_duplicate_search_results",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "duplicate_control",
              "problemArchetypeId": "enumerate_permutations"
            }
          },
          {
            "id": "alg-backtracking-duplicates-016",
            "prompt": "An implementation generates all n! indexed permutations, copies each length-n path, and deduplicates them afterward, even though only u value-distinct permutations exist. Select an upper bound on generation-and-copy work and final output space.",
            "constraints": [
              "Every indexed permutation is generated before deduplication.",
              "Each generated path copy has length n."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "generation_work",
                "final_output_space"
              ],
              "availableValuesByDimension": {
                "generation_work": [
                  "O(n!)",
                  "O(n·n!)",
                  "O(un)",
                  "O(2^n)"
                ],
                "final_output_space": [
                  "O(1)",
                  "O(u)",
                  "O(un)",
                  "O(n·n!)"
                ]
              },
              "acceptedValuesByDimension": {
                "generation_work": [
                  "O(n·n!)"
                ],
                "final_output_space": [
                  "O(un)"
                ]
              },
              "normalizedAliasesByDimension": {
                "generation_work": {
                  "all_indexed_paths": "O(n·n!)"
                },
                "final_output_space": {
                  "unique_outputs": "O(un)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Post-hoc deduplication does not avoid generating and copying duplicate indexed paths.",
              "details": "The final retained outputs scale with u, but the wasted generation work still scales with n! paths."
            },
            "taxonomy": {
              "primarySkillAtomId": "prevent_duplicate_search_results",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "duplicate_control",
