      {
        "id": "alg-complexity-scaling-001",
        "prompt": "Why should an operation budget be stated explicitly instead of using a universal rule such as \"10^8 operations always fit\"?",
        "difficulty": "intro",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "model_dependent",
              "text": "Actual throughput depends on operation cost, language, hardware, memory behavior, and time limit."
            },
            {
              "id": "big_o_exact",
              "text": "Big-O already gives an exact runtime in seconds."
            },
            {
              "id": "names_determine",
              "text": "Variable names determine the machine speed."
            },
            {
              "id": "budget_unneeded",
              "text": "Constraints never influence algorithm choice."
            }
          ],
          "acceptedOptionIds": [
            "model_dependent"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "A rough budget is a modeling assumption, not a universal physical constant.",
          "details": "Content should state the abstract budget and what counts as one unit operation before comparing candidate algorithms.",
          "wrongOptionExplanationsByOptionId": {
            "big_o_exact": "Asymptotic notation omits constants and hardware.",
            "names_determine": "Names do not affect runtime.",
            "budget_unneeded": "Input limits are a primary design signal."
          }
        },
