        "items": [
          {
            "id": "alg-arrays-indexed-scans-001",
            "prompt": "An array has length n. Which indices are valid when n > 0?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero_to_n_minus_one",
                  "text": "0 through n - 1, inclusive."
                },
                {
                  "id": "one_to_n",
                  "text": "1 through n, inclusive."
                },
                {
                  "id": "zero_to_n",
                  "text": "0 through n, inclusive."
                },
                {
                  "id": "one_to_n_minus_one",
                  "text": "1 through n - 1, inclusive."
                }
              ],
              "acceptedOptionIds": [
                "zero_to_n_minus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A zero-indexed sequence of length n occupies positions 0 through n - 1.",
              "details": "The length counts elements, while the largest valid index is one less than that count. Index n is immediately outside the sequence.",
              "wrongOptionExplanationsByOptionId": {
                "one_to_n": "This skips index 0 and includes the invalid index n.",
                "zero_to_n": "Index n is outside a sequence containing exactly n elements.",
                "one_to_n_minus_one": "This excludes the valid first element at index 0."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-002",
            "prompt": "A loop compares array[i] with array[i + 1] for an array of length n. Which loop condition keeps both accesses valid?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "i_less_n_minus_one",
                  "text": "i < n - 1"
                },
                {
                  "id": "i_less_n",
                  "text": "i < n"
                },
                {
                  "id": "i_less_equal_n_minus_one",
                  "text": "i <= n - 1"
                },
                {
                  "id": "i_less_equal_n",
                  "text": "i <= n"
                }
              ],
              "acceptedOptionIds": [
                "i_less_n_minus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Because the loop reads i + 1, the largest legal i is n - 2.",
              "details": "The condition i < n - 1 produces i values from 0 through n - 2. On the final iteration, i + 1 equals n - 1, the last valid index.",
              "wrongOptionExplanationsByOptionId": {
                "i_less_n": "When i equals n - 1, the access at i + 1 becomes index n.",
                "i_less_equal_n_minus_one": "This also allows i = n - 1 and therefore reads index n.",
                "i_less_equal_n": "This permits multiple iterations with invalid accesses."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-003",
            "prompt": "A scan compares array[i - 1] with array[i]. At which index should i begin?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_one",
                  "text": "1"
                },
                {
                  "id": "start_zero",
                  "text": "0"
                },
                {
                  "id": "start_two",
                  "text": "2"
                },
                {
                  "id": "start_n_minus_one",
                  "text": "n - 1"
                }
              ],
              "acceptedOptionIds": [
                "start_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Starting at 1 makes i - 1 equal 0 on the first iteration.",
              "details": "Index 0 has no previous element. Starting at 1 covers the first adjacent pair, array[0] and array[1], without reading a negative index.",
              "wrongOptionExplanationsByOptionId": {
                "start_zero": "The first access to i - 1 would use index -1.",
                "start_two": "This is safe but skips the first adjacent pair.",
                "start_n_minus_one": "This inspects only the final pair instead of scanning all adjacent pairs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-004",
            "prompt": "A contiguous window has length w and starts at index start in an array of length n. Which condition states that the whole window is inside the array?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_plus_w_le_n",
                  "text": "start + w <= n"
                },
                {
                  "id": "start_plus_w_lt_n",
                  "text": "start + w < n"
                },
                {
                  "id": "start_plus_w_le_n_minus_one",
                  "text": "start + w <= n - 1"
                },
                {
                  "id": "start_le_n",
                  "text": "start <= n"
                }
              ],
              "acceptedOptionIds": [
                "start_plus_w_le_n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A window [start, start + w) is valid when its exclusive end does not exceed n.",
              "details": "The last included index is start + w - 1. Requiring start + w <= n is equivalent to requiring that last index to be at most n - 1.",
              "wrongOptionExplanationsByOptionId": {
                "start_plus_w_lt_n": "This incorrectly rejects the valid window whose exclusive end is exactly n.",
                "start_plus_w_le_n_minus_one": "This is one position too strict because start + w is an exclusive boundary.",
                "start_le_n": "A legal start alone does not guarantee that the remaining w elements fit."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-005",
            "prompt": "A linear scan uses `for (i = 0; i < n; i++)` and reads only array[i]. What happens when n = 0?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero_iterations",
                  "text": "The loop executes zero times, so no array access occurs."
                },
                {
                  "id": "reads_index_zero",
                  "text": "The loop executes once and reads array[0]."
                },
                {
                  "id": "reads_negative_one",
                  "text": "The loop reads array[-1]."
                },
                {
                  "id": "requires_special_iteration",
                  "text": "The loop must execute once to confirm the array is empty."
                }
              ],
              "acceptedOptionIds": [
                "zero_iterations"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The initial condition 0 < 0 is false, so the body is skipped.",
              "details": "A half-open scan from 0 to n naturally handles empty input when every access is inside the guarded loop body.",
              "wrongOptionExplanationsByOptionId": {
                "reads_index_zero": "The loop condition is checked before the first body execution.",
                "reads_negative_one": "The loop never computes or reads a negative index.",
                "requires_special_iteration": "Emptiness is already represented by the failed loop condition."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-006",
            "prompt": "How many adjacent pairs exist in an array of length n?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "max_zero_n_minus_one",
                  "text": "max(0, n - 1)"
                },
                {
                  "id": "n",
                  "text": "n"
                },
                {
                  "id": "n_plus_one",
                  "text": "n + 1"
                },
                {
                  "id": "always_one",
                  "text": "Exactly one"
                }
              ],
              "acceptedOptionIds": [
                "max_zero_n_minus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each adjacent pair connects one index to the next, producing n - 1 pairs when n is positive.",
              "details": "Lengths 0 and 1 contain no adjacent pair. For n >= 2, the pairs begin at indices 0 through n - 2, giving n - 1 pairs.",
              "wrongOptionExplanationsByOptionId": {
                "n": "The final element has no next element, so there are fewer pairs than elements.",
                "n_plus_one": "A pair count cannot exceed the number of boundaries between consecutive elements.",
                "always_one": "Arrays of length 0 or 1 have none, while longer arrays can have many."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-007",
            "prompt": "A reverse scan must visit every index of a non-empty array exactly once. Which index sequence is correct?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "n_minus_one_to_zero",
                  "text": "n - 1, n - 2, ..., 0"
                },
                {
                  "id": "n_to_zero",
                  "text": "n, n - 1, ..., 0"
                },
                {
                  "id": "n_minus_one_to_one",
                  "text": "n - 1, n - 2, ..., 1"
                },
                {
                  "id": "zero_to_n_minus_one",
                  "text": "0, 1, ..., n - 1"
                }
              ],
              "acceptedOptionIds": [
                "n_minus_one_to_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The last valid index is n - 1, and index 0 must still be included.",
              "details": "Starting at n would be out of bounds. Stopping at 1 would omit the first element.",
              "wrongOptionExplanationsByOptionId": {
                "n_to_zero": "Index n is outside the array.",
                "n_minus_one_to_one": "This skips the valid element at index 0.",
                "zero_to_n_minus_one": "This visits the same indices but in forward rather than reverse order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-008",
            "prompt": "A half-open range [start, end) is used to describe a slice. Which statements are correct? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "end_excluded",
                  "text": "Index end is excluded."
                },
                {
                  "id": "length_end_minus_start",
                  "text": "The range length is end - start."
                },
                {
                  "id": "empty_when_equal",
                  "text": "The range is empty when start equals end."
                },
                {
                  "id": "last_index_end",
                  "text": "The last included index is end."
                }
              ],
              "acceptedOptionIds": [
                "end_excluded",
                "length_end_minus_start",
                "empty_when_equal"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Half-open ranges include the lower bound and exclude the upper bound.",
              "details": "This convention makes length subtraction direct and represents an empty range without a special sentinel. When non-empty, the last included index is end - 1.",
              "wrongOptionExplanationsByOptionId": {
                "last_index_end": "The upper boundary is excluded, so end cannot be the last included index."
              },
              "omittedCorrectExplanationsByOptionId": {
                "end_excluded": "Excluding the upper bound is the defining property of a half-open range.",
                "length_end_minus_start": "The number of integer indices from start up to but not including end is end - start.",
                "empty_when_equal": "No integer index lies between equal lower and upper boundaries."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-009",
            "prompt": "A scan reads array[i - 1], array[i], and array[i + 1]. Which values of i are legal for an array of length n?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_through_n_minus_two",
                  "text": "1 through n - 2, inclusive."
                },
                {
                  "id": "zero_through_n_minus_one",
                  "text": "0 through n - 1, inclusive."
                },
                {
                  "id": "one_through_n_minus_one",
                  "text": "1 through n - 1, inclusive."
                },
                {
                  "id": "zero_through_n_minus_two",
                  "text": "0 through n - 2, inclusive."
                }
              ],
              "acceptedOptionIds": [
                "one_through_n_minus_two"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The left neighbor requires i >= 1, and the right neighbor requires i <= n - 2.",
              "details": "Both offset accesses constrain the center index. For n < 3, the legal range is empty.",
              "wrongOptionExplanationsByOptionId": {
                "zero_through_n_minus_one": "Both endpoints permit an invalid neighbor access.",
                "one_through_n_minus_one": "At i = n - 1, the right-neighbor access uses index n.",
                "zero_through_n_minus_two": "At i = 0, the left-neighbor access uses index -1."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-010",
            "prompt": "Which tests are especially important for finding index-boundary defects? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "empty_input",
                  "text": "Empty input."
                },
                {
                  "id": "single_element",
                  "text": "A one-element input."
                },
                {
                  "id": "minimum_valid_window",
                  "text": "An input exactly as long as the required neighborhood or window."
                },
                {
                  "id": "only_large_random",
                  "text": "Only one large random input."
                }
              ],
              "acceptedOptionIds": [
                "empty_input",
                "single_element",
                "minimum_valid_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary defects concentrate around the smallest legal and illegal input sizes.",
              "details": "Empty and singleton inputs test whether the loop should execute at all. An input exactly matching the required access width verifies the first and last legal iteration.",
              "wrongOptionExplanationsByOptionId": {
                "only_large_random": "A large random case may never isolate the exact first, last, or no-iteration boundary."
              },
              "omittedCorrectExplanationsByOptionId": {
                "empty_input": "It reveals unconditional first-element reads and loops that should execute zero times.",
                "single_element": "It distinguishes element scans from pair or neighborhood scans.",
                "minimum_valid_window": "It checks whether the implementation accepts exactly one legal placement without running past the end."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-011",
            "prompt": "A stable in-place compaction uses a read index and a write index. Which invariant keeps the next write inside the already processed prefix?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "write_le_read",
                  "text": "0 <= write <= read <= n"
                },
                {
                  "id": "read_le_write",
                  "text": "0 <= read <= write <= n"
                },
                {
                  "id": "write_equals_n",
                  "text": "write is always n"
                },
                {
                  "id": "read_negative",
                  "text": "read begins at -1 and remains negative until a value is retained"
                }
              ],
              "acceptedOptionIds": [
                "write_le_read"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The write boundary cannot move beyond the number of positions already read.",
              "details": "Every retained value comes from the processed prefix, so the count of written values is at most the count of processed values. This also prevents writing past the input length.",
              "wrongOptionExplanationsByOptionId": {
                "read_le_write": "This would permit writing positions that have not yet been justified by processed input.",
                "write_equals_n": "The write index should reflect retained output length, which can be smaller than n.",
                "read_negative": "A forward compaction scan can begin at index 0 without using a negative read position."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-012",
            "prompt": "A sorted array is collapsed in place so each distinct value appears once. Why does merely comparing adjacent values not complete the task?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "must_track_write_boundary",
                  "text": "The algorithm must also track where the next retained value is written and return the logical result length."
                },
                {
                  "id": "adjacent_values_never_equal",
                  "text": "Adjacent values in a sorted array can never be equal."
                },
                {
                  "id": "duplicates_removed_automatically",
                  "text": "No additional logic is needed because reading duplicates removes them automatically."
                },
                {
                  "id": "sorting_preserves_original_indices",
                  "text": "The only missing step is restoring every value to its original index."
                }
              ],
              "acceptedOptionIds": [
                "must_track_write_boundary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Detection and output-boundary maintenance are separate responsibilities.",
              "details": "Adjacent comparison identifies whether the current value differs from the previous retained value. The write index defines the valid compacted prefix and must advance only when a value is retained.",
              "wrongOptionExplanationsByOptionId": {
                "adjacent_values_never_equal": "Sorting groups equal values, so adjacent equality is exactly what the scan uses.",
                "duplicates_removed_automatically": "Reading or detecting a duplicate does not mutate the output by itself.",
                "sorting_preserves_original_indices": "Sorting generally changes original positions, and this contract concerns a sorted in-place result."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "in_place_duplicate_collapse",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-013",
            "prompt": "Arrange the steps for deriving a safe loop boundary from the indices used inside the loop.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "list_accesses",
                  "text": "List every indexed access made from the loop variable."
                },
                {
                  "id": "derive_constraints",
                  "text": "Require each accessed index to stay within 0 through n - 1."
                },
                {
                  "id": "intersect_constraints",
                  "text": "Intersect the lower and upper constraints on the loop variable."
                },
                {
                  "id": "test_extreme_iterations",
                  "text": "Check the first and last permitted iterations explicitly."
                }
              ],
              "canonicalOrder": [
                "list_accesses",
                "derive_constraints",
                "intersect_constraints",
                "test_extreme_iterations"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Safe bounds are derived from actual accesses rather than memorized loop templates.",
              "details": "Every offset such as i - 1 or i + 2 adds a constraint. Combining those constraints yields the legal interval, and checking its endpoints catches off-by-one mistakes."
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-014",
            "prompt": "Arrange the debugging checks for a suspected off-by-one error in an indexed scan.",
            "difficulty": "easy",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "identify_smallest_input",
                  "text": "Choose the smallest input for which the loop should execute."
                },
                {
                  "id": "trace_first_iteration",
                  "text": "Trace every index used on the first iteration."
                },
                {
                  "id": "trace_last_iteration",
                  "text": "Trace every index used on the last intended iteration."
                },
                {
                  "id": "check_one_smaller",
                  "text": "Check the next-smaller input, where the loop should execute fewer times or not at all."
                }
              ],
              "canonicalOrder": [
                "identify_smallest_input",
                "trace_first_iteration",
                "trace_last_iteration",
                "check_one_smaller"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Minimal boundary cases expose exactly when an iteration becomes legal or illegal.",
              "details": "Tracing the first and last legal iterations reveals bad offsets, while the next-smaller input verifies that the loop stops at the correct threshold."
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-015",
            "prompt": "An algorithm scans every adjacent pair in an array of length n and uses only a constant number of variables. Select its time and auxiliary-space complexity.",
            "constraints": [
              "Each adjacent pair is inspected once.",
              "No collection grows with n."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "linear": "O(n)"
                },
                "auxiliary_space": {
                  "constant": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "There are max(0, n - 1) adjacent pairs, and the working state does not grow with n.",
              "details": "Inspecting each pair once is linear. The fact that two array positions are read per iteration does not create a nested scan."
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-016",
            "prompt": "A function scans an array once and returns an array containing every index whose value is negative. If k indices are returned, select the time, auxiliary-space, and output-space complexity.",
            "constraints": [
              "Appending to the result is amortized O(1).",
              "No growing collection other than the returned result is used."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space",
                "output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(k)",
                  "O(n)",
                  "O(n log n)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(k)",
                  "O(n)"
                ],
                "output_space": [
                  "O(1)",
                  "O(k)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ],
                "output_space": [
                  "O(k)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "linear": "O(n)"
                },
                "auxiliary_space": {
                  "constant": "O(1)"
                },
                "output_space": {
                  "matching_indices": "O(k)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The scan visits n positions, while the collected indices are the required output rather than auxiliary state.",
              "details": "The loop uses constant working variables. The returned list grows with the number of matches, so its O(k) size is reported as output space."
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-017",
            "prompt": "A function must return original indices satisfying a condition. Why can sorting the array before scanning be invalid?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sorting_changes_index_meaning",
                  "text": "Sorting changes which value occupies each original index unless provenance is preserved."
                },
                {
                  "id": "sorting_never_scans",
                  "text": "Sorting prevents the array from being scanned afterward."
                },
                {
                  "id": "sorting_removes_duplicates",
                  "text": "Sorting automatically removes repeated values and shortens the array."
                },
                {
                  "id": "sorting_constant_time",
                  "text": "Sorting is invalid because it takes O(1) time."
                }
              ],
              "acceptedOptionIds": [
                "sorting_changes_index_meaning"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When original positions are part of the output contract, reordering changes the meaning of an index.",
              "details": "Sorting may still be legal if each value carries its original index and the later logic restores the required provenance. Sorting alone cannot ignore that contract.",
              "wrongOptionExplanationsByOptionId": {
                "sorting_never_scans": "A sorted array can still be scanned; the issue is preservation of original positions.",
                "sorting_removes_duplicates": "Sorting rearranges occurrences but does not remove them.",
                "sorting_constant_time": "Sorting is not generally constant time, but that is not the semantic defect here."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-018",
            "prompt": "A scan must inspect every block of exactly three consecutive elements. Which loop over the block's start index is correct?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_plus_three_le_n",
                  "text": "Start at 0 and continue while start + 3 <= n."
                },
                {
                  "id": "start_less_n",
                  "text": "Start at 0 and continue while start < n."
                },
                {
                  "id": "start_plus_three_lt_n",
                  "text": "Start at 0 and continue while start + 3 < n."
                },
                {
                  "id": "start_at_three",
                  "text": "Start at 3 and continue while start <= n."
                }
              ],
              "acceptedOptionIds": [
                "start_plus_three_le_n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The block occupies [start, start + 3), so its exclusive end may equal n.",
              "details": "The final legal start is n - 3. This includes exactly one block when n equals 3 and no blocks when n is smaller.",
              "wrongOptionExplanationsByOptionId": {
                "start_less_n": "This permits starts whose three-element block extends past the array.",
                "start_plus_three_lt_n": "This incorrectly excludes the valid final block ending exactly at n.",
                "start_at_three": "Starting at 3 skips the first block and misuses the block length as an initial index."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-019",
            "prompt": "Arrange the steps for deriving a safe start-index loop for accesses at start, start + 1, and start + 2.",
            "difficulty": "easy",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "identify_largest_offset",
                  "text": "Identify +2 as the largest offset from start."
                },
                {
                  "id": "bound_largest_access",
                  "text": "Require start + 2 <= n - 1."
                },
                {
                  "id": "rewrite_exclusive_end",
                  "text": "Rewrite the condition as start + 3 <= n."
                },
                {
                  "id": "test_minimum_length",
                  "text": "Verify that n = 3 permits exactly start = 0."
                }
              ],
              "canonicalOrder": [
                "identify_largest_offset",
                "bound_largest_access",
                "rewrite_exclusive_end",
                "test_minimum_length"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The largest indexed offset determines the upper boundary on the loop variable.",
              "details": "Converting the last included access into an exclusive-end condition makes the minimum legal input and final legal start explicit."
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-indexed-scans-020",
            "prompt": "Arrange the checks for tracing one candidate window [start, start + w) before reading its elements.",
            "difficulty": "easy",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "compute_end",
                  "text": "Compute the exclusive end start + w."
                },
                {
                  "id": "check_lower_bound",
                  "text": "Verify that start is at least 0."
                },
                {
                  "id": "check_upper_bound",
                  "text": "Verify that the exclusive end is at most n."
                },
                {
                  "id": "access_half_open",
                  "text": "Access indices start through start + w - 1."
                }
              ],
              "canonicalOrder": [
                "compute_end",
                "check_lower_bound",
                "check_upper_bound",
                "access_half_open"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Both window boundaries must be validated before any indexed access occurs.",
              "details": "The half-open representation separates the legal exclusive end from the final included index and avoids accepting a partial window."
            },
            "taxonomy": {
              "primarySkillAtomId": "track_index_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          }
        ],
