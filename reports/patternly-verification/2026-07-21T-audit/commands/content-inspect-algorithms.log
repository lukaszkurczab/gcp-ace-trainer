          {
            "id": "alg-gt-complexity-006",
            "prompt": "BFS marks a vertex visited only when dequeued and has no separate queued-state check. Duplicate copies are skipped when popped after the first processed copy. Which resource warning is justified for a simple adjacency-list graph?",
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frontier_can_grow_to_edges",
                  "text": "The result can remain correct, but up to O(E) queue entries may be generated, weakening the usual O(V) frontier bound."
                },
                {
                  "id": "always_identical",
                  "text": "Time and space are always identical to discovery-time marking because both eventually visit the same vertices."
                },
                {
                  "id": "must_be_quadratic",
                  "text": "The time is necessarily O(V²) for every graph."
                },
                {
                  "id": "matrix_fix",
                  "text": "Converting to an adjacency matrix restores one enqueue per vertex without changing visited timing."
                }
              ],
              "acceptedOptionIds": [
                "frontier_can_grow_to_edges"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each examined edge can publish another copy before the target's first dequeue, so queue-entry count is no longer bounded by vertices.",
              "details": "With discovery-time marking, each vertex is enqueued once and frontier storage is O(V). With late marking and a stale-copy guard, each adjacency exposure can produce an enqueue, giving O(E) queue operations and potentially O(E) queued entries while preserving O(V + E) order in a simple guarded implementation. If duplicate copies also rescan neighbors, work can grow further. Therefore dequeue marking is not universally operationally equivalent.",
              "wrongOptionExplanationsByOptionId": {
                "always_identical": "Final reachability does not capture duplicate enqueue operations or the larger frontier they can create.",
                "must_be_quadratic": "The exact penalty depends on graph structure and duplicate handling; O(V²) is not universal.",
                "matrix_fix": "Multiple predecessors can still observe an unmarked vertex before dequeue; representation does not supply queued state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_graph_traversal_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "graph_bfs",
              "problemArchetypeId": "traverse_connected_state"
            }
