      {
        "id": "alg-arrays-indexed-scans-011",
        "prompt": "A stable in-place compaction uses a read index and a write index. Which invariant keeps the next write inside the already processed prefix?",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "write_le_read",
              "text": "0 <= write <= read <= n"
            },
            {
              "id": "read_le_write",
              "text": "0 <= read <= write <= n"
            },
            {
              "id": "write_equals_n",
              "text": "write is always n"
            },
            {
              "id": "read_negative",
              "text": "read begins at -1 and remains negative until a value is retained"
            }
          ],
          "acceptedOptionIds": [
            "write_le_read"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "The write boundary cannot move beyond the number of positions already read.",
          "details": "Every retained value comes from the processed prefix, so the count of written values is at most the count of processed values. This also prevents writing past the input length.",
          "wrongOptionExplanationsByOptionId": {
