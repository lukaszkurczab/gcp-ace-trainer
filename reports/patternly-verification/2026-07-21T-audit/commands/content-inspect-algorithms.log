              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Strict descent proves a finite call sequence, while bounded stack capacity imposes an independent maximum practical depth.",
              "details": "The measure n decreases to zero, so the abstract computation has finite depth n + 1. Under ordinary call semantics, however, all ancestor frames remain live until the base returns. A runtime with a smaller stack limit can fail partway through that finite sequence. This is not logical nontermination; it is resource exhaustion. The transfer rule is to evaluate both obligations: prove progress for correctness, then compare maximum depth and per-frame cost with the execution environment or replace deep recursion with iteration.",
              "wrongOptionExplanationsByOptionId": {
                "base_guarantees_execution": "A termination proof does not guarantee sufficient runtime resources. O(n) simultaneous frames can exceed a fixed stack limit.",
                "overflow_means_nonterminating": "The transition can strictly decrease n and still exhaust finite memory before the terminal state is reached.",
                "runtime_converts_to_loop": "Such optimization is language- and implementation-dependent and cannot be assumed under the stated constraints."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "account_for_recursive_call_stack",
              "secondarySkillAtomIds": [],
