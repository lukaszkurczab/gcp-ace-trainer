        "items": [
          {
            "id": "alg-tp-signal-sorted-pair-elimination",
            "prompt": "A target-sum existence query receives values already ordered from smallest to largest, and original positions do not matter. Which property makes an opposite-ends scan diagnostically appropriate?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "target_is_numeric",
                  "text": "The target is numeric, so arithmetic comparisons are available."
                },
                {
                  "id": "boundary_elimination",
                  "text": "Comparing the smallest and largest remaining values lets one boundary value be eliminated after each mismatch."
                },
                {
                  "id": "two_indices_exist",
                  "text": "The answer can be written using two array indices."
                },
                {
                  "id": "sorted_implies_binary",
                  "text": "The array is sorted, so every useful solution must use binary search."
                }
              ],
              "acceptedOptionIds": [
                "boundary_elimination"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The decisive signal is monotonic candidate elimination at the two remaining extremes. A mismatch determines which boundary cannot participate in any valid remaining pair.",
              "details": "With a nondecreasing array, a sum below the target can only be increased by advancing the left boundary, while a sum above the target can only be decreased by retreating the right boundary. That relationship coordinates the pointers and shrinks one candidate region. Merely having two indices says nothing about legal movement, and sorted input alone does not prescribe binary search. The pattern transfers when boundary comparisons support a one-direction elimination rule; it does not transfer to arbitrary pair conditions.",
              "wrongOptionExplanationsByOptionId": {
                "two_indices_exist": "Two indices are only representation. Without a shared invariant and a movement rule that eliminates candidates, this could still be a nested-loop or unrelated indexed scan.",
                "sorted_implies_binary": "Sortedness enables several strategies. Binary search is appropriate only when a legal half-discard rule matches the query; here the pair relation supports coordinated extremes instead.",
                "target_is_numeric": "Arithmetic is not enough. The comparison must be monotonic with respect to pointer movement so that a boundary candidate can be discarded safely."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory",
            "constraints": [
              "The array is sorted in nondecreasing order.",
              "The two selected elements must have distinct positions.",
              "Original indices do not need to be returned."
            ]
          },
          {
            "id": "alg-tp-signal-both-ends-comparison",
            "prompt": "A sequence must be checked for mirror symmetry after normalization. At each step, only the current leftmost and rightmost unprocessed symbols are compared. Which structure makes two pointers appropriate?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "shrinking_symmetric_region",
                  "text": "Each successful comparison removes both verified endpoints from one shrinking unresolved region."
                },
                {
                  "id": "sequence_is_sorted",
                  "text": "The normalized sequence is sorted before comparison."
                },
                {
                  "id": "every_step_moves_both",
                  "text": "Any algorithm that moves both indices on every step is a two-pointer algorithm."
                },
                {
                  "id": "need_two_counters",
                  "text": "The implementation needs two counters for bookkeeping."
                }
              ],
              "acceptedOptionIds": [
                "shrinking_symmetric_region"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The pointers delimit one unresolved symmetric region, and an equal endpoint pair can be removed together. Sortedness is not required for this variant.",
              "details": "The invariant is that all positions outside the current boundaries have already been verified as matching mirror pairs. When the current endpoints match, advancing both pointers preserves that invariant and reduces the unresolved region. If they differ, the decision is complete immediately. Moving both happens to be valid here because both endpoints are jointly discharged, not because moving both is a universal two-pointer rule.",
              "wrongOptionExplanationsByOptionId": {
                "sequence_is_sorted": "Mirror comparison depends on symmetric position, not value order. Sorting would destroy the original positional relationship being checked.",
                "every_step_moves_both": "Movement is justified by the mirror invariant. In pair-sum or read/write variants, moving both on every step can skip candidates or corrupt the output boundary.",
                "need_two_counters": "Two counters do not establish a coordinated boundary invariant. The diagnostic signal is the shrinking unresolved region and the meaning of removing its endpoints."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "compare_from_both_ends"
            },
            "difficulty": "introductory",
            "constraints": [
              "Normalization is defined before the comparison begins.",
              "The original left-to-right order is semantically meaningful."
            ]
          },
          {
            "id": "alg-tp-signal-read-write-compaction",
            "prompt": "An array must be compacted in place so that values satisfying a predicate remain in their original relative order. Which signal most strongly indicates a same-direction read/write two-pointer design?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "predicate_is_boolean",
                  "text": "The predicate returns true or false."
                },
                {
                  "id": "scan_and_output_boundary",
                  "text": "One pointer scans every input position while another marks the next slot of the valid output prefix."
                },
                {
                  "id": "array_has_two_ends",
                  "text": "The array has a first and last index."
                },
                {
                  "id": "sorting_can_group",
                  "text": "Sorting could group accepted values before rejected values."
                }
              ],
              "acceptedOptionIds": [
                "scan_and_output_boundary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The read pointer consumes input while the write pointer represents the boundary of a stable compacted prefix. Their coordinated but unequal movement is the decisive structure.",
              "details": "Before each read step, positions before write contain exactly the accepted values seen so far in original order. The read pointer advances for every input value, while write advances only when the current value is kept. That conditional relationship is a two-pointer invariant even though both pointers move in the same direction. Sorting is neither required nor harmless when stability is part of the output contract.",
              "wrongOptionExplanationsByOptionId": {
                "array_has_two_ends": "Every array has endpoints; that does not imply coordinated pointer state. The useful signal is a scan pointer plus an output-prefix boundary.",
                "sorting_can_group": "Sorting adds cost and changes relative order. It would violate the stable compaction contract unless order were explicitly irrelevant.",
                "predicate_is_boolean": "A predicate alone does not select an algorithm. The in-place stable output boundary is what creates the read/write pointer structure."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "same_direction_read_write",
              "problemArchetypeId": "compact_sequence_in_place"
            },
            "difficulty": "introductory",
            "constraints": [
              "Compaction must be in place.",
              "Kept values must preserve relative order."
            ]
          },
          {
            "id": "alg-tp-signal-predicate-partition",
            "prompt": "A sequence must be rearranged so that every value satisfying predicate P appears before every value that fails P. Relative order inside each group is irrelevant. Which invariant is the clearest two-pointer signal?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "fixed_window",
                  "text": "A fixed-length contiguous window is maintained."
                },
                {
                  "id": "classified_prefix_suffix",
                  "text": "A left prefix is known to satisfy P, a right suffix is known to fail P, and only the middle remains unclassified."
                },
                {
                  "id": "full_sort_order",
                  "text": "The entire sequence must become numerically sorted."
                },
                {
                  "id": "two_nested_indices",
                  "text": "Two loop variables enumerate every pair of positions."
                }
              ],
              "acceptedOptionIds": [
                "classified_prefix_suffix"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Partitioning is driven by two classified regions and an unclassified middle. Pointer movement grows those regions until no middle remains.",
              "details": "The left scan skips values already on the correct side, and the right scan does the analogous work for failing values. When both stop on violations, swapping repairs two positions and grows the classified regions. This is a boundary-maintenance problem, not full sorting. Stability is a separate transfer boundary: an opposite-ends swap partition does not preserve within-group order.",
              "wrongOptionExplanationsByOptionId": {
                "full_sort_order": "Partitioning requires only a predicate boundary, not total order. Sorting performs more work and imposes a stronger output contract than needed.",
                "two_nested_indices": "Enumerating all pairs does not maintain classified regions or eliminate an unclassified interval. Two indices alone are not the pattern signal.",
                "fixed_window": "A fixed window represents a contiguous aggregate, not a growing true-prefix and false-suffix partition invariant."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "partition_scan",
              "problemArchetypeId": "partition_sequence"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Only the predicate partition is required.",
              "Relative order within each partition may change."
            ]
          },
          {
            "id": "alg-tp-signal-nested-indices-near-miss",
            "prompt": "A program uses loops `for i = 0..n-1` and `for j = i+1..n-1` to inspect every pair. Why is the presence of i and j not enough to classify the method as the two-pointers pattern?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers_requires_sorted",
                  "text": "Every two-pointer algorithm requires sorted input."
                },
                {
                  "id": "two_pointers_requires_opposite_ends",
                  "text": "Every two-pointer algorithm must start at opposite ends."
                },
                {
                  "id": "no_coordinated_elimination",
                  "text": "The indices enumerate combinations independently; one comparison does not justify discarding a monotonic candidate region."
                },
                {
                  "id": "needs_pointer_syntax",
                  "text": "The variables are integers rather than memory pointers."
                }
              ],
              "acceptedOptionIds": [
                "no_coordinated_elimination"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Two pointers is defined by coordinated state and legal candidate elimination, not by the number or type of index variables.",
              "details": "The nested loops revisit a quadratic set of pairs and neither index movement is justified by a shared invariant that removes future work. A genuine two-pointer design makes monotonic progress through a bounded candidate region or output boundary. Some variants require sorted input, while others use same-direction compaction or predicate partitioning. Variable names and pointer syntax are irrelevant to the classification.",
              "wrongOptionExplanationsByOptionId": {
                "needs_pointer_syntax": "Array indices can implement the pattern perfectly well. The issue is the movement semantics, not whether the language exposes raw pointers.",
                "two_pointers_requires_sorted": "Sortedness is required for some elimination rules, especially pair-sum search, but not for palindrome comparison, read/write compaction, or predicate partitioning.",
                "two_pointers_requires_opposite_ends": "Same-direction read/write and partition scans are also legal variants. Starting positions do not define the family by themselves."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-tp-signal-sliding-window-near-miss",
            "prompt": "A task asks for the longest contiguous subarray containing at most k rejected values. A left and right index bound the current subarray. Which classification is most precise?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "two_pointers_by_count",
                  "text": "It is automatically two pointers because two indices are visible."
                },
                {
                  "id": "opposite_ends",
                  "text": "It is an opposite-ends search because the indices are named left and right."
                },
                {
                  "id": "binary_search",
                  "text": "It is binary search because the feasible range length is monotonic."
                },
                {
                  "id": "window_validity",
                  "text": "This is primarily a sliding-window invariant: right expands the contiguous range and left shrinks it only when the range violates the at-most-k condition."
                }
              ],
              "acceptedOptionIds": [
                "window_validity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The decisive state is validity of one contiguous window, not elimination of candidate pairs or maintenance of a compacted output boundary.",
              "details": "Both families may use two indices, but the learning boundary is the invariant that governs movement. Here right adds one element to a contiguous range and left removes elements until the range is valid again. A pair-search pointer move instead eliminates a boundary candidate based on an ordered relation. Classify by maintained state and legal movement, not variable names.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers_by_count": "Two visible indices are not a diagnostic contract. The contiguous-window validity rule is the material mechanism in this task.",
                "opposite_ends": "The indices begin together and delimit a moving range; they do not start at global extremes and converge by candidate elimination.",
                "binary_search": "No midpoint or legal half-discard operation is being used. Possible monotonicity of answer length does not describe the implemented state transition."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-tp-signal-unsorted-pair-near-miss",
            "prompt": "An unsorted array must return original indices of a pair summing to a target. Mutation and copying are forbidden, but O(n) extra memory is allowed. Which signal blocks the standard opposite-ends two-pointer choice?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "target_sum",
                  "text": "A target-sum requirement never belongs to two pointers."
                },
                {
                  "id": "no_ordered_elimination",
                  "text": "Without an ordered value relation, a low or high sum cannot safely eliminate either boundary candidate."
                },
                {
                  "id": "original_indices_exist",
                  "text": "Returning indices always makes two pointers impossible."
                },
                {
                  "id": "extra_memory_allowed",
                  "text": "Allowing memory automatically forbids pointer methods."
                }
              ],
              "acceptedOptionIds": [
                "no_ordered_elimination"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The standard low/high movement rule depends on value order. Under the stated no-sort boundary, that correctness argument is unavailable.",
              "details": "In an unsorted array, the values at the physical ends are not the smallest and largest remaining candidates, so moving either pointer after a mismatch can discard a valid solution. A hash lookup can preserve original indices without mutation under the allowed memory budget. Returning indices does not categorically forbid sorting-based methods, but sorting would require a decorated copy or mutation, both excluded here. The decisive boundary is legal elimination, not the surface phrase ‘pair sum.’",
              "wrongOptionExplanationsByOptionId": {
                "original_indices_exist": "Indices can be preserved by sorting value-index pairs when copying or mutation is permitted. The present blocker is the combination of unsorted input and the no-sort constraints.",
                "extra_memory_allowed": "Memory availability broadens the strategy set; it does not prohibit pointer methods. It makes a hash-based alternative feasible here.",
                "target_sum": "Pair-sum on sorted input is a canonical opposite-ends use case. The missing ordered relation, not the objective itself, blocks it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Input is not sorted.",
              "The original array may not be mutated or copied.",
              "Original indices must be returned.",
              "O(n) auxiliary memory is allowed."
            ]
          },
          {
            "id": "alg-tp-signal-multi-scenario-signals",
            "prompt": "Select all scenarios that contain a material two-pointer signal under the stated contract.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "independent_prefix_suffix",
                  "text": "Compute independent prefix and suffix totals in two separate passes."
                },
                {
                  "id": "sorted_pair",
                  "text": "Find a target-sum pair in a nondecreasing array by eliminating one extreme after each mismatch."
                },
                {
                  "id": "stable_filter",
                  "text": "Compact accepted values in place while a read pointer scans and a write pointer marks the valid prefix."
                },
                {
                  "id": "predicate_partition",
                  "text": "Grow a predicate-true prefix and predicate-false suffix around an unclassified middle."
                },
                {
                  "id": "all_pairs",
                  "text": "Use two nested indices to enumerate every unordered pair without eliminating future candidates."
                }
              ],
              "acceptedOptionIds": [
                "sorted_pair",
                "stable_filter",
                "predicate_partition"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The accepted scenarios coordinate two boundaries through elimination, output-prefix maintenance, or partition-region maintenance. The rejected scenarios merely use multiple indices or passes.",
              "details": "Two-pointer recognition is mechanism-based. Opposite ends can shrink an ordered candidate region, read/write pointers can separate consumed input from produced output, and partition pointers can delimit classified and unclassified regions. Exhaustive pair enumeration has no monotonic elimination, while independent prefix and suffix passes do not form one coordinated state. The family includes multiple variants, but each needs a shared invariant that explains movement.",
              "wrongOptionExplanationsByOptionId": {
                "all_pairs": "Two nested indices enumerate combinations but do not make coordinated monotonic progress through one candidate region.",
                "independent_prefix_suffix": "The passes may each use an index, but their states are independent rather than two boundaries maintaining one invariant."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sorted_pair": "Omitting this scenario misses the canonical opposite-ends signal: ordered extrema make a mismatch eliminate one whole boundary candidate class. It is not merely 'two indices'.",
                "stable_filter": "Omitting this incorrectly narrows two pointers to opposite ends; same-direction read/write is a legal variant.",
                "predicate_partition": "Omitting this scenario misses a legal partition-scan signal: the pointers grow complementary classified regions around an unclassified middle. It is distinct from stable compaction."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-tp-signal-movement-depends-on-invariant",
            "prompt": "Which statement best describes pointer movement across the two-pointers family?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "movement_is_arbitrary",
                  "text": "Any deterministic movement schedule is sufficient because two pointers are present."
                },
                {
                  "id": "movement_is_variant_specific",
                  "text": "Each pointer moves only when the active invariant makes that move safe: one boundary may move, both may move, or a write pointer may stay fixed."
                },
                {
                  "id": "always_move_both",
                  "text": "Both pointers must move after every comparison."
                },
                {
                  "id": "always_converge",
                  "text": "All two-pointer variants start at opposite ends and converge."
                }
              ],
              "acceptedOptionIds": [
                "movement_is_variant_specific"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Pointer motion is a consequence of the maintained invariant, not a family-wide fixed schedule.",
              "details": "In sorted pair search, exactly one boundary usually moves after a mismatch. In palindrome comparison, both verified endpoints can move together. In stable compaction, read advances every step while write advances only for accepted values. Treating movement as a syntactic recipe loses the correctness boundary that defines each variant.",
              "wrongOptionExplanationsByOptionId": {
                "always_move_both": "Moving both can skip a valid pair or advance a write boundary over rejected input. It is valid only when both current positions have been jointly discharged.",
                "always_converge": "Same-direction read/write pointers and some partition scans do not fit the opposite-ends-only description.",
                "movement_is_arbitrary": "Determinism is not correctness. Every move must preserve the variant invariant and exclude only states that cannot affect the answer."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-tp-signal-recognition-check-sequence",
            "prompt": "Order the diagnostic checks used to decide whether a proposed two-pointer classification is structurally justified.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_progress",
                  "text": "Confirm monotonic progress and a boundary condition that terminates the scan."
                },
                {
                  "id": "justify_moves",
                  "text": "Verify that each proposed pointer move preserves the invariant and discards only irrelevant work."
                },
                {
                  "id": "state_invariant",
                  "text": "State what remains true about processed and unprocessed positions."
                },
                {
                  "id": "identify_region",
                  "text": "Identify the candidate region, output boundary, or classified regions represented by the indices."
                }
              ],
              "canonicalOrder": [
                "identify_region",
                "state_invariant",
                "justify_moves",
                "check_progress"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Recognition should proceed from state meaning to invariant, then movement legality, then termination. Starting from variable names or a memorized schedule cannot establish the pattern.",
              "details": "First determine what the indices delimit; otherwise their movement has no semantic meaning. The invariant then states what has already been established and what remains possible. Movement is legal only if it preserves that statement and removes no needed candidate. Finally, monotonic progress and a stopping boundary distinguish a bounded scan from cycling or exhaustive revisitation."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-tp-signal-sort-then-scan-cost",
            "prompt": "An unsorted array is sorted in place with a comparison sort taking O(n log n), then scanned once with opposite-end pointers. What is the end-to-end time complexity?",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)",
                  "O(n^2)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log n)"
                ]
              },
              "normalizedAliasesByDimension": {},
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "The linear pointer scan does not erase the preprocessing cost. Sorting dominates the end-to-end time.",
              "details": "The comparison sort performs O(n log n) work, after which the pointers visit the sequence in O(n). Adding the phases gives O(n log n + n), which simplifies to O(n log n). Calling the method ‘linear two pointers’ describes only the post-sort scan. This cost boundary matters when comparing against an expected-O(n) hash lookup or when the input is already sorted."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_coordinated_boundary_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "opposite_ends",
              "problemArchetypeId": "find_pair_in_sorted_input"
            },
            "difficulty": "introductory",
            "constraints": [
              "The comparison sort takes O(n log n).",
              "The subsequent pointer scan takes O(n)."
            ]
          },
          {
            "id": "alg-tp-signal-arbitrary-movement-rejection",
            "prompt": "A proposed algorithm keeps left and right indices and alternates moving them inward, regardless of the values seen. What evidence is still required before calling the movement a valid two-pointer strategy?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "single_loop",
                  "text": "A single loop, because one loop is sufficient proof of linear correctness."
                },
                {
                  "id": "both_indices_change",
                  "text": "A guarantee that both indices eventually change at least once."
                },
                {
                  "id": "invariant_and_elimination",
                  "text": "A stated invariant showing why each alternating move preserves correctness and eliminates only candidates that cannot affect the answer."
                },
                {
                  "id": "different_names",
                  "text": "Names other than left and right so the variables are not confused with binary search."
                }
              ],
              "acceptedOptionIds": [
                "invariant_and_elimination"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Pointer variables and deterministic motion are not a correctness argument. The move must follow from an invariant or monotonic relation.",
              "details": "A valid two-pointer method explains what candidate region or output boundary remains and why a particular move cannot discard a needed state. Alternating movement may happen to terminate while still skipping valid candidates. A single loop may bound operation count, but it does not prove the answer contract. The diagnostic boundary is whether movement is semantically licensed by the problem structure.",
              "wrongOptionExplanationsByOptionId": {
                "different_names": "Variable names do not change semantics. The missing element is a correctness relation between state and movement.",
                "single_loop": "One loop can be incorrect, quadratic through hidden work, or unrelated to two pointers. Loop count does not prove candidate elimination.",
                "both_indices_change": "Eventual movement proves neither safety nor completeness. A pointer may need to remain fixed until its boundary candidate is discharged."
              }
            },
