        "items": [
          {
            "id": "alg-binary-search-boundaries-001",
            "prompt": "A search uses a closed active interval [left, right]. Which loop condition processes a one-element interval?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "left_le_right",
                  "text": "left <= right."
                },
                {
                  "id": "left_lt_right",
                  "text": "left < right."
                },
                {
                  "id": "left_eq_right",
                  "text": "left == right only."
                },
                {
                  "id": "right_lt_left",
                  "text": "right < left."
                }
              ],
              "acceptedOptionIds": [
                "left_le_right"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A closed interval remains non-empty while left is less than or equal to right.",
              "details": "When left equals right, exactly one candidate remains and must still be examined.",
              "wrongOptionExplanationsByOptionId": {
                "left_lt_right": "This stops before processing the final candidate when left equals right.",
                "left_eq_right": "This skips all larger intervals.",
                "right_lt_left": "That describes an empty closed interval."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_binary_search_boundary_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "classic_index_search",
              "problemArchetypeId": "find_index_in_sorted_input"
            }
          },
          {
            "id": "alg-binary-search-boundaries-002",
            "prompt": "A search uses a half-open active interval [left, right). Which loop condition continues while at least one candidate remains?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "left_lt_right",
                  "text": "left < right."
                },
                {
                  "id": "left_le_right",
                  "text": "left <= right."
                },
                {
                  "id": "right_lt_left",
                  "text": "right < left."
                },
                {
                  "id": "left_eq_right",
                  "text": "left == right."
                }
              ],
              "acceptedOptionIds": [
                "left_lt_right"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A half-open interval is empty exactly when its boundaries are equal.",
              "details": "Its candidate count is right - left, so positive length corresponds to left < right.",
              "wrongOptionExplanationsByOptionId": {
                "left_le_right": "When left equals right, the half-open interval is empty.",
                "right_lt_left": "That is not the normal non-empty condition.",
                "left_eq_right": "This identifies the exit state, not the active state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_binary_search_boundary_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-boundaries-003",
            "prompt": "In a half-open first-true search, predicate(mid) is true and mid may be the first true index. Which update preserves mid as a candidate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "right_mid",
                  "text": "right = mid."
                },
                {
                  "id": "right_mid_minus_one",
                  "text": "right = mid - 1."
                },
                {
                  "id": "left_mid_plus_one",
                  "text": "left = mid + 1."
                },
                {
                  "id": "return_mid",
                  "text": "Return mid immediately."
                }
              ],
              "acceptedOptionIds": [
                "right_mid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The search seeks the leftmost true value, so a true midpoint belongs to the retained right boundary.",
              "details": "Using a half-open interval [left, right), setting right = mid keeps mid and discards only positions strictly to its right.",
              "wrongOptionExplanationsByOptionId": {
                "right_mid_minus_one": "This can discard the first true index itself.",
                "left_mid_plus_one": "This discards mid and every earlier candidate.",
                "return_mid": "A true midpoint may not be the first true position."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_binary_search_boundary_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-boundaries-004",
            "prompt": "A loop uses lower-biased mid = floor((left + right) / 2) and the update left = mid when the answer lies to the right. What risk exists when right = left + 1?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "infinite_loop",
                  "text": "mid equals left, so the interval may not shrink."
                },
