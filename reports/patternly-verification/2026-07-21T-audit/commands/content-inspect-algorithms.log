        "items": [
          {
            "id": "alg-arrays-duplicate-handling-001",
            "prompt": "A function must return every distinct value exactly once while preserving the order of first appearance. What is the correct output for [4, 2, 4, 3, 2]?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "first_occurrence_order",
                  "text": "[4, 2, 3]"
                },
                {
                  "id": "sorted_unique",
                  "text": "[2, 3, 4]"
                },
                {
                  "id": "unchanged_input",
                  "text": "[4, 2, 4, 3, 2]"
                },
                {
                  "id": "grouped_duplicates",
                  "text": "[4, 4, 2, 2, 3]"
                }
              ],
              "acceptedOptionIds": [
                "first_occurrence_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The contract removes repeated occurrences but preserves the position of each value's first occurrence.",
              "details": "The first 4 is retained and the later 4 is removed. The first 2 is retained and the later 2 is removed. The value 3 appears once. Sorting would produce the same set of values but would violate the required first-appearance order.",
              "wrongOptionExplanationsByOptionId": {
                "sorted_unique": "This removes duplicates but changes the required order of first appearance.",
                "unchanged_input": "This preserves order and multiplicity, but the contract requires every distinct value exactly once.",
                "grouped_duplicates": "Grouping equal values changes order and still preserves repeated occurrences."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-002",
            "prompt": "A filter removes all negative values but must preserve every remaining occurrence in its original order. What should it return for [2, -1, 2, 3, -1]?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "preserve_positive_multiplicity",
                  "text": "[2, 2, 3]"
                },
                {
                  "id": "deduplicate_positives",
                  "text": "[2, 3]"
                },
                {
                  "id": "sort_positives",
                  "text": "[2, 2, 3], because filtering also requires sorting"
                },
                {
                  "id": "keep_one_per_sign",
                  "text": "[2], because repeated positive values are redundant"
                }
              ],
              "acceptedOptionIds": [
                "preserve_positive_multiplicity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Filtering values does not imply deduplicating the values that remain.",
              "details": "Both occurrences of 2 satisfy the filter and therefore both remain. Duplicate behavior is controlled by the output contract, not automatically by the fact that a transformation is being performed.",
              "wrongOptionExplanationsByOptionId": {
                "deduplicate_positives": "This silently changes the multiplicity contract by retaining only one occurrence of 2.",
                "sort_positives": "The values happen to appear in sorted order here, but sorting is not part of the stated contract.",
                "keep_one_per_sign": "The contract operates on individual occurrences, not on categories such as positive and negative."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-003",
            "prompt": "Which requirements must be established before selecting a duplicate-handling strategy? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "multiplicity_requirement",
                  "text": "Whether the output keeps every occurrence, one occurrence, or a bounded number of occurrences."
                },
                {
                  "id": "order_requirement",
                  "text": "Whether original relative order must be preserved."
                },
                {
                  "id": "mutation_requirement",
                  "text": "Whether the input may be reordered or modified in place."
                },
                {
                  "id": "numeric_input_requirement",
                  "text": "Whether the values are numeric rather than textual."
                }
              ],
              "acceptedOptionIds": [
                "multiplicity_requirement",
                "order_requirement",
                "mutation_requirement"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Duplicate handling depends on multiplicity, ordering, and mutation guarantees.",
              "details": "The same input may require completely different solutions depending on whether duplicates are removed, counted, capped, grouped, or preserved. Sorting may be legal when order is irrelevant but illegal when stable order is required. In-place requirements also constrain the available transformations.",
              "wrongOptionExplanationsByOptionId": {
                "numeric_input_requirement": "The value type alone does not define the duplicate contract. Numbers and strings can both require any of the listed multiplicity and ordering behaviors."
              },
              "omittedCorrectExplanationsByOptionId": {
                "multiplicity_requirement": "Without the multiplicity rule, it is impossible to know whether repeated values should be preserved, removed, counted, or capped.",
                "order_requirement": "An algorithm that returns the correct distinct values may still be wrong if it changes a required relative order.",
                "mutation_requirement": "A strategy that sorts or rewrites the input may violate the contract even when its returned values are otherwise correct."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-004",
            "prompt": "A function must remove duplicates while preserving the relative order of the retained values. Why is sorting the input before removing adjacent duplicates not generally valid?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sorting_changes_order",
                  "text": "Sorting can change the relative order required by the output contract."
                },
                {
                  "id": "sorting_cannot_group_duplicates",
                  "text": "Sorting cannot place equal values next to each other."
                },
                {
                  "id": "sorting_always_quadratic",
                  "text": "Sorting is invalid because every sorting algorithm takes O(n²) time."
                },
                {
                  "id": "sorting_removes_values",
                  "text": "Sorting automatically removes some duplicate values before the scan."
                }
              ],
              "acceptedOptionIds": [
                "sorting_changes_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A transformation is legal only if it preserves every guarantee in the output contract.",
              "details": "Sorting makes equal values adjacent and can simplify deduplication, but it also reorders different values. It is therefore valid only when the problem permits that change or explicitly requires sorted output.",
              "wrongOptionExplanationsByOptionId": {
                "sorting_cannot_group_duplicates": "Sorting normally does group equal values, which is why it can help with deduplication.",
                "sorting_always_quadratic": "Comparison sorting is commonly O(n log n); the decisive defect here is contract violation, not an assumed quadratic cost.",
                "sorting_removes_values": "Sorting changes positions but does not itself remove occurrences."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "in_place_duplicate_collapse",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-005",
            "prompt": "A stable deduplication function receives an input containing no duplicates. What should happen?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "unchanged_sequence",
                  "text": "The sequence should be returned unchanged."
                },
                {
                  "id": "empty_sequence",
                  "text": "The result should be empty because no duplicate was found."
                },
                {
                  "id": "first_value_only",
                  "text": "Only the first value should be retained."
                },
                {
                  "id": "reverse_sequence",
                  "text": "The sequence should be reversed to mark that deduplication completed."
                }
              ],
              "acceptedOptionIds": [
                "unchanged_sequence"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Removing repeated occurrences must not remove values that occur only once.",
              "details": "An input with no duplicates already satisfies the uniqueness postcondition. Stable deduplication should preserve all values and their relative order.",
              "wrongOptionExplanationsByOptionId": {
                "empty_sequence": "The absence of duplicates means no removals are necessary; it does not mean the input is invalid.",
                "first_value_only": "This would discard distinct values and violate the output contract.",
                "reverse_sequence": "Deduplication does not authorize an unrelated order change."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-006",
            "prompt": "A function must keep at most two copies of each value. What is the correct output for [7, 7, 7, 7]?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "keep_two",
                  "text": "[7, 7]"
                },
                {
                  "id": "keep_one",
                  "text": "[7]"
                },
                {
                  "id": "keep_all",
                  "text": "[7, 7, 7, 7]"
                },
                {
                  "id": "remove_all",
                  "text": "[]"
                }
              ],
              "acceptedOptionIds": [
                "keep_two"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The duplicate contract permits two occurrences, not exactly one and not every occurrence.",
              "details": "The first two copies are legal. The third and fourth exceed the maximum multiplicity and must be removed. Deduplication is not always equivalent to keeping exactly one copy.",
              "wrongOptionExplanationsByOptionId": {
                "keep_one": "This applies a stricter contract than requested by retaining only one copy.",
                "keep_all": "This violates the maximum multiplicity of two.",
                "remove_all": "Repeated values are not forbidden entirely; up to two copies must be preserved."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "in_place_duplicate_collapse",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-007",
            "prompt": "Arrange the reasoning steps that should occur before implementing duplicate handling.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "identify_multiplicity",
                  "text": "Identify the required multiplicity of each logical value."
                },
                {
                  "id": "identify_order",
                  "text": "Identify whether relative order or sorted order is required."
                },
                {
                  "id": "choose_legal_transformation",
                  "text": "Choose a transformation that preserves those guarantees."
                },
                {
                  "id": "test_duplicate_edges",
                  "text": "Test no duplicates, all duplicates, and separated duplicates."
                }
              ],
              "canonicalOrder": [
                "identify_multiplicity",
                "identify_order",
                "choose_legal_transformation",
                "test_duplicate_edges"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The output contract must be established before choosing or testing an implementation.",
              "details": "Multiplicity determines what repeated occurrences mean. Ordering determines whether sorting or grouping is legal. Only then can an implementation be selected and tested against representative duplicate distributions."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-008",
            "prompt": "An algorithm scans the input once and stores every previously seen distinct value in a set. Which statement is precise?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_time_linear_space",
                  "text": "It can be O(n) time and O(k) auxiliary space, where k is the number of distinct values."
                },
                {
                  "id": "linear_time_constant_space",
                  "text": "It is O(n) time and O(1) auxiliary space because it uses only one loop."
                },
                {
                  "id": "quadratic_due_to_set",
                  "text": "It is necessarily O(n²) because the set grows during the scan."
                },
                {
                  "id": "constant_time_due_to_hashing",
                  "text": "It is O(1) total time because set membership is expected O(1)."
                }
              ],
              "acceptedOptionIds": [
                "linear_time_linear_space"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "One pass constrains the number of iterations, not the amount of retained state.",
              "details": "The scan performs O(n) expected work under the standard hash-set model. The set may contain one entry for every distinct input value, so its auxiliary space is O(k), which is O(n) in the worst case.",
              "wrongOptionExplanationsByOptionId": {
                "linear_time_constant_space": "A single loop does not imply constant space; the set grows with the number of distinct values.",
                "quadratic_due_to_set": "Growing state does not by itself make the running time quadratic.",
                "constant_time_due_to_hashing": "Expected O(1) membership applies per operation, not to the entire scan of n elements."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-009",
            "prompt": "A sorted array is compacted in place so that each distinct value appears once in the retained prefix. Select the expected time and auxiliary-space complexity.",
            "constraints": [
              "The input contains n elements.",
              "The algorithm uses a read index and a write index.",
              "No additional collection grows with n."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "linear": "O(n)"
                },
                "auxiliary_space": {
                  "constant": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Every input position is inspected once, while the retained result is written back into the existing array.",
              "details": "The duplicate contract is represented by the retained prefix: each distinct value appears once. The scan is O(n), and a constant number of indices gives O(1) auxiliary space. The physical suffix may remain unchanged because it is outside the logical result."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "in_place_duplicate_collapse",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-010",
            "prompt": "The output must group equal values while preserving their exact original multiplicities. Which state model preserves the required information?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frequency_per_value",
                  "text": "A frequency count for each distinct value."
                },
                {
                  "id": "presence_only",
                  "text": "A set containing each value once."
                },
                {
                  "id": "first_value_only",
                  "text": "A single variable holding the first value."
                },
                {
                  "id": "duplicate_boolean",
                  "text": "One boolean indicating whether any duplicate exists."
                }
              ],
              "acceptedOptionIds": [
                "frequency_per_value"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Preserving multiplicity requires retaining the number of occurrences, not merely presence.",
              "details": "A set can tell whether a value appeared, but it cannot distinguish one occurrence from five. A frequency count retains the exact multiplicity needed to reproduce grouped output.",
              "wrongOptionExplanationsByOptionId": {
                "presence_only": "Presence state collapses all positive counts into one fact and loses multiplicity.",
                "first_value_only": "A single value cannot describe the counts of the remaining distinct values.",
                "duplicate_boolean": "Knowing that some duplicate exists does not identify which values repeat or how often."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-011",
            "prompt": "A sorted array is deduplicated in place and the function returns k, the logical result length. Which postconditions must hold? Select all that apply.",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "prefix_contains_unique_values",
                  "text": "The prefix [0, k) contains each distinct input value exactly once."
                },
                {
                  "id": "k_equals_distinct_count",
                  "text": "k equals the number of distinct values in the input."
                },
                {
                  "id": "suffix_is_outside_contract",
                  "text": "Positions at or after k may be outside the logical output contract."
                },
                {
                  "id": "physical_length_must_shrink",
                  "text": "The physical array length must become exactly k."
                }
              ],
              "acceptedOptionIds": [
                "prefix_contains_unique_values",
                "k_equals_distinct_count",
                "suffix_is_outside_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "In-place compaction defines a logical result prefix rather than necessarily resizing the underlying storage.",
              "details": "The returned length k identifies the valid result region. That region must contain exactly one copy of every distinct value. The remaining storage is not part of the logical output unless the problem explicitly says otherwise.",
              "wrongOptionExplanationsByOptionId": {
                "physical_length_must_shrink": "An in-place contract can return a logical length without changing the physical capacity or length of the underlying container."
              },
              "omittedCorrectExplanationsByOptionId": {
                "prefix_contains_unique_values": "This is the central semantic guarantee of the deduplicated prefix.",
                "k_equals_distinct_count": "Each distinct value contributes exactly one retained position, so the logical length equals the number of distinct values.",
                "suffix_is_outside_contract": "Values beyond the returned logical length do not have to be cleared or normalized unless the specification requires it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "in_place_duplicate_collapse",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-012",
            "prompt": "A program checks only whether the current value equals the immediately previous value. Why can this fail to remove all duplicates from [1, 2, 1]?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "duplicates_not_adjacent",
                  "text": "Equal values are not necessarily adjacent in an unsorted input."
                },
                {
                  "id": "three_elements_too_many",
                  "text": "Adjacent comparison works only for arrays of at most two elements."
                },
                {
                  "id": "integers_cannot_compare",
                  "text": "Integer equality cannot be checked with an adjacent scan."
                },
                {
                  "id": "duplicate_must_be_consecutive_three_times",
                  "text": "A value is considered a duplicate only after three consecutive occurrences."
                }
              ],
              "acceptedOptionIds": [
                "duplicates_not_adjacent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Adjacent comparison detects global duplicates only when the contract or preprocessing guarantees that equal values are grouped.",
              "details": "The two occurrences of 1 are separated by 2, so comparing each item only with its predecessor does not connect them. The solution needs global seen state or a legal transformation that groups equal values.",
              "wrongOptionExplanationsByOptionId": {
                "three_elements_too_many": "The problem is the distribution of equal values, not the total input length.",
                "integers_cannot_compare": "Integer equality is directly comparable; the scan simply compares the wrong pairs.",
                "duplicate_must_be_consecutive_three_times": "Two occurrences are sufficient to create a duplicate unless the problem defines a different threshold."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-013",
            "prompt": "Arrange the review steps for checking whether a proposed duplicate-handling solution preserves the required contract.",
            "difficulty": "easy",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_required_contract",
                  "text": "State the required multiplicity and ordering guarantees."
                },
                {
                  "id": "inspect_solution_effect",
                  "text": "Inspect whether the solution changes counts, order, or mutation behavior."
                },
                {
                  "id": "construct_counterexample",
                  "text": "Construct an input with separated and repeated occurrences."
                },
                {
                  "id": "compare_actual_postcondition",
                  "text": "Compare the produced output with the required postcondition."
                }
              ],
              "canonicalOrder": [
                "state_required_contract",
                "inspect_solution_effect",
                "construct_counterexample",
                "compare_actual_postcondition"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A solution cannot be judged without first making the duplicate contract explicit.",
              "details": "After the contract is stated, the transformation can be inspected for possible violations. A counterexample should exercise duplicate spacing, multiplicity, and order. The final output is then evaluated against the actual postcondition rather than against a vague idea of deduplication."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-014",
            "prompt": "A function removes only consecutive duplicate occurrences, not all repeated values globally. What is the correct output for [1, 1, 2, 1, 1]?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "collapse_each_run",
                  "text": "[1, 2, 1]"
                },
                {
                  "id": "global_unique",
                  "text": "[1, 2]"
                },
                {
                  "id": "keep_original",
                  "text": "[1, 1, 2, 1, 1]"
                },
                {
                  "id": "remove_repeated_value_entirely",
                  "text": "[2]"
                }
              ],
              "acceptedOptionIds": [
                "collapse_each_run"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Consecutive-run compression and global deduplication are different output contracts.",
              "details": "The first run [1, 1] becomes one 1. The isolated 2 remains. The final run [1, 1] also becomes one 1. The later 1 is retained because it belongs to a separate run.",
              "wrongOptionExplanationsByOptionId": {
                "global_unique": "This applies global uniqueness, which is stricter than removing only consecutive repetitions.",
                "keep_original": "This does not collapse either consecutive run.",
                "remove_repeated_value_entirely": "The contract removes extra occurrences within each run, not every value that appears more than once."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "adjacent_scan",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-015",
            "prompt": "The required output is the distinct input values in ascending order, and original positions are irrelevant. Is sorting followed by adjacent duplicate removal legal?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "legal_matches_contract",
                  "text": "Yes. Sorting establishes the required output order and groups equal values."
                },
                {
                  "id": "illegal_sorting_always_changes_contract",
                  "text": "No. Sorting is never legal in a duplicate-handling problem."
                },
                {
                  "id": "illegal_requires_hash_set",
                  "text": "No. Every deduplication contract requires a hash set."
                },
                {
                  "id": "legal_only_without_duplicates",
                  "text": "Yes, but only when the input already contains no duplicates."
                }
              ],
              "acceptedOptionIds": [
                "legal_matches_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorting is legal when its ordering effect is consistent with the required output.",
              "details": "Here the output must be ascending and does not preserve original positions. Sorting therefore satisfies rather than violates the order contract, while also making duplicate runs easy to collapse.",
              "wrongOptionExplanationsByOptionId": {
                "illegal_sorting_always_changes_contract": "Sorting is invalid only when its order change conflicts with a required guarantee.",
                "illegal_requires_hash_set": "A hash set is one possible technique, not a universal requirement.",
                "legal_only_without_duplicates": "Sorting followed by adjacent collapse is specifically useful when duplicates are present."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "in_place_duplicate_collapse",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-016",
            "prompt": "Two inventory lists are combined. Each occurrence represents one physical item, so repeated product IDs must retain their total multiplicity. Which result contract is correct?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sum_multiplicities",
                  "text": "The output count of each product ID equals its count in the first list plus its count in the second list."
                },
                {
                  "id": "set_union",
                  "text": "Every product ID appears exactly once, regardless of how many physical items exist."
                },
                {
                  "id": "duplicates_invalid",
                  "text": "Any product ID appearing more than once must be removed entirely."
                },
                {
                  "id": "first_list_counts_only",
                  "text": "Only multiplicities from the first list are retained."
                }
              ],
              "acceptedOptionIds": [
                "sum_multiplicities"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When occurrences represent physical entities, collapsing duplicate IDs destroys required quantity information.",
              "details": "The logical identity may repeat because several physical items share the same product ID. Combining the inventories therefore adds multiplicities rather than converting the data to a set.",
              "wrongOptionExplanationsByOptionId": {
                "set_union": "Set union preserves presence but loses the number of physical items.",
                "duplicates_invalid": "Repeated IDs are valid and represent multiple items under this contract.",
                "first_list_counts_only": "Ignoring the second list violates the requirement to combine both inventories."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-017",
            "prompt": "An algorithm inserts all n input values into a hash set and then returns the k distinct values stored in that set. Select its expected time, auxiliary-space, and output-space complexity.",
            "constraints": [
              "Hash insertion is expected O(1) per value.",
              "k is the number of distinct input values."
            ],
            "difficulty": "easy",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space",
                "output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(k)",
                  "O(n)",
                  "O(n log n)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(k)",
                  "O(n log n)"
                ],
                "output_space": [
                  "O(1)",
                  "O(k)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "auxiliary_space": [
                  "O(k)"
                ],
                "output_space": [
                  "O(k)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "linear": "O(n)"
                },
                "auxiliary_space": {
                  "distinct_values": "O(k)"
                },
                "output_space": {
                  "distinct_values": "O(k)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The scan processes n occurrences, while both retained state and returned data scale with the k distinct values.",
              "details": "Expected time is O(n) because every input occurrence is inserted or checked once. The set stores k entries, giving O(k) auxiliary space. Materializing the distinct result also requires O(k) output space. Output space and auxiliary space are separate accounting dimensions even when they have the same asymptotic size."
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-duplicate-handling-018",
            "prompt": "A stream of records may contain repeated user IDs. The required output keeps the earliest record for each user ID and preserves the original order of those retained records. Which approach matches the contract?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "append_first_unseen",
                  "text": "Scan from left to right, append a record only when its user ID has not been seen, and then mark that ID as seen."
                },
                {
                  "id": "sort_by_user_id",
                  "text": "Sort all records by user ID and keep one arbitrary record from each group."
                },
                {
                  "id": "overwrite_with_latest",
                  "text": "Store one record per user ID and overwrite it whenever a later record appears."
                },
                {
                  "id": "remove_all_repeated_ids",
                  "text": "Discard every record whose user ID occurs more than once."
                }
              ],
              "acceptedOptionIds": [
                "append_first_unseen"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The contract combines first-occurrence selection with stable output order.",
              "details": "A left-to-right scan makes the first record for each user ID the retained record. Appending only unseen IDs preserves the relative order of those first occurrences. Sorting or overwriting would change which record or order is retained.",
              "wrongOptionExplanationsByOptionId": {
                "sort_by_user_id": "Sorting changes the required original order and choosing an arbitrary group member may discard the earliest record.",
                "overwrite_with_latest": "Overwriting implements a keep-last contract rather than the required keep-first contract.",
                "remove_all_repeated_ids": "The contract retains one record for repeated IDs; it does not remove the entire duplicated identity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "preserve_duplicate_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          }
        ],
