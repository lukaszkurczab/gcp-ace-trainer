        "items": [
          {
            "id": "recursion-basics-recursion-mistake-review-unchanged-n-first-failing-obligation",
            "prompt": "Consider:\n\n    digitSum(n):\n        if n < 10: return n\n        return n % 10 + digitSum(n)\n\nFrom n = 42, which diagnosis is most precise?",
            "constraints": [
              "n is a non-negative integer.",
              "Integer digit sum is the intended result.",
              "The shown recursive argument is exactly n."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_progress_same_n",
                  "text": "The recursive state is unchanged, so 42 calls 42 repeatedly and the terminal range is unreachable."
                },
                {
                  "id": "wrong_empty_base",
                  "text": "The only defect is that the base case should check an empty input."
                },
                {
                  "id": "wrong_combiner",
                  "text": "Addition should be replaced by multiplication."
                },
                {
                  "id": "exponential_branching",
                  "text": "The function terminates but takes exponential time."
                }
              ],
              "acceptedOptionIds": [
                "no_progress_same_n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The first recursive call preserves n, creating an immediate self-loop before the result combiner can matter.",
              "details": "Diagnose recursive code in dependency order. The base contract for single-digit values is coherent, and n % 10 is the correct local contribution for a digit sum. But the transition digitSum(n) does not remove the last digit; the state graph contains a self-loop at every n >= 10. Therefore no recursive result is ever available to add. A precise review should name the earliest broken contract—progress on state—rather than proposing unrelated base, combination, or complexity changes.",
              "wrongOptionExplanationsByOptionId": {
                "wrong_empty_base": "The numeric contract has no empty input. Values below ten are valid atomic states; the failure is that larger values never move toward them.",
                "wrong_combiner": "Addition matches digit sum. The child call never returns, so changing the combiner would not repair the first failing obligation.",
                "exponential_branching": "There is one recursive call per frame, and it repeats the same state forever. The issue is nontermination, not a finite branching cost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_nonterminating_or_incomplete_recursion",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "recursive_decomposition",
              "problemArchetypeId": "compute_from_smaller_input"
            }
          },
          {
            "id": "recursion-basics-recursion-mistake-review-smallest-counterexample-diagnostic-sequence",
            "prompt": "Order the steps for diagnosing a recursive function that returns a wrong result or fails at runtime.",
            "constraints": [
              "The goal is code and trace diagnosis, not greenfield algorithm design.",
              "The function may have more than one visible defect, but the review must identify the first material violation."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_contract",
                  "text": "State the legal input domain and what one call promises to return."
                },
                {
                  "id": "smallest_trace",
                  "text": "Trace the smallest input that exhibits the symptom, including every recursive argument and return."
                },
                {
                  "id": "first_violation",
                  "text": "Identify the first violated obligation: terminal coverage, strict progress, state isolation, or result combination."
                },
                {
                  "id": "bounded_fix_check",
                  "text": "Check a bounded repair against a neighboring case and the ownership boundary before analyzing performance."
                },
                {
                  "id": "cost_after_correctness",
                  "text": "Only after correctness obligations hold, derive total work and maximum stack depth."
                }
              ],
              "canonicalOrder": [
                "state_contract",
                "smallest_trace",
                "first_violation",
                "bounded_fix_check",
                "cost_after_correctness"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 4
            },
            "feedback": {
              "reason": "A reliable review anchors the contract, exposes the first failing state transition or return, verifies a bounded repair, and postpones cost claims until behavior is coherent.",
              "details": "Without a domain and return promise, a base value or trace cannot be judged. The smallest failing input minimizes noise and reveals whether the fault occurs before a call, on a recursive edge, during shared-state mutation, or while combining returns. Naming the first violated obligation prevents secondary symptoms—such as stack overflow—from being mistaken for root causes. A proposed fix must be checked on an adjacent boundary so it does not merely patch one trace. Complexity analysis comes last because a nonterminating or semantically incomplete recurrence has no meaningful successful cost contract."
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_nonterminating_or_incomplete_recursion",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "recursive_decomposition",
              "problemArchetypeId": "compute_from_smaller_input"
            }
          },
          {
            "id": "recursion-basics-recursion-mistake-review-empty-input-guard-after-read",
            "prompt": "Consider a shared immutable array a:\n\n    containsFrom(i, target):\n        if a[i] == target: return true\n        if i == len(a): return false\n        return containsFrom(i + 1, target)\n\nWhat fails when i == len(a)?",
            "constraints": [
              "i may equal len(a).",
              "Array indexing is valid only for 0 <= i < len(a).",
              "The array is not padded with a sentinel element."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "read_before_terminal_guard",
                  "text": "The code reads a[i] before recognizing the empty suffix, so the terminal state causes an out-of-bounds access."
                },
                {
                  "id": "missing_target_state",
                  "text": "target must change in every recursive call."
                },
                {
                  "id": "wrong_boolean_combiner",
                  "text": "The function must combine two child Booleans with AND."
                },
                {
                  "id": "only_complexity_problem",
                  "text": "The code is correct but uses O(n) instead of O(log n)."
                }
              ],
              "acceptedOptionIds": [
                "read_before_terminal_guard"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
