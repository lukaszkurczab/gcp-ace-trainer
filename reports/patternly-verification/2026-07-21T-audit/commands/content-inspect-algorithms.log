            "taxonomy": {
              "primarySkillAtomId": "diagnose_bit_width_or_sign_assumption",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-review-018",
            "prompt": "A routine XOR-reduces n arbitrary-precision integers of at most w bits each. Select total time and accumulator space.",
            "constraints": [
              "XOR of two w-bit represented integers costs O(w).",
              "One w-bit accumulator is retained."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "accumulator_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n)",
                  "O(w)",
                  "O(nw)",
                  "O(2^w)"
                ],
                "accumulator_space": [
                  "O(1)",
                  "O(log w)",
                  "O(w)",
                  "O(nw)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(nw)"
                ],
                "accumulator_space": [
                  "O(w)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "values_times_width": "O(nw)"
                },
                "accumulator_space": {
                  "represented_width": "O(w)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The word-RAM O(1) assumption is invalid when operand width grows with input.",
              "details": "Both operation cost and stored accumulator scale with represented bit length."
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_bit_width_or_sign_assumption",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "xor_cancellation",
              "problemArchetypeId": "find_unique_element"
            }
          }
