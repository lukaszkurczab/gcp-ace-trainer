              "omittedCorrectExplanationsByOptionId": {
                "emitted_sorted_disjoint": "Without this invariant, the output is not yet a normalized union and later code cannot rely on it.",
                "active_is_current_union": "The scan's state must summarize all overlapping input not yet emitted, not only the most recent interval.",
                "active_end_is_max": "The maximum end prevents a contained interval from shrinking the covered component."
              }
            },
            "taxonomy": {
