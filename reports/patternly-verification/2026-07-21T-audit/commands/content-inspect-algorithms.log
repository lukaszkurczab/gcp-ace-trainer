          {
            "id": "alg-contrast-hash-sort-transfer-016",
            "prompt": "Arrange the transfer from arbitrary-order counts to ordered groups.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "old_contract",
                  "text": "Record that the original hash map served arbitrary-order key counts."
                },
                {
                  "id": "new_requirement",
                  "text": "Add ascending key order to the output contract."
                },
                {
                  "id": "compare_paths",
                  "text": "Compare hash-count-plus-key-sort with sort-values-plus-run-scan."
                },
                {
                  "id": "select",
                  "text": "Choose using k, n, memory, mutation, and guarantee assumptions."
                }
              ],
              "canonicalOrder": [
                "old_contract",
                "new_requirement",
                "compare_paths",
                "select"
