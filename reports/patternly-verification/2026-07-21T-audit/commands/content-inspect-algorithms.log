              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The exponential factor comes from the number of masks.",
              "details": "Without materialized subsets or retained history, the loop itself uses constant extra state."
            },
            "taxonomy": {
              "primarySkillAtomId": "enumerate_subset_by_bitmask",
