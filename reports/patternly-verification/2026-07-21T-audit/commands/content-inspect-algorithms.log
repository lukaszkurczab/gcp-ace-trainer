        "items": [
          {
            "id": "alg-hms-frequency-increment-invariant",
            "prompt": "Order the steps that update a frequency map so count[value] equals the number of processed occurrences after each iteration.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "read_value",
                  "text": "Read the current value."
                },
                {
                  "id": "read_old_count",
                  "text": "Read its stored count, using zero when the key is absent."
                },
                {
                  "id": "write_incremented",
                  "text": "Write old count + 1 for that value."
                },
                {
                  "id": "advance",
                  "text": "Advance to the next input value."
                }
              ],
              "canonicalOrder": [
                "read_value",
                "read_old_count",
                "write_incremented",
                "advance"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Each update derives the new count from the prior count before the loop invariant is advanced.",
              "details": "The invariant is processed-count equality: after updating value v, map[v] equals the number of v occurrences in the processed prefix. Missing keys represent zero before their first increment. Reading after an unconditional overwrite or storing only presence would lose multiplicity and break the invariant."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_frequency_map",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-hms-frequency-multiset-equality",
            "prompt": "Two arrays contain the same distinct values, but one array contains an extra copy of a value. Which state can distinguish the arrays as multisets?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frequency_map",
                  "text": "A value-to-count map."
                },
                {
                  "id": "presence_set",
                  "text": "A set of distinct values."
                },
                {
                  "id": "array_length_only",
                  "text": "Only the total length of each array."
                }
              ],
              "acceptedOptionIds": [
                "frequency_map"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Multiset equality is equality of per-value multiplicities, not only equality of distinct members.",
              "details": "A frequency map represents the complete multiset signature: every key’s count must match. A set answers only whether each key occurs at least once. The same boundary appears in permutation checks, inventory reconciliation, and resource-consumption validation.",
              "wrongOptionExplanationsByOptionId": {
                "presence_set": "Both arrays can have the same set even when their multiplicities differ, so presence loses the decisive information.",
                "array_length_only": "Equal lengths do not identify which values occur how many times, and an unequal length alone does not provide a complete multiset comparison."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_frequency_map",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-hms-frequency-decrement-remove-zero",
            "prompt": "An event removes one occurrence of key k from maintained frequency state. Order the steps so absence and zero count remain equivalent in the canonical map.",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "verify_positive",
                  "text": "Verify that k currently has a positive count."
                },
                {
                  "id": "decrement",
                  "text": "Decrease the stored count by one."
                },
                {
                  "id": "remove_if_zero",
                  "text": "Delete k if the new count is zero."
                },
                {
                  "id": "continue",
                  "text": "Continue with the next event."
                }
              ],
              "canonicalOrder": [
                "verify_positive",
                "decrement",
                "remove_if_zero",
                "continue"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The update must prevent negative counts and remove zero-valued keys if key presence is used as the positive-count predicate.",
              "details": "A canonical frequency map often uses absence to mean zero and key presence to mean a positive count. Verifying before decrement prevents an invalid negative state; deleting at zero preserves the equivalence between contains(k) and count(k) > 0. Keeping zero keys can be valid only if every membership check explicitly tests the numeric payload instead of key existence."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_frequency_map",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-frequency-threshold-crossing-order",
            "prompt": "The program must report the exact iteration when a value’s count becomes 3. Which update sequence is correct?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "increment_then_test",
                  "text": "Increment the value’s count, then test whether the new count equals 3."
                },
                {
                  "id": "test_then_increment",
                  "text": "Test whether the old count equals 3, then increment."
                },
                {
                  "id": "insert_presence_then_test",
                  "text": "Insert the value into a set, then test membership."
                }
              ],
              "acceptedOptionIds": [
                "increment_then_test"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The event is defined by the post-update count, so the increment must occur before the equality test.",
              "details": "“Check before or after update” is not a universal rule; it depends on which state the condition describes. Here the condition is that the current occurrence raises the cumulative count to three, so the new state must be computed first. For duplicate detection, by contrast, checking prior presence before recording the current occurrence is the correct invariant.",
              "wrongOptionExplanationsByOptionId": {
                "test_then_increment": "Testing the old count reports one occurrence late because the event that creates count 3 has not yet been reflected.",
                "insert_presence_then_test": "Membership cannot distinguish the first, second, and third occurrences, so it cannot detect the threshold crossing."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_frequency_map",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-frequency-most-common-state",
            "prompt": "A task must return the value with the highest occurrence count. Which hash state is sufficient to support the comparison?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_to_count",
                  "text": "A map from value to count, plus a rule for comparing counts."
                },
                {
                  "id": "seen_values",
                  "text": "A set of values that appeared."
                },
                {
                  "id": "value_to_boolean",
                  "text": "A map from value to true."
                }
              ],
              "acceptedOptionIds": [
                "value_to_count"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Selecting a most frequent value requires the numeric multiplicity associated with each key.",
              "details": "The map establishes the count invariant; a separate scan of entries or an online maximum tracker can then choose the largest count under a stated tie rule. Presence is insufficient because all seen values would look equal. If ties or stable ordering matter, that additional contract must also be represented.",
              "wrongOptionExplanationsByOptionId": {
                "seen_values": "A set shows which candidates exist but gives no basis for ranking them by multiplicity.",
                "value_to_boolean": "A boolean payload is semantically the same as set membership and still loses all count differences."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_frequency_map",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-frequency-count-versus-bucket",
            "prompt": "A report must return every record in each category, not only category sizes. What is missing from a value-to-count map?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "member_bucket",
                  "text": "A bucket of the original records for each category key."
                },
                {
                  "id": "presence_bit",
                  "text": "A boolean showing the category exists."
                },
                {
                  "id": "larger_integer",
                  "text": "A wider integer type for the count."
                }
              ],
              "acceptedOptionIds": [
                "member_bucket"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Counts summarize group size; returning group members requires a key-to-bucket payload.",
              "details": "A frequency map is a lossy aggregation by design. It answers “how many?” but not “which ones?” When the output changes to materialized groups, the payload must change to a list or another member-preserving structure. This is a transfer boundary between counting and grouping, even though both use hash maps.",
              "wrongOptionExplanationsByOptionId": {
                "presence_bit": "Presence retains even less information than the count and still cannot reconstruct group members.",
                "larger_integer": "Numeric width can prevent overflow, but it cannot recover the identities of records that were never stored."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_frequency_map",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate"
          },
          {
            "id": "alg-hms-frequency-expected-cost",
            "prompt": "A frequency pass processes n fixed-width values and updates one hash-map count per value. At most n distinct keys are stored. Under ordinary hashing assumptions, classify expected time and extra space.",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "extra_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)",
                  "O(n^2)"
                ],
                "extra_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n^2)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "extra_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {},
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "There is one expected-constant map update per input element and up to n distinct count entries.",
              "details": "The loop performs n read-modify-write operations, so expected O(1) per update yields expected O(n) total time. The number of keys is bounded by the number of processed elements, giving O(n) extra space in the worst distinct-value case. This does not assert worst-case constant lookup under arbitrary collisions."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_frequency_map",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Assume fixed-width keys and a conventional resizable hash table with well-distributed hashes."
            ]
          },
          {
            "id": "alg-hms-frequency-weighted-events-transfer",
            "prompt": "Events carry an integer weight w, and the required total for each key is the sum of its event weights. How should the frequency update generalize?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "add_weight",
                  "text": "state[key] = previous total + w"
                },
                {
                  "id": "add_one",
                  "text": "state[key] = previous total + 1"
                },
                {
                  "id": "set_weight",
                  "text": "state[key] = w, overwriting the previous total"
                },
                {
                  "id": "store_presence",
                  "text": "Insert key into a set and discard w"
                }
              ],
              "acceptedOptionIds": [
                "add_weight"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The maintained payload is an additive aggregate, so each event contributes its weight to the prior total.",
              "details": "Frequency counting is a special case of keyed aggregation where every event weight equals one. Replacing +1 with +w preserves the invariant that state[key] equals the sum of processed weights for that key. The transfer stops when the aggregate is non-associative or needs member order, in which case a different payload or processing contract is required.",
              "wrongOptionExplanationsByOptionId": {
                "add_one": "Adding one counts events rather than accumulating their stated weights.",
                "set_weight": "Overwriting retains only the most recent weight and loses earlier contributions.",
                "store_presence": "Presence discards both multiplicity and weight, so it cannot produce the required totals."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_frequency_map",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "advanced"
          }
