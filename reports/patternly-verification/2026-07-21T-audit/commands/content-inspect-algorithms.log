          {
            "id": "hpq-mechanics-trace-push-concrete",
            "prompt": "Starting from the valid min-heap array [2, 5, 3, 9, 7, 8], push the key 1 using ordinary append-and-sift-up mechanics. Which resulting array is correct?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "append_only",
                  "text": "[2, 5, 3, 9, 7, 8, 1]"
                },
                {
                  "id": "wrong_parent_path",
                  "text": "[1, 2, 3, 9, 7, 8, 5]"
                },
                {
                  "id": "sifted_path",
                  "text": "[1, 5, 2, 9, 7, 8, 3]"
                },
                {
                  "id": "fully_sorted",
                  "text": "[1, 2, 3, 5, 7, 8, 9]"
                }
              ],
              "acceptedOptionIds": [
                "sifted_path"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The new 1 swaps with its parent 3 and then with root 2; unrelated branches remain unchanged.",
              "details": "The key is appended at index 6. Its parent is index 2 with value 3, producing [2, 5, 1, 9, 7, 8, 3] after one swap. Its new parent is root 2, producing [1, 5, 2, 9, 7, 8, 3]. The algorithm does not sort the array and does not move through index 1, because the parent chain is determined by the complete-tree representation.",
              "wrongOptionExplanationsByOptionId": {
                "append_only": "Appending preserves shape but leaves 1 below parent 3, violating the min-heap invariant.",
                "fully_sorted": "Push repairs only the ancestor path. A heap operation does not establish global sorted order.",
                "wrong_parent_path": "The new node’s parent chain is index 6 → 2 → 0, not index 6 → 1 → 0; value 5 is not on the affected path."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_heap_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "choose_repeated_extreme"
            }
          },
          {
            "id": "hpq-mechanics-trace-pop-concrete",
            "prompt": "Starting from the valid min-heap array [1, 4, 3, 8, 6, 5], remove the minimum using last-leaf replacement and sift-down. Which resulting array is correct?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "smaller_child_swap",
                  "text": "[3, 4, 5, 8, 6]"
                },
                {
                  "id": "sorted_remaining",
                  "text": "[3, 4, 5, 6, 8]"
                },
                {
                  "id": "larger_child_swap",
                  "text": "[4, 5, 3, 8, 6]"
                },
                {
                  "id": "remove_root_shift",
                  "text": "[4, 3, 8, 6, 5]"
                }
              ],
              "acceptedOptionIds": [
                "smaller_child_swap"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "After 5 replaces the root, it must swap with the smaller child 3, yielding a valid heap.",
              "details": "Removing 1 and moving last leaf 5 to the root gives [5, 4, 3, 8, 6]. The smaller child is 3, so swapping produces [3, 4, 5, 8, 6]. The replacement then has no children, and repair stops. Shifting array entries does not preserve the complete-tree parent relationships used by heap mechanics, while sorting would do unnecessary global work.",
              "wrongOptionExplanationsByOptionId": {
                "larger_child_swap": "Swapping with 4 leaves child 3 below root 4, so the min-heap invariant remains broken.",
                "remove_root_shift": "Shifting all entries changes tree relationships and does not implement the canonical last-leaf replacement rule.",
                "sorted_remaining": "The remaining values happen to admit a sorted order, but pop performs local repair rather than a full sort."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_heap_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "choose_repeated_extreme"
            }
          },
          {
            "id": "hpq-mechanics-equal-priority-stability",
            "prompt": "Two tasks have equal priority. The product requires the earlier arrival to run first. What must the heap key contract include?",
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "full_sort_after_peek",
                  "text": "A full sort after every peek to discover which equal-priority task arrived first."
                },
                {
                  "id": "array_position_rank",
                  "text": "The current backing-array position as the permanent task rank."
                },
                {
                  "id": "heap_stability_assumption",
                  "text": "No extra field; binary heaps are inherently stable among equal keys."
                },
                {
                  "id": "composite_key",
                  "text": "A deterministic tie-break field such as arrival sequence in addition to priority."
                }
              ],
              "acceptedOptionIds": [
                "composite_key"
              ]
