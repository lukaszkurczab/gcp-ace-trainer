          {
            "id": "alg-contrast-hash-sort-reject-014",
            "prompt": "A comparison-sort path is still legal. Which facts make its ordered representation worth paying for? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "order_required",
