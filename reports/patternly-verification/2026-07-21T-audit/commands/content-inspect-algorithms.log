        "items": [
          {
            "id": "hpq-mechanics-peek-root-guarantee",
            "prompt": "The array [2, 5, 3, 9, 7, 8] represents a valid binary min-heap. What does peek guarantee?",
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "second_entry_is_second_min",
                  "text": "It proves 5 is the second-smallest element."
                },
                {
                  "id": "root_is_minimum",
                  "text": "It returns 2, the minimum element at the root."
                },
                {
                  "id": "array_is_sorted",
                  "text": "It proves the full array is in ascending order."
                },
                {
                  "id": "last_entry_is_maximum",
                  "text": "It proves 8 is the maximum element."
                }
              ],
              "acceptedOptionIds": [
                "root_is_minimum"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A min-heap guarantees only that every parent is no greater than its children, which places a minimum at the root.",
              "details": "The heap invariant is partial order, not total order. Here 3 appears after 5 because siblings and different subtrees have no required ordering. Peek reads the root without changing the structure, so it returns 2. The second-smallest value must be reasoned from the root’s children or obtained through a removal process; arbitrary array positions do not represent sorted ranks.",
              "wrongOptionExplanationsByOptionId": {
                "array_is_sorted": "Parent-child order does not impose order between siblings or across subtrees, so the backing array need not be sorted.",
                "second_entry_is_second_min": "Array position 1 is a child of the root, but the other child may be smaller. Heap position is not a global rank.",
                "last_entry_is_maximum": "A leaf has no required relationship with leaves in other branches, so the final array entry need not be the maximum."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_heap_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "choose_repeated_extreme"
            }
          },
          {
            "id": "hpq-mechanics-push-sift-up-order",
            "prompt": "Order the conceptual steps for pushing a new key into a binary min-heap.",
            "difficulty": "introductory",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "append_leaf",
                  "text": "Append the new key at the next leaf position."
                },
                {
                  "id": "compare_parent",
                  "text": "Compare the new key with its parent."
                },
                {
                  "id": "swap_up",
                  "text": "If the key is smaller than its parent, swap them."
                },
                {
                  "id": "repeat_or_stop",
                  "text": "Repeat upward until the parent relation is valid or the key reaches the root."
                }
              ],
              "canonicalOrder": [
                "append_leaf",
                "compare_parent",
                "swap_up",
                "repeat_or_stop"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Insertion preserves the complete-tree shape first, then repairs only the ancestor path by sifting upward.",
              "details": "Appending at the next leaf keeps the binary tree complete. The only possible invariant violation is between the new key and its ancestors, so the algorithm compares with the parent, swaps when necessary, and repeats. Swapping before placement has no defined node to move, and scanning unrelated branches is unnecessary. The same shape-first, local-repair principle transfers to a max-heap with the comparison reversed."
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_heap_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "schedule_by_priority"
            }
          },
          {
            "id": "hpq-mechanics-pop-sift-down-order",
            "prompt": "Order the conceptual steps for removing the minimum from a nonempty binary min-heap.",
            "difficulty": "intermediate",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "save_root",
                  "text": "Save the root value as the result."
                },
                {
                  "id": "move_last",
                  "text": "Move the last leaf to the root and remove the last array slot."
                },
                {
                  "id": "choose_child",
                  "text": "Compare the replacement with its children and choose the smaller child when a swap is needed."
                },
                {
                  "id": "swap_down",
                  "text": "Swap with that child and continue downward until the invariant is restored."
                },
                {
                  "id": "return_saved",
                  "text": "Return the saved minimum after the heap state is valid."
                }
              ],
              "canonicalOrder": [
                "save_root",
                "move_last",
                "choose_child",
                "swap_down",
                "return_saved"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 4
            },
            "feedback": {
              "reason": "Pop preserves shape by filling the root hole with the last leaf, then repairs the affected descendant path.",
              "details": "The root must be saved before it is overwritten. Moving the last leaf preserves the complete-tree shape after deletion. In a min-heap, choosing the smaller child is decisive: swapping with the larger child can leave the smaller child below a larger parent. Repeating this local repair restores the invariant before the operation exposes the updated heap. The empty and one-element cases collapse these steps but keep the same contract."
            },
            "taxonomy": {
              "primarySkillAtomId": "trace_heap_operation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
