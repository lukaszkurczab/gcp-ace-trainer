          {
            "id": "alg-contrast-window-prefix-transfer-001",
            "prompt": "A minimum-length sum-at-least-k task changes from strictly positive values to arbitrary signed values. What should happen to the strategy?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "recheck_prefix_structure",
                  "text": "Abandon the simple monotone window proof and consider prefix sums with an order-aware structure."
                },
                {
                  "id": "same_window",
                  "text": "Keep the same shrink-when-valid rule unchanged."
                },
                {
                  "id": "sort_values",
                  "text": "Sort values before moving boundaries."
                },
                {
                  "id": "prefix_hash_count",
                  "text": "Use only a frequency map for exact differences."
                }
              ],
              "acceptedOptionIds": [
                "recheck_prefix_structure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Changing the sign domain destroys the former discard invariant.",
              "details": "The strategy must transfer with the changed proof obligation, not with the familiar problem title.",
              "wrongOptionExplanationsByOptionId": {
                "same_window": "Negative values can reverse both expansion and shrink effects.",
                "sort_values": "Contiguity would be lost.",
                "prefix_hash_count": "The objective is shortest threshold, not exact count."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_window_vs_prefix_decision",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-transfer-002",
            "prompt": "A task changes from one fixed interval sum to millions of arbitrary static interval sums. Which transfer is natural?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "toward_prefix",
                  "text": "Pay one prefix build and reuse constant-time range differences."
                },
                {
                  "id": "keep_one_scan",
                  "text": "Rescan every interval regardless of workload."
                },
                {
                  "id": "toward_window",
                  "text": "Use one current window even though queries jump arbitrarily."
                },
                {
                  "id": "sort",
                  "text": "Sort once to preserve original interval sums."
                }
              ],
              "acceptedOptionIds": [
                "toward_prefix"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Query volume and boundary order now justify reusable cumulative state.",
              "details": "The same arithmetic result has a different best representation under the new workload.",
