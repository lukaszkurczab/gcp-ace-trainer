      {
        "id": "alg-arrays-duplicate-handling-003",
        "prompt": "Which requirements must be established before selecting a duplicate-handling strategy? Select all that apply.",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "multiple",
          "options": [
            {
              "id": "multiplicity_requirement",
              "text": "Whether the output keeps every occurrence, one occurrence, or a bounded number of occurrences."
            },
            {
              "id": "order_requirement",
              "text": "Whether original relative order must be preserved."
            },
            {
              "id": "mutation_requirement",
              "text": "Whether the input may be reordered or modified in place."
            },
            {
              "id": "numeric_input_requirement",
              "text": "Whether the values are numeric rather than textual."
            }
          ],
          "acceptedOptionIds": [
            "multiplicity_requirement",
            "order_requirement",
            "mutation_requirement"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "Duplicate handling depends on multiplicity, ordering, and mutation guarantees.",
          "details": "The same input may require completely different solutions depending on whether duplicates are removed, counted, capped, grouped, or preserved. Sorting may be legal when order is irrelevant but illegal when stable order is required. In-place requirements also constrain the available transformations.",
          "wrongOptionExplanationsByOptionId": {
            "numeric_input_requirement": "The value type alone does not define the duplicate contract. Numbers and strings can both require any of the listed multiplicity and ordering behaviors."
          },
          "omittedCorrectExplanationsByOptionId": {
            "multiplicity_requirement": "Without the multiplicity rule, it is impossible to know whether repeated values should be preserved, removed, counted, or capped.",
            "order_requirement": "An algorithm that returns the correct distinct values may still be wrong if it changes a required relative order.",
            "mutation_requirement": "A strategy that sorts or rewrites the input may violate the contract even when its returned values are otherwise correct."
          }
        },
        "taxonomy": {
          "primarySkillAtomId": "preserve_duplicate_contract",
          "secondarySkillAtomIds": [],
          "learningStage": "foundations",
          "problemArchetypeId": "remove_or_compact_in_place"
        },
        "interactionType": "choice",
        "resolvedTaxonomy": {
          "roadmapNodeId": "arrays_and_strings",
          "primaryMentalUnitId": "duplicate_handling",
          "patternFamilyId": "arrays_and_strings",
          "primarySkillAtomId": "preserve_duplicate_contract",
          "secondarySkillAtomIds": [],
          "learningStage": "foundations",
