        },
        "batchKind": "standard",
        "authoringProvenance": {
          "author": "OpenAI GPT-5.6 Pro — candidate authoring",
          "createdAt": "2026-07-18",
          "contentBatchId": "algorithms-dynamic-programming-intro-tabulation_bottom_up-candidate-v1",
          "authoringMethod": "independently_authored"
        },
        "items": [
          {
            "id": "alg-dpintro-tabulation-01-explicit-state-enumeration",
            "prompt": "Which evidence most directly supports a bottom-up tabulation of a recurrence?",
            "constraints": [
              "The same state meaning and transition will be used in every implementation."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "overlap_only",
                  "text": "Some recursive calls repeat, even though state bounds and dependency direction are still unknown."
                },
                {
                  "id": "array_input",
                  "text": "The input is stored in an array."
                },
                {
                  "id": "finite_dag",
                  "text": "The reachable states form a finite acyclic dependency graph whose bases and topological order are known."
                }
              ],
              "acceptedOptionIds": [
                "finite_dag"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Bottom-up evaluation needs an explicit finite state domain and an order consistent with its dependencies.",
              "details": "Tabulation replaces demand-driven recursion with a planned traversal of states. To do that safely, the implementation must know which states exist, which values seed the computation, and which dependencies must precede each state. Overlap can motivate reuse but does not by itself provide those pieces. The same criterion applies whether the table is one-dimensional or multidimensional.",
              "wrongOptionExplanationsByOptionId": {
                "overlap_only": "Repetition suggests reuse, but tabulation also needs a well-defined state domain and an order that does not read unresolved states.",
                "array_input": "Input representation does not determine whether the recurrence can be safely or usefully tabulated."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "tabulate_subproblems_bottom_up",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "optimize_prefix_or_suffix"
            }
          },
          {
            "id": "alg-dpintro-tabulation-02-table-shape-from-state",
            "prompt": "A recurrence is defined on dp(i, c), where i ranges from 0 to n and c from 0 to capacity. What is the safest initial tabulation shape?",
            "constraints": [
              "No compression proof has been made.",
              "Both i and c vary independently."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "capacity_only",
                  "text": "An array indexed only by c because capacity is the optimization constraint."
                },
                {
                  "id": "two_dimensional",
                  "text": "A table covering every reachable (i, c) pair, including terminal boundaries."
                },
                {
                  "id": "index_only",
                  "text": "An array indexed only by i because DP tables should follow input positions."
                }
              ],
              "acceptedOptionIds": [
                "two_dimensional"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The uncompressed table should represent the full state pair so each cell has one unambiguous meaning.",
              "details": "A table cell is a materialized state result. Because both i and c distinguish future behavior, the direct representation has one axis for each. A later proof may make the item layer implicit and compress storage, but beginning with a one-axis table would mix semantic states before dependencies and update order are understood. Include terminal rows or columns that the transition reads.",
              "wrongOptionExplanationsByOptionId": {
                "index_only": "Different capacities at the same item index can have different feasible choices and values, so they cannot share one cell.",
                "capacity_only": "Without a proven layer schedule or compression, the table would lose which item suffix or prefix the value represents."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "tabulate_subproblems_bottom_up",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "choose_or_skip"
            }
          },
          {
            "id": "alg-dpintro-tabulation-03-dense-table-cost",
            "prompt": "A bottom-up alignment table has (m + 1)(n + 1) cells and performs O(1) work per cell. Select its time and table space.",
            "constraints": [
              "The full table is retained.",
              "Input strings are not counted as extra space."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(m + n)",
                  "O(mn)",
                  "O(mn log(mn))",
                  "O(2^(m+n))"
                ],
                "space": [
                  "O(1)",
                  "O(m + n)",
                  "O(mn)",
                  "O(2^(m+n))"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(mn)"
                ],
                "space": [
                  "O(mn)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {},
                "space": {}
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "There are Θ(mn) cells and each is computed once with constant transition work.",
              "details": "The extra boundary row and column do not change the Θ(mn) state count. Visiting each cell once gives O(mn) time, and retaining every cell gives O(mn) extra space. A memoized version has the same worst-case bound when all pairs are reachable. Tabulation may still be faster in practice through contiguous access and no recursive calls, while row compression can reduce space only after a dependency proof."
            },
            "taxonomy": {
              "primarySkillAtomId": "tabulate_subproblems_bottom_up",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "sequence_alignment_intro"
            }
          },
          {
            "id": "alg-dpintro-tabulation-04-bottom-up-lifecycle",
            "prompt": "Order the core stages of a bottom-up DP computation.",
            "constraints": [
              "The state, transition, and dependency direction are already defined."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "allocate_domain",
                  "text": "Allocate the complete state domain, including boundary states."
                },
                {
                  "id": "seed_bases",
                  "text": "Initialize every base and impossible-state sentinel."
                },
                {
                  "id": "fill_states",
                  "text": "Evaluate nonterminal states in a dependency-safe order."
                },
                {
                  "id": "extract_answer",
                  "text": "Read the state that represents the original problem."
                }
              ],
              "canonicalOrder": [
                "allocate_domain",
                "seed_bases",
                "fill_states",
                "extract_answer"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Tabulation is valid only when semantic seeds precede dependent states and the answer is read after all of its dependencies are resolved.",
              "details": "The table shape must include every state the recurrence references, including terminal boundaries. Those states receive explicit base or sentinel values before the general fill. The traversal then follows a topological order of the recurrence. Reading the original-problem cell earlier would expose a default or partial value rather than the completed DP result."
            },
            "taxonomy": {
              "primarySkillAtomId": "tabulate_subproblems_bottom_up",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "grid_path_dp"
            }
          },
          {
            "id": "alg-dpintro-tabulation-05-compress-after-reference-table",
            "prompt": "What is the strongest way to justify replacing a full grid DP table with one row?",
            "constraints": [
              "The full recurrence is already correct.",
              "Only the final value is required."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "read_equivalence",
                  "text": "Prove every one-row read represents the same logical predecessor as in the full table."
                },
                {
                  "id": "same_big_o_time",
                  "text": "Show both versions have O(rows × columns) time and return the same kind of result."
                },
                {
                  "id": "one_row_common",
                  "text": "Use one row because that optimization is common for grid recurrences with neighboring dependencies."
                }
              ],
              "acceptedOptionIds": [
                "read_equivalence"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correctness depends on preserving the logical version of every dependency, not on matching asymptotic time or a common pattern.",
              "details": "The full table provides an unambiguous reference: each transition names exact predecessor cells. A rolling implementation must map every array read to those same logical values at the moment it occurs. This proof exposes whether update order overwrites a needed predecessor. Complexity and convention are secondary; semantic read equivalence is decisive.",
              "wrongOptionExplanationsByOptionId": {
                "same_big_o_time": "Equal time complexity does not prove that in-place reads refer to the correct logical layer.",
                "one_row_common": "A familiar optimization is not a proof; diagonal, multi-row, or reconstruction dependencies can invalidate it."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "tabulate_subproblems_bottom_up",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "state_compression",
              "problemArchetypeId": "grid_path_dp"
            }
          },
          {
            "id": "alg-dpintro-tabulation-06-unreachable-state-initialization",
            "prompt": "A minimum-cost table contains states that may be unreachable. Valid costs are nonnegative. How should unreachable cells be initialized?",
            "constraints": [
              "The transition takes a minimum.",
              "A reachable base is initialized separately."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero",
                  "text": "Use 0 because newly allocated numeric arrays start at zero."
                },
                {
                  "id": "negative_infinity",
                  "text": "Use -infinity so the sentinel is clearly special."
                },
                {
                  "id": "positive_infinity",
                  "text": "Use +infinity or an explicit unreachable marker so an unreachable state cannot win a minimum."
                }
              ],
              "acceptedOptionIds": [
                "positive_infinity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "For minimization, unreachable states must be worse than every valid cost, so +infinity or explicit reachability is safe.",
              "details": "A table default participates in transitions unless guarded. Zero is a legitimate low cost and can be selected as if an impossible predecessor were feasible. Positive infinity is dominated by any finite reachable cost and propagates impossibility until a valid transition reaches the state. For maximization the safe polarity is typically negative infinity; counting often uses zero ways.",
              "wrongOptionExplanationsByOptionId": {
                "zero": "Zero would look better than every positive valid cost and create paths that do not exist.",
                "negative_infinity": "Negative infinity would always win a minimum and contaminate every dependent state."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "tabulate_subproblems_bottom_up",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "tabulation",
              "problemArchetypeId": "optimize_prefix_or_suffix"
            }
          },
          {
            "id": "alg-dpintro-tabulation-07-grid-boundary-transfer",
            "prompt": "A path-count table uses dp[r][c] = dp[r - 1][c] + dp[r][c - 1] for interior open cells. Which bottom-up plan is correct?",
            "constraints": [
              "Moves are only right and down.",
              "The origin is open.",
              "Out-of-bounds reads are not allowed."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "reverse_without_recurrence_change",
                  "text": "Fill from bottom-right to top-left using the same predecessor formula."
                },
                {
                  "id": "boundaries_then_interior",
                  "text": "Seed the origin, initialize or guard the first row and first column, then fill interior cells from top-left toward bottom-right."
                },
                {
                  "id": "interior_first",
                  "text": "Fill interior cells first and initialize the first row and column afterward."
                }
              ],
              "acceptedOptionIds": [
                "boundaries_then_interior"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The recurrence's predecessors lie above and left, so boundaries must exist first and traversal must move toward their dependents.",
              "details": "The origin is the seed; cells on the first row or column have only one possible predecessor and need a boundary rule or an explicit guard. Once those values are valid, row-major traversal from top-left ensures both predecessors of every interior cell are available. A reverse traversal could work only with a reformulated recurrence using down and right successors.",
              "wrongOptionExplanationsByOptionId": {
                "interior_first": "Interior cells read those boundary values, so computing them first consumes unresolved data.",
                "reverse_without_recurrence_change": "That order reads cells above and left that have not yet been computed under the stated formulation."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "tabulate_subproblems_bottom_up",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "two_dimensional_dp",
              "problemArchetypeId": "grid_path_dp"
            }
          }
