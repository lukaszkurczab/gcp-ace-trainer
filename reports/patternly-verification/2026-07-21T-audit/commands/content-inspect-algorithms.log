        "items": [
          {
            "id": "recursion-basics-make-progress-toward-base-case-linked-suffix-size-as-progress-measure",
            "prompt": "visit(node) processes node and then recursively calls visit(node.next) until node is None.\nWhich argument proves that every branch terminates for an acyclic finite list?",
            "constraints": [
              "The list is finite and acyclic.",
              "Every non-terminal call recurses exactly on node.next."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "remaining_nodes_decrease",
                  "text": "The number of nodes reachable from node is a non-negative integer that decreases by one."
                },
                {
                  "id": "function_is_recursive",
                  "text": "The language runtime recognizes recursion and therefore stops it automatically."
                },
                {
                  "id": "node_values_change",
                  "text": "The stored node values eventually become smaller."
                },
                {
                  "id": "base_case_exists",
                  "text": "A node-is-None base case exists somewhere in the code."
                }
              ],
              "acceptedOptionIds": [
                "remaining_nodes_decrease"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Finite remaining-list size is well founded and strictly decreases when the call advances to node.next.",
              "details": "A termination proof needs a measure into a well-founded set, usually the non-negative integers, and a strict decrease on every recursive edge. For a finite acyclic list, let m(node) be the number of nodes reachable from node. The terminal node None has measure 0, and node.next has measure m(node) - 1 for every non-terminal node. Stored values are irrelevant. This proof also states its boundary: it fails for cyclic structures unless the state or algorithm prevents revisiting nodes.",
              "wrongOptionExplanationsByOptionId": {
                "function_is_recursive": "Runtimes allocate frames but do not prove progress. An unchanged node or a cycle would keep creating calls until stack failure.",
                "node_values_change": "The traversal does not modify or order node values, so their magnitudes provide no progress measure. Termination depends on link structure.",
                "base_case_exists": "A base case matters only if every valid recursive path reaches it. A cyclic list or an unchanged recursive argument could make it unreachable."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prove_recursive_progress",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "recursive_decomposition",
              "problemArchetypeId": "traverse_recursive_structure"
            }
          },
          {
            "id": "recursion-basics-make-progress-toward-base-case-construct-progress-proof",
            "prompt": "Order the steps for proving that every recursive branch reaches a base case.",
            "constraints": [
              "The function's semantic result contract is already fixed.",
              "The proof concerns termination of all legal recursive paths, not average behavior on selected examples."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "define_domain",
                  "text": "State the legal recursive states and all recursive transitions."
                },
                {
                  "id": "choose_measure",
                  "text": "Map each legal state to a value in a well-founded set such as the non-negative integers."
                },
                {
                  "id": "prove_strict_decrease",
                  "text": "Show that every recursive transition makes the measure strictly smaller."
                },
                {
                  "id": "connect_minimum_to_terminal",
                  "text": "Show that states at the measure's minimum are covered by terminal rules."
                }
              ],
              "canonicalOrder": [
                "define_domain",
                "choose_measure",
                "prove_strict_decrease",
                "connect_minimum_to_terminal"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A progress proof covers the whole state domain, every branch, and the terminal boundary of a well-founded measure.",
              "details": "The domain and transition list come first because an omitted branch can invalidate an otherwise correct argument. The measure must be defined for every legal state and cannot descend forever. Each recursive edge must strictly decrease it; non-increase is insufficient because equal-measure cycles remain possible. Finally, the minimum or terminal region of the measure must be handled without another recursive call. This structure applies to lengths, remaining nodes, numeric distances, tree heights, and divide-and-conquer ranges. Saying only “the input is smaller” omits the exact comparison and often hides an uncovered edge case."
            },
            "taxonomy": {
              "primarySkillAtomId": "prove_recursive_progress",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "recursive_decomposition",
              "problemArchetypeId": "compute_from_smaller_input"
            }
          },
          {
            "id": "recursion-basics-make-progress-toward-base-case-palindrome-crossed-interval-progress",
            "prompt": "pal(l, r) compares s[l] and s[r], then calls pal(l + 1, r - 1) when they match.\nWhich terminal condition completes the progress proof for every finite inclusive interval?",
            "constraints": [
              "The interval is inclusive.",
              "The recursive transition changes both boundaries by one.",
              "A zero- or one-character interval is already a palindrome."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "l_greater_equal_r",
                  "text": "Stop when l >= r."
                },
                {
                  "id": "l_equal_r_only",
                  "text": "Stop only when l == r."
                },
                {
                  "id": "l_greater_r_only",
                  "text": "Stop only when l > r."
                },
                {
                  "id": "r_equal_zero",
                  "text": "Stop when r == 0."
                }
              ],
              "acceptedOptionIds": [
                "l_greater_equal_r"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Removing both endpoints reaches size zero for even lengths and size one for odd lengths, so both l > r and l == r are terminal.",
              "details": "Use remaining length max(0, r - l + 1) as the progress measure. A non-terminal pair comparison requires l < r, and the child removes two positions. Odd lengths eventually have one center character, represented by l == r. Even lengths eventually have no character, represented by l > r. Both require no recursive work. This boundary generalizes to step sizes larger than one: terminal conditions must cover every residue class or overshoot state reachable under the transition, not only one visually convenient endpoint.",
              "wrongOptionExplanationsByOptionId": {
                "l_equal_r_only": "Even-length intervals move from two characters to l > r. Equality alone misses that reachable terminal state and can lead to invalid indexing.",
                "l_greater_r_only": "Odd-length intervals reach l == r, where no pair remains. Recursing again would compare the center character with itself and then cross unnecessarily.",
                "r_equal_zero": "The absolute right index is not a measure of remaining interval size. Many valid terminal and non-terminal intervals have unrelated r values."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prove_recursive_progress",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "base_case_recognition",
              "problemArchetypeId": "compute_from_smaller_input"
            }
          },
          {
            "id": "recursion-basics-make-progress-toward-base-case-balanced-split-child-ranges",
            "prompt": "solve(lo, hi) handles the half-open range [lo, hi). When hi - lo > 1 it sets\nmid = lo + (hi - lo) // 2 and recursively solves [lo, mid) and [mid, hi).\nWhich fact is required for termination?",
            "constraints": [
              "lo and hi are integers with lo <= hi.",
              "Recursion occurs only when hi - lo > 1.",
              "The split uses floor integer division as shown."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_children_strictly_shorter",
                  "text": "Each child range has non-negative length strictly less than hi - lo."
                },
                {
                  "id": "combined_lengths_equal_parent",
                  "text": "The two child lengths add to the parent length."
                },
                {
                  "id": "mid_is_integer",
                  "text": "mid is an integer."
                },
                {
                  "id": "two_calls_eventually_cancel",
                  "text": "The two recursive calls cancel one another's stack growth."
                }
              ],
              "acceptedOptionIds": [
                "both_children_strictly_shorter"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "For every non-terminal parent, lo < mid < hi makes both child lengths strictly smaller than the parent length.",
              "details": "Let m(lo, hi) = hi - lo. The terminal region is m <= 1. For m > 1, floor division places mid strictly between lo and hi, so m(lo, mid) and m(mid, hi) are both positive and both less than m(lo, hi). This proves termination on every branch. The fact that child ranges partition the parent is important for result correctness but is a separate obligation. The transfer rule for divide and conquer is to prove strict decrease independently for every generated child, not merely that the children collectively resemble the parent.",
              "wrongOptionExplanationsByOptionId": {
                "combined_lengths_equal_parent": "Coverage of the parent supports correctness, but it does not alone prove each branch is smaller. A split could include one unchanged child and one empty child.",
                "mid_is_integer": "Integer type does not establish that mid lies strictly inside a non-terminal interval. The inequalities lo < mid < hi are the decisive property.",
                "two_calls_eventually_cancel": "Calls do not cancel. Each branch must independently reach a terminal range under a well-founded measure."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "prove_recursive_progress",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "divide_and_combine",
              "problemArchetypeId": "divide_problem"
            }
          },
          {
            "id": "recursion-basics-make-progress-toward-base-case-step-two-terminal-overshoot",
            "prompt": "pairCount(i) counts complete adjacent pairs in a[i:] and recursively calls pairCount(i + 2).\nIt must work for arrays of either parity. Which terminal condition is required?",
            "constraints": [
              "The array is immutable.",
              "Each non-terminal call consumes exactly two positions.",
              "Only complete pairs contribute to the result."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "i_greater_equal_length",
                  "text": "Stop when i + 1 >= len(a)."
