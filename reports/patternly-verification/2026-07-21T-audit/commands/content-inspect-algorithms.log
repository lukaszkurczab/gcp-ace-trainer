      {
        "id": "alg-greedy-intro-ig-002",
        "prompt": "The last selected half-open interval ends at 5. Remaining candidates are X=[4,6), Y=[5,7), and Z=[7,9). Which interval should the canonical maximum-cardinality greedy scan select next?",
        "constraints": [
          "Candidates are compared only if they are feasible against currentEnd=5.",
          "Every selected interval contributes one."
        ],
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "select_y",
