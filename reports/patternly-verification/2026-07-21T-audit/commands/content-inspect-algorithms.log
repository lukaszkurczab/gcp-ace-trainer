          {
            "id": "algorithms-intervals-insert-005",
            "prompt": "Insert [3, 5) into the half-open list [1, 3), [7, 9). The product preserves back-to-back booking boundaries. What is the output?",
            "constraints": [
              "Equality at an endpoint is non-overlap.",
              "Existing intervals are sorted and disjoint."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "keep_touching_separate",
                  "text": "[1, 3), [3, 5), [7, 9)"
                },
                {
                  "id": "merge_first",
                  "text": "[1, 5), [7, 9)"
                },
                {
                  "id": "merge_all",
                  "text": "[1, 9)"
                }
              ],
              "acceptedOptionIds": [
                "keep_touching_separate"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The old interval with end == new.start is strictly before the new interval under the half-open, boundary-preserving policy.",
              "details": "The before-phase condition is old.end <= new.start. Because 3 <= 3, [1, 3) is copied unchanged. The overlap phase then compares [7, 9) with [3, 5); 7 < 5 is false, so append the new interval and then the remaining old interval. A common bug uses old.end < new.start, which treats equality as potential overlap and later merges the touching ranges. Closed intervals or a coalescing union policy would use different equality behavior, so the exact loop conditions must be derived from the declared contract.",
              "wrongOptionExplanationsByOptionId": {
                "merge_first": "Using '<' instead of '<=' in the before phase would incorrectly send [1, 3) into the merge phase and erase a legal boundary.",
                "merge_all": "The new interval also has a positive gap before [7, 9), so merging all three adds uncovered time."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "insert_interval_into_merged_sequence",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "insert_interval",
              "problemArchetypeId": "insert_into_merged_intervals"
            }
          },
          {
            "id": "algorithms-intervals-insert-006",
            "prompt": "Order the operations for inserting one interval into a start-sorted, pairwise non-overlapping sequence.",
            "constraints": [
              "The new interval may absorb several existing intervals.",
              "The output length must not be extended by duplicate copies."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "copy_before",
                  "text": "Copy every existing interval that ends before or at the new start under the half-open policy."
                },
                {
                  "id": "merge_overlaps",
                  "text": "While the next interval overlaps the growing new interval, update the new bounds."
                },
                {
                  "id": "append_merged_new",
                  "text": "Append the final merged new interval exactly once."
                },
                {
                  "id": "copy_after",
                  "text": "Copy all remaining existing intervals unchanged."
                }
              ],
              "canonicalOrder": [
                "copy_before",
                "merge_overlaps",
                "append_merged_new",
                "copy_after"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Sorted disjoint input creates contiguous before, overlap, and after regions; the new interval is appended only after its overlap region is complete.",
              "details": "Copying before intervals first preserves order. The merge phase must precede appending the new interval because its bounds may expand with every overlapping old interval. Once the first strictly after interval is reached, the sorted-disjoint invariant proves that no later old interval can overlap the final new range. Appending the new interval before completing the merge would require editing output; appending it after copying the remainder would break order. Each adjacent relation therefore corresponds to a correctness dependency rather than a cosmetic implementation preference."
            },
            "taxonomy": {
              "primarySkillAtomId": "insert_interval_into_merged_sequence",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "insert_interval",
              "problemArchetypeId": "insert_into_merged_intervals"
            }
          },
          {
            "id": "algorithms-intervals-insert-007",
            "prompt": "The existing intervals are sorted by end but are not guaranteed to be sorted by start or pairwise disjoint. May the standard linear insertion scan be applied unchanged?",
            "constraints": [
              "The scan assumes a single contiguous before/overlap/after partition."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "normalize_first",
                  "text": "No; validate or normalize to start-sorted, pairwise non-overlapping form first."
                },
                {
                  "id": "end_order_sufficient",
                  "text": "Yes; end sorting is sufficient for every interval scan."
                },
                {
                  "id": "length_check_sufficient",
                  "text": "Yes, if the new interval is shorter than every existing interval."
                }
