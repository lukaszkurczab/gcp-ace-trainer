              "acceptedOptionIds": [
                "plus_l_minus_r_plus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Moving the removal to r + 1 converts inclusive [l, r] into the equivalent half-open [l, r + 1).",
              "details": "On a discrete integer line, [l, r] contains l, l + 1, ..., r. The difference update +1 at l and -1 at r + 1 keeps the prefix active through r and removes it before the next integer. The conversion requires a safe successor; if r is the maximum representable value, adding one can overflow and the representation must change. This transfer reuses half-open sweep mechanics while preserving closed input meaning. It is not valid for continuous coordinates, where there is no unique next point after r.",
              "wrongOptionExplanationsByOptionId": {
                "plus_l_minus_r": "That removes the interval before counting r, turning an inclusive end into an exclusive one.",
                "plus_both": "The second event must remove the contribution; adding again makes the prefix persist."
              }
            },
