          },
          {
            "id": "alg-contrast-hash-sort-cost-020",
            "prompt": "A hash table doubles its capacity when a load threshold is crossed. Across n expected O(1) insertions, resizing copies all existing entries at geometric capacities. Select expected sequence time, worst cost of one resizing insertion, and table space.",
            "constraints": [
              "Capacities grow geometrically.",
              "Hash distribution assumptions support expected O(1) non-resizing insertions.",
              "A resizing insertion may copy Θ(n) current entries."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "sequence_time",
                "single_insertion_worst",
                "table_space"
              ],
              "availableValuesByDimension": {
                "sequence_time": [
                  "O(n)",
                  "O(n log n)",
                  "O(n²)",
                  "O(2^n)"
                ],
                "single_insertion_worst": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ],
                "table_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n²)"
                ]
              },
              "acceptedValuesByDimension": {
                "sequence_time": [
                  "O(n)"
                ],
                "single_insertion_worst": [
                  "O(n)"
                ],
                "table_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "sequence_time": {
                  "geometric_resize_amortization": "O(n)"
                },
                "single_insertion_worst": {
                  "resize_copy": "O(n)"
                },
                "table_space": {
                  "entries_and_capacity": "O(n)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Geometric resizing copies each earlier entry only across logarithmically spaced capacity changes, so total copying is linear.",
              "details": "This distinguishes expected or amortized sequence cost from the worst cost of one operation and prevents treating every hash insertion as a deterministic O(1)."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_expected_hash_and_sorting_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-cost-021",
            "prompt": "A comparison-based algorithm must put n arbitrary distinct keys into total sorted order. Select the comparison lower bound and the time of a matching optimal comparison sort.",
            "constraints": [
              "Only pairwise key comparisons reveal order.",
              "No bounded-key counting or radix assumption is available."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "comparison_lower_bound",
                "optimal_sort_time"
