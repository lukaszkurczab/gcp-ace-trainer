            "id": "alg-arrays-frequency-state-018",
            "prompt": "Two strings contain lowercase English letters. The task is to determine whether they contain the same characters with the same multiplicities, while character order is irrelevant. Which approach matches the required state?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "compare_frequency_arrays",
                  "text": "Build character-frequency arrays and compare all counters."
                },
                {
                  "id": "compare_seen_sets",
                  "text": "Compare only the sets of characters that appear."
                },
                {
                  "id": "compare_first_characters",
                  "text": "Compare only the first character of each string."
                },
                {
                  "id": "compare_lengths_only",
                  "text": "Equal lengths alone prove equal multiplicities."
                }
              ],
              "acceptedOptionIds": [
                "compare_frequency_arrays"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equal multiplicities require count state for every relevant character.",
              "details": "Because order is irrelevant, positions need not be preserved. However, presence alone is insufficient: strings can use the same distinct characters with different counts. Frequency arrays preserve exactly the needed information.",
              "wrongOptionExplanationsByOptionId": {
                "compare_seen_sets": "Sets cannot distinguish different multiplicities of the same characters.",
                "compare_first_characters": "The first position does not summarize the remaining characters or their counts.",
                "compare_lengths_only": "Equal total length does not imply that each character count matches."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_frequency_state",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-frequency-state-019",
            "prompt": "An algorithm scans n values from a domain of size R, updates an R-entry counter array, and then scans all R counters to find the most frequent value. Select its time, auxiliary-space, and output-space complexity.",
            "constraints": [
              "The counter array is temporary.",
              "The result is one value and one count."
            ],
            "difficulty": "easy",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space",
                "output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n)",
                  "O(R)",
                  "O(n + R)",
                  "O(nR)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(R)",
                  "O(n)"
                ],
                "output_space": [
                  "O(1)",
                  "O(R)",
                  "O(n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n + R)"
                ],
                "auxiliary_space": [
                  "O(R)"
                ],
                "output_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "scan_input_and_domain": "O(n + R)"
                },
                "auxiliary_space": {
                  "domain_counters": "O(R)"
                },
                "output_space": {
                  "single_result": "O(1)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The algorithm traverses both the input and the counter domain, while the counters are temporary state.",
              "details": "Updating counts costs O(n), and finding the maximum across R counters costs O(R). The R counters are auxiliary space; returning one value and count is constant-size output."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_frequency_state",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          },
          {
            "id": "alg-arrays-frequency-state-020",
            "prompt": "A function scans n values, builds a temporary frequency map with d keys, and returns a new array containing the k values whose frequency is exactly one. Select its expected time, auxiliary-space, and output-space complexity.",
            "constraints": [
              "Hash-map updates are expected O(1).",
              "The map is not returned."
            ],
            "difficulty": "easy",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space",
                "output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(n)",
                  "O(n + d)",
                  "O(n log n)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(d)",
                  "O(k)"
                ],
                "output_space": [
                  "O(1)",
                  "O(d)",
                  "O(k)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)",
                  "O(n + d)"
                ],
                "auxiliary_space": [
                  "O(d)"
                ],
                "output_space": [
                  "O(k)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "linear_expected": "O(n)"
                },
                "auxiliary_space": {
                  "distinct_keys": "O(d)"
                },
                "output_space": {
                  "unique_values": "O(k)"
                }
              },
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The map stores one count per distinct key, while the returned array stores only qualifying values.",
              "details": "The input scan is expected O(n), and iterating over d map entries is O(d), which is bounded by n. The temporary map is O(d) auxiliary space, and the required result is O(k) output space."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_frequency_state",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "count_or_group_values"
            }
          }
        ],
