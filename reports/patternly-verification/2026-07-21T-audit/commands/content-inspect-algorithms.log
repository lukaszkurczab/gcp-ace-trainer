                  "text": "Charge at most one later pop to that same occurrence."
                },
                {
                  "id": "add_scan_work",
                  "text": "Add the O(1) outer-scan work performed for each input occurrence."
                },
                {
                  "id": "derive_linear_total",
                  "text": "Bound total work by O(n) scan steps plus at most n pushes and n pops."
                },
                {
                  "id": "label_entries",
                  "text": "Give every input occurrence a stable identity."
                },
                {
                  "id": "count_pushes",
                  "text": "Count one push when each occurrence first becomes a candidate."
