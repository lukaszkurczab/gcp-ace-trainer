          {
            "id": "alg-mg-normalize-floating-circular-comparison",
            "prompt": "Two floating angle calculations should represent the same direction: one produces 0.1+0.2 turns and the other 0.3 turns. After normalization to [0,1), how should equivalence be tested?",
            "constraints": [
              "The values come from floating arithmetic.",
              "A positive tolerance eps is defined by the application error budget."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "circular_distance_tolerance",
                  "text": "Compute the minimum circular distance between the normalized values and compare it with eps."
                },
                {
                  "id": "exact_equality",
                  "text": "Compare the normalized values with ==."
                },
                {
                  "id": "round_to_integer",
                  "text": "Round both values to the nearest whole turn and compare."
                },
                {
                  "id": "compare_raw_difference",
                  "text": "Compare |a-b| only, without considering the wrap boundary."
                }
              ],
              "acceptedOptionIds": [
                "circular_distance_tolerance"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Floating equality needs a tolerance, and cyclic values require distance measured across the wrap as well as directly.",
              "details": "Binary floating arithmetic need not represent 0.1, 0.2, or 0.3 exactly. Even after normalization, values near 0 and 1 may represent nearly the same direction while their raw difference is close to one. A circular distance such as min(|a-b|,1-|a-b|) captures the topology of the cycle, and eps supplies the application’s acceptable error. Exact equality remains appropriate only for exact representations.",
              "wrongOptionExplanationsByOptionId": {
                "exact_equality": "Equivalent computations can differ by a few floating units, so == is too brittle for the stated data.",
                "round_to_integer": "Rounding to whole turns destroys meaningful fractional-angle information.",
                "compare_raw_difference": "Raw difference fails near the wrap, where 0.999999 and 0.000001 are close directions."
              }
            },
            "difficulty": "foundational-transfer",
            "taxonomy": {
