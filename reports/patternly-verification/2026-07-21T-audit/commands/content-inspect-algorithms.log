        "items": [
          {
            "id": "alg-bits-lowest-001",
            "prompt": "For a positive fixed-width unsigned integer x, what does x AND (x - 1) do?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "clear_lowest_one",
                  "text": "It clears the lowest set bit and preserves all higher bits."
                },
                {
                  "id": "isolate_lowest_one",
                  "text": "It keeps only the lowest set bit."
                },
                {
                  "id": "set_lowest_zero",
                  "text": "It sets the lowest clear bit."
                },
                {
                  "id": "shift_right",
                  "text": "It shifts every bit right by one."
                }
              ],
              "acceptedOptionIds": [
                "clear_lowest_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Subtracting one flips the lowest set bit to zero and turns lower zeros into ones.",
              "details": "AND with the original x removes that one while leaving higher bits unchanged.",
              "wrongOptionExplanationsByOptionId": {
                "isolate_lowest_one": "That is x AND -x under two's-complement arithmetic.",
                "set_lowest_zero": "The operation removes a set bit.",
                "shift_right": "Higher bit positions remain in place."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-lowest-002",
            "prompt": "Under a fixed-width two's-complement model, what does x AND -x isolate for nonzero x?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "lowest_one",
                  "text": "A one-hot mask containing only x's lowest set bit."
                },
                {
                  "id": "highest_one",
                  "text": "Only the highest set bit."
                },
                {
                  "id": "all_ones",
                  "text": "Every set bit of x."
                },
                {
                  "id": "zero",
                  "text": "Always zero."
                }
              ],
              "acceptedOptionIds": [
                "lowest_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Two's-complement negation preserves the lowest one position in both x and -x.",
              "details": "AND leaves exactly that shared lowest set bit.",
              "wrongOptionExplanationsByOptionId": {
                "highest_one": "Negation does not preserve only the most significant one.",
                "all_ones": "Higher set bits do not all survive the AND.",
                "zero": "A nonzero fixed-width pattern has a lowest set bit."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            },
            "constraints": [
              "Use one fixed width and two's-complement negation."
            ]
          },
          {
            "id": "alg-bits-lowest-003",
            "prompt": "What are 0 AND (0 - 1) and 0 AND -0 in a fixed-width unsigned/two's-complement bit model?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_zero",
                  "text": "Both are zero."
                },
                {
                  "id": "first_all_ones",
                  "text": "The first result is all ones."
                },
                {
                  "id": "second_all_ones",
                  "text": "The second result is all ones."
                },
                {
                  "id": "undefined_both",
                  "text": "Both are necessarily undefined."
                }
              ],
              "acceptedOptionIds": [
                "both_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Zero contains no set bit to remove or isolate.",
              "details": "Both AND expressions therefore produce zero.",
              "wrongOptionExplanationsByOptionId": {
                "first_all_ones": "Although 0 - 1 wraps to all ones in unsigned arithmetic, AND with zero is zero.",
                "second_all_ones": "-0 is still zero.",
                "undefined_both": "The question supplies a fixed-width bit model."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            },
            "constraints": [
              "Use fixed-width unsigned subtraction for 0 - 1 and fixed-width two's-complement negation."
            ]
          },
          {
            "id": "alg-bits-lowest-004",
            "prompt": "What is 10110000 AND (10110000 - 1) in 8-bit unsigned arithmetic?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bits_10100000",
                  "text": "10100000."
                },
                {
                  "id": "bits_00010000",
                  "text": "00010000."
                },
                {
                  "id": "bits_10101111",
                  "text": "10101111."
                },
                {
                  "id": "bits_01011000",
                  "text": "01011000."
                }
              ],
              "acceptedOptionIds": [
                "bits_10100000"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The lowest set bit is at position 4.",
              "details": "Subtracting one gives 10101111, and AND clears position 4 while preserving the higher set bits.",
              "wrongOptionExplanationsByOptionId": {
                "bits_00010000": "That isolates the lowest set bit rather than clearing it.",
                "bits_10101111": "That is x - 1 before the AND.",
                "bits_01011000": "That resembles a right shift."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            },
            "constraints": [
              "Use exactly 8 unsigned bits."
            ]
          },
          {
            "id": "alg-bits-lowest-005",
            "prompt": "What is 10110000 AND -10110000 under 8-bit two's-complement arithmetic?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bits_00010000",
                  "text": "00010000."
                },
                {
                  "id": "bits_10100000",
                  "text": "10100000."
                },
                {
                  "id": "bits_01010000",
                  "text": "01010000."
                },
                {
                  "id": "bits_11110000",
                  "text": "11110000."
                }
              ],
              "acceptedOptionIds": [
                "bits_00010000"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The lowest set position of 10110000 is bit 4.",
              "details": "The x AND -x identity produces the one-hot mask 00010000.",
              "wrongOptionExplanationsByOptionId": {
                "bits_10100000": "That is the lowest-set-bit removal result.",
                "bits_01010000": "This retains extra higher information.",
                "bits_11110000": "The isolated result must be one-hot."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            },
            "constraints": [
              "Use exactly 8 bits and two's-complement negation."
            ]
          },
          {
            "id": "alg-bits-lowest-006",
            "prompt": "How many iterations does a loop perform if it repeatedly executes x = x AND (x - 1) until x becomes zero?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "popcount",
                  "text": "Exactly the number of set bits initially present in x."
                },
                {
                  "id": "bit_width",
                  "text": "Always the full word width."
                },
                {
                  "id": "numeric_value",
                  "text": "Exactly x iterations."
                },
                {
                  "id": "one",
                  "text": "Always one iteration."
                }
              ],
              "acceptedOptionIds": [
                "popcount"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Each iteration removes exactly one set bit.",
              "details": "The loop terminates after every initial one has been cleared.",
              "wrongOptionExplanationsByOptionId": {
                "bit_width": "Each iteration removes a one, not necessarily one bit position.",
                "numeric_value": "The numeric value can be much larger than its popcount.",
                "one": "Values with multiple set bits require multiple removals."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-lowest-007",
            "prompt": "If lowbit = x AND -x equals 00100000, what is the zero-based position of x's lowest set bit?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "position_5",
                  "text": "5."
                },
                {
                  "id": "position_4",
                  "text": "4."
                },
                {
                  "id": "position_6",
                  "text": "6."
                },
                {
                  "id": "position_32",
                  "text": "32."
                }
              ],
              "acceptedOptionIds": [
                "position_5"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "00100000 is the place value 2^5.",
              "details": "The one-hot mask directly identifies the lowest set-bit position.",
              "wrongOptionExplanationsByOptionId": {
                "position_4": "Bit 4 would be 00010000.",
                "position_6": "Bit 6 would be 01000000.",
                "position_32": "32 is the place value, not the zero-based position."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-lowest-008",
            "prompt": "Which expression correctly tests whether a positive unsigned x is a power of two?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "positive_and_clear_zero",
                  "text": "x is nonzero and (x AND (x - 1)) equals zero."
                },
                {
                  "id": "clear_nonzero",
                  "text": "(x AND (x - 1)) is nonzero."
                },
                {
                  "id": "lowbit_zero",
                  "text": "(x AND -x) equals zero."
                },
                {
                  "id": "xor_one",
                  "text": "x XOR 1 equals zero."
                }
              ],
              "acceptedOptionIds": [
                "positive_and_clear_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A positive power of two contains exactly one set bit.",
              "details": "Removing its lowest set bit leaves zero; the explicit nonzero check excludes x = 0.",
              "wrongOptionExplanationsByOptionId": {
                "clear_nonzero": "That means x has at least two set bits.",
                "lowbit_zero": "A nonzero x always has a nonzero lowbit.",
                "xor_one": "That recognizes only x = 1."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-lowest-009",
            "prompt": "Why should a repeated x = x AND (x - 1) bit-count loop use an unsigned or explicitly fixed-width model?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "model_clarity",
                  "text": "Subtraction, negative patterns, and termination should not depend on unspecified signed overflow or width behavior."
                },
                {
                  "id": "unsigned_faster",
                  "text": "Unsigned values are always asymptotically faster."
                },
                {
                  "id": "signed_no_bits",
                  "text": "Signed values have no bit representation."
                },
                {
                  "id": "loop_needs_sort",
                  "text": "Unsigned input is required for sorting."
                }
              ],
              "acceptedOptionIds": [
                "model_clarity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Bit identities are statements about a declared finite bit pattern.",
              "details": "Using unsigned or explicit fixed-width semantics makes wraparound and every intermediate value reviewable.",
              "wrongOptionExplanationsByOptionId": {
                "unsigned_faster": "The issue is semantic definition, not asymptotic speed.",
                "signed_no_bits": "They do, but language rules may differ.",
                "loop_needs_sort": "Sorting is unrelated."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-lowest-010",
            "prompt": "Which statements about x AND (x - 1) are correct for nonzero fixed-width unsigned x? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "removes_one",
                  "text": "It removes exactly one set bit."
                },
                {
                  "id": "higher_preserved",
                  "text": "All bit positions above the removed one keep their previous values."
                },
                {
                  "id": "lower_zero",
                  "text": "All positions below the removed bit are zero in the final result."
                },
                {
                  "id": "isolates_one",
                  "text": "It returns only the removed one bit."
                }
              ],
              "acceptedOptionIds": [
                "removes_one",
                "higher_preserved",
                "lower_zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The operation clears the lowest one without moving or changing higher positions.",
              "details": "It is a removal identity, not an isolation identity.",
              "wrongOptionExplanationsByOptionId": {
                "isolates_one": "That describes x AND -x."
              },
              "omittedCorrectExplanationsByOptionId": {
                "removes_one": "The lowest one is cleared.",
                "higher_preserved": "Subtract-one changes only at and below the lowest one.",
                "lower_zero": "Those positions were zero in x and AND keeps them zero."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-lowest-011",
            "prompt": "Which statements about x AND -x are correct under fixed-width two's-complement arithmetic? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "one_hot_nonzero",
                  "text": "For nonzero x, the result is a one-hot mask."
                },
                {
                  "id": "zero_case",
                  "text": "For x = 0, the result is 0."
                },
                {
                  "id": "place_value",
                  "text": "The unsigned result equals the place value of the lowest set bit."
                },
                {
                  "id": "removes_lowbit",
                  "text": "The result is x with its lowest set bit removed."
                }
              ],
              "acceptedOptionIds": [
                "one_hot_nonzero",
                "zero_case",
                "place_value"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The lowbit identity isolates one position rather than returning the remainder of x.",
              "details": "Its signed numeric interpretation may be awkward at the sign position, so the bit-pattern contract should remain explicit.",
              "wrongOptionExplanationsByOptionId": {
                "removes_lowbit": "That is x AND (x - 1)."
              },
              "omittedCorrectExplanationsByOptionId": {
                "one_hot_nonzero": "Exactly the lowest one survives.",
                "zero_case": "Zero has no set bit.",
                "place_value": "A one-hot bit at k has value 2^k."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            },
            "constraints": [
              "Use one fixed width and two's-complement negation."
            ]
          },
          {
            "id": "alg-bits-lowest-012",
            "prompt": "Which tests are important for lowest-set-bit logic? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "zero",
                  "text": "x = 0."
                },
                {
                  "id": "power_two",
                  "text": "x has exactly one set bit."
                },
                {
                  "id": "lowbit_sign_position",
                  "text": "Only the most significant bit is set in the fixed-width word."
                },
                {
                  "id": "only_many_ones",
                  "text": "Only one value with many set bits."
                }
              ],
              "acceptedOptionIds": [
                "zero",
                "power_two",
                "lowbit_sign_position"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Zero, one-hot, and sign-position cases expose different model errors.",
              "details": "Dense patterns are useful but not sufficient by themselves.",
              "wrongOptionExplanationsByOptionId": {
                "only_many_ones": "This misses the critical zero and one-hot boundaries."
              },
              "omittedCorrectExplanationsByOptionId": {
                "zero": "It verifies the no-set-bit boundary.",
                "power_two": "Removal should yield zero and isolation should return x.",
                "lowbit_sign_position": "It exercises width and signed-interpretation assumptions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-lowest-013",
            "prompt": "Arrange one iteration of Brian Kernighan's set-bit counting loop.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_nonzero",
                  "text": "Confirm x is nonzero."
                },
                {
                  "id": "remove_lowest",
                  "text": "Set x = x AND (x - 1)."
                },
                {
                  "id": "increment_count",
                  "text": "Increment the set-bit counter."
                },
                {
                  "id": "repeat",
                  "text": "Continue until x becomes zero."
                }
              ],
              "canonicalOrder": [
                "check_nonzero",
                "remove_lowest",
                "increment_count",
                "repeat"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Each iteration corresponds to exactly one removed set bit.",
              "details": "The counter therefore equals the original popcount at termination."
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            }
          },
          {
            "id": "alg-bits-lowest-014",
            "prompt": "Arrange the reasoning that x AND -x isolates the lowest set bit.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "identify_suffix",
                  "text": "Write x as a higher prefix, then its lowest one, then only zeros below."
                },
                {
                  "id": "negate_twos",
                  "text": "Form -x by complementing and adding one within the fixed width."
                },
                {
                  "id": "compare_patterns",
                  "text": "Observe that x and -x share the lowest one but differ above it."
                },
                {
                  "id": "and_patterns",
                  "text": "AND the patterns to keep only that shared one."
                }
              ],
              "canonicalOrder": [
                "identify_suffix",
                "negate_twos",
                "compare_patterns",
                "and_patterns"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The proof depends on the carry behavior of two's-complement negation.",
              "details": "Width must be fixed so complement and addition are defined."
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            },
            "constraints": [
              "Use fixed-width two's-complement negation."
            ]
          },
          {
            "id": "alg-bits-lowest-015",
            "prompt": "Arrange the steps for extracting every set-bit one-hot mask from x.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_x",
                  "text": "While x is nonzero, continue."
                },
                {
                  "id": "compute_lowbit",
                  "text": "Compute lowbit = x AND -x."
                },
                {
                  "id": "process_lowbit",
                  "text": "Use or record that one-hot mask."
                },
                {
                  "id": "remove_lowbit",
                  "text": "Set x = x AND (x - 1)."
                }
              ],
              "canonicalOrder": [
                "check_x",
                "compute_lowbit",
                "process_lowbit",
                "remove_lowbit"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Isolation identifies the next bit, and removal guarantees progress.",
              "details": "The sequence emits set bits from least significant to most significant."
            },
            "taxonomy": {
              "primarySkillAtomId": "remove_lowest_set_bit",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lowest_set_bit",
              "problemArchetypeId": "count_set_bits"
            },
            "constraints": [
              "Use fixed-width two's-complement negation."
            ]
          },
          {
            "id": "alg-bits-lowest-016",
