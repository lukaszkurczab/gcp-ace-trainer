      {
        "id": "alg-contrast-window-prefix-state-001",
        "prompt": "A single pass must report the maximum sum among all contiguous blocks of exactly k elements. Which state model is most direct?",
        "difficulty": "intro",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "moving_sum",
              "text": "Maintain the current k-element sum, subtract the outgoing value, and add the incoming value."
            },
            {
              "id": "all_prefix_queries",
              "text": "Build a full prefix array and issue one query for every block because precomputation is mandatory."
            },
            {
              "id": "recompute_each",
              "text": "Recompute each block sum from its k elements."
            },
            {
              "id": "sort_values",
              "text": "Sort values before comparing block sums."
            }
          ],
          "acceptedOptionIds": [
            "moving_sum"
          ]
