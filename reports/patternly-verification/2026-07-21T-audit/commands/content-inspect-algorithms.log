        "items": [
          {
            "id": "alg-contrast-window-prefix-objective-001",
            "prompt": "All values are positive, and the task asks for the minimum length with sum at least k. Which objective signal favors a variable window?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "threshold_min",
                  "text": "The threshold becomes true monotonically as right expands, and shrinking searches shorter valid intervals."
                },
                {
                  "id": "exact_prefix",
                  "text": "The answer requires an earlier prefix equal to currentPrefix - k."
                },
                {
                  "id": "sort_values",
                  "text": "The values should be sorted before choosing a range."
                },
                {
                  "id": "one_sum",
                  "text": "Every problem containing a sum uses the same method."
                }
              ],
              "acceptedOptionIds": [
                "threshold_min"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The inequality and positive values create a validity region that can be repaired and minimized by moving boundaries.",
              "details": "This is different from matching one exact cumulative difference.",
              "wrongOptionExplanationsByOptionId": {
                "exact_prefix": "That relation is central to exact equality, not necessary for this positive threshold objective.",
                "sort_values": "Sorting destroys contiguity.",
                "one_sum": "Objective and sign constraints decide."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-002",
            "prompt": "Values may be negative, and the task asks whether any subarray sums exactly to k. Which signal favors prefix-hash state?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "exact_difference",
                  "text": "Exact equality is expressed as currentPrefix - earlierPrefix = k without relying on monotone boundary moves."
                },
                {
                  "id": "threshold_window",
                  "text": "Shrink when sum is above k and expand when below k."
                },
                {
                  "id": "positive_assumption",
                  "text": "Treat all negative values as zero."
                },
                {
                  "id": "sort_then_scan",
                  "text": "Sort values and search adjacent blocks."
                }
              ],
              "acceptedOptionIds": [
                "exact_difference"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Exact sum is a relation between two cumulative boundaries.",
              "details": "Hashing earlier prefixes supports the relation for arbitrary signs.",
              "wrongOptionExplanationsByOptionId": {
                "threshold_window": "Mixed signs invalidate that direction.",
                "positive_assumption": "That changes the input.",
                "sort_then_scan": "Contiguity is lost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-003",
            "prompt": "All values are nonnegative, and the task asks for existence of an exact sum k. Which conclusion is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "both_possible",
                  "text": "A carefully defined window can work, while prefix methods also remain correct; workload and edge cases decide."
                },
                {
                  "id": "prefix_only",
                  "text": "Exact equality always excludes sliding window."
                },
                {
                  "id": "window_any_sign",
                  "text": "The same window is correct for arbitrary signed values."
                },
                {
                  "id": "no_method",
                  "text": "Exact equality cannot be solved on contiguous ranges."
                }
              ],
              "acceptedOptionIds": [
                "both_possible"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The words exact sum do not uniquely determine a strategy.",
              "details": "The value domain and required reuse distinguish a nonnegative window from a more general prefix representation.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_only": "Nonnegative sum movement can support equality search.",
                "window_any_sign": "Mixed signs break monotonicity.",
                "no_method": "Both mechanisms can solve it under suitable contracts."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-004",
            "prompt": "A nonnegative window has just been shrunk until its sum is at most the budget. Why should its current length be evaluated before right advances?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "record_after_repair",
                  "text": "After shrinking any over-budget interval, record the current valid length."
                },
                {
                  "id": "record_only_equal",
                  "text": "Record only when sum equals budget."
                },
                {
                  "id": "stop_first",
                  "text": "Return the first valid interval."
                },
                {
                  "id": "prefix_match",
                  "text": "Look only for prefix difference exactly equal to budget."
                }
              ],
              "acceptedOptionIds": [
                "record_after_repair"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The objective accepts every sum below or equal to the budget.",
              "details": "After monotone repair, the current interval is the longest valid one ending at right.",
              "wrongOptionExplanationsByOptionId": {
                "record_only_equal": "A longest at-most answer may have a smaller sum.",
                "stop_first": "Later intervals may be longer.",
                "prefix_match": "The inequality allows many valid sums."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-005",
            "prompt": "A static array receives many queries for the exact sum of a specified interval [l, r]. Which method is natural?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "prefix_array",
                  "text": "Use a prefix difference for the already specified boundaries."
                },
                {
                  "id": "search_window",
                  "text": "Move boundaries until the sum happens to equal the query answer."
                },
                {
                  "id": "prefix_hash",
                  "text": "Use a frequency map to discover an unknown start."
                },
                {
                  "id": "sort",
                  "text": "Sort each interval before summing."
                }
              ],
              "acceptedOptionIds": [
                "prefix_array"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Exact can describe either a target value or the arithmetic value of a known interval.",
              "details": "Here prefix subtraction answers the requested fixed boundaries directly.",
              "wrongOptionExplanationsByOptionId": {
                "search_window": "The query already supplies the boundaries.",
                "prefix_hash": "No boundary discovery is needed.",
                "sort": "Order is irrelevant to sum but sorting changes the interval representation."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-006",
            "prompt": "Values may be negative, and the task asks for the shortest interval with sum at least k. What is the safe conclusion?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "stronger_prefix_structure",
                  "text": "The simple threshold window is invalid; prefix sums with an order-aware structure may be required."
                },
                {
                  "id": "exact_hash_frequency",
                  "text": "A frequency map for prefix - k always gives the shortest at-least interval."
                },
                {
                  "id": "positive_window",
                  "text": "Use the positive-value shrink rule unchanged."
                },
                {
                  "id": "sort_values",
                  "text": "Sort and use two pointers."
                }
              ],
              "acceptedOptionIds": [
                "stronger_prefix_structure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Threshold versus exact is only one axis; sign constraints are another.",
              "details": "For this mixed-sign inequality, prefix sums combined with a monotonic deque are a known appropriate mechanism.",
              "wrongOptionExplanationsByOptionId": {
                "exact_hash_frequency": "The objective is inequality and shortest length, not exact equality count.",
                "positive_window": "Negative values reverse aggregate movement.",
                "sort_values": "Contiguity is destroyed."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-007",
            "prompt": "Which phrase most directly changes an exact-sum problem into a threshold problem?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "at_least",
                  "text": "\"sum at least k\" instead of \"sum exactly k.\""
                },
                {
                  "id": "contiguous",
                  "text": "Adding the word contiguous."
                },
                {
                  "id": "array",
                  "text": "Calling the sequence an array."
                },
                {
                  "id": "target",
                  "text": "Using the word target."
                }
              ],
              "acceptedOptionIds": [
                "at_least"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Equality selects one aggregate value; a threshold selects a range of valid values.",
              "details": "That changes answer timing and the boundary rule when monotonicity exists.",
              "wrongOptionExplanationsByOptionId": {
                "contiguous": "Both problem types already concern contiguous intervals.",
                "array": "Data-container vocabulary does not change objective semantics.",
                "target": "Both exact and threshold objectives can have targets."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-008",
            "prompt": "The result asks for how many subarrays sum exactly to k. Why is a minimum-length threshold window the wrong abstraction?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "different_result",
                  "text": "Counting every exact match requires preserving all matching start boundaries, not only one current valid window."
                },
                {
                  "id": "count_no_contiguous",
                  "text": "Counts cannot refer to contiguous intervals."
                },
                {
                  "id": "window_no_sum",
                  "text": "A window cannot maintain a sum."
                },
                {
                  "id": "prefix_sorted",
                  "text": "Prefix values must be sorted first."
                }
              ],
              "acceptedOptionIds": [
                "different_result"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The result contract requires multiplicity of exact cumulative differences.",
              "details": "A single moving left boundary discards earlier starts that may each form distinct matches.",
              "wrongOptionExplanationsByOptionId": {
                "count_no_contiguous": "They can.",
                "window_no_sum": "It can, but its state does not retain all exact starts.",
                "prefix_sorted": "Hash frequencies can count in scan order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-009",
            "prompt": "All values are positive. The task asks for the maximum length with sum exactly k. Which statement is most accurate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "window_possible",
                  "text": "A monotone window can search equality, but zeros are absent and answer timing must retain the longest matching state."
                },
                {
                  "id": "threshold_same",
                  "text": "Exact equality is identical to sum at most k."
                },
                {
                  "id": "prefix_invalid",
                  "text": "Prefix differences cannot represent exact sums."
                },
                {
                  "id": "negative_required",
                  "text": "An exact-sum window requires negative values."
                }
              ],
              "acceptedOptionIds": [
                "window_possible"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Strict positivity creates monotone sum movement even for an equality objective.",
              "details": "The algorithm must distinguish valid equality from merely below or above the target.",
              "wrongOptionExplanationsByOptionId": {
                "threshold_same": "At-most intervals with smaller sums are not answers.",
                "prefix_invalid": "They remain valid.",
                "negative_required": "Negative values weaken the simple window."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_threshold_window_from_exact_sum_prefix",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-objective-010",
            "prompt": "Which decision rule is invalid?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "word_sum",
                  "text": "Choose sliding window whenever the prompt mentions a contiguous sum."
                },
                {
                  "id": "threshold_sign",
                  "text": "For a threshold, check whether value signs create monotone boundary effects."
                },
                {
                  "id": "exact_history",
                  "text": "For exact sums with arbitrary signs, consider historical prefix lookup."
                },
                {
                  "id": "known_boundaries",
                  "text": "For many fixed-boundary queries, consider precomputed prefix differences."
