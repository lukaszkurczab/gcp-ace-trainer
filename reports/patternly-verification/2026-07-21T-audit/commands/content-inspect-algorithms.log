        "items": [
          {
            "id": "alg-stack-mono-acc-001",
            "prompt": "A design review covers Strictly increasing input after a long decreasing frontier. Explain why one iteration may pop many entries without making total time quadratic. Which statement gives the decisive justification?",
            "constraints": [
              "Use the exact output, strictness, scan direction, and tie semantics stated in the prompt.",
              "Do not classify the algorithm from a variable name or one intermediate snapshot."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "decisive_contract_rule",
                  "text": "Those entries cannot be popped again if each is pushed once and never reinserted."
                },
                {
                  "id": "target_false_heuristic",
                  "text": "A nested while loop always implies O(n²)."
                },
                {
                  "id": "surface_feature_classifier",
                  "text": "A loop nested inside the scan makes the total cost quadratic regardless of how many times each entry can actually be removed."
                },
                {
                  "id": "unjustified_alternative_rule",
                  "text": "The maximum stack size multiplied by the input length is always the exact running time, independent of the executed operations."
                }
              ],
              "acceptedOptionIds": [
                "decisive_contract_rule"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Those entries cannot be popped again if each is pushed once and never reinserted. This is the decisive boundary for the stated output and retained-state semantics.",
              "details": "The item is decided by aggregate operation counts versus work attached to each transition, not by a surface feature. Those entries cannot be popped again if each is pushed once and never reinserted. The tempting claim—A nested while loop always implies O(n²).—fails because it does not establish the semantic invariant that makes removal or retention safe. Transfer the aggregate or potential proof only when each entry has a bounded number of constant-work transitions; count any attached scan, copy, or nonconstant work separately.",
              "wrongOptionExplanationsByOptionId": {
                "target_false_heuristic": "This is the targeted misconception. Those entries cannot be popped again if each is pushed once and never reinserted. The quoted clue does not establish that invariant or justify the removal rule.",
                "surface_feature_classifier": "This relies on a surface feature instead of the contract. The correct decision follows from aggregate operation counts versus work attached to each transition; payload type or implementation shape alone is not diagnostic.",
                "unjustified_alternative_rule": "This changes the representation or transition without proving that it preserves the requested result. Those entries cannot be popped again if each is pushed once and never reinserted."
              }
