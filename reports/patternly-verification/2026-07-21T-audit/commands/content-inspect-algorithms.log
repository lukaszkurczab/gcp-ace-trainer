            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-queries-019",
            "prompt": "Sort n values once and answer q exact queries by binary search. Select total time and auxiliary space for an in-place O(n log n) sort using O(log n) stack.",
            "constraints": [
              "Input mutation is legal."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n + q)",
                  "O(n log n + q log n)",
                  "O(qn)",
                  "O(n²)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(q)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log n + q log n)"
                ],
                "auxiliary_space": [
                  "O(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "sort_and_queries": "O(n log n + q log n)"
                },
                "auxiliary_space": {
                  "sort_stack": "O(log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The one-time ordering cost is followed by logarithmic queries.",
              "details": "The path also provides reusable ordered traversal not offered by a plain hash set."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-queries-020",
            "prompt": "Compare q full scans, O(qn), with sorting once and binary-searching, O(n log n + q log n). What asymptotic query volume is sufficient for the sorting path to break even when n is large?",
            "constraints": [
              "Assume comparison and scan primitive costs are comparable.",
              "Use an asymptotic threshold rather than an exact machine-dependent constant."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "break_even_q"
              ],
              "availableValuesByDimension": {
                "break_even_q": [
                  "Θ(1)",
                  "Θ(log n)",
                  "Θ(n)",
                  "Θ(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "break_even_q": [
                  "Θ(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "break_even_q": {
                  "solve_costs": "Θ(log n)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Equating qn with n log n + q log n gives q approximately n log n divided by n - log n, which is Θ(log n).",
              "details": "Exact crossover depends on constants, existing order, mutation, and query semantics."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-queries-021",
            "prompt": "A dataset is rebuilt completely u times. Across all versions, q exact queries are answered. Select expected hash-workload time and sorted-workload time.",
            "constraints": [
              "Each hash rebuild costs expected O(n), and each hash query expected O(1).",
              "Each sorted rebuild costs O(n log n), and each binary-search query O(log n)."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "hash_time",
                "sort_time"
              ],
              "availableValuesByDimension": {
                "hash_time": [
                  "O(un + q)",
                  "O(un log n + q)",
                  "O(qn)",
                  "O(uq)"
                ],
                "sort_time": [
                  "O(un + q)",
                  "O(un log n + q log n)",
                  "O(qn)",
                  "O(uq)"
                ]
              },
              "acceptedValuesByDimension": {
                "hash_time": [
                  "O(un + q)"
                ],
                "sort_time": [
                  "O(un log n + q log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "hash_time": {
                  "rebuilds_and_queries": "O(un + q)"
                },
                "sort_time": {
                  "resorts_and_queries": "O(un log n + q log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Frequent complete invalidation multiplies preprocessing by u.",
              "details": "A realistic dynamic comparison must include that lifecycle cost."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-queries-022",
            "prompt": "Sort n values once, answer q ordered range queries with two binary-search boundaries each, and emit T total values across all query results. Select total time and output space.",
            "constraints": [
              "Each boundary search costs O(log n).",
              "T counts all materialized reported values."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "output_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n log n + q log n)",
                  "O(n log n + q log n + T)",
                  "O(qn)",
                  "O(n + T)"
                ],
                "output_space": [
                  "O(1)",
                  "O(q)",
                  "O(T)",
                  "O(nT)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log n + q log n + T)"
                ],
                "output_space": [
                  "O(T)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "sort_boundaries_output": "O(n log n + q log n + T)"
                },
                "output_space": {
                  "reported_values": "O(T)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Ordered preprocessing reduces boundary location but cannot remove the cost of emitting required results.",
              "details": "This is a workload where sorting provides a relation that a plain hash table does not."
            },
            "taxonomy": {
              "primarySkillAtomId": "choose_hash_or_sort_for_query_volume",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          }
        ],
