        "items": [
          {
            "id": "alg-complexity-reject-001",
            "prompt": "What is the main purpose of rejecting infeasible brute force before implementation?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "avoid_wrong_growth",
                  "text": "Avoid spending implementation effort on a growth class that cannot satisfy the stated constraints."
                },
                {
                  "id": "brute_force_never",
                  "text": "Prove brute force is always conceptually wrong."
                },
                {
                  "id": "names",
                  "text": "Choose shorter variable names."
                },
                {
                  "id": "micro_optimize",
                  "text": "Replace all reasoning with low-level optimization."
                }
              ],
              "acceptedOptionIds": [
                "avoid_wrong_growth"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Constraint analysis should eliminate impossible strategy classes early.",
              "details": "Implementation detail matters only after the asymptotic and output requirements are plausible.",
              "wrongOptionExplanationsByOptionId": {
                "brute_force_never": "Brute force can be appropriate for small inputs or required enumeration.",
                "names": "Names do not affect feasibility.",
                "micro_optimize": "Constant-factor tuning cannot repair an orders-of-magnitude growth mismatch."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_infeasible_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-reject-002",
            "prompt": "Is an O(2^n) subset search automatically unacceptable?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "depends_n_output",
                  "text": "No. It can be appropriate for small n or when all subsets must be output."
                },
                {
                  "id": "always_bad",
                  "text": "Yes. Exponential algorithms are never usable."
                },
                {
                  "id": "always_good",
                  "text": "No. It is always acceptable."
                },
                {
                  "id": "only_sorted",
                  "text": "It is acceptable only on sorted input."
                }
              ],
              "acceptedOptionIds": [
                "depends_n_output"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Feasibility depends on concrete n, per-state work, and whether enumeration is mandated.",
              "details": "The goal is to reject infeasible brute force, not to ban exhaustive methods categorically.",
              "wrongOptionExplanationsByOptionId": {
                "always_bad": "For n around 20, the state count can be manageable.",
                "always_good": "Larger n quickly makes it infeasible.",
                "only_sorted": "Subset count is unrelated to sort order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_infeasible_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-reject-003",
            "prompt": "For n = 100,000, why should an O(n²) pair check usually be rejected under ordinary contest-scale budgets?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ten_billion",
                  "text": "It implies about 10 billion pair operations before overhead."
                },
                {
                  "id": "nested_syntax",
                  "text": "Because any nested loop is forbidden."
                },
                {
                  "id": "pairs_output",
                  "text": "Because pairs cannot be represented."
                },
                {
                  "id": "variable_n",
                  "text": "Because both loops use the name n."
                }
              ],
              "acceptedOptionIds": [
                "ten_billion"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Substituting the maximum constraint exposes a cost far above common abstract budgets.",
              "details": "A different invariant, data structure, or problem reduction is needed unless the output itself is that large.",
              "wrongOptionExplanationsByOptionId": {
                "nested_syntax": "Some nested loops have linear aggregate work.",
                "pairs_output": "The issue is the count.",
                "variable_n": "Actual bounds, not names, matter."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_infeasible_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            },
            "constraints": [
              "Use the dominant count n² and ignore constant factors."
            ]
          },
          {
            "id": "alg-complexity-reject-004",
            "prompt": "Why is enumerating all n! permutations usually rejected much earlier than enumerating all 2^n subsets?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "factorial_faster",
                  "text": "Factorial growth overtakes exponential 2^n rapidly."
                },
                {
                  "id": "permutations_linear",
                  "text": "Permutation count is actually linear."
                },
                {
                  "id": "subsets_more",
                  "text": "2^n is always larger than n!."
                },
                {
                  "id": "sort_required",
                  "text": "Permutations require sorting first."
                }
              ],
              "acceptedOptionIds": [
                "factorial_faster"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Factorial branching multiplies by a decreasing sequence n·(n-1)·...·1.",
              "details": "Even moderate n can produce hundreds of millions or more candidate orderings.",
              "wrongOptionExplanationsByOptionId": {
                "permutations_linear": "There are n! orderings.",
                "subsets_more": "For sufficiently large n, n! is much larger.",
                "sort_required": "Sorting is not the growth explanation."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_infeasible_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-reject-005",
            "prompt": "A branch-and-bound algorithm has a heuristic prune but no proof that it removes branches in the worst case. What worst-case class should still be considered?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "original_tree",
                  "text": "The full brute-force search-tree class."
                },
                {
                  "id": "constant",
                  "text": "O(1) because pruning exists."
                },
                {
                  "id": "linear",
                  "text": "O(n) because each branch is visited once."
                },
                {
                  "id": "average_only",
                  "text": "No worst-case analysis is possible."
                }
              ],
              "acceptedOptionIds": [
                "original_tree"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A heuristic can improve typical behavior without changing the formal worst case.",
              "details": "Only a guaranteed structural reduction justifies a stronger worst-case bound.",
              "wrongOptionExplanationsByOptionId": {
                "constant": "Some inputs may trigger no useful pruning.",
                "linear": "The number of branches may be exponential.",
                "average_only": "The unpruned tree gives a valid upper bound."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_infeasible_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-reject-006",
            "prompt": "A task asks to list all n! permutations. Should O(n!) enumeration be rejected solely because it is factorial?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "output_required",
                  "text": "No. The output contract itself requires n! results, so factorial output work is unavoidable."
                },
                {
                  "id": "yes_always",
                  "text": "Yes. The requested output should be ignored."
                },
                {
                  "id": "constant_possible",
                  "text": "A constant-time algorithm can return all results symbolically under the same materialized-output contract."
                },
                {
                  "id": "only_n2",
                  "text": "The best possible time is always O(n²)."
                }
              ],
              "acceptedOptionIds": [
                "output_required"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Avoidable brute force must be separated from mandatory enumeration.",
              "details": "The relevant goal becomes low overhead per output and correct output-sensitive accounting.",
              "wrongOptionExplanationsByOptionId": {
                "yes_always": "An algorithm cannot return all permutations without producing them.",
                "constant_possible": "Materialization requires writing each result.",
                "only_n2": "That is smaller than the output size."
              }
            },
