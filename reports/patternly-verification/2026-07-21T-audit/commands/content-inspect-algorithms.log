        "items": [
          {
            "id": "hpq-complexity-peek-time",
            "prompt": "A binary heap already contains h elements. Report the worst-case time complexity of reading the root with peek, without modifying the heap.",
            "difficulty": "introductory",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log h)",
                  "O(h)",
                  "O(h log h)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {}
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Peek reads the root at a known position and performs no invariant repair.",
              "details": "The heap invariant guarantees that the selected extreme is stored at the root, so the operation needs one indexed read. The number of descendants does not matter because no traversal occurs. This constant bound applies to peek only; push and pop may follow a root-to-leaf or leaf-to-root path and therefore have different costs."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_heap_cost_from_heap_size",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "choose_repeated_extreme"
            }
          },
          {
            "id": "hpq-complexity-single-mutation-time",
            "prompt": "A binary heap contains h elements. Report the worst-case time complexity of one push or one pop that may repair the heap along one root-to-leaf path.",
            "difficulty": "introductory",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log h)",
                  "O(h)",
                  "O(h log h)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(log h)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {}
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "A complete binary heap has height O(log h), and one mutation repairs at most one ancestor or descendant path.",
              "details": "Push may sift a new leaf to the root, and pop may sift a replacement root toward a leaf. Each level performs constant comparison and swap work, while the number of levels is logarithmic in the current heap size. The bound is not constant merely because the root is directly accessible, and it is not linear because unrelated branches are not scanned."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_heap_cost_from_heap_size",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "running_extreme",
              "problemArchetypeId": "choose_repeated_extreme"
            }
          },
          {
            "id": "hpq-complexity-bounded-top-k-total",
            "prompt": "An algorithm processes n stream values and maintains at most k retained candidates in a binary heap. In the worst case, each value may cause one bounded heap update. Report total time and extra space.",
            "constraints": [
              "Exclude storage for the input and final output.",
              "Assume 1 <= k <= n."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n)",
                  "O(n log k)",
                  "O(n log n)",
                  "O(k log n)"
                ],
                "space": [
                  "O(1)",
                  "O(k)",
                  "O(n)",
                  "O(nk)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log k)"
                ],
                "space": [
                  "O(k)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {},
                "space": {}
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "There are n inspections, each with at most logarithmic work in a heap whose size never exceeds k; the retained state stores at most k entries.",
              "details": "Every input value is examined once. A value may be discarded after a root comparison or may trigger push/pop repair bounded by the height of a size-k heap. The worst-case total is therefore O(n log k), with O(k) extra retained state. The bound is not O(n log n) unless the heap grows with n, and it is not O(n) in the worst case when k grows and many updates repair the heap."
            },
