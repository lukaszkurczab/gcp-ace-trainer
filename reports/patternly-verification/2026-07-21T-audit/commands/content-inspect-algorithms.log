      {
        "id": "alg-arrays-frequency-state-011",
        "prompt": "When is comparing only the current value with the previous value sufficient for duplicate-related reasoning?",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
