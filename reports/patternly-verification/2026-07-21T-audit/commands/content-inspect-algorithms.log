        "items": [
          {
            "id": "alg-contrast-hash-sort-cost-001",
            "prompt": "Why does expected O(n) hash construction not prove that hashing is always faster than O(n log n) comparison sorting?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "full_model",
                  "text": "Expected bounds, constants, key-operation costs, locality, memory, guarantees, and consumed output structure all matter."
                },
                {
                  "id": "big_o_wrong",
                  "text": "Asymptotic notation never compares algorithms."
                },
                {
                  "id": "sorting_linear",
                  "text": "Every comparison sort is actually O(n)."
                },
                {
                  "id": "hash_deterministic",
                  "text": "Expected hash time is a deterministic worst-case guarantee."
                }
              ],
              "acceptedOptionIds": [
                "full_model"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The headline asymptotic term is one component of an end-to-end cost model.",
              "details": "Hashing can be preferable, but the universal claim fails when assumptions or required downstream work change.",
              "wrongOptionExplanationsByOptionId": {
                "big_o_wrong": "Asymptotic analysis is useful but not sufficient by itself.",
                "sorting_linear": "General comparison sorting is O(n log n) in the standard model.",
                "hash_deterministic": "Expected and worst-case bounds are different."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_expected_hash_and_sorting_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-hash-sort-cost-002",
            "prompt": "Under an adversarial collision model, what can happen to n insertions into a conventional hash table if each insertion may inspect O(n) colliding entries?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "quadratic",
                  "text": "Total construction can degrade to O(n²)."
                },
                {
                  "id": "always_linear",
                  "text": "Construction remains guaranteed O(n)."
                },
                {
                  "id": "logarithmic",
                  "text": "Construction becomes O(log n)."
                },
                {
                  "id": "constant",
                  "text": "All insertions together are O(1)."
                }
              ],
              "acceptedOptionIds": [
                "quadratic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A sequence of n operations can cost O(n) each in a pathological collision regime.",
              "details": "A robust comparison distinguishes expected hashing from deterministic or adversarial guarantees.",
              "wrongOptionExplanationsByOptionId": {
                "always_linear": "Expected constant-time insertion is not a universal worst-case guarantee.",
                "logarithmic": "There are n insertions.",
                "constant": "At least n inputs must be processed."
