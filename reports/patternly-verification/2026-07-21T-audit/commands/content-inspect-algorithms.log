      {
        "id": "alg-binary-search-answer-015",
        "prompt": "Arrange one minimization iteration for false-to-true feasibility over a half-open candidate range.",
        "difficulty": "foundational",
        "interaction": {
          "type": "ordering",
          "elements": [
            {
              "id": "compute_mid",
              "text": "Compute the candidate midpoint."
            },
            {
              "id": "evaluate",
              "text": "Evaluate feasible(mid)."
            },
            {
              "id": "keep_feasible",
              "text": "If feasible, retain mid by moving the right boundary to mid."
            },
            {
              "id": "discard_infeasible",
              "text": "If infeasible, move the left boundary to mid + 1."
            }
          ],
          "canonicalOrder": [
            "compute_mid",
            "evaluate",
            "keep_feasible",
            "discard_infeasible"
          ],
          "scoringMethod": "adjacent_relations"
