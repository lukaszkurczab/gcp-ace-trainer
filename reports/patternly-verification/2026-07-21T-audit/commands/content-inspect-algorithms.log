        "items": [
          {
            "id": "alg-complexity-scaling-001",
            "prompt": "Why should an operation budget be stated explicitly instead of using a universal rule such as \"10^8 operations always fit\"?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "model_dependent",
                  "text": "Actual throughput depends on operation cost, language, hardware, memory behavior, and time limit."
                },
                {
                  "id": "big_o_exact",
                  "text": "Big-O already gives an exact runtime in seconds."
                },
                {
                  "id": "names_determine",
                  "text": "Variable names determine the machine speed."
                },
                {
                  "id": "budget_unneeded",
                  "text": "Constraints never influence algorithm choice."
                }
              ],
              "acceptedOptionIds": [
                "model_dependent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A rough budget is a modeling assumption, not a universal physical constant.",
              "details": "Content should state the abstract budget and what counts as one unit operation before comparing candidate algorithms.",
              "wrongOptionExplanationsByOptionId": {
                "big_o_exact": "Asymptotic notation omits constants and hardware.",
                "names_determine": "Names do not affect runtime.",
                "budget_unneeded": "Input limits are a primary design signal."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-002",
            "prompt": "With n = 200,000 and an abstract budget of 100,000,000 unit operations, which candidate is clearly infeasible by its dominant count?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "quadratic",
                  "text": "An O(n²) full pair comparison."
                },
                {
                  "id": "linear",
                  "text": "An O(n) scan."
                },
                {
                  "id": "n_log_n",
                  "text": "An O(n log2 n) comparison process."
                },
                {
                  "id": "constant",
                  "text": "An O(1) check."
                }
              ],
              "acceptedOptionIds": [
                "quadratic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "n² is approximately 40 billion when n = 200,000.",
              "details": "That exceeds the stated 100 million unit-operation budget by orders of magnitude.",
              "wrongOptionExplanationsByOptionId": {
                "linear": "About 200,000 unit operations is well below the budget.",
                "n_log_n": "It is roughly a few million operations under the stated abstraction.",
                "constant": "Constant work is smaller still."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            },
            "constraints": [
              "Use an abstract budget of 100,000,000 equal-cost unit operations and ignore constant factors."
            ]
          },
          {
            "id": "alg-complexity-scaling-003",
            "prompt": "With n = 20, what does the size of the full subset space suggest?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "about_million",
                  "text": "2^20 is about one million, so complete enumeration may be viable under a suitable per-state cost and budget."
                },
                {
                  "id": "always_impossible",
                  "text": "Any exponential algorithm is automatically impossible."
                },
                {
                  "id": "linear",
                  "text": "2^20 grows linearly with n."
                },
                {
                  "id": "twenty_states",
                  "text": "There are only 20 subsets."
                }
              ],
              "acceptedOptionIds": [
                "about_million"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Asymptotic class alone is not the whole feasibility decision.",
              "details": "Small n can make an exponential state space manageable, but per-state work and output obligations still matter.",
              "wrongOptionExplanationsByOptionId": {
                "always_impossible": "Small exponents can be manageable.",
                "linear": "Subset count is exponential.",
                "twenty_states": "Each of 20 elements has an include/exclude choice."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-004",
            "prompt": "With n = 50, why is enumerating all 2^n subsets normally rejected under a 100,000,000-operation budget?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "quadrillion_states",
                  "text": "2^50 is over one quadrillion states, far beyond the budget."
                },
                {
                  "id": "nested_name",
                  "text": "The code would probably use nested loops."
                },
                {
                  "id": "output_zero",
                  "text": "Subset enumeration produces no output."
                },
                {
                  "id": "fifty_large",
                  "text": "Every algorithm with n = 50 is infeasible."
                }
              ],
              "acceptedOptionIds": [
                "quadrillion_states"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The candidate state count itself exceeds the budget by many orders of magnitude.",
              "details": "No constant-factor optimization can bridge that gap under the stated model.",
              "wrongOptionExplanationsByOptionId": {
                "nested_name": "Syntax is not the decisive argument.",
                "output_zero": "It may produce enormous output.",
                "fifty_large": "Polynomial algorithms can be easy at n = 50."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            },
            "constraints": [
              "Use an abstract budget of 100,000,000 equal-cost unit operations."
            ]
          },
          {
            "id": "alg-complexity-scaling-005",
            "prompt": "An algorithm preprocesses n records in O(n log n) and answers q queries in O(log n) each. Which workload expression should be compared with the budget?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "total_formula",
                  "text": "O(n log n + q log n)."
                },
                {
                  "id": "query_only",
                  "text": "O(log n) only."
                },
                {
                  "id": "preprocess_only",
                  "text": "O(n log n) only."
                },
                {
                  "id": "multiply_all",
                  "text": "O(nq log² n)."
                }
              ],
              "acceptedOptionIds": [
                "total_formula"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Feasibility is based on the full requested workload.",
              "details": "A fast per-query bound does not erase one-time preprocessing or the number of queries.",
              "wrongOptionExplanationsByOptionId": {
                "query_only": "This ignores both preprocessing and query count.",
                "preprocess_only": "The q queries also execute.",
                "multiply_all": "Sequential preprocessing and queries add."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-scaling-006",
            "prompt": "Two input dimensions are n = 10,000 and m = 10,000. What should be checked before accepting an O(nm) nested comparison?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "product_budget",
                  "text": "Compute nm = 100,000,000 and compare it with the stated budget and per-comparison cost."
                },
                {
                  "id": "rename_m",
                  "text": "Rename m to n so the loop looks quadratic."
                },
                {
                  "id": "add_only",
                  "text": "Use n + m because there are two inputs."
                },
                {
                  "id": "ignore_m",
                  "text": "Only the larger dimension matters."
                }
              ],
              "acceptedOptionIds": [
                "product_budget"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Multidimensional constraints should be substituted into the actual cost expression.",
              "details": "The same O(nm) class can be feasible or infeasible depending on the separate limits and constant work.",
              "wrongOptionExplanationsByOptionId": {
                "rename_m": "Names do not change work.",
                "add_only": "The algorithm compares every pair, so counts multiply.",
                "ignore_m": "Both dimensions participate in the product."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-007",
            "prompt": "Why can two algorithms with the same Big-O classification differ in feasibility near a tight limit?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "constants_and_ops",
                  "text": "Their constant factors, operation types, memory access, and implementation overhead can differ."
                },
                {
                  "id": "big_o_wrong",
                  "text": "Big-O is never useful for comparing algorithms."
                },
                {
                  "id": "names",
                  "text": "Their variable names may be longer."
                },
                {
                  "id": "same_always",
                  "text": "Algorithms in the same class always have identical runtime."
                }
              ],
              "acceptedOptionIds": [
                "constants_and_ops"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Asymptotic filtering rejects clearly wrong growth classes first.",
              "details": "Near the budget boundary, the cost model and implementation details need closer measurement or conservative margin.",
              "wrongOptionExplanationsByOptionId": {
                "big_o_wrong": "It remains essential for growth but is not an exact stopwatch.",
                "names": "Names are irrelevant.",
                "same_always": "Asymptotic equivalence hides constants and lower-order terms."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-scaling-008",
            "prompt": "A task must output k records. Why must k be considered when assessing feasibility?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "output_work",
                  "text": "Writing or materializing k records requires at least proportional work and usually proportional output storage."
                },
                {
                  "id": "output_free",
                  "text": "Output is free once the algorithm computes the first record."
                },
                {
                  "id": "input_only",
                  "text": "Only input size can affect complexity."
                },
                {
                  "id": "k_constant",
                  "text": "k is always constant."
                }
              ],
              "acceptedOptionIds": [
                "output_work"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A candidate time bound smaller than the mandatory output size is incomplete.",
              "details": "Feasibility must include both search/computation and required emission.",
              "wrongOptionExplanationsByOptionId": {
                "output_free": "Every required record must still be produced.",
                "input_only": "Output size can dominate.",
                "k_constant": "The result count may grow with the input."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "output_sensitive_analysis"
            }
          },
          {
            "id": "alg-complexity-scaling-009",
            "prompt": "A proposed O(n²) dynamic-programming table uses n = 50,000 boolean entries per dimension. Which resource issue appears before runtime details?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "space_infeasible",
                  "text": "The table has 2.5 billion cells and may exceed the memory budget."
                },
                {
                  "id": "always_constant",
                  "text": "Booleans always occupy zero memory asymptotically."
                },
                {
                  "id": "time_only",
                  "text": "Only CPU time matters when evaluating constraints."
                },
                {
                  "id": "names_quadratic",
                  "text": "The table is large only because both dimensions are named n."
                }
              ],
              "acceptedOptionIds": [
                "space_infeasible"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Constraint translation includes memory as well as operations.",
              "details": "A theoretically acceptable transition count is irrelevant if the state representation cannot fit.",
              "wrongOptionExplanationsByOptionId": {
                "always_constant": "Each cell requires storage.",
                "time_only": "Memory can reject an approach independently.",
                "names_quadratic": "The actual cell product causes the growth."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-010",
            "prompt": "Which quantities should be included when translating constraints into a budget? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "input_limits",
                  "text": "Maximum values of every independent input dimension."
                },
                {
                  "id": "query_count",
                  "text": "The number of repeated operations or queries."
                },
                {
                  "id": "output_size",
                  "text": "The maximum required output volume."
                },
                {
                  "id": "variable_names",
                  "text": "The spelling of loop variables."
                }
              ],
              "acceptedOptionIds": [
                "input_limits",
                "query_count",
                "output_size"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Feasibility follows the complete workload shape.",
              "details": "Ignoring one dimension, query multiplicity, or output can understate cost by orders of magnitude.",
              "wrongOptionExplanationsByOptionId": {
                "variable_names": "Names do not affect operation count."
              },
              "omittedCorrectExplanationsByOptionId": {
                "input_limits": "They determine candidate work.",
                "query_count": "Per-query cost repeats.",
                "output_size": "Output creates an unavoidable lower bound."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-011",
            "prompt": "Under an abstract 100,000,000-operation budget and n = 100,000, which candidate classes are plausibly viable before constant-factor review? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "linear",
                  "text": "O(n)."
                },
                {
                  "id": "n_log_n",
                  "text": "O(n log2 n)."
                },
                {
                  "id": "quadratic",
                  "text": "O(n²)."
                },
                {
                  "id": "cubic",
                  "text": "O(n³)."
                }
              ],
              "acceptedOptionIds": [
                "linear",
                "n_log_n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Substituting the maximum n gives a first-pass feasibility filter.",
              "details": "The accepted classes still require realistic operation and memory modeling.",
              "wrongOptionExplanationsByOptionId": {
                "quadratic": "About 10 billion units, which exceeds the budget.",
                "cubic": "About 10^15 units, which is far beyond the budget."
              },
              "omittedCorrectExplanationsByOptionId": {
                "linear": "About 100,000 units.",
                "n_log_n": "Roughly 1.7 million units."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            },
            "constraints": [
              "Treat one dominant-count unit as one abstract operation and ignore constant factors."
            ]
          },
          {
            "id": "alg-complexity-scaling-012",
            "prompt": "Which exhaustive spaces can be plausible under a 100,000,000-state budget? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "subsets_20",
                  "text": "All 2^20 subsets."
                },
                {
                  "id": "subsets_26",
                  "text": "All 2^26 subsets."
                },
                {
                  "id": "subsets_40",
                  "text": "All 2^40 subsets."
                },
                {
                  "id": "permutations_12",
                  "text": "All 12! permutations."
                }
              ],
              "acceptedOptionIds": [
                "subsets_20",
                "subsets_26"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Concrete state counts matter when n is small.",
              "details": "Accepted cases remain only first-pass plausible; output and per-state work can still make them impractical.",
              "wrongOptionExplanationsByOptionId": {
                "subsets_40": "This is about 1.1 trillion states.",
                "permutations_12": "This is about 479 million states."
              },
              "omittedCorrectExplanationsByOptionId": {
                "subsets_20": "This is about 1.05 million states.",
                "subsets_26": "This is about 67 million states before per-state overhead."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            },
            "constraints": [
              "Use an abstract budget of 100,000,000 states before per-state work."
            ]
          },
          {
            "id": "alg-complexity-scaling-013",
            "prompt": "Which caveats belong in an operation-budget estimate? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "abstract_units",
                  "text": "The estimate treats operations as abstract equal-cost units."
                },
                {
                  "id": "constants",
                  "text": "Constant factors and cache behavior may matter near the limit."
                },
                {
                  "id": "memory",
                  "text": "Memory and output constraints may reject an otherwise acceptable operation count."
                },
                {
                  "id": "universal_speed",
                  "text": "The estimate proves every implementation finishes in the same wall-clock time."
                }
              ],
              "acceptedOptionIds": [
                "abstract_units",
                "constants",
                "memory"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A good estimate states what it includes and what remains uncertain.",
              "details": "The budget is a design tool, not a universal hardware law.",
              "wrongOptionExplanationsByOptionId": {
                "universal_speed": "No abstract budget gives that guarantee."
              },
              "omittedCorrectExplanationsByOptionId": {
                "abstract_units": "Real operations have different costs.",
                "constants": "Asymptotics are a filter, not an exact timing result.",
                "memory": "Feasibility is multi-resource."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-scaling-014",
            "prompt": "Arrange the process for assessing an algorithm against constraints.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "extract_limits",
                  "text": "Extract maximum input dimensions, query counts, output obligations, and memory limits."
                },
                {
                  "id": "derive_cost",
                  "text": "Write the candidate algorithm's time and space expressions."
                },
                {
                  "id": "substitute",
                  "text": "Substitute the maximum constraints to estimate work and storage."
                },
                {
                  "id": "decide_margin",
                  "text": "Reject, accept provisionally, or benchmark when the estimate is near the budget."
                }
              ],
              "canonicalOrder": [
                "extract_limits",
                "derive_cost",
                "substitute",
                "decide_margin"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Constraint analysis connects asymptotic formulas to concrete maxima.",
              "details": "Near-boundary cases require conservative constants or measurement rather than false certainty."
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-015",
            "prompt": "Arrange the analysis of a repeated-query workload.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "preprocess",
                  "text": "Identify one-time preprocessing cost P(n)."
                },
                {
                  "id": "per_query",
                  "text": "Identify per-query cost Q(n)."
                },
                {
                  "id": "multiply_queries",
                  "text": "Compute q·Q(n)."
                },
                {
                  "id": "combine",
                  "text": "Compare P(n) + q·Q(n), memory, and update costs with the workload budget."
                }
              ],
              "canonicalOrder": [
                "preprocess",
                "per_query",
                "multiply_queries",
                "combine"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Fast query time is meaningful only inside the total workload.",
              "details": "The same data structure can be attractive for many queries and wasteful for one."
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-scaling-016",
            "prompt": "Arrange the analysis of a two-dimensional candidate cost O(nm).",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "keep_dimensions",
                  "text": "Keep n and m as separate constrained dimensions."
                },
                {
                  "id": "substitute_max",
                  "text": "Insert their independent maximum values."
                },
                {
                  "id": "compute_product",
                  "text": "Estimate the product and per-pair work."
                },
                {
                  "id": "compare_budget",
                  "text": "Compare the result with time and memory budgets."
                }
              ],
              "canonicalOrder": [
                "keep_dimensions",
                "substitute_max",
                "compute_product",
                "compare_budget"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Collapsing dimensions too early can hide the real maximum product.",
              "details": "The separate limits may be asymmetric and should be preserved."
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-017",
            "prompt": "For n = 200,000, estimate the dominant operation count of O(n log2 n) and whether it fits an abstract 100,000,000-operation budget.",
            "constraints": [
              "Use log2(200,000) ≈ 18 and ignore constant factors."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "operation_count",
                "budget_fit"
              ],
              "availableValuesByDimension": {
                "operation_count": [
                  "about 3.6 million",
                  "about 40 billion",
                  "about 200,000",
                  "about 2^200000"
                ],
                "budget_fit": [
                  "fits",
                  "does not fit"
                ]
              },
              "acceptedValuesByDimension": {
                "operation_count": [
                  "about 3.6 million"
                ],
                "budget_fit": [
                  "fits"
                ]
              },
              "normalizedAliasesByDimension": {
                "operation_count": {
                  "n_times_log": "about 3.6 million"
                },
                "budget_fit": {
                  "under_budget": "fits"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Multiplying 200,000 by about 18 gives roughly 3.6 million dominant units.",
              "details": "That is below the stated abstract budget, before constant-factor review."
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-018",
            "prompt": "For n = 30,000, estimate the dominant count of an O(n²) algorithm and whether it fits an abstract 100,000,000-operation budget.",
            "constraints": [
              "Ignore constant factors."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "operation_count",
                "budget_fit"
              ],
              "availableValuesByDimension": {
                "operation_count": [
                  "about 900 million",
                  "about 30,000",
                  "about 450 million",
                  "about 3 million"
                ],
                "budget_fit": [
                  "fits",
                  "does not fit"
                ]
              },
              "acceptedValuesByDimension": {
                "operation_count": [
                  "about 900 million"
                ],
                "budget_fit": [
                  "does not fit"
                ]
              },
              "normalizedAliasesByDimension": {
                "operation_count": {
                  "square": "about 900 million"
                },
                "budget_fit": {
                  "over_budget": "does not fit"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "30,000² is 900,000,000.",
              "details": "The dominant count exceeds the budget ninefold before overhead."
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-019",
            "prompt": "For n = 25, estimate the number of subset masks 2^n and whether one O(1)-work pass over all masks fits an abstract 100,000,000-operation budget.",
            "constraints": [
              "Use 2^25 = 33,554,432 and ignore constant factors."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "operation_count",
                "budget_fit"
              ],
              "availableValuesByDimension": {
                "operation_count": [
                  "about 33.6 million",
                  "about 625",
                  "about 25 million",
                  "about 3.3 billion"
                ],
                "budget_fit": [
                  "fits",
                  "does not fit"
                ]
              },
              "acceptedValuesByDimension": {
                "operation_count": [
                  "about 33.6 million"
                ],
                "budget_fit": [
                  "fits"
                ]
              },
              "normalizedAliasesByDimension": {
                "operation_count": {
                  "subsets": "about 33.6 million"
                },
                "budget_fit": {
                  "under_budget": "fits"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The mask count is about 33.6 million.",
              "details": "It fits the abstract state budget, but materializing subsets or doing O(n) work per mask could change the decision."
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-scaling-020",
            "prompt": "A workload has n = 100,000 records and q = 100,000 queries. Preprocessing costs O(n), and every query costs O(log2 n). Estimate dominant units and budget fit for a 100,000,000-operation budget.",
            "constraints": [
              "Use log2(100,000) ≈ 17 and ignore constant factors."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "operation_count",
                "budget_fit"
              ],
              "availableValuesByDimension": {
                "operation_count": [
                  "about 1.8 million",
                  "about 10 billion",
                  "about 100,000",
                  "about 170 billion"
                ],
                "budget_fit": [
                  "fits",
                  "does not fit"
                ]
              },
              "acceptedValuesByDimension": {
                "operation_count": [
                  "about 1.8 million"
                ],
                "budget_fit": [
                  "fits"
                ]
              },
              "normalizedAliasesByDimension": {
                "operation_count": {
                  "preprocess_plus_queries": "about 1.8 million"
                },
                "budget_fit": {
                  "under_budget": "fits"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The estimate is 100,000 + 100,000·17 ≈ 1.8 million.",
              "details": "The per-query logarithm must be multiplied by q before comparing with the budget."
            },
            "taxonomy": {
              "primarySkillAtomId": "translate_constraints_to_operation_budget",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          }
        ],
