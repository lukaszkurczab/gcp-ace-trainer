        "items": [
          {
            "id": "alg-complexity-preprocess-001",
            "prompt": "What total-cost expression compares a preprocessing strategy across q queries?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "p_plus_q",
                  "text": "Preprocessing cost P(n) plus q times per-query cost Q(n)."
                },
                {
                  "id": "query_only",
                  "text": "Only Q(n)."
                },
                {
                  "id": "preprocess_only",
                  "text": "Only P(n)."
                },
                {
                  "id": "product_all",
                  "text": "P(n)·q·Q(n)."
                }
              ],
              "acceptedOptionIds": [
                "p_plus_q"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The full workload is P(n) + qQ(n).",
              "details": "Memory construction, updates, and output may add further terms.",
              "wrongOptionExplanationsByOptionId": {
                "query_only": "The query cost repeats q times and preprocessing also executes.",
                "preprocess_only": "Queries are omitted.",
                "product_all": "Sequential preprocessing and queries add rather than multiply together."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-002",
            "prompt": "For one membership query on an unsorted array, why can sorting first be worse than a direct scan?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "preprocess_dominates",
                  "text": "O(n log n) sorting plus O(log n) query exceeds one O(n) scan asymptotically."
                },
                {
                  "id": "binary_wrong",
                  "text": "Binary search is never correct."
                },
                {
                  "id": "scan_constant",
                  "text": "A scan is O(1)."
                },
                {
                  "id": "sort_free",
                  "text": "Library sorting has no cost."
                }
              ],
              "acceptedOptionIds": [
                "preprocess_dominates"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Fast query time can be overwhelmed by a one-time preprocessing cost when q is small.",
              "details": "The best strategy depends on the whole workload.",
              "wrongOptionExplanationsByOptionId": {
                "binary_wrong": "It is correct after legal sorting.",
                "scan_constant": "The scan is linear.",
                "sort_free": "Preprocessing work must be included."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-003",
            "prompt": "When do prefix sums become attractive for range-sum queries on a static array?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "many_queries",
                  "text": "When O(n) preprocessing can be shared across enough O(1) queries."
                },
                {
                  "id": "one_query_always",
                  "text": "For every single query regardless of n."
                },
                {
                  "id": "updates_frequent",
                  "text": "When arbitrary updates occur after every query and the prefix array is never repaired."
                },
                {
                  "id": "output_large",
                  "text": "Only when each query outputs the full array."
                }
              ],
              "acceptedOptionIds": [
                "many_queries"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Prefix sums trade one linear build for constant-time query evaluation.",
              "details": "The trade is strongest when data is static and q is large.",
              "wrongOptionExplanationsByOptionId": {
                "one_query_always": "A direct O(length) scan may be cheaper for one small query.",
                "updates_frequent": "Stale preprocessing becomes incorrect.",
                "output_large": "Prefix sums target aggregate queries."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-004",
            "prompt": "A hash set is built for repeated membership queries. Which cost is easy to omit?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "memory_and_build",
                  "text": "O(n) build work and O(n) expected storage, in addition to expected O(1) queries."
                },
                {
                  "id": "query_count_none",
                  "text": "The number of queries never matters."
                },
                {
                  "id": "output_n",
                  "text": "Every membership query returns n values."
                },
                {
                  "id": "sorting",
                  "text": "A hash set always requires sorting first."
                }
              ],
              "acceptedOptionIds": [
                "memory_and_build"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Preprocessing can reduce query time by spending time and memory up front.",
              "details": "A fair comparison includes all three resources.",
              "wrongOptionExplanationsByOptionId": {
                "query_count_none": "The benefit is tied to query volume.",
                "output_n": "It usually returns one boolean.",
                "sorting": "Hashing does not require sorted input."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-005",
            "prompt": "What happens to a precomputed index when the underlying data changes?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "may_invalidate",
                  "text": "It may need incremental maintenance or rebuilding before future queries are correct."
                },
                {
                  "id": "never_matters",
                  "text": "Preprocessing remains correct automatically."
                },
                {
                  "id": "query_faster",
                  "text": "Updates always make queries faster."
                },
                {
                  "id": "output_only",
                  "text": "Only output size changes."
                }
              ],
              "acceptedOptionIds": [
                "may_invalidate"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Preprocessing assumptions include data mutability.",
              "details": "Static-data query models cannot be transferred unchanged to update-heavy workloads.",
              "wrongOptionExplanationsByOptionId": {
                "never_matters": "The index may no longer match the data.",
                "query_faster": "Maintenance can add cost.",
                "output_only": "The data structure's validity changes."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-006",
            "prompt": "Which distinction matters between offline and online queries?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "future_known",
                  "text": "Offline processing may reorder or batch known queries, while online processing must answer before future queries are known."
                },
                {
                  "id": "same_always",
                  "text": "There is no algorithmic difference."
                },
                {
                  "id": "online_sort_output",
                  "text": "Online means outputs must be sorted."
                },
                {
                  "id": "offline_no_cost",
                  "text": "Offline preprocessing is free."
                }
              ],
              "acceptedOptionIds": [
                "future_known"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The availability of future queries changes legal preprocessing and batching strategies.",
              "details": "The complexity explanation should state which workload model is assumed.",
              "wrongOptionExplanationsByOptionId": {
                "same_always": "Knowledge of the full workload can enable sorting or batching.",
                "online_sort_output": "Online refers to arrival and response timing.",
                "offline_no_cost": "It still consumes time and memory."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-007",
            "prompt": "Why can sorting as preprocessing be illegal even when it improves query time?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "order_contract",
                  "text": "The original order or original indices may be part of the required result contract."
                },
                {
                  "id": "sort_slow_only",
                  "text": "Sorting is illegal whenever it is O(n log n)."
                },
                {
                  "id": "duplicates",
                  "text": "Sorting always removes duplicates."
                },
                {
                  "id": "one_query",
                  "text": "Sorting is semantically illegal only when q = 1."
                }
              ],
              "acceptedOptionIds": [
                "order_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A preprocessing transformation must preserve all required information or carry provenance.",
              "details": "Performance improvement cannot justify changing result meaning.",
              "wrongOptionExplanationsByOptionId": {
                "sort_slow_only": "Cost does not determine semantic legality.",
                "duplicates": "Sorting reorders but does not deduplicate.",
                "one_query": "Legality is independent of query count."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-preprocess-008",
            "prompt": "How should a break-even query count be derived?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "solve_inequality",
                  "text": "Write total-cost expressions for both strategies and solve where one becomes smaller."
                },
                {
                  "id": "guess_many",
                  "text": "Use the word many without a formula."
                },
                {
                  "id": "ignore_build",
                  "text": "Compare only per-query terms."
                },
                {
                  "id": "variable_names",
                  "text": "Choose the strategy whose query variable has the shorter name."
                }
              ],
              "acceptedOptionIds": [
                "solve_inequality"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A break-even point follows from P1 + qQ1 versus P2 + qQ2.",
              "details": "The resulting threshold may depend on n, constants, memory, and update frequency.",
              "wrongOptionExplanationsByOptionId": {
                "guess_many": "The threshold depends on n and both query costs.",
                "ignore_build": "That removes the cost being amortized.",
                "variable_names": "Names do not affect cost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-preprocess-009",
            "prompt": "Which costs belong in a preprocessing-versus-query comparison? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "build",
                  "text": "One-time build or sort cost."
                },
                {
                  "id": "per_query",
                  "text": "Per-query cost multiplied by q."
                },
                {
                  "id": "memory",
                  "text": "Additional index or table storage."
                },
                {
                  "id": "names",
                  "text": "Variable and function names."
                }
              ],
              "acceptedOptionIds": [
                "build",
                "per_query",
                "memory"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A complete comparison covers total time and storage.",
              "details": "Update maintenance and output can add further terms when present.",
              "wrongOptionExplanationsByOptionId": {
                "names": "Names do not affect resources."
              },
              "omittedCorrectExplanationsByOptionId": {
                "build": "It is paid before queries.",
                "per_query": "The query repeats.",
                "memory": "A faster strategy may exceed memory limits."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-010",
            "prompt": "Which workload properties make preprocessing more attractive? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "large_q",
                  "text": "Many queries reuse the same data."
                },
                {
                  "id": "static_data",
                  "text": "The underlying data changes rarely or not at all."
                },
                {
                  "id": "large_query_saving",
                  "text": "The per-query improvement is substantial."
                },
                {
                  "id": "single_tiny_query",
                  "text": "One tiny query with no future reuse."
                }
              ],
              "acceptedOptionIds": [
                "large_q",
                "static_data",
                "large_query_saving"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Preprocessing pays off through reuse and stability.",
              "details": "A one-shot workload often favors direct computation.",
              "wrongOptionExplanationsByOptionId": {
                "single_tiny_query": "Preprocessing may dominate the workload."
              },
              "omittedCorrectExplanationsByOptionId": {
                "large_q": "The build cost is shared.",
                "static_data": "The index stays valid.",
                "large_query_saving": "Each query recovers more of the initial cost."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-011",
            "prompt": "Which facts can make an index unattractive despite fast queries? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "memory_limit",
                  "text": "The index exceeds available memory."
                },
                {
                  "id": "frequent_updates",
                  "text": "Maintaining correctness after updates is expensive."
                },
                {
                  "id": "small_q",
                  "text": "Too few queries occur to recover build cost."
                },
                {
                  "id": "query_fast",
                  "text": "The index answers queries quickly."
                }
              ],
              "acceptedOptionIds": [
                "memory_limit",
                "frequent_updates",
                "small_q"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Query speed is only one part of a data-structure tradeoff.",
              "details": "Build, maintenance, and memory can dominate.",
              "wrongOptionExplanationsByOptionId": {
                "query_fast": "That is the intended benefit, not a disadvantage."
              },
              "omittedCorrectExplanationsByOptionId": {
                "memory_limit": "Space can reject the strategy.",
                "frequent_updates": "Update cost becomes part of the workload.",
                "small_q": "The amortized benefit is too small."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-preprocess-012",
            "prompt": "Which distinctions should be explicit in a repeated-query model? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "static_dynamic",
                  "text": "Static data versus data with updates."
                },
                {
                  "id": "online_offline",
                  "text": "Online arrival versus all queries known in advance."
                },
                {
                  "id": "one_many",
                  "text": "One query versus many queries."
                },
                {
                  "id": "loop_names",
                  "text": "Whether loops are named outer and inner."
                }
              ],
              "acceptedOptionIds": [
                "static_dynamic",
                "online_offline",
                "one_many"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The same asymptotic query primitive can lead to different total strategies under different workload contracts.",
              "details": "Stating the model prevents transferring an invalid tradeoff.",
              "wrongOptionExplanationsByOptionId": {
                "loop_names": "Names do not define workload."
              },
              "omittedCorrectExplanationsByOptionId": {
                "static_dynamic": "It determines maintenance needs.",
                "online_offline": "Offline batching may be legal.",
                "one_many": "It changes whether preprocessing pays."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-013",
            "prompt": "Arrange the comparison of a direct strategy and a preprocessed strategy.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "write_direct",
                  "text": "Write the direct total cost for q queries."
                },
                {
                  "id": "write_preprocessed",
                  "text": "Write build cost plus q times indexed query cost."
                },
                {
                  "id": "compare_space_updates",
                  "text": "Add memory and update-maintenance constraints."
                },
                {
                  "id": "choose",
                  "text": "Choose the strategy that satisfies the full workload with margin."
                }
              ],
              "canonicalOrder": [
                "write_direct",
                "write_preprocessed",
                "compare_space_updates",
                "choose"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A query-only comparison is incomplete.",
              "details": "The decision belongs to total workload, not one isolated operation."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-014",
            "prompt": "Arrange the prefix-sum workflow for a static array.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "build",
                  "text": "Build the prefix array in O(n)."
                },
                {
                  "id": "receive_query",
                  "text": "Receive a range-sum query."
                },
                {
                  "id": "subtract_prefixes",
                  "text": "Answer it with a constant number of prefix lookups and subtraction."
                },
                {
                  "id": "repeat",
                  "text": "Reuse the same prefix array for remaining queries."
                }
              ],
              "canonicalOrder": [
                "build",
                "receive_query",
                "subtract_prefixes",
                "repeat"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The one-time build is recovered through repeated constant-time queries.",
              "details": "The model assumes updates do not invalidate the prefix data."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-015",
            "prompt": "Arrange the review of a data structure under updates and queries.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "count_workload",
                  "text": "Count builds, updates, and queries."
                },
                {
                  "id": "cost_each",
                  "text": "Derive the cost of each operation type."
                },
                {
                  "id": "combine",
                  "text": "Compute build + u·update + q·query."
                },
                {
                  "id": "check_validity",
                  "text": "Verify the maintained structure remains semantically correct after every update."
                }
              ],
              "canonicalOrder": [
                "count_workload",
                "cost_each",
                "combine",
                "check_validity"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Dynamic workloads need more than preprocessing and query terms.",
              "details": "A stale but fast index is not a valid solution."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-016",
            "prompt": "An unsorted array of n values receives q membership queries. Strategy A scans in O(n) per query. Strategy B sorts once in O(n log n) and uses O(log n) binary search per query. Select both total-time expressions.",
            "constraints": [
              "Original-order mutation is legal."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "strategy_a",
                "strategy_b"
              ],
              "availableValuesByDimension": {
                "strategy_a": [
                  "O(n + q)",
                  "O(qn)",
                  "O(n log n)",
                  "O(q log n)"
                ],
                "strategy_b": [
                  "O(n log n + q log n)",
                  "O(qn)",
                  "O(n + q)",
                  "O(nq log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "strategy_a": [
                  "O(qn)"
                ],
                "strategy_b": [
                  "O(n log n + q log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "strategy_a": {
                  "scan_each": "O(qn)"
                },
                "strategy_b": {
                  "sort_plus_queries": "O(n log n + q log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The direct scan repeats n work q times.",
              "details": "The indexed strategy pays sorting once and logarithmic work per query."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-017",
            "prompt": "A static array of n values is preprocessed into prefix sums, then q range-sum queries are answered. Select total time and auxiliary-space complexity.",
            "constraints": [
              "Each query is O(1), and the prefix array is not part of the returned output."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(q)",
                  "O(n)",
                  "O(n + q)",
                  "O(nq)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(nq)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n + q)"
                ],
                "auxiliary_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "build_plus_queries": "O(n + q)"
                },
                "auxiliary_space": {
                  "prefix_array": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The build scans n values and each of q queries uses constant work.",
              "details": "The prefix array is reusable auxiliary state."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-018",
            "prompt": "A hash set is built from n values and answers q membership queries in expected O(1) each. Select expected total time and auxiliary space.",
            "constraints": [
              "Assume expected O(1) insertion and lookup and at most n distinct keys."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "expected_time",
                "auxiliary_space"
              ],
              "availableValuesByDimension": {
                "expected_time": [
                  "O(q)",
                  "O(n)",
                  "O(n + q)",
                  "O(nq)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(nq)"
                ]
              },
              "acceptedValuesByDimension": {
                "expected_time": [
                  "O(n + q)"
                ],
                "auxiliary_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "expected_time": {
                  "build_plus_queries": "O(n + q)"
                },
                "auxiliary_space": {
                  "set_entries": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Expected linear build plus expected constant-time queries gives O(n + q).",
              "details": "The index stores up to one entry per distinct input value."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-019",
            "prompt": "For n = 1,000 and q = 1, compare q linear scans with sorting once plus q binary searches using log2 n ≈ 10. Select the dominant operation estimates.",
            "constraints": [
              "Ignore constants and treat one comparison as one unit."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "scan_strategy",
                "sorted_strategy"
              ],
              "availableValuesByDimension": {
                "scan_strategy": [
                  "about 1,000q",
                  "about 1,000 + q",
                  "about 10q",
                  "about 10,000 + 10q"
                ],
                "sorted_strategy": [
                  "about 10,000 + 10q",
                  "about 1,000q",
                  "about q",
                  "about 1,000 + q"
                ]
              },
              "acceptedValuesByDimension": {
                "scan_strategy": [
                  "about 1,000q"
                ],
                "sorted_strategy": [
                  "about 10,000 + 10q"
                ]
              },
              "normalizedAliasesByDimension": {
                "scan_strategy": {
                  "q_scans": "about 1,000q"
                },
                "sorted_strategy": {
                  "sort_plus_binary": "about 10,000 + 10q"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The formulas expose a break-even near ten queries under the simplified model.",
              "details": "A real decision still considers constants, order legality, and memory."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          },
          {
            "id": "alg-complexity-preprocess-020",
            "prompt": "A mutable dataset of n values receives u updates. After each update, a full O(n) prefix structure is rebuilt, and q queries cost O(1) each. Select total time.",
            "constraints": [
              "The initial build cost is included in the same asymptotic term."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n + u + q)",
                  "O(un + q)",
                  "O(uq)",
                  "O(nuq)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(un + q)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "rebuilds_plus_queries": "O(un + q)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Each of u updates triggers linear rebuilding, while queries are constant-time.",
              "details": "A static prefix-sum advantage can disappear under frequent updates."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "repeated_query_cost_model"
            }
          }
        ],
