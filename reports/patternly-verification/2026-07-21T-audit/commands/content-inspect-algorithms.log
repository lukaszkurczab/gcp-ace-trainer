          {
            "id": "alg-backtracking-base-contract-013",
            "prompt": "Arrange the control flow for a collect-all backtracking call.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_failure",
                  "text": "Reject an impossible partial state."
                },
                {
                  "id": "check_completion",
                  "text": "If complete, record a snapshot and return from this branch."
                },
                {
                  "id": "enumerate_choices",
                  "text": "Enumerate legal next choices."
                },
                {
                  "id": "recurse_each",
                  "text": "Recurse for each choice and restore branch state."
                }
              ],
              "canonicalOrder": [
                "check_failure",
                "check_completion",
                "enumerate_choices",
                "recurse_each"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Failure and completion are resolved before expanding nonterminal states.",
              "details": "This ordering prevents invalid states from expanding and ensures completed states are recorded exactly once."
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "construct_valid_assignment"
            }
          },
          {
            "id": "alg-backtracking-base-contract-014",
            "prompt": "Arrange the steps for recording a completed mutable path safely.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "recognize_complete",
                  "text": "Verify that the completion contract is satisfied."
                },
                {
                  "id": "copy_path",
                  "text": "Create a snapshot of the current path."
                },
                {
                  "id": "append_snapshot",
                  "text": "Append the snapshot to the results."
                },
                {
                  "id": "return_branch",
                  "text": "Return from the completed branch without generating extra choices."
                }
              ],
              "canonicalOrder": [
                "recognize_complete",
                "copy_path",
                "append_snapshot",
                "return_branch"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A result must be recognized, frozen, stored, and then treated as terminal.",
              "details": "Copying after later mutations would capture the wrong state, and continuing choices could create invalid overlong results."
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "choice_tree",
              "problemArchetypeId": "enumerate_combinations"
            }
          },
          {
            "id": "alg-backtracking-base-contract-015",
            "prompt": "Arrange the checks for a find-one grid word-search call.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "target_complete",
                  "text": "If the full target is matched, return success."
                },
                {
                  "id": "bounds_and_match",
                  "text": "Reject out-of-bounds, mismatched, or path-reused cells."
                },
                {
                  "id": "mark_and_search",
                  "text": "Mark the current cell and search legal neighbors."
                },
                {
                  "id": "restore_and_fail",
                  "text": "Restore the cell state and return failure if no neighbor succeeds."
                }
              ],
              "canonicalOrder": [
                "target_complete",
                "bounds_and_match",
                "mark_and_search",
                "restore_and_fail"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Success completion is checked before attempting another cell, while invalid current states fail before mutation.",
              "details": "The order separates completed success, invalid failure, recursive expansion, and branch restoration."
            },
            "taxonomy": {
              "primarySkillAtomId": "define_backtracking_completion_contract",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "grid_search",
              "problemArchetypeId": "search_grid_paths"
            }
          },
          {
