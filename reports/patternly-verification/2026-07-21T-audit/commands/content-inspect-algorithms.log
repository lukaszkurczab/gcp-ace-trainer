        "items": [
          {
            "id": "alg-mg-mod-congruence-closure-rules",
            "prompt": "Select all statements that are valid for integers modulo a positive modulus m.",
            "constraints": [
              "Congruence a ≡ b (mod m) means m divides a-b.",
              "All arithmetic statements are mathematical, not language-specific % behavior."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "addition_preserves",
                  "text": "If a ≡ b (mod m), then a+c ≡ b+c (mod m)."
                },
                {
                  "id": "multiplication_preserves",
                  "text": "If a ≡ b (mod m) and c ≡ d (mod m), then ac ≡ bd (mod m)."
                },
                {
                  "id": "arbitrary_cancellation",
                  "text": "If ka ≡ kb (mod m), then a ≡ b (mod m) for every integer k."
                },
                {
                  "id": "decimal_equality",
                  "text": "Two residues are congruent exactly when their floating-point decimal representations compare equal."
                }
              ],
              "acceptedOptionIds": [
                "addition_preserves",
                "multiplication_preserves"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Congruence is preserved by addition and multiplication, while cancellation needs an invertibility condition.",
              "details": "Because m divides a-b, it also divides (a+c)-(b+c). If m divides both a-b and c-d, expanding ac-bd=a(c-d)+d(a-b) shows multiplication preserves congruence. Cancellation is different: from k(a-b) divisible by m, a-b need not be divisible by m when k shares a factor with m. Floating decimal equality is neither the definition nor a reliable exact test.",
