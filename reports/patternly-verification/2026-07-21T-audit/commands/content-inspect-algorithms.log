        "items": [
          {
            "id": "alg-contrast-binary-scan-keywords-001",
            "prompt": "A function contains variables named left, right, and mid, but right decreases by one on every iteration. Which classification is justified?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_progress",
                  "text": "It has linear worst-case progress unless another branch provides stronger shrinkage."
                },
                {
                  "id": "binary_by_names",
                  "text": "It is binary search and therefore O(log n)."
                },
                {
                  "id": "constant",
                  "text": "It is O(1) because only three variables are used."
                },
                {
                  "id": "quadratic",
                  "text": "It is automatically O(n²) because it has two boundaries."
                }
              ],
              "acceptedOptionIds": [
                "linear_progress"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Classification follows executed updates and invariant, not identifier names.",
              "details": "If the interval loses one candidate per iteration, midpoint syntax does not create logarithmic behavior.",
              "wrongOptionExplanationsByOptionId": {
                "binary_by_names": "Variable names do not determine how fast the candidate set shrinks.",
                "constant": "Space variables do not determine iteration count.",
                "quadratic": "Two boundaries do not imply nested work."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-002",
            "prompt": "A problem statement uses the phrase “find a threshold.” What must be proven before choosing binary search?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "monotonic_threshold",
                  "text": "The threshold predicate has one directional transition over an ordered candidate domain."
                },
                {
                  "id": "word_threshold",
                  "text": "Nothing else; the word threshold is sufficient."
                },
                {
                  "id": "numeric_input",
                  "text": "Only that the input contains numbers."
                },
                {
                  "id": "midpoint",
                  "text": "Only that a midpoint can be computed."
                }
              ],
              "acceptedOptionIds": [
                "monotonic_threshold"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A threshold label must correspond to an actual boundary in predicate truth.",
              "details": "The proof, not the keyword, supplies the half-discard rule.",
              "wrongOptionExplanationsByOptionId": {
                "word_threshold": "Natural-language wording does not guarantee monotonicity.",
                "numeric_input": "Numeric values can support arbitrary conditions.",
                "midpoint": "Every finite range has a midpoint, including invalid search models."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-003",
            "prompt": "The input is described as sorted, but the query asks for the first value whose hash has an even final bit. Which strategy follows from the description alone?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "none_until_structure",
                  "text": "No binary-search conclusion follows; the hash condition may require scanning unless separately indexed."
                },
                {
                  "id": "binary_sorted",
                  "text": "Binary search is mandatory because sorted appears in the prompt."
                },
                {
                  "id": "lower_bound_hash",
                  "text": "Use lower bound on the hash parity."
                },
                {
                  "id": "mid_hash",
                  "text": "Check only the middle hash because mid implies logarithmic search."
                }
              ],
              "acceptedOptionIds": [
                "none_until_structure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The sort key and query property must align.",
              "details": "A surface keyword cannot replace a proof that one side is impossible.",
              "wrongOptionExplanationsByOptionId": {
                "binary_sorted": "The condition need not be monotonic in value order.",
                "lower_bound_hash": "Parity does not form one ordered boundary.",
                "mid_hash": "The midpoint does not classify either side."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-004",
            "prompt": "A loop is named binarySearch but sequentially checks array[i] for i = 0, 1, 2, .... What is it?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_scan",
                  "text": "A linear scan."
                },
                {
                  "id": "binary_search",
                  "text": "Binary search because the function name says so."
                },
                {
                  "id": "hybrid_log",
                  "text": "A logarithmic hybrid because the name and loop differ."
                },
                {
                  "id": "unknown",
                  "text": "Impossible to classify even with the loop described."
                }
              ],
              "acceptedOptionIds": [
                "linear_scan"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Algorithm names are claims that must match the implementation.",
              "details": "Sequentially advancing one index and checking candidates is a scan regardless of the label.",
              "wrongOptionExplanationsByOptionId": {
                "binary_search": "Behavior, not the function name, defines the algorithm.",
                "hybrid_log": "The executed work is sequential candidate inspection.",
                "unknown": "The traversal pattern is explicit."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-005",
            "prompt": "A loop uses a variable named scanIndex but halves a proven monotonic candidate interval every iteration. Which classification is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "binary_structure",
                  "text": "It implements binary-search structure despite the variable name."
                },
                {
                  "id": "linear_by_name",
                  "text": "It is a linear scan because the variable is called scanIndex."
                },
                {
                  "id": "constant",
                  "text": "It is O(1) because there is one index variable."
                },
                {
                  "id": "not_search",
                  "text": "It is not a search because mid is not named explicitly."
                }
              ],
              "acceptedOptionIds": [
                "binary_structure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The invariant and update rule define the algorithm.",
              "details": "A correct half-discard search remains binary search under any sensible identifiers.",
              "wrongOptionExplanationsByOptionId": {
                "linear_by_name": "Names do not override interval-halving semantics.",
                "constant": "The interval requires logarithmically many iterations.",
                "not_search": "A midpoint can be computed under another identifier."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-006",
            "prompt": "A solution contains a while loop and two pointers. Is that enough to distinguish binary search from a two-pointer scan?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_updates_decide",
                  "text": "No. The candidate invariant and pointer updates must be examined."
                },
                {
                  "id": "yes_two_binary",
                  "text": "Yes. Two pointers always mean binary search."
                },
                {
                  "id": "yes_while_scan",
                  "text": "Yes. A while loop always means a scan."
                },
                {
                  "id": "yes_names",
                  "text": "Yes, if the variables are named left and right."
                }
              ],
              "acceptedOptionIds": [
                "no_updates_decide"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Shared syntax is not a strategy boundary.",
              "details": "Binary search discards a proven region; a two-pointer scan typically advances one or both endpoints according to a different invariant.",
              "wrongOptionExplanationsByOptionId": {
                "yes_two_binary": "Two-pointer scans also maintain two indices.",
                "yes_while_scan": "Binary search is commonly iterative with while.",
                "yes_names": "Those names appear in both patterns."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-007",
            "prompt": "A problem says “search in O(log n)” but the input is unsorted and no preprocessing is permitted. What should the analyst do?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "challenge_contract",
                  "text": "Challenge the stated target or identify missing structure; do not invent an unsound binary search."
                },
                {
                  "id": "force_binary",
                  "text": "Use midpoint discard because the complexity target demands it."
                },
                {
                  "id": "assume_sorted",
                  "text": "Assume the input is sorted even though it is not stated."
                },
                {
                  "id": "rename_array",
                  "text": "Rename the array to sortedValues."
                }
              ],
              "acceptedOptionIds": [
                "challenge_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Complexity requirements must be reconciled with available structure.",
              "details": "The correct response may be to request a sorted/indexed precondition or explain that the bound is infeasible under the current contract.",
              "wrongOptionExplanationsByOptionId": {
                "force_binary": "A desired bound cannot create correctness conditions.",
                "assume_sorted": "That changes the input contract.",
                "rename_array": "Naming does not order data."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-008",
            "prompt": "A code review comment says, “This has nested if statements, so it cannot be binary search.” Which response is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "control_shape_irrelevant",
                  "text": "Nested conditionals do not decide the pattern; interval elimination and progress do."
                },
                {
                  "id": "if_forces_scan",
                  "text": "Any nested conditional forces linear scanning."
                },
                {
                  "id": "binary_one_if",
                  "text": "Binary search must contain exactly one if statement."
                },
                {
                  "id": "complexity_syntax",
                  "text": "Big-O can be read directly from indentation depth."
                }
              ],
              "acceptedOptionIds": [
                "control_shape_irrelevant"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Surface control-flow shape is weaker evidence than the maintained invariant.",
              "details": "A binary search may need multiple branches for equality, ordered-half detection, or boundary semantics.",
              "wrongOptionExplanationsByOptionId": {
                "if_forces_scan": "Branch structure does not imply candidate count.",
                "binary_one_if": "Implementations vary in branch organization.",
                "complexity_syntax": "Executed iterations and work determine complexity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-009",
            "prompt": "The requirement says “closest value.” Does that phrase identify binary search by itself?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "depends_structure",
                  "text": "No. It depends on sorted order, access model, tie-breaking, and the exact closeness contract."
                },
                {
                  "id": "always_binary",
                  "text": "Yes. Closest always means binary search."
                },
                {
                  "id": "always_scan",
                  "text": "Yes, and it always means linear scan."
                },
                {
                  "id": "mid_closest",
                  "text": "Return the first midpoint because it is geometrically central."
                }
              ],
              "acceptedOptionIds": [
                "depends_structure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Problem keywords name an output goal, not necessarily the mechanism.",
              "details": "Binary search becomes appropriate when sorted value boundaries locate neighboring candidates whose distances can be compared.",
              "wrongOptionExplanationsByOptionId": {
                "always_binary": "Unsorted data or custom metrics may require other methods.",
                "always_scan": "Sorted numeric data can support a boundary-based closest lookup.",
                "mid_closest": "Index centrality is unrelated to value distance."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-010",
            "prompt": "A function computes mid = (left + right) // 2 but then recursively explores both halves. Which complexity signal is most accurate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "not_single_half",
                  "text": "Computing mid does not make it logarithmic; exploring both halves may visit the whole domain or more."
                },
                {
                  "id": "always_log",
                  "text": "Any midpoint recursion is O(log n)."
                },
                {
                  "id": "constant",
                  "text": "The midpoint calculation is O(1), so the whole function is O(1)."
                },
                {
                  "id": "linear_scan_name",
                  "text": "It becomes a scan only if an index is named i."
                }
              ],
              "acceptedOptionIds": [
                "not_single_half"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The recurrence follows how many subproblems are explored.",
              "details": "Binary search obtains T(n) = T(n/2) + O(1); exploring both halves follows a different recurrence.",
              "wrongOptionExplanationsByOptionId": {
                "always_log": "Logarithmic search explores one retained half, not both.",
                "constant": "Recursive work dominates.",
                "linear_scan_name": "Names do not determine the recurrence."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-011",
            "prompt": "A sorted array query uses a helper named isValid(mid), but isValid alternates across indices. Which classification is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "arbitrary_condition",
                  "text": "It is an arbitrary-condition scan problem unless another structure is added."
                },
                {
                  "id": "monotonic_by_name",
                  "text": "It is monotonic because the helper is called isValid."
                },
                {
                  "id": "binary_by_parameter",
                  "text": "Passing mid makes it binary-searchable."
                },
                {
                  "id": "sorted_enough",
                  "text": "Sorted input alone makes the helper monotonic."
                }
              ],
              "acceptedOptionIds": [
                "arbitrary_condition"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Semantic behavior must be inspected directly.",
              "details": "A scan can evaluate every index; binary search cannot safely discard a side under an alternating helper.",
              "wrongOptionExplanationsByOptionId": {
                "monotonic_by_name": "The truth sequence, not the name, determines monotonicity.",
                "binary_by_parameter": "Any index can be passed to an arbitrary predicate.",
                "sorted_enough": "The helper may not follow the sort key."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-012",
            "prompt": "Which observations are insufficient by themselves to classify code as binary search? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "left_right_mid",
                  "text": "Variables named left, right, and mid."
                },
                {
                  "id": "sorted_word",
                  "text": "The prompt contains the word sorted."
                },
                {
                  "id": "while_loop",
                  "text": "The implementation uses a while loop."
                },
                {
                  "id": "half_discard_proof",
                  "text": "Each midpoint outcome proves one whole side impossible and the interval shrinks proportionally."
                }
              ],
              "acceptedOptionIds": [
                "left_right_mid",
                "sorted_word",
                "while_loop"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Syntax and vocabulary are weak signals.",
              "details": "The half-discard proof and boundary invariant are the decisive evidence.",
              "wrongOptionExplanationsByOptionId": {
                "half_discard_proof": "This is substantive classification evidence."
              },
              "omittedCorrectExplanationsByOptionId": {
                "left_right_mid": "The updates may still be linear or incorrect.",
                "sorted_word": "The query may not align with the order.",
                "while_loop": "Many patterns use while loops."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-013",
            "prompt": "Which evidence should replace keyword-based strategy classification? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "candidate_invariant",
                  "text": "A statement describing where the answer can still remain."
                },
                {
                  "id": "discard_implication",
                  "text": "A proof connecting midpoint outcomes to impossible regions."
                },
                {
                  "id": "progress_measure",
                  "text": "A demonstration that every nonterminal step shrinks the candidate set."
                },
                {
                  "id": "familiar_names",
                  "text": "Identifiers copied from a standard template."
                }
              ],
              "acceptedOptionIds": [
                "candidate_invariant",
                "discard_implication",
                "progress_measure"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Classification should rest on semantic and operational evidence.",
              "details": "Familiar names can help readability only after the algorithm is already correct.",
              "wrongOptionExplanationsByOptionId": {
                "familiar_names": "Templates can be misapplied."
              },
              "omittedCorrectExplanationsByOptionId": {
                "candidate_invariant": "This defines the active search state.",
                "discard_implication": "This determines legal elimination.",
                "progress_measure": "This determines termination and iteration count."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-014",
            "prompt": "Which code behaviors are compatible with a linear scan despite binary-search-like names? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "one_step_boundary",
                  "text": "A boundary moves by exactly one position on every iteration."
                },
                {
                  "id": "check_every_item",
                  "text": "Every element is eventually inspected in the worst case."
                },
                {
                  "id": "no_side_proof",
                  "text": "Midpoint outcomes do not imply anything about unchecked regions."
                },
                {
                  "id": "half_each_time",
                  "text": "Exactly one proven half is retained after every mismatch."
                }
              ],
              "acceptedOptionIds": [
                "one_step_boundary",
                "check_every_item",
                "no_side_proof"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The executed candidate progression defines the method.",
              "details": "Names can obscure a scan but cannot change its work or proof structure.",
              "wrongOptionExplanationsByOptionId": {
                "half_each_time": "This is binary-search behavior."
              },
              "omittedCorrectExplanationsByOptionId": {
                "one_step_boundary": "The candidate count may decline linearly.",
                "check_every_item": "This is scan-like work.",
                "no_side_proof": "No binary elimination occurs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-015",
            "prompt": "Which prompt words require further analysis rather than an automatic binary-search choice? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sorted",
                  "text": "sorted."
                },
                {
                  "id": "threshold",
                  "text": "threshold."
                },
                {
                  "id": "minimum",
                  "text": "minimum."
                },
                {
                  "id": "first_true_proof",
                  "text": "A proven false-to-true predicate over a bounded ordered domain."
                }
              ],
              "acceptedOptionIds": [
                "sorted",
                "threshold",
                "minimum"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Common interview vocabulary identifies hypotheses to test, not guaranteed strategies.",
              "details": "The explicit first-true proof is different because it states the actual transferable mechanism.",
              "wrongOptionExplanationsByOptionId": {
                "first_true_proof": "This phrase already includes the decisive structure rather than a surface keyword."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sorted": "The query still must align with the order.",
                "threshold": "The threshold may not represent a monotonic predicate.",
                "minimum": "Optimization alone does not create monotonic feasibility."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-keywords-016",
            "prompt": "A loop uses variables left, right, and mid but removes exactly one candidate per O(1) iteration. Another loop uses variable i and doubles i each O(1) iteration until i >= n. Select the worst-case time of each.",
            "constraints": [
              "The first loop starts with n candidates.",
              "The second loop starts at i = 1."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "named_binary_loop",
                "named_scan_loop"
              ],
              "availableValuesByDimension": {
                "named_binary_loop": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ],
                "named_scan_loop": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "named_binary_loop": [
                  "O(n)"
                ],
                "named_scan_loop": [
                  "O(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "named_binary_loop": {
                  "one_candidate_removed": "O(n)"
                },
                "named_scan_loop": {
                  "doubling": "O(log n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Variable names can point in the opposite direction from the true complexity.",
              "details": "The update magnitude and termination condition determine iteration counts."
            },
            "taxonomy": {
              "primarySkillAtomId": "reject_keyword_based_binary_search_classification",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          }
        ],
