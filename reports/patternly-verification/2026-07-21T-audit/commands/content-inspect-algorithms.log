        "items": [
          {
            "id": "alg-binary-search-answer-001",
            "prompt": "A problem asks for the minimum capacity that makes a schedule feasible. Which candidate domain should binary search operate on?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "capacity_values",
                  "text": "An ordered range of possible capacity values."
                },
                {
                  "id": "job_indices",
                  "text": "Only the indices of input jobs."
                },
                {
                  "id": "result_booleans",
                  "text": "The two values true and false."
                },
                {
                  "id": "loop_counts",
                  "text": "Possible numbers of loop iterations."
                }
              ],
              "acceptedOptionIds": [
                "capacity_values"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Binary search on answer searches the value being optimized.",
              "details": "The input provides data for the feasibility predicate, while candidate capacities form the ordered answer domain.",
              "wrongOptionExplanationsByOptionId": {
                "job_indices": "The optimized quantity is capacity, not a job position.",
                "result_booleans": "The predicate result guides search but is not the answer domain.",
                "loop_counts": "Iteration count is an implementation consequence."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-002",
            "prompt": "For minimizing capacity, feasible(x) is false for small x and true for large x. Which result should be returned?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "first_true",
                  "text": "The first feasible candidate."
                },
                {
                  "id": "last_true",
                  "text": "The last feasible candidate."
                },
                {
                  "id": "first_false",
                  "text": "The first infeasible candidate."
                },
                {
                  "id": "any_true",
                  "text": "Any feasible candidate."
                }
              ],
              "acceptedOptionIds": [
                "first_true"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Minimization over false-to-true feasibility is a first-true boundary problem.",
              "details": "The search retains a feasible midpoint while checking whether a smaller feasible candidate exists.",
              "wrongOptionExplanationsByOptionId": {
                "last_true": "That is usually just the largest bound, not the minimum.",
                "first_false": "The answer must satisfy feasibility.",
                "any_true": "This does not guarantee minimality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-003",
            "prompt": "For maximizing a minimum distance, valid(d) is true for small d and false for large d. Which result should be returned?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "last_true",
                  "text": "The last valid distance."
                },
                {
                  "id": "first_true",
                  "text": "The first valid distance."
                },
                {
                  "id": "first_false",
                  "text": "The first invalid distance."
                },
                {
                  "id": "domain_max",
                  "text": "The maximum bound without checking feasibility."
                }
              ],
              "acceptedOptionIds": [
                "last_true"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Maximization over a true-to-false predicate is a last-true boundary problem.",
              "details": "A valid midpoint allows the search to seek a larger feasible candidate.",
              "wrongOptionExplanationsByOptionId": {
                "first_true": "That gives a small feasible value, not the maximum.",
                "first_false": "The requested answer must remain valid.",
                "domain_max": "The largest bound may be impossible."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "maximize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-004",
            "prompt": "Does the optimal answer need to appear as an element of the input array?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_answer_domain",
                  "text": "No. It may be any candidate value in the explicitly modeled answer domain."
                },
                {
                  "id": "yes_input_only",
                  "text": "Yes. Binary search can inspect only values stored in the input."
                },
                {
                  "id": "yes_mid_index",
                  "text": "Yes. Every midpoint is an input index."
                },
                {
                  "id": "only_if_sorted",
                  "text": "It appears in the input only when the input is sorted."
                }
              ],
              "acceptedOptionIds": [
                "no_answer_domain"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Answer-space search is distinct from index search.",
              "details": "For example, minimum feasible capacity may be a sum or threshold not present in the original data.",
              "wrongOptionExplanationsByOptionId": {
                "yes_input_only": "Binary search on answer can search an integer value range.",
                "yes_mid_index": "The midpoint may represent a candidate answer value.",
                "only_if_sorted": "Sortedness does not determine answer membership."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-005",
            "prompt": "What makes a lower answer bound sound?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_optimum_below",
                  "text": "No valid optimal answer can lie below it."
                },
                {
                  "id": "looks_small",
                  "text": "It is a convenient small number."
                },
                {
                  "id": "input_min_always",
                  "text": "It always equals the minimum input value."
                },
                {
                  "id": "zero_always",
                  "text": "It is always zero."
                }
              ],
              "acceptedOptionIds": [
                "no_optimum_below"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Search bounds must contain every possible optimal answer.",
              "details": "A lower bound can come from mandatory per-item requirements, mathematical limits, or contract constraints.",
              "wrongOptionExplanationsByOptionId": {
                "looks_small": "Convenience is not a correctness proof.",
                "input_min_always": "Different objectives require different bounds.",
                "zero_always": "Some answer domains begin above zero."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-006",
            "prompt": "What makes an upper answer bound sound?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "contains_feasible_or_limit",
                  "text": "It is guaranteed to be at or beyond every possible optimum, often with a known feasible candidate for minimization."
                },
                {
                  "id": "largest_input_always",
                  "text": "It must always equal the largest input value."
                },
                {
                  "id": "random_large",
                  "text": "Any arbitrarily large number is automatically safe and efficient."
                },
                {
                  "id": "first_mid",
                  "text": "It equals the first midpoint selected."
                }
              ],
              "acceptedOptionIds": [
                "contains_feasible_or_limit"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The upper boundary must complete the enclosure of the answer domain.",
              "details": "For first-feasible minimization, a known feasible upper candidate makes the boundary contract especially clear.",
              "wrongOptionExplanationsByOptionId": {
                "largest_input_always": "Some objectives require a sum or wider bound.",
                "random_large": "It may overflow or create an unnecessarily wide domain.",
                "first_mid": "Midpoint follows from bounds; it does not justify them."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-007",
            "prompt": "Why is a feasibility predicate different from the optimization objective?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "decision_vs_optimum",
                  "text": "The predicate answers whether one candidate works; binary search uses those decisions to locate the optimum boundary."
                },
                {
                  "id": "same_value",
                  "text": "They are always the same numeric expression."
                },
                {
                  "id": "predicate_returns_index",
                  "text": "The predicate must return an input index."
                },
                {
                  "id": "objective_not_needed",
                  "text": "The objective can be ignored once a predicate exists."
                }
              ],
              "acceptedOptionIds": [
                "decision_vs_optimum"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Binary search reduces optimization to repeated decision problems.",
              "details": "The predicate must be complete enough to classify one candidate and monotonic enough to eliminate a region.",
              "wrongOptionExplanationsByOptionId": {
                "same_value": "A boolean decision and an optimized value serve different roles.",
                "predicate_returns_index": "It normally returns true or false.",
                "objective_not_needed": "The objective determines first true versus last true and the answer domain."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-008",
            "prompt": "A proposed feasibility predicate returns true, false, then true again as capacity increases. What is the correct diagnosis?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "invalid_model",
                  "text": "The predicate or candidate model is not suitable for ordinary binary search on answer."
                },
                {
                  "id": "use_upper_mid",
                  "text": "An upper-biased midpoint will repair it."
                },
                {
                  "id": "search_twice",
                  "text": "Running binary search twice guarantees the optimum."
                },
                {
                  "id": "sort_answers",
                  "text": "Sorting the boolean results during the search will fix them."
                }
              ],
              "acceptedOptionIds": [
                "invalid_model"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Answer-space search needs one monotonic feasibility transition.",
              "details": "The model must be revised or a different algorithm chosen.",
              "wrongOptionExplanationsByOptionId": {
                "use_upper_mid": "Midpoint bias cannot create monotonicity.",
                "search_twice": "Repeated use of an invalid predicate remains unsupported.",
                "sort_answers": "Predicate truth is semantic, not a collection to reorder."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-009",
            "prompt": "A minimization predicate is true even at the lower bound. What should a correct first-feasible search be able to return?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "lower_bound",
                  "text": "The lower bound itself."
                },
                {
                  "id": "upper_bound",
                  "text": "Always the upper bound."
                },
                {
                  "id": "lower_plus_one",
                  "text": "The next value after the lower bound."
                },
                {
                  "id": "not_found",
                  "text": "No answer."
                }
              ],
              "acceptedOptionIds": [
                "lower_bound"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The search must retain endpoint candidates.",
              "details": "This all-feasible edge case exposes updates that accidentally discard the left boundary.",
              "wrongOptionExplanationsByOptionId": {
                "upper_bound": "A smaller feasible answer exists.",
                "lower_plus_one": "The optimum may be exactly the boundary.",
                "not_found": "Feasibility at the lower bound proves an answer exists."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-010",
            "prompt": "Which steps are required to model binary search on answer? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "define_answer",
                  "text": "Define the numeric or ordered quantity being optimized."
                },
                {
                  "id": "derive_bounds",
                  "text": "Derive sound lower and upper bounds containing the optimum."
                },
                {
                  "id": "define_feasibility",
                  "text": "Define a complete predicate for one candidate."
                },
                {
                  "id": "prove_monotonicity",
                  "text": "Prove the predicate changes in one direction."
                }
              ],
              "acceptedOptionIds": [
                "define_answer",
                "derive_bounds",
                "define_feasibility",
                "prove_monotonicity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Answer-space search is correct only when domain, bounds, predicate, and transition direction are explicit.",
              "details": "Skipping any layer turns the loop into guesswork.",
              "wrongOptionExplanationsByOptionId": {},
              "omittedCorrectExplanationsByOptionId": {
                "define_answer": "This creates the candidate domain.",
                "derive_bounds": "The search must enclose the answer.",
                "define_feasibility": "Each midpoint must be classifiable.",
                "prove_monotonicity": "This justifies elimination."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-011",
            "prompt": "Which facts can justify answer bounds for minimum processing capacity? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "largest_job",
                  "text": "Capacity must be at least the largest indivisible job."
                },
                {
                  "id": "sum_jobs",
                  "text": "The total job sum is a safe upper bound when one period may process everything."
                },
                {
                  "id": "zero_without_proof",
                  "text": "Zero is always a valid lower bound regardless of job requirements."
                },
                {
                  "id": "random_int_max",
                  "text": "The maximum machine integer is always the preferred upper bound."
                }
              ],
              "acceptedOptionIds": [
                "largest_job",
                "sum_jobs"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Bounds should come from problem semantics and known feasible or impossible limits.",
              "details": "Loose arbitrary bounds can harm safety and clarity.",
              "wrongOptionExplanationsByOptionId": {
                "zero_without_proof": "Some jobs require positive minimum capacity.",
                "random_int_max": "It may overflow midpoint arithmetic and is unnecessarily loose."
              },
              "omittedCorrectExplanationsByOptionId": {
                "largest_job": "A smaller capacity cannot process that job.",
                "sum_jobs": "That candidate is guaranteed sufficient under the stated model."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-012",
            "prompt": "Which properties must a feasibility predicate satisfy? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "candidate_complete",
                  "text": "It fully decides whether the given candidate satisfies the constraints."
                },
                {
                  "id": "stable",
                  "text": "The same candidate yields the same result during one search."
                },
                {
                  "id": "monotonic",
                  "text": "Increasing candidates preserve truth or falsity in the proven direction."
                },
                {
                  "id": "approximate_guess",
                  "text": "It may return an unverified guess when evaluation is expensive."
                }
              ],
              "acceptedOptionIds": [
                "candidate_complete",
                "stable",
                "monotonic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The predicate is the correctness oracle for answer-space search.",
              "details": "Approximate or state-dependent decisions need a different correctness framework.",
              "wrongOptionExplanationsByOptionId": {
                "approximate_guess": "An incorrect boolean can discard the optimum."
              },
              "omittedCorrectExplanationsByOptionId": {
                "candidate_complete": "Each midpoint needs a reliable boolean classification.",
                "stable": "Earlier eliminations rely on stable truth.",
                "monotonic": "One transition is required."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-013",
            "prompt": "Which edge cases should answer-space search handle? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "lower_optimum",
                  "text": "The optimum equals the lower bound."
                },
                {
                  "id": "upper_optimum",
                  "text": "The optimum equals the upper bound."
                },
                {
                  "id": "none_feasible",
                  "text": "No candidate is feasible when the public contract allows a not-found result."
                },
                {
                  "id": "mid_only",
                  "text": "Only a case where the first midpoint is optimal."
                }
              ],
              "acceptedOptionIds": [
                "lower_optimum",
                "upper_optimum",
                "none_feasible"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary and absent-solution cases validate the full result contract.",
              "details": "A midpoint hit is the least demanding test.",
              "wrongOptionExplanationsByOptionId": {
                "mid_only": "This does not exercise updates or endpoints."
              },
              "omittedCorrectExplanationsByOptionId": {
                "lower_optimum": "Endpoint retention must be correct.",
                "upper_optimum": "The other endpoint must also remain searchable.",
                "none_feasible": "The sentinel behavior must be defined."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-014",
            "prompt": "Arrange the design process for binary search on answer.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "define_quantity",
                  "text": "Define the answer quantity and optimization direction."
                },
                {
                  "id": "derive_bounds",
                  "text": "Derive a sound ordered candidate range."
                },
                {
                  "id": "define_predicate",
                  "text": "Implement feasibility for one candidate."
                },
                {
                  "id": "prove_and_search",
                  "text": "Prove monotonicity, select first-true or last-true search, and verify the result."
                }
              ],
              "canonicalOrder": [
                "define_quantity",
                "derive_bounds",
                "define_predicate",
                "prove_and_search"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The loop is the final step after the optimization problem has been converted into a boundary problem.",
              "details": "A correct search cannot compensate for an incorrect answer model."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-015",
            "prompt": "Arrange one minimization iteration for false-to-true feasibility over a half-open candidate range.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "compute_mid",
                  "text": "Compute the candidate midpoint."
                },
                {
                  "id": "evaluate",
                  "text": "Evaluate feasible(mid)."
                },
                {
                  "id": "keep_feasible",
                  "text": "If feasible, retain mid by moving the right boundary to mid."
                },
                {
                  "id": "discard_infeasible",
                  "text": "If infeasible, move the left boundary to mid + 1."
                }
              ],
              "canonicalOrder": [
                "compute_mid",
                "evaluate",
                "keep_feasible",
                "discard_infeasible"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A feasible midpoint may be the minimum, while an infeasible midpoint and all smaller candidates are excluded.",
              "details": "The exact code must preserve the chosen half-open interval semantics."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-016",
            "prompt": "Arrange one maximization iteration for true-to-false feasibility using a progress-safe closed contract.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "compute_upper_mid",
                  "text": "Compute an upper-biased midpoint."
                },
                {
                  "id": "evaluate",
                  "text": "Evaluate valid(mid)."
                },
                {
                  "id": "keep_valid",
                  "text": "If valid, set left = mid to search larger candidates."
                },
                {
                  "id": "discard_invalid",
                  "text": "If invalid, set right = mid - 1."
                }
              ],
              "canonicalOrder": [
                "compute_upper_mid",
                "evaluate",
                "keep_valid",
                "discard_invalid"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A valid midpoint remains a candidate for the maximum and shifts the search right.",
              "details": "Upper bias ensures left = mid progresses when two candidates remain."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "maximize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-017",
            "prompt": "Arrange the post-search verification for a minimum feasible answer x.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "check_range",
                  "text": "Verify x lies inside the declared answer domain."
                },
                {
                  "id": "check_feasible",
                  "text": "Verify feasible(x) is true."
                },
                {
                  "id": "check_predecessor",
                  "text": "Verify x is the lower bound or feasible(x - 1) is false."
                },
                {
                  "id": "return",
                  "text": "Return x as the first feasible candidate."
                }
              ],
              "canonicalOrder": [
                "check_range",
                "check_feasible",
                "check_predecessor",
                "return"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A minimum is proven by feasibility plus predecessor infeasibility or the domain boundary.",
              "details": "This verification catches incorrect bounds and off-by-one updates."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-018",
            "prompt": "The integer answer domain contains W candidates and feasible(x) costs O(n). Select total time and iterative outer-search space.",
            "constraints": [
              "The predicate is monotonic.",
              "The outer search halves the answer range."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "outer_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(log W)",
                  "O(n)",
                  "O(n log W)",
                  "O(nW)"
                ],
                "outer_space": [
                  "O(1)",
                  "O(log W)",
                  "O(n)",
                  "O(W)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log W)"
                ],
                "outer_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "predicate_times_iterations": "O(n log W)"
                },
                "outer_space": {
                  "iterative": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Answer-space width determines predicate-call count, and input size determines each call's cost.",
              "details": "The outer loop itself stores only numeric boundaries."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-019",
            "prompt": "A minimum-capacity search uses candidate range [maxJob, sumJobs], and each feasibility check scans n jobs. Select the standard time bound in terms of range width R = sumJobs - maxJob + 1.",
            "constraints": [
              "Feasibility is false-to-true across the range."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n)",
                  "O(log R)",
                  "O(n log R)",
                  "O(nR)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log R)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "scan_per_candidate_level": "O(n log R)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "The search performs logarithmically many candidate checks, each scanning all jobs.",
              "details": "The logarithm depends on numeric answer range width, not only on the number of jobs."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-020",
            "prompt": "A maximum-minimum-distance solver first sorts n positions, then each feasibility check scans them in O(n), and the answer range has width R. Select total time.",
            "constraints": [
              "Comparison sorting costs O(n log n).",
              "Binary search performs O(log R) feasibility checks."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n log R)",
                  "O(n log n)",
                  "O(n log n + n log R)",
                  "O(nR)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log n + n log R)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "sort_plus_search": "O(n log n + n log R)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Both preprocessing and answer-space search contribute to total cost.",
              "details": "Ignoring the sort understates the one-time work; ignoring predicate scans understates the search."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "maximize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-021",
            "prompt": "A recursive answer-space binary search uses O(log W) recursion depth, and each predicate call allocates O(n) temporary space that is released before the next call returns. Select peak auxiliary space.",
            "constraints": [
              "One predicate evaluation is active in each recursive frame only during that frame's work.",
              "Predicate-local O(n) storage does not accumulate across completed sibling calls."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "peak_auxiliary_space"
              ],
              "availableValuesByDimension": {
                "peak_auxiliary_space": [
                  "O(1)",
                  "O(log W)",
                  "O(n)",
                  "O(n + log W)"
                ]
              },
              "acceptedValuesByDimension": {
                "peak_auxiliary_space": [
                  "O(n + log W)"
                ]
              },
              "normalizedAliasesByDimension": {
                "peak_auxiliary_space": {
                  "predicate_plus_stack": "O(n + log W)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Peak memory combines one active predicate workspace with the recursion stack.",
              "details": "An iterative outer search would remove the O(log W) stack term."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          },
          {
            "id": "alg-binary-search-answer-022",
            "prompt": "A feasibility predicate performs O(n log n) work, and the answer range contains W integer candidates. Select total binary-search time.",
            "constraints": [
              "The predicate is evaluated independently at each outer iteration."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(n log n)",
                  "O(log W)",
                  "O(n log n log W)",
                  "O(nW log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log n log W)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "predicate_times_iterations": "O(n log n log W)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Binary search does not make an expensive predicate constant-time.",
              "details": "The total complexity multiplies one evaluation cost by the logarithmic number of candidate levels."
            },
            "taxonomy": {
              "primarySkillAtomId": "search_feasible_answer_space",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "binary_search_on_answer",
              "problemArchetypeId": "minimize_feasible_answer"
            }
          }
        ],
