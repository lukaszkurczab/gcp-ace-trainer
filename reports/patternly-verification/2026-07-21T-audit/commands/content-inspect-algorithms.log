        "items": [
          {
            "id": "alg-arrays-normalization-comparison-001",
            "prompt": "Two ASCII strings should be compared case-insensitively while preserving every character position. Which normalization is appropriate before comparison?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "lowercase_both",
                  "text": "Convert both strings to the same case, then compare them position by position."
                },
                {
                  "id": "sort_characters",
                  "text": "Sort the characters in both strings before comparison."
                },
                {
                  "id": "deduplicate_characters",
                  "text": "Remove repeated characters from both strings before comparison."
                },
                {
                  "id": "normalize_one_side",
                  "text": "Convert only the first string to lowercase."
                }
              ],
              "acceptedOptionIds": [
                "lowercase_both"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The normalization must remove only the distinction declared irrelevant by the contract.",
              "details": "Case is irrelevant, but order, positions, and multiplicity remain meaningful. Converting both strings to one case preserves those properties while removing only case differences.",
              "wrongOptionExplanationsByOptionId": {
                "sort_characters": "Sorting destroys positional order, which the comparison still requires.",
                "deduplicate_characters": "Removing repeated characters changes multiplicity even though duplicates remain meaningful.",
                "normalize_one_side": "The same normalization must be applied symmetrically to both inputs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-002",
            "prompt": "A comparison ignores punctuation and letter case but preserves the order of letters and digits. Which pipeline matches the contract?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "filter_and_fold_case",
                  "text": "For each input, keep only letters and digits, convert letters to one case, then compare the resulting sequences."
                },
                {
                  "id": "sort_after_filter",
                  "text": "Remove punctuation, sort the remaining characters, then compare."
                },
                {
                  "id": "remove_duplicates",
                  "text": "Remove punctuation and repeated characters, then compare."
                },
                {
                  "id": "compare_raw_lengths",
                  "text": "Compare only the original string lengths."
                }
              ],
              "acceptedOptionIds": [
                "filter_and_fold_case"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Normalization should remove punctuation and case differences while preserving the remaining sequence.",
              "details": "Filtering and case folding produce a canonical sequence under the stated equivalence rule. Sorting would additionally make order irrelevant, which is not allowed.",
              "wrongOptionExplanationsByOptionId": {
                "sort_after_filter": "Sorting changes the order of meaningful characters.",
                "remove_duplicates": "Duplicate letters and digits remain part of the normalized sequence unless the contract says otherwise.",
                "compare_raw_lengths": "Ignored punctuation can change raw lengths without changing normalized equality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-003",
            "prompt": "A username comparison ignores leading and trailing spaces but preserves spaces inside the username. Which normalization is correct?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "trim_edges",
                  "text": "Remove whitespace only from the beginning and end of both inputs."
                },
                {
                  "id": "remove_all_spaces",
                  "text": "Remove every whitespace character from both inputs."
                },
                {
                  "id": "collapse_words",
                  "text": "Replace every run of whitespace with one space."
                },
                {
                  "id": "sort_characters",
                  "text": "Sort all non-space characters."
                }
              ],
              "acceptedOptionIds": [
                "trim_edges"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The normalization must match the exact whitespace rule in the contract.",
              "details": "Only surrounding whitespace is irrelevant. Internal spaces still distinguish usernames, so removing or collapsing them would merge inputs that should remain different.",
              "wrongOptionExplanationsByOptionId": {
                "remove_all_spaces": "This removes internal spaces that remain meaningful.",
                "collapse_words": "The contract does not authorize changing internal whitespace runs.",
                "sort_characters": "Sorting destroys the sequence order and is unrelated to trimming."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-004",
            "prompt": "A normalizer removes ignored separators but must preserve repeated meaningful symbols. What should it produce from [\"A\", \"-\", \"A\", \"-\", \"B\"] when only \"-\" is ignored?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "preserve_repeated_a",
                  "text": "[\"A\", \"A\", \"B\"]"
                },
                {
                  "id": "deduplicate_all",
                  "text": "[\"A\", \"B\"]"
                },
                {
                  "id": "keep_separators",
                  "text": "[\"A\", \"-\", \"A\", \"-\", \"B\"]"
                },
                {
                  "id": "sort_output",
                  "text": "[\"A\", \"A\", \"B\"], but only because normalization always sorts"
                }
              ],
              "acceptedOptionIds": [
                "preserve_repeated_a"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Removing ignored separators does not imply removing duplicate meaningful values.",
              "details": "Both occurrences of A remain because A is meaningful and multiplicity is preserved. Only the separator is discarded.",
              "wrongOptionExplanationsByOptionId": {
                "deduplicate_all": "This silently introduces a uniqueness rule that is not part of normalization.",
                "keep_separators": "The contract explicitly declares the separator irrelevant.",
                "sort_output": "The resulting order happens to match the input, but normalization does not automatically authorize sorting."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-005",
            "prompt": "Which properties should a deterministic canonical normalizer satisfy? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "same_rule_both_inputs",
                  "text": "Apply the same declared equivalence rules to every compared input."
                },
                {
                  "id": "idempotent_result",
                  "text": "Normalizing an already normalized sequence should not keep changing it."
                },
                {
                  "id": "preserve_meaningful_data",
                  "text": "Preserve order and multiplicity whenever the contract still treats them as meaningful."
                },
                {
                  "id": "remove_every_difference",
                  "text": "Remove every difference between the inputs until they compare equal."
                }
              ],
              "acceptedOptionIds": [
                "same_rule_both_inputs",
                "idempotent_result",
                "preserve_meaningful_data"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Canonical normalization is symmetric, stable, and limited to distinctions declared irrelevant.",
              "details": "A valid normalizer maps equivalent inputs to the same representation without erasing meaningful differences. Idempotence prevents the representation from drifting under repeated application.",
              "wrongOptionExplanationsByOptionId": {
                "remove_every_difference": "Normalization must not force unequal inputs to become equal by deleting meaningful distinctions."
              },
              "omittedCorrectExplanationsByOptionId": {
                "same_rule_both_inputs": "Asymmetric normalization can make equality depend on argument order.",
                "idempotent_result": "A canonical representation should already satisfy its own normalization rules.",
                "preserve_meaningful_data": "Information outside the ignored equivalence dimensions must remain intact."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-006",
            "prompt": "Two product codes should be compared ignoring hyphens and ASCII letter case, but digit order remains significant. Are \"ab-12\" and \"A-B21\" equal under this rule?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "not_equal_order_differs",
                  "text": "No. They normalize to \"AB12\" and \"AB21\", which differ in digit order."
                },
                {
                  "id": "equal_same_characters",
                  "text": "Yes. They contain the same letters and digits."
                },
                {
                  "id": "equal_after_sorting",
                  "text": "Yes. Sorting the normalized characters makes them equal."
                },
                {
                  "id": "not_equal_hyphen_positions",
                  "text": "No. The hyphens appear in different positions."
                }
              ],
              "acceptedOptionIds": [
                "not_equal_order_differs"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Only hyphens and case are ignored; the order of retained characters still defines equality.",
              "details": "After filtering and case folding, the digit sequences are 12 and 21. Sorting would add an unstated order-insensitive rule.",
              "wrongOptionExplanationsByOptionId": {
                "equal_same_characters": "Having the same multiset of characters is insufficient when order remains meaningful.",
                "equal_after_sorting": "Sorting changes the contract by discarding positional order.",
                "not_equal_hyphen_positions": "Hyphens are explicitly ignored, so their positions do not affect equality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-007",
            "prompt": "Arrange the steps for comparing two sequences under a shared normalization contract.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_equivalence_rule",
                  "text": "State exactly which differences are irrelevant and which remain meaningful."
                },
                {
                  "id": "normalize_both",
                  "text": "Apply the same normalization to both sequences."
                },
                {
                  "id": "compare_canonical_forms",
                  "text": "Compare the resulting canonical sequences."
                },
                {
                  "id": "test_boundaries",
                  "text": "Test empty, all-ignored, repeated, and already-normalized inputs."
                }
              ],
              "canonicalOrder": [
                "state_equivalence_rule",
                "normalize_both",
                "compare_canonical_forms",
                "test_boundaries"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The equivalence relation determines the legal normalizer, and the normalized outputs determine equality.",
              "details": "Starting with implementation before defining ignored distinctions risks deleting meaningful information. Boundary tests then verify that the chosen normalizer is stable and complete."
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-009",
            "prompt": "A sequence is normalized in place by removing ignored values and returning a logical length k. Which statement is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "valid_prefix_contract",
                  "text": "The normalized result is the prefix [0, k); the suffix may remain outside the logical contract."
                },
                {
                  "id": "suffix_must_be_zeroed",
                  "text": "Every position after k must be cleared for the result to be valid."
                },
                {
                  "id": "physical_length_required",
                  "text": "The physical container length must always shrink to k."
                },
                {
                  "id": "duplicates_removed_automatically",
                  "text": "Any repeated retained values must also be removed."
                }
              ],
              "acceptedOptionIds": [
                "valid_prefix_contract"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "In-place compaction commonly defines a logical result prefix rather than a rewritten suffix.",
              "details": "The returned k identifies the valid normalized sequence. Clearing or resizing the remainder is unnecessary unless explicitly required. Repeated meaningful values remain repeated.",
              "wrongOptionExplanationsByOptionId": {
                "suffix_must_be_zeroed": "The suffix is outside the logical result unless the specification says otherwise.",
                "physical_length_required": "Logical length and physical storage length are separate concepts.",
                "duplicates_removed_automatically": "Filtering ignored values does not introduce an unstated deduplication rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-010",
            "prompt": "A comparison ignores character order but requires exact multiplicity. Which normalized representation is sufficient for lowercase ASCII strings?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "frequency_vector",
                  "text": "A 26-entry frequency vector for each string."
                },
                {
                  "id": "seen_set",
                  "text": "A set of characters present in each string."
                },
                {
                  "id": "sorted_unique_characters",
                  "text": "The distinct characters in sorted order."
                },
                {
                  "id": "first_character",
                  "text": "Only the first character of each string."
                }
              ],
              "acceptedOptionIds": [
                "frequency_vector"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "When order is irrelevant but multiplicity matters, counts form the canonical representation.",
              "details": "Equal frequency vectors mean every character occurs the same number of times. A set or unique-character sequence loses multiplicity.",
              "wrongOptionExplanationsByOptionId": {
                "seen_set": "Presence cannot distinguish one occurrence from several.",
                "sorted_unique_characters": "Removing duplicate occurrences loses required count information.",
                "first_character": "One position cannot summarize the full character multiset."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "frequency_table",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-011",
            "prompt": "Which cases should be included when reviewing a filter-and-compare normalizer? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "all_ignored",
                  "text": "Inputs whose characters are all ignored by the normalization rule."
                },
                {
                  "id": "already_normalized",
                  "text": "Inputs already in canonical form."
                },
                {
                  "id": "repeated_meaningful",
                  "text": "Inputs containing repeated meaningful values."
                },
                {
                  "id": "only_happy_path",
                  "text": "Only two ordinary inputs that already compare equal."
                }
              ],
              "acceptedOptionIds": [
                "all_ignored",
                "already_normalized",
                "repeated_meaningful"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary tests should verify empty canonical output, idempotence, and preservation of meaningful multiplicity.",
              "details": "All-ignored inputs test empty results. Already-normalized inputs test stability. Repeated meaningful values catch accidental deduplication.",
              "wrongOptionExplanationsByOptionId": {
                "only_happy_path": "A single ordinary equal case does not exercise the failure boundaries of normalization."
              },
              "omittedCorrectExplanationsByOptionId": {
                "all_ignored": "The normalizer must handle a canonical result of length zero.",
                "already_normalized": "Canonical input should remain unchanged under repeated normalization.",
                "repeated_meaningful": "The normalizer must not delete multiplicity that remains part of the contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-012",
            "prompt": "A developer lowercases the first input but leaves the second unchanged before a case-insensitive comparison. What is the defect?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "asymmetric_normalization",
                  "text": "The normalization is asymmetric, so equivalent inputs can compare differently depending on argument order."
                },
                {
                  "id": "lowercase_always_invalid",
                  "text": "Lowercasing is never a valid normalization."
                },
                {
                  "id": "comparison_requires_sorting",
                  "text": "Every normalized comparison must sort both inputs."
                },
                {
                  "id": "duplicate_counts_missing",
                  "text": "The only defect is that duplicate counts were not computed."
                }
              ],
              "acceptedOptionIds": [
                "asymmetric_normalization"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Both sides of an equivalence comparison must be mapped through the same canonicalization rule.",
              "details": "For example, lowercase(\"A\") equals \"a\", but lowercase(\"a\") compared with raw \"A\" fails. The outcome should not depend on which input is placed first.",
              "wrongOptionExplanationsByOptionId": {
                "lowercase_always_invalid": "Lowercasing is valid when ASCII case is explicitly irrelevant.",
                "comparison_requires_sorting": "Sorting is needed only when order is also irrelevant.",
                "duplicate_counts_missing": "Count state is unrelated to the asymmetry defect in this case."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-014",
            "prompt": "A normalizer removes every zero from an integer sequence before comparison. Why might this be incorrect?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero_may_be_meaningful",
                  "text": "Zero may be a meaningful value unless the comparison contract explicitly declares it ignorable."
                },
                {
                  "id": "zeros_cannot_be_scanned",
                  "text": "A linear scan cannot process zero values."
                },
                {
                  "id": "normalization_requires_duplicates",
                  "text": "Normalization is valid only when the input contains duplicates."
                },
                {
                  "id": "zero_removal_always_quadratic",
                  "text": "Removing zeros always takes O(n²) time."
                }
              ],
              "acceptedOptionIds": [
                "zero_may_be_meaningful"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Normalization rules come from semantic equivalence, not from values that appear convenient to discard.",
              "details": "If zero contributes to the sequence meaning, removing it merges distinct inputs. A value may be ignored only when the contract explicitly defines that difference as irrelevant.",
              "wrongOptionExplanationsByOptionId": {
                "zeros_cannot_be_scanned": "Zero is processed like any other integer value.",
                "normalization_requires_duplicates": "Duplicate presence is unrelated to whether a value is ignorable.",
                "zero_removal_always_quadratic": "Stable filtering can be performed in one linear scan."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "scan_indexed_sequence"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-015",
            "prompt": "Two normalized sequences are compared position by position after each input was scanned once. If their lengths are n and m before normalization, which time bound is precise?",
            "constraints": [
              "Each input is normalized in one pass.",
              "Comparing canonical outputs is linear in their retained lengths."
            ],
            "difficulty": "easy",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(min(n, m))",
                  "O(n + m)",
                  "O(nm)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n + m)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "linear_in_both_inputs": "O(n + m)"
                }
              },
              "maxPoints": 1
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 1
            },
            "feedback": {
              "reason": "Each original input may need to be fully examined before canonical equality is known.",
              "details": "The two normalization passes cost O(n) and O(m). Comparing outputs costs at most O(n + m) in total, so the combined bound remains O(n + m)."
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-016",
            "prompt": "A comparison requires original order after ignored characters are removed. Why is sorting the normalized outputs unsafe?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sorting_erases_order",
                  "text": "Sorting can make different meaningful sequences appear equal by erasing their relative order."
                },
                {
                  "id": "sorting_cannot_handle_strings",
                  "text": "Sorting cannot be applied to sequence elements."
                },
                {
                  "id": "sorting_removes_duplicates",
                  "text": "Sorting always removes repeated values."
                },
                {
                  "id": "sorting_requires_constant_space",
                  "text": "Sorting is unsafe because it always uses O(1) space."
                }
              ],
              "acceptedOptionIds": [
                "sorting_erases_order"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A canonicalization step may not discard order when order remains part of equality.",
              "details": "For example, AB and BA become the same sorted sequence even though their normalized orders differ. Sorting is legal only when order is explicitly irrelevant.",
              "wrongOptionExplanationsByOptionId": {
                "sorting_cannot_handle_strings": "Sequences can be sorted; the issue is semantic legality, not technical possibility.",
                "sorting_removes_duplicates": "Sorting rearranges elements but does not itself deduplicate them.",
                "sorting_requires_constant_space": "Space usage is not the contract violation described here."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-017",
            "prompt": "A whitespace normalizer collapses every run of spaces to one space. For which contract is this normalization legal?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "run_length_irrelevant",
                  "text": "When the number of consecutive spaces is irrelevant but word separation remains meaningful."
                },
                {
                  "id": "all_spaces_meaningful",
                  "text": "When every original space position and count must be preserved."
                },
                {
                  "id": "spaces_removed_entirely",
                  "text": "When spaces must be removed rather than retained as separators."
                },
                {
                  "id": "order_irrelevant",
                  "text": "Whenever character order is irrelevant."
                }
              ],
              "acceptedOptionIds": [
                "run_length_irrelevant"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Collapsing runs preserves separation while discarding only whitespace multiplicity.",
              "details": "It is correct only when one or many consecutive spaces represent the same boundary. Other contracts may require exact spaces or no spaces at all.",
              "wrongOptionExplanationsByOptionId": {
                "all_spaces_meaningful": "Collapsing would destroy required whitespace positions and multiplicities.",
                "spaces_removed_entirely": "Keeping one separator does not satisfy a contract that removes spaces entirely.",
                "order_irrelevant": "Order relevance does not determine how whitespace runs should be normalized."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          },
          {
            "id": "alg-arrays-normalization-comparison-018",
            "prompt": "A record comparison ignores the case of ASCII letters in a name field but treats digits, punctuation, order, and duplicate characters as meaningful. Which implementation best matches the contract?",
            "difficulty": "easy",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "case_fold_only",
                  "text": "Convert letters in both names to one case and compare the complete resulting sequences."
                },
                {
                  "id": "remove_punctuation",
                  "text": "Convert case, remove punctuation, and compare."
                },
                {
                  "id": "sort_and_deduplicate",
                  "text": "Convert case, sort characters, remove duplicates, and compare."
                },
                {
                  "id": "compare_distinct_sets",
                  "text": "Compare only the sets of distinct characters."
                }
              ],
              "acceptedOptionIds": [
                "case_fold_only"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The implementation should normalize case and preserve every other declared distinction.",
              "details": "Digits, punctuation, sequence order, and multiplicity remain meaningful. Removing, sorting, or deduplicating them would broaden the equivalence relation beyond the specification.",
              "wrongOptionExplanationsByOptionId": {
                "remove_punctuation": "Punctuation remains meaningful under this contract.",
                "sort_and_deduplicate": "Sorting and deduplication erase order and multiplicity that must be preserved.",
                "compare_distinct_sets": "A set loses both order and repeated occurrences."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "apply_sequence_normalization",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "linear_scan",
              "problemArchetypeId": "normalize_and_compare_sequences"
            }
          }
        ],
