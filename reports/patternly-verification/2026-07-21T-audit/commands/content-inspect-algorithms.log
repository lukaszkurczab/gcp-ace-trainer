      {
        "id": "ssc-extract-online-arrival",
        "prompt": "Readings arrive one at a time, cannot be replayed, and the program must emit whether a duplicate has appeared after each arrival. Which signal must be extracted before proposing a strategy?",
        "constraints": [
          "Readings arrive incrementally.",
          "Past input cannot be replayed.",
          "An answer is required after every arrival."
        ],
        "difficulty": "intermediate",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "online_incremental",
              "text": "The task is online: state must support incremental updates and answers without revisiting future data."
            },
            {
              "id": "fixed_window",
              "text": "One-at-a-time arrival implies a fixed-size sliding window."
            },
            {
              "id": "eventual_sort",
              "text": "The readings are numeric, so they can always be sorted after all input arrives."
            }
          ],
          "acceptedOptionIds": [
            "online_incremental"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "The input and output are online. A legal strategy must update retained state and answer each prefix before future readings are known.",
          "details": "Offline preprocessing assumes the complete dataset is available before answers are required. That assumption fails here: every prefix has an observable answer, and the stream cannot be replayed. A retained membership structure is a plausible later candidate because it supports incremental queries, while sorting only after the stream ends misses the required answer times. Streaming does not imply a window unless old data expires under an explicit horizon. The transfer rule is to extract when data becomes available and when answers are due; those timing contracts can rule out otherwise efficient offline strategies.",
          "wrongOptionExplanationsByOptionId": {
            "eventual_sort": "Sorting after the final reading may answer one offline duplicate query, but it cannot produce the required answer after each arrival. It becomes legal only when all answers are deferred until the complete input is available.",
            "fixed_window": "Streaming and windowing are different constraints. A fixed window becomes relevant only when the contract limits the answer to the most recent k readings or explicitly expires old state."
          }
        },
