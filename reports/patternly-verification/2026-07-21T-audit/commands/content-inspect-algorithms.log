      {
        "id": "alg-contrast-hash-sort-memory-014",
        "prompt": "Which conditions can make hashing's auxiliary memory smaller than a naive O(n) estimate? Select all that apply.",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "multiple",
          "options": [
            {
              "id": "few_distinct",
              "text": "Only k much smaller than n distinct keys are retained."
            },
            {
              "id": "early_exit",
              "text": "The algorithm stops after finding an early duplicate and releases state."
            },
            {
              "id": "bounded_domain_compact",
              "text": "A compact bounded-domain table or bitset replaces general entries when the contract permits it."
            },
            {
              "id": "all_distinct",
              "text": "Every input value is distinct."
            }
          ],
          "acceptedOptionIds": [
            "few_distinct",
            "early_exit",
            "bounded_domain_compact"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "Space analysis should use the actual retained state and execution contract.",
          "details": "Worst-case all-distinct input still gives O(n) general hash storage.",
          "wrongOptionExplanationsByOptionId": {
