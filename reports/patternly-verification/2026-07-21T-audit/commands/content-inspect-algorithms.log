      {
        "id": "ssc-transfer-next-taller-building",
        "prompt": "For each building in a street, return the first building to its right that is taller. Which prior mechanism transfers despite the new surface?",
        "constraints": [
          "Return the first taller building to the right.",
          "Original street order must be preserved.",
          "Each building needs at most one witness."
        ],
        "difficulty": "intermediate",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "sort_heights",
              "text": "Sort buildings by height, then use adjacent taller values to determine the first greater building for every original street position."
            },
            {
              "id": "monotonic_frontier",
              "text": "Maintain a decreasing stack of unresolved building indices; a taller building resolves and pops shorter indices."
            },
            {
              "id": "ordinary_history",
              "text": "Push every building onto an ordinary stack and never remove anything until the end."
            }
          ],
          "acceptedOptionIds": [
            "monotonic_frontier"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "The task is a next-greater relation. A monotonic stack keeps exactly the unresolved frontier and discards entries when their first valid witness appears.",
          "details": "Street position supplies the left-to-right processing order, while height supplies the comparison. Indices on the stack have not yet seen a taller building; when a new height exceeds the top, that new index is the first valid witness because all intermediate buildings have already been processed. Popped indices are resolved permanently, giving amortized O(n) work. An ordinary unpruned stack does not encode the dominance relation, and sorting loses 'first to the right.' The transfer boundary is nearest/first witness semantics; asking for every taller building would require more output and invalidate permanent discard.",
          "wrongOptionExplanationsByOptionId": {
            "ordinary_history": "Retaining history without a monotonic invariant provides no efficient resolution rule. It becomes useful only if another mechanism searches that history or if LIFO order is itself the output contract.",
            "sort_heights": "Height order does not preserve street order or nearest-right identity. Sorting becomes relevant for global rank questions rather than directional nearest witnesses."
          }
