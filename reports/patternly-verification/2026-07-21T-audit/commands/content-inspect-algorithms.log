        "items": [
          {
            "id": "algorithms-intervals-sweep-001",
            "prompt": "How should a half-open interval [s, e) be represented for a basic active-count sweep?",
            "constraints": [
              "The sweep accumulates demand from left to right.",
              "Each interval has unit demand."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "plus_start_minus_end",
                  "text": "Create +1 at s and -1 at e."
                },
                {
                  "id": "minus_start_plus_end",
                  "text": "Create -1 at s and +1 at e."
                },
                {
                  "id": "plus_both",
                  "text": "Create +1 at both s and e."
                }
              ],
              "acceptedOptionIds": [
                "plus_start_minus_end"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A start introduces one active interval and an end removes it, so the event deltas are +1 and -1 respectively.",
              "details": "The sweep is a discrete derivative of the active-count function. Before s, the interval contributes zero; at s it becomes active, so add one; at e it stops contributing under [s, e), so subtract one. Prefix-summing all ordered event deltas reconstructs the number of active intervals between event coordinates. Weighted intervals replace one with the demand weight, but the signs remain the same. The endpoint contract still controls equal-coordinate ordering and whether the end transition occurs before or after starts at the same point.",
              "wrongOptionExplanationsByOptionId": {
                "minus_start_plus_end": "This reverses acquisition and release, producing negative active counts before intervals begin.",
                "plus_both": "The end must remove the interval's contribution. Adding at both endpoints makes active demand grow permanently."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "process_interval_events_in_order",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sweep_line_intro",
              "problemArchetypeId": "count_concurrent_intervals"
            }
          },
          {
            "id": "algorithms-intervals-sweep-002",
            "prompt": "Order the core steps of a static sweep that computes maximum interval concurrency.",
            "constraints": [
              "The endpoint contract supplies a deterministic same-coordinate tie rule."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "emit_events",
                  "text": "Emit the required start and end events from every interval."
                },
                {
                  "id": "sort_events",
                  "text": "Sort events by coordinate and the declared tie key."
                },
                {
                  "id": "accumulate_state",
                  "text": "Process events in order and update the active count."
                },
                {
                  "id": "update_answer",
                  "text": "Update the maximum from the semantically valid active states."
                }
              ],
              "canonicalOrder": [
                "emit_events",
                "sort_events",
                "accumulate_state",
                "update_answer"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The prefix state has meaning only after events are created and fully ordered; the answer is then derived from that state.",
              "details": "Event creation defines what changes at each endpoint. Sorting establishes chronological order, including what happens when several changes share a coordinate. Accumulation reconstructs the active-count prefix. The answer update reads that state after the transition points permitted by the contract. Reversing sort and accumulation combines unrelated times, while updating the maximum before state changes can miss a peak. Some implementations update the maximum inside the accumulation loop; the essential dependency is that each observed state follows its correctly ordered event transition."
            },
            "taxonomy": {
              "primarySkillAtomId": "process_interval_events_in_order",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sweep_line_intro",
              "problemArchetypeId": "count_concurrent_intervals"
            }
          },
          {
            "id": "algorithms-intervals-sweep-003",
            "prompt": "For half-open intervals, an end event and a start event share coordinate t. The sweep inspects active count after each event. Which tie rule is correct?",
            "constraints": [
              "Ending intervals are inactive at t.",
              "Starting intervals are active at t."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "end_before_start",
                  "text": "Process end events before start events."
                },
                {
                  "id": "start_before_end",
                  "text": "Process start events before end events."
                },
                {
                  "id": "arbitrary",
                  "text": "Use any order because the net delta is the same."
                }
              ],
              "acceptedOptionIds": [
                "end_before_start"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Release precedes acquisition at a half-open boundary, so an ending interval leaves active state before a new one enters.",
              "details": "Equal-coordinate ordering is part of the sweep contract whenever intermediate states matter. With active = 1 before t, processing start first yields 2 and may record a false overlap; processing end first yields 0 then 1, matching legal reuse. The net delta after both events is zero, which is why an implementation that only examines final grouped state can appear correct on some outputs. It must nevertheless prove that no lost intermediate state affects the requested result. Closed intervals require the opposite tie because both intervals include t.",
              "wrongOptionExplanationsByOptionId": {
                "start_before_end": "That temporarily counts the ending interval at a point it excludes and can create a false peak.",
                "arbitrary": "The final count after both events is the same, but intermediate counts—and therefore the maximum or conflict result—can differ."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "process_interval_events_in_order",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sweep_line_intro",
              "problemArchetypeId": "detect_schedule_conflict"
            }
          },
          {
            "id": "algorithms-intervals-sweep-004",
            "prompt": "For closed intervals, both an ending interval and a starting interval contain coordinate t. The sweep must capture a one-point peak. Which tie rule is required?",
            "constraints": [
              "The active count is measured at t.",
              "A one-point overlap is material."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "start_before_end",
                  "text": "Process starts before ends at t."
                },
                {
                  "id": "end_before_start",
                  "text": "Process ends before starts at t."
                },
                {
                  "id": "net_delta_only",
                  "text": "Apply only the combined net delta at t."
                }
              ],
              "acceptedOptionIds": [
                "start_before_end"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The new interval becomes active at t while the ending interval is still active there, so the peak is observed before release.",
              "details": "Closed endpoint semantics change event order, not merely the comparison syntax. If one interval ends at t and another begins at t, both sets contain t. Applying the start increment first exposes the concurrent state; applying the end first erases it. Grouping to a net zero delta also erases the peak. This matters for point-sensitive capacity or geometric intersection. If the application intentionally ignores measure-zero intersections, it must declare that alternate policy rather than silently using the half-open tie.",
              "wrongOptionExplanationsByOptionId": {
                "end_before_start": "That removes the ending interval before measuring the shared point and undercounts inclusive occupancy.",
                "net_delta_only": "A +1 and -1 may cancel even though both intervals are simultaneously active at the included point."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "process_interval_events_in_order",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "sweep_line_intro",
