              "availableValuesByDimension": {
                "preprocessing_time": [
                  "O(R + C)",
                  "O(RC)",
                  "O(RC log(RC))",
                  "O(R^2 C^2)"
                ],
                "query_time": [
                  "O(1)",
                  "O(log R + log C)",
                  "O(R + C)",
                  "O(RC)"
                ],
                "extra_space": [
                  "O(1)",
                  "O(R + C)",
                  "O(RC)",
                  "O(R^2 C^2)"
                ]
              },
              "acceptedValuesByDimension": {
                "preprocessing_time": [
                  "O(RC)"
                ],
                "query_time": [
                  "O(1)"
                ],
                "extra_space": [
                  "O(RC)"
                ]
              },
              "normalizedAliasesByDimension": {},
              "maxPoints": 3
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Every cell contributes to one prefix entry, each query uses four states, and the padded table stores one state per row-column boundary pair.",
              "details": "The (R + 1) × (C + 1) table is built in O(RC) time and occupies O(RC) extra space. Inclusion-exclusion performs a fixed number of reads and arithmetic operations, so each query is O(1). The constant query time is purchased with a full 2D auxiliary structure; it is not a zero-space prefix method."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_matrix_region_from_prefixes",
