                ],
                "prefix_time": [
                  "O(n + q)",
                  "O(qn)",
                  "O(n log n)",
                  "O(q log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "direct_time": [
                  "O(qn)"
                ],
                "prefix_time": [
