        "items": [
          {
            "id": "alg-gt-msbfs-001",
            "prompt": "Order the initialization steps for computing each vertex's minimum unweighted distance to any vertex in a known source set S.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "initialize_distance",
                  "text": "Initialize every distance to infinity or unseen."
                },
                {
                  "id": "seed_sources",
                  "text": "For every distinct source s in S, set distance[s] = 0 and mark it discovered."
                },
                {
                  "id": "enqueue_sources",
                  "text": "Enqueue all distinct sources before processing any non-source vertex."
                },
                {
                  "id": "run_bfs",
                  "text": "Run the ordinary BFS relaxation from the shared queue."
                }
              ],
              "canonicalOrder": [
                "initialize_distance",
                "seed_sources",
                "enqueue_sources",
                "run_bfs"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "All sources must occupy the same distance-zero frontier before expansion begins.",
              "details": "The queue initially represents layer zero as the entire source set. A non-source vertex is then first discovered from the closest expanding wave, giving its minimum distance to any source. Processing one source to completion before adding another would bias the result toward source order. Deduplicate repeated source IDs so each logical source is seeded once."
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_multi_source_frontier",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "multi_source_bfs",
              "problemArchetypeId": "propagate_from_multiple_sources"
            }
          },
          {
            "id": "alg-gt-msbfs-002",
            "prompt": "An unweighted road graph has 40 fire stations and millions of intersections. The task needs the distance from every intersection to its nearest station. Which approach matches the output contract?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_multi_source",
                  "text": "Run one BFS seeded with all 40 stations at distance zero."
                },
                {
                  "id": "forty_bfs",
                  "text": "Run a complete BFS from each station and take the minimum afterward."
                },
                {
                  "id": "one_arbitrary",
                  "text": "Run BFS from one arbitrary station because BFS is always fastest."
                },
                {
                  "id": "dfs_nearest",
                  "text": "Run DFS from all stations; depth order automatically gives nearest distance."
                }
              ],
              "acceptedOptionIds": [
                "one_multi_source"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Simultaneous distance-zero sources let one breadth expansion compute the lower envelope of all source distances.",
              "details": "Multi-source BFS is equivalent to allowing every station to begin at time zero. Each intersection is first reached by a shortest unit-edge path from whichever station's wave arrives first. The graph is processed once in O(V + E) with adjacency lists, rather than once per station. The pattern applies only because all traversed edges have equal cost.",
              "wrongOptionExplanationsByOptionId": {
                "forty_bfs": "This is correct but repeats graph traversal 40 times; simultaneous sources compute the same minimum-distance envelope in one traversal.",
                "one_arbitrary": "One source computes distance to that station, not to the nearest station in the full set.",
                "dfs_nearest": "DFS does not process unit-cost paths in nondecreasing length and cannot assign nearest distances by first discovery."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_multi_source_frontier",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "multi_source_bfs",
              "problemArchetypeId": "propagate_from_multiple_sources"
            }
          },
          {
            "id": "alg-gt-msbfs-003",
            "prompt": "The supplied source list is [2, 2, 5]. What is the correct canonical initialization for multi-source BFS?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "deduplicate",
                  "text": "Seed vertices 2 and 5 once each at distance zero and enqueue each once."
                },
                {
                  "id": "enqueue_duplicate",
                  "text": "Enqueue vertex 2 twice so its wave has twice the priority of vertex 5."
                },
                {
                  "id": "distance_two",
                  "text": "Set distance[2] = 2 because source 2 appears twice."
                },
                {
                  "id": "dequeue_mark",
                  "text": "Leave both copies unseen until dequeue; late marking is always equivalent."
                }
              ],
              "acceptedOptionIds": [
                "deduplicate"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The source set is semantic; duplicate input entries do not create distinct graph origins.",
              "details": "Initialize based on distinct source identities. Every source has distance zero and should be published to the frontier once. Duplicate queue entries do not produce a better distance and may inflate memory or repeated checks. A source with a different state identity, such as the same location under a different resource mask, would not be a duplicate; identity follows the search-state contract.",
              "wrongOptionExplanationsByOptionId": {
                "enqueue_duplicate": "BFS priority is determined by distance layers, not multiplicity; duplicate sources add redundant frontier entries.",
                "distance_two": "Source multiplicity does not change the zero distance from a source to itself.",
                "dequeue_mark": "That intentionally admits duplicate scheduling and weakens the one-discovery invariant without changing the mathematical source set."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_multi_source_frontier",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "multi_source_bfs",
              "problemArchetypeId": "propagate_from_multiple_sources"
            }
          },
          {
            "id": "alg-gt-msbfs-004",
            "prompt": "A contamination process starts simultaneously at several cells and spreads one orthogonal step per minute through open cells. What value gives the time until every reachable open cell is contaminated?",
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "max_finite_distance",
                  "text": "The maximum finite distance assigned by multi-source BFS, provided no required open cell remains unreachable."
                },
                {
                  "id": "source_count",
                  "text": "The number of initial sources, because each source contributes one minute."
                },
                {
                  "id": "queue_size",
                  "text": "The largest queue size observed during BFS."
                },
                {
                  "id": "dfs_depth",
                  "text": "The maximum recursive DFS depth from any one source."
                }
              ],
              "acceptedOptionIds": [
                "max_finite_distance"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "BFS distance is arrival time under unit-time moves, and completion occurs at the last reachable required state.",
              "details": "Seed all contaminated cells at minute zero. Each BFS layer advances one minute, so a cell's distance is its earliest contamination time. The overall completion time is the maximum of those distances. Before returning it, check whether any required cell stayed unseen; if so, complete contamination is impossible rather than merely slower.",
              "wrongOptionExplanationsByOptionId": {
                "source_count": "Source count changes how waves cover the grid but is not the propagation depth.",
                "queue_size": "Queue width measures frontier memory pressure, not the number of elapsed propagation layers.",
                "dfs_depth": "DFS depth depends on exploration order and does not represent simultaneous minimum arrival time."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "initialize_multi_source_frontier",
