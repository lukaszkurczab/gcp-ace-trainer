            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "auxiliary_space",
                "output_space"
              ],
              "availableValuesByDimension": {
                "auxiliary_space": [
                  "O(1)",
                  "O(n)",
                  "O(n²)",
                  "O(2^n)"
                ],
                "output_space": [
                  "O(1)",
                  "O(n)",
                  "O(n²)",
                  "O(2^n)"
                ]
              },
              "acceptedValuesByDimension": {
                "auxiliary_space": [
                  "O(n²)"
                ],
                "output_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "auxiliary_space": {
                  "table": "O(n²)"
                },
                "output_space": {
                  "scalar": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The table is temporary working storage, while the result is constant-size.",
              "details": "The roles, not the data contents, determine classification."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
