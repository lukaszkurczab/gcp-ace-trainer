          {
            "id": "alg-hms-review-stale-zero-key",
            "prompt": "A mutable frequency map decrements counts but keeps keys whose count reaches zero. Later code tests only key membership and treats the value as present. What is the defect?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "membership_invariant_broken",
                  "text": "Key presence no longer means positive frequency; zero keys must be removed or membership checks must inspect the count."
                },
                {
                  "id": "decrement_too_slow",
                  "text": "Hash-map decrement is asymptotically too slow."
                },
                {
                  "id": "need_index_payload",
                  "text": "Every count entry must also store an original index."
                }
              ],
              "acceptedOptionIds": [
                "membership_invariant_broken"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The implementation mixes two conventions: absence-as-zero and retained zero entries, then interprets membership as positive count.",
              "details": "Either convention can work if applied consistently. Canonical sparse frequency state usually deletes a key at zero so contains(key) is equivalent to count(key) > 0. If zero entries are retained, every later condition must read the numeric payload. The mismatch is not fixed by changing container type.",
              "wrongOptionExplanationsByOptionId": {
                "decrement_too_slow": "The observed incorrect result comes from state semantics, not from the expected cost of the update.",
                "need_index_payload": "No provenance requirement is stated; adding indices would not repair the zero-versus-present confusion."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_hash_state_mismatch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "frequency_map",
              "problemArchetypeId": "group_or_count_values"
            },
            "difficulty": "advanced"
          },
          {
            "id": "alg-hms-review-select-all-composite-repairs",
            "prompt": "A pair-index implementation inserts current value to current index, then checks the complement, and overwrites earlier duplicate indices. It must return the first pair found by a left-to-right scan, using the earliest prior index for each value. Select all required repairs.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "check_before_insert",
                  "text": "Query the complement before recording the current occurrence."
                },
                {
                  "id": "preserve_earliest",
                  "text": "Store an index only when the value is absent, preserving the earliest index."
                },
                {
                  "id": "replace_with_set",
                  "text": "Replace the map with a set of values."
                },
                {
                  "id": "claim_worst_constant",
                  "text": "Document every lookup as guaranteed worst-case O(1)."
                }
              ],
              "acceptedOptionIds": [
                "check_before_insert",
                "preserve_earliest"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Two independent invariants are broken: prior-state distinctness and earliest-index payload preservation.",
              "details": "A complete diagnosis separates temporal and payload defects. Querying before insertion ensures any match comes from an earlier index. First-write-wins preserves the earliest origin under each value. Both repairs are needed; a set removes required provenance, and a complexity statement cannot compensate for incorrect state semantics.",
              "wrongOptionExplanationsByOptionId": {
                "replace_with_set": "A set would discard the earlier index required by the output and cannot enforce earliest provenance.",
                "claim_worst_constant": "Changing the complexity claim does not repair either the self-match or overwrite defect, and the guarantee is unjustified."
              },
              "omittedCorrectExplanationsByOptionId": {
                "check_before_insert": "Omitting check_before_insert leaves the current occurrence eligible to satisfy its own complement lookup.",
                "preserve_earliest": "Omitting preserve_earliest allows later duplicates to replace the provenance required by the earliest-pair contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_hash_state_mismatch",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "complement_lookup",
              "problemArchetypeId": "preserve_original_index"
            },
            "difficulty": "advanced",
            "constraints": [
              "A valid pair must use two distinct indices.",
              "Among pairs with the same later index, the smaller earlier index is preferred."
            ]
          }
