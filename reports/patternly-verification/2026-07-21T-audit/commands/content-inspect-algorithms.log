        "items": [
          {
            "id": "alg-complexity-space-001",
            "prompt": "Which memory is counted as auxiliary space?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "working_memory",
                  "text": "Additional working storage used to compute the result, excluding pre-existing input and separately reported output."
                },
                {
                  "id": "input_always",
                  "text": "Every byte occupied by the input."
                },
                {
                  "id": "output_always_aux",
                  "text": "Every required returned value."
                },
                {
                  "id": "code_size",
                  "text": "The source-code text length."
                }
              ],
              "acceptedOptionIds": [
                "working_memory"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Auxiliary space describes extra working state created for computation.",
              "details": "Input, output, and auxiliary storage should be classified by role.",
              "wrongOptionExplanationsByOptionId": {
                "input_always": "Input storage is normally reported separately.",
                "output_always_aux": "Required result storage is output space.",
                "code_size": "Algorithmic space analysis concerns runtime storage."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-002",
            "prompt": "A function creates many temporary arrays one after another, but frees each before creating the next. What determines peak auxiliary space?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "maximum_concurrent",
                  "text": "The largest amount simultaneously alive, not the sum of all allocations over time."
                },
                {
                  "id": "sum_all_allocations",
                  "text": "The total number of bytes ever allocated."
                },
                {
                  "id": "last_only",
                  "text": "Only the final allocation."
                },
                {
                  "id": "variable_count",
                  "text": "Only the number of variable names."
                }
              ],
              "acceptedOptionIds": [
                "maximum_concurrent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Space complexity is a peak-concurrency measure.",
              "details": "Sequential reuse can keep peak memory low even when cumulative allocation volume is large.",
              "wrongOptionExplanationsByOptionId": {
                "sum_all_allocations": "Space complexity measures peak live memory.",
                "last_only": "An earlier allocation may have been larger.",
                "variable_count": "Containers can differ greatly in size."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-space-003",
            "prompt": "An iterative algorithm uses ten scalar variables regardless of n. What is its auxiliary space?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "constant",
                  "text": "O(1)."
                },
                {
                  "id": "linear",
                  "text": "O(n) because the variables process n inputs."
                },
                {
                  "id": "ten_n",
                  "text": "O(10n)."
                },
                {
                  "id": "unknown",
                  "text": "Impossible to classify without their names."
                }
              ],
              "acceptedOptionIds": [
                "constant"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A fixed number of fixed-size values does not scale with input size.",
              "details": "The time spent updating them is separate from storage size.",
              "wrongOptionExplanationsByOptionId": {
                "linear": "Storage count does not grow with n.",
                "ten_n": "The variables are not duplicated per input.",
                "unknown": "A fixed number of fixed-size scalars is sufficient information."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-004",
            "prompt": "A recursive function has depth n and each frame stores O(1) local state. What stack space does recursion use?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear",
                  "text": "O(n)."
                },
                {
                  "id": "constant",
                  "text": "O(1) because each frame is constant-size."
                },
                {
                  "id": "quadratic",
                  "text": "O(n²) because recursion is nested."
                },
                {
                  "id": "logarithmic",
                  "text": "O(log n)."
                }
              ],
              "acceptedOptionIds": [
                "linear"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Peak stack memory equals active depth times per-frame storage.",
              "details": "n frames with constant state require O(n) space.",
              "wrongOptionExplanationsByOptionId": {
                "constant": "There are n simultaneously active frames.",
                "quadratic": "Constant frame size multiplied by depth n is linear.",
                "logarithmic": "The depth is explicitly n."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-005",
            "prompt": "A hash map stores one entry per distinct input value, and there are d distinct values. What parameter gives the tight auxiliary-space expression?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "distinct_d",
                  "text": "O(d)."
                },
                {
                  "id": "always_n",
                  "text": "O(n) only."
                },
                {
                  "id": "constant",
                  "text": "O(1) because each lookup is expected constant-time."
                },
                {
                  "id": "log_d",
                  "text": "O(log d)."
                }
              ],
              "acceptedOptionIds": [
                "distinct_d"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Storage follows the number of retained keys.",
              "details": "When every input value is distinct, d can equal n; otherwise O(d) is more precise.",
              "wrongOptionExplanationsByOptionId": {
                "always_n": "O(n) is a worst-case bound, but d is the tighter direct parameter.",
                "constant": "Operation time does not bound total entries.",
                "log_d": "The map stores d entries."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-space-006",
            "prompt": "A function returns a new array of k results and otherwise uses only two indices. Which classification is precise?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "output_k_aux_1",
                  "text": "O(k) output space and O(1) auxiliary space."
                },
                {
                  "id": "aux_k",
                  "text": "O(k) auxiliary space and O(1) output space."
                },
                {
                  "id": "both_k",
                  "text": "The same array counts as both output and auxiliary space."
                },
                {
                  "id": "all_constant",
                  "text": "Both are O(1) because only two indices are used."
                }
              ],
              "acceptedOptionIds": [
                "output_k_aux_1"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The result array is output storage, while the indices are working state.",
              "details": "Separating roles avoids conflating result size with auxiliary memory.",
              "wrongOptionExplanationsByOptionId": {
                "aux_k": "The new array is the required result.",
                "both_k": "One structure should not be double-counted.",
                "all_constant": "The result array grows with k."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "output_sensitive_analysis"
            }
          },
          {
            "id": "alg-complexity-space-007",
            "prompt": "A function sorts an input array in place using an implementation with O(log n) recursion depth. What auxiliary term must be included?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "stack_log",
                  "text": "O(log n) recursion-stack space."
                },
                {
                  "id": "input_n_aux",
                  "text": "The input array itself as O(n) auxiliary space."
                },
                {
                  "id": "output_n",
                  "text": "A mandatory new O(n) output array."
                },
                {
                  "id": "constant",
                  "text": "O(1) because the elements remain in the same array."
                }
              ],
              "acceptedOptionIds": [
                "stack_log"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "In-place mutation can avoid a second array without eliminating call-stack storage.",
              "details": "Auxiliary analysis must include every simultaneously active frame.",
              "wrongOptionExplanationsByOptionId": {
                "input_n_aux": "Input storage is not extra working memory.",
                "output_n": "The sort is in place.",
                "constant": "The recursion stack still grows."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-space-008",
            "prompt": "Why does the total number of allocations not by itself determine space complexity?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "peak_live",
                  "text": "Allocations may be released or reused, so peak simultaneously live memory is what matters."
                },
                {
                  "id": "allocations_free",
                  "text": "Allocations never consume memory."
                },
                {
                  "id": "names_only",
                  "text": "Only variable names determine memory."
                },
                {
                  "id": "time_equals_space",
                  "text": "Allocation count is always identical to running time."
                }
              ],
              "acceptedOptionIds": [
                "peak_live"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Space complexity is not cumulative allocation traffic.",
              "details": "Lifetime overlap determines the maximum live footprint.",
              "wrongOptionExplanationsByOptionId": {
                "allocations_free": "They do while live.",
                "names_only": "Container sizes and lifetimes matter.",
                "time_equals_space": "Time and peak space measure different resources."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-009",
            "prompt": "Which storage categories should be separated in a careful analysis? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "input",
                  "text": "Pre-existing input storage."
                },
                {
                  "id": "output",
                  "text": "Storage required to represent the returned result."
                },
                {
                  "id": "auxiliary",
                  "text": "Temporary working memory and call-stack state."
                },
                {
                  "id": "source_lines",
                  "text": "The number of source-code lines."
                }
              ],
              "acceptedOptionIds": [
                "input",
                "output",
                "auxiliary"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Space explanations should identify storage by semantic role.",
              "details": "This prevents double-counting and makes in-place claims precise.",
              "wrongOptionExplanationsByOptionId": {
                "source_lines": "Runtime space does not scale with formatting."
              },
              "omittedCorrectExplanationsByOptionId": {
                "input": "It may be reported but is not usually auxiliary.",
                "output": "Output size can be unavoidable.",
                "auxiliary": "This is extra computational storage."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-010",
            "prompt": "Which structures contribute to auxiliary space in a boolean duplicate detector? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "seen_set",
                  "text": "A seen set discarded after returning the boolean."
                },
                {
                  "id": "loop_indices",
                  "text": "A constant number of indices or iterators."
                },
                {
                  "id": "boolean_result",
                  "text": "The returned boolean as O(1) output space."
                },
                {
                  "id": "input_array",
                  "text": "The caller-provided input array."
                }
              ],
              "acceptedOptionIds": [
                "seen_set",
                "loop_indices"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Temporary state is auxiliary even when it stores input-derived values.",
              "details": "The returned boolean and caller-owned input belong to different categories.",
              "wrongOptionExplanationsByOptionId": {
                "boolean_result": "It is output, not auxiliary.",
                "input_array": "It is pre-existing input storage."
              },
              "omittedCorrectExplanationsByOptionId": {
                "seen_set": "It is temporary working state.",
                "loop_indices": "They contribute O(1) auxiliary space."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-space-011",
            "prompt": "Which facts determine recursion-stack space? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "max_depth",
                  "text": "The maximum number of simultaneously active calls."
                },
                {
                  "id": "frame_size",
                  "text": "The asymptotic local storage retained by each frame."
                },
                {
                  "id": "total_calls",
                  "text": "The total number of calls over the whole execution."
                },
                {
                  "id": "call_names",
                  "text": "The names of recursive functions."
                }
              ],
              "acceptedOptionIds": [
                "max_depth",
                "frame_size"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Peak recursive space is based on simultaneous frames, not cumulative call count.",
              "details": "Both depth and retained per-frame data matter.",
              "wrongOptionExplanationsByOptionId": {
                "total_calls": "Completed calls no longer occupy the stack.",
                "call_names": "Names do not change frame size."
              },
              "omittedCorrectExplanationsByOptionId": {
                "max_depth": "Stack usage follows active depth.",
                "frame_size": "Large frame-local buffers can multiply with depth."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-012",
            "prompt": "Which cases can have O(1) auxiliary space? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "in_place_scan",
                  "text": "An iterative in-place scan with a fixed number of scalars."
                },
                {
                  "id": "stream_output",
                  "text": "A streaming producer that emits results without retaining them and uses fixed local state."
                },
                {
                  "id": "fixed_word_mask",
                  "text": "A constant number of fixed-width masks."
                },
                {
                  "id": "recursive_depth_n",
                  "text": "A recursion of depth n with one frame per level."
                }
              ],
              "acceptedOptionIds": [
                "in_place_scan",
                "stream_output",
                "fixed_word_mask"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Auxiliary space depends on retained working state.",
              "details": "Large input or output does not automatically imply large auxiliary memory.",
              "wrongOptionExplanationsByOptionId": {
                "recursive_depth_n": "The stack grows linearly."
              },
              "omittedCorrectExplanationsByOptionId": {
                "in_place_scan": "Working state does not grow.",
                "stream_output": "Logical output can be large while internal auxiliary state remains constant.",
                "fixed_word_mask": "Their storage is constant under the stated model."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-space-013",
            "prompt": "Arrange the process for deriving space complexity.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "list_storage",
                  "text": "List input, output, temporary structures, and recursion frames."
                },
                {
                  "id": "classify_roles",
                  "text": "Classify each structure by role."
                },
                {
                  "id": "find_peak",
                  "text": "Determine the maximum simultaneously live size of each auxiliary component."
                },
                {
                  "id": "combine",
                  "text": "Add concurrent terms and simplify the dominant asymptotic bound."
                }
              ],
              "canonicalOrder": [
                "list_storage",
                "classify_roles",
                "find_peak",
                "combine"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A space proof must account for both role and lifetime.",
              "details": "Adding every allocation ever made overstates peak space."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-014",
            "prompt": "Arrange the analysis of recursive stack space.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "derive_depth",
                  "text": "Determine maximum active recursion depth."
                },
                {
                  "id": "derive_frame",
                  "text": "Determine retained storage per frame."
                },
                {
                  "id": "multiply",
                  "text": "Multiply depth by asymptotic per-frame size when frames coexist."
                },
                {
                  "id": "add_other",
                  "text": "Add other simultaneously live auxiliary structures."
                }
              ],
              "canonicalOrder": [
                "derive_depth",
                "derive_frame",
                "multiply",
                "add_other"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Recursive space follows concurrent frames and their retained state.",
              "details": "The final result may be dominated by either stack or another structure."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "analyze_scaling_limit"
            }
          },
          {
            "id": "alg-complexity-space-015",
            "prompt": "Arrange the comparison of two sequential temporary buffers.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "size_first",
                  "text": "Determine the size of the first buffer."
                },
                {
                  "id": "lifetime",
                  "text": "Confirm it is released before the second buffer is allocated."
                },
                {
                  "id": "size_second",
                  "text": "Determine the second buffer's size."
                },
                {
                  "id": "take_max",
                  "text": "Use the maximum rather than the sum for peak auxiliary space."
                }
              ],
              "canonicalOrder": [
                "size_first",
                "lifetime",
                "size_second",
                "take_max"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Non-overlapping lifetimes do not contribute simultaneously.",
              "details": "Peak live memory is the larger buffer plus any shared state."
            },
            "taxonomy": {
              "primarySkillAtomId": "derive_space_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "problemArchetypeId": "compare_solution_costs"
            }
          },
          {
            "id": "alg-complexity-space-016",
            "prompt": "An iterative scan uses three indices and returns no growing result. Select auxiliary-space complexity.",
            "constraints": [
              "All scalar values have fixed size."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "auxiliary_space"
