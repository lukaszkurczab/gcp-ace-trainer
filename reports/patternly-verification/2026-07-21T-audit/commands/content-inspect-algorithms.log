                  "O(1)",
                  "O(k)",
                  "O(n + m)",
                  "O(nm)"
                ],
                "output_space": [
                  "O(1)",
                  "O(k)",
                  "O(n + m)",
                  "O(nm)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n + m + k)"
                ],
