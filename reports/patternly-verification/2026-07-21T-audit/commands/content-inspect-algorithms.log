        "items": [
          {
            "id": "alg-binary-search-bounds-001",
            "prompt": "What does lower_bound(target) return in ascending data?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "first_ge",
                  "text": "The first index whose value is greater than or equal to target."
                },
                {
                  "id": "first_gt",
                  "text": "The first index whose value is strictly greater than target."
                },
                {
                  "id": "last_le",
                  "text": "The last index whose value is less than or equal to target."
                },
                {
                  "id": "any_equal",
                  "text": "Any index equal to target."
                }
              ],
              "acceptedOptionIds": [
                "first_ge"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Lower bound locates the insertion boundary before all values that are not less than target.",
              "details": "It returns n when every value is smaller than target.",
              "wrongOptionExplanationsByOptionId": {
                "first_gt": "That is upper_bound.",
                "last_le": "That can be derived from upper_bound but is not lower_bound.",
                "any_equal": "Lower bound remains defined even when target is absent."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-002",
            "prompt": "What does upper_bound(target) return in ascending data?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "first_gt",
                  "text": "The first index whose value is strictly greater than target."
                },
                {
                  "id": "first_ge",
                  "text": "The first index whose value is greater than or equal to target."
                },
                {
                  "id": "last_equal",
                  "text": "The last index equal to target."
                },
                {
                  "id": "any_greater",
                  "text": "Any index whose value is greater than target."
                }
              ],
              "acceptedOptionIds": [
                "first_gt"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Upper bound separates values less than or equal to target from strictly greater values.",
              "details": "It can equal n when no value is greater.",
              "wrongOptionExplanationsByOptionId": {
                "first_ge": "That is lower_bound.",
                "last_equal": "Upper bound is one position after the final equal value.",
                "any_greater": "The first such index is required."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "upper_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-003",
            "prompt": "The sorted array is [1, 2, 2, 2, 5]. What are lower_bound(2) and upper_bound(2)?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "one_four",
                  "text": "1 and 4."
                },
                {
                  "id": "one_three",
                  "text": "1 and 3."
                },
                {
                  "id": "two_four",
                  "text": "2 and 4."
                },
                {
                  "id": "zero_five",
                  "text": "0 and 5."
                }
              ],
              "acceptedOptionIds": [
                "one_four"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The equal-value range is the half-open interval [lower_bound, upper_bound).",
              "details": "Indices 1, 2, and 3 contain 2, so the first greater value is at index 4.",
              "wrongOptionExplanationsByOptionId": {
                "one_three": "Index 3 is the last equal value, not the first greater value.",
                "two_four": "Lower bound must return the first equal position.",
                "zero_five": "Those are the full-array boundaries, not the target boundaries."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-004",
            "prompt": "How can the number of occurrences of target in sorted data be computed from boundaries?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "upper_minus_lower",
                  "text": "upper_bound(target) - lower_bound(target)."
                },
                {
                  "id": "lower_minus_upper",
                  "text": "lower_bound(target) - upper_bound(target)."
                },
                {
                  "id": "upper_plus_lower",
                  "text": "upper_bound(target) + lower_bound(target)."
                },
                {
                  "id": "any_match",
                  "text": "Return 1 whenever any exact match exists."
                }
              ],
              "acceptedOptionIds": [
                "upper_minus_lower"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The half-open equal range contains exactly upper - lower indices.",
              "details": "When target is absent, both boundaries converge to the same insertion position and the count is zero.",
              "wrongOptionExplanationsByOptionId": {
                "lower_minus_upper": "This produces a nonpositive value.",
                "upper_plus_lower": "Index positions are not combined by addition.",
                "any_match": "Duplicates may produce more than one occurrence."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "upper_bound",
              "problemArchetypeId": "find_last_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-005",
            "prompt": "What should lower_bound(target) return when every array value is smaller than target?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "n",
                  "text": "n, the insertion position after the final element."
                },
                {
                  "id": "n_minus_one",
                  "text": "n - 1, the final valid index."
                },
                {
                  "id": "minus_one",
                  "text": "-1."
                },
                {
                  "id": "zero",
                  "text": "0."
                }
              ],
              "acceptedOptionIds": [
                "n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The insertion boundary may be one past the final valid index.",
              "details": "Half-open boundary searches intentionally allow n as a legal result.",
              "wrongOptionExplanationsByOptionId": {
                "n_minus_one": "That value is still smaller than target.",
                "minus_one": "Lower bound commonly uses the half-open sentinel n.",
                "zero": "Inserting at the beginning would violate sorted order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-006",
            "prompt": "What should lower_bound(target) return when every array value is greater than target?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "zero",
                  "text": "0."
                },
                {
                  "id": "one",
                  "text": "1."
                },
                {
                  "id": "n_minus_one",
                  "text": "n - 1."
                },
                {
                  "id": "n",
                  "text": "n."
                }
              ],
              "acceptedOptionIds": [
                "zero"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The first position already satisfies the lower-bound predicate.",
              "details": "Inserting target before index 0 preserves ascending order.",
              "wrongOptionExplanationsByOptionId": {
                "one": "The first element already satisfies value >= target.",
                "n_minus_one": "That is not the first valid position.",
                "n": "A valid position exists at the beginning."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-007",
            "prompt": "Why is returning immediately when nums[mid] equals target incorrect for lower_bound?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "earlier_equal_possible",
                  "text": "An earlier equal value may still exist in the left region."
                },
                {
                  "id": "equal_never_valid",
                  "text": "Equality is never a valid lower-bound condition."
                },
                {
                  "id": "must_search_right",
                  "text": "Lower bound always lies to the right of an equal value."
                },
                {
                  "id": "duplicates_unsorted",
                  "text": "Duplicates make the array unsorted."
                }
              ],
              "acceptedOptionIds": [
                "earlier_equal_possible"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A matching midpoint is a valid candidate but may not be the first valid candidate.",
              "details": "The search retains mid and continues left.",
              "wrongOptionExplanationsByOptionId": {
                "equal_never_valid": "Equality satisfies value >= target.",
                "must_search_right": "It seeks the first equal or greater position.",
                "duplicates_unsorted": "Equal adjacent values are compatible with sorted order."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-008",
            "prompt": "How can the last index with value <= target be derived from upper_bound?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "upper_minus_one",
                  "text": "upper_bound(target) - 1, when the result range is non-empty."
                },
                {
                  "id": "lower_plus_one",
                  "text": "lower_bound(target) + 1."
                },
                {
                  "id": "upper_itself",
                  "text": "upper_bound(target)."
                },
                {
                  "id": "n_always",
                  "text": "Always return n."
                }
              ],
              "acceptedOptionIds": [
                "upper_minus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Upper bound is the first position outside the <= target region.",
              "details": "Subtracting one yields the final position inside that region, with a separate check when upper bound is zero.",
              "wrongOptionExplanationsByOptionId": {
                "lower_plus_one": "This has no general relation to the last <= target position.",
                "upper_itself": "Upper bound points to the first strictly greater value.",
                "n_always": "The result depends on target and data."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "upper_bound",
              "problemArchetypeId": "find_last_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-009",
            "prompt": "How can the last index with value < target be derived from lower_bound?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "lower_minus_one",
                  "text": "lower_bound(target) - 1, when lower_bound is greater than zero."
                },
                {
                  "id": "upper_minus_one",
                  "text": "upper_bound(target) - 1."
                },
                {
                  "id": "lower_itself",
                  "text": "lower_bound(target)."
                },
                {
                  "id": "zero_always",
                  "text": "Always return 0."
                }
              ],
              "acceptedOptionIds": [
                "lower_minus_one"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Lower bound is the first position outside the < target region.",
              "details": "The predecessor is the final strictly smaller value when such a position exists.",
              "wrongOptionExplanationsByOptionId": {
                "upper_minus_one": "That returns the last <= target position.",
                "lower_itself": "Lower bound points to the first >= target position.",
                "zero_always": "The answer may not exist or may be later."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_last_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-010",
            "prompt": "The target is absent from sorted data. How are lower_bound(target) and upper_bound(target) related?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "equal_insertion",
                  "text": "They are equal at the target's insertion position."
                },
                {
                  "id": "lower_less",
                  "text": "Lower bound is always strictly smaller."
                },
                {
                  "id": "upper_less",
                  "text": "Upper bound is smaller than lower bound."
                },
                {
                  "id": "both_minus_one",
                  "text": "Both must be -1."
                }
              ],
              "acceptedOptionIds": [
                "equal_insertion"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With no values equal to target, the >= and > predicates change at the same position.",
              "details": "This makes upper - lower equal zero.",
              "wrongOptionExplanationsByOptionId": {
                "lower_less": "Without equal values, first >= and first > coincide.",
                "upper_less": "Boundary order cannot reverse.",
                "both_minus_one": "The canonical boundary result is an insertion index, possibly n."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "upper_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-011",
            "prompt": "Which are legal lower-bound return values for an array of length n? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "zero",
                  "text": "0."
                },
                {
                  "id": "middle",
                  "text": "Any index from 1 through n - 1."
                },
                {
                  "id": "n",
                  "text": "n."
                },
                {
                  "id": "minus_one",
                  "text": "-1 under the canonical [0, n) contract."
                }
              ],
              "acceptedOptionIds": [
                "zero",
                "middle",
                "n"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Lower bound returns an insertion boundary in the closed numeric range [0, n].",
              "details": "It is not limited to valid element indices because n is a useful sentinel.",
              "wrongOptionExplanationsByOptionId": {
                "minus_one": "The canonical insertion boundary stays within 0 through n."
              },
              "omittedCorrectExplanationsByOptionId": {
                "zero": "The first element may satisfy the predicate.",
                "middle": "The transition may occur inside the array.",
                "n": "No element may satisfy value >= target."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-012",
            "prompt": "Which queries can be answered using lower or upper boundaries? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "insertion",
                  "text": "Find where target can be inserted while preserving order."
                },
                {
                  "id": "count_equal",
                  "text": "Count occurrences of target."
                },
                {
                  "id": "last_le",
                  "text": "Find the last value less than or equal to target."
                },
                {
                  "id": "arbitrary_unsorted",
                  "text": "Find any target in arbitrary unsorted data without preprocessing."
                }
              ],
              "acceptedOptionIds": [
                "insertion",
                "count_equal",
                "last_le"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary searches expose ordered partition points that support several derived queries.",
              "details": "They do not apply directly to arbitrary unsorted data.",
              "wrongOptionExplanationsByOptionId": {
                "arbitrary_unsorted": "Boundary predicates rely on sorted or monotonic structure."
              },
              "omittedCorrectExplanationsByOptionId": {
                "insertion": "Lower bound is the canonical insertion point before equal values.",
                "count_equal": "The equal range length is upper - lower.",
                "last_le": "It is upper_bound(target) - 1 when present."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-013",
            "prompt": "Which tests are important for lower and upper bound implementations? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "target_absent_between",
                  "text": "Target absent between two existing values."
                },
                {
                  "id": "all_equal",
                  "text": "All array values equal target."
                },
                {
                  "id": "outside_both",
                  "text": "Target smaller than all values and larger than all values."
                },
                {
                  "id": "only_unique_mid",
                  "text": "Only one unique target located initially at mid."
                }
              ],
              "acceptedOptionIds": [
                "target_absent_between",
                "all_equal",
                "outside_both"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary tests must exercise duplicate ranges, absence, and both sentinels.",
              "details": "A midpoint hit can pass even when the algorithm returns the wrong edge.",
              "wrongOptionExplanationsByOptionId": {
                "only_unique_mid": "This does not exercise duplicate or sentinel behavior."
              },
              "omittedCorrectExplanationsByOptionId": {
                "target_absent_between": "Both boundaries should equal the internal insertion point.",
                "all_equal": "The boundaries should become 0 and n.",
                "outside_both": "These exercise return values 0 and n."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "upper_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-014",
            "prompt": "Which predicate-to-boundary mappings are correct? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "first_ge",
                  "text": "First value >= target corresponds to lower_bound."
                },
                {
                  "id": "first_gt",
                  "text": "First value > target corresponds to upper_bound."
                },
                {
                  "id": "last_lt",
                  "text": "Last value < target can be derived as lower_bound(target) - 1."
                },
                {
                  "id": "last_le_lower",
                  "text": "Last value <= target is lower_bound(target) - 1."
                }
              ],
              "acceptedOptionIds": [
                "first_ge",
                "first_gt",
                "last_lt"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary definitions can be composed through predecessor relationships.",
              "details": "The strictness of the predicate determines whether lower or upper bound is used.",
              "wrongOptionExplanationsByOptionId": {
                "last_le_lower": "That gives last < target, not last <= target when equal values exist."
              },
              "omittedCorrectExplanationsByOptionId": {
                "first_ge": "This is the canonical lower-bound predicate.",
                "first_gt": "This is the canonical upper-bound predicate.",
                "last_lt": "Lower bound is the first position outside the < target region."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_last_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-015",
            "prompt": "Arrange one lower-bound iteration over [left, right).",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "compute_mid",
                  "text": "Compute a midpoint in the non-empty half-open interval."
                },
                {
                  "id": "test_ge",
                  "text": "Test whether nums[mid] >= target."
                },
                {
                  "id": "keep_or_discard",
                  "text": "If true set right = mid; otherwise set left = mid + 1."
                },
                {
                  "id": "repeat",
                  "text": "Continue until left equals right."
                }
              ],
              "canonicalOrder": [
                "compute_mid",
                "test_ge",
                "keep_or_discard",
                "repeat"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The predicate is false before the lower bound and true from the lower bound onward.",
              "details": "A true midpoint remains a candidate; a false midpoint is discarded."
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-016",
            "prompt": "Arrange one upper-bound iteration over [left, right).",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "compute_mid",
                  "text": "Compute a midpoint."
                },
                {
                  "id": "test_gt",
                  "text": "Test whether nums[mid] > target."
                },
                {
                  "id": "keep_or_discard",
                  "text": "If true set right = mid; otherwise set left = mid + 1."
                },
                {
                  "id": "converge",
                  "text": "Return the converged first-greater index."
                }
              ],
              "canonicalOrder": [
                "compute_mid",
                "test_gt",
                "keep_or_discard",
                "converge"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Upper bound searches the first true position of value > target.",
              "details": "Equal values belong to the false side and are skipped by moving left past mid."
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "upper_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-017",
            "prompt": "Arrange the steps for counting target occurrences in sorted data.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "find_lower",
                  "text": "Compute lower_bound(target)."
                },
                {
                  "id": "find_upper",
                  "text": "Compute upper_bound(target)."
                },
                {
                  "id": "subtract",
                  "text": "Compute upper - lower."
                },
                {
                  "id": "interpret_zero",
                  "text": "Treat zero as target absent and a positive value as the count."
                }
              ],
              "canonicalOrder": [
                "find_lower",
                "find_upper",
                "subtract",
                "interpret_zero"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The equal-value region is half-open and its length is a direct subtraction.",
              "details": "No separate exact-match scan is required."
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "upper_bound",
              "problemArchetypeId": "find_last_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-018",
            "prompt": "Arrange the verification of a returned lower-bound index p.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "range",
                  "text": "Check 0 <= p <= n."
                },
                {
                  "id": "left_partition",
                  "text": "Verify every index before p has value < target."
                },
                {
                  "id": "right_condition",
                  "text": "Verify p == n or nums[p] >= target."
                },
                {
                  "id": "minimality",
                  "text": "Conclude p is the first valid insertion boundary."
                }
              ],
              "canonicalOrder": [
                "range",
                "left_partition",
                "right_condition",
                "minimality"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A boundary result is proven by the partition on both sides.",
              "details": "Exact equality is optional because target may be absent."
            },
            "taxonomy": {
              "primarySkillAtomId": "find_first_or_last_valid_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lower_bound",
              "problemArchetypeId": "find_first_valid_position"
            }
          },
          {
            "id": "alg-binary-search-bounds-019",
