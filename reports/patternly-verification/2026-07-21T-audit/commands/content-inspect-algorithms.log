          {
            "id": "alg-prefix-index-contract-sortedness-independent",
            "prompt": "Does choosing an inclusive or exclusive prefix convention depend on whether A is sorted?",
            "constraints": [
              "Queries refer to positions in the current array order.",
              "Either convention may be implemented consistently."
