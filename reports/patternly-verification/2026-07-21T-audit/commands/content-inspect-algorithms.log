            },
            "feedback": {
              "reason": "A rejected value consumes input but produces no output position.",
              "details": "Read advances because the source occurrence has been processed. Write remains unchanged because the valid prefix gains no retained value."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_read_write_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-stable-compaction-020",
            "prompt": "Arrange the reasoning that proves the read/write invariant is preserved when a value is retained.",
            "difficulty": "easy",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "assume_prefix_valid",
                  "text": "Assume [0, write) already contains the retained values from the processed prefix."
                },
                {
                  "id": "write_next_retained",
                  "text": "Write the accepted current value at array[write]."
                },
                {
                  "id": "advance_boundary",
                  "text": "Increment write so the valid prefix includes the new value."
                },
                {
                  "id": "confirm_order_and_safety",
                  "text": "Confirm that relative order is preserved and write does not move ahead of the next read boundary."
                }
              ],
              "canonicalOrder": [
                "assume_prefix_valid",
                "write_next_retained",
                "advance_boundary",
                "confirm_order_and_safety"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The proof follows the invariant before the iteration, the state update, and the invariant after the update.",
              "details": "Appending the current retained value to the established prefix preserves both content and order, while the boundary relation keeps unread input safe."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_read_write_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          },
          {
            "id": "alg-arrays-stable-compaction-021",
            "prompt": "Arrange the finalization steps after the read index has processed the entire input.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "stop_at_n",
                  "text": "Stop when read reaches n."
                },
                {
                  "id": "identify_valid_prefix",
                  "text": "Treat [0, write) as the complete compacted result."
                },
                {
                  "id": "ignore_suffix",
                  "text": "Leave positions at or after write outside the logical output contract."
                },
                {
                  "id": "return_write",
                  "text": "Return write as the logical result length."
                }
              ],
              "canonicalOrder": [
                "stop_at_n",
                "identify_valid_prefix",
                "ignore_suffix",
                "return_write"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Completion freezes the established output prefix and reports its exclusive boundary.",
              "details": "The suffix need not be cleared unless explicitly required. Returning write exposes exactly the number of retained values."
            },
            "taxonomy": {
              "primarySkillAtomId": "maintain_read_write_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "foundations",
              "patternVariantId": "stable_compaction",
              "problemArchetypeId": "remove_or_compact_in_place"
            }
          }
        ],
