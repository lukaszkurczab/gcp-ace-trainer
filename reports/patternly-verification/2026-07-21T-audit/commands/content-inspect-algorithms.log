                  "O(2^n)"
                ],
                "auxiliary_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n log n)"
                ],
                "auxiliary_space": [
                  "O(log n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "sort_plus_scan": "O(n log n)"
