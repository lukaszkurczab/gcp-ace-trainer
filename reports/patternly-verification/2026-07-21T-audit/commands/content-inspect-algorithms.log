      {
        "id": "alg-contrast-hash-sort-lookup-001",
        "prompt": "A stream must report whether each arriving identifier has been seen before; result order follows arrival order and no sorted output is required. Which primary signal is strongest?",
        "difficulty": "intro",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "hash_lookup",
              "text": "Equality-based membership state favors a hash set."
            },
            {
              "id": "sort_all",
              "text": "Sorting is required because duplicate detection always needs adjacency."
            },
            {
              "id": "compare_neighbors",
              "text": "Compare only consecutive arrivals."
            },
            {
              "id": "binary_search_unsorted",
              "text": "Binary-search the unsorted arrivals."
            }
          ],
          "acceptedOptionIds": [
            "hash_lookup"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "The decisive operation is repeated equality-based membership lookup.",
          "details": "A hash set directly represents seen identifiers and can preserve arrival-order processing without first imposing an ordering.",
          "wrongOptionExplanationsByOptionId": {
            "sort_all": "Sorting can expose adjacent duplicates, but online seen-before lookup does not require order.",
            "compare_neighbors": "Equal identifiers may be separated by many other values.",
            "binary_search_unsorted": "Binary search lacks a sorted search domain."
          }
        },
        "taxonomy": {
