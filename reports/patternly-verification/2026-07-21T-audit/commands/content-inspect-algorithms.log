      {
        "id": "alg-complexity-reject-008",
        "prompt": "A proposed search checks every pair of n values, but the task must return every qualifying pair and k can be Θ(n²). What is the correct review?",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "output_may_justify",
              "text": "Quadratic work may be unavoidable in worst cases because the required output can itself be quadratic."
            },
            {
              "id": "always_reject",
              "text": "Reject O(n²) without considering output."
            },
            {
              "id": "constant_output",
              "text": "Returning pairs always uses O(1) output space."
            },
            {
              "id": "names",
              "text": "Rename the loops to avoid the quadratic bound."
            }
          ],
          "acceptedOptionIds": [
            "output_may_justify"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
