          {
            "id": "alg-contrast-binary-scan-single-009",
            "prompt": "A sorted array query requires returning every occurrence of target. Which one-query cost statement is correct if k matches are output?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "binary_plus_output",
                  "text": "Boundary searches can locate the range in O(log n), but materializing k results still costs Ω(k)."
                },
                {
                  "id": "pure_log",
                  "text": "The entire operation is O(log n) regardless of k."
                },
                {
                  "id": "scan_always_n_only",
                  "text": "A scan is O(n) and output has no additional cost."
                },
                {
                  "id": "any_match",
                  "text": "Return one midpoint match because binary search is faster."
                }
