        "items": [
          {
            "id": "alg-ctpsw-sivc-01",
            "prompt": "When is sorted input a decisive signal for a two-pointers pair scan, rather than a superficial property that could coexist with a contiguous-range problem?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ordered_elimination",
                  "text": "When comparing endpoint values lets the algorithm prove which endpoint cannot belong to any remaining valid pair."
                },
                {
                  "id": "always_sorted",
                  "text": "Whenever the input is sorted, regardless of the output contract."
                },
                {
                  "id": "two_indices",
                  "text": "Whenever left and right can be initialized."
                },
                {
                  "id": "contiguous_output",
                  "text": "Whenever the result must be a contiguous range."
                }
              ],
              "acceptedOptionIds": [
                "ordered_elimination"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sortedness is useful when it supports a safe endpoint-elimination proof.",
              "details": "Ordering is not a pattern label by itself. It becomes decisive when a comparison with the target establishes a direction: all candidates retaining one endpoint are too small or too large, so that endpoint can be discarded. If the problem instead asks about a contiguous range whose complete contents determine validity, the same sorted input may be irrelevant or may merely simplify the range predicate. The transfer rule is to connect sortedness to a concrete proof, not to a memorized association.",
              "wrongOptionExplanationsByOptionId": {
                "always_sorted": "Sorted data supports many algorithms and does not override the candidate or invariant.",
                "two_indices": "Choosing endpoints initially does not prove which movement is safe; sortedness must connect a comparison to elimination of all pairs using one endpoint.",
                "contiguous_output": "Contiguous output is a window signal, not a reason to use endpoint-pair elimination."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_sorted_input_signal_from_contiguity_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "Sortedness is decisive only when a comparison justifies eliminating a set of candidate pairs."
            ]
          },
          {
            "id": "alg-ctpsw-sivc-02",
            "prompt": "An unsorted sequence of nonnegative values asks for the longest original-order contiguous segment with total at most B. Which signal is decisive?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "contiguity_window",
                  "text": "Original-order contiguity plus an incrementally maintained range sum supports sliding window."
                },
                {
                  "id": "unsorted_no_window",
                  "text": "Unsorted input rules out sliding window."
                },
                {
                  "id": "sort_then_pair",
                  "text": "Sort the sequence and use endpoint pair comparison."
                },
                {
                  "id": "two_indices_pair",
                  "text": "Use two pointers because the segment has two endpoints."
                }
              ],
              "acceptedOptionIds": [
                "contiguity_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The candidate's original-order contiguity and maintained aggregate outweigh the absence of sorted order.",
              "details": "A window does not need globally sorted values. It needs a contiguous candidate and a validity rule that can be maintained as boundaries move. Nonnegative values supply monotone budget repair, so the range sum can be updated in linear time on the unsorted original sequence. Sorting would change which elements are adjacent and therefore solve a different problem. Two endpoints are simply the representation of the required segment, not evidence of an endpoint-pair relation.",
              "wrongOptionExplanationsByOptionId": {
                "unsorted_no_window": "Sliding window relies on contiguity and monotone state updates, not global sort order.",
                "sort_then_pair": "Sorting changes which elements are adjacent, so it destroys the original contiguous candidates and solves a materially different selection problem.",
                "two_indices_pair": "The two indices delimit a candidate whose total depends on every interior element; endpoint count does not turn that range into an isolated pair."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_sorted_input_signal_from_contiguity_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "introductory",
            "constraints": [
              "Original relative order must be preserved.",
              "Every value is nonnegative."
            ]
          },
          {
            "id": "alg-ctpsw-sivc-03",
            "prompt": "A nondecreasing array asks for the longest contiguous run whose maximum minus minimum is at most D. Because the array is sorted, the range extrema are its endpoints. Which classification is structurally correct?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sliding_window",
                  "text": "Sliding window: the candidate is the entire contiguous run, and left repairs its validity as right expands."
                },
                {
                  "id": "two_pointers_sorted",
                  "text": "Two pointers: sorted input always makes the endpoints an isolated pair."
                },
                {
                  "id": "either_identical",
                  "text": "Either label is equivalent because only endpoint values determine max and min."
                },
                {
                  "id": "binary_search",
                  "text": "Binary search, because the array is sorted."
                }
              ],
              "acceptedOptionIds": [
                "sliding_window"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Even when endpoint values summarize validity, the optimized candidate is the whole contiguous run.",
              "details": "Sortedness simplifies the range statistic: the endpoints give the minimum and maximum. It does not change candidate membership. Every element between left and right belongs to the run, its length is the objective, and advancing left removes a prefix from that candidate until the endpoint difference is valid. This remains a window invariant. If the task selected any two values with difference at most D and ignored the interior, sortedness would support a pair relation instead.",
              "wrongOptionExplanationsByOptionId": {
                "two_pointers_sorted": "Sortedness makes endpoint extrema easy to read, but it does not turn a length objective over all enclosed elements into an isolated endpoint-pair relation.",
                "either_identical": "The labels encode different candidate and correctness contracts even if the range statistic is endpoint-derived.",
                "binary_search": "Sorted input alone does not provide a monotone search predicate over answer positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_sorted_input_signal_from_contiguity_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The result is a contiguous run.",
              "The input is nondecreasing.",
              "D is nonnegative."
            ]
          },
          {
            "id": "alg-ctpsw-sivc-04",
            "prompt": "Why is “sort first, then use two pointers” generally invalid for a task asking for a longest contiguous segment in the original sequence?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "destroys_adjacency",
                  "text": "Sorting changes adjacency, so it changes which element sets are legal contiguous segments."
                },
                {
                  "id": "too_slow",
                  "text": "Sorting is always asymptotically too slow."
                },
                {
                  "id": "two_pointers_forbidden",
                  "text": "Two index variables cannot be used after sorting."
                },
                {
                  "id": "windows_require_hash",
                  "text": "Sliding windows require a hash map instead."
                }
              ],
              "acceptedOptionIds": [
                "destroys_adjacency"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Original-order adjacency is part of the answer contract and is not preserved by sorting.",
              "details": "Sorting preserves the multiset of values but not their positions or neighbours. A contiguous segment in sorted order may combine elements that were far apart originally and omit elements that lay between them. Therefore the preprocessing changes the candidate space before any pointer method runs. Pair-relation problems may permit sorting when original positions are irrelevant or can be preserved separately, because their candidates are selected values rather than original contiguous blocks. The boundary is semantic preservation, not merely time complexity.",
              "wrongOptionExplanationsByOptionId": {
                "too_slow": "O(n log n) may be acceptable under some constraints; the fundamental defect is changing legal candidates.",
                "two_pointers_forbidden": "Two pointers can be used on sorted data; the issue is that sorting violates this task's output contract.",
                "windows_require_hash": "Many windows use scalar state. Data-structure choice is unrelated to sorting legality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_sorted_input_signal_from_contiguity_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "intermediate",
            "constraints": [
              "The answer must refer to a contiguous segment of the original input."
            ]
          },
          {
            "id": "alg-ctpsw-sivc-05",
            "prompt": "Select all statements that correctly describe how sortedness and contiguity should influence the two-pointers-versus-window decision.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sorted_needs_proof",
                  "text": "Sortedness supports two pointers only when it enables a safe endpoint-elimination or ordered read/write rule."
                },
                {
                  "id": "contiguous_state",
                  "text": "A contiguous candidate whose full state is maintained is evidence for sliding window even if the data is sorted."
                },
                {
                  "id": "sorted_always_two",
                  "text": "Sorted input always overrides a contiguous-range objective."
                },
                {
                  "id": "unsorted_never_window",
                  "text": "An unsorted sequence cannot use sliding window."
                }
              ],
              "acceptedOptionIds": [
                "sorted_needs_proof",
                "contiguous_state"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Both accepted statements connect a surface signal to the invariant it actually supports.",
              "details": "Sortedness is a resource, not a classification. It may justify eliminating endpoint candidates, but only for an output relation that preserves that proof. Contiguity is also not sufficient by itself, yet when the algorithm maintains validity or score for the complete range, it identifies a window candidate. These rules explain why the same sorted sequence can produce a two-pointers pair task or a sliding-window range task depending on the requested answer.",
              "wrongOptionExplanationsByOptionId": {
                "sorted_always_two": "A sorted sequence can still ask for a contiguous-range objective whose invariant is a window.",
                "unsorted_never_window": "Many window predicates, including nonnegative sums and frequency constraints, do not require sorted input."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sorted_needs_proof": "Omitting this leaves sortedness as an unsupported keyword heuristic rather than a justified signal.",
                "contiguous_state": "Omitting this misses the stronger evidence that the maintained object is the whole range."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "distinguish_sorted_input_signal_from_contiguity_signal",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            },
            "difficulty": "advanced",
            "constraints": [
              "More than one statement may be correct."
            ]
          }
        ],
