            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The late containing interval starts before output already emitted, which a tail-only merge cannot repair.",
              "details": "End sorting permits [1, 10) to arrive last. By then [2, 3) has been committed separately. Merging the containing interval with only the last output cannot revisit that earlier component, so the result still overlaps. Sorting by start places [1, 10) first and makes both shorter intervals contained in one active component. The review should name the violated monotonic-start invariant rather than adding a special case based on length or changing endpoint equality.",
              "wrongOptionExplanationsByOptionId": {
                "wrong_endpoint_contract": "Containment and the missed earlier output occur regardless of half-open versus closed equality.",
                "long_interval_special_case": "A special length rule treats a symptom. Start order provides the general invariant for all containment cases."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_interval_endpoint_error",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          },
          {
            "id": "algorithms-intervals-boundary-review-012",
            "prompt": "A function predicts overlap when the sum of interval lengths exceeds the distance between their starts. It falsely reports overlap for [0, 100) with [100, 101), and for [0, 1) with [1.5, 100). What should replace the heuristic?",
            "constraints": [
              "All intervals are half-open linear ranges."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "use_cross_endpoint_predicate",
                  "text": "Use the direct cross-end predicate `a.start < b.end && b.start < a.end`."
                },
                {
                  "id": "adjust_length_threshold",
                  "text": "Increase the length threshold until both examples classify correctly."
                },
                {
                  "id": "sort_by_length_first",
                  "text": "Sort by length and compare the longer interval's end with the shorter interval's length."
                }
              ],
              "acceptedOptionIds": [
                "use_cross_endpoint_predicate"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Overlap is a set-intersection relation defined by endpoint order; duration-only formulas are incomplete.",
              "details": "The first pair contains a very long interval but is disjoint because the half-open endpoint 100 belongs only to the second interval. The second pair is also disjoint: there is a positive gap from 1 to 1.5, yet the very long second interval makes the sum-of-lengths test pass. These counterexamples show that duration magnitude is not sufficient to establish intersection. The cross-end predicate uses exactly the relative endpoint information required by half-open semantics. If the input is closed, change equality according to that contract rather than tuning a length threshold. Review feedback should remove the heuristic, not adjust its constant.",
              "wrongOptionExplanationsByOptionId": {
                "adjust_length_threshold": "No global duration threshold captures position, containment, gaps, and equality across arbitrary intervals.",
                "sort_by_length_first": "Sorting by duration still omits the intervals' relative coordinates. Containment and overlap are determined by endpoint order, so length-first processing cannot repair the heuristic."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "diagnose_interval_endpoint_error",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "merge_overlaps",
              "problemArchetypeId": "merge_or_compare_intervals"
            }
          }
        ],
