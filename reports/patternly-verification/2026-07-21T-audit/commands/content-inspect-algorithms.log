        "items": [
          {
            "id": "alg-contrast-binary-scan-discard-001",
            "prompt": "In ascending data, nums[mid] is smaller than target. What makes discarding every index at or left of mid legal?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sorted_implication",
                  "text": "Sorted order proves every value at or left of mid is also smaller than target."
                },
                {
                  "id": "mid_position",
                  "text": "Mid is near the center, so the left side is probably wrong."
                },
                {
                  "id": "variable_names",
                  "text": "The code uses left, right, and mid."
                },
                {
                  "id": "scan_equivalence",
                  "text": "A linear scan would eventually pass mid."
                }
              ],
              "acceptedOptionIds": [
                "sorted_implication"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A legal half discard is a logical implication from the midpoint observation and domain order.",
              "details": "The entire left region is eliminated because its values are bounded above by nums[mid], not because it contains roughly half the indices.",
              "wrongOptionExplanationsByOptionId": {
                "mid_position": "Probability is not a correctness proof.",
                "variable_names": "Names do not establish regional value relationships.",
                "scan_equivalence": "The scan behavior does not justify skipping unchecked candidates."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-002",
            "prompt": "An unsorted array has nums[mid] smaller than target. What can be concluded about values to the left of mid?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "nothing_directional",
                  "text": "Nothing directional; the target may appear anywhere, so scanning remains necessary."
                },
                {
                  "id": "all_smaller",
                  "text": "Every left value is smaller than target."
                },
                {
                  "id": "discard_left",
                  "text": "The left half can be discarded because mid is too small."
                },
                {
                  "id": "discard_right",
                  "text": "The right half can be discarded because mid is too small."
                }
              ],
              "acceptedOptionIds": [
                "nothing_directional"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A local comparison without global order does not eliminate a region.",
              "details": "Linear scan remains correct because every unchecked position is still a candidate.",
              "wrongOptionExplanationsByOptionId": {
                "all_smaller": "Unsorted positions have no such ordering guarantee.",
                "discard_left": "The target may be in the discarded half.",
                "discard_right": "The target may also be in the right half."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-003",
            "prompt": "A predicate over candidates is false for small values and true for all larger values. P(mid) is false. Which discard is legal in a first-true search?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "discard_through_mid",
                  "text": "Discard mid and every smaller candidate."
                },
                {
                  "id": "discard_right",
                  "text": "Discard every candidate greater than mid."
                },
                {
                  "id": "keep_mid_left",
                  "text": "Keep mid and search only smaller values."
                },
                {
                  "id": "return_mid",
                  "text": "Return mid as the first true."
                }
              ],
              "acceptedOptionIds": [
                "discard_through_mid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Monotonic false-to-true structure proves the entire prefix through mid is false.",
              "details": "This is the predicate analogue of eliminating one sorted-array half.",
              "wrongOptionExplanationsByOptionId": {
                "discard_right": "The first true must lie to the right when mid is false.",
                "keep_mid_left": "Mid is known false and smaller values are also false.",
                "return_mid": "The predicate is false at mid."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-004",
            "prompt": "A condition over sorted values follows false, true, false. The midpoint condition is true. Which conclusion is valid?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_half_proof",
                  "text": "No complete side can be discarded solely from that truth value because the condition is nonmonotonic."
                },
                {
                  "id": "discard_right",
                  "text": "Discard the right side because true has already been found."
                },
                {
                  "id": "discard_left",
                  "text": "Discard the left side because mid is true."
                },
                {
                  "id": "logarithmic",
                  "text": "The search is logarithmic because a midpoint was evaluated."
                }
              ],
              "acceptedOptionIds": [
                "no_half_proof"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Binary search needs an implication covering a whole side, not merely a useful midpoint value.",
              "details": "An arbitrary condition must be scanned or handled with a different structural argument.",
              "wrongOptionExplanationsByOptionId": {
                "discard_right": "The condition becomes false and may change again; the desired contract is not specified as a boundary.",
                "discard_left": "Earlier or later true values may exist without one directional transition.",
                "logarithmic": "Evaluation at mid does not guarantee half elimination."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-005",
            "prompt": "In exact binary search, nums[mid] is greater than target. Why is right = mid - 1 stronger than right = mid for a closed interval?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "mid_proven_wrong",
                  "text": "Mid is proven not to match, so removing it guarantees progress while preserving every possible target."
                },
                {
                  "id": "mid_may_match",
                  "text": "Mid may still equal target."
                },
                {
                  "id": "style_only",
                  "text": "The two updates are always equivalent style choices."
                },
                {
                  "id": "scan_requires",
                  "text": "Linear scan requires mid - 1."
                }
              ],
              "acceptedOptionIds": [
                "mid_proven_wrong"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A legal discard should remove all proven-impossible candidates, including mid after a strict mismatch.",
              "details": "Boundary updates must encode both the semantic proof and strict interval shrinkage.",
              "wrongOptionExplanationsByOptionId": {
                "mid_may_match": "The strict greater-than comparison has ruled that out.",
                "style_only": "Keeping a known-wrong midpoint can stall or alter the interval contract.",
                "scan_requires": "The update follows binary-search correctness and progress, not scan mechanics."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-006",
            "prompt": "A rotated sorted array with distinct values has an ordered left half. The target lies outside that half’s endpoint range. Which reasoning justifies discarding it?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "ordered_range_exclusion",
                  "text": "Because the half is ordered, every value in it lies within its endpoints, and target lies outside that range."
                },
                {
                  "id": "rotation_guess",
                  "text": "The pivot is probably on the other side."
                },
                {
                  "id": "mid_name",
                  "text": "The midpoint variable identifies the correct half automatically."
                },
                {
                  "id": "always_right",
                  "text": "Rotated search always discards the left half."
                }
              ],
              "acceptedOptionIds": [
                "ordered_range_exclusion"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Even in rotated search, elimination depends on a region whose values are known to occupy a specific range.",
              "details": "The ordered-half test supplies the missing implication that a scan does not require.",
              "wrongOptionExplanationsByOptionId": {
                "rotation_guess": "Probability is insufficient without the ordered-range proof.",
                "mid_name": "The half must be classified and compared with target.",
                "always_right": "The retained side depends on order and target range."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-007",
            "prompt": "A proposed search checks the midpoint of a sorted array for whether the value is prime and discards the left half when it is not prime. What is wrong?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "primality_not_monotonic",
                  "text": "Primality is not monotonic in sorted numeric order, so a nonprime midpoint says nothing about one whole half."
                },
                {
                  "id": "sorted_not_numeric",
                  "text": "Sorted arrays cannot contain numeric values."
                },
                {
                  "id": "prime_requires_right",
                  "text": "Prime values always lie to the right."
                },
                {
                  "id": "mid_too_expensive",
                  "text": "The only issue is that primality testing has nonconstant cost."
                }
              ],
              "acceptedOptionIds": [
                "primality_not_monotonic"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Sorted values help only when the query predicate respects that order.",
              "details": "A scan is required to find a prime unless another structure or preprocessed index is introduced.",
              "wrongOptionExplanationsByOptionId": {
                "sorted_not_numeric": "They can; the predicate is the issue.",
                "prime_requires_right": "Primes and composites alternate irregularly.",
                "mid_too_expensive": "Even a constant-time primality oracle would not provide a half-discard rule."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-008",
            "prompt": "A first-true search uses a half-open interval [left, right). P(mid) is true. Why is right = mid legal while returning mid immediately may be wrong?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "mid_candidate_not_proven_first",
                  "text": "Mid is a valid candidate, but an earlier true candidate may still exist."
                },
                {
                  "id": "mid_false",
                  "text": "Mid is known false."
                },
                {
                  "id": "right_side_required",
                  "text": "The first true must be to the right of mid."
                },
                {
                  "id": "scan_only",
                  "text": "Boundary search can never return a first true value."
                }
              ],
              "acceptedOptionIds": [
                "mid_candidate_not_proven_first"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Boundary search may retain a midpoint rather than accept it as final.",
              "details": "The discard rule removes candidates strictly right of mid while preserving the possibility of an earlier transition.",
              "wrongOptionExplanationsByOptionId": {
                "mid_false": "The predicate is true at mid.",
                "right_side_required": "A true midpoint bounds the first true at or left of mid.",
                "scan_only": "It can when the invariant is preserved."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-009",
            "prompt": "Which observation distinguishes a legal binary-search iteration from merely checking a middle element during a scan?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "regional_implication",
                  "text": "The result at mid establishes a regional implication that eliminates candidates without inspecting them."
                },
                {
                  "id": "middle_position",
                  "text": "The inspected position is numerically near n/2."
                },
                {
                  "id": "two_boundaries",
                  "text": "Two integer variables are maintained."
                },
                {
                  "id": "one_comparison",
                  "text": "Only one comparison is made in the iteration."
                }
              ],
              "acceptedOptionIds": [
                "regional_implication"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Binary search is defined by justified candidate elimination.",
              "details": "Midpoint sampling without a side-wide implication remains an arbitrary inspection order.",
              "wrongOptionExplanationsByOptionId": {
                "middle_position": "A scan can inspect the middle first without gaining elimination power.",
                "two_boundaries": "Variables alone do not justify exclusion.",
                "one_comparison": "The meaning of the comparison, not its count, is decisive."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-010",
            "prompt": "Which facts can justify discarding one side of a search domain? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sorted_comparison",
                  "text": "A strict comparison in data sorted by the same key as the query."
                },
                {
                  "id": "monotonic_predicate",
                  "text": "A proven one-transition predicate over ordered candidates."
                },
                {
                  "id": "ordered_rotated_half",
                  "text": "An identified ordered half plus target-range exclusion in a distinct-value rotated array."
                },
                {
                  "id": "mid_is_center",
                  "text": "The candidate is near the numerical center."
                }
              ],
              "acceptedOptionIds": [
                "sorted_comparison",
                "monotonic_predicate",
                "ordered_rotated_half"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A legal discard is supported by a domain-wide implication.",
              "details": "Geometric centrality is useful only because it balances a discard already proven correct.",
              "wrongOptionExplanationsByOptionId": {
                "mid_is_center": "Central position alone says nothing about answer location."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sorted_comparison": "Order extends the midpoint comparison to a whole side.",
                "monotonic_predicate": "Truth or falsity extends directionally.",
                "ordered_rotated_half": "The local ordered range supports elimination."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-011",
            "prompt": "Which situations do not provide a legal half-discard rule? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "unsorted_exact",
                  "text": "Exact target search in arbitrary unsorted data without preprocessing."
                },
                {
                  "id": "alternating_condition",
                  "text": "A condition that alternates true and false across sorted values."
                },
                {
                  "id": "original_first_without_index",
                  "text": "First match in original order when only a key-sorted copy is available without provenance."
                },
                {
                  "id": "lower_bound",
                  "text": "First value greater than or equal to target in ascending data."
                }
              ],
              "acceptedOptionIds": [
                "unsorted_exact",
                "alternating_condition",
                "original_first_without_index"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Scanning remains necessary when unchecked candidates cannot be excluded in groups.",
              "details": "Lower bound is the contrasting case because its predicate partitions the array monotonically.",
              "wrongOptionExplanationsByOptionId": {
                "lower_bound": "This has a monotonic value >= target predicate."
              },
              "omittedCorrectExplanationsByOptionId": {
                "unsorted_exact": "A mismatch gives no direction.",
                "alternating_condition": "No single boundary exists.",
                "original_first_without_index": "Key order does not order the required identity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-012",
            "prompt": "Which properties must a binary-search update satisfy after midpoint evaluation? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "retain_possible",
                  "text": "Retain every candidate still capable of satisfying the result contract."
                },
                {
                  "id": "remove_impossible",
                  "text": "Remove only candidates justified as impossible by the invariant."
                },
                {
                  "id": "strict_progress",
                  "text": "Strictly reduce the active candidate set on every nonterminal branch."
                },
                {
                  "id": "remove_half_exactly",
                  "text": "Remove exactly half on every input."
                }
              ],
              "acceptedOptionIds": [
                "retain_possible",
                "remove_impossible",
                "strict_progress"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Correct binary-search updates combine preservation, proof, and progress.",
              "details": "The asymptotic benefit comes from proportional shrinkage, but the semantic requirements apply first.",
              "wrongOptionExplanationsByOptionId": {
                "remove_half_exactly": "Intervals may differ by one and duplicate ambiguity can reduce progress; correctness does not require an exact half count."
              },
              "omittedCorrectExplanationsByOptionId": {
                "retain_possible": "The answer cannot be discarded.",
                "remove_impossible": "Elimination must be sound.",
                "strict_progress": "Termination and logarithmic iteration count require progress."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-013",
            "prompt": "Which statements correctly contrast scanning with binary elimination? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "scan_checks_candidates",
                  "text": "A scan remains correct by checking candidates individually when no regional implication exists."
                },
                {
                  "id": "binary_skips_proven",
                  "text": "Binary search skips candidates only after proving they cannot contain the answer."
                },
                {
                  "id": "scan_can_early_exit",
                  "text": "A scan may still stop early after finding a result that satisfies its output contract."
                },
                {
                  "id": "binary_by_mid",
                  "text": "Any algorithm that checks mid is binary search."
                }
              ],
              "acceptedOptionIds": [
                "scan_checks_candidates",
                "binary_skips_proven",
                "scan_can_early_exit"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The methods differ in how they justify leaving candidates uninspected.",
              "details": "A scan checks or reaches them sequentially; binary search excludes them by invariant.",
              "wrongOptionExplanationsByOptionId": {
                "binary_by_mid": "Midpoint inspection without elimination is not binary search."
              },
              "omittedCorrectExplanationsByOptionId": {
                "scan_checks_candidates": "It does not need a discard proof.",
                "binary_skips_proven": "That proof is the mechanism.",
                "scan_can_early_exit": "Linear worst case does not forbid early termination."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-014",
            "prompt": "Arrange the reasoning for discarding the left side in ascending exact search when nums[mid] < target.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "local_compare",
                  "text": "Establish nums[mid] is too small."
                },
                {
                  "id": "extend_by_order",
                  "text": "Use ascending order to show every index at or left of mid is no larger than nums[mid]."
                },
                {
                  "id": "exclude_region",
                  "text": "Conclude none of those indices can contain target."
                },
                {
                  "id": "move_boundary",
                  "text": "Set left = mid + 1 and continue."
                }
              ],
              "canonicalOrder": [
                "local_compare",
                "extend_by_order",
                "exclude_region",
                "move_boundary"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The boundary update is the final consequence of a regional proof.",
              "details": "Skipping directly from comparison to assignment can hide an invalid assumption when the query changes."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-015",
            "prompt": "Arrange the reasoning for a first-true false-to-true predicate when P(mid) is true.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "mid_valid",
                  "text": "Establish that mid is a true candidate."
                },
                {
                  "id": "monotonic_suffix",
                  "text": "Use monotonicity to show every larger candidate is also true."
                },
                {
                  "id": "target_left_or_mid",
                  "text": "Conclude the first true lies at mid or earlier."
                },
                {
                  "id": "retain_mid_left",
                  "text": "Retain the left region including mid and discard candidates strictly right of mid."
                }
              ],
              "canonicalOrder": [
                "mid_valid",
                "monotonic_suffix",
                "target_left_or_mid",
                "retain_mid_left"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A true result does not finish a first-true search; it changes which region remains relevant.",
              "details": "The transfer boundary is the exact answer contract: any true could return, first true must continue left."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-016",
            "prompt": "Arrange the audit of a proposed half-discard condition.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_domain",
                  "text": "State the ordered candidate domain and exact desired result."
                },
                {
                  "id": "state_mid_outcomes",
                  "text": "List every possible midpoint outcome."
                },
                {
                  "id": "prove_side_implication",
                  "text": "For each nonterminal outcome, prove which whole region is impossible."
                },
                {
                  "id": "check_updates",
                  "text": "Verify the code removes only that region and strictly shrinks the interval."
                }
              ],
              "canonicalOrder": [
                "state_domain",
                "state_mid_outcomes",
                "prove_side_implication",
                "check_updates"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A discard rule is reviewed as a proof table, not as a memorized code pattern.",
              "details": "If any branch lacks a side-wide implication, scanning or another strategy is required."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-017",
            "prompt": "Arrange the fallback reasoning when a proposed condition is not monotonic.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "find_counterexample",
                  "text": "Exhibit candidates a < b < c where the condition changes direction more than once."
                },
                {
                  "id": "invalidate_implication",
                  "text": "Show that a midpoint truth value cannot classify one entire side."
                },
                {
                  "id": "reject_binary_rule",
                  "text": "Reject the proposed half-discard update."
                },
                {
                  "id": "select_alternative",
                  "text": "Use a scan, preprocessing index, or another structure that matches the condition."
                }
              ],
              "canonicalOrder": [
                "find_counterexample",
                "invalidate_implication",
                "reject_binary_rule",
                "select_alternative"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "A concrete counterexample is enough to invalidate the universal binary-search implication.",
              "details": "The alternative strategy depends on workload and whether useful preprocessing can create a monotonic representation."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-018",
            "prompt": "Arrange the two-candidate progress check for a branch that retains mid.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "set_adjacent",
                  "text": "Assume right = left + 1."
                },
                {
                  "id": "compute_bias",
                  "text": "Compute which boundary the chosen midpoint formula returns."
                },
                {
                  "id": "apply_update",
                  "text": "Apply the branch update that retains mid."
                },
                {
                  "id": "verify_smaller",
                  "text": "Confirm the resulting interval is strictly smaller; otherwise change midpoint bias or update."
                }
              ],
              "canonicalOrder": [
                "set_adjacent",
                "compute_bias",
                "apply_update",
                "verify_smaller"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The smallest nontrivial interval exposes non-progress immediately.",
              "details": "A legal semantic discard still needs a mechanical update that terminates."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-019",
            "prompt": "A legal binary search reduces an n-candidate random-access interval to at most half each iteration, while a scan may inspect every candidate. Select worst-case candidate inspections for both.",
            "constraints": [
              "Midpoint evaluation is O(1).",
              "The target may be absent."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "binary_inspections",
                "scan_inspections"
              ],
              "availableValuesByDimension": {
                "binary_inspections": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ],
                "scan_inspections": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "binary_inspections": [
                  "O(log n)"
                ],
                "scan_inspections": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "binary_inspections": {
                  "halving": "O(log n)"
                },
                "scan_inspections": {
                  "all_candidates": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "The complexity contrast is earned by the legal discard rule.",
              "details": "Without that rule, the O(log n) count is not available even if the code chooses middle indices."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-discard-020",
            "prompt": "A loop computes mid but updates left = left + 1 or right = right - 1, discarding only one candidate per iteration. A scan also advances one candidate at a time. Select the worst-case time of both under O(1) checks.",
            "constraints": [
              "The interval can shrink by only one position per iteration."
            ],
            "difficulty": "foundational",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "mid_loop_time",
                "scan_time"
              ],
              "availableValuesByDimension": {
                "mid_loop_time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ],
                "scan_time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)"
                ]
              },
              "acceptedValuesByDimension": {
                "mid_loop_time": [
                  "O(n)"
                ],
                "scan_time": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {
                "mid_loop_time": {
                  "one_candidate_progress": "O(n)"
                },
                "scan_time": {
                  "one_candidate_progress": "O(n)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "Using a midpoint does not make the loop logarithmic when progress is linear.",
              "details": "The number of candidates removed per iteration, together with check cost, determines the asymptotic bound."
            },
            "taxonomy": {
              "primarySkillAtomId": "compare_half_discard_rule_with_linear_scan",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          }
