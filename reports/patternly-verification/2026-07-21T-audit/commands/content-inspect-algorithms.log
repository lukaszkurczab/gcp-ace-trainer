          {
            "id": "recursion-basics-recursion-stack-and-complexity-tail-position-without-tco",
            "prompt": "factorialAcc(n, acc) returns acc when n == 0; otherwise it returns factorialAcc(n - 1, acc * n).\nThe target runtime does not guarantee tail-call optimization. What is the correct stack conclusion?",
            "constraints": [
              "n is a non-negative integer.",
              "The runtime does not guarantee tail-call optimization.",
              "Arithmetic cost and overflow are outside this item's scope."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "linear_stack_without_tco",
                  "text": "The call is in tail position, but maximum stack usage is O(n) without a guaranteed optimization."
                },
                {
                  "id": "constant_stack_by_syntax",
                  "text": "Stack usage is O(1) because a tail-position call automatically reuses the frame."
                },
                {
                  "id": "exponential_stack",
                  "text": "Stack usage is O(2^n) because factorial grows exponentially in value."
