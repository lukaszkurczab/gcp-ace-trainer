              "text": "When the contract concerns consecutive runs, or equal values are guaranteed to be grouped."
            },
            {
              "id": "any_unsorted_duplicates",
              "text": "For detecting all repeated values in any unsorted input."
            },
            {
              "id": "exact_global_counts",
              "text": "For computing exact global frequencies of arbitrary values."
            },
            {
              "id": "first_index_lookup",
              "text": "For returning the first index of every distinct value."
            }
          ],
          "acceptedOptionIds": [
            "adjacent_run_contract"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "Previous-value state represents local adjacency, not global history.",
          "details": "It is sufficient when only consecutive equality matters or when preprocessing guarantees that equal values form one run. Otherwise, separated occurrences require broader seen or frequency state.",
          "wrongOptionExplanationsByOptionId": {
