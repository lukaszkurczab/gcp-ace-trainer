      {
        "id": "alg-complexity-scaling-014",
        "prompt": "Arrange the process for assessing an algorithm against constraints.",
        "difficulty": "foundational",
        "interaction": {
          "type": "ordering",
          "elements": [
            {
              "id": "extract_limits",
              "text": "Extract maximum input dimensions, query counts, output obligations, and memory limits."
            },
            {
              "id": "derive_cost",
              "text": "Write the candidate algorithm's time and space expressions."
            },
            {
              "id": "substitute",
              "text": "Substitute the maximum constraints to estimate work and storage."
            },
            {
              "id": "decide_margin",
              "text": "Reject, accept provisionally, or benchmark when the estimate is near the budget."
            }
          ],
          "canonicalOrder": [
