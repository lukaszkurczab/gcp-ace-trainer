                "auxiliary_space": [
                  "O(1)",
                  "O(log W)",
                  "O(W)",
                  "O(W log W)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(log W)"
                ],
                "auxiliary_space": [
                  "O(1)"
                ]
              },
              "normalizedAliasesByDimension": {
                "time": {
                  "candidate_range": "O(log W)"
                },
                "auxiliary_space": {
                  "iterative": "O(1)"
                }
              },
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
