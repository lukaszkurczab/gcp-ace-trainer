            }
          },
          {
            "id": "alg-sort-groups-08-transfer-equivalence-key",
            "prompt": "Select all designs where sorting by the stated key guarantees that every intended equivalence class forms one contiguous run.",
            "constraints": [
              "The intended group relation is exactly the one described in each option.",
              "Normalization functions are deterministic."
            ],
            "difficulty": "advanced",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "casefold_words",
                  "text": "Group words case-insensitively by sorting on caseFold(word) and testing equality of that same normalized key."
                },
                {
                  "id": "raw_sort_casefold_group",
                  "text": "Group words case-insensitively after sorting only by their raw case-sensitive spelling."
                },
                {
                  "id": "date_day",
                  "text": "Group timestamps by calendar day by sorting on extractedDay(timestamp) and testing that same day key."
                },
                {
                  "id": "length_sort_anagram_group",
                  "text": "Group anagrams after sorting only by string length."
                }
              ],
              "acceptedOptionIds": [
                "casefold_words",
                "date_day"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Contiguous runs are guaranteed when the primary sort key is the same deterministic key that defines group equality.",
              "details": "Case-folded text and extracted calendar day each produce a canonical group key; sorting by that key places all equal keys together. Raw spelling can interleave case-insensitive equivalents with other strings, and length alone coarsens many non-anagram strings into one region without making each anagram signature contiguous. A secondary tie-break may order members inside a run, but the group key must remain primary.",
              "wrongOptionExplanationsByOptionId": {
                "raw_sort_casefold_group": "Case-sensitive order does not guarantee that every case-insensitive equivalent occupies one uninterrupted block.",
                "length_sort_anagram_group": "Equal length is necessary for anagrams but not the equivalence key, so different signatures can interleave the intended groups."
              },
              "omittedCorrectExplanationsByOptionId": {
                "casefold_words": "The normalized case-folded key is both the sort key and the equality key, guaranteeing one run per class.",
                "date_day": "Extracted day identity directly defines the groups and therefore becomes contiguous under the same primary key."
              }
            },
