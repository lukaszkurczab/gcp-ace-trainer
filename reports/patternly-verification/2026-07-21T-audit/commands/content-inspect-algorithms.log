            "feedback": {
              "reason": "XOR is powerful when the contract matches parity cancellation, but it is not a general multiset summary.",
              "details": "Its information loss must be part of the correctness argument.",
              "wrongOptionExplanationsByOptionId": {
                "requires_sort": "Associativity and commutativity remove any order requirement."
              },
              "omittedCorrectExplanationsByOptionId": {
                "loses_counts": "XOR retains parity only.",
                "two_uniques_combined": "A second technique is needed to separate them.",
                "not_sum": "Carries are ignored."
              }
            },
