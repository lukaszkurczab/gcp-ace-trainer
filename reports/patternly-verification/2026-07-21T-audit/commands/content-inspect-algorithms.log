          {
            "id": "alg-contrast-hash-sort-transfer-015",
            "prompt": "Arrange the general transfer decision process.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "diff_contract",
                  "text": "Identify exactly what changed in result, queries, updates, guarantees, order, indices, memory, or mutation."
                },
                {
                  "id": "recheck_legality",
                  "text": "Re-evaluate legal key operations and correctness for hashing and sorting."
                },
                {
                  "id": "recompute_cost",
                  "text": "Recompute complete lifecycle time, peak auxiliary space, and output cost."
                },
                {
                  "id": "justify_transfer",
                  "text": "Keep or change the strategy with an explicit boundary-based explanation."
