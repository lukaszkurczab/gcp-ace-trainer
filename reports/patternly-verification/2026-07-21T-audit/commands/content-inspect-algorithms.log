        "items": [
          {
            "id": "alg-hms-complexity-expected-versus-worst",
            "prompt": "Which statement accurately describes ordinary hash-table lookup complexity without overclaiming?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "expected_constant_possible_linear_worst",
                  "text": "Expected O(1) under ordinary distribution assumptions, with O(n) worst case possible for n stored keys."
                },
                {
                  "id": "worst_constant",
                  "text": "Worst-case O(1) for every key distribution and implementation."
                },
                {
                  "id": "always_logarithmic",
                  "text": "Always O(log n) because the table must search a balanced tree."
                }
              ],
              "acceptedOptionIds": [
                "expected_constant_possible_linear_worst"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Hash lookup is commonly described as expected O(1), while a linear worst case remains possible unless stronger guarantees are specified.",
              "details": "Complexity claims must name their model. With well-distributed hashes and controlled load, expected lookup examines a constant amount of state. If many keys collide or the implementation’s defenses do not supply a stronger bound, a lookup may inspect O(n) entries. The exact worst-case guarantee is implementation- and threat-model-dependent.",
              "wrongOptionExplanationsByOptionId": {
                "worst_constant": "Collisions or implementation-specific adversarial cases can force many stored entries to be examined; constant time is not a universal worst-case guarantee.",
                "always_logarithmic": "Ordinary hash tables do not inherently perform a balanced-tree search for every lookup; expected access is commonly constant under stated assumptions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_expected_hash_lookup_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "lookup_by_value",
              "problemArchetypeId": "detect_duplicate_or_membership"
            },
            "difficulty": "introductory"
          },
          {
            "id": "alg-hms-complexity-n-hash-operations",
            "prompt": "An algorithm processes n fixed-width keys and performs two expected O(1) hash operations per key. It stores at most n keys. Classify expected total time and extra space.",
            "interaction": {
              "type": "complexity",
              "checkedDimensions": [
                "time",
                "extra_space"
              ],
              "availableValuesByDimension": {
                "time": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n log n)",
                  "O(n^2)"
                ],
                "extra_space": [
                  "O(1)",
                  "O(log n)",
                  "O(n)",
                  "O(n^2)"
                ]
              },
              "acceptedValuesByDimension": {
                "time": [
                  "O(n)"
                ],
                "extra_space": [
                  "O(n)"
                ]
              },
              "normalizedAliasesByDimension": {},
              "maxPoints": 2
            },
            "scoringContract": {
              "type": "complexity",
              "maxPoints": 2
            },
            "feedback": {
              "reason": "A constant expected amount of hash work is repeated n times, and retained state can grow with n.",
              "details": "Per-operation expected O(1) does not collapse the loop count. Two operations per element is still O(1) work per iteration, producing expected O(n) total time. The table may store n distinct keys, so extra space is O(n). This is the standard aggregate model for seen sets, frequency maps, and complement maps under fixed-width keys."
            },
            "taxonomy": {
              "primarySkillAtomId": "explain_expected_hash_lookup_complexity",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "seen_set",
              "problemArchetypeId": "detect_duplicate_or_membership"
            },
            "difficulty": "introductory",
            "constraints": [
              "Assume fixed-width keys and an ordinary well-distributed resizable hash table."
            ]
          },
          {
            "id": "alg-hms-complexity-resize-amortization",
            "prompt": "A resizable hash table occasionally rebuilds its storage, making one insertion cost O(n). Which conclusion is justified over a long sequence of insertions under its standard resizing policy?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "amortized_constant",
                  "text": "Insertions can still be amortized or expected O(1) because expensive rebuilds are spread across many operations."
                },
                {
                  "id": "every_insert_linear",
                  "text": "Every insertion is O(n) because some insertion triggers a rebuild."
                },
                {
                  "id": "rebuild_free",
                  "text": "Rebuilding costs O(1) because hashing is constant time."
                }
              ],
              "acceptedOptionIds": [
                "amortized_constant"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Occasional linear rebuilds are compatible with amortized constant insertion when the resizing schedule provides enough cheap operations between rebuilds.",
              "details": "Amortized analysis bounds the total cost of a sequence rather than each individual insertion. Geometric capacity growth typically makes the sum of all rebuild work linear in the number of insertions, yielding O(1) amortized insertion. This does not make the worst single insertion constant, and it still assumes the implementation follows the stated policy.",
              "wrongOptionExplanationsByOptionId": {
                "every_insert_linear": "A worst cost for an occasional operation does not imply that every operation pays that cost; amortized analysis distributes it across the sequence.",
                "rebuild_free": "Rebuilding must revisit and place existing entries, so its direct cost grows with the number of stored keys."
              }
            },
            "taxonomy": {
