              "problemArchetypeId": "compute_from_smaller_input"
            }
          },
          {
            "id": "recursion-basics-recursion-stack-and-complexity-terminating-chain-can-overflow",
            "prompt": "countdown(n) has a correct base n == 0 and calls countdown(n - 1). For a very large n on a runtime with a\nbounded call stack and no tail-call optimization, which conclusion is correct?",
            "constraints": [
              "n is finite and non-negative.",
              "The runtime stack is bounded.",
              "Tail-call optimization is not guaranteed."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "terminates_in_model_may_overflow",
                  "text": "The recurrence terminates mathematically, but execution may raise stack overflow before reaching the base."
                },
                {
                  "id": "base_guarantees_execution",
                  "text": "The base case guarantees successful execution for every finite n."
                },
                {
                  "id": "overflow_means_nonterminating",
                  "text": "A stack overflow proves the recursive transition does not make progress."
                },
                {
                  "id": "runtime_converts_to_loop",
                  "text": "The runtime must convert any one-call recursion into a loop."
                }
              ],
              "acceptedOptionIds": [
