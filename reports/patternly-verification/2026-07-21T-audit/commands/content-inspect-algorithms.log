        "items": [
          {
            "id": "alg-tree-boundary-empty-sum-and-maximum",
            "prompt": "Select all boundary contracts that preserve the stated meaning on an empty tree.",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "sum_is_zero",
                  "text": "A whole-tree sum returns `0`."
                },
                {
                  "id": "maximum_is_absent",
                  "text": "A whole-tree maximum returns an explicit no-result value such as `None` or an empty optional."
                },
                {
                  "id": "maximum_is_zero",
                  "text": "A whole-tree maximum always returns `0`."
                },
                {
                  "id": "size_is_one",
                  "text": "A whole-tree node count returns `1` for the missing root."
                }
              ],
              "acceptedOptionIds": [
                "sum_is_zero",
                "maximum_is_absent"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Empty input uses the identity of the requested operation when one exists; otherwise the API must represent absence rather than invent a value.",
              "details": "Addition has a neutral element, so zero is the natural sum of no nodes. Maximum over an empty set has no ordinary numeric value unless the domain and contract supply a safe sentinel, so an optional result states the absence precisely. Returning zero for maximum fails when all legal values are negative and confuses a real value with no result. Counting a missing root as one invents a node. Boundary behavior belongs to each query's output contract, not to a universal “null means zero” rule.",
              "wrongOptionExplanationsByOptionId": {
                "maximum_is_zero": "Zero is plausible as a familiar default, but it may exceed every actual negative value and is a valid payload. It is safe only when the value domain and API explicitly declare zero as a sentinel outside all legal results.",
                "size_is_one": "A null root represents zero nodes. Returning one would fit a different measure such as counting an external null marker, not node count."
              },
              "omittedCorrectExplanationsByOptionId": {
                "sum_is_zero": "Without the additive identity, callers need unnecessary special cases and a leaf recurrence will not compose cleanly.",
                "maximum_is_absent": "Without an absence representation, the function must fabricate a maximum for a set with no elements."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "handle_empty_and_leaf_boundaries",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "subtree_aggregation",
              "problemArchetypeId": "compute_subtree_property"
            },
            "difficulty": "foundational",
            "constraints": [
              "Node values may be negative, zero, or positive.",
              "The API may use an optional result type."
            ]
          },
          {
            "id": "alg-tree-boundary-leaf-definition",
            "prompt": "Under the standard binary-tree node contract used throughout this batch, which description correctly identifies a leaf node?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "no_children",
                  "text": "A non-null node whose left and right child references are both null."
                },
                {
                  "id": "at_least_one_missing",
                  "text": "Any non-null node with at least one null child."
                },
                {
                  "id": "null_reference",
                  "text": "The null reference reached after stepping past a node."
                },
                {
                  "id": "deepest_seen",
                  "text": "Whichever node happens to be deepest in the current DFS branch."
                }
              ],
              "acceptedOptionIds": [
                "no_children"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A leaf is an actual node with no children; a unary node remains internal, and null is missing structure rather than a node.",
              "details": "The definition is structural and independent of traversal history. A node with only one child still has a descendant and is not terminal. Null calls are useful base cases but do not become leaves. “Deepest seen” is an observation relative to one traversal and can change when another branch is explored. This boundary controls root-to-leaf path completion, leaf counts, and algorithms that apply work only at terminal nodes.",
              "wrongOptionExplanationsByOptionId": {
                "at_least_one_missing": "This is a common shortcut that wrongly classifies unary nodes as leaves. It becomes valid only under a nonstandard contract that defines terminality by a missing designated edge.",
                "null_reference": "Null marks the absence of a node. Some edge-based recurrences process null markers, but they must not call those markers leaves without redefining the model.",
                "deepest_seen": "Depth does not define leaf status; an internal node can be deeper than a leaf in another branch. This could identify a current traversal maximum, not a structural category."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "handle_empty_and_leaf_boundaries",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "path_accumulation",
              "problemArchetypeId": "root_to_leaf_path"
            },
            "difficulty": "foundational"
          },
          {
            "id": "alg-tree-boundary-single-node-order-collapse",
            "prompt": "A tree contains exactly one node with value `8`. Which statement about its standard traversals is correct?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "all_emit_singleton",
                  "text": "Preorder, inorder, and postorder all emit `[8]`, while level order emits one level containing `8`."
                },
                {
                  "id": "preorder_only",
                  "text": "Only preorder emits the node because the other traversals require children."
                },
                {
                  "id": "orders_are_globally_equivalent",
                  "text": "Because the orders agree here, traversal order is irrelevant for every tree."
                },
                {
                  "id": "bfs_empty",
                  "text": "Level order returns no levels because the root has no children."
                }
              ],
              "acceptedOptionIds": [
                "all_emit_singleton"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With no child operations to interleave, all DFS action positions collapse to the same one-node sequence, but that boundary case does not erase their differences on larger trees.",
              "details": "Each standard traversal processes every real node once. On a singleton, the left and right subtree calls are empty, so placing the current action before, between, or after them yields the same visible value. BFS has a nonempty root frontier and therefore one level. This is a useful test boundary because an implementation can pass it while still ordering larger trees incorrectly; tests must include a node with both child structure and observable ordering.",
              "wrongOptionExplanationsByOptionId": {
                "preorder_only": "Inorder and postorder do not require non-null children; their empty child calls simply contribute no values. All three still process the current node.",
                "orders_are_globally_equivalent": "Agreement on a degenerate input does not prove semantic equivalence. The orders diverge as soon as child and parent actions can be interleaved.",
                "bfs_empty": "A root is itself a level even when it has no children. Empty level order applies only to a null root."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "handle_empty_and_leaf_boundaries",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "dfs_inorder",
              "problemArchetypeId": "traverse_tree"
            },
            "difficulty": "foundational",
            "constraints": [
              "All traversals visit actual nodes and omit null markers."
            ]
          },
          {
            "id": "alg-tree-boundary-skewed-recursion-depth",
            "prompt": "A recursive DFS is linear-time on every proper tree. What additional boundary must be considered for a tree shaped as a chain of `n` nodes?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "depth_n_stack",
                  "text": "The recursion depth becomes `n`, so auxiliary stack use is `O(n)` and may exceed the runtime's call-stack limit."
                },
                {
                  "id": "time_exponential",
                  "text": "The traversal becomes exponential because every node has one child."
                },
                {
                  "id": "global_list_fixes_depth",
                  "text": "Moving the output to a global list makes recursion depth constant."
                },
                {
                  "id": "visited_set_balances_tree",
                  "text": "Adding a visited set reduces the recursion depth to `O(log n)`."
                }
              ],
              "acceptedOptionIds": [
                "depth_n_stack"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Linear node visits do not bound recursion depth; a skewed tree has height `n` and keeps one frame per node on the active path.",
              "details": "Tree shape controls `h`, the maximum live recursive chain. A balanced tree has logarithmic height, but a chain has `h = n`, so a correct `O(n)` DFS can still overflow a bounded language stack. An explicit stack moves storage to the heap but remains `O(n)` for the chain. Global output state and visited state do not change structural height. The practical boundary may motivate an iterative implementation even when asymptotic time is already optimal.",
              "wrongOptionExplanationsByOptionId": {
                "time_exponential": "Each node still has only one recursive child call and is visited once, so time remains linear. Exponential growth requires repeated branching or recomputation.",
                "global_list_fixes_depth": "Output location does not remove active recursive calls or shorten the root-to-leaf chain. It can change state ownership, but the call-stack depth remains proportional to tree height.",
                "visited_set_balances_tree": "Visited state prevents revisits in graphs; it does not change the tree's shape or execution path length."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "handle_empty_and_leaf_boundaries",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "dfs_preorder",
              "problemArchetypeId": "traverse_tree"
            },
            "difficulty": "intermediate",
            "constraints": [
              "Each node is visited exactly once.",
              "The language runtime has a finite call-stack limit."
            ]
          },
          {
            "id": "alg-tree-boundary-duplicate-values-are-distinct-nodes",
            "prompt": "A proper binary tree contains two different nodes whose values are both `4`. Which traversal policy preserves the tree correctly?",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "visit_both_by_identity",
                  "text": "Visit both nodes; equal payload values do not merge their identities."
                },
                {
                  "id": "skip_second_value",
                  "text": "Treat the second `4` as already visited and skip its subtree."
                },
                {
                  "id": "merge_subtrees",
                  "text": "Combine the two nodes into one logical node because their values match."
                },
                {
                  "id": "add_graph_visited_by_value",
                  "text": "Use a value-based visited set, as graph DFS would."
                }
              ],
              "acceptedOptionIds": [
                "visit_both_by_identity"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Tree nodes are structural identities, while values are payload; duplicate values remain separate positions and must both be traversed.",
              "details": "A proper tree already guarantees one structural route to each node, so no visited set is needed. Even when a graph requires visited state, it is normally keyed by vertex identity, not payload value. Skipping or merging equal values changes node count, topology, and any subtree below the skipped node. Value-based deduplication is valid only when the problem explicitly defines values as unique identifiers and duplicates as aliases, which is not the standard tree contract.",
              "wrongOptionExplanationsByOptionId": {
                "skip_second_value": "This confuses equality with identity and loses a real node and its descendants. It is valid only under an explicit deduplication-by-key data model.",
                "merge_subtrees": "Equal payloads do not imply equal child structure or ownership. Merging mutates the represented tree into another graph.",
                "add_graph_visited_by_value": "Graph traversal uses identity-based discovery because values may repeat. Adding a value-based set imports the wrong graph rule and is unnecessary for a proper tree."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "handle_empty_and_leaf_boundaries",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "dfs_preorder",
              "problemArchetypeId": "traverse_tree"
            },
            "difficulty": "foundational",
            "constraints": [
              "Node values are not unique identifiers.",
              "The input satisfies proper-tree structure."
            ]
          }
