          {
            "id": "alg-mg-geometry-determinant-overflow-diagnostic",
            "prompt": "An orientation test returns inconsistent signs for large signed integer coordinates. The code subtracts and multiplies in the input type. What is the first diagnostic question?",
            "constraints": [
              "The mathematical formula is otherwise correct."
            ],
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "check_full_intermediate_range",
