            },
            {
              "id": "all_counts",
              "text": "Compute all value counts when either arbitrary or ordered output can be produced."
            },
            {
              "id": "unique_values",
              "text": "Return the set of distinct values when output ordering is flexible."
            },
            {
              "id": "first_repeat_stream",
              "text": "Return the first repeated arrival before the stream ends."
