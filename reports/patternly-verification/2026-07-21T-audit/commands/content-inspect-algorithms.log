      {
        "id": "alg-contrast-hash-sort-lookup-002",
        "prompt": "A report must list all distinct values in ascending order and combine equal values into adjacent groups. Which signal favors sorting?",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "single",
          "options": [
            {
              "id": "ordered_groups",
              "text": "The output requires deterministic value order and equal-run adjacency."
            },
            {
              "id": "hash_expected",
              "text": "Hash lookup is expected O(1), so ordering requirements can be ignored."
            },
            {
              "id": "one_pass_name",
              "text": "The implementation should contain one loop."
            },
            {
              "id": "first_seen_only",
              "text": "Only first-seen membership matters."
            }
          ],
          "acceptedOptionIds": [
            "ordered_groups"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "Sorting directly creates the adjacency and order consumed by the result.",
          "details": "A hash map could count values, but a later key sort would reintroduce ordering cost and should be included in the strategy comparison.",
