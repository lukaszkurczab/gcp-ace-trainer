          {
            "id": "alg-bits-representation-001",
            "prompt": "In an 8-bit unsigned integer, what place value does bit position 5 represent when bit positions are numbered from 0 at the least significant bit?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_32",
                  "text": "32."
                },
                {
                  "id": "value_5",
                  "text": "5."
                },
                {
                  "id": "value_16",
                  "text": "16."
                },
                {
                  "id": "value_64",
                  "text": "64."
                }
              ],
              "acceptedOptionIds": [
                "value_32"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Bit position k contributes 2^k when it is set.",
              "details": "With zero-based positions, bit 5 represents 2^5 = 32.",
              "wrongOptionExplanationsByOptionId": {
                "value_5": "The bit index is an exponent, not the represented value.",
                "value_16": "16 is the place value of bit position 4.",
                "value_64": "64 is the place value of bit position 6."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "interpret_integer_bit_representation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-representation-002",
            "prompt": "What unsigned decimal value is represented by the 8-bit pattern 10110010?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_178",
                  "text": "178."
                },
                {
                  "id": "value_77",
                  "text": "77."
                },
                {
                  "id": "value_82",
                  "text": "82."
                },
                {
                  "id": "value_210",
                  "text": "210."
                }
              ],
              "acceptedOptionIds": [
                "value_178"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The set bits contribute 128 + 32 + 16 + 2.",
              "details": "Adding the place values gives 178.",
              "wrongOptionExplanationsByOptionId": {
                "value_77": "77 is not the sum of the set-bit place values.",
                "value_82": "This omits the highest set bit's contribution.",
                "value_210": "This corresponds to a different set of bit positions."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "interpret_integer_bit_representation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            }
          },
          {
            "id": "alg-bits-representation-003",
            "prompt": "Under 8-bit two's-complement interpretation, what signed value is represented by 10110010?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "value_minus_78",
                  "text": "-78."
                },
                {
                  "id": "value_178",
                  "text": "178."
                },
                {
                  "id": "value_minus_77",
                  "text": "-77."
                },
                {
                  "id": "value_82",
                  "text": "82."
                }
              ],
              "acceptedOptionIds": [
                "value_minus_78"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The same bit pattern can have different signed and unsigned interpretations.",
              "details": "For an 8-bit two's-complement value with the sign bit set, subtract 2^8 from the unsigned value: 178 - 256 = -78.",
              "wrongOptionExplanationsByOptionId": {
                "value_178": "178 is the unsigned interpretation of the same bits.",
                "value_minus_77": "The two's-complement value is unsignedValue - 256 = 178 - 256.",
                "value_82": "The leading one makes the fixed-width signed value negative."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "interpret_integer_bit_representation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Use exactly 8 bits and two's-complement signed interpretation."
            ]
          },
          {
            "id": "alg-bits-representation-004",
            "prompt": "Which bit is the sign bit in an 8-bit two's-complement integer?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bit_7",
                  "text": "Bit position 7."
                },
                {
                  "id": "bit_0",
                  "text": "Bit position 0."
                },
                {
                  "id": "bit_8",
                  "text": "Bit position 8."
                },
                {
                  "id": "bit_6",
                  "text": "Bit position 6."
                }
              ],
              "acceptedOptionIds": [
                "bit_7"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The most significant bit is the sign bit in fixed-width two's complement.",
              "details": "An 8-bit word has positions 0 through 7, so position 7 determines whether the signed interpretation is negative.",
              "wrongOptionExplanationsByOptionId": {
                "bit_0": "Bit 0 is the least significant value bit.",
                "bit_8": "An 8-bit value has positions 0 through 7.",
                "bit_6": "Bit 6 contributes 64 but is not the sign position."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "interpret_integer_bit_representation",
