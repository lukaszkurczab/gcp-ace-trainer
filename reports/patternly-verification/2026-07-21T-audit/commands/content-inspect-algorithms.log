        "items": [
          {
            "id": "alg-contrast-window-prefix-positive-001",
            "prompt": "All values are positive, and the task asks for the minimum-length contiguous interval with sum at least target. Which invariant supports a variable window?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "shrink_valid",
                  "text": "After right makes the window valid, repeatedly move left while validity remains, recording each shortest valid candidate."
                },
                {
                  "id": "shrink_invalid",
                  "text": "Move left whenever the sum is below target."
                },
                {
                  "id": "expand_valid_forever",
                  "text": "Never shrink after reaching target."
                },
                {
                  "id": "prefix_only",
                  "text": "Positive values forbid sliding windows."
                }
              ],
              "acceptedOptionIds": [
                "shrink_valid"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "With positive values, expansion strictly increases sum and shrinking strictly decreases it.",
              "details": "Once valid, removing left explores shorter candidates until the next removal would break validity.",
              "wrongOptionExplanationsByOptionId": {
                "shrink_invalid": "Removing a positive value cannot repair an insufficient sum.",
                "expand_valid_forever": "That misses shorter valid intervals.",
                "prefix_only": "They provide the monotonicity the window needs."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-002",
            "prompt": "All values are nonnegative, and the task asks for the longest interval with sum at most budget. Which rule is natural?",
            "difficulty": "intro",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "shrink_over_budget",
                  "text": "Expand right; while sum exceeds budget, move left; record the valid length afterward."
                },
                {
                  "id": "shrink_under_budget",
                  "text": "Shrink while sum is below budget."
                },
                {
                  "id": "stop_first_valid",
                  "text": "Stop at the first valid interval."
                },
                {
                  "id": "exact_prefix_only",
                  "text": "Use exact-sum prefix lookup because the objective is at most."
                }
              ],
              "acceptedOptionIds": [
                "shrink_over_budget"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Expansion cannot decrease the sum, so an over-budget interval remains over budget until enough left values are removed.",
              "details": "After restoring validity, the current interval is the longest ending at right under this process.",
              "wrongOptionExplanationsByOptionId": {
                "shrink_under_budget": "That throws away valid candidates without necessity.",
                "stop_first_valid": "Longer valid intervals may appear later.",
                "exact_prefix_only": "The threshold and nonnegative values give a monotone window."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-003",
            "prompt": "Why do positive values create a legal discard rule for a minimum-sum-threshold window?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "directional_effect",
                  "text": "Any further right extension can only increase sum, and removing left can only decrease it."
                },
                {
                  "id": "prefix_equal",
                  "text": "All prefix sums become equal."
                },
                {
                  "id": "indices_monotonic",
                  "text": "Indices are ordered in every array."
                },
                {
                  "id": "target_sorted",
                  "text": "The target is numerically sorted."
                }
              ],
              "acceptedOptionIds": [
                "directional_effect"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The sign constraint links each boundary move to a known aggregate direction.",
              "details": "That implication is the proof that skipped shorter or earlier intervals cannot later become better in the forbidden direction.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_equal": "They become strictly increasing.",
                "indices_monotonic": "Index order alone says nothing about sum direction.",
                "target_sorted": "A scalar target has no sort order role."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-004",
            "prompt": "Zeros are allowed in a nonnegative minimum-length sum-at-least-target problem. Which statement is correct?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "plateau_care",
                  "text": "The window remains monotone, but zero removals may leave the sum unchanged, so the loop must still advance boundaries and test shorter candidates."
                },
                {
                  "id": "zero_breaks",
                  "text": "Any zero invalidates the window method."
                },
                {
                  "id": "strict_increase",
                  "text": "Every right expansion strictly increases sum."
                },
                {
                  "id": "prefix_required",
                  "text": "Prefix hashing is the only correct strategy."
                }
              ],
              "acceptedOptionIds": [
                "plateau_care"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Nonnegative values preserve nondecreasing expansion and nonincreasing shrinkage.",
              "details": "Zeros affect strictness, not the directional invariant.",
              "wrongOptionExplanationsByOptionId": {
                "zero_breaks": "Zero does not reverse sum direction.",
                "strict_increase": "Adding zero creates a plateau.",
                "prefix_required": "The threshold window remains legal."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-005",
            "prompt": "For positive values, when should a minimum-length sum-at-least-target algorithm record an answer?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "before_each_shrink",
                  "text": "Whenever the current window is valid, before removing its left value, and again while validity continues."
                },
                {
                  "id": "only_end",
                  "text": "Only after the entire array is processed."
                },
                {
                  "id": "only_invalid",
                  "text": "Only when the sum drops below target."
                },
                {
                  "id": "first_valid_only",
                  "text": "Only the first time any window reaches target."
                }
              ],
              "acceptedOptionIds": [
                "before_each_shrink"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Every valid state in the shrink loop is a candidate.",
              "details": "Recording before the next removal preserves the shortest valid interval found at that right boundary.",
              "wrongOptionExplanationsByOptionId": {
                "only_end": "The best interval may have been valid earlier and then discarded.",
                "only_invalid": "That state is not a valid answer.",
                "first_valid_only": "Later windows may be shorter."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-006",
            "prompt": "For nonnegative values, an exact-sum-k existence problem is considered. Which conclusion is accurate?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "window_can_work",
                  "text": "A carefully defined variable window can work because sum movement is monotone, although zeros and equality handling need explicit rules."
                },
                {
                  "id": "prefix_only",
                  "text": "Exact equality always forbids a window."
                },
                {
                  "id": "window_always_any_sign",
                  "text": "The same rule works unchanged for arbitrary negative values."
                },
                {
                  "id": "sort_two_pointer",
                  "text": "Sort the values and use opposite ends."
                }
              ],
              "acceptedOptionIds": [
                "window_can_work"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Objective semantics and value constraints jointly decide the method.",
              "details": "Prefix-hash state is more general for arbitrary signs, but exact equality is not itself enough to ban a window under nonnegative values.",
              "wrongOptionExplanationsByOptionId": {
                "prefix_only": "Nonnegative values can support an equality window.",
                "window_always_any_sign": "Mixed signs destroy monotonicity.",
                "sort_two_pointer": "Sorting loses contiguity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-007",
            "prompt": "The target is zero and all values are strictly positive. What should a non-empty minimum-length sum-at-least-target contract decide?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "first_singleton",
                  "text": "Every non-empty interval is valid, so the minimum length is 1 if the array is non-empty."
                },
                {
                  "id": "zero_length",
                  "text": "Return length 0 even though empty intervals are forbidden."
                },
                {
                  "id": "no_answer",
                  "text": "No positive sum can be at least zero."
                },
                {
                  "id": "prefix_hash",
                  "text": "Only a prefix-frequency map can answer."
                }
              ],
              "acceptedOptionIds": [
                "first_singleton"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Edge-case behavior depends on whether empty intervals are allowed.",
              "details": "For non-empty intervals and positive values, any singleton satisfies a nonpositive threshold.",
              "wrongOptionExplanationsByOptionId": {
                "zero_length": "The result contract excludes the empty interval.",
                "no_answer": "Every positive sum is at least zero.",
                "prefix_hash": "The boundary is trivial under the stated contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-008",
            "prompt": "No interval reaches a positive target in a positive-valued array. What should the window algorithm return?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "explicit_none",
                  "text": "The contract's explicit no-solution result after scanning all right boundaries."
                },
                {
                  "id": "last_window",
                  "text": "The final interval even though it is invalid."
                },
                {
                  "id": "zero_without_contract",
                  "text": "Always zero regardless of the API contract."
                },
                {
                  "id": "prefix_sum_total",
                  "text": "The total array sum as a length."
                }
              ],
              "acceptedOptionIds": [
                "explicit_none"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Monotonicity makes the search complete, not guaranteed to succeed.",
              "details": "The public result contract must define absence explicitly.",
              "wrongOptionExplanationsByOptionId": {
                "last_window": "A result must satisfy the threshold.",
                "zero_without_contract": "Sentinel behavior must be declared.",
                "prefix_sum_total": "Sum and length are different result types."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-009",
            "prompt": "Which change destroys the positive monotonic boundary most directly?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "allow_negative",
                  "text": "Allow arbitrary negative values."
                },
                {
                  "id": "larger_target",
                  "text": "Increase the target while values remain nonnegative."
                },
                {
                  "id": "more_elements",
                  "text": "Increase n."
                },
                {
                  "id": "use_long_integer",
                  "text": "Use a wider numeric type."
                }
              ],
              "acceptedOptionIds": [
                "allow_negative"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A negative incoming or outgoing value can reverse the aggregate effect of a boundary move.",
              "details": "That removes the simple discard implication.",
              "wrongOptionExplanationsByOptionId": {
                "larger_target": "The same directional invariant holds.",
                "more_elements": "Input size affects work, not legality.",
                "use_long_integer": "That can improve overflow safety without changing monotonicity."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-010",
            "prompt": "Which facts justify a positive or nonnegative threshold window? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "expand_direction",
                  "text": "Adding the next value cannot decrease the sum."
                },
                {
                  "id": "shrink_direction",
                  "text": "Removing the left value cannot increase the sum."
                },
                {
                  "id": "contiguous_objective",
                  "text": "The candidate is one contiguous interval with movable boundaries."
                },
                {
                  "id": "target_keyword",
                  "text": "The prompt contains the word target."
                }
              ],
              "acceptedOptionIds": [
                "expand_direction",
                "shrink_direction",
                "contiguous_objective"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The method needs both a matching interval search space and directional aggregate effects.",
              "details": "Target vocabulary alone is insufficient.",
              "wrongOptionExplanationsByOptionId": {
                "target_keyword": "A keyword does not establish monotonicity."
              },
              "omittedCorrectExplanationsByOptionId": {
                "expand_direction": "Expansion has a known direction.",
                "shrink_direction": "Shrinkage has a known direction.",
                "contiguous_objective": "The state matches the search space."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-011",
            "prompt": "Which objectives naturally fit a nonnegative variable window? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "min_at_least",
                  "text": "Minimum length with sum at least target."
                },
                {
                  "id": "max_at_most",
                  "text": "Maximum length with sum at most budget."
                },
                {
                  "id": "exact_nonnegative",
                  "text": "Existence of exact sum k with carefully handled zeros."
                },
                {
                  "id": "arbitrary_signed_exact",
                  "text": "Exact sum k with arbitrary signed values using the same simple rule."
                }
              ],
              "acceptedOptionIds": [
                "min_at_least",
                "max_at_most",
                "exact_nonnegative"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The objective must align with the direction supplied by nonnegative values.",
              "details": "The same template does not transfer to arbitrary signs.",
              "wrongOptionExplanationsByOptionId": {
                "arbitrary_signed_exact": "Mixed signs break the boundary."
              },
              "omittedCorrectExplanationsByOptionId": {
                "min_at_least": "Shrink while valid to minimize.",
                "max_at_most": "Shrink only when invalid and record restored windows.",
                "exact_nonnegative": "Monotone sum movement can support equality."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-012",
            "prompt": "Which edge cases require explicit loop or result rules? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "zeros",
                  "text": "Zeros that leave the sum unchanged while a boundary moves."
                },
                {
                  "id": "no_solution",
                  "text": "No valid interval."
                },
                {
                  "id": "target_nonpositive",
                  "text": "A nonpositive threshold when empty intervals may or may not be legal."
                },
                {
                  "id": "positive_middle",
                  "text": "Only one ordinary case with a unique middle answer."
                }
              ],
              "acceptedOptionIds": [
                "zeros",
                "no_solution",
                "target_nonpositive"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Monotone correctness does not remove API and loop-boundary decisions.",
              "details": "These cases expose hidden empty-window and progress assumptions.",
              "wrongOptionExplanationsByOptionId": {
                "positive_middle": "This does not cover boundary semantics."
              },
              "omittedCorrectExplanationsByOptionId": {
                "zeros": "They test strict versus non-strict conditions.",
                "no_solution": "The absence sentinel must be defined.",
                "target_nonpositive": "The result depends on the interval contract."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-013",
            "prompt": "Which mistaken claims bypass the monotonic-window proof? Select all that apply.",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "multiple",
              "options": [
                {
                  "id": "contiguous_always",
                  "text": "Every contiguous-sum problem supports a simple window."
                },
                {
                  "id": "two_pointers_proof",
                  "text": "Using left and right variables proves safe elimination."
                },
                {
                  "id": "positive_boundary",
                  "text": "Nonnegative values can create monotone sum movement."
                },
                {
                  "id": "first_valid_best",
                  "text": "The first valid threshold interval is always globally shortest."
                }
              ],
              "acceptedOptionIds": [
                "contiguous_always",
                "two_pointers_proof",
                "first_valid_best"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "A correct window argument must name the monotone effect and complete answer search.",
              "details": "Nonnegative monotonicity is real evidence, not a heuristic.",
              "wrongOptionExplanationsByOptionId": {
                "positive_boundary": "This is a valid condition."
              },
              "omittedCorrectExplanationsByOptionId": {
                "contiguous_always": "Value signs and objective semantics matter.",
                "two_pointers_proof": "The directional invariant is the proof.",
                "first_valid_best": "Later right boundaries may produce shorter valid intervals."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-014",
            "prompt": "Sequence the minimization pass for a positive sum-at-least window.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "extend",
                  "text": "Add a[right] as right advances."
                },
                {
                  "id": "check_valid",
                  "text": "While the sum is at least target, the current window is a candidate."
                },
                {
                  "id": "record",
                  "text": "Record its length against the best answer."
                },
                {
                  "id": "shrink",
                  "text": "Subtract a[left], increment left, and continue while still valid."
                }
              ],
              "canonicalOrder": [
                "extend",
                "check_valid",
                "record",
                "shrink"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The shrink loop enumerates all shortest candidates ending at each right boundary.",
              "details": "Recording before removal prevents losing the current valid interval."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-015",
            "prompt": "Sequence the repair-and-measure pass for a nonnegative sum-at-most window.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "extend",
                  "text": "Add the new right value."
                },
                {
                  "id": "repair",
                  "text": "While the sum exceeds budget, subtract left values and advance left."
                },
                {
                  "id": "valid_state",
                  "text": "Once the sum is at most budget, the current window is valid."
                },
                {
                  "id": "record",
                  "text": "Update the maximum length with right - left + 1."
                }
              ],
              "canonicalOrder": [
                "extend",
                "repair",
                "valid_state",
                "record"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "For nonnegative values, shrinking is the only way to repair an over-budget interval.",
              "details": "The restored interval is the longest valid one ending at the current right under this scan."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-016",
            "prompt": "Arrange the correctness proof for the shrink step in a minimum-length positive window.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "positive_left",
                  "text": "The outgoing left value is positive or nonnegative."
                },
                {
                  "id": "sum_direction",
                  "text": "Removing it cannot increase the sum."
                },
                {
                  "id": "candidate_order",
                  "text": "Each shrink produces a strictly shorter interval at the same right boundary."
                },
                {
                  "id": "stop_rule",
                  "text": "When the next state is invalid, further shrinking cannot restore threshold validity."
                }
              ],
              "canonicalOrder": [
                "positive_left",
                "sum_direction",
                "candidate_order",
                "stop_rule"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The stop rule follows from monotone contraction.",
              "details": "Without the sign condition, an invalid shorter state could become valid after removing a negative value."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-017",
            "prompt": "Arrange the zero-aware review of a nonnegative window.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "use_non_strict",
                  "text": "State that aggregate movement is nondecreasing or nonincreasing, not necessarily strict."
                },
                {
                  "id": "ensure_pointer_progress",
                  "text": "Ensure every loop iteration changes a boundary even when sum stays equal."
                },
                {
                  "id": "record_equal_states",
                  "text": "Evaluate shorter or longer equal-sum windows according to the objective."
                },
                {
                  "id": "test_zero_runs",
                  "text": "Test leading, trailing, and interior zero runs."
                }
              ],
              "canonicalOrder": [
                "use_non_strict",
                "ensure_pointer_progress",
                "record_equal_states",
                "test_zero_runs"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "Zeros preserve legality but expose stalled or prematurely stopped loops.",
              "details": "Boundary progress and answer timing must be tested separately from sum change."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-window-prefix-positive-018",
            "prompt": "Arrange the decision audit before applying a threshold window.",
            "difficulty": "foundational",
            "interaction": {
              "type": "ordering",
              "elements": [
                {
                  "id": "state_objective",
                  "text": "State minimum/maximum and at-least/at-most semantics."
                },
                {
                  "id": "state_values",
                  "text": "State whether values are positive, nonnegative, or arbitrary signed."
                },
                {
                  "id": "derive_moves",
                  "text": "Derive the aggregate effect of expanding and shrinking."
                },
                {
                  "id": "select",
                  "text": "Use the window only if those effects justify every discard and stopping rule."
                }
              ],
              "canonicalOrder": [
                "state_objective",
                "state_values",
                "derive_moves",
                "select"
              ],
              "scoringMethod": "adjacent_relations"
            },
            "scoringContract": {
              "type": "ordering",
              "maxPoints": 3
            },
            "feedback": {
              "reason": "The template is derived from objective and value domain.",
              "details": "Contiguity is necessary but not sufficient."
            },
            "taxonomy": {
              "primarySkillAtomId": "identify_positive_monotonic_window_boundary",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
