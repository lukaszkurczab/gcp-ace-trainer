        "items": [
          {
            "id": "ssc-transfer-ledger-interval-totals",
            "prompt": "A finance tool stores one immutable daily net-flow value for a year and must answer thousands of questions such as 'What was the total flow from day l through day r?' Which prior strategy decision transfers most directly?",
            "constraints": [
              "Daily values are immutable.",
              "Queries are numerous.",
              "Each query asks for an additive date interval."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "hash_dates",
                  "text": "Store each date in a hash set and use exact date membership as the reusable operation for computing every requested interval total."
                },
                {
                  "id": "prefix_transfer",
                  "text": "Treat days as a static sequence, build cumulative totals once, and recover each interval by subtracting two prefixes."
                },
                {
                  "id": "sort_transactions",
                  "text": "Sort the daily totals by value, then answer each requested date interval from the corresponding segment of the sorted sequence."
                }
              ],
              "acceptedOptionIds": [
                "prefix_transfer"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The decisive structure is a static additive range query, independent of the finance vocabulary. Cumulative state supports repeated interval totals.",
              "details": "The surface form uses days and cash flow, but the decision contract is the same as an immutable array with many additive range queries. A prefix total preserves the sum of every leading interval, and subtraction cancels the shared earlier days. Sorting would destroy calendar contiguity, while a set answers presence rather than an aggregate. The transfer boundary is that updates, non-additive queries, or output requiring individual transactions would change the mechanism. The general rule is to map the new story to structure, operation, and lifecycle before reusing a strategy.",
              "wrongOptionExplanationsByOptionId": {
                "sort_transactions": "Ordering by value breaks the date interval that defines each query. Sorting becomes relevant only for value-rank or threshold questions that do not depend on original chronology.",
                "hash_dates": "A date set can answer whether a day exists, but not the sum over a range. It becomes useful if the query primitive changes to exact membership."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_strategy_selection_to_new_surface_form",
              "secondarySkillAtomIds": [],
              "learningStage": "strategy_selection"
            }
          },
          {
            "id": "ssc-transfer-badge-stream-duplicate",
            "prompt": "A venue receives badge IDs one at a time and must immediately flag an ID that has appeared earlier in the same event. Which strategy-selection rule transfers?",
            "constraints": [
              "Badge IDs arrive one at a time.",
              "The answer is required immediately.",
              "The question is exact, not approximate."
            ],
            "difficulty": "introductory",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_at_close",
                  "text": "Wait until the event ends, sort all IDs, and then report duplicates."
                },
                {
                  "id": "two_end_badges",
                  "text": "Keep pointers at the first and latest badge because two pointers work on sequences."
                },
                {
                  "id": "incremental_membership",
                  "text": "Maintain a set of previously seen IDs and test membership before insertion."
                }
              ],
              "acceptedOptionIds": [
                "incremental_membership"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The underlying contract is online exact membership over a growing prefix. Retained seen-state supports the required answer time.",
              "details": "Badge IDs are merely keys. The decisive signals are that input arrives incrementally, an answer is required before future data is known, and prior membership is the complete query primitive. A set stores exactly the state needed to detect repetition. End-of-event sorting could answer an offline audit but misses immediate alerts, and pointer placement has no ordered discard rule. The transfer boundary is memory or expiration: a bounded recent-history rule would require state eviction, while approximate membership would require an explicitly relaxed correctness contract.",
              "wrongOptionExplanationsByOptionId": {
                "sort_at_close": "This is a legal offline audit candidate but violates the immediate-answer timing. It becomes appropriate when alerts may be delayed until the full event log is available.",
                "two_end_badges": "A sequence alone does not supply the ordering invariant needed for pointer elimination. Two pointers become useful only after an ordered relation or window contract is established."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_strategy_selection_to_new_surface_form",
              "secondarySkillAtomIds": [],
              "learningStage": "strategy_selection"
            }
          },
          {
            "id": "ssc-transfer-minimum-machine-speed",
            "prompt": "A production line must choose the minimum integer machine speed that completes all jobs before a deadline. A deterministic check can decide whether a proposed speed is sufficient. Which strategy-selection rule transfers?",
            "constraints": [
              "Speed is an integer in a known bounded range.",
              "Feasibility can be checked for a proposed speed.",
              "Greater speed never reduces completed work."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_jobs_only",
                  "text": "Sort jobs by duration; sorting alone always reveals the minimum speed."
                },
                {
                  "id": "binary_feasibility",
                  "text": "Prove that any speed above a feasible speed is also feasible, then binary-search the first feasible speed."
                },
                {
                  "id": "hash_speeds",
                  "text": "Insert tried speeds into a set and choose the smallest stored value."
                }
              ],
              "acceptedOptionIds": [
                "binary_feasibility"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "The unfamiliar surface still exposes an ordered answer domain and a monotonic feasibility predicate, which is the decision boundary for binary search on answer.",
              "details": "The target is not an existing element but the smallest parameter satisfying a constraint. If increasing speed cannot make completion harder, feasibility is upward-closed: insufficient speeds form a prefix and sufficient speeds a suffix. That boundary licenses half discard, while the total cost is logarithmic in the speed range times the check cost. Sorting jobs may be part of the feasibility check but does not by itself search the speed domain. The transfer boundary is nonmonotonic behaviour, such as speeds that introduce failures or discrete modes where faster can become infeasible.",
              "wrongOptionExplanationsByOptionId": {
                "sort_jobs_only": "Job ordering may help evaluate one candidate speed, but it does not locate the minimum parameter without a search or derivation. It becomes complete only if a proof directly computes the optimum after sorting.",
                "hash_speeds": "A set records which speeds were tried but provides no rule for choosing informative trials or proving untried values impossible. It becomes relevant only as memoization inside another search."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "transfer_strategy_selection_to_new_surface_form",
              "secondarySkillAtomIds": [],
              "learningStage": "strategy_selection"
            }
          },
          {
            "id": "ssc-transfer-advertising-budget-window",
            "prompt": "Daily advertising costs are nonnegative. A campaign planner wants the longest consecutive run whose total cost is at most B. Which strategy-selection rule transfers, and what boundary must be remembered?",
            "constraints": [
              "Costs are nonnegative.",
              "The selected days must be consecutive.",
              "The goal is maximum length under total cost B."
            ],
            "difficulty": "intermediate",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "sort_days",
                  "text": "Sort days from cheapest to most expensive, then choose the longest affordable prefix and treat those selected days as the campaign run."
                },
                {
                  "id": "prefix_always",
                  "text": "Use prefix sums because consecutive-range tasks are solved by cumulative totals, and query-time arithmetic will reveal the longest affordable run."
                },
                {
                  "id": "window_nonnegative",
                  "text": "Use a variable window because expanding cannot reduce cost and shrinking cannot increase it; negative rebates would break this movement rule."
                }
              ],
              "acceptedOptionIds": [
                "window_nonnegative"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Nonnegative contributions make window validity repairable by forward boundary movement. The transfer depends on that sign constraint, not on the advertising vocabulary.",
