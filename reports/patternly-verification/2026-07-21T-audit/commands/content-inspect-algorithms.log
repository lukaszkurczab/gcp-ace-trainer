              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Minimal state can keep the same field names in every frame while their values identify different subproblems.",
              "details": "Recursive state has two levels: its shape, such as one integer field, and its value in a particular frame. Self-similarity normally preserves the shape because each call solves the same kind of problem. Progress changes the value. Here n uniquely determines the remaining number of decrements, so adding a call counter or original input would be redundant. This distinction transfers broadly: identical parameter lists are expected; identical parameter values are suspicious when a strict progress measure should change.",
              "wrongOptionExplanationsByOptionId": {
                "identical_state_each_call": "A parameter name defines the schema, not its runtime value. States n = 4 and n = 3 identify different remaining subproblems.",
                "add_call_number": "The changing n already distinguishes the subproblems and determines the remaining distance. A call number is derivable from the starting value and current n and adds no answer-relevant information.",
                "copy_original_n": "The return value depends only on the current distance n. The original start is ancestor history and is unnecessary under the stated contract."
              }
            },
            "taxonomy": {
