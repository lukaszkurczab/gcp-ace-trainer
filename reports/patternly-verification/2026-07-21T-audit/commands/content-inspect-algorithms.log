      {
        "id": "alg-arrays-frequency-state-013",
        "prompt": "Which statements describe a correct exact-frequency invariant during a left-to-right scan? Select all that apply.",
        "difficulty": "foundational",
        "interaction": {
          "type": "choice",
          "selectionMode": "multiple",
          "options": [
            {
              "id": "processed_prefix_count",
              "text": "After processing a prefix, count[x] equals the number of occurrences of x in that prefix."
            },
            {
              "id": "missing_means_zero",
              "text": "Before a value is first seen, its logical count is zero."
            },
            {
              "id": "increment_once",
              "text": "Each processed occurrence increments exactly one counter once."
            },
            {
              "id": "reset_on_change",
              "text": "The count of the previous value must reset whenever the current value changes."
            }
          ],
          "acceptedOptionIds": [
            "processed_prefix_count",
            "missing_means_zero",
            "increment_once"
          ]
        },
        "scoringContract": {
          "type": "choice",
          "resultSemantics": "exact_selected_set_with_partial_v1"
        },
        "feedback": {
          "reason": "Exact frequencies are maintained as cumulative counts over the processed prefix.",
          "details": "A missing key represents zero earlier occurrences, and every new occurrence increases its own value's count once. Counts do not reset merely because another value appears.",
          "wrongOptionExplanationsByOptionId": {
            "reset_on_change": "Resetting on value changes would count adjacent runs rather than global frequency."
          },
          "omittedCorrectExplanationsByOptionId": {
            "processed_prefix_count": "This is the central correctness invariant for the frequency table.",
            "missing_means_zero": "Zero is the correct prior count before the first occurrence.",
            "increment_once": "One occurrence contributes exactly one to its value's multiplicity."
          }
