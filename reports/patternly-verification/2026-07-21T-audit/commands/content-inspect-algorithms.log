          {
            "id": "alg-bits-representation-006",
            "prompt": "Using an 8-bit width-limited complement, what is the result of complementing 00001111?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "bits_11110000",
                  "text": "11110000."
                },
                {
                  "id": "infinite_ones",
                  "text": "An unlimited sequence of leading ones followed by 11110000."
                },
                {
                  "id": "bits_00001111",
                  "text": "00001111."
                },
                {
                  "id": "bits_11111111",
                  "text": "11111111."
                }
              ],
              "acceptedOptionIds": [
                "bits_11110000"
              ]
            },
            "scoringContract": {
              "type": "choice",
              "resultSemantics": "exact_selected_set_with_partial_v1"
            },
            "feedback": {
              "reason": "Width-limited complement flips each of the eight declared bits.",
              "details": "The result depends on the width model; without a width, leading-bit behavior is ambiguous.",
              "wrongOptionExplanationsByOptionId": {
                "infinite_ones": "The question explicitly limits the result to 8 bits.",
                "bits_00001111": "Complement flips each bit.",
                "bits_11111111": "Only the four low zeros become ones; the four low ones become zeros."
              }
            },
            "taxonomy": {
              "primarySkillAtomId": "interpret_integer_bit_representation",
              "secondarySkillAtomIds": [],
              "learningStage": "pattern_mechanics",
              "patternVariantId": "bit_mask",
              "problemArchetypeId": "encode_boolean_state"
            },
            "constraints": [
              "Use exactly 8 bits. Complement flips only those 8 positions."
            ]
          },
          {
            "id": "alg-bits-representation-007",
