            "taxonomy": {
              "primarySkillAtomId": "compare_preprocessing_and_repeated_query_cost",
              "secondarySkillAtomIds": [],
              "learningStage": "contrast_practice"
            }
          },
          {
            "id": "alg-contrast-binary-scan-repeated-022",
            "prompt": "A maintained ordered index supports O(log n) query and O(n) update. A plain array supports O(n) query and O(1) append. For q queries and u appends, compare total workload time.",
            "constraints": [
