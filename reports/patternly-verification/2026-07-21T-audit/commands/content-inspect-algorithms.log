            },
            {
              "id": "nested_never",
              "text": "Nested loops can never be quadratic."
            },
            {
              "id": "two_means_linear",
              "text": "Two loops always add to O(n)."
            },
            {
              "id": "names",
              "text": "The loop variables may not be named i and j."
