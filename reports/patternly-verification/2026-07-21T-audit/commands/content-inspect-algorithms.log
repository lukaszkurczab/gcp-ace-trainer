          {
            "id": "alg-contrast-binary-scan-single-007",
            "prompt": "A monotonic predicate search over W candidates calls an O(n) feasibility function. A direct O(n) algorithm solves the same one-query problem. Which is asymptotically cheaper?",
            "difficulty": "foundational",
            "interaction": {
              "type": "choice",
              "selectionMode": "single",
              "options": [
                {
                  "id": "direct_scan",
                  "text": "The direct O(n) method, compared with O(n log W) for repeated predicate evaluation."
                },
                {
                  "id": "binary",
                  "text": "Binary search because it uses only O(log W) candidates."
                },
                {
                  "id": "equal",
                  "text": "They are always equal."
                },
                {
                  "id": "unknown_without_mid",
                  "text": "The result depends on the midpoint variable name."
                }
              ],
              "acceptedOptionIds": [
                "direct_scan"
