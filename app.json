{
  "expo": {
    "name": "Patternly",
    "slug": "patternly",
    "version": "0.1.0",
    "scheme": "com.lkurczab.patternly",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-notifications",
      "./plugins/withPrivacyBoundary"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lkurczab.patternly"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.lkurczab.patternly"
    }
  }
}
