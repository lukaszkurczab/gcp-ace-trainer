# Copy to .env.sandbox.local. Do not add emulator, BACKEND_E2E, API-origin,
# or E2E credential values: this profile rejects all local auth overrides.
PATTERNLY_RUNTIME_MODE=sandbox
EXPO_PUBLIC_PATTERNLY_RUNTIME_MODE=sandbox
EXPO_PUBLIC_PATTERNLY_FIREBASE_API_KEY=
EXPO_PUBLIC_PATTERNLY_FIREBASE_APP_ID=
EXPO_PUBLIC_PATTERNLY_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_PATTERNLY_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_PATTERNLY_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_PATTERNLY_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_PATTERNLY_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_PATTERNLY_APPCHECK_ANDROID_PROVIDER=playIntegrity
EXPO_PUBLIC_PATTERNLY_APPCHECK_APPLE_PROVIDER=deviceCheck
EXPO_PUBLIC_PATTERNLY_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_PATTERNLY_PUBLIC_ENVIRONMENT={"apiOrigin":"","androidAppLinkHost":"","authActionOrigin":"","authRedirectDomain":"","environment":"sandbox","iosAssociatedDomain":"applinks:","privacyUrl":"","publicWebOrigin":"","supportUrl":"","termsUrl":"","transactionalSenderDomain":""}
