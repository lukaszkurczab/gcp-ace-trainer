# Copy to .env for a local build. Keep .env untracked.
#
# EXPO_PUBLIC_* values are inlined into the client bundle. They are public
# Firebase/OAuth identifiers or public origins, not a place for secrets.
# Never put a Firebase service-account key, private key, App Store key,
# RevenueCat secret, backend signing secret, or user password here.

# Firebase Web client configuration for the selected sandbox project.
# Obtain these from Firebase Console > Project settings > General > Your apps.
EXPO_PUBLIC_PATTERNLY_FIREBASE_API_KEY=
EXPO_PUBLIC_PATTERNLY_FIREBASE_APP_ID=
EXPO_PUBLIC_PATTERNLY_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_PATTERNLY_FIREBASE_PROJECT_ID=

# OAuth client IDs used by the native Google sign-in request.
# These are client identifiers, not client secrets.
EXPO_PUBLIC_PATTERNLY_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_PATTERNLY_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_PATTERNLY_GOOGLE_WEB_CLIENT_ID=

# Exact JSON object required by the validated public-environment contract.
# Keep environment=sandbox until the real sandbox origins are known.
# Required keys: apiOrigin, publicWebOrigin, authActionOrigin,
# authRedirectDomain, privacyUrl, termsUrl, supportUrl, publicDeletionUrl,
# iosAssociatedDomain, androidAppLinkHost, transactionalSenderDomain.
EXPO_PUBLIC_PATTERNLY_PUBLIC_ENVIRONMENT={"apiOrigin":"","androidAppLinkHost":"","authActionOrigin":"","authRedirectDomain":"","environment":"sandbox","iosAssociatedDomain":"applinks:","privacyUrl":"","publicDeletionUrl":"","publicWebOrigin":"","supportUrl":"","termsUrl":"","transactionalSenderDomain":""}

# Native App Check provider selection. Leave both empty for ordinary app
# development. Use Android=debug only with a private, registered Firebase
# debug token; use Android=playIntegrity only for the later distribution gate.
# Leave Apple empty until an Apple Developer account and iOS release path exist.
# Android: debug | playIntegrity
# Apple: debug | deviceCheck | appAttest | appAttestWithDeviceCheckFallback
EXPO_PUBLIC_PATTERNLY_APPCHECK_ANDROID_PROVIDER=
EXPO_PUBLIC_PATTERNLY_APPCHECK_APPLE_PROVIDER=

# Local Firebase Auth Emulator / backend E2E only. Do not put emulator origins
# in .env when producing an installed sandbox build: EXPO_PUBLIC_* values are
# compiled into the bundle. Supply these values only to an explicit local E2E
# Metro session with a disposable emulator test account.
EXPO_PUBLIC_PATTERNLY_BACKEND_E2E=false
EXPO_PUBLIC_PATTERNLY_E2E_EMAIL=
EXPO_PUBLIC_PATTERNLY_E2E_PASSWORD=
