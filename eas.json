{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-cli/schema/eas-config.json",
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "sandbox": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "sandbox",
      "environment": "preview",
      "env": {
        "PATTERNLY_RUNTIME_MODE": "sandbox",
        "EXPO_PUBLIC_PATTERNLY_RUNTIME_MODE": "sandbox"
      }
    },
    "release": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "PATTERNLY_RUNTIME_MODE": "release",
        "EXPO_PUBLIC_PATTERNLY_RUNTIME_MODE": "release"
      }
    },
    "android-clock-probe": {
      "extends": "sandbox",
      "channel": "android-clock-probe-20261017",
      "env": {
        "EXPO_PUBLIC_PATTERNLY_ANDROID_CLOCK_PROBE_RUN_ID": "c84afbb2-a2c7-405e-91df-9fd124ace0af"
      },
      "android": {
        "gradleCommand": ":app:assembleRelease --stacktrace --max-workers=1 --no-parallel"
      }
    },
    "android-isolation-probe": {
      "extends": "sandbox",
      "channel": "android-isolation-probe",
      "env": {
        "EXPO_PUBLIC_PATTERNLY_PUBLIC_ENVIRONMENT": "{\"apiOrigin\":\"https://environment-isolation.invalid\",\"androidAppLinkHost\":\"patternly-backend-sandbox-958691314582.europe-central2.run.app\",\"authActionOrigin\":\"https://patternly-app-sandbox.firebaseapp.com\",\"authRedirectDomain\":\"patternly-app-sandbox.firebaseapp.com\",\"environment\":\"sandbox\",\"iosAssociatedDomain\":\"applinks:patternly-backend-sandbox-958691314582.europe-central2.run.app\",\"privacyUrl\":\"https://patternly-backend-sandbox-958691314582.europe-central2.run.app/privacy\",\"publicWebOrigin\":\"https://patternly-backend-sandbox-958691314582.europe-central2.run.app\",\"supportUrl\":\"https://patternly-backend-sandbox-958691314582.europe-central2.run.app/support\",\"termsUrl\":\"https://patternly-backend-sandbox-958691314582.europe-central2.run.app/terms\",\"transactionalSenderDomain\":\"patternly-app-sandbox.firebaseapp.com\"}"
      },
      "android": {
        "gradleCommand": ":app:assembleRelease --stacktrace --max-workers=1 --no-parallel"
      }
    }
  }
}
