{
  "extends": "expo/tsconfig.base",
  "include": [
    "App.tsx",
    "app.config.js",
    "plugins/**/*",
    "src/**/*",
    "scripts/**/*"
  ],
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  }
}
