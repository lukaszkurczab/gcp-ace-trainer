{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternly.app/schemas/release/release-evidence.schema.json",
  "title": "Patternly release evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "applicationCommit",
    "verifiedAt",
    "verifiedBy",
    "evidenceReferences",
    "evidenceSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "patternly-release-evidence-v2" },
    "id": {
      "enum": [
        "design-authority",
        "security-and-privacy",
        "provider-and-operations",
        "signing-and-builds",
        "physical-device-matrix",
        "store-readiness",
        "product-owner-go"
      ]
    },
    "status": { "const": "verified" },
    "applicationCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "verifiedBy": { "type": "string", "minLength": 1 },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "releaseBinding": {},
    "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [{
    "if": { "properties": { "id": { "const": "signing-and-builds" } }, "required": ["id"] },
    "then": {
      "required": ["releaseBinding"],
      "properties": {
        "releaseBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["iosBuild", "configuration"],
          "properties": {
            "iosBuild": {
              "type": "object",
              "additionalProperties": false,
              "required": ["appVersion", "buildId", "buildNumber", "bundleIdentifier"],
              "properties": {
                "appVersion": { "type": "string", "minLength": 1 },
                "buildId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
                "buildNumber": { "type": "string", "pattern": "^[0-9]+$" },
                "bundleIdentifier": { "type": "string", "minLength": 1 }
              }
            },
            "configuration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["apiOrigin", "appCheckAppleProvider", "authActionOrigin", "channel", "environment", "firebaseProjectId", "iosAssociatedDomain", "publicWebOrigin", "runtimeMode", "runtimeVersion", "updatesUrl"],
              "properties": {
                "apiOrigin": { "type": "string", "pattern": "^https://" },
                "appCheckAppleProvider": { "enum": ["deviceCheck", "appAttest", "appAttestWithDeviceCheckFallback"] },
                "authActionOrigin": { "type": "string", "pattern": "^https://" },
                "channel": { "const": "production" },
                "environment": { "const": "production" },
                "firebaseProjectId": { "type": "string", "minLength": 1 },
                "iosAssociatedDomain": { "type": "string", "minLength": 1 },
                "publicWebOrigin": { "type": "string", "pattern": "^https://" },
                "runtimeMode": { "const": "release" },
                "runtimeVersion": { "type": "string", "minLength": 1 },
                "updatesUrl": { "type": "string", "pattern": "^https://" }
              }
            }
          }
        }
      }
    },
    "else": { "not": { "required": ["releaseBinding"] } }
  }]
}
