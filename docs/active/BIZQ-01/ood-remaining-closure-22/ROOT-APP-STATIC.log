                  <SkeletonShape motion={motion} style={[styles.homeLoadingLine, styles.homeLoadingDecisionDetail, { height: 13 * textScale }]} />
                </View>
              </View>
              <SkeletonShape motion={motion} style={[styles.homeLoadingAction, { minHeight: 48 * textScale }]} />
            </View>
