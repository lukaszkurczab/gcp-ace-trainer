    export function HomeTab({
      activeTrack,
      activeSession,
      analytics,
      algorithmsDashboard,
      dashboardError,
      onChangeTrack,
      onChooseTopic,
      onDismissGoalOnboarding,
      onOpenActivity,
      onOpenSettings,
      onSetGoal,
      onRecommendationAction,
      onHomePlanAction,
      onRetryHomePlan,
      onStartLearning,
      homePlan,
      reviewQueueItems,
      goalInvitationAudience,
