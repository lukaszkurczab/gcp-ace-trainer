    {
      "id": "N09-B07-i027-serializes-ambiguity",
      "severity": "blocking",
      "criterion": "BIZQ-01 single-choice requirement: visible facts must make one answer best; the decisive premise must be unambiguous.",
      "questionId": "ood-n09-b07-i027",
      "fields": [
        "constraints[0]",
        "feedback.details.errorCorrection",
        "feedback.details.boundaryOrTradeoff",
        "feedback.reason",
        "feedback.messages[n09b07_i027_parallel_individual_reads_v5]"
      ],
      "evidence": "The stem’s phrase “serializes single-author requests” may mean sequential request processing or payload encoding/serialization. Sequential processing would exclude parallel fan-out; encoding alone would not. This phrase carries the decisive distinction between batching and the new parallel-requests alternative.",
      "minimumCorrection": "Say explicitly that the service processes/queues single-author requests one at a time; align Reason, Details and the feedback with that behavior."
    }
  ],
