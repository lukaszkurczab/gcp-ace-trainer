{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternly.app/schemas/canonical-product-contract.schema.json",
  "title": "Patternly canonical product contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contractId", "authority", "requirements", "algorithms", "certification"],
  "properties": {
    "version": {
      "description": "The version of this contract format.",
      "type": "integer",
      "const": 1
    },
    "contractId": {
      "type": "string",
      "const": "patternly-product-contract"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normativeSource", "narrativeDocuments"],
      "properties": {
        "normativeSource": {
          "type": "string",
          "const": "canonical-product-contract"
        },
        "narrativeDocuments": {
          "type": "string",
          "const": "non-normative"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*[A-Z0-9]$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "algorithms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customPractice", "modes"],
      "properties": {
        "customPractice": { "$ref": "#/$defs/customPractice" },
        "modes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/algorithmMode" }
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/certificationMode" }
        }
      }
    }
  },
  "$defs": {
    "customPractice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modeId", "contentBlueprintModeId", "mentalUnitSelection", "reinsertOwnership", "lifecycle"],
      "properties": {
        "modeId": { "const": "algorithms-custom-practice" },
        "contentBlueprintModeId": { "const": "algorithms-guided-practice" },
        "mentalUnitSelection": { "const": "explicit" },
        "reinsertOwnership": { "const": "profile" },
        "lifecycle": { "const": "sharedOneActiveSession" }
      }
    },
    "algorithmMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "lengths", "scope", "shortening", "feedback", "timer", "reinsert"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "algorithms-learn-approach",
            "algorithms-guided-practice",
            "algorithms-custom-practice",
            "algorithms-recognize-patterns",
            "algorithms-contrast-practice",
            "algorithms-weak-area-review",
            "algorithms-independent-practice",
            "algorithms-interview-simulation"
          ]
        },
        "label": {
          "type": "string",
          "enum": [
            "Learn Approach",
            "Guided Practice",
            "Custom Practice",
            "Recognize Patterns",
            "Contrast Practice",
            "Weak Area Review",
            "Independent Practice",
            "Interview Simulation"
          ]
        },
        "lengths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "supported"],
          "properties": {
            "default": { "type": "integer", "enum": [10, 20, 40] },
            "supported": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "enum": [10, 20, 40] }
            }
          }
        },
        "scope": {
          "type": "string",
          "enum": [
            "oneMentalUnit",
            "guidedPracticeBlueprintForSelectedMentalUnit",
            "declaredRecognitionSet",
            "declaredContrastSet",
            "eligibleDueReviewOrCompletedSessionMisses",
            "declaredInterleavedScope",
            "fixedSimulationBlueprint"
          ]
        },
        "shortening": { "type": "string", "enum": ["allowed", "blueprintControlled", "prohibited"] },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "supported"],
          "properties": {
            "default": { "type": "string", "enum": ["afterEachAnswer", "atSessionEnd"] },
            "supported": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["afterEachAnswer", "atSessionEnd"] }
            }
          }
        },
        "timer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "elapsedForeground" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "durationMs"],
              "properties": {
                "kind": { "const": "countdownForeground" },
                "durationMs": { "const": 2700000 }
              }
            }
          ]
        },
        "reinsert": { "type": "boolean" }
      }
    },
    "certificationMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "owner", "status"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "certification-diagnostic-baseline",
            "certification-focus-practice",
            "certification-scenario-practice",
            "certification-weak-area-review",
            "certification-mixed-practice",
            "certification-quick-review",
            "certification-exam-simulation"
          ]
        },
        "label": {
          "type": "string",
          "enum": [
            "Diagnostic Baseline",
            "Focus Practice",
            "Scenario Practice",
            "Weak Area Review",
            "Mixed Practice",
            "Quick Review",
            "Exam Simulation"
          ]
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["familyId", "trackId"],
          "properties": {
            "familyId": { "const": "certification" },
            "trackId": { "const": "cloud-certification" }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "implementation", "verification"],
          "properties": {
            "contract": { "const": "declared" },
            "implementation": { "const": "unavailable" },
            "verification": { "const": "unverified" }
          }
        }
      }
    }
  }
}
