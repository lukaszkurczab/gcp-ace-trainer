{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternly.app/schemas/canonical-product-contract.schema.json",
  "title": "Patternly canonical product contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contractId", "authority", "requirements", "requirementTestCoverage", "userCommands", "sessionStateMachine", "simulationConcurrency", "simulationTimerCadence", "designReferences", "simulationOperationStateCtas", "algorithms", "certification"],
  "properties": {
    "version": {
      "description": "The version of this contract format.",
      "type": "integer",
      "const": 1
    },
    "contractId": {
      "type": "string",
      "const": "patternly-product-contract"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normativeSource", "narrativeDocuments"],
      "properties": {
        "normativeSource": {
          "type": "string",
          "const": "canonical-product-contract"
        },
        "narrativeDocuments": {
          "type": "string",
          "const": "non-normative"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*[A-Z0-9]$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirementTestCoverage": { "$ref": "#/$defs/requirementTestCoverage" },
    "userCommands": { "$ref": "#/$defs/userCommands" },
    "sessionStateMachine": { "$ref": "#/$defs/sessionStateMachine" },
    "simulationConcurrency": { "$ref": "#/$defs/simulationConcurrency" },
    "simulationTimerCadence": { "$ref": "#/$defs/simulationTimerCadence" },
    "designReferences": { "$ref": "#/$defs/designReferences" },
    "simulationOperationStateCtas": { "$ref": "#/$defs/simulationOperationStateCtas" },
    "algorithms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customPractice", "reinsertPolicy", "modes"],
      "properties": {
        "customPractice": { "$ref": "#/$defs/customPractice" },
        "reinsertPolicy": { "$ref": "#/$defs/algorithmsReinsertPolicy" },
        "modes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/algorithmMode" }
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/certificationMode" }
        }
      }
    }
  },
  "$defs": {
    "requirementTestCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tests"],
      "properties": {
        "version": { "const": 1 },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requirementTest" }
        }
      }
    },
    "requirementTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "testPath", "testName", "requirementIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
        "testPath": { "type": "string", "pattern": "^tests/[^/\\\\]+(?:/[^/\\\\]+)*\\.(?:[cm]?[jt]sx?|mjs)$" },
        "testName": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*[A-Z0-9]$" }
        }
      }
    },
    "userCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "sessionCtaMappings"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 10,
          "maxItems": 11,
          "items": { "$ref": "#/$defs/userCommand" }
        },
        "sessionCtaMappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sessionCtaMapping" }
        }
      }
    },
    "sessionStateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practice", "simulation"],
      "properties": {
        "practice": { "$ref": "#/$defs/practiceSessionStateMachine" },
        "simulation": { "$ref": "#/$defs/simulationSessionStateMachine" }
      }
    },
    "simulationConcurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "queueDiscipline", "maxInFlight", "revalidateActiveSessionAtExecution", "mutationKinds"],
      "properties": {
        "scope": { "const": "oneActiveSession" },
        "queueDiscipline": { "const": "fifo" },
        "maxInFlight": { "const": 1 },
        "revalidateActiveSessionAtExecution": { "const": true },
        "mutationKinds": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/simulationMutationKind" }
        }
      }
    },
    "simulationMutationKind": {
      "type": "string",
      "enum": ["save", "navigation", "timer-checkpoint", "foreground-transition", "finalization", "abandonment"]
    },
    "simulationTimerCadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "uiRefreshIntervalMs", "uiRefreshWritesDurably", "durableCheckpointIntervalMs", "maxDurableCheckpointDriftMs", "lifecycleCheckpoints"],
      "properties": {
        "version": { "const": 1 },
        "uiRefreshIntervalMs": { "const": 1000 },
        "uiRefreshWritesDurably": { "const": false },
        "durableCheckpointIntervalMs": { "const": 15000 },
        "maxDurableCheckpointDriftMs": { "const": 1000 },
        "lifecycleCheckpoints": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/simulationTimerLifecycleCheckpoint" }
        }
      }
    },
    "simulationTimerLifecycleCheckpoint": {
      "type": "string",
      "enum": ["foreground-enter", "foreground-leave", "draft-save", "finalization", "expiry"]
    },
    "designReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "references", "uiOwnership"],
      "properties": {
        "version": { "const": 1 },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/designReference" }
        },
        "uiOwnership": {
          "type": "array",
          "items": { "$ref": "#/$defs/designReferenceUiOwnership" }
        }
      }
    },
    "simulationOperationStateCtas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "policies"],
      "properties": {
        "version": { "const": 1 },
        "policies": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/simulationOperationStateCtaPolicy" }
        }
      }
    },
    "simulationOperationStateCtaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operationStates", "allowedCtaIds"],
      "properties": {
        "id": { "type": "string", "enum": ["saving-response", "save-failed", "response-saved-navigation-failed", "finalizing", "finalization-recovery-required"] },
        "operationStates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/simulationSessionState" }
        },
        "allowedCtaIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sessionCtaMapping/properties/ctaId" }
        }
      }
    },
    "designReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "screenStateTarget", "patternPath", "version", "approvalStatus", "owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
        "screenStateTarget": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
        "patternPath": { "type": "string", "pattern": "^docs/designs/[^/\\\\]+(?:/[^/\\\\]+)*$" },
        "version": { "type": "integer", "minimum": 1 },
        "approvalStatus": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED"] },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" }
      }
    },
    "designReferenceUiOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePathPrefix", "designReferenceId"],
      "properties": {
        "sourcePathPrefix": { "type": "string", "pattern": "^src/(?:assets|components|content/application|features|navigation|preferences|theme)(?:/[A-Za-z0-9_-]+)*/$" },
        "designReferenceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" }
      }
    },
    "practiceSessionStateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialState", "states", "transitions"],
      "properties": {
        "initialState": { "const": "unanswered" },
        "states": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/practiceSessionState" }
        },
        "transitions": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": { "$ref": "#/$defs/practiceSessionTransition" }
        }
      }
    },
    "simulationSessionStateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialState", "states", "transitions"],
      "properties": {
        "initialState": { "const": "editable" },
        "states": {
          "type": "array",
          "minItems": 24,
          "maxItems": 25,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/simulationSessionState" }
        },
        "transitions": {
          "type": "array",
          "minItems": 31,
          "maxItems": 33,
          "items": { "$ref": "#/$defs/simulationSessionTransition" }
        }
      }
    },
    "practiceSessionState": {
      "type": "string",
      "enum": ["unanswered", "submitting_before_journal", "submit_journal_failed", "commit_pending", "commit_materialization_failed", "commit_verification_failed", "verified_pending_clear", "recovery_required", "feedback", "advancing", "advance_failed", "completing", "completion_failed", "completed", "abandoning", "abandonment_failed_before_journal", "abandonment_recovery_required", "abandoned"]
    },
    "simulationSessionState": {
      "type": "string",
      "enum": ["editable", "saving", "save_failed", "stale_revision", "navigating", "navigation_failed", "save_and_continue_advance_recovery", "frozen", "finalization_journal_pending", "finalization_journal_failed", "materializing", "materialization_failed", "verifying", "verification_failed", "verified_pending_clear", "recovery_required", "timer_recovery_failed", "missing_draft", "version_mismatch", "corrupt_state", "abandoning", "abandonment_failed_before_journal", "abandonment_recovery_required", "abandoned", "completed"]
    },
    "sessionStateMachineTrigger": {
      "type": "string",
      "enum": ["submit", "next", "save", "navigator_jump", "finish", "abandon", "recover", "validation_rejected", "journal_write_failed", "submit_verified", "advance_verified", "advance_failed", "completion_verified", "completion_failed", "abandonment_verified", "abandonment_before_journal_failed", "abandonment_recovery_required", "save_verified", "save_failed", "stale_revision", "navigation_verified", "navigation_failed", "advance_not_verified_after_saved_response", "reconstruct", "finalization_started", "finalization_verified", "materialization_failed", "materialization_verified", "verification_failed", "verification_verified"]
    },
    "sessionStateMachineTransitionCondition": {
      "type": "string",
      "enum": ["durable_state_not_durable", "journal_status_durable", "journal_status_materialized", "journal_status_verified_pending_clear", "recovered_active_session"]
    },
    "practiceSessionTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "trigger", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/practiceSessionState" },
        "trigger": { "$ref": "#/$defs/sessionStateMachineTrigger" },
        "condition": { "$ref": "#/$defs/sessionStateMachineTransitionCondition" },
        "to": { "$ref": "#/$defs/practiceSessionState" }
      }
    },
    "simulationSessionTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "trigger", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/simulationSessionState" },
        "trigger": { "$ref": "#/$defs/sessionStateMachineTrigger" },
        "condition": { "$ref": "#/$defs/sessionStateMachineTransitionCondition" },
        "to": { "$ref": "#/$defs/simulationSessionState" }
      }
    },
    "userCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/userCommandId" }
      }
    },
    "userCommandId": {
      "type": "string",
      "enum": [
        "submit",
        "next",
        "save",
        "save-and-continue",
        "navigator-jump",
        "finish",
        "leave-resumable",
        "abandon",
        "recover",
        "resume",
        "resume-editing"
      ]
    },
    "sessionCtaMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ctaId", "commandId"],
      "properties": {
        "ctaId": {
          "type": "string",
          "enum": [
            "practice-submit",
            "practice-next",
            "practice-finish",
            "practice-leave-resumable",
            "practice-abandon",
            "practice-recover",
            "simulation-save",
            "simulation-keep-editing",
            "simulation-save-and-continue",
            "simulation-navigator-jump",
            "simulation-finish",
            "simulation-leave-resumable",
            "simulation-abandon",
            "simulation-recover",
            "session-resume"
          ]
        },
        "commandId": { "type": "string", "minLength": 1 }
      }
    },
    "customPractice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modeId", "contentBlueprintModeId", "mentalUnitSelection", "reinsertOwnership", "lifecycle"],
      "properties": {
        "modeId": { "const": "algorithms-custom-practice" },
        "contentBlueprintModeId": { "const": "algorithms-guided-practice" },
        "mentalUnitSelection": { "const": "explicit" },
        "reinsertOwnership": { "const": "profile" },
        "lifecycle": { "const": "sharedOneActiveSession" }
      }
    },
    "algorithmsReinsertPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "eligibleResultKinds", "maxReinsertsPerSource", "minInterveningDurableSubmissions", "variantSelectionOrder", "missingValidSlot"],
      "properties": {
        "version": { "const": 1 },
        "eligibleResultKinds": {
          "type": "array",
          "const": ["incorrect", "partial"],
          "uniqueItems": true
        },
        "maxReinsertsPerSource": { "const": 1 },
        "minInterveningDurableSubmissions": { "const": 3 },
        "variantSelectionOrder": {
          "type": "array",
          "const": ["compatibleReviewedVariant", "exactSourceFallback"],
          "uniqueItems": true
        },
        "missingValidSlot": { "const": "skip" }
      }
    },
    "algorithmMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "lengths", "scope", "shortening", "feedback", "timer", "reinsert"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "algorithms-learn-approach",
            "algorithms-guided-practice",
            "algorithms-custom-practice",
            "algorithms-recognize-patterns",
            "algorithms-contrast-practice",
            "algorithms-weak-area-review",
            "algorithms-independent-practice",
            "algorithms-interview-simulation"
          ]
        },
        "label": {
          "type": "string",
          "enum": [
            "Learn Approach",
            "Guided Practice",
            "Custom Practice",
            "Recognize Patterns",
            "Contrast Practice",
            "Weak Area Review",
            "Independent Practice",
            "Interview Simulation"
          ]
        },
        "lengths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "supported"],
          "properties": {
            "default": { "type": "integer", "enum": [10, 20, 40] },
            "supported": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "enum": [10, 20, 40] }
            }
          }
        },
        "scope": {
          "type": "string",
          "enum": [
            "oneMentalUnit",
            "guidedPracticeBlueprintForSelectedMentalUnit",
            "declaredRecognitionSet",
            "declaredContrastSet",
            "eligibleDueReviewOrCompletedSessionMisses",
            "declaredInterleavedScope",
            "fixedSimulationBlueprint"
          ]
        },
        "shortening": { "type": "string", "enum": ["allowed", "blueprintControlled", "prohibited"] },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "supported"],
          "properties": {
            "default": { "type": "string", "enum": ["afterEachAnswer", "atSessionEnd"] },
            "supported": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["afterEachAnswer", "atSessionEnd"] }
            }
          }
        },
        "timer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "elapsedForeground" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "durationMs"],
              "properties": {
                "kind": { "const": "countdownForeground" },
                "durationMs": { "const": 2700000 }
              }
            }
          ]
        },
        "reinsert": { "type": "boolean" }
      }
    },
    "certificationMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "owner", "status"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "certification-diagnostic-baseline",
            "certification-focus-practice",
            "certification-scenario-practice",
            "certification-weak-area-review",
            "certification-mixed-practice",
            "certification-quick-review",
            "certification-exam-simulation"
          ]
        },
        "label": {
          "type": "string",
          "enum": [
            "Diagnostic Baseline",
            "Focus Practice",
            "Scenario Practice",
            "Weak Area Review",
            "Mixed Practice",
            "Quick Review",
            "Exam Simulation"
          ]
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["familyId", "trackId"],
          "properties": {
            "familyId": { "const": "certification" },
            "trackId": { "const": "cloud-certification" }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "implementation", "verification"],
          "properties": {
            "contract": { "const": "declared" },
            "implementation": { "enum": ["available", "unavailable"] },
            "verification": { "enum": ["verified", "unverified"] }
          }
        },
        "configuration": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["setupControls", "sessionLength", "selectionScope", "feedbackTiming", "timer", "shortening", "reinsert", "reviewBehavior", "summaryMetrics", "permittedActions"],
              "properties": {
                "setupControls": { "type": "array", "items": { "type": "string" } },
                "sessionLength": { "const": 40 },
                "selectionScope": { "const": "fixedDiagnosticBlueprint" },
                "feedbackTiming": { "const": "afterEachDurableSubmit" },
                "timer": { "const": "elapsedForeground" },
                "shortening": { "const": "prohibited" },
                "reinsert": { "const": false },
                "reviewBehavior": { "const": "domainBreakdown" },
                "summaryMetrics": { "type": "array", "items": { "type": "string" } },
                "permittedActions": { "type": "array", "items": { "type": "string" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["setupControls", "sessionLengths", "selectionScope", "feedbackTiming", "timer", "shortening", "reinsert", "reviewBehavior", "summaryMetrics", "permittedActions"],
              "properties": {
                "setupControls": { "const": ["topic", "sessionLength"] },
                "sessionLengths": { "const": [10, 20, 40] },
                "selectionScope": { "const": "explicitCloudDomain" },
                "feedbackTiming": { "const": "afterEachDurableSubmit" },
                "timer": { "const": "elapsedForeground" },
                "shortening": { "const": "allowedWithinSelectedTopic" },
                "reinsert": { "const": false },
                "reviewBehavior": { "const": "domainBreakdown" },
                "summaryMetrics": { "type": "array", "items": { "type": "string" } },
                "permittedActions": { "type": "array", "items": { "type": "string" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["setupControls", "sessionLengths", "selectionScope", "feedbackTiming", "timer", "shortening", "reinsert", "reviewBehavior", "summaryMetrics", "permittedActions"],
              "properties": {
                "setupControls": { "const": ["competency", "sessionLength"] },
                "sessionLengths": { "const": [10, 20, 40] },
                "selectionScope": { "const": "explicitApprovedScenarioCompetency" },
                "feedbackTiming": { "const": "afterEachDurableSubmit" },
                "timer": { "const": "elapsedForeground" },
                "shortening": { "const": "allowedWithinSelectedCompetency" },
                "reinsert": { "const": false },
                "reviewBehavior": { "const": "domainBreakdown" },
                "summaryMetrics": { "type": "array", "items": { "type": "string" } },
                "permittedActions": { "type": "array", "items": { "type": "string" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["setupControls", "sessionLengths", "selectionScope", "feedbackTiming", "timer", "shortening", "reinsert", "reviewBehavior", "summaryMetrics", "permittedActions"],
              "properties": {
                "setupControls": { "const": ["sessionLength"] },
                "sessionLengths": { "const": [10, 20] },
                "selectionScope": { "const": "eligibleDueReviewEvidence" },
                "feedbackTiming": { "const": "afterEachDurableSubmit" },
                "timer": { "const": "elapsedForeground" },
                "shortening": { "const": "allowedWithinEligibleReviewEvidence" },
                "reinsert": { "const": false },
                "reviewBehavior": { "const": "resolveAfterTwoConsecutiveDueReviewSuccesses" },
                "summaryMetrics": { "type": "array", "items": { "type": "string" } },
                "permittedActions": { "type": "array", "items": { "type": "string" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["setupControls", "sessionLengths", "selectionScope", "feedbackTiming", "timer", "shortening", "reinsert", "reviewBehavior", "summaryMetrics", "permittedActions"],
              "properties": {
                "setupControls": { "const": ["sessionLength"] },
                "sessionLengths": { "const": [10, 20, 40] },
                "selectionScope": { "const": "explicitUniqueInterleavedBlueprint" },
                "feedbackTiming": { "const": "afterEachDurableSubmit" },
                "timer": { "const": "elapsedForeground" },
                "shortening": { "const": "allowedWithinInterleavedBlueprint" },
                "reinsert": { "const": false },
                "reviewBehavior": { "const": "domainBreakdown" },
                "summaryMetrics": { "type": "array", "items": { "type": "string" } },
                "permittedActions": { "type": "array", "items": { "type": "string" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["setupControls", "sessionLength", "selectionScope", "feedbackTiming", "timer", "shortening", "reinsert", "reviewBehavior", "summaryMetrics", "permittedActions"],
              "properties": {
