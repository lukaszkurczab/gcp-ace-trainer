{
  "name": "gcp-ace-trainer",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "audit:ux-ui": "npm run audit:ux-ui:report && PATTERNLY_DEV_CLIENT_URL=\"com.lkurczab.gcpacetrainer://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081\" maestro test --test-output-dir docs/audits/ux-ui/algorithms-stage3-visual-harness-v1/maestro --flatten-debug-output .audit/ux-ui/maestro/flows/algorithms-stage3-harness.ios.yaml",
    "audit:ux-ui:android": "npm run audit:ux-ui:report && PATTERNLY_DEV_CLIENT_URL=\"com.lkurczab.gcpacetrainer://expo-development-client/?url=http%3A%2F%2F10.0.2.2%3A8081\" maestro test --test-output-dir docs/audits/ux-ui/algorithms-stage3-visual-harness-v1/maestro --flatten-debug-output .audit/ux-ui/maestro/flows/algorithms-stage3-harness.android.yaml",
    "audit:ux-ui:report": "node scripts/validateUxUiAuditConfig.mjs",
    "audit:algorithms-ui:fixtures": "node --import tsx --test tests/algorithmsVisualHarness.test.ts",
    "audit:algorithms-ui:start": "cd audit/algorithms-ui && expo start --dev-client --port 8082",
    "qa:static": "npm run recovery:check && npm run typecheck && npm test && npm run validate:content-boundary",
    "recovery:check": "node scripts/checkRecoveryBaseline.mjs",
    "baseline:report": "node scripts/recoveryBaselineReport.mjs",
    "inventory:algorithms": "node --import tsx scripts/inventoryAlgorithmsSchema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:algorithms-cross-repo": "node --import tsx --test tests/algorithmsCrossRepoContract.test.ts",
    "validate:content-boundary": "node scripts/validateContentBoundary.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "expo": "~54.0.33",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-svg-transformer": "^1.5.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
