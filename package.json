{
  "name": "patternly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo run:android",
    "android:sandbox:prebuild": "npm ci --omit=optional && npx expo prebuild --platform android --clean --no-install && node scripts/writeAndroidLocalProperties.mjs",
    "android:sandbox": "export NODE_ENV=production PATTERNLY_ANDROID_SANDBOX=1 && npm run android:sandbox:prebuild && (cd android && ./gradlew :app:assembleSandbox)",
    "ios": "expo run:ios",
    "web": "expo start --web --localhost",
    "qa:static": "npm run recovery:check && npm run typecheck && npm test && npm run validate:content-boundary && npm run validate:runtime-privacy-boundary",
    "gate:contract-change": "node --import tsx scripts/enforceContractChangeGate.ts",
    "recovery:check": "node scripts/checkRecoveryBaseline.mjs",
    "baseline:report": "node scripts/recoveryBaselineReport.mjs",
    "launch:readiness": "node scripts/releaseGate.mjs",
    "release:gate": "node scripts/releaseGate.mjs --enforce",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:content-release-cross-repo": "node --import tsx --test tests/contentReleaseCrossRepo.test.ts",
    "e2e:rc:certification-exam:android": "node scripts/runCertificationExamRcAndroid.mjs",
    "e2e:rc:certification-exam:ios": "node scripts/runCertificationExamRcIos.mjs",
    "e2e:rc:algorithms:android": "node scripts/runRcAlgorithmsAndroid.mjs",
    "e2e:rc:algorithms:ios": "node scripts/runRcAlgorithmsIos.mjs",
    "validate:content-boundary": "node scripts/validateContentBoundary.mjs",
    "validate:runtime-privacy-boundary": "node scripts/validateRuntimePrivacyBoundary.mjs",
    "sync:content-release": "node scripts/syncBundledContentRelease.mjs"
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.7",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/app-check": "^26.3.2",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "expo": "~57.0.11",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.9",
    "expo-build-properties": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.17",
    "fflate": "^0.8.3",
    "firebase": "^12.17.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "ajv": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.0"
  }
}
